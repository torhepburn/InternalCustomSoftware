
@*Error popup*@
<div class="popup-overlay @(pop.IsVisible ? "visible" : "")">
    <div class="popup-content">
        <h3>@pop.Title</h3>
        <p>@pop.Message</p>
        <button class="button-85" @onclick="pop.ClosePopup">Close</button>
    </div>
</div>

@*SHOW PURCHASE ORDERS FOR ITEM CODE*@
@if (dt != null)
{
    <div class="table-container" style="position: fixed;
                                        top: 50%;
                                        left: 50%;
                                        transform: translate(-50%, -50%);
                                        width:70%">
        <table class="table" style="min-width:890px;padding-right:20px;background-color:white">
            <thead>
                <tr>
                    @for (int i = 0; i < n; i++)
                    {
                        int index = i; // Create a local variable and assign it to i
                        <th>
                            <button @onclick="() => SortTable(index)" class="cell-header">
                                @dt.Columns[i]
                                @if (isVisible[i])
                                {
                                    <section class="sort-arrow-down @(isSortedDescending[i] ? "rotate" : "")"></section>
                                }
                            </button>
                        </th>
                    }



                </tr>
            </thead>
            <tbody>
                @if (dt != null)
                {
                    @foreach (DataRow items in dt.Rows)
                    {
                        <tr>
                            <td><button @onclick="() => choose(items)" class="clickable-cell" style="color:red">@items[0].ToString()</button></td>
                            @for (int i = 1; i < n; i++)
                            {
                                <td>@items[i].ToString()</td>
                            }
                        </tr>
                    }

                }
            </tbody>
        </table>
    </div>
}

@code {
    [Parameter]
    public Shortage? item { get; set; }
    [Parameter]
    public Action ExitPOCallback { get; set; }
    PopUp pop = new PopUp();

    public int currentColNum = 0;
    public DataTable dt;

    private bool newBrowse = true;
    int n = 0;
    private List<bool>? isSortedDescending;

    private List<bool>? isVisible;

    
    protected override async Task OnInitializedAsync()//Load the table on open
    {
        SqlConnection NAVcnxn = new SqlConnection(Databases.dbNAV);
        try
        {

            string SQL =
            "SELECT " +
            "l.[Document No_] [Order No] " +
            ",l.[PO Line No_] [PO Line No] " +
            ",l.[Job No_] [Job No] " +
            ",CONVERT(varchar(10), l.[Orig_ Requested Receipt Date],101) [Orig_ Requested Receipt Date] " +
            ",s.Name Vendor " +
            ",FORMAT(l.Quantity, '##.##') as Quantity " +
            ",CONVERT(varchar(10), l.[Planned Receipt Date],1) [Planned Receipt Date] " +
            ",H.[Purchaser Code] " +
            "FROM [" + Databases.NAVprefix + "Purchase Line] l " +
            "INNER JOIN [ZYGO$Purchase Header] H on H.No_ = l.[Document No_] " +
            "inner join [" + Databases.NAVprefix + "Vendor] s on l.[Buy-from Vendor No_] = s.No_ " +
            "WHERE  l.[Outstanding Quantity] > 0 and l.No_ = '" + item.code + "' " +
            "order by l.[Promised Receipt Date]";


            NAVcnxn.Open();


            SqlCommand cmd = new SqlCommand(SQL, NAVcnxn);

            /*      wait time in seconds    */

            cmd.CommandTimeout = 30;
            SqlDataReader dr = cmd.ExecuteReader();
            dt = new DataTable();
            if (dr.HasRows)
            {
                dt = new();
                dt.Load(dr);
                n = dt.Columns.Count;

                isSortedDescending = Enumerable.Repeat(true, n - 1).ToList();
                isSortedDescending.Insert(0, false);

                isVisible = Enumerable.Repeat(false, n - 1).ToList();
                isVisible.Insert(0, true);
            }
            else
            {
                item.PurchaseOrder.PurchaserCode = "";
                ExitPOCallback?.Invoke();
            }
        }
        catch (SqlException ex)
        {
            pop.Title = "Error";
            pop.Message = ex.ToString();
            pop.ShowPopup();
        }
        finally
        {
            NAVcnxn.Close();
        }

    }
    public void SortTable(int columnNum, bool forceAsc = false)
    {
        currentColNum = columnNum;
        string ascendingString = "ASC";
        //Controls the sorting operation of the table
        for (int i = 0; i < n; i++)
        {
            if (columnNum == i)
            {
                isVisible[i] = true; //shows the sort arrow on the table for the corresponding column

                if (isSortedDescending[i] | forceAsc)
                {
                    isSortedDescending[i] = false;
                    ascendingString = "ASC";
                }
                else
                {
                    isSortedDescending[i] = true;
                    ascendingString = "DESC";
                }
            }
            else
            {
                isSortedDescending[i] = true;
                isVisible[i] = false;
            }
        }

        dt.DefaultView.Sort = dt.Columns[columnNum] + " " + ascendingString;
        dt = dt.DefaultView.ToTable();
        StateHasChanged();

    }

    private void choose(DataRow PurchaseItems) //set all purchase order variables once chosen
    {
        item.PurchaseOrder = new PurchaseOrder();
        item.PurchaseOrder.OrderNo = PurchaseItems[0].ToString();
        item.PurchaseOrder.OrigRqstDate = DateTime.Parse(PurchaseItems[3].ToString());
        item.PurchaseOrder.Supplier = PurchaseItems[4].ToString();
        item.PurchaseOrder.Quantity = double.Parse(PurchaseItems[5].ToString());
        item.PurchaseOrder.PlannedDate = DateTime.Parse(PurchaseItems[6].ToString());
        item.buyer = PurchaseItems[7].ToString();
        ExitPOCallback?.Invoke();
    }
}