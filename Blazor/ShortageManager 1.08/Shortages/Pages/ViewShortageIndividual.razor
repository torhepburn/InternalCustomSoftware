        {
            AS4 = loopCmd.ExecuteScalar();
        }
        catch (SqlException ex)
        {
            pop.Title = "Error";
            pop.Message = ex.ToString();
            pop.ShowPopup();
        }

        
        Allocation = string.Format("{0:0}", (Convert.ToDouble(AS1) + Convert.ToDouble(AS2) + Convert.ToDouble(AS3) + Convert.ToDouble(AS4)));



        /*  blocked stock   */


        loopCmd = new SqlCommand
            ("SELECT " +
            "COALESCE(FORMAT(SUM([Quantity]),'N0'), '0') " +
            "FROM [" + Databases.NAVprefix + "Warehouse Entry] " +
