        /*  stock on order  */

        loopCmd = new SqlCommand
        ("SELECT " +
            "COALESCE(FORMAT(SUM(L.[Outstanding Quantity]),'N0'), '0') " +
            "FROM [" + Databases.NAVprefix + "Purchase Line] L " +
