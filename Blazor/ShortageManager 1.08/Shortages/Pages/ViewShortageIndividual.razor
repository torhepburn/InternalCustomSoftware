        "FROM [" + Databases.NAVprefix + "Item Ledger Entry] " +
        "WHERE [Non-Nettable] = 0 " +
        "and [Item No_] = '" + item.code + "' "
        , cnxn);

        nn = "";

        try
        {
            nn = loopCmd.ExecuteScalar();
        }
        catch (SqlException ex)
        {
            pop.Title = "Error";
            pop.Message = ex.ToString();
            pop.ShowPopup();
        }


        if (nn == null)
        {
            pop.Title = "Error";
            pop.Message = "This item does not exist";
            pop.ShowPopup();
        }
