@page "/viewshortageindividual"
@inject NavigationManager Nav
@inject ViewShortageService Views
@inject AuthenticationStateProvider auth;
@inject IJSRuntime JSRuntime

<style>
    body {
        background-color: @BackgroundColor;
    }
</style>

<body>
    @*SHORTAGE TOP TABLE*@
    <Table dt="@ShortageDT" TableStyle="table-shortage" prodLine="@item.prodLine"></Table>

    @*<button @onclick="UpdateShortage">update</button>*@
    <div style="display:flex">
        @*All editing fields go in this model*@
        <div style="width:100%">
            <div style="display:flex">

                <div>
                    @*ARCHIVE and SAVE*@
                    <button class="button-save" @onclick="UpdateShortage">Save</button>
                    <br /><br />
                    @if (isArchived)
                    {
                        <button class="button-save" type="submit" @onclick="Unarchive">Unarchive</button>
                    }
                    else
                    {
                        <button class="button-save" type="submit" @onclick="Archive">Archive</button>
                    }
                    <div class="checkbox-wrapper-59" style="display:flex">
                        <label>Current Month Revenue Impact: </label>
                        <input class="checkbox" type="checkbox" id="revenue" @bind="@item.impactsRevenue" />
                    </div>

                </div>
                @*STATUS*@
                <div style="display:flex;flex-direction:column;margin-left:10px">
                    <label style="background-color:yellow;border:solid 1px">Status: @item.lateFlagStatus</label>

                    <select id="status" @bind="@item.status">
                        <option value="">No Status</option>
                        <option value="Needs PO">Needs PO</option>
                        <option value="On Order">On Order</option>
                        <option value="Confirmed">Confirmed</option>
                        <option value="Receiving Dock">Receiving Dock</option>
                        <option value="IQC">IQC</option>
                        <option value="FAI">FAI</option>
                        <option value="FAST">FAST</option>
                        <option value="MOVED">MOVED</option>
                    </select>
                    @*HOT*@
                    <div class="checkbox-wrapper-59" style="display:flex">
                        <label>Hot: </label>
                        <input class="checkbox" type="checkbox" id="hot" @bind="@item.hot" />
                    </div>
                    @*ACTION RQD/FLAG FIELD*@
                    <div style="display:flex">
                        <label>Action Rqd:</label>
                        <input class="checkbox" type="checkbox" id="actRqrd" @bind="@item.flagField" />
                    </div>
                </div>
                @*REASON*@
                <div style="display:flex;flex-direction:column;margin-left:10px;margin-right:10px">
                    <label style="background-color:yellow;border:solid 1px">Reason: @item.reason</label>
                    <select @bind="@item.reason">
                        <option value="">--Select Reason--</option>
                        <option value="Inside Lead Time">Inside Lead Time</option>
                        <option value="Pull In">Pull In</option>
                        <option value="Late PO">Late PO</option>
                        <option value="Confirm Delivery">Confirm Delivery</option>
                        <option value="Purchasing Delay">Purchasing Delay</option>
                        <option value="Tariff Approval Delay">Purchasing Delay</option>
                        <option value="Engineering">Engineering</option>
                        <option value="FAST-Supplier">FAST-Supplier</option>
                        <option value="FAST-ZYGO">FAST-ZYGO</option>
                        <option value="Inventory Discrepancy">Inventory Discrepancy</option>
                        <option value="Item Master Discrepancy">Item Master Discrepancy</option>
                        <option value="BOM Discrepancy">BOM Discrepancy</option>
                        <option value="KB Scan Missed">KB Scan Missed</option>
                        <option value="Logistic Delay">Logistic Delay</option>
                        <option value="Unpaid Invoices">Unpaid Invoices</option>
                    </select>
                    @*FEDEX/UPS*@
                    <div style="display:flex;padding-top:5px">
                        <button @onclick="FedEx" class="button-85" style="border-color:palegreen">FedEx</button>
                        <button @onclick="UPS" class="button-85" style="border-color:brown">UPS</button>
                    </div>
                    @*TRACKING NUMBER*@
                    <div style="padding-top:5px">
                        <input type="text" placeholder="Enter Tracking Number" style="font-size:12px; width:150px; height:20px;" @bind="@item.trackingNo" />
                    </div>
                </div>
                @*PROMISED/IQC/REQUIRED DATES*@
                <div style="display:flex;flex-direction:column;margin-left:10px;margin-right:10px;font-size:12px">
                    <label>Promised Receipt Date</label>
                    <input type="date" id="plannedreceiptdate" @bind="item.promisedReceiptDate" />
                    <label>IQC Complete Date</label>
                    <input type="date" id="iqccompletedate" @bind="@item.iqcCompleteDate" />
                    <label>Planner Required Date</label>
                    <input type="date" id="plannercompletedate" @bind="@item.reqDate" />
                </div>
                @*ADD COMMENT*@
                <div style="width:100%;display:flex">
                    <div style="width:100%;display:flex; flex-direction:column">
                        <label style="font-size:12px;">Add Comment:</label>
                        <textarea style="width: 99%; height: 100px;max-height:200px" @bind="@newComment"></textarea>
                    </div>
                </div>
            </div>
            @*Input boxes to be able to modify values in certain fields in shortage list entry *@
            <div style="display:flex;font-size:13px; padding-top:5px">
                <label>Production Order:</label>
                <input type="text" style="width: 150px; height: 20px;margin-right:10px;" @bind="@item.productionOrder" />
                <label>Sales Order:</label>
                <input type="text" style="width: 150px; height: 20px;margin-right:10px;" @bind="@item.salesOrder" />
                <label>Sales Order Line:</label>
                <input type="number" style="width: 150px; height: 20px;margin-right:10px;" @bind="@item.SOLineNum" />
                <label>Ship Date:</label>
                <input type="date" style="width: 150px; height: 20px;margin-right:10px;" @bind="@item.shipDate" />
                <label>Sales Order Date:</label>
                <input type="date" style="width: 150px; height: 20px;margin-right:10px;" @bind="@item.salesOrderDate" />
                <label>Change Buyer:</label>
                <input type="text" style="width: 150px; height: 20px;margin-right:10px;" @bind="@item.buyer" />
                <label>Change Vendor:</label>
                <input type="text" style="width: 150px; height: 20px;margin-right:10px;" @bind="@item.vendor" />
            </div>
        </div>
        @*COMMENT TABLE*@
        <Table dt="@CommentsDT" TableStyle="table-comments" prodLine="@item.prodLine"></Table>
    </div>
    @*ITEM MASTER TABLE*@
    <div style="width:100%">
        <label style="font-size:12px">Item Master Data</label>
        <ItemMasterData dt="@itemMasterDT"
                        itemCode="@item.code"
                        Allocations="@Allocation"
                        nonnetStock="@nonnetStock"
                        onOrder="@onOrder"
                        blockedStock="@blockedStock"
                        nettableStock="@nettableStock"
                        prodLine="@item.prodLine">
        </ItemMasterData>
    </div>

    <div style="display:flex">
        @*PLANNED STOCK TABLE*@
        <div style="width:70%;flex-direction:column;">
            <label style="font-size:12px">Planned Stock Transactions</label>
            <Table dt="@PlannedStockDT" TableStyle="table-planned-stock" prodLine="@item.prodLine"></Table>
        </div>
        @*CHANGE HISTORY TABLE*@
        <div style="width:30%;flex-direction:column;">
            <label style="font-size:12px">Promised Receipt Date Change History</label>
            <Table dt="@HistoryDT" TableStyle="table-history" prodLine="@item.prodLine"></Table>
        </div>
    </div>

    @*PURCHASE ORDER TABLE*@
    <label style="font-size:12px">Purchase Orders (Open)</label>
    <Table dt="@PurchOrdDT" TableStyle="table-purchase" prodLine="@item.prodLine"></Table>

    <div style="width:100%;display:flex">
        @*RECEIPTS TABLE*@
        <div style="width:50%;flex-direction:column">
            <label style="font-size:12px">Receipts (Awaiting QC)</label>
            <Table dt="@ReceiptsDT" TableStyle="table-receipts" prodLine="@item.prodLine"></Table>
        </div>
        @*OPEN PROD TABLE*@
        <div style="width:50%;flex-direction:column">
            <label style="font-size:12px">Production Orders (Open)</label>
            <Table dt="@OpenProdDT" TableStyle="table-production" prodLine="@item.prodLine"></Table>
        </div>
    </div>

    <div style="display:flex">
        @*TRACKING WAREHOUSE TABLE*@
        <div style="width:45%;flex-direction:column">
            <label style="font-size:12px">Tracker Info (Moved out to warehouse in last 7 days)</label>
            <Table dt="@TrackWarehouseDT" TableStyle="table-warehouse" prodLine="@item.prodLine"></Table>
        </div>
        @*TRACKING QC TABLE*@
        <div style="width:45%;flex-direction:column">
            <label style="font-size:12px">Tracker Info (Moved out by QC operator in last 7 days)</label>
            <Table dt="@TrackQCDT" TableStyle="table-qc" prodLine="@item.prodLine"></Table>
        </div>
        <button class="button-85" style="height:100%;margin-top:24px;margin-left:25px" @onclick="TrackReport">Tracking Details</button>
    </div>
</body>

@*LOADING SPINNER*@
@if (spinner)
{
    <section class="overlay-container">
        <div class="loading-spinner">
            <div class="spinner" style="position:fixed;top:50%;left:50%;transform:translate(-50%, -50%)"></div>
        </div>
    </section>
}

@*POPUPS*@
<div class="popup-overlay @(pop.IsVisible ? "visible" : "")">
    <div class="popup-content">
        <h3>@pop.Title</h3>
        <p>@pop.Message</p>
        <button class="button-85" @onclick="pop.ClosePopup">Close</button>
    </div>
</div>

@code {
    public string shortageID;
    public PopUp pop = new PopUp();

    public Shortage item = new Shortage();
    public DateTime? OrigCurrDueDate;

    public DataTable? ShortageDT;
    public DataTable? ReceiptsDT;
    public DataTable? PlannedStockDT;
    public DataTable? OpenProdDT;
    public DataTable? CommentsDT;
    public DataTable? HistoryDT;
    public DataTable? TrackWarehouseDT;
    public DataTable? PurchOrdDT;
    public DataTable? TrackQCDT;
    public DataTable? ProdLineDT;

    public DataTable? itemMasterDT;
    public string? Allocation;
    public string? nonnetStock;
    public string? onOrder;
    public string? blockedStock;
    public string? nettableStock;

    public string newComment = "";
    public string BackgroundColor = "white";
    private bool spinner = false;
    private bool isArchived;


    public int shortNum = 0;
    public int ProdLineNumShortages;

    //TRACKING FEDEX/UPS BUTTONS------------------------------------------
    public void FedEx()
    {
        string track = "https://www.fedex.com/apps/fedextrack/?tracknumbers=" +
        item.trackingNo.Trim() + "&commit=Track%21";
        JSRuntime.InvokeVoidAsync("openNewTab", track);
    }

    public void UPS()
    {
        string track = "https://www.ups.com/track?loc=en_US&requester=ST/";
        JSRuntime.InvokeVoidAsync("openNewTab", track);
    }

    //ARCHIVE/UNARCHIVE-----------------------------------
    public void Archive()
    {
        SqlConnection cnxn = new SqlConnection(Databases.db);
        SqlParameter pID = new SqlParameter("@ID", SqlDbType.Int);
        pID.Value = item.ID;
        SqlParameter pWhoArchived = new SqlParameter("@WhoArchived", SqlDbType.VarChar);
        string user = auth.GetAuthenticationStateAsync().Result.User.Identity.Name;
        if (user.StartsWith("Z"))
        {
            user = user.Replace("ZYGOMIS\\", "");
        }
        else
        {
            user = user.Replace("AMETEK-AD\\", "");
        }
        pWhoArchived.Value = user;
        SqlParameter pDateArchived = new SqlParameter("@DateArchived", SqlDbType.Date);
        pDateArchived.Value = DateTime.Now;

        SqlCommand cmd = new SqlCommand("UPDATE Shortage_List SET " +
        "WhoArchived = " + pWhoArchived + "," +
        "DateArchived = " + pDateArchived +
        " WHERE ID = " + pID, cnxn);

        cmd.Parameters.Add(pWhoArchived);
        cmd.Parameters.Add(pDateArchived);
        cmd.Parameters.Add(pID);


        try
        {
            cnxn.Open();
            cmd.ExecuteNonQuery();
            cnxn.Close();
        }
        catch (SqlException ex)
        {
            pop.Title = "Error";
            pop.Message = ex.ToString();
            pop.ShowPopup();
            return;
        }

        pop.Title = "Success";
        pop.Message = item.ID + " has been archived.";
        pop.ShowPopup();
        isArchived = true;
        StateHasChanged();
    }

    public void Unarchive()
    {
        SqlConnection cnxn = new SqlConnection(Databases.db);
        SqlParameter pID = new SqlParameter("@ID", SqlDbType.Int);
        pID.Value = item.ID;

        SqlCommand cmd = new SqlCommand("UPDATE Shortage_List SET " +
        "WhoArchived = NULL," +
        "DateArchived = NULL" +
        " WHERE ID = " + pID, cnxn);

        cmd.Parameters.Add(pID);


        try
        {
            cnxn.Open();
            cmd.ExecuteNonQuery();
            cnxn.Close();
        }
        catch (SqlException ex)
        {
            pop.Title = "Error";
            pop.Message = ex.ToString();
            pop.ShowPopup();
            return;
        }

        pop.Title = "Success";
        pop.Message = item.ID + " has been unarchived.";
        pop.ShowPopup();
        isArchived = false;
        StateHasChanged();
    }

    private void UpdatePromised()
    {
        SqlConnection cnxn = new SqlConnection(Databases.db);

        if (OrigCurrDueDate != item.promisedReceiptDate)
        {
            cnxn.Open();
            //First handle saving edits and reloading comments
            SqlCommand cmd = new SqlCommand("UPDATE Shortage_List SET " +
            "CurrDueDate = @Promised " +
            "WHERE ID = @ID", cnxn);
            cmd.Parameters.Add(new SqlParameter("@Promised", (item.promisedReceiptDate == null)
            ? new DateTime(1900, 01, 01) : item.promisedReceiptDate));
            cmd.Parameters.Add(new SqlParameter("@ID", item.ID));


            try
            {
                cmd.ExecuteNonQuery();
            }
            catch (SqlException ex)
            {
                pop.Title = "Error";
                pop.Message = ex.ToString();
                pop.ShowPopup();
            }
            finally
            {

                SqlCommand cmd1 = new SqlCommand("UPDATE Shortage_List " +
                           "SET PreviousCurrDueDate = '" + item.promisedReceiptDate + "' " +
                           "WHERE ID = @ID", cnxn);
                cmd1.Parameters.Add(new SqlParameter("@ID", item.ID));

                try
                {
                    cmd1.ExecuteNonQuery();
                }
                catch (SqlException ex)
                {

                }


                cnxn.Close();
            }
        }

    }

    public async void UpdateShortage()
    {
        SqlConnection cnxn = new SqlConnection(Databases.db);


        //First handle saving edits and reloading comments
        SqlCommand cmd = new SqlCommand("UPDATE Shortage_List SET " +
        "HOT = @HOT " +
        ",ItemStatus = @ItemStatus " +
        ",Reason = @Reason " +
        ",FlagField = @FlagField " +
        ",ShipmentTrackingNumber = @ShipmentTrackingNumber " +
        ",IQCCompleteDate = @IQCCompleteDate " +
        ",PlannerRequiredDate = @PlannerRequiredDate " +
        ",ProdOrder = @ProdOrder " +
        ",SalesOrder = @SalesOrder " +
        ",ShipDate = @ShipDate " +
        ",SODate = @SODate " +
        ",SOLineNo = @SOLineNo " +
        ",Buyer = @Buyer " +
        ",Supplier = @Vendor " +
        ",ImpactsRevenue = @ImpactsRevenue " +
        "WHERE ID = @ID", cnxn);

        cmd.Parameters.Add(new SqlParameter("@HOT", item.hot ? -1 : 0));
        cmd.Parameters.Add(new SqlParameter("@ItemStatus", (item.status == null)
        ? DBNull.Value : item.status));
        cmd.Parameters.Add(new SqlParameter("@Reason", (item.reason == null)
        ? DBNull.Value : item.reason));
        cmd.Parameters.Add(new SqlParameter("@FlagField", (item.flagField) ? -1 : 0));
        cmd.Parameters.Add(new SqlParameter("@ShipmentTrackingNumber", (item.trackingNo == null)
        ? DBNull.Value : item.trackingNo));
        cmd.Parameters.Add(new SqlParameter("@IQCCompleteDate", (item.iqcCompleteDate == null)
        ? new DateTime(1990, 01, 01) : item.iqcCompleteDate));
        cmd.Parameters.Add(new SqlParameter("@PlannerRequiredDate", (item.reqDate == null)
        ? new DateTime(1990, 01, 01) : item.reqDate));
        cmd.Parameters.Add(new SqlParameter("@ProdOrder", (item.productionOrder == null)
        ? DBNull.Value : item.productionOrder));
        cmd.Parameters.Add(new SqlParameter("@SalesOrder", (item.salesOrder == null)
        ? DBNull.Value : item.salesOrder));
        cmd.Parameters.Add(new SqlParameter("@ShipDate", (item.shipDate == null)
        ? DBNull.Value : item.shipDate));
        cmd.Parameters.Add(new SqlParameter("@SODate", (item.salesOrderDate == null)
        ? new DateTime(1990, 01, 01) : item.salesOrderDate));
        cmd.Parameters.Add(new SqlParameter("@SOLineNo", (item.SOLineNum == null)
        ? DBNull.Value : item.SOLineNum));
        cmd.Parameters.Add(new SqlParameter("@Buyer", (item.buyer == null)
        ? DBNull.Value : item.buyer));
        cmd.Parameters.Add(new SqlParameter("@ID", item.ID));
        cmd.Parameters.Add(new SqlParameter("@Vendor", (item.vendor == null)
        ? DBNull.Value : item.vendor));
        cmd.Parameters.Add(new SqlParameter("@ImpactsRevenue", item.impactsRevenue));

        cnxn.Open();
        try
        {
            cmd.ExecuteNonQuery();
        }
        catch (SqlException ex)
        {
            pop.Title = "Error";
            pop.Message = ex.ToString();
            pop.ShowPopup();
        }
        finally
        {
            cnxn.Close();
            pop.Title = "Success";
            pop.Message = "Shortage " + item.ID + " has been saved";
            pop.ShowPopup();
        }

        if (newComment != "")
        {
            await JSRuntime.InvokeVoidAsync("console.log", newComment);
            addComment(newComment.Trim());
            await ReloadComments();

        }
        UpdatePromised();
        await ReloadBuyer();

        StateHasChanged();
    }

    public async void addComment(string comment)
    {
        SqlConnection cnxn = new SqlConnection(Databases.db);
        SqlParameter pID = new SqlParameter("@ShortageID", SqlDbType.Int);
        pID.Value = item.ID;
        SqlParameter pComment = new SqlParameter("@Comment", SqlDbType.NVarChar);
        pComment.Value = comment;

        SqlParameter pEnteredBy = new SqlParameter("@EnteredBy", SqlDbType.VarChar);

        string user = auth.GetAuthenticationStateAsync().Result.User.Identity.Name;
        if (user.StartsWith("Z"))
        {
            user = user.Replace("ZYGOMIS\\", "");
        }
        else
        {
            user = user.Replace("AMETEK-AD\\", "");
        }
        pEnteredBy.Value = user;
        await JSRuntime.InvokeVoidAsync("console.log", user);
        await JSRuntime.InvokeVoidAsync("console.log", item.ID);

        SqlCommand cmd = new SqlCommand(
            "Insert into shortagelistcomments (" +
            " ShortageID " +
            ", Comment " +
            ", EnteredBy " +
            ", EnteredOn) " +
            "values (" +
            pID + "," +
            pComment + "," +
            pEnteredBy + "," +
            "GETDATE())", cnxn);
        cmd.Parameters.Add(pID);
        cmd.Parameters.Add(pComment);
        cmd.Parameters.Add(pEnteredBy);

        try
        {
            cnxn.Open();
            cmd.ExecuteNonQuery();

        }
        catch (SqlException ex)
        {
            pop.Title = "Error";
            pop.Message = ex.ToString();
            pop.ShowPopup();
        }
        await ReloadComments();
        cnxn.Close();

    }

    //Call this after a new comment is added to ensure updated table
    public async Task ReloadComments()
    {
        SqlConnection cnxn = new SqlConnection(Databases.db);
        SqlCommand cmd = new SqlCommand(" SELECT " +
                    "  RTRIM(Comment) Comment " +
                    " ,RTRIM(EnteredBy) as [by] " +
                    " ,EnteredOn AS [Date of Change] " +
                    " FROM ShortageListComments " +
                    " WHERE ShortageID = " + item.ID +
                    " ORDER BY CommentID  DESC", cnxn);
        await cnxn.OpenAsync();
        CommentsDT = GetDataTable(cmd);
        cnxn.Close();
    }

    public async Task ReloadBuyer()
    {
        SqlConnection cnxn = new SqlConnection(Databases.db);
        SqlParameter pShortageID = new SqlParameter("@ID", item.ID);
        SqlCommand cmd = new SqlCommand("select " +
                                                "[ID]," +
                                                "[GROUP]," +
                                                "[STKOUT]," +
                                                "[QtyNeeded]," +
                                                "CONVERT(varchar,DateAddedToList,1) AS [List Date]," +
                                                "DATEDIFF(D, DateAddedtoList, GETDATE()) AS [Days on List]," +
                                                "[Custom Item]," +
                                                "[PO]," +
                                                "[QTY], " +
                                                "[WarBoardDate]," +
                                                "[whoAdded]," +
                                                "[Project]," +
                                                "[PROJECTDESC]," +
                                                "[Supplier]," +
                                                "[Buyer]," +
                                                "CONVERT(varchar,[Orig_ Requested Receipt Date],1) [Orig_ Requested Receipt Date] " +
                                        "FROM Shortage_List " +
                                        "WHERE [ID] = " + pShortageID, cnxn);
        cmd.Parameters.Add(pShortageID);
        await cnxn.OpenAsync();
        ShortageDT = GetDataTable(cmd);
        cmd.Parameters.Clear();
        cnxn.Close();
    }

    protected override async Task OnInitializedAsync()
    {
        SqlConnection cnxn = new SqlConnection(Databases.db);
        cnxn.Open();

        SqlParameter pShortageID = new SqlParameter("@ID", SqlDbType.VarChar);
        pShortageID.Value = Views.currentShortageID;
        SqlCommand cmd = new SqlCommand("select [DateArchived] " +
                                        "FROM Shortage_List " +
                                        "WHERE ID = " + pShortageID, cnxn);
        cmd.Parameters.Add(pShortageID);
        using (SqlDataReader reader = cmd.ExecuteReader())
        {
            if (reader.HasRows)
            {
                while (reader.Read())
                {
                    isArchived = reader.IsDBNull(0) ? false : true;
                }
            }
            cmd.Parameters.Clear();
        }
        cnxn.Close();

        await getTables(Views.currentShortageID);
        StateHasChanged();
    }



    public async Task getTables(string shortageID)
    {
        //Start connection to Access Front Ends---------------------------------------
        //Get item code from shortageID
        SqlConnection cnxn = new SqlConnection(Databases.db);
        await cnxn.OpenAsync();
        string fromSQL;
        if (isArchived)
        {
            fromSQL = ",[WhoArchived],[DateArchived] FROM Shortage_List WHERE ID = ";
        }
        else
        {
            fromSQL = ",[LateFlag] FROM Shortage_List f " +
                      "INNER JOIN Shortage_ActiveFlags l " +
                      "ON l.id = f.id " +
                      "WHERE l.ID = ";
        }

        SqlParameter pShortageID = new SqlParameter("@ID", SqlDbType.VarChar);
        pShortageID.Value = shortageID;
        SqlCommand cmd = new SqlCommand(
            "select " +
            "[PRODUCTLINE]" +
            ",[GROUP]" +
            ",[STKOUT]" +
            ",[QtyNeeded]" +
            ",[ItemCode]" +
            ",[Custom Item]" +
            ",[Description]" +
            ",[PROJECT]" +
            ",[PROJECTDESC]" +
            ",[PO]" +
            ",[ProdOrder]" +
            ",[SalesOrder]" +
            ",[SOLineNo]" +
            ",[SODate]" +
            ",[ShipDate]" +
            ",[PlannerRequiredDate]" +
            ",[Comments]" +
            ",[Buyer]" +
            ",[HOT]" +
            ",[Reason]" +
            ",[ItemStatus]" +
            ",[CurrDueDate]" +
            ",[IQCCompleteDate]" +
            ",[ShipmentTrackingNumber]" +
            ",[FlagField]" +
            ",[Supplier]" +
            ",ImpactsRevenue " +
            fromSQL + pShortageID, cnxn);
        cmd.Parameters.Add(pShortageID);

        DataTable dt = new DataTable();
        SqlDataReader dr = cmd.ExecuteReader();
        dt.Load(dr);

        using (SqlDataReader reader = cmd.ExecuteReader())
        {
            if (reader.HasRows)
            {
                while (reader.Read())
                {
                    item.ID = shortageID;
                    item.prodLine = reader.GetString(0);
                    item.group = reader.IsDBNull(1) ? null : reader.GetString(1);
                    item.code = reader.GetString(4);
                    item.productionOrder = reader.IsDBNull(10) ? null : reader.GetString(10);
                    item.salesOrder = reader.IsDBNull(11) ? null : reader.GetString(11);
                    item.SOLineNum = reader.IsDBNull(12) ? null : int.Parse(reader.GetString(12));
                    item.salesOrderDate = reader.IsDBNull(13) ? null : reader.GetDateTime(13);
                    item.shipDate = reader.IsDBNull(14) ? null : reader.GetDateTime(14);
                    item.reqDate = reader.GetDateTime(15);
                    item.buyer = reader.GetString(17);
                    item.hot = (reader.GetInt32(18) == -1);
                    item.reason = reader.IsDBNull(19) ? null : reader.GetString(19).Trim();
                    item.status = reader.IsDBNull(20) ? null : reader.GetString(20);
                    item.promisedReceiptDate = reader.IsDBNull(21) ? null : reader.GetDateTime(21);
                    OrigCurrDueDate = item.promisedReceiptDate;
