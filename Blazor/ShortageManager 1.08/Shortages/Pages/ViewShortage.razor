    private async Task LoadProdLineDataAsync()
    {
        //Start connection to Access Front Ends---------------------------------------
        //Get item code from shortageID
        SqlConnection cnxn = new SqlConnection(Databases.db);
        Views.currentProdLine = Views.currentProdLine.Trim();
        await cnxn.OpenAsync();

        string SQL = "SELECT " +
                         "l.ID " +
                         "FROM Shortage_List l " +
                         "INNER JOIN ShortageList_ActiveFlags f " +
                         "ON l.id = f.id " +
                         "WHERE ";

        string order = "ORDER BY (CASE WHEN ItemStatus = 'IQC' THEN 1 ELSE 0 END), " +
        "buyer, sortgroup, lateflagsort, itemstatussort, prodline, itemcode, l.id";

        string SQL1 = string.Empty;


        if (Views.currentProdLine == "LAS" || Views.currentProdLine == "PROFILER" || Views.currentProdLine == "CMS")
        {
            SQL1 = SQL +
                "prodline = '" + Views.currentProdLine + "' AND ActionFlag = -1 " +
                "ORDER BY (CASE WHEN ItemStatus = 'IQC' THEN 1 ELSE 0 END), " +
                "buyer, sortgroup, lateflagsort, itemstatussort, prodline, itemcode, l.id";
        }
        else if (Views.currentProdLine == "OPT" )
        {
            SQL1 = SQL + " prodline = '" + Views.currentProdLine + "' AND ActionFlag = -1 " + order;
        }
        else if (Views.currentProdLine == "WAR")
        {
            SQL1 = SQL + " OnWarRoomList = 1 AND ActionFlag = -1 ORDER BY ProdLine, Priority";
        }
        else
        {
            SQL1 = SQL + " prodline = '" + Views.currentProdLine + "' AND ActionFlag = -1 " + order;
        }



        ProdLineDT = GetDataTable(new SqlCommand(SQL1, cnxn));
        cnxn.Close();
        ProdLineNumShortages = ProdLineDT.Rows.Count;

        for (int i = 0; i < ProdLineNumShortages; i++)
        {
            DataRow row = ProdLineDT.Rows[i];
            string shortageID = row["ID"].ToString();
            isArchived.Add(false);


            if (i < 2)
            {
                await getTables(shortageID, i);
                await InvokeAsync(StateHasChanged);
                await Task.Delay(1);
            }
            else
            {
                await Task.Run(() => getTables(shortageID, i));
            }

        }
        StateHasChanged();
    }


    public async Task getTables(string shortageID, int i = 0)
    {
        //Start connection to Access Front Ends---------------------------------------
        //GET SHORTAGE FIELDS FIRST FROM SHORTAGE_LIST
        itemsList.Add(new Shortage());
        SqlConnection cnxn = new SqlConnection(Databases.db);
        await cnxn.OpenAsync();

        SqlParameter pShortageID = new SqlParameter("@ID", SqlDbType.VarChar);
        pShortageID.Value = shortageID;
        SqlCommand cmd = new SqlCommand("SELECT " +

            "TRIM([PRODLINE])" +    //0
            ",[QtyNeeded]" +
            ",[ItemCode]" +
            ",[Custom Item]" +
            ",[Description]" +
            ",[PROJECT]" +          //5
            ",[PROJECTDESC]" +
            ",[PO]" +
            ",[ProdOrder]" +
            ",[SalesOrder]" +
            ",[SOLineNo]" +         //10
            ",[SODate]" +
            ",[ShipDate]" +
            ",[PlannerRequiredDate]" +
            ",[Comments]" +
            ",[Buyer]" +            //15
            ",[Reason]" +
            ",[ItemStatus]" +
            ",[Promised Receipt Date]" +
            ",[IQCCompleteDate]" +
            ",[ShipmentTrackingNumber]" +   //20
            ",[FlagField]" +
            ",LateFlag " +
            ",[Supplier]" +
            ",Priority " +
            ",OnWarRoomList " +         //25
            "FROM Shortage_List l " +
            "INNER JOIN Shortage_ActiveFlags f " +
            "ON l.id = f.id " +
            "WHERE l.ID = " + pShortageID, cnxn);
        cmd.Parameters.Add(pShortageID);

        DataTable dt = new DataTable();
        SqlDataReader dr = cmd.ExecuteReader();
        dt.Load(dr);

        using (SqlDataReader reader = cmd.ExecuteReader())
        {
            if (reader.HasRows)
            {
                while (reader.Read())
                {
                    itemsList[i].ID = shortageID;
                    itemsList[i].prodLine = reader.GetString(0);
                    itemsList[i].code = reader.IsDBNull(2) ? null : reader.GetString(2);  // reader.GetString(3);
                    itemsList[i].productionOrder = reader.IsDBNull(8) ? null : reader.GetString(8);
                    itemsList[i].salesOrder = reader.IsDBNull(9) ? null : reader.GetString(9);
                    itemsList[i].SOLineNum = reader.IsDBNull(10) ? null : int.Parse(reader.GetString(10));
                    itemsList[i].salesOrderDate = reader.IsDBNull(11) ? null : reader.GetDateTime(11);
                    itemsList[i].shipDate = reader.IsDBNull(12) ? null : reader.GetDateTime(12);
                    itemsList[i].reqDate = reader.GetDateTime(13);
                    itemsList[i].buyer = reader.GetString(15);
                    itemsList[i].reason = reader.IsDBNull(16) ? null : reader.GetString(16).Trim();
                    itemsList[i].status = reader.IsDBNull(17) ? null : reader.GetString(17);
                    itemsList[i].promisedReceiptDate = reader.IsDBNull(18) ? null : reader.GetDateTime(18);
                    OrigCurrDueDates.Add(itemsList[i].promisedReceiptDate);
                    itemsList[i].iqcCompleteDate = reader.IsDBNull(19) ? null : reader.GetDateTime(19);
                    itemsList[i].trackingNo = reader.IsDBNull(20) ? null : reader.GetString(20);
                    itemsList[i].flagField = (reader.GetInt32(21) == -1);
                    itemsList[i].lateFlagStatus = reader.IsDBNull(22) ? "" : reader.GetString(22);
                    itemsList[i].vendor =  reader.IsDBNull(23) ? "" :reader.GetString(23);
                    itemsList[i].priority = reader.IsDBNull(24) ? "" : reader.GetString(24);
                    itemsList[i].onWarRoomList = reader.IsDBNull(25) ? false : reader.GetBoolean(25);
                }
            }
            else
            {

            }
            cmd.Parameters.Clear();
        }

        SqlParameter pID = new SqlParameter("@ID", SqlDbType.VarChar);
        pID.Value = shortageID;
        SqlCommand cmd1 = new SqlCommand("UPDATE Shortage_List " +
                           "SET previousCurrDueDate = CurrDueDate " +
                           "WHERE ID = " + pID, cnxn);

        cmd1.Parameters.Add(pID);
        

        try
        {
            cmd1.ExecuteNonQuery();
        }
        catch (SqlException ex)
        {
            pop.Title = "Error";
            pop.Message = ex.ToString();
            pop.ShowPopup();
        }

        //SHORTAGE TABLE
        ShortageDTList.Add(new DataTable());
        pShortageID = new SqlParameter("@ID", SqlDbType.VarChar);
        pShortageID.Value = shortageID;
        cmd = new SqlCommand("select " +
                            " [ID]" +
                            ",[QtyNeeded]" +
                            ",CONVERT(varchar,DateAddedToList,1) AS [List Date]" +
                            ",DATEDIFF(D, DateAddedtoList, GETDATE()) AS [Days on List]" +
                            ",[Custom Item]" +
                            ",[PO]" +
                            ",[QTY] " +
                            ",[whoAdded]" +
                            ",[Project]" +
                            ",[PROJECTDESC]" +
                            ",[Supplier]" +
                            ",[Buyer]" +
                            ",CONVERT(varchar,[Orig_ Requested Receipt Date],1) [Orig_ Requested Receipt Date] " +
                            ",OnWarRoomList " +
                            ",ProdLine " +
                            "FROM Shortage_List " +
                            "WHERE [ID] = " + pShortageID, cnxn);
        cmd.Parameters.Add(pShortageID);
        ShortageDTList[i] = GetDataTable(cmd);
        cmd.Parameters.Clear();



        //COMMENTS
        CommentsDTList.Add(new DataTable());
        cmd = new SqlCommand(" SELECT " +
                    "  RTRIM(Comment) Comment " +
                    " ,RTRIM(EnteredBy) as [by] " +
                    " ,EnteredOn AS [Date of Change] " +
                    " FROM ShortageListComments " +
                    " WHERE ShortageID = " + pShortageID +
                    " ORDER BY CommentID  DESC", cnxn);
        cmd.Parameters.Add(pShortageID);
        CommentsDTList[i] = GetDataTable(cmd);
        cmd.Parameters.Clear();

        //CHANGE HISTORY
        HistoryDTList.Add(new DataTable());
        cmd = new SqlCommand("select " +
                    "LogDate AS [Date of Change], " +
                    "ConfDueDateValue AS Value " +
                    "FROM Shortage_ConfDueDate_Change_Log " +
                    "WHERE ShortageID = " + pShortageID +
                    " ORDER BY LogDate DESC", cnxn);
        cmd.Parameters.Add(pShortageID);
        HistoryDTList[i] = GetDataTable(cmd);
        cmd.Parameters.Clear();

        //TRACKER QC
        TrackQCDTList.Add(new DataTable());
        TrackQCDTList[i] = GetDataTable(new SqlCommand("select DISTINCT" +
                        "  MovedOutDate AS [DATE MOVED OUT]" +
                        " ,OperatorName as [MOVED BY]" +
                        " ,MovedOutQty AS [QTY MVD]" +
                        " ,MkReceiptTransactionID AS [TRKR ID]" +
                        " ,Location AS LOCATION" +
                        " ,SignatureName AS SIGNATURE " +
                        " FROM Shortages_Tracking_MoveOut_STK where partNumber = '" +
                        itemsList[i].code + "'  and LEN(operatorname) > 0 "
                        , cnxn));


        //TRACKER WAREHOUSE
        TrackWarehouseDTList.Add(new DataTable());
        TrackWarehouseDTList[i] = GetDataTable(new SqlCommand("select DISTINCT " +
                                "  MovedOutDate AS [DATE MOVED OUT]" +
                                " ,SignatureName AS INSPECTOR" +
                                " ,MovedOutQty AS [QTY MVD]" +
                                " ,MkReceiptTransactionID AS [TRKR ID] " +
                                " ,ReceiptNumber AS RCPT" +
                                " ,Location AS LOCATION " +
                                " FROM Shortages_Tracking_MoveOut_QC where partNumber = '" +
                                itemsList[i].code + "'  and LEN(operatorname) > 0 "
                                    , cnxn));

        //RECEIPTS
        ReceiptsDTList.Add(new DataTable());
        ReceiptsDTList[i] = GetDataTable(new SqlCommand("SELECT " +
                        " Order_No PO " +
                        ",Position_Number POS " +
                        ", CONVERT (Varchar(8),[ReceivedDate], 1)[DT RCVD] " +
                        ", ReceivedQty[DEL QTY] " +
                        ", FORMAT(Quantity, 'N0')[Qty @QC] " +
                        ", MkReceiptTransactionID[TRKR ID] " +
                        ", ReceiptNumber RCPT " +
                        ", QualityInspectorAssigned INSPR " +
                        ", FORMAT(QualityPriority, 'N0') PRI " +
                        " FROM [Local_Dash_NAV_Receipts] r " +
                        " left join[Shortage NAV Warehouse Entry] S1 on " +
                        " s1.[Item No_] = r.PartNumber " +
                        " and s1.[Source No_] = r.Order_no " +
                        " and(s1.[Source Line No_] / 1000) = r.Position_Number " +
                        "WHERE " +
                        "(MKReceiptTransactionID in " +
                        "(select distinct MKReceiptTransactionID from Local_Dash_View_Tracking " +
                        "where MovedToDate > (GETDATE() - 365) " +
                        "AND MovedOutDate is null)) " +
                        "AND Quantity > 0 and [Bin Code] like '%IQC%' " +
                        "AND [PartNumber] = '" + itemsList[i].code + "' ORDER BY 1", cnxn));




        cnxn.Close();
        //CLOSE connection to Access Front Ends ------------------------------------------

        //Start connection to NAV-------------------------------------------------------
        SqlConnection NAVcnxn = new SqlConnection(Databases.dbNAV);
        NAVcnxn.Open();


        //PURCHASE ORDERS
        PurchOrdDTList.Add(new DataTable());
        PurchOrdDTList[i] = GetDataTable(new SqlCommand(
            "WITH s1 as " +
                    "( SELECT " +
                    "  [Document No_] ORDER_NO " +
                    " ,[PO Line No_] POSITION " +
                    " , CASE " +
                    "     WHEN [Orig_ Promised Receipt Date] = '1753-01-01 00:00:00.000' " +
                    "          THEN DATEDIFF(d, GETDATE(), [Promised Receipt Date]) " +
                    "     WHEN[Orig_ Promised Receipt Date] > '1753' " +
                    "          THEN DATEDIFF(d, GETDATE(), [Orig_ Promised Receipt Date]) " +
                    "   END AS POLineDaysTillDue " +
                    " FROM [" + Databases.NAVprefix + "Purchase Line] WHERE [Document Type] = 1 )" +
                    ", S2 as ( SELECT ORDER_NO, POSITION, POLineDaysTillDue " +
                    ", CASE WHEN POLineDaysTillDue <= 0 THEN null " +
                    "  WHEN POLineDaysTillDue > 0 THEN POLineDaysTillDue " +
                    "  END as POLineDaysEarly " +
                    " ,CASE WHEN POLineDaysTillDue <= 0 THEN(-1 * POLineDaysTillDue) " +
                    "  WHEN POLineDaysTillDue > 0 THEN null " +
                    "  END as POLineDaysLate FROM s1 ) " +
                    " select DISTINCT p.[Document No_][PO #] " +
                    ", p.[PO Line No_] LN " +
                    ", CONVERT (Varchar(8), p.[Requested Receipt Date], 1) [RQST RCPT DT] " +
                    ", CASE " +
                    "     WHEN [Promised Receipt Date] = '1753-01-01 00:00:00.000' " +
                    "          THEN '' " +
                    "     ELSE " +
                    "         CONVERT (Varchar(8),p.[Promised Receipt Date], 1) " +
                    "   END [PROM RCPT DT] " +
                    ", CONVERT (Varchar(8),p.[Expected Receipt Date], 1) [EXPECT DT]" +
                    ", FORMAT(p.Quantity, '##0') [ORD QTY] " +
                    ", FORMAT(p.[Quantity Received], '##0') [DEL QTY] " +
                    ", FORMAT(p.[Outstanding Quantity], '##0') [BO QTY]" +
                    " , CONVERT (Varchar(8),p.[Order Date], 1) [ORD DT] " +
                    ", p.[Job No_] PROJ " +
                    ", j.[Description] [PROJ DESC] " +
                    ", p.[Prod_ Order No_] [PROD ORD], " +
                    "p.[Buy-from Vendor No_] SUPPLIER, " +
                    "s.[Name] as [Supplier Name]" +
                    ", CASE WHEN POLineDaysLate > 0 THEN 'LATE' WHEN POLineDaysLate <= 0 THEN '' END as [STA TUS] " +
                    ", CASE WHEN p.[Inspection Code] = 'I' THEN 'Y' WHEN p.[Inspection Code] <> 'I' THEN 'N' " +
                    " END [INS RQD] " +
                    ", p.[Inspection Code][Insp Code] " +
                    ", s.Contact SALES_REFERENCE " +
                    ", s.[Phone No_] TELEPHONE " +
                    ", s.[E-Mail] EMAIL " +
                    " , CASE " +
                    "     WHEN [Orig_ Promised Receipt Date] = '1753-01-01 00:00:00.000' " +
                    "          THEN '' " +
                    "     ELSE " +
                    "         CONVERT (Varchar(8),p.[Orig_ Promised Receipt Date], 1) " +
                    "   END [ORIG PROM RCPT DT] " +
                    " FROM[" + Databases.NAVprefix + "Purchase Line] p " +
                    " LEFT JOIN S2 on S2.ORDER_NO = p.[Document No_] and  S2.POSITION = p.[PO Line No_]" +
                    " LEFT JOIN[" + Databases.NAVprefix + "Vendor] s ON p.[Buy-from Vendor No_] = s.No_ " +
                    " LEFT JOIN[" + Databases.NAVprefix + "Job] j ON p.[Job No_] = j.No_ " +
                    " WHERE [Document Type] = 1 AND [Quantity Received] <> Quantity AND p.[No_] = '" + itemsList[i].code + "'" +
                    " ORDER BY 1", NAVcnxn));

        //PLANNED STOCK TRANSACTIONS
        PlannedStockDTList.Add(new DataTable());
        PlannedStockDTList[i] = GetDataTable(new SqlCommand("with S1 as " +
            "( select " +
            " c.[Item No_] " +
            ", l.[Starting Date] [TRANS DT] " +
            ",c.[Remaining Quantity] [PLN QTY] " +
            ", 'DEMAND' as [TRANS TYPE] " +
            ", 'Production Order' as [Ord Type] " +
            ",l.[Prod_ Order No_] [ORDER #] " +
            ",c.[Line No_] POS " +
            ",l.[Item No_] AS [NxL Item Code] " +
            ",l.[Job No_] " +
            " FROM " +
            " [" + Databases.NAVprefix + "Prod_ Order Line] l " +
            " INNER JOIN [" + Databases.NAVprefix + "Prod_ Order Component] c ON l.[Prod_ Order No_] = c.[Prod_ Order No_] " +
            " WHERE " +
            " c.[Item No_] = '" + itemsList[i].code + "' " +
            " AND c.[Remaining Quantity] > 0 " +
            " AND c.Status in (2,3) " +
            " UNION " +
            " SELECT " +
            " No_ [Item No_] " +
            " , [Expected Receipt Date] " +
            " , [Outstanding Quantity] " +
            " , 'SUPPLY' " +
            " , 'Purchase Order' " +
            " , [Document No_]  " +
            " , [PO Line No_]  " +
            " , '' " +
            " ,[Job No_] " +
            " FROM [" + Databases.NAVprefix + "Purchase Line] WHERE No_ = '" + itemsList[i].code + "' " +
            " AND [Outstanding Quantity] > 0" +
            "UNION " +
            " SELECT " +
            "    No_ " +
            "    ,[Due Date] [TRANS DT] " +
            "	,[Quantity] " +
            "	,'DEMAND' as [TRANS TYPE] " +
            "	,'Job Inventory Request' as [Ord Type] " +
            "	,[Document No_] " +
            "	,[Line No_] " +
            "	,'' AS[NxL Item Code] " +
            "	,[Job No_] " +
            " FROM[ZYGO$Job Journal Line] " +
            " WHERE " +
            "    [Journal Template Name] = 'INVREQ' " +
            "    AND[No_] = '" + itemsList[i].code + "' " +
            "), " +
            " S2 as " +
            " ( " +
            " SELECT COALESCE(FORMAT(SUM([Quantity]),'N0', 'en-us'), '0') OH " +
            ",e.[Item No_] " +
            " FROM [" + Databases.NAVprefix + "Item Ledger Entry] e " +
            " WHERE [Item No_] IN (SELECT [NxL Item Code] FROM S1) " +
            " GROUP BY e.[Item No_] " +
            ") " +
            " SELECT " +
            " CONVERT (Varchar(8), [TRANS DT], 1) [TRANS DT] " +
            " , FORMAT([PLN QTY], 'N0') [PLN QTY] " +
            "  ,[TRANS TYPE] " +
            " ,[Job No_] [JOB NO] " +
            " ,CASE " +
            "	    WHEN [TRANS TYPE] = 'DEMAND' THEN FORMAT(([PLN QTY] * -1), 'n0') " +
            " 	    ELSE FORMAT([PLN QTY], 'n0') " +
            "  END AS [INV CHG] " +
            ",[Ord Type] [ORD TYPE] " +
            ",[ORDER #] " +
            ",POS " +
            ",[NxL Item Code] [NxL ITEM CODE] " +
            ", COALESCE(OH,  '0') OH " +
            " FROM S1 LEFT JOIN S2 on S1.[NxL Item Code] = S2.[Item No_] " +
            " ORDER BY S1.[TRANS DT] ", NAVcnxn));

        //Open Production Orders
        OpenProdDTList.Add(new DataTable());
        OpenProdDTList[i] = GetDataTable(new SqlCommand(
        "select DISTINCT " +
            "  p.[Prod_ Order No_] AS [PROD ORD]" +
            ",CONVERT(varchar,[Starting Date],1) AS [START DT] " +
            ",FORMAT([Remaining Quantity], '##0') [ORD QTY]" +
            ",FORMAT([Finished Quantity],'##0') [POSTED QTY]" +
            " ,CONVERT(varchar,[Due Date],1) AS [DUE DT] " +
            ", CASE " +
            "     WHEN[Due Date] <= GETDATE() THEN 'OVDUE' " +
            "     WHEN[Due Date] <= (GETDATE() - 14) THEN 'LATE' " +
            "END [STATUS] " +
            ", p.[Job No_] AS [JOB NO] " +
            ", l.[Purch_ Order No_] AS PO " +
            ", l.[Expected Receipt Date] AS [PO DEL Dt] " +
            " FROM [" + Databases.NAVprefix + "Prod_ Order Line] p " +
            " LEFT JOIN[" + Databases.NAVprefix + "Purchase Line] l ON p.[Prod_ Order No_] = l.[Prod_ Order No_] " +
            " WHERE p.[Item No_] = '" + itemsList[i].code + "' AND Status = 3 ", NAVcnxn));


        //ITEM MASTER DATA
