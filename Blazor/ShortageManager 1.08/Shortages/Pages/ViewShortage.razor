@page "/viewshortage"
@inject NavigationManager Nav
@inject ViewShortageService Views
@inject AuthenticationStateProvider auth;
@inject IJSRuntime JSRuntime
@* <style>
    body{
        background-color: @BackgroundColor;
    }
</style> *@

<body>
    @*SHORTAGE TOP TABLE*@
<Table dt="@ShortageDTList[shortNum]" TableStyle="table-shortage" prodLine="@itemsList[shortNum].prodLine" ></Table>

@*<button @onclick="UpdateShortage">update</button>*@
    <div style="display:flex">
        @*All editing fields go in this model*@
        <div style="width:100%">
            <div style="display:flex">
                <div>
                    @*NEXT/PREV*@
                    <button class="button-85" disabled="@(isLoading ? true : null)" @onclick="@Previous">PREV</button>
                    <button class="button-85" disabled="@(isLoading ? true : null)" @onclick="@Next">NEXT</button>
                    <br />
                    <label style="font-weight:700;color:grey;padding-left:45px">@((shortNum + 1).ToString()) OF @ProdLineNumShortages</label>
                    <br />
                    @*ARCHIVE*@
                    @if (isArchived[shortNum])
                    {
                        <button class="button-save" disabled="@(isLoading ? true : null)" type="submit" @onclick="Unarchive">Unarchive</button>
                    }
                    else
                    {
                        <button class="button-save" disabled="@(isLoading ? true : null)" type="submit" @onclick="Archive">Archive</button>
                    }
                    
                </div>
                @*STATUS*@
                <div style="display:flex;flex-direction:column;margin-left:10px">
                    <label style="background-color:yellow;border:solid 1px">Status: @itemsList[shortNum].lateFlagStatus</label>

                    <select id="status" @bind="@itemsList[shortNum].status">
                        <option value="">No Status</option>
                        <option value="Needs PO">Needs PO</option>
                        <option value="On Order">On Order</option>
                        <option value="Confirmed">Confirmed</option>
                        <option value="Receiving Dock">Receiving Dock</option>
                        <option value="IQC">IQC</option>
                        <option value="FAI">FAI</option>
                        <option value="FAST">FAST</option>
                        <option value="MOVED">MOVED</option>
                    </select>
                    <br />
                    @*PRIORITY*@
                    <div style="display:flex;flex-direction:column;margin-left:10px">
                        <label style="border:solid 4px; border-color:red">Priority: @itemsList[shortNum].priority</label>
                        <select id="priority" @bind="@itemsList[shortNum].priority">
                            <option value="">No Priority</option>
                            <option value="P1: Immediate Risk (0-2 Weeks)">P1: Immediate Risk (0-2 Weeks)</option>
                            <option value="P2: Upcoming Risk (3-4 Weeks)">P2: Upcoming Risk (3-4 Weeks)</option>
                            <option value="P3: Future Risk (5-8 Weeks)">P3: Future Risk (5-8 Weeks)</option>
                            <option value="P4: Other">P4: Other</option>
                        </select>
                        
                    </div>
                    
                </div>
                @*REASON*@
                <div style="display:flex;flex-direction:column;margin-left:10px;margin-right:10px">
                    <label style="background-color:yellow;border:solid 1px">Reason: @itemsList[shortNum].reason</label>
                    <select @bind="@itemsList[shortNum].reason">
                        <option value="">--Select Reason--</option>
                        <option value="Inside Lead Time">Inside Lead Time</option>
                        <option value="Pull In">Pull In</option>
                        <option value="Late PO">Late PO</option>
                        <option value="Purchasing Delay">Purchasing Delay</option>
                        <option value="Tariff Approval Delay">Tariff Approval Delay</option>
                        <option value="Engineering">Engineering</option>
                        <option value="FAST-Supplier">FAST-Supplier</option>
                        <option value="FAST-ZYGO">FAST-ZYGO</option>
                        <option value="Inventory Discrepancy">Inventory Discrepancy</option>
                        <option value="Item Master Discrepancy">Item Master Discrepancy</option>
                        <option value="BOM Discrepancy">BOM Discrepancy</option>
                        <option value="KB Scan Missed">KB Scan Missed</option>
                        <option value="Logistic Delay">Logistic Delay</option>
                        <option value="Unpaid Invoices">Unpaid Invoices</option>
                    </select>
                    @*FEDEX/UPS*@
                    <div style="display:flex;padding-top:5px">
                        <button @onclick="FedEx" class="button-85" style="border-color:palegreen">FedEx</button>
                        <button @onclick="UPS" class="button-85" style="border-color:brown">UPS</button>
                    </div>
                    @*TRACKING NUMBER*@
                    <div style="padding-top:5px">
                        <input type="text" placeholder="Enter Tracking Number" style="font-size:12px; width:150px; height:20px;" @bind="@itemsList[shortNum].trackingNo"/>
                    </div>
                </div>
                @*PROMISED/IQC/REQUIRED DATES*@
                <div style="display:flex;flex-direction:column;margin-left:10px;margin-right:10px;font-size:12px">
                    <label>Promised Receipt Date</label>
                    <input type="date" id="plannedreceiptdate" @bind="itemsList[shortNum].promisedReceiptDate" />
                    <label>IQC Complete Date</label>
                    <input type="date" id="iqccompletedate" @bind="@itemsList[shortNum].iqcCompleteDate"/>
                    <label>Planner Required Date</label>
                    <input type="date" id="plannercompletedate" @bind="@itemsList[shortNum].reqDate"/>
                </div>
                @*ADD COMMENT*@
                <div style="width:75%;display:flex">
                    <div style="width:99%;display:flex; flex-direction:column">
                        <label style="font-size:12px;">Add Comment:</label>
                        <textarea style="width: 100%; height: 100px;max-height:200px" @bind="@newComment"></textarea>
                    </div>
                </div>
            </div>
            @*PROD/SALES ORDERS AND DATES/CHANGE BUYER*@
            <div style="display:flex;font-size:13px; padding-top:5px">
                <label>Production Order:</label>
                <input type="text" style="width: 150px; height: 20px;margin-right:10px;" @bind="@itemsList[shortNum].productionOrder"/>
                <label>Sales Order:</label>
                <input type="text" style="width: 150px; height: 20px;margin-right:10px;" @bind="@itemsList[shortNum].salesOrder"/>
                <label>Sales Order Line:</label>
                <input type="number" style="width: 150px; height: 20px;margin-right:10px;" @bind="@itemsList[shortNum].SOLineNum"/>
                <label>Ship Date:</label>
                <input type="date" style="width: 150px; height: 20px;margin-right:10px;" @bind="@itemsList[shortNum].shipDate"/>
                <label>Sales Order Date:</label>
                <input type="date" style="width: 150px; height: 20px;margin-right:10px;" @bind="@itemsList[shortNum].salesOrderDate"/>
                <label>Change Buyer:</label>
                <input type="text" style="width: 150px; height: 20px;margin-right:10px;" @bind="@itemsList[shortNum].buyer" />
            </div>
        </div>
        @*COMMENT TABLE*@
        <Table dt="@CommentsDTList[shortNum]" TableStyle="table-comments" prodLine="@itemsList[shortNum].prodLine"></Table>
    </div>
    @*ITEM MASTER TABLE*@
    <div style="width:100%">
        <label style="font-size:12px">Item Master Data</label>
        <ItemMasterData
        dt="@itemMasterDTList[shortNum]"
        itemCode="@itemsList[shortNum].code" 
        Allocations="@Allocations[shortNum]"
        nonnetStock="@nonnetStock[shortNum]"
        onOrder="@onOrder[shortNum]"
        blockedStock="@blockedStock[shortNum]"
        nettableStock="@nettableStock[shortNum]"
        prodLine="@itemsList[shortNum].prodLine">
        </ItemMasterData>
    </div>
    
    <div style="display:flex">
        @*PLANNED STOCK TABLE*@
        <div style="width:70%;flex-direction:column;">
            <label style="font-size:12px">Planned Stock Transactions</label>
            <Table dt="@PlannedStockDTList[shortNum]" TableStyle="table-planned-stock" prodLine="@itemsList[shortNum].prodLine"></Table>
        </div>
        @*CHANGE HISTORY TABLE*@
        <div style="width:30%;flex-direction:column;">
            <label style="font-size:12px">Promised Receipt Date Change History</label>
            <Table dt="@HistoryDTList[shortNum]" TableStyle="table-history" prodLine="@itemsList[shortNum].prodLine"></Table>
        </div>
    </div>

    @*PURCHASE ORDER TABLE*@
    <label style="font-size:12px">Purchase Orders (Open)</label>
    <Table dt="@PurchOrdDTList[shortNum]" TableStyle="table-purchase" prodLine="@itemsList[shortNum].prodLine"></Table>

    <div style="width:100%;display:flex">
        @*RECEIPTS TABLE*@
        <div style="width:50%;flex-direction:column">
            <label style="font-size:12px">Receipts (Awaiting QC)</label>
            <Table dt="@ReceiptsDTList[shortNum]" TableStyle="table-receipts" prodLine="@itemsList[shortNum].prodLine"></Table>
        </div>
        @*OPEN PROD TABLE*@
        <div style="width:50%;flex-direction:column">
            <label style="font-size:12px">Production Orders (Open)</label>
            <Table dt="@OpenProdDTList[shortNum]" TableStyle="table-production" prodLine="@itemsList[shortNum].prodLine"></Table>
        </div>
    </div>

    <div style="display:flex">
        @*TRACKING WAREHOUSE TABLE*@
        <div style="width:45%;flex-direction:column">
            <label style="font-size:12px">Tracker Info (Moved out to warehouse in last 7 days)</label>
            <Table dt="@TrackWarehouseDTList[shortNum]" TableStyle="table-warehouse" prodLine="@itemsList[shortNum].prodLine"></Table>
        </div>
        @*TRACKING QC TABLE*@
        <div style="width:45%;flex-direction:column">
            <label style="font-size:12px">Tracker Info (Moved out by QC operator in last 7 days)</label>
            <Table dt="@TrackQCDTList[shortNum]" TableStyle="table-qc" prodLine="@itemsList[shortNum].prodLine"></Table>
        </div>
        <button class="button-85" style="height:100%;margin-top:24px;margin-left:25px" @onclick="TrackReport">Tracking Details</button>
    </div>
</body>

@*LOADING SPINNER*@
@if (spinner)
{
    <section class="overlay-container">
        <div class="loading-spinner">
            <div class="spinner" style="position:fixed;top:50%;left:50%;transform:translate(-50%, -50%)"></div>
        </div>
    </section>
}

@*POPUPS*@
<div class="popup-overlay @(pop.IsVisible ? "visible" : "")">
    <div class="popup-content">
        <h3>@pop.Title</h3>
        <p>@pop.Message</p>
        <button class="button-85" @onclick="pop.ClosePopup">Close</button>
    </div>
</div>

@code {

    public PopUp pop = new PopUp();

    List<Shortage> itemsList = new List<Shortage>();
    /*  IMPORTANT use shortNum to KEEP TRACK OF CURRENT SHORTAGE    */
    public int shortNum = 0; //CURRENT VIEWED SHORTAGE


    List<DateTime?> OrigCurrDueDates = new List<DateTime?>();

    //ALL DATATABLES SAVED IN LISTS
    List<DataTable> ShortageDTList = new List<DataTable>();
    public DataTable? ReceiptsDT;
    List<DataTable> ReceiptsDTList = new List<DataTable>();
    public DataTable? PlannedStockDT;
    List<DataTable> PlannedStockDTList = new List<DataTable>();
    public DataTable? OpenProdDT;
    List<DataTable> OpenProdDTList = new List<DataTable>();
    public DataTable? CommentsDT;
    List<DataTable> CommentsDTList = new List<DataTable>();
    public DataTable? HistoryDT;
    List<DataTable> HistoryDTList = new List<DataTable>();
    public DataTable? TrackWarehouseDT;
    List<DataTable> TrackWarehouseDTList = new List<DataTable>();
    public DataTable? PurchOrdDT;
    List<DataTable> PurchOrdDTList = new List<DataTable>();
    public DataTable? TrackQCDT;
    List<DataTable> TrackQCDTList = new List<DataTable>();

    //ITEM MASTER STORED DIFFERENTLY DUE TO EXTRA COMPUTING
    List<DataTable> itemMasterDTList = new List<DataTable>();
    List<string?> Allocations = new List<string?>();
    List<string?> nonnetStock = new List<string?>();
    List<string?> onOrder = new List<string?>();
    List<string?> blockedStock = new List<string?>();
    List<string?> nettableStock = new List<string?>();

    //KEEP TRACK OF ARCHIVED AND UNARCHIVED SHORTAGES
    List<bool> isArchived = new List<bool>();


    private bool isLoading = true; //CONTROLS DISABLED PROPERTY OF PREV/NEXT
    private bool spinner = false;
    public DataTable? ProdLineDT;
    public string BackgroundColor = "white";

    public int ProdLineNumShortages;
    public string newComment = "";


    //PREV/NEXT buttons-------------------------------------------------------
    private void UpdatePromised()
    {
        SqlConnection cnxn = new SqlConnection(Databases.db);

        if(OrigCurrDueDates[shortNum] != itemsList[shortNum].promisedReceiptDate)
        {
            cnxn.Open();
            //First handle saving edits and reloading comments
            SqlCommand cmd = new SqlCommand("UPDATE Shortage_List SET " +
            "CurrDueDate = @Promised " +
            "WHERE ID = @ID", cnxn);
            cmd.Parameters.Add(new SqlParameter("@Promised", (itemsList[shortNum].promisedReceiptDate == null)
            ? new DateTime(1900, 01, 01) : itemsList[shortNum].promisedReceiptDate));
            cmd.Parameters.Add(new SqlParameter("@ID", itemsList[shortNum].ID));


            try
            {
                cmd.ExecuteNonQuery();
            }
            catch (SqlException ex)
            {
                pop.Title = "Error";
                pop.Message = ex.ToString();
                pop.ShowPopup();
            }
            finally
            {
                SqlCommand cmd1 = new SqlCommand("UPDATE Shortage_List " +
                           "SET PreviousCurrDueDate = '" + itemsList[shortNum].promisedReceiptDate + "' " +
                           "WHERE ID = @ID", cnxn);
                cmd1.Parameters.Add(new SqlParameter("@ID", itemsList[shortNum].ID));

                try
                {
                    cmd1.ExecuteNonQuery();
                }
                catch (SqlException ex)
                {

                }

                cnxn.Close();
            }
        }

    }

    public async void UpdateShortage()
    {

        SqlConnection cnxn = new SqlConnection(Databases.db);


        //First handle saving edits and reloading comments
        SqlCommand cmd = new SqlCommand("UPDATE Shortage_List SET " +
        " ItemStatus = @ItemStatus " +
        ",Reason = @Reason " +
        ",FlagField = @FlagField" +
        ",ShipmentTrackingNumber = @ShipmentTrackingNumber " +
        ",IQCCompleteDate = @IQCCompleteDate " +
        ",PlannerRequiredDate = @PlannerRequiredDate " +
        ",ProdOrder = @ProdOrder " +
        ",SalesOrder = @SalesOrder " +
        ",ShipDate = @ShipDate " +
        ",SODate = @SODate " +
        ",SOLineNo = @SOLineNo " +
        ",Buyer = @Buyer " +
        ",[Priority] = @priority " +
        ",onWarRoomList = @onWarRoomList " +
        "WHERE ID = @ID", cnxn);

        cmd.Parameters.Add(new SqlParameter("@ItemStatus", (itemsList[shortNum].status == null) 
        ? DBNull.Value : itemsList[shortNum].status));
        cmd.Parameters.Add(new SqlParameter("@Reason", (itemsList[shortNum].reason == null) 
        ? DBNull.Value : itemsList[shortNum].reason));
        cmd.Parameters.Add(new SqlParameter("@FlagField", (itemsList[shortNum].flagField) ? -1 : 0));
        cmd.Parameters.Add(new SqlParameter("@ShipmentTrackingNumber", (itemsList[shortNum].trackingNo == null)
        ? DBNull.Value : itemsList[shortNum].trackingNo));
        cmd.Parameters.Add(new SqlParameter("@IQCCompleteDate", (itemsList[shortNum].iqcCompleteDate == null)
        ? new DateTime(1990, 01, 01) : itemsList[shortNum].iqcCompleteDate));
        cmd.Parameters.Add(new SqlParameter("@PlannerRequiredDate", (itemsList[shortNum].reqDate == null) 
        ? new DateTime(1990, 01, 01) : itemsList[shortNum].reqDate));
        cmd.Parameters.Add(new SqlParameter("@ProdOrder", (itemsList[shortNum].productionOrder == null)
        ? DBNull.Value : itemsList[shortNum].productionOrder));
        cmd.Parameters.Add(new SqlParameter("@SalesOrder", (itemsList[shortNum].salesOrder == null)
        ? DBNull.Value : itemsList[shortNum].salesOrder));
        cmd.Parameters.Add(new SqlParameter("@ShipDate", (itemsList[shortNum].shipDate == null)
        ? DBNull.Value : itemsList[shortNum].shipDate));
        cmd.Parameters.Add(new SqlParameter("@SODate", (itemsList[shortNum].salesOrderDate == null)
        ? new DateTime(1990, 01, 01) : itemsList[shortNum].salesOrderDate));
        cmd.Parameters.Add(new SqlParameter("@SOLineNo", (itemsList[shortNum].SOLineNum == null)
        ? DBNull.Value : itemsList[shortNum].SOLineNum));
        cmd.Parameters.Add(new SqlParameter("@priority", (itemsList[shortNum].priority == null)
        ? DBNull.Value : itemsList[shortNum].priority));
        cmd.Parameters.Add(new SqlParameter("@Buyer", itemsList[shortNum].buyer));
        cmd.Parameters.Add(new SqlParameter("@ID", itemsList[shortNum].ID));

        SqlParameter pOnWarRoomList = new SqlParameter("@onWarRoomList", SqlDbType.Bit);
        if (itemsList[shortNum].priority.Substring(0,2) == "P1" )
        {
            pOnWarRoomList.Value = 1;
        }
        else if (itemsList[shortNum].priority.Substring(0, 2) == "P2")
        {
            pOnWarRoomList.Value = 1;
        }
        else
        {
            pOnWarRoomList.Value = 0;
        }

        cmd.Parameters.Add(pOnWarRoomList);


        cnxn.Open();
        try
        {
            cmd.ExecuteNonQuery();
        }
        catch(SqlException ex)
        {
            pop.Title = "Error";
            pop.Message = ex.ToString();
            pop.ShowPopup();
        }
        finally
        {
            cnxn.Close();
        }

        UpdatePromised();
        await Task.Delay(1000);
        //ReloadBuyer();

    }



    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        //Enables PREV/NEXT buttons after the page is rendered
        if (firstRender)
        {
            await Task.Delay(2000);
            isLoading = false;
            StateHasChanged();
        }
    }

    public async void Previous() //Cycle backwards in meeting
    {
        UpdateShortage();
        //await getTables();

        if (newComment != "")
        {
            addComment(newComment);
        }

        newComment = "";
        await ReloadComments();

        /*
        //Need to prevent user from cycling before all the data is loaded
        if ((nettableStock.Count < ProdLineNumShortages) && (shortNum == 0))
        {
            isLoading = true;
            StateHasChanged();
            await Task.Delay(1000);
            isLoading = false;
            StateHasChanged();
            }*/

    if (((itemMasterDTList.Count < shortNum + 3) ||
    (nettableStock.Count < shortNum + 3) ||
    (OpenProdDTList.Count < shortNum + 3) ||
    (ShortageDTList.Count < shortNum + 3) ||
    (CommentsDTList.Count < shortNum + 3))

    &&
    ((shortNum + 2 != ProdLineNumShortages) && (shortNum + 1 != ProdLineNumShortages)))

        {
            isLoading = true;
            StateHasChanged();
            await Task.Delay(2000);
            isLoading = false;
            StateHasChanged();
        }

        else
        {
            if (shortNum == 0)
            {
                shortNum = ProdLineNumShortages - 1;
            }
            else
            {
                shortNum -= 1;
            }

            StateHasChanged();
        }


    }

    public async void Next() //Cycle forward in meeting
    {
        UpdateShortage();
        //await LoadProdLineDataAsync();
        

        //First handle saving edits and reloading comments
        if (newComment != "")
        {
            addComment(newComment);
        }

        newComment = "";

        //Need to prevent user from cycling before all the data is loaded
        if (((itemMasterDTList.Count < shortNum + 3) ||
            (nettableStock.Count < shortNum + 3) ||
            (OpenProdDTList.Count < shortNum + 3) ||
            (ShortageDTList.Count < shortNum + 3) ||
            (CommentsDTList.Count < shortNum + 3)) 

            &&
            ((shortNum + 2 != ProdLineNumShortages) && (shortNum + 1 != ProdLineNumShortages)))

        {
            isLoading = true;
            StateHasChanged();
            await Task.Delay(2000);
            isLoading = false;
            StateHasChanged();
        }
        else
        {
            if (shortNum == ProdLineNumShortages - 1)
            {
                shortNum = 0;
            }
            else
            {
                shortNum += 1;
            }
            
            StateHasChanged();
        }
    }
    //END PREV/NEXT BUTTONS-----------------------------------------

    //COMMENTS------------------------------------------------------
    public async void addComment(string comment)
    {
        SqlConnection cnxn = new SqlConnection(Databases.db);
        SqlParameter pID = new SqlParameter("@ShortageID", SqlDbType.Int);
        pID.Value = itemsList[shortNum].ID;
        SqlParameter pComment = new SqlParameter("@Comment", SqlDbType.VarChar);
        pComment.Value = comment;

        SqlParameter pEnteredBy = new SqlParameter("@EnteredBy", SqlDbType.VarChar);
        string user = auth.GetAuthenticationStateAsync().Result.User.Identity.Name;
        if (user.StartsWith("Z"))
        {
            user = user.Replace("ZYGOMIS\\", "");
        }
        else
        {
            user = user.Replace("AMETEK-AD\\", "");
        }
        pEnteredBy.Value = user;
        SqlParameter pEnteredOn = new SqlParameter("@EnteredOn", SqlDbType.Date);
        pEnteredOn.Value = DateTime.Now;

        SqlCommand cmd = new SqlCommand(
            "Insert into shortagelistcomments (" +
            " ShortageID " +
            ", Comment " +
            ", EnteredBy " +
            ", EnteredOn) " +
            "values (" +
            pID + "," +
            pComment + "," +
            pEnteredBy + "," +
            "GETDATE())", cnxn);
        cmd.Parameters.Add(pID);
        cmd.Parameters.Add(pComment);
        cmd.Parameters.Add(pEnteredBy);
        cmd.Parameters.Add(pEnteredOn);

        try
        {
            cnxn.Open();
            cmd.ExecuteNonQuery();
            cnxn.Close();
        }
        catch(SqlException ex)
        {
            pop.Title ="Error";
            pop.Message = ex.ToString();
            pop.ShowPopup();
        }
        await ReloadComments();

    }

    //Call this after a new comment is added to ensure updated table
    public async Task ReloadComments()
    {
        SqlConnection cnxn = new SqlConnection(Databases.db);
        SqlCommand cmd = new SqlCommand(" SELECT " +
                    "  RTRIM(Comment) Comment " +
                    " ,RTRIM(EnteredBy) as [by] " +
                    " ,EnteredOn AS [Date of Change] " +
                    " FROM ShortageListComments " +
                    " WHERE ShortageID = " + itemsList[shortNum].ID +
                    " ORDER BY CommentID  DESC", cnxn);
        await cnxn.OpenAsync();
        CommentsDTList[shortNum] = GetDataTable(cmd);
        cnxn.Close();
    }

    //ARCHIVE/UNARCHIVE-----------------------------------
    public void Archive()
    {
        SqlConnection cnxn = new SqlConnection(Databases.db);
        SqlParameter pID = new SqlParameter("@ID", SqlDbType.Int);
        pID.Value = itemsList[shortNum].ID;
        SqlParameter pWhoArchived = new SqlParameter("@WhoArchived", SqlDbType.VarChar);
        string user = WindowsIdentity.GetCurrent().Name;
        if (user.StartsWith("Z"))
        {
            user = user.Replace("ZYGOMIS\\", "");
        }
        else
        {
            user = user.Replace("AMETEK-AD\\", "");
        }
        pWhoArchived.Value = user;
        SqlParameter pDateArchived = new SqlParameter("@DateArchived", SqlDbType.Date);
        pDateArchived.Value = DateTime.Now;

        SqlCommand cmd = new SqlCommand("UPDATE Shortage_List SET " +
        "WhoArchived = " + pWhoArchived + "," +
        "DateArchived = " + pDateArchived +
        " WHERE ID = " + pID, cnxn);

        cmd.Parameters.Add(pWhoArchived);
        cmd.Parameters.Add(pDateArchived);
        cmd.Parameters.Add(pID);


        try
        {
            cnxn.Open();
            cmd.ExecuteNonQuery();
            cnxn.Close();
        }catch(SqlException ex)
        {
            pop.Title = "Error";
            pop.Message = ex.ToString();
            pop.ShowPopup();
            return;
        }

        pop.Title = "Success";
        pop.Message = itemsList[shortNum].ID + " has been archived.";
        pop.ShowPopup();
        isArchived[shortNum] = true;
        StateHasChanged();
    }

    public void Unarchive()
    {
        SqlConnection cnxn = new SqlConnection(Databases.db);
        SqlParameter pID = new SqlParameter("@ID", SqlDbType.Int);
        pID.Value = itemsList[shortNum].ID;

        SqlCommand cmd = new SqlCommand("UPDATE Shortage_List SET " +
        "WhoArchived = NULL," +
        "DateArchived = NULL" +
        " WHERE ID = " + pID, cnxn);

        cmd.Parameters.Add(pID);


        try
        {
            cnxn.Open();
            cmd.ExecuteNonQuery();
            cnxn.Close();
        }
        catch (SqlException ex)
        {
            pop.Title = "Error";
            pop.Message = ex.ToString();
            pop.ShowPopup();
            return;
        }

        pop.Title = "Success";
        pop.Message = itemsList[shortNum].ID + " has been unarchived.";
        pop.ShowPopup();
        isArchived[shortNum] = false;
        StateHasChanged();
    }

    //TRACKING FEDEX/UPS BUTTONS------------------------------------------
    public void FedEx()
    {
        string track = "https://www.fedex.com/apps/fedextrack/?tracknumbers=" +
        itemsList[shortNum].trackingNo.Trim() + "&commit=Track%21";
        JSRuntime.InvokeVoidAsync("openNewTab", track);
    }

    public void UPS()
    {
        string track = "https://www.ups.com/track?loc=en_US&requester=ST/";
        JSRuntime.InvokeVoidAsync("openNewTab", track);
