    public DataTable GetDataTable(SqlCommand cmd)
    {
        DataTable dt = new DataTable();
        try
        {
            SqlDataReader dr = cmd.ExecuteReader();
            dt.Load(dr);
        }
        catch (Exception ex)
        {
            pop.Title = "Error";
            pop.Message = ex.ToString();
            pop.ShowPopup();
        }
        return (dt);
    }

    //TRACKING REPORT BUTTON---------------------------------------------
    public async Task TrackReport()
    {
        SqlConnection cnxn = new SqlConnection(Databases.db);
        DataTable dt = new DataTable();

        SqlCommand cmd = new SqlCommand
            ("SELECT " +
            "  MKReceiptTransactionID AS [Trkr ID:]" +
            " ,PartNumber AS [Item Code]" +
            " ,OperatorName AS [Operator]" +
            " ,Location AS [Location]" +
            " ,MovedToDate AS [Moved To Date]" +
            " ,MovedToQty AS [To Qty]" +
            " ,MovedOutDate AS [Moved Out Date]" +
            " ,MovedOutQty AS [Out Qty]" +
            " ,OriginalQty AS [Orig Qty]" +
            " ,ReceiptNumber AS [MK Rcpt]" +
            " ,TimeInMin AS [El Time]" +
            " ,LocationTrackingID AS [Loc Trk#]" +
            " ,KanbanTransactionID AS [OKB Trn ID]" +
            " ,RMAItemsNumber AS [RMA Itm#]" +
            " ,ServiceID AS [Sve ID]" +
            " FROM local_dash_view_tracking t " +
            " WHERE partNumber = '" + itemsList[shortNum].code + "' " +
            " order by MKReceiptTransactionID desc, movedtodate asc ", cnxn);


        try
        {
            cnxn.Open();
            SqlDataReader dr = cmd.ExecuteReader();
            dt.Load(dr);
        }
        catch (Exception ex)
        {
            pop.Message = ex.ToString();
            pop.Title = "Error";
            pop.ShowPopup();
        }
        cnxn.Close();

        var rows = new StringBuilder();
        string currentTrckID = "";
        foreach (DataRow items in dt.Rows)
        {
            if (items[0].ToString() != currentTrckID)
            {
                rows.AppendLine("<tr><th>" + dt.Columns[0] + ": " + items[0].ToString() + "</th></tr>");
                currentTrckID = items[0].ToString();
            }
            rows.AppendLine("<tr>");
            for (int i = 1; i < dt.Columns.Count; i++)
            {
                rows.AppendLine("<td>" + items[i].ToString() + "</td> ");
            }
            rows.AppendLine("</tr>");

        }


        string html = @"
        <head>
          <style>
            @media print{
              @page {
                size: landscape;
              }
            }

            body {
              margin: 20px;
              /* Adjust the value to set the desired margin size */
            }

            colName {
              margin: 20px;
              font-size: 12px;
            }

            tr {
              font-size: 12px;
            }
            td {
              font-size: 12px;
              text-align:center;
            }
            th {
              font-size: 12px;
              text-align:center;
            }

          </style>
        </head>

        <body>

            <h2>Tracking History - by Item Code, Tracking ID and Moved Out Date (Last 90 Days)</h2>

          <br>

            <table>
                <thead>
                    <tr>
                        <th>Item Code       </th>
                        <th>Operator        </th>
                        <th>Location        </th>
                        <th>Moved To Date   </th>
                        <th>To Qty          </th>
                        <th>Moved Out Date  </th>
                        <th>Out Qty         </th>
                        <th>Orig Qty        </th>
                        <th>MK Rcpt         </th>
                        <th>El Time         </th>
                        <th>Loc Trk#        </th>
                        <th>OKB Trn ID      </th>
                        <th>RMA Itm#        </th>
                        <th>Sve ID          </th>
                    </tr>
                </thead>
                <tbody> " +
                rows.ToString() + @"
                </tbody >
            </table>
        </body>
        ";
        await JSRuntime.InvokeVoidAsync("printContent", html);
    }
