    public void getItemMasterData(int i, SqlConnection cnxn)
    {

        SqlCommand cmd = new SqlCommand("select " +
                "[Description]," +
                "FORMAT([Safety Stock Quantity], 'N0')," +
                "FORMAT([Reorder Point], 'N0')," +
                "CASE  WHEN LEN([Lead Time Calculation]) = 0 THEN '0' " +
                    "WHEN CHARINDEX(CHAR(3),[Lead Time Calculation]) > 0 " +
                        "THEN REPLACE([Lead Time Calculation], CHAR(3), '') " +
                    "WHEN CHARINDEX(CHAR(4),[Lead Time Calculation]) > 0 THEN " +
                        "REPLACE([Lead Time Calculation], CHAR(4), '') * 5	" +
                    "WHEN CHARINDEX(CHAR(5),[Lead Time Calculation]) > 0 THEN " +
                        "REPLACE([Lead Time Calculation], CHAR(5), '') * 20	" +
                    "WHEN CHARINDEX(CHAR(2),[Lead Time Calculation]) > 0 THEN " +
                        "REPLACE([Lead Time Calculation], CHAR(2), '')  " +
                "END [LT], " +
                "[Supplier Replenishment] [RPL TM], " +
                "FORMAT([Reorder Quantity], 'N0') AS [BIN SZ], " +
                "FORMAT([Standard Cost], 'C') AS [STD COST]," +
                "CASE " +
                    "WHEN [MPS Item] = 0 THEN 'MRP' " +
                    "WHEN [MPS Item] = 1 THEN 'MPS' " +
                " END AS [O SYS], " +
                "[Signal Code], " +
                "[P6], " +
                "[F6], " +
                "[EAU] " +
                "FROM [ZYGO$Item] " +
                "WHERE [No_] = '" + itemsList[i].code + "'", cnxn);
        itemMasterDTList.Add(new DataTable());
        itemMasterDTList[i] = GetDataTable(cmd);
            /*
        *
        *  Allocated
        *
        * */

        /*  Production Order Components

            Firm Planned and Released
            Quantity goes back to required quantity on BOM
            Remaining Quantity reflects what is needed for this order
        */

        SqlCommand loopCmd = new SqlCommand
           ("SELECT " +
            "COALESCE(SUM([Remaining Quantity]), 0) " +
            "FROM [" + Databases.NAVprefix + "Prod_ Order Component] " +
            "WHERE 1=1 " +
            "AND Status in (2, 3) " +
            "and [Item No_] = '" + itemsList[i].code + "' "
           , cnxn);

        object AS1 = 0;

        try
        {
            AS1 = loopCmd.ExecuteScalar();
        }
        catch (SqlException ex)
        {
            pop.Title = "Error";
            pop.Message = ex.ToString();
            pop.ShowPopup();
        }


        /*  Sales Orders */

        loopCmd = new SqlCommand
           ("SELECT " +
           "COALESCE(SUM([Quantity]), 0) " +
           "FROM [" + Databases.NAVprefix + "Sales Line] " +
           "WHERE 1=1 " + //[Posting Date] >= (GETDATE() + 183) " +
           "AND Type = 2 AND [Completely Shipped] = 0 " +
           "and [No_] = '" + itemsList[i].code + "' "
           , cnxn);

        object AS2 = 0;

        try
        {
            AS2 = loopCmd.ExecuteScalar();
        }
        catch (SqlException ex)
        {
            pop.Title = "Error";
            pop.Message = ex.ToString();
            pop.ShowPopup();
        }



        /*  Service Orders */

        loopCmd = new SqlCommand
           ("SELECT " +
           "COALESCE(SUM([Quantity]), 0) " +
           "FROM [" + Databases.NAVprefix + "Service Line] " +
           "WHERE 1=1 " + //[Posting Date] >= (GETDATE() + 183) " +
                          //"AND ([Entry Type] = 1 OR [Entry Type] = 5) " +
           "and [No_] = '" + itemsList[i].code + "' "
           , cnxn);

        object AS3 = 0;

        try
        {
            AS3 = loopCmd.ExecuteScalar();
        }
        catch (SqlException ex)
        {
            pop.Title = "Error";
            pop.Message = ex.ToString();
            pop.ShowPopup();
        }


        /*  Job - Inventory Requests */

        loopCmd = new SqlCommand
           ("SELECT " +
           "COALESCE(SUM([Quantity]), 0) " +
           "FROM [" + Databases.NAVprefix + "Job Journal Line] " +
           "WHERE 1=1 " + //[Posting Date] >= (GETDATE() + 183) " +
           "AND [Journal Template Name] = 'INVREQ' " +
           "and [No_] = '" + itemsList[i].code + "' "
           , cnxn);

        object AS4 = 0;

        try
        {
            AS4 = loopCmd.ExecuteScalar();
        }
        catch (SqlException ex)
        {
            pop.Title = "Error";
            pop.Message = ex.ToString();
            pop.ShowPopup();
        }

        Allocations.Add("");
        Allocations[i] = string.Format("{0:0}", (Convert.ToDouble(AS1) + Convert.ToDouble(AS2) + Convert.ToDouble(AS3) + Convert.ToDouble(AS4)));



        /*  blocked stock   */


        loopCmd = new SqlCommand
            ("SELECT " +
            "COALESCE(FORMAT(SUM([Quantity]),'N0'), '0') " +
            "FROM [" + Databases.NAVprefix + "Warehouse Entry] " +
            "WHERE [Bin Code] like '%IQC%' " +
            "and [Item No_] = '" + itemsList[i].code + "' "
            , cnxn);

        object b = "";

        try
        {
            b = loopCmd.ExecuteScalar();
        }
