    protected void HandleValidSubmit()
    {
        dt = new DataTable();

        cnxn = new SqlConnection(Databases.db);

        cmd = new SqlCommand(
            "SELECT " +
            "ItemCode " +
            ",Description " +
            ",[Supplier]" +
            ",Priority" +
            ",Reason" +
            ",CONVERT(varchar,DateAddedToList,1) AS [List Date]" +
            ",DATEDIFF(D, DateAddedtoList, GETDATE()) AS [Days on List]" +
            ",[PO]" +
            ",[QTY] " +
            ",[whoAdded]" +
            ",CONVERT(varchar,[Orig_ Requested Receipt Date],1) [Orig_ Requested Receipt Date] " +
            ",OnWarRoomList " +
            "FROM Shortage_List " +
            "WHERE DateArchived is null " +
            "ORDER BY Priority DESC"
            , cnxn);


        try
        {
            cnxn.Open();
            dr = cmd.ExecuteReader();
            dt.Load(dr);
        }
        catch (SqlException ex)
        {
            ex.ToString();
        }
        finally
        {
            cnxn.Close();

        }
        try
        {
            //string filepathServer = @"\\CT-MID-DFS01.ametek.com\Manufacturing\SoftwareDistribution\ShortageList.csv";

            string filepathServer = @"C:\A\shortage.csv";
            File.Delete(filepathServer);
            var lines = new List<string>();

            string[] columnNames = dt.Columns
                .Cast<DataColumn>()
                .Select(column => column.ColumnName)
                .ToArray();

            var header = string.Join(",", columnNames.Select(name => $"\"{name}\""));
            lines.Add(header);


            System.Collections.Generic.IEnumerable<string> valueLines;
            valueLines = dt.AsEnumerable()
                .Select(row => string.Join(",", row.ItemArray.Select(val => $"\"{val}\"")));

            lines.AddRange(valueLines);


            File.WriteAllLines(filepathServer, lines);

            pop.Title = "File Exported to";
            pop.Message = @"C\A\";
            //pop.Message = @"\\CT-MID-DFS01.ametek.com\Manufacturing\SoftwareDistribution\";
            pop.ShowPopup();

        }
        catch (Exception ex)
        {
            pop.Title = "Error";
            pop.Message = ex.ToString();
            pop.ShowPopup();
        }
        finally
        {
            cnxn.Close();
        }
        //NavMgr.NavigateTo("viewshortages");
    }

