    protected override void OnInitialized()
    {

        EditContext = new EditContext(dataModel);
        EditContext.OnFieldChanged += EditContext_OnFieldChanged;

        dtEmployees = new DataTable();

        cnxn = new SqlConnection(g.db);

        cmd = new("select " +
                "  ROW_NUMBER() OVER " +
                "(Order BY sn) " +
                ", SN + '  : ' + CN " +
                ", mail " +
                "FROM EmployeesAmetekAD " +
                "WHERE BU = 'ct-mid' " +
                "order by SN "
        , cnxn);

        try
        {
            cnxn.Open();
            dr = cmd.ExecuteReader();
            dtEmployees.Load(dr);
        }
        catch (SqlException ex)
        {
            pop.Title = "Error";
            pop.Message = ex.ToString();
            pop.ShowPopup();
        }
        finally
        {
            cnxn.Close();

        }


        dtCostCenters = new System.Data.DataTable();

        cnxn = new SqlConnection(g.dbNAV);

        cmd = new SqlCommand(
        "select Code + '  ' + Name As Number from [ZYGO$Dimension Value] " +
        "WHERE [Dimension Code] = 'COSTCENTER' AND Blocked = 0 ORDER BY Number", cnxn);

        try
        {
            cnxn.Open();
            dr = cmd.ExecuteReader();
            dtCostCenters.Load(dr);
        }
        catch (SqlException ex)
        {
            pop.Title = "Error";
            pop.Message = ex.ToString();
            pop.ShowPopup();
        }
        finally
        {
            cnxn.Close();
        }

        cnxn = new SqlConnection(g.db);

        cmd = new SqlCommand(
         "Select  " +
         "[ORIG Priority] " +
         ",FORMAT([ORIG Request_Need_Date], 'MM/dd/yy') " +
         ",[ORIG Requestor] " +
         ",[ORIG PROJECT] " +
         ",[ORIG Cost_Center] " +
         ",[ORIG Quantity] " +
         ",[ORIG Request_Text] " +
         ",COALESCE([ORIG Request_Comments],'') " +
         ",COALESCE([ORIG Rework_Order_Number],'') " +
         ",COALESCE([ORIG Request_Reason],'') " +
         ",COALESCE([ORIG Request_Type],'') " +
         ",COALESCE([ORIG TypeSubcategory],'') " +
         ",COALESCE([ORIG PartNumber],'') " +
         ",COALESCE([ORIG FAST_Number],'') " +
         ",COALESCE([ORIG Production_Number],'') " +
         ",[ORIG TimeSavingsEstimate] " +
         ",[ORIG CostSavingsEstimate] " +
         ",[ORIG RevenueSavingsEstimate] " +
         ",COALESCE([ORIG requestor_email],'') " +
         ",COALESCE([ORIG requestor_phone],'') " +
         "from [tool_requests] " +
         "where " +
         "ID = " + g.RequestID, cnxn);


        try
        {
            cnxn.Open();
            dr = cmd.ExecuteReader();
            while (dr.Read())
            {
                priority = dr.GetString(0);
                request_need_date = dr.GetString(1);
                requestor = dr.GetString(2);
                project = dr.GetString(3);
                cost_center = dr.GetString(4);
                quantity = dr.GetInt32(5).ToString();
                request_text = dr.GetString(6);
                request_comments = dr.GetString(7);
                reworkNumber = dr.GetString(8);
                request_reason = dr.GetString(9);
                requestType = dr.GetString(10);
                typesubcategory = dr.GetString(11);
                partnumber = dr.GetString(12);
                fast = dr.GetString(13);
                production_number = dr.GetString(14);
                timesavingsestimate = dr.GetString(15);
                costsavingsestimate = dr.GetString(16);
                revenuesavingsestimate = dr.GetString(17);
                requestor_email = dr.GetString(18);
                requestor_phone = dr.GetString(19);
            }
        }
        catch (Exception ex)
        {
            pop.Title = "Error";
            pop.Message = ex.ToString();
            pop.ShowPopup();

        }
    }

