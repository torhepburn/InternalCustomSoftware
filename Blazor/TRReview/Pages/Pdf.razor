        // }
        // catch (Exception ex)
        // {
        //     pop.Title = "Error";
        //     pop.Message = ex.ToString();
        //     pop.ShowPopup();
        // }


        //await ProcessPdfStream(pdfStream);

        // Assuming you have a method to fetch the PDF data from your server
        //byte[] pdfBytes = await GetPdfDataFromServer();

        PdfSource = $"data:application/pdf;base64,{pdfData}";
    }

