@page "/pdf" 
 
<PageTitle>PDF</PageTitle>

@using TRReview.Data

@using Microsoft.Data.SqlClient
@using System.Data

@inject Global g
@inject NavigationManager NavMgr

<div class="popup-overlay @(pop.IsVisible ? "visible" : "")">
    <div class="popup-content">
        <h3>@pop.Title</h3>
        <p>@pop.Message</p>
        <button class="btn" @onclick="pop.ClosePopup">Close</button>
    </div>
</div>

<div class="container">
    <embed type="application/pdf" src="@PdfSource" width="100%" height="1000px" />
</div>



@code {

    PopUp pop = new PopUp();

    private string PdfSource { get; set; }

    SqlCommand cmd;
    SqlConnection cnxn;
    
    protected override async Task OnInitializedAsync()
    {
        cnxn = new SqlConnection(g.db);
        
        SqlCommand cmd = new SqlCommand
            ("Select uploaded_pdf from tool_requests where id = '" + g.RequestID + "' and uploaded_pdf is not null", cnxn);
        cnxn.Open();

        object o = cmd.ExecuteScalar();

        var n = o.GetType();

        byte[] xData = (byte[])o;

        var pdfData = Convert.ToBase64String(xData);

        cnxn.Close();

        // // {
