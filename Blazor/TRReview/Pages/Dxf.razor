    protected override async Task OnInitializedAsync()
    {
        if (Directory.Exists("c:\\dxf"))
        {

        }
        else
        {
            System.IO.Directory.CreateDirectory("c:\\dxf");
        }

        cnxn = new SqlConnection(g.db);

        SqlCommand cmd = new SqlCommand
            ("Select uploaded_dxf from tool_requests where id = '" + g.RequestID + "' and uploaded_dxf is not null", cnxn);
        cnxn.Open();

        object o = cmd.ExecuteScalar();

        var n = o.GetType();

        byte[] xData = (byte[])o;

        try
        {
            // write bytes to disk as file
            FileStream fs1 = new FileStream
                (Dxtract, FileMode.Create, FileAccess.ReadWrite);
            BinaryWriter bw = new BinaryWriter(fs1);
            bw.Write(xData);
            bw.Close();
        }
        catch (Exception ex)
        {
            pop.Title = "Error";
            pop.Message = ex.ToString();
            pop.ShowPopup();
        }



