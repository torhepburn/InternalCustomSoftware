

<div class="popup-overlay @(pop.IsVisible ? "visible" : "")">
    <div class="popup-content">
        <h3>@pop.Title</h3>
        <p>@pop.Message</p>
        <button @onclick="pop.ClosePopup">Close</button>
    </div>
</div>
<style>
    th{
        background-color: @color;
    }
</style>

@if (dt != null && dt.Rows.Count > 0)
{
    <table style="width:100%;border-collapse:separate;border-spacing: 0;">
            <thead>
                <tr>
                    <th>Item Code</th>
                    <th>Description</th>
                    <th>STK OH</th>
                    <th>STK OO</th>
                    <th>ALO</th>
                    <th>BLK STK</th>
                    <th>NON NET</th>
                    <th>P6 ISS</th>
                    <th>F6</th>
                    <th>EAU</th>
                    <th>SFE STK</th>
                    <th>RE ORD</th>
                    <th>VEND LT</th>
                    <th>REPL TM</th>
                    <th>BIN SZ</th>
                    <th>O SYS</th>
                    <th>SIG CODE</th>
                    <th>STD COST</th>
                </tr>
            </thead>
            <tbody>
                @if (dt != null)
                {
                    @foreach (DataRow items in dt.Rows)
                    {
                        <tr>
                            <td style="background-color:yellow">@itemCode.ToString()</td>
                            <td>@items[0]</td>
                            <td>@nettableStock</td>
                            <td>@onOrder</td>
                            <td>@Allocations</td>
                            <td>@blockedStock</td>
                            <td>@nonnetStock</td>
                            <td>@items[9]</td>
                            <td>@items[10]</td>
                            <td>@items[11]</td>
                            @for (int i = 1; i < 6; i++)
                            {
                                <td>@items[i].ToString()</td>
                            }
                            <td>@items[7]</td>
                            <td>@items[8]</td>
                            <td>@items[6]</td>
                        </tr>
                    }
                }

            </tbody>
        </table>
}



@code {
    public PopUp pop = new PopUp();
    [Parameter]
    public DataTable? dt { get; set; }
    [Parameter]
    public string? itemCode { get; set; }
    [Parameter]
    public string? Allocations { get; set; }
    [Parameter]
    public string? nonnetStock { get; set; }
    [Parameter]
    public string? onOrder { get; set; }
    [Parameter]
    public string? blockedStock { get; set; }
    [Parameter]
    public string? nettableStock { get; set; }
    [Parameter]
    public string? prodLine { get; set; }
    public string color = "white";

    protected override async Task OnInitializedAsync()
    {

        if (prodLine == "INST")
        {
            color = "lightyellow";
        }
        else if (prodLine == "PPS")
        {
            color = "lightgreen";
        }
        else if (prodLine == "OPT")
        {
            color = "lightcyan";
        }
        else if (prodLine == "EPO")
        {
            color = "plum";
        }
    }
}