@page "/editbincontent"

<PageTitle>Edit Bin Contents Fields</PageTitle>

@using LowBin.Data
@using Microsoft.Data.SqlClient
@using System.Data

@inject FormModel f

<h1>Edit Fields</h1>
<br />
<EditForm Model="model">
    <DataAnnotationsValidator />
    <ValidationSummary />
    <table>
        <tbody>
            <tr>
                <td align="right">
                    Part Number :
                    <InputText id="n10" @bind-Value="f.item" />
                </td>
            </tr>

            <tr>
                <td align="right">
                    Full Quantity :
                    <InputText id="n10" @bind-Value="f.FullQty" />
                </td>
            </tr>
            @*<tr>
                <td align="right">
                    Cost Center :
                    <InputText id="n11" placeholder="CostCenter" @bind-Value="g.costcenter" />
                </td>

            </tr>
            <tr>
                <td align="right">
                    Due Date :
                    <InputText id="n13" placeholder="Due Date" @bind-Value="g.duedate" />
                </td>
            </tr>*@
        </tbody>
    </table>

</EditForm>
