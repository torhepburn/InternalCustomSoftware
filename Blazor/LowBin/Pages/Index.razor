@page "/"
@page "/index"

@using LowBin.Data
@using Microsoft.Data.SqlClient
@using System.Data

<PageTitle>Index</PageTitle>

<h1>Report low or empty bin</h1>
<div>
    <div style="display:flex;justify-content:center">
  
   
    <EditForm Model=@f OnValidSubmit="@DataEntry">
        <DataAnnotationsValidator />

    
            <div>
                
                <InputCheckbox @bind-Value="cbBBO"></InputCheckbox> Check if Both Bins Out of stock.
                <br />
                <br />
            </div>
            Scan Item Number or type part number and hit enter:
            <div>
              
        <InputText style="width: 70%" @bind-Value="f.item" @onfocus="InputOnFocus" />
        <ValidationMessage For="() => f.item" style="display:inline" />
        @*<h1><label style="color:red">@successLabel</label></h1>*@
    </div>
     

        </EditForm>
</div>

</div>

<table>
    <thead>
        <tr>
            @*<th>ID</th>*@
            <th>Item Number</th>
            <th>Quantity</th>
            <th>Location</th>
            @*<th>Location</th>
            <th>In/Out</th>*@

            @*<th>Contact / Operator</th>

            <th>Cost Center</th>
            <th>Controller/Computer Name</th>
            <th>Failure Description</th>
            <th>Assigned To</th>
            <th>Resolution</th>*@

        </tr>
    </thead>
    <tbody>
        @foreach (DataRow r in dt.Rows)
        {
            <tr>
                @*<td style="width:80px">@r[0].ToString()</td>*@
                <td style="width:200px">@r[0].ToString()</td>
                <td style="width:150px">@r[1].ToString()</td>
                <td style="width:150px">@r[2].ToString()</td>
                @*<td style="width:150px">@r[3].ToString()</td>
                <td style="width:150px">@r[4].ToString()</td>*@

                @*<td style="width:150px">@r[6].ToString()</td>
            <td style="width:150px">@r[7].ToString()</td>
            <td style="width:150px">@r[9].ToString()</td>
            <td style="width:500px">@r[8].ToString()</td>
            <td>@r[10].ToString()</td>
            <td>@r[11].ToString()</td>*@

            </tr>
        }
    </tbody>
</table>



