@page "/"


@using OpticsTracker.Data
@using Microsoft.Data.SqlClient

<PageTitle>Index</PageTitle>

<h1>Scan Location then Scan Part</h1>

<div style="display:flex;justify-content:center">
  
    
    <EditForm Model=@f OnValidSubmit="@DataEntry">
        <DataAnnotationsValidator />

        <div>
            <div>
                Scan Location :
                <div>
                    @*<InputText @ref=inputTextForFocus @bind-Value="f.location"/>*@
                    <InputText @bind-Value="f.location" />
                    <ValidationMessage For="() => f.location" style="display:inline" />
                </div>
            </div>
            <br/>

            <div>
                Scan Work Order :
                <div>
                    <InputText style="width: 70%" @bind-Value="f.workOrder" />
                    <ValidationMessage For="() => f.workOrder" style="display:inline" />
                </div>
            </div>
            <br />
        </div>
        <button type="submit">Submit</button>
    </EditForm>

    <br />
   
</div>

@*<button class="btn btn-primary" @onclick="DataEntry">Save Data</button>*@

@code
{

    private FormModel f = new FormModel();
    private InputText inputTextForFocus;


    SqlCommand cmd;
    SqlConnection cnxn;

    public class DateSample
    {
        public DateTime ddate { get; set; }
    }
    private DateSample _dateSample = new DateSample();

    //protected override async Task OnAfterRenderAsync(bool firstRender)
    //{
    //    if (inputTextForFocus?.Element != null)
    //    {
    //        await inputTextForFocus.Element.Value.FocusAsync();
    //    }
    //}


    public void DataEntry()
    {
        cnxn = new SqlConnection(f.dbNAV);

        cmd = new("SELECT [Source No_] FROM [ZYGO$Production Order] " +
                    "WHERE No_ = '" + f.workOrder.ToUpper() + "' ",cnxn);

        try
        {
            cnxn.Open();
            object o = cmd.ExecuteScalar();
            f.part = o.ToString().Trim();
        }
        catch (SqlException ex)
        {
            ex.ToString();
        }
        finally
        {
            cnxn.Close();
        }

        
        cnxn = new SqlConnection(f.db);

        cmd = new("INSERT INTO OpticsTracker (" +
                    " Date " +
                    ",Part " +
                    ",Location " +
                    ",WO " +
                    ",InOut " +

                    ") values (" +
                    "'" + DateTime.Now + "'" +
                    ",'" + f.part + "'" +
                    ",'" + f.location + "'" +
                    ",'" + f.workOrder + "'" +
                    ",'In'" +
                    ")", cnxn);


        try
        {
            cnxn.Open();
            cmd.ExecuteNonQuery();
        }
        catch (SqlException ex)
        {
            ex.ToString();
        }
        finally
        {
            cnxn.Close();
        }

        f.part = string.Empty;
        f.workOrder = string.Empty;
        //modelpartnumber = "";
        //serialnumber = "";
        //contactoperator = "";
        //location = "";
        //costcenter = "";
        //computer = "";
        //failuredescription = "";

        //NavMgr.NavigateTo("viewshortages");
    }


}