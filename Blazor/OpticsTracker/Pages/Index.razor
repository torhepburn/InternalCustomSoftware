@page "/"


@using OpticsTracker.Data
@using Microsoft.Data.SqlClient

<PageTitle>Index</PageTitle>

<h1>Scan Location then Scan Part</h1>

<div style="display:flex;justify-content:center">
  
    
    <EditForm Model=@f OnValidSubmit="@DataEntry">
        <DataAnnotationsValidator />

        <div>
            <div>
                Scan Location :
                <div>
                    <InputText @bind-Value="f.location"/>
                    <ValidationMessage For="() => f.location" style="display:inline" />
                </div>
            </div>
            <br/>

            <div>
                Scan Part :
                <div>
                    <InputText style="width: 70%" @bind-Value="f.part" />
                    <ValidationMessage For="() => f.part" style="display:inline" />
                </div>
            </div>
            <br />
        </div>
        <button type="submit">Submit</button>
    </EditForm>

    <br />
   
</div>

@*<button class="btn btn-primary" @onclick="DataEntry">Save Data</button>*@

@code
{

    private FormModel f = new FormModel();
    //public EditContext? EditContext;
    

    SqlCommand cmd;
    SqlConnection cnxn;

    //protected override void OnInitialized()
    //{
    //    EditContext = new EditContext(dataModel);
    //}

    public class DateSample
    {
        public DateTime ddate { get; set; }
    }
    private DateSample _dateSample = new DateSample();


    public void DataEntry()
    {
        cnxn = new SqlConnection("server = CT-MID-SQL11; password = Read+Write!; " +
                                        "user = readWrite; database = Optics; encrypt=false;");

        cmd = new("INSERT INTO LocatedInventory (" +
                    " Date " +
                    ",Part " +
                    ",Location " +
                    //",Employee " +
                    ",InOut " +
                    ") values (" +
                    "'" + DateTime.Now + "'" +
                    ",'" + f.part + "'" +
                    ",'" + f.location + "'" +
                    //",'" + costcenter + "'" +
                    ",'In'" +
                    ")", cnxn);


        try
        {
            cnxn.Open();
            cmd.ExecuteNonQuery();
        }
        catch (SqlException ex)
        {
            ex.ToString();
        }
        finally
        {
            cnxn.Close();
        }

        f.part = string.Empty;
        //equipment = "";
        //modelpartnumber = "";
        //serialnumber = "";
        //contactoperator = "";
        //location = "";
        //costcenter = "";
        //computer = "";
        //failuredescription = "";

        //NavMgr.NavigateTo("viewshortages");
    }


}