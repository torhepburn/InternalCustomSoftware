@page "/"
@page "/index"


@using OpticsTracker.Data
@using Microsoft.Data.SqlClient

<PageTitle>Index</PageTitle>



<div style="display:flex;justify-content:center">
  
   
    <EditForm Model=@f OnValidSubmit="@DataEntry">
        <DataAnnotationsValidator />

        <div>
            <h1>Select Location then Scan Part</h1>
            <br />
                            <div>
                                <label>Select Location:</label>
                                <InputSelect id="prodLine" tabindex=0 list="prodLines" @bind-Value="f.location">
                                    <option value="">-- Select an option --</option>
                                    <option value="128 TRIZAC">128 TRIZAC</option>
                                    <option value="ASSEMBLY ROOM">ASSEMBLY ROOM</option>
                                    <option value="CHEMICAL ETCH">CHEMICAL ETCH</option>
                                    <option value="CLEAN ROOM #1">CLEAN ROOM #1</option>
                                    <option value="CLEAN ROOM #2">CLEAN ROOM #2</option>
                                    <option value="CLEAN ROOM #3">CLEAN ROOM #3</option>
                                    <option value="CLEAN ROOM #4">CLEAN ROOM #4</option>
                                    <option value="CMM">CMM</option>
                                    <option value="CNC">CNC</option>
                                    <option value="COATING">COATING</option>
                                    <option value="GENERATING">LFO GENERATING</option>
                                    <option value="GRINDING">GRINDING</option>
                                    <option value="LASER EDGE">LASER EDGE</option>
                                    <option value="LASER SERIALIZING">LASER SERIALIZING</option>
                                    <option value="METROLOGY">METROLOGY</option>
                                    <option value="MODELS SHOP">MODELS SHOP</option>
                                    <option value="MRB">MRB</option>
                                    <option value="MRB 128 TRIZAC">MRB 128 TRIZAC</option>
                                    <option value="MRB (MRF)">MRB (MRF)</option>
                                    <option value="MRB CHEMICAL ETCH">MRB CHEMICAL ETCH</option>
                                    <option value="MRB (CNC/GRINDING)">MRB (CNC/GRINDING)</option>
                                    <option value="MRB GENERATING">MRB LFO GENERATING</option>
                                    <option value="MRB MODELS SHOP">MRN MODELS SHOP</option>
                                    <option value="MRB OPTICS">MRB OPTICS</option>
                                    <option value="MRB POLISH">MRB POLISH</option>
                                    <option value="MRF">MRF</option>
                                    <option value="PLANO POLISH">PLANO POLISH</option>
                                    <option value="QUALITY CONTROL">QUALITY CONTROL</option>
                                </InputSelect>
                                <ValidationMessage For="() => f.location " style="display:inline" />
                            </div>
            
            @*<div>
                Scan Location :
                <div>
                    @*<InputText @ref=inputTextForFocus @bind-Value="f.location"/>
                    <InputText @bind-Value="f.location" />
                    <ValidationMessage For="() => f.location" style="display:inline" />
                </div>
            </div>
            *@
            <br/>

            <div>
                Scan Work Order :
                <div>
                    <InputText style="width: 70%" @bind-Value="f.workOrder" />
                    <ValidationMessage For="() => f.workOrder" style="display:inline" />
                </div>
            </div>
            <br />
        </div>
        <button type="submit" class="btn btn-success" >If scan does not work then type in Work Order number and click here to Submit</button>
        @*The submit button automatically finds data entry and does not need an onclick*@
    </EditForm>

    <br />
   
</div>

@code
{

    private FormModel f = new FormModel();
    private InputText inputTextForFocus;


    SqlCommand cmd;
    SqlConnection cnxn;

    public class DateSample
    {
        public DateTime ddate { get; set; }
    }
    private DateSample _dateSample = new DateSample();

    //protected override async Task OnAfterRenderAsync(bool firstRender)
    //{
    //    if (inputTextForFocus?.Element != null)
    //    {
    //        await inputTextForFocus.Element.Value.FocusAsync();
    //    }
    //}


    public void DataEntry()
    {
        if (f.workOrder.Substring(0,3)=="%P%")
        {
            f.workOrder = f.workOrder.Substring(3, 8);
        }

        
        cnxn = new SqlConnection(f.dbNAV);

        cmd = new("SELECT [Source No_] FROM [ZYGO$Production Order] " +
                    "WHERE No_ = '" + f.workOrder.ToUpper().Substring(0,8) + "' ",cnxn);

        try
        {
            cnxn.Open();
            object o = cmd.ExecuteScalar();
            f.part = o.ToString().Trim();
        }
        catch (SqlException ex)
        {
            ex.ToString();
        }
        finally
        {
            cnxn.Close();
        }

        
        cnxn = new SqlConnection(f.db);

        cmd = new("INSERT INTO OpticsTracker (" +
                    " Date " +
                    ",Part " +
                    ",Location " +
                    ",WO " +
                    ",InOut " +

                    ") values (" +
                    "'" + DateTime.Now + "'" +
                    ",'" + f.part + "'" +
                    ",'" + f.location.TrimEnd('\r', '\n') + "'" +
                    ",'" + f.workOrder.ToUpper().Substring(0,8) + "'" +
                    ",'In'" +
                    ")", cnxn);
        try
        {
            cnxn.Open();
            cmd.ExecuteNonQuery();
        }
        catch (SqlException ex)
        {
            ex.ToString();
        }
        finally
        {
            cnxn.Close();
        }

        f.part = string.Empty;
        f.workOrder = string.Empty;
        //modelpartnumber = "";
        //serialnumber = "";
        //contactoperator = "";
        //location = "";
        //costcenter = "";
        //computer = "";
        //failuredescription = "";

        //NavMgr.NavigateTo("viewshortages");
    }


}