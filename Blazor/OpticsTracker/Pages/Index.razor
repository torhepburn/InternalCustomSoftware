@page "/"

@using OpticsTracker.Data
@using Microsoft.Data.SqlClient

<PageTitle>Index</PageTitle>

<h1>Scan Location then Scan Part</h1>

<div style="display:flex;justify-content:center">
  
    
    <EditForm Model="simple">

        <div>
            <div>
                Scan Location :
                <div>
                    <InputText @bind-Value="location"/>
                </div>
            </div>
            <br/>

            <div>
                Scan Part :
                <div>
                    <InputText style="width: 70%" @bind-Value="part" />
                </div>
            </div>
            <br />
        </div>
        
    </EditForm>

    <br />
   
</div>

<button class="btn btn-primary" @onclick="DataEntry">Save Data</button>

@code
{

