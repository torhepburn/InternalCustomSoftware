    public EditContext? EditContext;
    private string? location;
    private string? part;
    private string simple = "";

    SqlCommand cmd;
    SqlConnection cnxn;

    protected override void OnInitialized()
    {
        EditContext = new EditContext(dataModel);
    }

    public class DateSample
    {
        public DateTime ddate { get; set; }
    }
    private DateSample _dateSample = new DateSample();


    public void DataEntry()
    {
        cnxn = new SqlConnection("server = CT-MID-SQL11; password = Read+Write!; " +
                                        "user = readWrite; database = Optics; encrypt=false;");

        cmd = new("INSERT INTO LocatedInventory (" +
                    " Date " +
                    ",Part " +
                    ",Location " +
                    //",Employee " +
                    ") values (" +
                    "'" + DateTime.Now + "'" +
                    ",'" + part + "'" +
                    ",'" + location + "'" +
                    //",'" + costcenter + "'" +
                    ")", cnxn);


        try
        {
            cnxn.Open();
            cmd.ExecuteNonQuery();
        }
        catch (SqlException ex)
        {
            ex.ToString();
        }
        finally
