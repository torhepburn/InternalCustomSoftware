@page "/"

<PageTitle>ServiceRequests</PageTitle>

<h1>Service Request</h1>

@using ServiceRequests.Data
@using System.Data
@using Microsoft.Data.SqlClient

@inject Global g

<EditForm Model="item" OnValidSubmit="DataEntry">
    <DataAnnotationsValidator />
    <ValidationSummary />
    <table>
        <tbody>
            <tr>
                <td align="right">
                    Equipment Name :
                    <InputText id="n8" placeholder="Equipment" @bind-Value="equipment" />
                </td>
            </tr>
                <tr>
                <td align="right">
                    Model or Part Number :
                    <InputText id="n9" placeholder="Model or Part Number" @bind-Value="modelpartnumber" />
                </td>

            </tr>

            <tr>
                <td align="right">
                    Serial Number :
                    <InputText id="n10" placeholder="Serial Number" @bind-Value="serialnumber" />
                </td>
            </tr>

            
            <tr>
                <td align="right">
                    Contact/Operator :
                    <InputText id="n11" placeholder="Contact/Operator" @bind-Value="contactoperator" />
                </td>
            </tr>
            <tr>
                <td align="right">
                    Location :
                    <InputText id="n12" placeholder="Location" @bind-Value="location" />
                </td>
                
            </tr>
        </tbody>
    </table>
    <br />
    
    Description of Failure :
    <InputText id="a13" placeholder="Description of Failure" style="width: 100%; height: 200px" @bind-Value="failuredescription" />
    



</EditForm>

<br />
<button class="btn btn-primary" @onclick="DataEntry">Save Data</button>





@code {

    public class DateSample
    {
        public DateTime ddate { get; set; }
    }
    private DateSample _dateSample = new DateSample();

    public string enteredOn = "";
    public string equipment = "";
    public string modelpartnumber = "";
    public string serialnumber = "";
    public string contactoperator = "";
    public string item = "";
    public string failuredescription = "";
    public string location = "";
    //public string binCode = "";
    //public string storekeeper = "";
    //public string costcenter = "";
    //public string planner = "";
    public string duedate = "";
    //public string comment = "";
    //public string commentEntered = "";

    SqlCommand cmd;
    SqlConnection cnxn;
    SqlDataReader dr;
    DataTable dt;
    DataTable dtc;

    protected override void OnInitialized()
    {

    }

    public void DataEntry()
    {
        cnxn = new SqlConnection(g.db);

        cmd = new("INSERT INTO ServiceRequests (" +
                    " DateEntered " +
                    ",EquipmentName " +
                    ",ModelPartNumber " +
                    ",SerialNumber " +
                    ",ContactOperator " +
                    ",Location " +
                    ",FailureDescription) values (" +
                    "'" + DateTime.Now + "'" +
                    ",'" + equipment + "'" +
                    ",'" + modelpartnumber + "'" +
                    ",'" + serialnumber + "'" +
                    ",'" + contactoperator + "'" +
                    ",'" + location + "'" +
                    ",'" + failuredescription + "')",cnxn);


        try
        {
            cnxn.Open();
            cmd.ExecuteNonQuery();
        }
        catch (SqlException ex)
        {
            ex.ToString();
        }
        finally
        {
            cnxn.Close();
        }

        equipment = "";
        modelpartnumber = "";
        serialnumber = "";
        contactoperator = "";
        location = "";
        failuredescription = "";

        //NavMgr.NavigateTo("viewshortages");
    }

    
}
