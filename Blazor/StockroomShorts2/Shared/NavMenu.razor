@using Data
@inject Global g
@inject NavigationManager nav

@if (g.isLoading)
{
    <section class="overlay-container">
        <div class="loading-spinner">
            <div class="ring" style="position:fixed;top:50%;left:50%;transform:translate(-50%, -50%)"></div>
        </div>
    </section>
}



<div style="display:flex;justify-content:center">
    <nav style="display:flex;justify-content:center">

        <h3 style="padding-top:16px">stockroom</h3>
        <h3 style="padding-top:16px;color:red">shortages</h3>

        <div class="nav-item px-3">
            <button @onclick="Home" class="nav-item">
                <div class="oi oi-home" ></div> Home
            </button>
        </div>
        
        <div class="nav-item px-3" style="cursor:pointer">
            <div class="dropdown">
                <div>
                    <button style="cursor:auto" class="nav-item">
                        <div class="oi oi-plus"></div> Add Shortage
                    </button>
                </div>

                <div class="dropdown-content">
                    <br />
                    <div class="nav-item px-3">
                        <button style="width:200px" class="button-85" @onclick="EnterShortage">WO Shortage</button>
                    </div>
                    <div class="nav-item px-3">
                        <button style="width:200px" class="button-85" @onclick="AddDisconnectedShortage">Free Shortage</button>
                    </div>
                    <div class="nav-item px-3">
                        <button style="width:200px" class="button-85" @onclick="EnterQualifierShortage">Qualifier Shortage</button>
                    </div>
                    <div class="nav-item px-3">
                        <button style="width:200px" class="button-85" @onclick="ViewQualifierShortages">View Qualifier Shortages</button>
                    </div>

                    <br />
                </div>
            </div>
        </div>
        
        <div class="nav-item px-3">
            <button @onclick="UpdateData" class="nav-item">
                <div class="oi oi-list-rich"></div> Update Data
            </button>
        </div>

        <div class="nav-item px-3" style="cursor:pointer">
            <div class="dropdown">
                <div>
                    <button style="cursor:auto" class="nav-item">
                        <div class="oi oi-data-transfer-download"></div> Export to Excel
                    </button>
                </div>

                <div class="dropdown-content">
                    <br />
                    <div class="nav-item px-3">
                        <button style="width:200px" class="button-85" @onclick="Export" >
                            Associate Active List
                        </button>
                    </div>
                    <div class="nav-item px-3">
                        <button style="width:200px" class="button-85" @onclick="ExportArchived">
                            Archived Parts
                        </button>
                    </div>
                    <div class="nav-item px-3">
                        <button style="width:200px" class="button-85" @onclick="ExportQualifier">
                            Qualifier Parts
                        </button>
                    </div>
                    <br />
                </div>
            </div>
        </div>

        <div class="nav-item px-3">
            <button @onclick="Documentation" class="nav-item">
                <div class="oi oi-folder"></div> Documentation
            </button>
        </div>
            
    </nav>
</div>

@code {
    PopUp pop = new PopUp();

    private void load()
    {
        g.isLoading = true;
        StateHasChanged();
    }

    private void Home()
    {
        nav.NavigateTo("viewshortages");
    }

    private void EnterShortage()
    {
        nav.NavigateTo("entershortage");
    }

    private void EnterQualifierShortage()
    {
        nav.NavigateTo("enterqualifiershortage");
    }

    private void ViewQualifierShortages()
    {
        nav.NavigateTo("viewqualifiershortages");
    }

    private void AddDisconnectedShortage()
    {
        nav.NavigateTo("adddisconnectedshortage");
    }

    private void UpdateData()
    {
        nav.NavigateTo("updatedata");
        load();
    }

    private void Export()
    {
        g.exportFile = "Active";
        g.archive = "0";
        //g.storekeeper = "john.bess@ametek.com";
        nav.NavigateTo("exportshortages");
    }

    private void ExportArchived()
    {
        g.archive = "1";
        g.exportFile = "Archived";
        nav.NavigateTo("exportshortages");
    }

    private void ExportQualifier()
    {
        g.archive = "0";
        g.exportFile = "Qualifier";
        nav.NavigateTo("exportshortages");
    }

    private void Documentation()
    {
        nav.NavigateTo("documentation");
    }
}
