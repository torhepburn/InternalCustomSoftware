@using System.Data
@using Microsoft.Data.SqlClient
@using static PopUp

@inject Global g
@inject NavigationManager NavMgr

<div class="popup-overlay @(pop.IsVisible ? "visible" : "")">
    <div class="popup-content">
        <h3>@pop.Title</h3>
        <p>@pop.Message</p>
        <button @onclick="pop.ClosePopup">Close</button>
    </div>
</div>


<div class="@TableStyle" style="min-height:60px;border:solid 1px black;">
    @*<div class="table-shortages" style="min-height:60px;border:solid 1px black;">*@
    <table>
        <thead>
            <tr>  @* top row are buttons with headings to allow sorting *@
                @for (int i = 1; i < n - 1; i++)
                {
                    int index = i; // Create a local variable and assign it to i
                    <th>
                        <button @onclick="() => SortTable(index)">
                            @dt.Columns[i]
                            @if (isVisible[i])
                            {
                                <section class="sort-arrow-down @(isSortedDescending[i] ? "rotate" : "")"></section>
                            }
                        </button>
                    </th>
                }



            </tr>
        </thead>
        <tbody>
            @if (dt != null)
            {
                @foreach (DataRow items in dt.Rows)
                {
                    string green = "rgb(175,255,140)";
                    string yellow = "rgb(255, 255, 140)";
                    string red = "rgb(255,109,106)";
                    string blue = "rgb(135,206,250)";
                    string orange = "rgb(255,187,51)";
                    string purple = "rgb(213,128,255)";
                    string cyan = "rgb(0,255,255)";
                    string color = "white";

                    if (items[16].ToString() == "green")
                    {
                        color = green;
                    }
                    else if (items[16].ToString() == "yellow")
                    {
                        color = yellow;
                    }
                    else if (items[16].ToString() == "red")
                    {
                        color = red;
                    }
                    else if (items[16].ToString() == "blue")
                    {
                        color = blue;
                    }
                    else if (items[16].ToString() == "orange")
                    {
                        color = orange;
                    }
                    else if (items[16].ToString() == "purple")
                    {
                        color = purple;
                    }
                    else if (items[16].ToString() == "cyan")
                    {
                        color = cyan;
                    }

                    <tr style="background-color:@color">
                        @for (int i = 1; i < n - 1; i++)
                        {
                            <td @onclick="() => Select(items[0].ToString())">@items[i].ToString()</td>
                        }
                    </tr>

                }

            }
        </tbody>
    </table>
</div>


@code {

    SqlCommand cmd;
    SqlConnection cnxn;
    SqlDataReader dr;
    DataTable dtg;


    [Parameter]
    public DataTable? dt { get; set; }

    [Parameter]
    public string? TableStyle { get; set; }

    PopUp pop = new PopUp();

    public int currentColNum = 0;

    private bool newBrowse = true;
    int n;
    private List<bool>? isSortedDescending;

    private List<bool>? isVisible;

    
    protected override async Task OnInitializedAsync()
    {
        //SqlConnection cnxn = new SqlConnection(Databases.db);
        n = dt.Columns.Count;
        if (n > 0)
        {
            isSortedDescending = Enumerable.Repeat(true, n - 1).ToList();
            isSortedDescending.Insert(0, false);

            isVisible = Enumerable.Repeat(false, n - 1).ToList();
            isVisible.Insert(0, true);
        }
    }

    public void SortTable(int columnNum, bool forceAsc = false)
    {
        currentColNum = columnNum;
        string ascendingString = "ASC";
        for (int i = 0; i < n; i++)
        {
            if (columnNum == i)
            {
                isVisible[i] = true;

                if (isSortedDescending[i] | forceAsc)
                {
                    isSortedDescending[i] = false;
                    ascendingString = "ASC";
                }
                else
                {
                    isSortedDescending[i] = true;
                    ascendingString = "DESC";
                }
            }
            else
            {
                isSortedDescending[i] = true;
                isVisible[i] = false;
            }
        }

        dt.DefaultView.Sort = dt.Columns[columnNum] + " " + ascendingString;
        dt = dt.DefaultView.ToTable();
        StateHasChanged();

    }

    private void Select(string ID)
    {
        g.ShortageID = ID;
        NavMgr.NavigateTo("EditShortage");
    }

