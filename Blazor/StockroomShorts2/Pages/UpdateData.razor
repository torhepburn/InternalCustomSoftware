        SqlDataAdapter da = new SqlDataAdapter(select, cnxnNAV);
        DataTable table = new DataTable();
        da.Fill(table);




        SqlBulkCopy copy = new SqlBulkCopy(cnxn);

        copy.DestinationTableName = tableName;

        try
        {
            copy.WriteToServer(table);
        }
        catch (Exception ex)
        {
            //MessageBox.Show(ex.ToString());
        }
        finally
        {

        }
    }

    public async Task CopyTable(string sourcecommand, string destinationTableName)
    {
        using (SqlConnection sourceConnection = new SqlConnection(g.dbNAV))
        using (SqlConnection destinationConnection = new SqlConnection(g.db))
        {
            await sourceConnection.OpenAsync();
            await destinationConnection.OpenAsync();

            using (SqlCommand selectCommand = new SqlCommand(sourcecommand, sourceConnection))
            using (SqlDataReader reader = await selectCommand.ExecuteReaderAsync())
            using (SqlBulkCopy bulkCopy = new SqlBulkCopy(destinationConnection))
            {
                bulkCopy.BatchSize = 15000;
                bulkCopy.DestinationTableName = destinationTableName;

                // Adjust the bulk copy settings as needed (e.g., BatchSize, NotifyAfter)

                await bulkCopy.WriteToServerAsync(reader);
            }

            sourceConnection.Close();
            destinationConnection.Close();
        }
    }

    private async void UpdateQuantity()
    {
        SqlConnection NAVcnxn = new SqlConnection(g.dbNAV);
        SqlConnection cnxn = new SqlConnection(g.db);
        SqlCommand cmd = new SqlCommand();
        SqlDataReader dr;
        DataTable test = new DataTable();

        await Task.Delay(10);
        foreach (DataRow items in dt.Rows)
        {

            cmd = new SqlCommand("SELECT " +
                    "cast(c.[Remaining Quantity] as int) " +                                       

                    "FROM " +
                    "[ZYGO$Prod_ Order Component] c " +
                    "INNER JOIN [ZYGO$Item] i " +
                    "ON c.[Item No_] = i.No_ " +
                    "LEFT JOIN [ZYGO$Production Order] o ON c.[Prod_ Order No_] = o.[No_] " +

                    "WHERE (Substring(c.[Description],1, 1) != '#' AND Substring(c.[Description],1, 1) != '&') " +
                    "AND [Remaining Quantity] > 0 " +
                    "AND [Prod_ Order No_] = '" + items[2].ToString() + "' " +
                    "AND c.[Item No_] = '" + items[3].ToString() + "' " +
                    "ORDER BY [Prod_ Order Line No_], [Line No_]"
                    , NAVcnxn);

            NAVcnxn.Open();
            dr = cmd.ExecuteReader();
            if (dr.HasRows)
            {
                while (dr.Read())
                {
                    UpQuantity = dr.GetInt32(0);
                }


                cmd = new SqlCommand("UPDATE StockroomShortages " +
               "SET [Quantity] = '" + UpQuantity.ToString() + "' " +
               "WHERE [ID] = '" + items[0].ToString() + "'", cnxn);
                cnxn.Open();
                cmd.ExecuteNonQuery();
                cnxn.Close();

                cmd = new SqlCommand("UPDATE StockroomShortagesQ " +
              "SET [Quantity] = '" + UpQuantity.ToString() + "' " +
              "WHERE [ID] = '" + items[0].ToString() + "'", cnxn);
                cnxn.Open();
                cmd.ExecuteNonQuery();
                cnxn.Close();
            }
            NAVcnxn.Close();
        }
    }

