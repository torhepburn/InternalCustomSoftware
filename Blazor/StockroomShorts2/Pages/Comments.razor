@page "/comments"

<PageTitle>Comments</PageTitle>

<h1>Comments</h1>

@using System.Data
@using Microsoft.Data.SqlClient
@inject Global g
@inject NavigationManager NavMgr


<h1>View Comments</h1>


    <table class="table">
        <thead>
            <tr>
                <th>Comment</th>
                <th>Entered By</th>
                <th>Entered On</th>
                <th>Comment ID</th>
                <th>Shortage ID</th>
            </tr>
        </thead>
        <tbody>
           @foreach (DataRow r in dt.Rows)
            {
                <tr>
                    <td>@r[0].ToString()</td>
                    <td>@r[1].ToString()</td>
                    <td>@r[2].ToString()</td>
                    <td>@r[3].ToString()</td>
                    <td>@r[4].ToString()</td>
                </tr>
            }
        </tbody>
    </table>
<br />
<br />
    

@code
{
    SqlCommand cmd;
    SqlConnection cnxn;
    SqlDataReader dr;
    DataTable dt;

    public string comment = "";
    public string emailFrom = "";
    public string shortageID = "";

    protected override void OnInitialized()
    {
        dt = new DataTable();

        cnxn = new SqlConnection(g.db);

        cmd = new("select " +
        "  Comment " +
        ", COALESCE(EnteredBy, '') EnteredBy " +
        ", COALESCE(EnteredOn, '') EnteredOn " +
        ", COALESCE(CommentID, '') CommentID " + 
        ", COALESCE(ShortageID, '') ShortageID " +
        " from StockroomComments " +
        " ORDER BY CommentID "
        , cnxn);

        try
        {
            cnxn.Open();
            dr = cmd.ExecuteReader();
            dt.Load(dr);
        }
        catch (SqlException ex)
        {
            ex.ToString();
        }
        finally
        {
            cnxn.Close();

        }
    }

    //private void Select(string id)
    //{
    //    id = dt.Rows[0].ToString();
    //}
}
