@page "/editfields"

<PageTitle>Edit Shortage</PageTitle>


@using System.Data
@using Microsoft.Data.SqlClient
@inject Global g
@inject NavigationManager NavMgr


<h2>Fill in the required fields.</h2>
<br />
 
<div>

    <EditForm Model="item">
    <DataAnnotationsValidator />
    <ValidationSummary />
    <table>
        <tbody>
            <tr>
                <td align="right">
                    Stockroom Associate :
                   @*  <InputText id="n10" placeholder="Skt Rm Assoc #" @bind-Value="g.storekeeper" /> *@
                        <InputSelect id="s4" class="form-control" style="width:80%" @bind-Value="g.storekeeper">
                            <option value=""</Option>
                            @foreach (System.Data.DataRow r in dtStorekeeper.Rows)
                            {
                                <option value="@r[0].ToString()">@r[0].ToString()</option>
                            }
                        </InputSelect>
                </td>
            </tr>
            <tr>
                <td align="right">
                    Cost Center :
                    <InputText id="n11" placeholder="CostCenter" @bind-Value="g.costcenter" />
                </td>
               
            </tr>
            <tr>
                <td align="right">
                    Due Date :
                    <InputText id="n13" placeholder="Due Date" @bind-Value="g.duedate" />
                </td>
            </tr>
        </tbody>
    </table>
    
</EditForm>


</div>

@code {
        
    public string item = "";

    SqlCommand cmd;
    SqlConnection cnxn;
    SqlDataReader dr;
    DataTable dtStorekeeper;
   

    protected override void OnInitialized()
    {
        dtStorekeeper = new DataTable();

        cnxn = new SqlConnection(g.db);

        cmd = new("select " +
                  //"CN " +
                  " mail " +
                  "FROM EmployeesAmetekAD " +
                  "WHERE BU = 'ct-mid' " +
                  "AND Manager LIKE '%Fornal%' " +
                  "order by SN "
                  , cnxn);

        try
        {
            cnxn.Open();
            dr = cmd.ExecuteReader();
            dtStorekeeper.Load(dr);
        }
        catch (SqlException ex)
        {
            // pop.Title = "Error";
            // pop.Message = ex.ToString();
            // pop.ShowPopup();
        }
        finally
        {
            cnxn.Close();

        }
        
    }

   
    }