@page "/editfields"

<PageTitle>Edit Shortage</PageTitle>


@using System.Data
@using Microsoft.Data.SqlClient
@inject Global g
@inject NavigationManager NavMgr


<h2>Fill in the required fields.</h2>
<br />
 
<div>

    <EditForm Model="item">
    <DataAnnotationsValidator />
    <ValidationSummary />
    <table>
        <tbody>
            <tr>
                <td align="right">
                    Stockroom Associate :
                    <InputText id="n10" placeholder="Skt Rm Assoc #" @bind-Value="g.storekeeper" />
                </td>
            </tr>
            <tr>
                <td align="right">
                    Cost Center :
                    <InputText id="n11" placeholder="CostCenter" @bind-Value="g.costcenter" />
                </td>
               
            </tr>
            <tr>
                <td align="right">
                    Due Date :
                    <InputText id="n13" placeholder="Due Date" @bind-Value="g.duedate" />
                </td>
            </tr>
        </tbody>
    </table>
    
</EditForm>


</div>

@code {
        
    public string item = "";
   

    protected override void OnInitialized()
    {
        
    }

   
    }