
@using System.Data
@using Microsoft.Data.SqlClient
@using static PopUp


@inject Global g
@inject NavigationManager NavMgr
@inject IJSRuntime JSRuntime

<div class="popup-overlay @(pop.IsVisible ? "visible" : "")">
    <div class="popup-content">
        <h3>@pop.Title</h3>
        <p>@pop.Message</p>
        <button @onclick="pop.ClosePopup">Close</button>
    </div>
</div>

<div class="popup-overlay @(GroupPop.IsVisible ? "visible" : "")">
    <div class="popup-content">
        <h3>@GroupPop.Title</h3>
        <p>@GroupPop.Message</p>
        <input @ref="textBoxRef" type="text" @bind="GroupName" />
        <button @onclick="GroupShortages">Group</button>
        <button @onclick="GroupPop.ClosePopup">Cancel</button>
    </div>
</div>

<div class="popup-overlay @(AddPop.IsVisible ? "visible" : "")">
    <div class="popup-content">
        <h3>@AddPop.Title</h3>
        <p>@AddPop.Message</p>
        <EditForm Model="@GroupName">
            <InputSelect @bind-Value="groupNameAdding">
                <option value="">-- Select an option --</option>
                @foreach (Group x in g.groups)
                {
                    <option value="@x.Name">@x.Name</option>
                }
            </InputSelect>
        </EditForm>

        <button @onclick="AddSelected">Group</button>
        <button @onclick="AddPop.ClosePopup">Cancel</button>
    </div>
</div>

<div class="popup-overlay @(showShortage ? "visible" : "")">
    <div class="popup-shortage">
        <EditShortage @key="showShortage"></EditShortage>
        <br />
        <div style="display:flex;justify-content:center"><button class="button-58" @onclick="closeShortage">Close</button></div>
    </div>
</div>

@if (g.isLoading)
{
    <section class="overlay-container">
        <div class="loading-spinner">
            <div class="ring" style="position:fixed;top:50%;left:50%;transform:translate(-50%, -50%)"></div>
        </div>
    </section>
}



<div style="width:100%;">

    <div style="display:inline">
        <button @onclick="InitiateGroup" class="button-85">Group Selected Rows</button>
        @*<button @onclick="InitiateAddSelected" class="button-85">Add Selected to Existing Group</button>*@
        <br /><br />
        <div style="flex-direction:row; border:solid 1px black;display:flex;text-align:center;max-height:30px">
            <h4 style="font-size:12px;width:50%">Status Key:</h4>
            
            <label style="font-size:12px;width:100%;background-color:rgb(175,255,140)">On Hand (OH)</label>
            <label style="font-size:12px;width:100%;background-color:rgb(0,255,255)">Inadequate Quantity/Holding Part (IQ/HP)</label>
            <label style="font-size:12px;width:100%;background-color:rgb(255,255,140)">On Order (OO)</label>
            <label style="font-size:12px;width:100%;background-color:rgb(255,109,106)">Not On Order/Not On Hand (NOO/NOH)</label>
            <label style="font-size:12px;width:100%;background-color:rgb(135,206,250)">Actively Searching (AS)</label>
            <label style="font-size:12px;width:100%;background-color:rgb(255,187,51)">OFS (Offsite)</label>
            <label style="font-size:12px;width:100%;background-color:rgb(213,128,255)">IQC (QC Inspection)</label>
        </div>
        <br />
        <h4 style="font-weight:bold">Master Shortage List:</h4>
    </div>


    <div class="table-shortages" style="min-height:60px;border:solid 1px black;">
    <table>
        <thead>
            <tr>
                @* th header for first column which contains the check boxes to be able to group
                    the rows - does not need a button as the others do to sort
                *@
                <th>Group</th>

                @* loop to make each column heading a button to be able to sort *@
                @for (int i = 1; i < n; i++)
                {
                    int index = i; // Create a local variable and assign it to i
                <th>
                        <button @onclick="() => SortTable(index)">
                            @dt.Columns[i]
                            @if (isVisible[i])
                            {
                                <section class="sort-arrow-down @(isSortedDescending[i] ? "rotate" : "")"></section>
                            }
                        </button>
                    </th>
                }
            </tr>
        </thead>
        <tbody>
            @if (dt != null)
            {
                int count = -1;
                @foreach (DataRow items in dt.Rows)
                {
                    string green = "rgb(175,255,140)";
                    string yellow = "rgb(255, 255, 140)";
                    string red = "rgb(255,109,106)";
                    string blue = "rgb(135,206,250)";
                    string orange = "rgb(255,187,51)";
                    string purple = "rgb(213,128,255)";
                    string cyan = "rgb(0,255,255)";
                    string color = "white";
                    string status = "None";

                    @* items[16] is the column of the datatable which contains the name
                        of the color from the stockroomshortages table
                    *@

                    if (items[16].ToString() == "green")
                    {
                        color = green;
                        status = "OH";
                    }
                    else if (items[16].ToString() == "yellow")
                    {
                        color = yellow;
                        status = "OO";
                    }
                    else if (items[16].ToString() == "red")
                    {
                        color = red;
                        status = "NOO/NOH";
                    }
                    else if (items[16].ToString() == "blue")
                    {
                        color = blue;
                        status = "AS";
                    }
                    else if (items[16].ToString() == "orange")
                    {
                        color = orange;
                        status = "OFS";
                    }
                    else if (items[16].ToString() == "purple")
                    {
                        color = purple;
                        status = "IQC";
                    }
                    else if (items[16].ToString() == "cyan")
                    {
                        color = cyan;
                        status = "IQ/HP";
                    }
                    
                    <tr style="background-color:@color" >
                        
                        <td style="width:1%"><input style="transform: scale(2)" type="checkbox" @bind-value=@checkboxList[dt.Rows.IndexOf(items)] /></td>
                        @for (int i = 1; i < n-1; i++)
                        {
                                <td @onclick="() => Select(items[0].ToString())">@items[i].ToString()</td>
                                if(i == (n - 2))
                                {
                                    <td @onclick="() => Select(items[0].ToString())">@status</td>
                                }
                        }

                    </tr>
                    
                }

            }
        </tbody>
    </table>
</div>
</div>

@code {

    SqlCommand cmd;
    SqlConnection cnxn;
    SqlDataReader dr;
    DataTable dt;

    //[Parameter]
    //public DataTable? dt { get; set; }

    [Parameter]
    public string? TableStyle { get; set; }

    [Parameter]
    public EventCallback<Group> CreateGroup { get; set; }

    [Parameter]
    public EventCallback Clear { get; set; }


    public EventCallback changeState { get; set; }

    private ElementReference textBoxRef;

    PopUp pop = new PopUp();

    PopUp GroupPop = new PopUp();

    public string GroupName = "";

    PopUp AddPop = new PopUp();

    public List<bool> checkboxList = new List<bool>();

    public int currentColNum = 0;

    private bool newBrowse = true;
    int n;
    private List<bool>? isSortedDescending;

    private List<bool>? isVisible;

    private bool showShortage = false;

    int quantity;

    private string? groupNameAdding;
    private string? optionGroupXML;

    protected override void OnInitialized()
    {
        cnxn = new SqlConnection(g.db);

        dt = new DataTable();

        cmd = new(g.SQLs1 +
                    "WHERE Archived = 0 " +
                    "ORDER BY [color]", cnxn);
                    //"ORDER BY s.[EnteredOn], [WO], [WOline], ComponentLine", cnxn);

        try
        {
            cnxn.Open();
            dr = cmd.ExecuteReader();
            dt.Load(dr);
        }
        catch (SqlException ex)
        {
            ex.ToString();
        }
        finally
        {
            cnxn.Close();
        }

    }

    protected override async Task OnInitializedAsync()
    {
        //SqlConnection cnxn = new SqlConnection(Databases.db);
        n = dt.Columns.Count;
        if (n > 0)
        {
            isSortedDescending = Enumerable.Repeat(true, n - 1).ToList();
            isSortedDescending.Insert(0, false);

            isVisible = Enumerable.Repeat(false, n - 1).ToList();
            isVisible.Insert(0, true);
        }
        foreach(DataRow items in dt.Rows)
        {
            checkboxList.Add(false);
        }
    }
    public void SortTable(int columnNum, bool forceAsc = false)
    {
        currentColNum = columnNum;
        string ascendingString = "ASC";
        for (int i = 0; i < n; i++)
        {
            if (columnNum == i)
            {
                isVisible[i] = true;

                if (isSortedDescending[i] | forceAsc)
                {
                    isSortedDescending[i] = false;
                    ascendingString = "ASC";
                }
                else
                {
                    isSortedDescending[i] = true;
                    ascendingString = "DESC";
                }
            }
            else
            {
                isSortedDescending[i] = true;
                isVisible[i] = false;
            }
        }

        dt.DefaultView.Sort = dt.Columns[columnNum] + " " + ascendingString;
        dt = dt.DefaultView.ToTable();
        StateHasChanged();

    }

    private void Select(string ID)
    {
        g.ShortageID = ID;

        showShortage = true;
        StateHasChanged();
        // NavMgr.NavigateTo("EditShortage");
    }

    private void closeShortage()
    {
        showShortage=false;
        StateHasChanged();
        NavMgr.NavigateTo("viewshortages", forceLoad: true);
        /*  forceLoad causes the client to reload the page from the server  */
    }

    private async Task FocusOnTextBox()
    {
        await textBoxRef.FocusAsync();
        StateHasChanged();
    }


    public async void InitiateGroup()
    {
        for(int i = 0; i < checkboxList.Count; i++)
        {
            if (checkboxList[i])
            {
                GroupPop.Title = "Name Group";
                GroupPop.ShowPopup();
                break;
            }
        }
        StateHasChanged();
        StateHasChanged();
        await FocusOnTextBox();
        await FocusOnTextBox();
    }

    public async void GroupShortages()
    {
        SqlConnection cnxn = new SqlConnection(g.db);
        /* zach's code */
        int newID = 0;
        DataTable newDT = dt.Clone();
        newDT.Clear();
        int count = -1;
        Group newGroup = new Group();

        /*  my code */
        string groupContents = string.Empty;

        foreach(bool check in checkboxList)
        {
            count++;
            if (check)
            {
                /* extra steps taken by Zach commented out*/
                //DataRow sourceRow = dt.Rows[count];
                //DataRow newRow = newDT.NewRow();
                //newRow.ItemArray = sourceRow.ItemArray;
                //newDT.Rows.Add(newRow);
                //newID = int.Parse(sourceRow.ItemArray[0].ToString());
                //newGroup.ID.Add(newID);

                /* this is where the checked ID gets added to the ID list */
                
                newGroup.ID.Add(int.Parse(dt.Rows[count][0].ToString()));
                groupContents += dt.Rows[count][0].ToString() + ",";
            }
        }
        for (int i = 0; i < checkboxList.Count; i++)
        {
            checkboxList[i] = false;
        }
        await ResetCheckboxes();

        newGroup.Name = GroupName;

        SqlParameter pGroupName = new SqlParameter("@groupName", SqlDbType.VarChar);
        pGroupName.Value = GroupName;


        await CreateGroup.InvokeAsync(newGroup);
        GroupName = "";
        await GroupPop.ClosePopup();
        StateHasChanged();

        
        SqlCommand cmd = new SqlCommand("INSERT INTO StockroomGroups (GroupName, EnteredOn, GroupContents, GroupStatus) values (" +
                            pGroupName + 
                             ",'" + DateTime.Now + "'" +
                             ",'" + groupContents.Remove(groupContents.LastIndexOf(",")) + "' " +
                             ",'Active' ) ", cnxn);

        cmd.Parameters.Add(pGroupName);
        //cmd.Parameters.Add(pGroupContents);

        try
        {
            cnxn.Open();
            cmd.ExecuteNonQuery();
        }
        catch (SqlException ex)
        {
            ex.ToString();
        }
        finally
        {
            cnxn.Close();
        }

        NavMgr.NavigateTo("viewshortages", forceLoad: true);
    }


    public async void AddSelected()
    {
        int count = -1;
        foreach (Group x in g.groups)
        {
            if (x.Name == groupNameAdding)
            {
                foreach (bool check in checkboxList)
                {
                    count++;
                    if (check)
                    {
                        x.ID.Add(int.Parse(dt.Rows[count].ItemArray[0].ToString()));
                    }
                }
            }
        }
        AddPop.ClosePopup();

        await ResetCheckboxes();
        StateHasChanged();
        NavMgr.NavigateTo("viewshortages", forceLoad: true);
    }


    private async void ClearGroups()
    {
        await Clear.InvokeAsync();
    }

    private async Task ResetCheckboxes()
    {
        await JSRuntime.InvokeVoidAsync("setAllCheckboxesToFalse");
    }

    public async void InitiateAddSelected()
    {
        if (g.groups.Count > 0)
        {
            for (int i = 0; i < checkboxList.Count; i++)
            {
                if (checkboxList[i])
                {
                    AddPop.Title = "Add To Group";
                    AddPop.Message = "Which group would you like to add to?";
                    StateHasChanged();
                    AddPop.ShowPopup();
                    break;
                }
                else if (i == checkboxList.Count - 1)
                {
                    pop.Title = "Error";
                    pop.Message = "No parts selected";
                    StateHasChanged();
                    pop.ShowPopup();
                }
            }

        }
        else
        {
            pop.Title = "Error";
            pop.Message = "No groups exist";
            StateHasChanged();
            pop.ShowPopup();
        }
    }
}