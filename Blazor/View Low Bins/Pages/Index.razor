@code
{
    SqlCommand cmd;
    SqlConnection cnxn;
    SqlDataReader dr;
    DataTable dt;

    int n;

    public List<bool> checkboxList = new List<bool>();

    protected override void OnInitialized()
    {
        cnxn = new SqlConnection(g.db);

        dt = new DataTable();

        cmd = new("SELECT " +
                  " ID " +
                  ",EnteredOn " +
                  ",PartNo " +
                  ",QuantityOnHand " +
                  ",StockLocation " +
                  ",FullBinQuantity " +
                  ",BothBinsOut " +
                  ",Color " +
                  " FROM StockroomLowBins "+
                  " WHERE Archived = 0 " +
                  " ORDER BY EnteredOn ", cnxn);

        try
        {
            cnxn.Open();
            dr = cmd.ExecuteReader();
            dt.Load(dr);
        }
        catch (SqlException ex)
        {
            ex.ToString();
        }
        finally
        {
            cnxn.Close();
        }

    }

    private void Select(string id)
    {
        g.ID = id;
        NavMgr.NavigateTo("editdata");
    }

}
