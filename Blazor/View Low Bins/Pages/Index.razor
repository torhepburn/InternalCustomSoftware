                  ",FullBinQuantity " +
                  ",BothBinsOut " +
                  ",Color " +
                  " FROM StockroomLowBins "+
                  " WHERE Archived = 0 " +
                  " ORDER BY EnteredOn ", cnxn);

        try
        {
            cnxn.Open();
            dr = cmd.ExecuteReader();
            dt.Load(dr);
        }
        catch (SqlException ex)
