</div>




@code
{
    Global g = new Global();

    SqlCommand cmd;
    SqlConnection cnxn;
    SqlDataReader dr;
    DataTable dt;

    int n;

    protected override void OnInitialized()
    {
        cnxn = new SqlConnection(g.db);

        dt = new DataTable();

        cmd = new("SELECT " +
                  " EnteredOn " +
                  ",PartNo " +
                  ",QuantityOnHand " +
                  //",Location " +
                  ",StockLocation " +

        " FROM StockroomLowBins", cnxn);

        try
        {
            cnxn.Open();
            dr = cmd.ExecuteReader();
            dt.Load(dr);
        }
        catch (SqlException ex)
        {
            ex.ToString();
        }
        finally
        {
            cnxn.Close();
        }

    }

}
