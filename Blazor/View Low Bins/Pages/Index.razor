    private void Archive()
    {
        SqlConnection cnxn1 = new SqlConnection(g.db);

        int count = -1;

        foreach(bool check in checkboxList)
        {
            string id;
            count++;
            if (check)
            {
                SqlCommand cmd = new SqlCommand("UPDATE StockroomLowBins SET Archived = 1 WHERE ID = " + dt.Rows[count][0].ToString() +" ", cnxn1);

                try
                {
                    cnxn1.Open();
                    cmd.ExecuteNonQuery();
                }
                catch (SqlException ex)
                {
                    ex.ToString();
                }
                finally
                {
                    cnxn1.Close();
                }
            }
        }

        NavMgr.NavigateTo("index", forceLoad: true);
        // g.ID = id;
