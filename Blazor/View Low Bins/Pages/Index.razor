@page "/"
@page "/index"

<PageTitle>Index</PageTitle>

@using System.Data
@using Microsoft.Data.SqlClient

@using View_Low_Bins.Data

@inject NavigationManager NavMgr
@inject Global g

<h1>View Low Bins</h1>

<table class="table-shortages">
    <thead class="border border-dark">
            <tr>
            <th><div style="background-color:rgb(175,255,140)">On Hand</div></th>
            <th><div style="background-color:rgb(0,255,255)">Inadequate Quantity</div></th>
            <th><div style="background-color:rgb(255,255,140)">On Order</div></th>
            <th><div style="background-color:rgb(255,109,106)">Not On Order/Not On Hand</div></th>
            <th><div style="background-color:rgb(135,206,250)">Actively Searching</div></th>
            <th><div style="background-color:rgb(255,187,51)">OFS (Offsite)</div></th>
            <th><div style="background-color:rgb(213,128,255)">IQC (QC Inspection)</div></th>
        </tr>
    </thead>
</table>
<br />
<button @onclick=Archive class="button-85">Archive Checked Items</button>
<br />
<br />
<div class="table-shortages" style="min-height:60px;border:solid 1px black;">
    <table>
        

            <tr>
                <td>Add to Archive List</td>
                <td>Date Entered</td>
                <td>Item Number</td>
                <td>Quantity on Hand</td>
                <td>Stock Location</td>
                <td>Full Bin Quantity</td>
            </tr>
            @*<tr>
                @* th header for first column which contains the check boxes to be able to group
                the rows - does not need a button as the others do to sort
                
              
            </tr>*@
        
        <tbody class="border border-dark">
            
             @if (dt != null)
            { 
                @foreach (DataRow r in dt.Rows)
                {
                    string green = "rgb(175,255,140)";
                    string yellow = "rgb(255, 255, 140)";
                    string red = "rgb(255,109,106)";
                    string blue = "rgb(135,206,250)";
                    string orange = "rgb(255,187,51)";
                    string purple = "rgb(213,128,255)";
                    string cyan = "rgb(0,255,255)";
                    string color = "white";
                    string status = "None";

                    if (r[7].ToString().Trim() == "green")
                    {
                        color = green;

                        status = "OH";
                    }
                    else if (r[7].ToString().Trim() == "yellow")
                    {
                        color = yellow;
                        status = "OO";
                    }
                    else if (r[7].ToString().Trim() == "red")
                    {
                        color = red;
                        status = "NOO/NOH";
                    }
                    else if (r[7].ToString().Trim() == "blue")
                    {
                        color = blue;
                        status = "AS";
                    }
                    else if (r[7].ToString().Trim() == "orange")
                    {
                        color = orange;
                        status = "OFS";
                    }
                    else if (r[7].ToString().Trim() == "purple")
                    {
                        color = purple;
                        status = "IQC";
                    }
                    else if (r[7].ToString().Trim() == "cyan")
                    {
                        color = cyan;
                        status = "IQ/HP";
                    }
               
                    <tr style="background-color:@color">

                                <td style="width:25px"><input style="transform: scale(2)" type="checkbox" @bind-value=@checkboxList[dt.Rows.IndexOf(r)] /></td>
                                @*  was getting an index out of range due to missing checkboxList add in code behind  *@
                                @* the code below determines which columns to show and what to do when clicked  int i = 0 is the checkbox*@
                                     @for (int i = 1; i < n - 2; i++)
                                    {
                                        <td @onclick="() => Select(r[0].ToString())">@r[i].ToString()</td>
                                        
                                        if (i == (n - 2))
                                        {
                                            <td @onclick="() => Select(r[0].ToString())">@status</td>
                                        }
                                    } 
                    </tr>
               
                }
             } 
            
        </tbody>
    </table>


</div>




