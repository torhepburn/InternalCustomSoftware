    protected override void OnInitialized()
    {
        dt = new DataTable();

        cnxn = new SqlConnection(g.db);

        cmd = new SqlCommand("SELECT " +
                " ID " +                                                //0
                ", COALESCE(FORMAT([EnteredOn], 'MM/dd/yy'),'') " +     //1
                ", COALESCE(FullBinQuantity, 0) " +                                 //2
                ", COALESCE(PartNo, '') " +                             //3
                ", COALESCE(PartDescription, '') " +                    //4
                                                                        //", COALESCE(WOLine, '') " +                             //5
                                                                        //", COALESCE(JobDescription, '') " +                     //6
                                                                        //", COALESCE(JobReference, '') " +                       //7
                                                                        //", COALESCE(QuantityOnHand, 0) " +                            //8
                ", COALESCE(Stocklocation, '') " +                      //9
                                                                        ////", COALESCE(CostCenter, '') " +                         //10
                                                                        ////", COALESCE(StockRoomAssociate,'') " +                  //11
                                                                        ////", COALESCE(Planner, '') " +                            //12
                                                                        ////", COALESCE([DueDate], '') " +                          //13
                ", COALESCE(Location, '') " +                           //14
                ", Color " +                                            //15
                " from StockroomLowBins WHERE ID = '" + g.ID + "' " +
                " AND Archived = 0 " 
                 //"ORDER BY [EnteredOn] DESC, [WO], [WOline], ComponentLine"
                 , cnxn);

        try
        {
            cnxn.Open();
            dr = cmd.ExecuteReader();
            while (dr.Read())
            {
                enteredOn = dr.GetString(1);
                fullBinQuantity = dr.GetInt32(2).ToString();
                item = dr.GetString(3);
                partdescription = dr.GetString(4);
                binCode = dr.GetString(5);
                location = dr.GetString(6);
                //storekeeper = dr.GetString(11);
                //costcenter = dr.GetString(10);
                //planner = dr.GetString(12);
                //duedate = dr.GetString(13);
                //woline = dr.GetInt32(5).ToString();
                //job = dr.GetString(6);
                //jobreference = dr.GetString(7);
                //quantity = dr.GetInt32(8).ToString();
                color = dr.IsDBNull(7) ? "white" : dr.GetString(7);
            }

            //g.item = item;

            //dr = cmd.ExecuteReader();
            //dt.Load(dr);
        }
        catch (SqlException ex)
        {
            ex.ToString();
        }
        finally
        {
            cnxn.Close();

        }
        color = color.Trim();
        if (color == "green")
        {
            status = "On Hand";
        }
        else if (color == "yellow")
        {
            status = "On Order";
        }
        else if (color == "red")
        {
            status = "Not On Order/Not On Hand";
        }
        else if (color == "blue")
        {
            status = "Actively Searching";
        }
        else if (color == "orange")
        {
            status = "OFS";
        }
        else if (color == "purple")
        {
            status = "IQC";
        }
        else if (color == "cyan")
        {
            status = "IQ/HP";
        }


        //dtc = new DataTable();

