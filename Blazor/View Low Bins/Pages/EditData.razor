@page "/editdata"

<PageTitle>Edit Data</PageTitle>

@using View_Low_Bins.Data

@using System.Data
@using Microsoft.Data.SqlClient

@inject Global g
@inject NavigationManager NavMgr


<h1>Edit Data</h1>
<div>
<br />
Only Edit Full Bin Quantity, Archive, and Actively Searching are currently functional.
<br />
<br />
<br />
</div>
<div style="display:flex;justify-content:center">
<EditForm Model="formX" OnValidSubmit="DataEntry">
    <DataAnnotationsValidator />
    <ValidationSummary />
        <table >
        <tbody>
            <tr>
                <td align="right">
                   <label style="width:100%">Entered On :</label>
                    <InputText id="n8" @bind-Value="enteredOn" />
                </td>
                <td align="right">

                        <label style="width:100%">Bin Code :</label>
                    <InputText id="n9"  @bind-Value="binCode" /> 
                </td>
               @* <td align="right">
                        <label style="width:100%">Stockroom Associate :</label>

                    <InputText id="n10" placeholder="Skt Rm Assoc #" @bind-Value="storekeeper" />
                </td>*@
            </tr>
            <tr>
                <td align="right">

                        <label style="width:100%">Item Number :</label>
                    <InputText id="n11" @bind-Value="item" />
                </td>
                <td align="right">
                        <label style="width:100%">Full Bin Quantity :</label>

                    <InputText id="n12" p @bind-Value="fullBinQuantity" />
                </td>
                <td align="right">
                        <label style="width:100%">Location :</label>

                    <InputText id="n13" @bind-Value="location" />
                </td>
                    <td align="right">
                        <label style="width:100%">Color :</label>

                        <InputText id="n13" @bind-Value="color" />
                    </td>
            </tr>
        </tbody>
    </table>

</EditForm>

<br />

</div>
<br />
<div style="display:flex;justify-content:center">
    <button class="button-58" style="margin-right:40px" @onclick="DataEntry">Save Data</button>

    <button class="button-58" style="margin-right:40px"@onclick="Archive">Archive</button>

    <button class="button-58" style="margin-right:40px" @onclick="Searching">Actively Searching for Part</button>

    <button class="button-58" style="margin-right:40px" @onclick="StopSearching">No Longer Searching for Part</button>
</div>




