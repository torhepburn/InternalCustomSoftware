        //        ",[EnteredOn] " +
        //        " from StockroomComments WHERE ShortageID = '" + g.ShortageID + "' " +
        //        "ORDER BY [EnteredOn] DESC", cnxn);

        //try
        //{
        //    cnxn.Open();
        //    dr = cmd.ExecuteReader();

        //    dtc.Load(dr);
