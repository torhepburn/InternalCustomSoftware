    public void DataEntry()
    {
        cnxn = new SqlConnection(g.db);

        cmd = new("UPDATE StockroomLowBinsAppendix " +
                    "SET [FullQuantity] = '" + fullBinQuantity + "'" +
                    "WHERE PartNo = '" + g.item + "'"
                    , cnxn);

        try
        {
            cnxn.Open();
            cmd.ExecuteNonQuery();
        }
        catch (SqlException ex)
        {
            ex.ToString();
        }
        finally
        {
            cnxn.Close();
        }

        cnxn = new SqlConnection(g.db);

        cmd = new("UPDATE StockroomLowBins " +
                    "SET [FullBinQuantity] = '" + fullBinQuantity + "'" +
                    "WHERE PartNo = '" + g.item + "'"
                    , cnxn);

        try
        {
            cnxn.Open();
            cmd.ExecuteNonQuery();
        }
        catch (SqlException ex)
        {
            ex.ToString();
        }
        finally
        {
            cnxn.Close();
        }

        NavMgr.NavigateTo("index");
    }


    public void Archive()
    {
        cnxn = new SqlConnection(g.db);

        cmd = new("UPDATE StockroomLowBins " +
                    "SET [Archived] = 1 " +
                    "WHERE ID = '" + g.ID + "'"
                    , cnxn);

        try
        {
            cnxn.Open();
            cmd.ExecuteNonQuery();
        }
        catch (SqlException ex)
        {
            ex.ToString();
        }
        finally
        {
            cnxn.Close();
        }

        NavMgr.NavigateTo("index");
    }

    public void Searching()
    {
        cnxn = new SqlConnection(g.db);

        cmd = new("UPDATE StockroomLowBins " +
                    "SET [Color] = 'blue' " +
                    "WHERE ID = '" + g.ID + "'"
                    , cnxn);

        try
        {
            cnxn.Open();
            cmd.ExecuteNonQuery();
        }
        catch (SqlException ex)
        {
            ex.ToString();
        }
        finally
        {
            cnxn.Close();
        }

        NavMgr.NavigateTo("index");
    }
    
    public void StopSearching()
    {
        cnxn = new SqlConnection(g.db);

        cmd = new("UPDATE StockroomLowBins " +
                    "SET [Color] = '' " +
                    "WHERE ID = '" + g.ID + "'"
                    , cnxn);

        try
        {
            cnxn.Open();
            cmd.ExecuteNonQuery();
        }
        catch (SqlException ex)
        {
            ex.ToString();
        }
        finally
        {
            cnxn.Close();
        }

        NavMgr.NavigateTo("index");
    }

