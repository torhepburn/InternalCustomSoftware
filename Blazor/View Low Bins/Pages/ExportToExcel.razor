@page "/exporttoexcel"

@using View_Low_Bins.Data
@using System.Data
@using Microsoft.Data.SqlClient
@using static PopUp

@inject NavigationManager NavMgr
@inject Global f

<PageTitle>Export to Excel</PageTitle>

<div class="popup-overlay @(pop.IsVisible ? "visible" : "")">
    <div class="popup-content">
        <h3>@pop.Title</h3>
        <p>@pop.Message</p>
        <button @onclick="pop.ClosePopup">Close</button>
    </div>
</div>


<h1>Export Data to Excel</h1>




@code 
{
    SqlCommand cmd;
    SqlConnection cnxn;
    SqlDataReader dr;

    DataTable dt;

    PopUp pop = new PopUp();

    public string item = "";
    public string stockLocation = "";
    public string ID = "";
    public string quantity = "";

    protected override async Task OnInitializedAsync()
    {
        dt = new DataTable();

        cnxn = new SqlConnection(f.db);

        cmd = new("SELECT " +
                  "CAST(GETDATE() as date) [Date] " +
                  ",'Batch' [Document No_] " +
                  ",PartNo  " +
                  ",COALESCE(FullBinQuantity,'') [Quantity] " +
                  ",COALESCE([Location],'') [Location] " +
                  ",StockLocation [Bin Code] " +
                  ",'' [New Location] " +
                  ",'' [New Bin Code] " +
                  " FROM StockroomLowBins " +
                  " WHERE Archived = 0 " +
                  " ORDER BY PartNo "
                  , cnxn);

        try
        {
            cnxn.Open();
            dr = cmd.ExecuteReader();
            dt.Load(dr);
        }
        catch (SqlException ex)
        {
            ex.ToString();
        }
        finally
        {
            cnxn.Close();

        }
        try
        {
            string filepathServer = @"\\CT-MID-DFS01\Manufacturing\SoftwareDistribution\GPIStock.csv";
            var lines = new List<string>();

            string[] columnNames = dt.Columns
                .Cast<DataColumn>()
                .Select(column => column.ColumnName)
                .ToArray();

            var header = string.Join(",", columnNames.Select(name => $"\"{name}\""));
            lines.Add(header);


            System.Collections.Generic.IEnumerable<string> valueLines;
            valueLines = dt.AsEnumerable()
                .Select(row => string.Join(",", row.ItemArray.Select(val => $"\"{val}\"")));

            lines.AddRange(valueLines);


            File.WriteAllLines(filepathServer, lines);

            pop.Title = "Data Exported";
            pop.Message = filepathServer;
            pop.ShowPopup();
            
        }
        catch (Exception ex)
        {
            pop.Title = "Error";
            pop.Message = ex.ToString();
            pop.ShowPopup();
        }
        finally
        {
            cnxn.Close();
        }
        
        //NavMgr.NavigateTo("index");
    }
    
}
