        <div class="nav-item px-3">
        <NavLink class="nav-link" href="adddisconnectedshortage">
        <span class="oi oi-plus" aria-hidden="true"></span> Add Free Shortage
        </NavLink>
        </div>
        
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="updatedata">
                <span class="oi oi-list-rich" aria-hidden="true"></span> Update Data
            </NavLink>
        </div>
    </nav>
</div>

@code {
    private bool collapseNavMenu = true;

    private string? NavMenuCssClass => collapseNavMenu ? "collapse" : null;

    private void ToggleNavMenu()
    {
        collapseNavMenu = !collapseNavMenu;
    }
}
