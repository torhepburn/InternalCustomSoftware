@page "/exportshortages"

<PageTitle>Export Stockroom Shortages</PageTitle>

@using StockroomShorts.Data
@using System.Data
@using Microsoft.Data.SqlClient
@using static PopUp


@inject Global g
@inject NavigationManager NavMgr

<div class="popup-overlay @(pop.IsVisible ? "visible" : "")">
    <div class="popup-content">
        <h3>@pop.Title</h3>
        <p>@pop.Message</p>
        <button @onclick="pop.ClosePopup">Close</button>
    </div>
</div>


<h1>Export Stockroom Shortages</h1>


@code {

    SqlCommand cmd;
    SqlConnection cnxn;
    SqlDataReader dr;
    DataTable dt;

    PopUp pop = new PopUp();

    public string item = "";
    public string stockLocation = "";
    public string ID = "";
    public string quantity = "";

    protected override void OnInitialized()
    {
        dt = new DataTable();

        cnxn = new SqlConnection(g.db);

        cmd = new(
                     "WITH s1 AS " +
                     "( " +
                    " SELECT " +
                    " ShortageID " +
                    ",MAX(CommentID) CommentID " +
                    " FROM StockroomComments " +
                    " GROUP BY ShortageID  " +
                    ") " +
                    ",s2 AS " +
                    "( " +
                    "	SELECT " +
                    "	s1.ShortageID " +
                    "	,Comment " +
                    "   ,FORMAT([EnteredOn],'MM/dd/yy') EnteredOn " +
                    "	FROM StockroomComments c " +
                    " INNER JOIN s1 ON s1.ShortageID = c.ShortageID and s1.CommentID = c.CommentID " +
                    ") " +
        " select " +
        " ID " +
        ", COALESCE(FORMAT(s.[EnteredOn],'MM/dd/yy'), '') Date " +
        ", COALESCE(WO, '') [Work Order #] " +
        ", COALESCE(PartNo, '') [Part Number] " +
        ", COALESCE(LEFT(PartDescription, 10), '') [Part Description] " +
        ", COALESCE(WOLine, '') [Work Order Line] " +
        ", COALESCE(JobDescription, '') [Job Description] " +
        ", COALESCE(JobReference, '') [Job Reference] " +
        ", COALESCE(Quantity, 0) [Quantity Short] " +
        ", COALESCE(Location, '') [Location] " +
        ", COALESCE(Stocklocation, '') [Bin Code] " +
        ", COALESCE(CostCenter, '') [Cost Center] " +
        ", COALESCE(StockRoomAssociate,'') [Stockroom Associate] " +
        ", COALESCE(Planner, '') [Planner] " +
        ", COALESCE(DueDate, '') [Due Date] " +
        ", COALESCE(s2.Comment,'') [Most Recent Comment] " +
        ", COALESCE(s2.EnteredOn,'') [Comment Date] " +
        ", COALESCE(TRIM(color),'') [Color Code] " +
        " from StockroomShortages s" +
        " LEFT JOIN s2 ON s.ID = s2.ShortageID " +
        "WHERE Archived = 0 " +
        "ORDER BY s.[EnteredOn], [WO], [WOline], ComponentLine", cnxn);

        try
        {
            cnxn.Open();
            dr = cmd.ExecuteReader();
            dt.Load(dr);
        }
        catch (SqlException ex)
        {
            ex.ToString();
        }
        finally
        {
            cnxn.Close();

        }

        try
        {
            //string filepath = Path.Combine(Environment.GetFolderPath(Environment.SpecialFolder.Desktop), "StockroomShortages.csv");
            string filepath = @"\\CT-MID-DFS01\Manufacturing\SoftwareDistribution\StockroomShortages.csv";

            var lines = new List<string>();

            string[] columnNames = dt.Columns
                .Cast<DataColumn>()
                .Select(column => column.ColumnName)
                .ToArray();

            var header = string.Join(",", columnNames.Select(name => $"\"{name}\""));
            lines.Add(header);


            System.Collections.Generic.IEnumerable<string> valueLines;
            valueLines = dt.AsEnumerable()
                .Select(row => string.Join(",", row.ItemArray.Select(val => $"\"{val}\"")));

            lines.AddRange(valueLines);

            File.WriteAllLines(filepath, lines);

        }
        catch (Exception ex)
        {
            pop.Title = "Error";
            pop.Message = ex.ToString();
            pop.ShowPopup();
        }
        finally
        {
            cnxn.Close();
        }
    }
}
}
