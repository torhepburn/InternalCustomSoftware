@page "/addshortage"

<PageTitle>Add Shortage</PageTitle>

@using StockroomShorts.Data

@using System.Data
@using Microsoft.Data.SqlClient
@inject Global g

<h1>Add Shortage</h1>

<EditForm Model="comment" OnValidSubmit="DataEntry">
    <DataAnnotationsValidator />
    <ValidationSummary />

    <InputText id="n1" placeholder="Comment" style="width: 100%; height: 50px" @bind-Value="comment" />
    <br /><br />
    <InputText id="n2" placeholder="Email To" @bind-Value="emailTo" />
    <br /><br />
    <InputText id="n3" placeholder="Email From" @bind-Value="emailFrom" />

</EditForm>
<br />
<button class="btn btn-primary" @onclick="DataEntry">Save Data</button>

@code {
    private int currentCount = 0;

    private void IncrementCount()
    {
        currentCount++;
    }

    SqlCommand cmd;
    SqlConnection cnxn;

    public string comment = "";
    public string emailFrom = "";
    public string emailTo = "";

    public void DataEntry()
    {
        cnxn = new SqlConnection(g.db);

        cmd = new("Insert into StockroomShortages (Item,Quantity,StockLocation, EnteredOn) values ( " +
            //"'" + g.RequestID + "'" +
            //",'" + comment + "'" +
            //",'" + emailFrom + "'" +
            "'6024-0118-01'" +
            ",10 " +
            ",'020-B12' " +
            ",'" + DateTime.Now + "'" +
            ")", cnxn);

        try
        {
            cnxn.Open();
            cmd.ExecuteNonQuery();
        }
        catch (SqlException ex)
        {
            ex.ToString();
        }
        finally
        {
            cnxn.Close();

        }


    }
}
