@page "/addshortage"

<PageTitle>Add Shortage</PageTitle>

@using StockroomShorts.Data

@using System.Data
@using Microsoft.Data.SqlClient
@inject Global g

<h1>Add Shortage</h1>

<EditForm Model="item" OnValidSubmit="DataEntry">
    <DataAnnotationsValidator />
    <ValidationSummary />

    <InputText id="n1" placeholder="Work Order #" style="width: 25%;" @bind-Value="wo" />
    <br /><br />
    <InputText id="n2" placeholder="WO Line No" @bind-Value="woline" />
    <br /><br />
    <InputText id="n3" placeholder="Job Description" @bind-Value="job" />
    <br /><br />
    <InputText id="n4" placeholder="Job Reference" style="width: 10%" @bind-Value="jobreference" />
    <br /><br />
    <InputText id="n5" placeholder="Part No" @bind-Value="item" />
    <br /><br />
    <InputText id="n6" placeholder="Part Description" @bind-Value="partdescription" />
    <br /><br />
    <InputText id="n7" placeholder="Quantity" @bind-Value="quantity" />
    <br /><br />
    <InputText id="n8" placeholder="Location" @bind-Value="location" />
    <br /><br />
    <InputText id="n9" placeholder="Skt Rm Assoc #" style="width: 10%" @bind-Value="storekeeper" />
    <br /><br />
    <InputText id="n10" placeholder="Cost Center Code" @bind-Value="costcenter" />
    <br /><br />
    <InputText id="n11" placeholder="Planner" @bind-Value="planner" />
    <br /><br />
    <InputText id="n11" placeholder="Due Date" @bind-Value="duedate" />


</EditForm>
<br />
<button class="btn btn-primary" @onclick="DataEntry">Save Data</button>

@code {
    
    SqlCommand cmd;
    SqlConnection cnxn;

    public string wo = "";
    public string woline = "";
    public string job = "";
    public string jobreference = "";
    public string item = "";
    public string partdescription = "";
    public string quantity = "";
    public string location = "";
    public string storekeeper = "";
    public string costcenter = "";
    public string planner = "";
    public string duedate = "";
    


    public void DataEntry()
    {
        cnxn = new SqlConnection(g.db);

        cmd = new("Insert into StockroomShortages (" +
                    "[WO] " +
                    ",[WOLine] " +
                    ",[JobDescription] " +
                    ",[JobReference] " +
                    ",[PartNo] " +
                    ",[PartDescription] " +
                    ",[Quantity] " +
                    ",[StockLocation] " +
                    ",[StockRoomAssociate] " +
                    ",[CostCenter] " +
                    ",[Planner] " + 
                    ",[DueDate] " +
                    ",[EnteredOn] " +
                    ") VALUES (" +
                    "'" + wo + "'" +
                    ",'" + woline + "'" +
                    ",'" + job + "'" +
                     ",'" + jobreference + "'" +
                    ",'" + item + "'" + 
                    ",'" + partdescription + "'" +
                    ",'" + quantity + "'" +
                    ",'" + location + "'" +
                    ",'" + storekeeper + "'" + 
                    ",'" + costcenter + "'" +
                    ",'" + planner + "'" +
                    ",'" + duedate + "'" +
                    ",'" + DateTime.Now + "'" +
                    ")", cnxn);

        try
        {
            cnxn.Open();
            cmd.ExecuteNonQuery();
        }
        catch (SqlException ex)
        {
            ex.ToString();
        }
        finally
        {
            cnxn.Close();
        }


    }
}
