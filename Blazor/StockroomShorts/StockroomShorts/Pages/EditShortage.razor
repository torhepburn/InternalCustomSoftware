@page "/editshortage"

<PageTitle>Edit Shortage</PageTitle>

@using StockroomShorts.Data

@using System.Data
@using Microsoft.Data.SqlClient
@inject Global g
@inject NavigationManager NavMgr


<h2>Edit Shortage</h2>
<br />
Date : @enteredOn

<table class="table">
    <thead>
        <tr>
            <th>Work Order Number</th>
            <th>Part Number</th>
            <th>Part Description</th>
            <th>Quantity</th>
        </tr>
    </thead>
    <tbody>
        <tr>
            <td>@wo</td>
            <td>@item</td>
            <td>@partdescription</td>
            <td>@quantity</td>
        </tr>
    </tbody>
</table>
<table class="table">
    <thead>
        <tr>
            <th>Production Order Line Number</th>
            <th>Job Descriptioin</th>
            <th>Job Reference</th>
        </tr>
    </thead>
    <tbody>
        <tr>
            <td>@woline</td>
            <td>@job</td>
            <td>@jobreference</td>
        </tr>
    </tbody>
</table>

<table class="table">
    <thead>
        <tr>
            <th>Comment Date</th>
            <th>Comment</th>
        </tr>
    </thead>
    <tbody>
        @foreach (DataRow r in dtc.Rows)
        {
            <tr>
                <td>@r[0].ToString()</td>
                <td>@r[1].ToString()</td>
            </tr>
        }
    </tbody>
</table>
 

<EditForm Model="item" OnValidSubmit="DataEntry">
    <DataAnnotationsValidator />
    <ValidationSummary />
    <table>
        <tbody>
            <tr>
                <td>
                    Location :
                    <InputText id="n8" placeholder="Location" @bind-Value="location" />
                </td>
                <td>
                    Bin Code :
                    <InputText id="n9" placeholder="BinCode" @bind-Value="binCode" /> 
                </td>
                <td>
                    Stockroom Associate :
                    <InputText id="n10" placeholder="Skt Rm Assoc #" @bind-Value="storekeeper" />
                </td>
            </tr>
            <tr>
                <td>
                    Cost Center :
                    <InputText id="n11" placeholder="CostCenter" @bind-Value="costcenter" />
                </td>
                <td>
                    Planner :
                    <InputText id="n12" placeholder="Planner" @bind-Value="planner" />
                </td>
                <td>
                    Due Date :
                    <InputText id="n13" placeholder="Due Date" @bind-Value="duedate" />
                </td>
            </tr>
        </tbody>
    </table>    
    @*<br /><br />Location :
    <InputText id="n8" placeholder="Location" @bind-Value="location" />
    <br /><br />Bin Code :
    <InputText id="n8" placeholder="BinCode" @bind-Value="binCode" />
    <br /><br />Stockroom Associate :
    <InputText id="n9" placeholder="Skt Rm Assoc #" style="width: 20%" @bind-Value="storekeeper" />
    <br /><br />Cost Center :
    <InputText id="n10" placeholder="Cost Center Code" @bind-Value="costcenter" />
    <br /><br />Planneer :
    <InputText id="n11" placeholder="Planner" @bind-Value="planner" />
    <br /><br />Due Date :
    <InputText id="n11" placeholder="Due Date" @bind-Value="duedate" />
    <InputDate id="n12" required @bind-Value="_dateSample.ddate"/>*@


</EditForm>
<br />
<button class="btn btn-primary" @onclick="DataEntry">Save Data</button>

<button class="btn btn-primary " @onclick="Archive">Archive</button>

<AddComment></AddComment>


@code {

    public class DateSample
    {
        public DateTime ddate { get; set; }
    }
    private DateSample _dateSample = new DateSample();

    public string enteredOn = "";
    public string wo = "";
    public string woline = "";
    public string job = "";
    public string jobreference = "";
    public string item = "";
    public string partdescription = "";
    public string quantity = "";
    public string location = "";
    public string binCode = "";
    public string storekeeper = "";
    public string costcenter = "";
    public string planner = "";
    public string duedate = "";
    public string comment = "";
    public string commentEntered = "";

    SqlCommand cmd;
    SqlConnection cnxn;
    SqlDataReader dr;
    DataTable dt;
    DataTable dtc;

    protected override void OnInitialized()
    {
        dt = new DataTable();

        cnxn = new SqlConnection(g.db);

        cmd = new SqlCommand("SELECT " +
                " ID " +                                                //0
                ", COALESCE(FORMAT([EnteredOn], 'MM/dd/yy'),'') " +     //1
                ", COALESCE(WO, '') " +                                 //2
                ", COALESCE(PartNo, '') " +                             //3
                ", COALESCE(PartDescription, '') " +                    //4
                ", COALESCE(WOLine, '') " +                             //5
                ", COALESCE(JobDescription, '') " +                     //6
                ", COALESCE(JobReference, '') " +                       //7
                ", COALESCE(Quantity, 0) " +                            //8
                ", COALESCE(Stocklocation, '') " +                      //9
                ", COALESCE(CostCenter, '') " +                         //10
                ", COALESCE(StockRoomAssociate,'') " +                  //11
                ", COALESCE(Planner, '') " +                            //12
                ", COALESCE([DueDate], '') " +                          //13
                ", COALESCE(Location, '') " +                           //14
                " from StockroomShortages WHERE ID = '" + g.ShortageID + "' " +
                " AND Archived = 0 " +
                "ORDER BY [EnteredOn] DESC, [WO], [WOline], ComponentLine", cnxn);

        try
        {
            cnxn.Open();
            dr = cmd.ExecuteReader();
            while (dr.Read())
            {
                enteredOn = dr.GetString(1);
                wo = dr.GetString(2);
                item = dr.GetString(3);
                partdescription = dr.GetString(4);
                woline = dr.GetInt32(5).ToString();
                job = dr.GetString(6);
                jobreference = dr.GetString(7);
                quantity = dr.GetInt32(8).ToString();
                binCode = dr.GetString(9);
                storekeeper = dr.GetString(11);
                costcenter = dr.GetString(10);
                planner = dr.GetString(12);
                duedate = dr.GetString(13);
                location = dr.GetString(14);
            }

            dt.Load(dr);
        }
        catch (SqlException ex)
        {
            ex.ToString();
        }
        finally
        {
            cnxn.Close();

        }


        dtc = new DataTable();

        cmd = new SqlCommand("SELECT " +
                "COALESCE(FORMAT([EnteredOn], 'MM/dd/yy'),'') " +
                ", COALESCE(Comment, '') " +
                " from StockroomComments WHERE ShortageID = '" + g.ShortageID + "' " +
                "ORDER BY [EnteredOn] DESC", cnxn);

        try
        {
            cnxn.Open();
            dr = cmd.ExecuteReader();

            dtc.Load(dr);
        }
        catch (SqlException ex)
        {
            ex.ToString();
        }
        finally
        {
            cnxn.Close();
        }


        _dateSample.ddate = DateTime.Now;
    }

    public void DataEntry()
    {
        cnxn = new SqlConnection(g.db);

        cmd = new("UPDATE StockroomShortages " +
                    "SET [StockLocation] = '" + binCode + "'" +
                    ",[StockRoomAssociate] = '" + storekeeper + "'" +
                    ",[CostCenter] = '" + costcenter + "'" +
                    ",[Planner] = '" + planner + "'" + 
                    ",[DueDate] = '" + duedate + "'" +
                    ",Location = '" + location + "' " +
                    "WHERE ID = '" + g.ShortageID + "'"
                    , cnxn);

        try
        {
            cnxn.Open();
            cmd.ExecuteNonQuery();
        }
        catch (SqlException ex)
        {
            ex.ToString();
        }
        finally
        {
            cnxn.Close();
        }

        NavMgr.NavigateTo("/");
    }

    public void Archive()
    {
        cnxn = new SqlConnection(g.db);

        cmd = new("UPDATE StockroomShortages " +
                    "SET [Archived] = 1 " +
                    "WHERE ID = '" + g.ShortageID + "'"
                    , cnxn);

        try
        {
            cnxn.Open();
            cmd.ExecuteNonQuery();
        }
        catch (SqlException ex)
        {
            ex.ToString();
        }
        finally
        {
            cnxn.Close();
        }

        NavMgr.NavigateTo("/");
    }
}
