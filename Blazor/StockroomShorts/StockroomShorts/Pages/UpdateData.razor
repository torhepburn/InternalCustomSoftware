                 "AND[Bin Code] LIKE '%OFS%' " +
                 "GROUP BY[Item No_] " +
                 "), " +
                "IQC AS " +
                "( " +
                "SELECT " +
                "[Item No_] " +
                ", SUM(Quantity) IQC_Q " +
                "FROM [ZYGO$Warehouse Entry] " +
                "WHERE [Location Code] IN ('MID') " +
                "AND [Bin Code] LIKE '%IQC%' " +
                "GROUP BY[Item No_] " +
                "), " +
                "OH AS " +
                "( " +
                "SELECT " +
                "[Item No_] " +
                ", SUM(Quantity) OH_Q " +
                "FROM [ZYGO$Warehouse Entry] " +
                "WHERE [Location Code] IN ('MID') " +
                "AND ([Bin Code] NOT LIKE '%IQC%' AND [Bin Code] NOT LIKE '%OFS%') " +
                "GROUP BY[Item No_] " +
                " ) " +
                "SELECT " +
                "OH.[Item No_] " +
                ",OH_Q OH " +
                ", COALESCE(OFS_Q, 0) OFS " +
                ",COALESCE(IQC_Q, 0) IQC " +
                "FROM OH LEFT JOIN OFS ON OH.[Item No_] = OFS.[Item No_] " +
                "LEFT JOIN IQC ON OH.[Item No_] = IQC.[Item No_] ";


        tableName = "[Item_OH_MID_OFS]";

        MakeTables();


        select = " select " +
                 "[Prod_ Order No_] [WO] " +
                 ",[Prod_ Order Line No_] [WOLine] " +
                 ",[Line No_] [ComponentLine] " +
                 ",[Item No_] [PartNo] " +
                 "from [ZYGO$Prod_ Order Component] " +
                 "WHERE Status IN (3,4) " +
                 "AND [Remaining Quantity] = 0 ";


        tableName = "[StS_WO_Components_Issued]";

        MakeTables();

        //archived issued components

        try
        {
            cmd = new(" UPDATE ss " +
                      " SET Archived = 1 " +
                      " from Stockroomshortages ss " +
                      " inner join [StS_WO_Components_Issued] s1 " +
                      " on s1.[WO] = ss.WO " +
                      " AND s1.WOLine = ss.WOLine " +
                      " AND s1.ComponentLine = ss.ComponentLine " +
                      " where archived = 0 ", cnxn);

            cnxn.Open();
            cmd.ExecuteNonQuery();
            cnxn.Close();
            //dt.Load(dr);
        }
        catch (SqlException ex)
        {
            ex.ToString();
        }
        finally
        {
            cnxn.Close();

        }



        //green first - On Hand in warehouse

        try
        {
            cmd = new("UPDATE StockroomShortages set color = '' WHERE color IN  ('green','orange','purple') AND archived = 0 ", cnxn);

            cnxn.Open();
            cmd.ExecuteNonQuery();
            cnxn.Close();
            
            cmd = new(" UPDATE ss " +
                      " SET color = 'green' " +
                      " from Stockroomshortages ss " +
                      " inner join [Item_OH_MID_OFS] s1 on s1.[Item No_] = ss.PartNo " +
                      " where s1.OH > 0 " +
                      " AND color <> 'blue' " +
                      " AND archived = 0 ", cnxn);

            cnxn.Open();
            cmd.ExecuteNonQuery();
            cnxn.Close();
            //dt.Load(dr);
        }
        catch (SqlException ex)
        {
            ex.ToString();
        }
        finally
        {
            cnxn.Close();

        }

        //orange  OFS

        try
        {
            cmd = new(" UPDATE ss " +
                      " SET color = 'orange' " +
                      " from Stockroomshortages ss " +
                      " inner join [Item_OH_MID_OFS] s1 on s1.[Item No_] = ss.PartNo " +
                      " where s1.OH = 0 " +
                      " AND OFS > 0" +
                      " AND color <> 'blue' " +
                      " AND archived = 0 ", cnxn);

            cnxn.Open();
            cmd.ExecuteNonQuery();
            cnxn.Close();
            //dt.Load(dr);
        }
        catch (SqlException ex)
        {
            ex.ToString();
        }
        finally
        {
            cnxn.Close();

        }

        //purple IQC

        //orange  OFS

        try
        {
            cmd = new(" UPDATE ss " +
                      " SET color = 'purple' " +
                      " from Stockroomshortages ss " +
                      " inner join [Item_OH_MID_OFS] s1 on s1.[Item No_] = ss.PartNo " +
                      " where s1.OH = 0 " +
                      " AND IQC > 0" +
                      " AND color <> 'blue' " +
                      " AND archived = 0 ", cnxn);

            cnxn.Open();
            cmd.ExecuteNonQuery();
            cnxn.Close();
            //dt.Load(dr);
        }
        catch (SqlException ex)
        {
            ex.ToString();
        }
        finally
        {
            cnxn.Close();

        }


        //yellow second

        try
        {
            cmd = new("UPDATE StockroomShortages set color = '' WHERE color = 'yellow' AND archived = 0 ", cnxn);

            cnxn.Open();
            cmd.ExecuteNonQuery();
            cnxn.Close();

            cmd = new(" UPDATE ss " +
                      " SET color = 'yellow' " +
                      " from Stockroomshortages ss " +
                      " inner join [Item_WO_Released_MID_OFS] s1 on s1.[Item No_] = ss.PartNo " +
                      " where s1.OO > 0 " +
                      " AND archived = 0 " +
                      " AND ss.color NOT IN ('green','blue')", cnxn);

            cnxn.Open();
            cmd.ExecuteNonQuery();
            cnxn.Close();
            //dt.Load(dr);
        }
        catch (SqlException ex)
        {
            ex.ToString();
        }
        finally
        {
            cnxn.Close();

        }

        //red third

        try
        {
            cmd = new("UPDATE StockroomShortages set color = 'red' WHERE LEN(COALESCE(color,'')) = 0 AND archived = 0 ", cnxn);

            cnxn.Open();
            cmd.ExecuteNonQuery();
            cnxn.Close();

            //dt.Load(dr);
        }
        catch (SqlException ex)
        {
            ex.ToString();
        }
        finally
        {
            cnxn.Close();

        }

        NavMgr.NavigateTo("viewShortages");
    }

    private void MakeTables()
    {
        cnxnNAV = new SqlConnection(g.dbNAV);
        SqlCommand cmd = new SqlCommand(select, cnxnNAV);
        SqlDataAdapter da = new SqlDataAdapter(select, cnxnNAV);
        DataTable table = new DataTable();
        da.Fill(table);

        cnxn = new SqlConnection(g.db);

        cnxn.Open();
        SqlBulkCopy copy = new SqlBulkCopy(cnxn);
        copy.DestinationTableName = tableName;

        try
        {
            copy.WriteToServer(table);
        }
        catch (Exception ex)
        {
            //MessageBox.Show(ex.ToString());
        }
        finally
        {
            cnxn.Close();
        }
    }

