    public string item = "";
    public string stockLocation = "";
    public string ID = "";
    public string quantity = "";
    public string select = "";
    public string tableName = "";

    protected override void OnInitialized()
    {
        cnxn = new SqlConnection(g.db);

        cmd = new("TRUNCATE TABLE Item_WO_Released_MID_OFS ", cnxn);

        cnxn.Open();
        cmd.ExecuteNonQuery();
        cnxn.Close();

        cmd = new("TRUNCATE TABLE [Item_OH_MID_OFS] ", cnxn);

        cnxn.Open();
        cmd.ExecuteNonQuery();
        cnxn.Close();

        cmd = new("TRUNCATE TABLE [StS_WO_Components_Issued] ", cnxn);

        cnxn.Open();
        cmd.ExecuteNonQuery();
        cnxn.Close();

        dt = new DataTable();

        select ="WITH OFS AS " +
                "( " +
                "SELECT " +
                "[Item No_] " +
                ", SUM([Remaining Quantity]) OFS_Q " +
                "   FROM [ZYGO$Prod_ Order Line] " +
                "	WHERE [Location Code] IN ('MID') " +
                "	AND [Bin Code] LIKE '%OFS%' " +
                "	GROUP BY [Item No_]  " +
                "), " +
                "IQC AS " +
                "( " +
                "SELECT " +
                "[Item No_] " +
                ", SUM([Remaining Quantity]) IQC_Q " +
                "	FROM [ZYGO$Prod_ Order Line] " +
                "WHERE [Location Code] IN ('MID') " +
                "	AND [Bin Code] LIKE '%IQC%' " +
                "	GROUP BY [Item No_]  " +
                "), " +
                "OH AS " +
                "( " +
                "SELECT " +
                "[Item No_] " +
                ", SUM([Remaining Quantity]) OO_Q " +
                "	FROM [ZYGO$Prod_ Order Line] " +
                "WHERE [Location Code] IN ('MID') " +
                "	AND ([Bin Code] NOT LIKE '%IQC%' AND [Bin Code] NOT LIKE '%OFS%') " +
                "	GROUP BY [Item No_]  " +
                ") " +
                "SELECT " +
                "OH.[Item No_] " +
                ",OO_Q OO " +
                ",COALESCE(OFS_Q,0) OFS " +
                ",COALESCE(IQC_Q,0) IQC " +
                "FROM OH LEFT JOIN OFS ON OH.[Item No_] = OFS.[Item No_] " +
                "LEFT JOIN IQC ON OH.[Item No_] = IQC.[Item No_] ";


        tableName = "Item_WO_Released_MID_OFS";

        MakeTables();


        select = " WITH OFS AS " +
                 "( " +
                 "  SELECT " +
                 "  [Item No_] " +
