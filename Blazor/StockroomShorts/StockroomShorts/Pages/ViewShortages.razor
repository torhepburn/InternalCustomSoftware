<h1>Stockroom Shortages</h1>

<table class="table table-bordered">
    <thead class="border border-dark">
            <tr>
            <th><div style="background-color:rgb(175,255,140)">On Hand</div></th>
            <th><div style="background-color:rgb(0,255,255)">Inadequate Quantity</div></th>
            <th><div style="background-color:rgb(255,255,140)">On Order</div></th>
            <th><div style="background-color:rgb(255,109,106)">Not On Order/Not On Hand</div></th>
            <th><div style="background-color:rgb(135,206,250)">Actively Searching</div></th>
            <th><div style="background-color:rgb(255,187,51)">OFS (Offsite)</div></th>
            <th><div style="background-color:rgb(213,128,255)">IQC (QC Inspection)</div></th>
</tr>
</thead>
</table>
<table class="table table-bordered">
    <thead class="border border-dark">
            <tr>
                <th>Date</th>
                <th>Work Order #</th>
                <th width="170">Part Number</th>
                <th>Part Description</th>
               @* <th>WO Line #</th>*@
                <th>Job Reference</th>
                <th>Quantity Short</th>
                @*<th>Location</th>*@
                <th width="140">Bin Code</th>
                <th width="40">Cost Center</th>
                <th>Stockrom Associate</th>
                <th>Planner</th>
                <th>Due Date</th>
                <th>Most Recent Comment</th>
                <th>Comment Date</th>
            </tr>
        </thead>
    <tbody class="border border-dark">
        @foreach (DataRow r in dt.Rows)
        {
            string bgstyle="";
            string bgclass = "";
            if (r[17].ToString() == "green")
            {
                string what = r[17].ToString();
                bgclass = "";
                bgstyle = "background-color:rgb(175,255,140)";
            }
            if (r[17].ToString() == "yellow")
            {
                string what = r[17].ToString();
                bgclass = "";
                bgstyle = "background-color:rgb(255, 255, 140)";
            }
            if (r[17].ToString() == "red")
            {
                string what = r[17].ToString();
                bgclass = "";                         
                bgstyle = "background-color:rgb(255,109,106)";
            }
            if (r[17].ToString() == "blue")
            {
                string what = r[17].ToString();
                bgclass = "";                         
                bgstyle = "background-color:rgb(135,206,250)";
            }
            if (r[17].ToString() == "orange")
            {
                string what = r[17].ToString();
                bgclass = "";                         
                bgstyle = "background-color:rgb(255,187,51)";
            }
            if (r[17].ToString() == "purple")
            {
                string what = r[17].ToString();
                bgclass = "";
                bgstyle = "background-color:rgb(213,128,255)";
            }
            if (r[17].ToString() == "cyan")
            {
                string what = r[17].ToString();
                bgclass = "";
                bgstyle = "background-color:rgb(0,255,255)";
            }

            <tr class=@bgclass style=@bgstyle @onclick="() => Select(r[0].ToString())">
                <td style="width:80px">@r[1].ToString()</td>
                <td class="border border-dark">@r[2].ToString()</td>
                <td class="border border-dark" style="width:150px">@r[3].ToString()</td>
                <td class="border border-dark">@r[4].ToString()</td>
                <td class="border border-dark">@r[7].ToString()</td>
                <td class="border border-dark">@r[8].ToString()</td>
                @*<td class="border border-dark">@r[9].ToString()</td>*@
                <td class="border border-dark">@r[10].ToString()</td>
                <td class="border border-dark">@r[11].ToString()</td>
                <td class="border border-dark">@r[12].ToString()</td>
                <td class="border border-dark">@r[13].ToString()</td>
                <td class="border border-dark">@r[14].ToString()</td>
                <td class="border border-dark">@r[15].ToString()</td>
                <td class="border border-dark">@r[16].ToString()</td>
                    </tr>
        }
        </tbody>
    </table>




@code {

    SqlCommand cmd;
    SqlConnection cnxn;
    SqlDataReader dr;
    DataTable dt;

    PopUp pop = new PopUp();

    public string item = "";
    public string stockLocation = "";
    public string ID = "";
    public string quantity = "";

    protected override void OnInitialized()
    {
        dt = new DataTable();

        cnxn = new SqlConnection(g.db);

        cmd = new(
                     "WITH s1 AS " +
                     "( " +
                    " SELECT " +
                    " ShortageID " +
                    ",MAX(CommentID) CommentID " +
                    " FROM StockroomComments " +
                    " GROUP BY ShortageID  " +
                    ") " +
                    ",s2 AS " +
                    "( " +
                    "	SELECT " +
                    "	s1.ShortageID " +
                    "	,Comment " +
                    "   ,FORMAT([EnteredOn],'MM/dd/yy') EnteredOn " +
                    "	FROM StockroomComments c " +
                    " INNER JOIN s1 ON s1.ShortageID = c.ShortageID and s1.CommentID = c.CommentID " +
                    ") " +
        " select " +
        " ID " +
        ", COALESCE(FORMAT(s.[EnteredOn],'MM/dd/yy'), '') Date " +
        ", COALESCE(WO, '') [Work Order #] " +
        ", COALESCE(PartNo, '') [Part Number] " +
        ", COALESCE(LEFT(PartDescription, 10), '') [Part Description] " +
        ", COALESCE(WOLine, '') [Work Order Line] " +
        ", COALESCE(JobDescription, '') [Job Description] " +
        ", COALESCE(JobReference, '') [Job Reference] " +
        ", COALESCE(Quantity, 0) [Quantity Short] " +
        ", COALESCE(Location, '') [Location] " +
        ", COALESCE(Stocklocation, '') [Bin Code] " +
        ", COALESCE(CostCenter, '') [Cost Center] " +
        ", COALESCE(StockRoomAssociate,'') [Stockroom Associate] " +
        ", COALESCE(Planner, '') [Planner] " +
        ", COALESCE(DueDate, '') [Due Date] " +
        ", COALESCE(s2.Comment,'') [Most Recent Comment] " +
        ", COALESCE(s2.EnteredOn,'') [Comment Date] " +
        ", COALESCE(TRIM(color),'') [Color Code] " +
        " from StockroomShortages s" +
        " LEFT JOIN s2 ON s.ID = s2.ShortageID " +
        "WHERE Archived = 0 " +
        "ORDER BY s.[EnteredOn], [WO], [WOline], ComponentLine", cnxn);

        try
        {
            cnxn.Open();
            dr = cmd.ExecuteReader();
            dt.Load(dr);
        }
        catch (SqlException ex)
        {
            ex.ToString();
        }
        finally
        {
            cnxn.Close();

        }
    }

    private void Select(string ID)
    {
        g.ShortageID = ID;
        NavMgr.NavigateTo("EditShortage");
    }

    
}

