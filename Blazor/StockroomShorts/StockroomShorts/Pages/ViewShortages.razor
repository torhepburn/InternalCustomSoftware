@page "/ViewShortages"

<PageTitle>Stockroom Shortages</PageTitle>

@using StockroomShorts.Data
@using System.Data
@using Microsoft.Data.SqlClient

@inject Global g
@inject NavigationManager NavMgr

<h1>Stockroom Shortages</h1>

<p>This component demonstrates fetching data from a service.</p>

<table class="table">
        <thead>
            <tr>
                <th>Date</th>
                <th>Work Order #</th>
                <th>Part #</th>
                <th>Part Description</th>
                <th>WO Line #</th>
                <th>Job Description</th>
                <th>Job Reference</th>
                <th>Quantity Short</th>
                <th>Location</th>
                <th>Bin Code</th>
                <th>Cost Center</th>
                <th>Stockrom Associate</th>
                <th>Planner</th>
                <th>Due Date</th>
            </tr>
        </thead>
        <tbody>
        @foreach (DataRow r in dt.Rows)
        {
                    <tr @onclick="() => Select(r[14].ToString())">
                        <td>@r[0].ToString()</td>
                        <td>@r[1].ToString()</td>
                        <td>@r[2].ToString()</td>
                        <td>@r[3].ToString()</td>
                        <td>@r[4].ToString()</td>
                        <td>@r[5].ToString()</td>
                        <td>@r[6].ToString()</td>
                        <td>@r[7].ToString()</td>
                        <td>@r[8].ToString()</td>
                        <td>@r[9].ToString()</td>
                        <td>@r[10].ToString()</td>
                        <td>@r[11].ToString()</td>
                        <td>@r[12].ToString()</td>
                    </tr>
        }
        </tbody>
    </table>




@code {

    SqlCommand cmd;
    SqlConnection cnxn;
    SqlDataReader dr;
    DataTable dt;

    public string item = "";
    public string stockLocation = "";
    public string ID = "";
    public string quantity = "";

    protected override void OnInitialized()
    {
        dt = new DataTable();

        cnxn = new SqlConnection(g.db);

        cmd = new("select " +
        " COALESCE(FORMAT([EnteredOn],'MM/dd/yy'), '') " +
        ", COALESCE(WO, '') " +
        ", COALESCE(PartNo, '') " +
        ", COALESCE(PartDescription, '') " +
        ", COALESCE(WOLine, '') " +
        ", COALESCE(JobDescription, '') " +
        ", COALESCE(JobReference, '') " +
        ", COALESCE(Quantity, 0) " +
        ", COALESCE(Location, '') " +
        ", COALESCE(Stocklocation, '') " +
        ", COALESCE(CostCenter, '') " +
        ", COALESCE(StockRoomAssociate,'') " +
        ", COALESCE(Planner, '') " +
        ", COALESCE(DueDate, '') " +
        ", ID " +
        " from StockroomShortages " +
        "WHERE Archived = 0 " +
        "ORDER BY [EnteredOn] DESC, [WO], [WOline], ComponentLine", cnxn);

        try
        {
            cnxn.Open();
            dr = cmd.ExecuteReader();
            dt.Load(dr);
        }
        catch (SqlException ex)
        {
            ex.ToString();
        }
        finally
        {
            cnxn.Close();

        }
    }

    private void Select(string ID)
    {
        g.ShortageID = ID;
        NavMgr.NavigateTo("EditShortage");
    }
}
