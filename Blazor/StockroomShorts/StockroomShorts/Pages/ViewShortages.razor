@page "/"

<PageTitle>Stockroom Shortages</PageTitle>

@using StockroomShorts.Data
@using System.Data
@using Microsoft.Data.SqlClient

@inject Global g
@inject NavigationManager NavMgr

<h1>Stockroom Shortages</h1>

<table class="table">
        <thead>
            <tr>
                <th>Date</th>
                <th>Work Order #</th>
                <th>Part Number</th>
                <th>Part Description</th>
               @* <th>WO Line #</th>*@
                <th>Job Reference</th>
                <th>Quantity Short</th>
                <th>Location</th>
                <th>Bin Code</th>
                <th>Cost Center</th>
                <th>Stockrom Associate</th>
                <th>Planner</th>
                <th>Due Date</th>
                <th>Most Recent Comment</th>
                <th>Comment Date</th>
            </tr>
        </thead>
        <tbody>
        @foreach (DataRow r in dt.Rows)
        {
            string bgclass = "";
            if (r[17].ToString() == "green")
            {
                string what = r[17].ToString();
                //bgclass = "bg-success"; //green;
                bgclass = "text-white bg-success";                         //bgclass = "bg-warning" //yellow;
                                                                  //bgclass = "bg-info";
                //<p class="text-success">.text-success</p>
            }
            <tr class=@bgclass @onclick="() => Select(r[0].ToString())">
                        <td>@r[1].ToString()</td>
                        <td>@r[2].ToString()</td>
                        <td style="width:150px">@r[3].ToString()</td>
                        <td>@r[4].ToString()</td>
                        <td>@r[7].ToString()</td>
                        <td>@r[8].ToString()</td>
                        <td>@r[9].ToString()</td>
                        <td>@r[10].ToString()</td>
                        <td>@r[11].ToString()</td>
                        <td>@r[12].ToString()</td>
                        <td>@r[13].ToString()</td>
                        <td>@r[14].ToString()</td>
                        <td>@r[15].ToString()</td>
                        <td>@r[16].ToString()</td>
                    </tr>
        }
        </tbody>
    </table>




@code {

    SqlCommand cmd;
    SqlConnection cnxn;
    SqlDataReader dr;
    DataTable dt;

    public string item = "";
    public string stockLocation = "";
    public string ID = "";
    public string quantity = "";

    protected override void OnInitialized()
    {
        dt = new DataTable();

        cnxn = new SqlConnection(g.db);

        cmd = new(
                     "WITH s1 AS " +
                     "( " +
                    " SELECT " +
                    " ShortageID " +
                    ",MAX(CommentID) CommentID " +
                    " FROM StockroomComments " +
                    " GROUP BY ShortageID  " +
                    ") " +
                    ",s2 AS " +
                    "( " +
                    "	SELECT " +
                    "	s1.ShortageID " +
                    "	,Comment " +
                    "   ,FORMAT([EnteredOn],'MM/dd/yy') EnteredOn " +
                    "	FROM StockroomComments c " +
                    " INNER JOIN s1 ON s1.ShortageID = c.ShortageID and s1.CommentID = c.CommentID " +
                    ") " +
        " select " +
        " ID " +
        ", COALESCE(FORMAT(s.[EnteredOn],'MM/dd/yy'), '') " +
        ", COALESCE(WO, '') " +
        ", COALESCE(PartNo, '') " +
        ", COALESCE(PartDescription, '') " +
        ", COALESCE(WOLine, '') " +
        ", COALESCE(JobDescription, '') " +
        ", COALESCE(JobReference, '') " +
        ", COALESCE(Quantity, 0) " +
        ", COALESCE(Location, '') " +
        ", COALESCE(Stocklocation, '') " +
        ", COALESCE(CostCenter, '') " +
        ", COALESCE(StockRoomAssociate,'') " +
        ", COALESCE(Planner, '') " +
        ", COALESCE(DueDate, '') " +
        ", COALESCE(s2.Comment,'') " +
        ", COALESCE(s2.EnteredOn,'') " +
        ", COALESCE(TRIM(color),'') " +
        " from StockroomShortages s" +
        " LEFT JOIN s2 ON s.ID = s2.ShortageID " +
        "WHERE Archived = 0 " +
        "ORDER BY s.[EnteredOn], [WO], [WOline], ComponentLine", cnxn);

        try
        {
            cnxn.Open();
            dr = cmd.ExecuteReader();
            dt.Load(dr);
        }
        catch (SqlException ex)
        {
            ex.ToString();
        }
        finally
        {
            cnxn.Close();

        }
    }

    private void Select(string ID)
    {
        g.ShortageID = ID;
        NavMgr.NavigateTo("EditShortage");
    }
}
