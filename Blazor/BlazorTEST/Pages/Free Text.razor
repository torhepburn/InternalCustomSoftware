@page "/home"


@inherits LayoutComponentBase
@inject NavigationManager NavManager
@inject FreeData freeData


<div class="border-bottom" > @*Title*@
    <h1><b>Welcome! Enter or find your data to continue</b></h1>
</div>
<br />
<h6><b>Custom Input</b></h6>


<div class="border-bottom">
    <h4><i>Enter Data</i></h4>
    <EditForm Model="partNum" OnValidSubmit="Submit">
        <DataAnnotationsValidator />
        <ValidationSummary />

        <InputText id="num" placeholder = "Part Number" @bind-Value="partNum" />

        <InputText id="name" placeholder = "Description" @bind-Value="description" />

        <InputText id="name" placeholder = "Revision" @bind-Value="rev" />
        
    </EditForm>
    <br />
    <button type="button" class="btn btn-primary" @onclick="Submit">Submit</button>
    <br /><br />
</div>


<br />
<Get_Data></Get_Data>

@code {
    public string partNum = "";
    public string description = "";
    public string rev = "";
    public string value = "";
    public bool showDetails = false;
    private void Submit()
    {
        this.StateHasChanged();

        freeData.PartNum = partNum;
        freeData.Description = description;
        freeData.Rev = rev;
        NavManager.NavigateTo("labeldetails/free"); 
    }

}
