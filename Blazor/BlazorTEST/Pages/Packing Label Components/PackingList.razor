@page "/packinglist"

<h3>Packing List</h3>

@using ZPLPrinter.Data
@using System.Windows
@using System.Data
@using Microsoft.Data.SqlClient
@using System.Drawing.Printing
@using Microsoft.AspNetCore.Components.Authorization
@inject NavigationManager NavManager
@inject AuthenticationStateProvider AuthProvider
@inject FreeData freeData
@inject Printer printer


@*design how the hyperlinks look in the GetData table*@
<style>
    a:link {
        color: rgb(220, 0, 0);
        background-color: transparent;
        text-decoration: none;
    }

    a:visited {
        color: rgb(220, 0, 0);
        background-color: transparent;
        text-decoration: none;
    }

    a:hover {
        color: red;
        background-color: transparent;
        text-decoration: underline;
    }

    a:active {
        color: rgb(220, 0, 0);
        background-color: transparent;
        text-decoration: underline;
    }
</style>


<h6><b>Find Packing List</b></h6>

<div class="border-0">
    <EditForm Model="searchFilter" @onclick="getRecords">
        <DataAnnotationsValidator />
        <ValidationSummary />

        <h4><i>Enter the description or item number </i></h4>
        <InputText id="num" placeholder="Keyword" @bind-Value="searchFilter" />


        @*<button type="button" class="btn btn-primary btn-sm" @onclick="getRecords">Filter</button>*@
        <input type="submit" class="btn btn-primary btn-sm" @onfocus="getRecords" @onclick="getRecords" title="Filter" value="Filter" /> @*onfocus and onclick are both used to avoid double clicking the button*@
        @if (emptyText == true) @*Case in which nothing is searched for*@
        {
            <br />

            <br />
            <h4><b>You must enter a keyword!</b></h4>
        }
        @if (dt != null && dt.Rows.Count > 0)
        {
            <body style="overflow-y:scroll; height:500px; width:800px;"> @*overflow allows scrollbar in table*@
                <table style="border:ridge; border-color:grey;" class="table">
                    <thead>
                        <tr style="background-color:white; color:black;">
                            <th>Packing List</th>
                            <th>Description</th>
                            <th>Revision</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (dt != null)
                        {
                            @foreach (DataRow items in dt.Rows)
                            {
                                <tr @onclick="() => prints(items[0].ToString())"> @*Use this to make selectable table instead of links. Can only manage to pass one parameter at the moment. Might need to pass a class of vars.*@
                                    <style>                                       @*https://www.telerik.com/blogs/how-to-pass-arguments-to-your-onclick-functions-blazor use this link to pass parameter*@
                                        tr:hover {
                                            background-color: rgba(220,0,0,200);
                                            color: white;
                                        }
                                    </style>
                                    <td> @items[0].ToString()</td> 
                                    <td> @items[1].ToString()</td>
                                    <td> @items[2].ToString()</td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </body>
        }
        else if (dt != null && dt.Rows.Count == 0 && emptyText == false) @*Case in which the search results yielded nothing*@
        {
            <br />

            <br />
            <h4><b>Nothing was found!</b></h4>
        }
    </EditForm>
</div>


@code {
    public DataTable dt;
    public string searchFilter = "";
    public bool isSearching = false; //This variable was for having a spinner while results are loading. Could be useful in future however loading times are quick
    public bool emptyText = false;

    //Filter the data in table
    public void getRecords() //Gets data for table based on search
    {

        if (searchFilter == "")
        {
            emptyText = true;
        }
        else
        {
            emptyText = false;
        }
        SqlCommand cmd;
        SqlConnection cnxn = new SqlConnection(g.db);
        SqlDataReader dr;

        try
        {
            if (!string.IsNullOrEmpty(searchFilter))
            {
                isSearching = true;
                StateHasChanged();
                cmd = new SqlCommand(
                    "Select distinct documentnumber [Packing List], pldescription [Description], Revision " +
                    "from labels_packinglists order by documentnumber, revision ", cnxn);
                //unsecure way to filter
                dt = new();
                cnxn.Open();
                dr = cmd.ExecuteReader();
                dt.Load(dr);
                isSearching = false;

            }

        }
        catch (SqlException ex)
        {
            isSearching = false;
        }
        finally
        {
            cnxn.Close();
        }
        StateHasChanged();
    }

    public void prints(string iDescription)
    {
        string line1 = "";
        string line2 = "";
        string line3 = "";

        int firstLastIndex = 0;
        int secondLastIndex = 0;

        int descriptionLength = iDescription.Length;

        if (descriptionLength < 15)
        {
            line1 = iDescription.Trim();
            line2 = "";
            line3 = "";
        }
        else   /*   description length is greater than 14   */
        {
            //if (g.iDescription.IndexOf(" ") != -1)
            //{
            //if (descriptionLength > 14)
            //{
            string a = iDescription.Substring(0, 14);

            if (a.LastIndexOf(",") != -1)
            {
                firstLastIndex = a.LastIndexOf(",");
                line1 = iDescription.Substring(0, firstLastIndex + 1);
            }
            else if (a.LastIndexOf(" ") != -1)
            {
                firstLastIndex = a.LastIndexOf(" ");
                line1 = iDescription.Substring(0, firstLastIndex);
            }
            else
            {
                line1 = iDescription.Substring(0, 14);
                firstLastIndex = 13;
            }
            //}

            if (iDescription.Substring(firstLastIndex + 1, descriptionLength - (firstLastIndex + 1)).Length > 14)
            {
                string b = iDescription.Substring(firstLastIndex + 1, 14);

                if (b.LastIndexOf(",") != -1)
                {
                    secondLastIndex = b.LastIndexOf(",");
                    line2 = iDescription.Substring(firstLastIndex + 1, secondLastIndex + 1);
                }
                else if (b.LastIndexOf(" ") != -1)
                {
                    secondLastIndex = b.LastIndexOf(" ");
                    line2 = iDescription.Substring(firstLastIndex + 1, secondLastIndex);
                }
                else if (b.ToUpper().LastIndexOf("X") != -1)
                {
                    secondLastIndex = b.ToUpper().LastIndexOf("X");
                    line2 = iDescription.Substring(firstLastIndex + 1, secondLastIndex);
                }
                else
                {
                    secondLastIndex = 13;
                    line2 = b;
                }

                if (line2.Substring(0, 1) == " ")
                {
                    line2 = line2.Trim();
                }
            }
            else
            {
                line2 = iDescription.Substring(firstLastIndex + 1, descriptionLength - (firstLastIndex + 1));
                secondLastIndex = -1;
            }

            if (secondLastIndex != -1)
            {
                line3 = iDescription.Substring(firstLastIndex + secondLastIndex + 2, descriptionLength -
                        (firstLastIndex + secondLastIndex + 2));

                if (line3.Substring(0, 1) == " ")
                {
                    line3 = line3.Trim();
                }
            }
            else
            {
                line3 = "";
            }

            if (line1.Length > 14 | line2.Length > 14 | line3.Length > 14)
            {
                line1 = iDescription.Substring(0, 14);

                if (descriptionLength > 28)
                {
                    line2 = iDescription.Substring(14, 14);
                }
                else  //( descriptionLength <= 28 )
                {
                    line2 = iDescription.Substring(14, descriptionLength - 14);
                }

                if (descriptionLength > 28)
                {
                    line3 = iDescription.Substring(28, descriptionLength - 28);
                }
            }

            if (line1.Length > 0)
            {
                line1 = line1.Replace("\"", "\\\"");
            }

            if (line2.Length > 0)
            {
                line2 = line2.Replace("\"", "\\\"");
            }

            if (line3.Length > 0)
            {
                line3 = line3.Replace("\"", "\\\"");
            }

        }


        if (printer.zpl == "True")
        {
            StringBuilder ZplBuilder = new StringBuilder();


            //Printing labels now...

            ZplBuilder.Clear();
            ZplBuilder.Append("^XA");
            //To print images with ZPL use Labelary.com


            ZplBuilder.Append("^FO10, 25 ^GFA, 578, 578, 17, 3KFE01FE3F1FE03FC, 7LF01FEFFDFE1IF, 7LF03LFE3IFC, 7LF03LFEJFE, 7LF83LFEKF, 7LF87RF, 007FF7F87IFC7JF1FF8, 00FFE3FC7IF83IFE0FF8, 01FFC3FC7IF83IFC07F8, 03FF83FCJF83IFC07F8, 03FF01FEFEFF83IFC07FC, 07FE01FEFEFF83IFC07F8, 0FFC00IFEFF83IFC07F8, 1FF800IFC7F83IFC07F8, 3FFI07FFC7LFE0FF8, 7JF87FFC7MF1FF, KF87FF83PF, KF83FF81JFEJFE, KF83FF80JFE7IFC, KF81FF007F3FE3IF8, 7JF81FFJ03FE0FFE, L01FEJ03FE01F, L01FE0FF83FE, K07FFE07FC7FC, K07FFC07JFC, K07FFC07JF8, K07FF803JF8, K07FF001IFE, K07FCI07FFC,,::gSF,:^FS");
            ZplBuilder.Append("^FO445,25^GFA,357,357,17,,001,003801FF807FCJFDJFEJFDFE1FC,003801FF80FFCJFDJFEJFDFE3F8,007C01FFC0FFCJFDJFEJFDFE7F,007E01FFC1FFCJFDJFEJFDFEFE,00FE01FFE1FFCJFDJFEJFDIFE,00FF01FFE3FFCFEJ03F80FE001IFC,00FF01IF3FFCJFC03F80JFDIF8,007F81IF7FFCJFC03F80JFDIF,007F81LFCJFC03F80JFDIF8,003FC1LFCJFC03F80JFDIF8,003FC1LFCJFC03F80JFDIFC,001FE1JFEFCFEJ03F80FE001IFE,0FEFF1FDFFCFCFEJ03F80FE001IFE,1FCFF1FDFFCFCJF803F80JF9FEFF,1FC7F9FCFFCFCJFC03F80JFDFE7F8,3F87F9FCFF8FCJFC03F80JFDFE7FC,3F83FDFC7F8FCJFC03F80JFDFE3FC,7F03FDFC7F0FCJFC03F80JFDFE3FE,7E01IFC3F0FC7IF803F007IF8FC1FE,^FS");

            ZplBuilder.Append("^CF,20");
            ZplBuilder.Append("^FO140, 25^FD21 Laurel Brook Rd^FS");
            ZplBuilder.Append("^FO140, 50^FDMiddlefield, CT 06455 USA^FS");
            ZplBuilder.Append("^FO10, 85^FDP/N:^FS");
            ZplBuilder.Append("^FO10, 150^FDSN:^FS");
            //Ensure bar code can fit on label
            //if (partNum.Length > 13)
            //{
            //    ZplBuilder.Append("^FO55, 70^BCN,35,Y,N,N^BY1^A0,30,30^FD" + pl + "^FS");//the ^BY command sets the size of the barcode
            //}
            //else
            //{
            //    ZplBuilder.Append("^FO55, 70^BCN,35,Y,N,N^BY2^A0,30,30^FD" + pl + "^FS");
            //}
            //if (serial.Length > 13)
            //{
            //    ZplBuilder.Append("^FO55, 140^BCN,35,Y,N,N^BY1^A0,30,30^FD" + serial + "^FS");
            //}
            //else if (serial == "")//case in which no serial is given
            //{

            //}
            //else
            //{
            //    ZplBuilder.Append("^FO55, 140^BCN,35,Y,N,N^BY2^A0,30,30^FD" + serial + "^FS");
            //}
            ZplBuilder.Append("^FO430, 80^FD" + line1 + "^FS");
            ZplBuilder.Append("^FO430, 100^FD" + line2 + "^FS");
            ZplBuilder.Append("^FO430, 120^FD" + line3 + "^FS");
            //ZplBuilder.Append("^FO430, 140^FDRev: " + rev + "^FS");
            //ZplBuilder.Append("^FO430, 165^FDQty: " + quantity + "^FS");
            //ZplBuilder.Append("^FO430, 190^FDPart: " + i + " of " + numBoxes + "^FS");
            ZplBuilder.Append("^XZ");

            string ZplString = ZplBuilder.ToString();
            //send data to printer
            MemoryStream lmemStream = new MemoryStream();

            StreamWriter lstreamWriter = new StreamWriter(lmemStream);
            lstreamWriter.Write(ZplString);
            lstreamWriter.Flush();
            lmemStream.Position = 0;

            byte[] byteArray = lmemStream.ToArray();

            IntPtr cpUnmanagedBytes = new IntPtr(0);
            int cnLength = byteArray.Length;
            cpUnmanagedBytes = Marshal.AllocCoTaskMem(cnLength);
            Marshal.Copy(byteArray, 0, cpUnmanagedBytes, cnLength);

            RawPrinterHelper.SendBytesToPrinter(printer.myPrinter, cpUnmanagedBytes, cnLength);
            Marshal.FreeCoTaskMem(cpUnmanagedBytes);
        }
        else
        {

                    Bitmap bzp = Properties.Resources.zygo_blk_noR_132;
                    Bitmap bxp = Properties.Resources.ametek_blk_noR_132;

                    /*
                     *  Add the image to the resources folder or elsewhere, then add the file to the
                     *  resourses.resx file and it will take in the file and reclassify it as an image.
                     *  It should then be available under properties.resources - the case does matter for
