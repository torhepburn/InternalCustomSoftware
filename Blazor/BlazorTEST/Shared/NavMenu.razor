<div class="top-row ps-3 navbar navbar-dark">
    <div class="container-fluid">
        <a class="navbar-brand" <img src="Images/NewZygoLogo.png" height="83" width="180" alt="Logo" /></a> 
        <button title="Navigation menu" class="navbar-toggler" @onclick="ToggleNavMenu">
            <span class="navbar-toggler-icon"></span>
        </button>
    </div>
</div>



<div class="@NavMenuCssClass" @onclick="ToggleNavMenu">
    <nav class="flex-column">
        @*These nav-items are all of the tabs on the left of the page. Copy and paste to add more. href should be page name defined at the top of each component. icon can be changed as well from oi oi*@
        <div class="nav-item px-2">
            <NavLink class="nav-link" href="home">
                <span class="oi oi-lightbulb" aria-hidden="true"></span> Shipping
            </NavLink>
        </div>
        <div class="nav-item px-2">
            <NavLink class="nav-link" href="packinglist">
                <span class="oi oi-project" aria-hidden="true"></span> Packing
            </NavLink>
        </div>
        <div class="nav-item px-2">
            <NavLink class="nav-link" href="calibrate">
                <span class="oi oi-aperture" aria-hidden="true"></span> Canon
            </NavLink>
        </div>
        <div class="nav-item px-2">
            <NavLink class="nav-link" href="calibrate">
                <span class="oi oi-menu" aria-hidden="true"></span> Bin
            </NavLink>
        </div>
        <div class="nav-item px-2">
            <NavLink class="nav-link" href="calibrate">
                <span class="oi oi-wrench" aria-hidden="true"></span> Repair
            </NavLink>
        </div>
        <div class="nav-item px-2">
            <NavLink class="nav-link" href="calibrate">
                <span class="oi oi-cog" aria-hidden="true"></span> Calibrate Menu
            </NavLink>
        </div>


    </nav>
</div>

@code {
    private bool collapseNavMenu = true;

    private string? NavMenuCssClass => collapseNavMenu ? "collapse" : null;

    private void ToggleNavMenu()
    {
        collapseNavMenu = !collapseNavMenu;
    }
}
