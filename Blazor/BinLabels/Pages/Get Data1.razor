@page "/"
@page "/getdata"

<PageTitle>Data in Grid</PageTitle>

@using BlazorTEST.Data
@using System.Data
@using Microsoft.Data.SqlClient;
@using C1.Blazor.Grid
@using LabelSpace.Data
@using ZPLPrinter.Data


<h1>Data Display</h1>

<p>This component demonstrates fetching data from a service.</p>
<div class="border">
    <EditForm Model="searchFilter" OnValidSubmit="getRecords">
        <DataAnnotationsValidator />
        <ValidationSummary />

        <label>Enter a keyword</label>
        <br />
        <InputText id="num" placeholder="Keyword" @bind-Value="searchFilter" />
        <br />
        <br />
        @*<button type="button" class="btn btn-primary btn-sm" @onclick="getRecords">Filter</button>*@
        <input type="submit" class="btn btn-primary btn-sm" OnValidSubmit="getRecords" title="Filter" value="Filter" />
        <button type="button" class="btn btn-primary" @onclick="printNow">Print</button>

        @if (dt != null && dt.Rows.Count > 0)
        {
            <table class="table">
                <thead>
                    <tr>
                        <th>Item Number</th>
                        <th>Description</th>
                        <th>Revision</th>
                    </tr>
                </thead>
                <tbody>
                    @if (dt != null)
                    {
                        @foreach (DataRow items in dt.Rows)
                        {
                            <tr>
                                <td><a href=@("/labeldetails/" + items[0] + ">" + items[1] + ">" + items[2])> @items[0].ToString()</a></td> @*hyperlink to print data in row*@
                                <td>@items[1].ToString()</td>
                                <td>@items[2].ToString()</td>
                            </tr>
                        }

                    }

                </tbody>
            </table>
        }
    </EditForm>
</div>











