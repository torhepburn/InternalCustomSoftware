@page "/counter"
@using Microsoft.AspNetCore.Components

<PageTitle>Counter</PageTitle>

<h1>Counter</h1>

<p role="status">Current count: @currentCount</p>

<button class="btn btn-primary" @onclick="IncrementCount">Click me</button>

<div class="container">
  <div class="row">
    <div class="col">
      Column
    </div>
    <div class="col">
      Column
    </div>
    <div class="col">
      Column
    </div>
  </div>
</div>

<table class="table">
  <thead>
    <tr class="bg-primary">
      <th scope="col">#</th>
      <th scope="col">First</th>
      <th scope="col">Last</th>
      <th scope="col">Handle</th>
    </tr>
  </thead>
  <tbody>
    <tr class="bg-success">
      <th scope="row">1</th>
      <td>Mark</td>
      <td>Otto</td>
      <td>@mdo</td>
    </tr>
    <tr class="bg-light">
      <th scope="row">2</th>
      <td>Jacob</td>
      <td>Thornton</td>
      <td>@fat</td>
    </tr>
    <tr>
      <th scope="row">3</th>
      <td colspan="2">Larry the Bird</td>
      <td>@twitter</td>
    </tr>
  </tbody>
</table>

<div style="text-align:center;">
<button class="btn btn-sm btn-danger" @onclick="IncrementCount">Click me</button>
</div>

<div class="card" style="width: 18rem;">
  <img src="..." class="card-img-top" alt="...">
  <div class="card-body">
    <h5 class="card-title">Card title</h5>
    <p class="card-text">Some quick example text to build on the card title and make up the bulk of the card's content.</p>
    <a href="http://ct-mid-sql11/reports/browse" class="btn btn-primary">Go somewhere</a>
    <br /><br /><br />
    <div class="container justify-content-center bg-white">
        <div class="row">
            <div class="form-group row">

                <div class="col text-muted text-left">
                    Name

                </div>
                <input class="form-control form-control-sm" @bind-value=@twitter>
                <br />
                <input type="datetime" class="form-control form-control-sm" @bind-value=@dtnow />
                <br />
                <button class="btn btn-primary" @onclick="Confirm">Click me</button>

                

            </div>
        </div>

    </div>

  </div>
</div>

@code {

    private string fat = "THIN";
    public string mdo = "method";
    public int twitter = 6;
    public DateTime dtnow = DateTime.Now;

    private int currentCount = 0;

    private void IncrementCount()
    {
        currentCount++;
    }

    private void Confirm()
    {
        //currentCount++;


    }
}
