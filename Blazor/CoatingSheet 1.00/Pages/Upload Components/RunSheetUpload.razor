@page "/"
<h4>Upload Run Sheet</h4>

@if (showTables)
{
    <Table @key=dt dt="dt" TableStyle="generic-table"></Table>
    <br>
    <br />
    if(dtProcess.Rows.Count > 0)
    {
        <Table @key=dtProcess dt="dtProcess" TableStyle="generic-table"></Table>
    }

}
else
{
    <label>Select a run sheet file and a table will show with its data. If the data is correct upload to the database</label>
    <br />
    <br />
}

@*ERROR MESSAGE POPUP*@
<div class="popup-overlay @(pop.IsVisible ? "visible" : "")">
    <div class="popup-content">
        <h3>@pop.Title</h3>
        <p>@pop.Message</p>
        <button class="button-85" @onclick="pop.ClosePopup">Close</button>
    </div>
</div>

<div class="popup-overlay @(popInput.IsVisible ? "visible" : "")">
    <div class="popup-content">
        <h3>@popInput.Title</h3>
        <p>@popInput.Message</p>
        <input type="text" @bind="WO" />
        <button @onclick="GetPartData">Enter Data</button>
        <button @onclick="popInput.ClosePopup">Cancel</button>
    </div>
</div>

<div class="popup-overlay @(popCustomer.IsVisible ? "visible" : "")">
    <div class="popup-content">
        <h3>@popCustomer.Title</h3>
        <p>@popCustomer.Message</p>
        <input type="text" @bind="Customer" />
        <button @onclick="EnterCustomer">Enter Data</button>
        <button @onclick="popCustomer.ClosePopup">Cancel</button>
    </div>
</div>


