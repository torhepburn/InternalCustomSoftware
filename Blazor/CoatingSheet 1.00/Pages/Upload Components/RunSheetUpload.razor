                    //    }
                    //}
                    cnxn.Close();
                    pop.Title = "Success";
                    pop.Message = "Run # " + row[2].ToString() + " was added to SQL database";
                    pop.ShowPopup();



                }catch (Exception ex)
                {
                    if (ex.ToString().Contains("Violation of PRIMARY KEY"))
                    {
                        pop.Title = "Error";
                        pop.Message = "Run # " + row[2].ToString() + " is already in database";
                    }
