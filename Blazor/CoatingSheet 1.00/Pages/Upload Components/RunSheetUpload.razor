                    cmd.Parameters.Add(new SqlParameter("@Material3", row[24].ToString()));
                    cmd.Parameters.Add(new SqlParameter("@Material3Rate", row[25].ToString()));
                    cmd.Parameters.Add(new SqlParameter("@Material4", row[26].ToString()));
                    cmd.Parameters.Add(new SqlParameter("@Material4Rate", row[27].ToString()));
                    SqlParameter pID = new SqlParameter("@ID", SqlDbType.Int);
                    pID.Direction = ParameterDirection.Output;
                    cmd.Parameters.Add(pID);
                }
                catch
                {
                    pop.Title = "Error";
                    pop.Message = "Something went wrong";
                    pop.ShowPopup();
                    return;
                }


                try
                {
                    cnxn.Open();
                    cmd.ExecuteNonQuery();

                    //SqlCommand GetIDcmd = new SqlCommand(@"SELECT TOP (1) [ID] FROM CoatingSheet ORDER By [ID] DESC", cnxn);
                    //using (SqlDataReader dr = GetIDcmd.ExecuteReader())
                    //{
