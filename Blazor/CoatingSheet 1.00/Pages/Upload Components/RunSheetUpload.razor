    //Run sheets use xlsx files so the process for reading them is different
    //than the spectral csv files. Using a different library than GenericParser
    //This is using NPOI
    private async Task OnFileSelected(InputFileChangeEventArgs e)
    {
        showTables = false;
        StateHasChanged();
        dt = new DataTable();
        dtProcess = new DataTable();
        try
        {
            var fileStream = e.File.OpenReadStream();
            var ms = new MemoryStream();
            await fileStream.CopyToAsync(ms);
            fileStream.Close();
            ms.Position = 0;

            ISheet sheet;
            var xsswb = new XSSFWorkbook(ms);

            sheet = xsswb.GetSheetAt(0);

            var rl = new List<string>();

            IRow rr = sheet.GetRow(2);

            ICell runType = rr.GetCell(34);

            if (runType.ToString().Trim().ToUpper() == "PRODUCTION")
            {
                popInput.Title = "Production";
                popInput.Message = "Enter Work Order Number";
                popInput.ShowPopup();
                //return;

            }


            for (var i = 2; i <= 20; i += 3)
            {
                IRow hr = sheet.GetRow(i);
                int cc = hr.LastCellNum;
                for (var j = 0; j < cc; j += 4)
                {

                    ICell cell = hr.GetCell(j);
                    dt.Columns.Add(cell.ToString());
                }
            }
            DataRow newRow = dt.NewRow();
            int colNum = 0;
            for (var i = 2; i <= 20; i += 3)
            {

                IRow r = sheet.GetRow(i);
                int cc = r.LastCellNum;

                for (var j = 2; j < cc; j += 4)
                {
                    ICell cell = r.GetCell(j);
                    if (cell.CellType == CellType.Numeric && DateUtil.IsCellDateFormatted(cell))
                    {
                        if (colNum == 4)
                        {
                            newRow[colNum] = cell.DateCellValue.Date.ToShortDateString();
                        }
                        else
                        {
                            newRow[colNum] = cell.DateCellValue.TimeOfDay.ToString();
                        }
                    }
                    else
                    {
                        newRow[colNum] = cell.ToString();
                    }

                    colNum++;
                }
            }
            dt.Rows.Add(newRow);
        }
        catch(Exception ex)
        {
            pop.Title = "Error";
            pop.Message = "Something went wrong";
            pop.ShowPopup();
            return;
        }



        showTables = true;
        StateHasChanged();
        StateHasChanged();

    }

