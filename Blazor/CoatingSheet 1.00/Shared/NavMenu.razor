@inject NavigationManager Nav
@inject IJSRuntime JSRuntime
@using Pages




<div class="popup-overlay @(pop.IsVisible ? "visible" : "")">
    <div class="popup-content">
        <h3>@pop.Title</h3>
        <p>@pop.Message</p>
        <button class="button-85" @onclick="pop.ClosePopup">Close</button>
    </div>
</div>

<div class="popup-overlay @(searchPop.IsVisible ? "visible" : "")">
    
    <div class="popup-content" style="width:95vw">
        <button class="" style="position:relative;left:94%;color:red" @onclick="searchPop.ClosePopup">X</button>
        <Search></Search>
    </div>
</div>


@if (isLoading)
{
    <section class="overlay-container">
        <div class="loading-spinner">
            <div class="ring" style="position:fixed;top:50%;left:50%;transform:translate(-50%, -50%)"></div>
        </div>
    </section>
}

    <nav style="display:flex;">
    <h3 style="padding-top:10px">coating</h3><h3 style="color:red; margin-right:50px;padding-top:10px">sheet</h3>
        <div class="nav-item">
            <button class="nav-item" @onclick="OpenSearch">
                <div class="oi oi-magnifying-glass" aria-hidden="true"></div> Search
            </button>
        </div>
        <div class="nav-item">
            <button class="nav-item" @onclick="HomeNav">
                <div class="oi oi-plus" aria-hidden="true"></div> Add Run Sheet
            </button>
        </div>
    
    <div class="nav-item px-3" style="cursor:pointer">
        <div class="dropdown">
            <div>
                <button style="cursor:auto" class="nav-item">
                    <div class="oi oi-data-transfer-upload"></div> Upload Spectral Data
                </button>
            </div>

            <div class="dropdown-content">
                <div class="nav-item">
                    <button class="nav-item" @onclick="TypeA">
                        <div aria-hidden="true"></div> Cary 7000
                    </button>
                </div>
                <div class="nav-item">
                    <button class="nav-item" @onclick="TypeB">
                        <div aria-hidden="true"></div> PE983
                    </button>
                </div>
                <div class="nav-item">
                    <button class="nav-item" @onclick="TypeC">
                        <div aria-hidden="true"></div> FTIR
                    </button>
                </div>
            </div>
        </div>
    </div>


        <img style="background-color:transparent;" src="Images/zygoLogo.png">
        @*<label style="font-size:10px;position:fixed;bottom:1%;right:1%">Version 1.05 07-27-23</label>*@
    </nav>

@code {
    public PopUp pop = new PopUp();
    public PopUp searchPop = new PopUp();


    private bool isLoading = false;
    private bool showAddShortage = false;

    private async void HomeNav()
    {
        Nav.NavigateTo("");
    }
    private async void TypeA()
    {
        Nav.NavigateTo("Cary7000");
    }
    private async void TypeB()
    {
        Nav.NavigateTo("PE983");
    }
    private async void TypeC()
    {
        Nav.NavigateTo("FTIR");
    }
    private void OpenSearch()
    {
        searchPop.ShowPopup();
    }

}
