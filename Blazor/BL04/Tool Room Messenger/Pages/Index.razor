@page "/"

<PageTitle>Tool Room Messanger</PageTitle>

@using Tool_Room_Messenger.Data
@using System.Data
@using Microsoft.Data.SqlClient

@inject Global g
@inject NavigationManager NavMgr

<h1>Richmond Tool Requests</h1>

Select the Request you need to access.

<table class="table">
        <thead>
            <tr>
                <th>Request Number</th>
                <th>Company</th>
                <th>Projecct</th>
                <th>Part</th>
            </tr>
        </thead>
        <tbody>
        @foreach (DataRow r in dt.Rows)
        {
                    <tr @onclick="() => Select(r[0].ToString())">
                        <td>@r[0].ToString()</td>
                        <td>@r[1].ToString()</td>
                        <td>@r[2].ToString()</td>
                        <td>@r[3].ToString()</td>
                    </tr>
        }
        </tbody>
    </table>

