@code
{
    SqlCommand cmd;
    SqlConnection cnxn = new SqlConnection("server=CT-MID-SQL11; user=readWrite; password=Read+Write!;" +
                           "database=AccessFrontEnds; encrypt=false;");

    public string comment = "";
    public string emailFrom = "";
    public string requestID = "";

    //private WeatherForecast[]? forecasts;

    //protected override async Task OnInitializedAsync()
    //{
    //    //forecasts = await ForecastService.GetForecastAsync(DateTime.Now);
    //}

    public void DataEntry()
    {
        //testInput = "TO";

        cmd = new("Insert into RIC.TOOL_Comments (RequestID,Comment,EnteredBy) values ( " +
            "'" + requestID + "'" +
            ",'" + comment + "'" +
            ",'" + emailFrom + "'" +
            ")", cnxn);

        try
        {
            cnxn.Open();
            cmd.ExecuteNonQuery();


        }
        catch (SqlException ex)
        {
            ex.ToString();
        }
        finally
        {
            cnxn.Close();

        }
    }
}
