@page "/addcomment"

<PageTitle>Add Comment</PageTitle>

@using Tool_Room_Messenger.Data

@using System.Data
@using Microsoft.Data.SqlClient
@inject Global g


<h1>Add Comment</h1>

@*<p>This component demonstrates fetching data from a service.</p>*@

@*<button class="btn btn-primary" @onclick="DataEntry">Click me</button>*@


<EditForm Model="comment" OnValidSubmit="DataEntry">
    <DataAnnotationsValidator />
    <ValidationSummary />>

    <InputText id="n1" placeholder="Comment" @bind-Value="comment" />
    <InputText id="n2" placeholder="Email To" @bind-Value="emailFrom" />
    <InputText id="n3" placeholder="Request ID" @bind-Value="requestID" />

    @*<input class="format-control" value="@comment" />*@

    


    @*<input type="submit" class="btn btn-sm" title="test" value="TEST" />*@

</EditForm>
<br />
<button class="btn btn-primary" @onclick="DataEntry">Save Data</button>


