<?xml version="1.0" encoding="utf-8"?>
<Report xmlns="http://schemas.microsoft.com/sqlserver/reporting/2005/01/reportdefinition" xmlns:rd="http://schemas.microsoft.com/SQLServer/reporting/reportdesigner">
  <DataSources>
    <DataSource Name="MaintainApprovalHistory">
      <rd:DataSourceID>4f62a2a0-26ba-4f86-b48d-48a65d7d96a2</rd:DataSourceID>
      <DataSourceReference>MaintainApprovalHistory</DataSourceReference>
    </DataSource>
  </DataSources>
  <InteractiveHeight>11in</InteractiveHeight>
  <rd:DrawGrid>true</rd:DrawGrid>
  <InteractiveWidth>8.5in</InteractiveWidth>
  <rd:SnapToGrid>true</rd:SnapToGrid>
  <RightMargin>1in</RightMargin>
  <LeftMargin>1in</LeftMargin>
  <BottomMargin>1in</BottomMargin>
  <rd:ReportID>425013e1-eb54-4eb2-829d-da843e72a06c</rd:ReportID>
  <DataSets>
    <DataSet Name="DataSet1">
      <Fields>
        <Field Name="Expr1">
          <DataField>Expr1</DataField>
          <rd:TypeName>System.DateTime</rd:TypeName>
        </Field>
        <Field Name="Spplr_Commodity">
          <DataField>Spplr_Commodity</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="OrderNum">
          <DataField>OrderNum</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="RcvdQty">
          <DataField>RcvdQty</DataField>
          <rd:TypeName>System.Double</rd:TypeName>
        </Field>
        <Field Name="DaysFromRecToQC">
          <DataField>DaysFromRecToQC</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
        <Field Name="ReceivedDate">
          <DataField>ReceivedDate</DataField>
          <rd:TypeName>System.DateTime</rd:TypeName>
        </Field>
        <Field Name="MovedToDate">
          <DataField>MovedToDate</DataField>
          <rd:TypeName>System.DateTime</rd:TypeName>
        </Field>
        <Field Name="Howlong">
          <DataField>Howlong</DataField>
          <rd:TypeName>System.Int16</rd:TypeName>
        </Field>
      </Fields>
      <Query>
        <DataSourceName>MaintainApprovalHistory</DataSourceName>
        <CommandText>SELECT tblTrackerLinkApproval_200.DateApprvd AS Expr1, tblTrackerLinkApproval_200.Spplr_Commodity, tblTrackerLinkApproval_200.OrderNum, 
                  tblTrackerLinkApproval_200.RcvdQty, tblTimeFromRecToQC_200.DaysFromRecToQC, tblTimeFromRecToQC_200.ReceivedDate, tblTimeFromRecToQC_200.MovedToDate, 
                  cint(Datediff('d', tblTrackerLinkApproval_200.RcvdDate, NOW())) AS Howlong
FROM     tblTrackerLinkApproval_200, tblTimeFromRecToQC_200
WHERE  tblTrackerLinkApproval_200.MKReceiptTransactionID = tblTimeFromRecToQC_200.MKReceiptTransactionID
ORDER BY tblTimeFromRecToQC_200.ReceivedDate</CommandText>
      </Query>
    </DataSet>
  </DataSets>
  <Width>6.5in</Width>
  <Body>
    <ReportItems>
      <Chart Name="chart1">
        <Legend>
          <Style>
            <BorderStyle>
              <Default>Solid</Default>
            </BorderStyle>
          </Style>
          <Position>BottomCenter</Position>
        </Legend>
        <CategoryAxis>
          <Axis>
            <Title>
              <Caption>Date Moved(Inspection Completed)</Caption>
            </Title>
            <Style />
            <MajorGridLines>
              <Style>
                <BorderStyle>
                  <Default>Solid</Default>
                </BorderStyle>
              </Style>
            </MajorGridLines>
            <MinorGridLines>
              <Style>
                <BorderStyle>
                  <Default>Solid</Default>
                </BorderStyle>
              </Style>
            </MinorGridLines>
            <MajorTickMarks>Outside</MajorTickMarks>
            <Min>0</Min>
            <Visible>true</Visible>
          </Axis>
        </CategoryAxis>
        <DataSetName>DataSet1</DataSetName>
        <PlotArea>
          <Style>
            <BackgroundColor>LightGrey</BackgroundColor>
            <BorderStyle>
              <Default>Solid</Default>
            </BorderStyle>
          </Style>
        </PlotArea>
        <ThreeDProperties>
          <Rotation>30</Rotation>
          <Inclination>30</Inclination>
          <Shading>Simple</Shading>
          <WallThickness>50</WallThickness>
        </ThreeDProperties>
        <PointWidth>0</PointWidth>
        <Filters>
          <Filter>
            <FilterExpression>=cint(year(Fields!ReceivedDate.Value))</FilterExpression>
            <Operator>Equal</Operator>
            <FilterValues>
              <FilterValue>2012</FilterValue>
            </FilterValues>
          </Filter>
        </Filters>
        <SeriesGroupings>
          <SeriesGrouping>
            <StaticSeries>
              <StaticMember>
                <Label>Average Days</Label>
              </StaticMember>
            </StaticSeries>
          </SeriesGrouping>
        </SeriesGroupings>
        <Top>0.125in</Top>
        <Subtype>Plain</Subtype>
        <ValueAxis>
          <Axis>
            <Title>
              <Caption>Average Days</Caption>
            </Title>
            <MajorGridLines>
              <ShowGridLines>true</ShowGridLines>
              <Style>
                <BorderStyle>
                  <Default>Solid</Default>
                </BorderStyle>
              </Style>
            </MajorGridLines>
            <MinorGridLines>
              <Style>
                <BorderStyle>
                  <Default>Solid</Default>
                </BorderStyle>
              </Style>
            </MinorGridLines>
            <MajorTickMarks>Outside</MajorTickMarks>
            <Min>0</Min>
            <Margin>true</Margin>
            <Visible>true</Visible>
            <Scalar>true</Scalar>
          </Axis>
        </ValueAxis>
        <Type>Column</Type>
        <Width>6.25in</Width>
        <CategoryGroupings>
          <CategoryGrouping>
            <DynamicCategories>
              <Grouping Name="chart1_year">
                <GroupExpressions>
                  <GroupExpression>=year(Fields!TransactionDate.Value)</GroupExpression>
                </GroupExpressions>
              </Grouping>
              <Sorting>
                <SortBy>
                  <SortExpression>=year(Fields!TransactionDate.Value)</SortExpression>
                  <Direction>Ascending</Direction>
                </SortBy>
              </Sorting>
              <Label>=year(Fields!TransactionDate.Value)</Label>
            </DynamicCategories>
          </CategoryGrouping>
          <CategoryGrouping>
            <DynamicCategories>
              <Grouping Name="chart1_Month">
                <GroupExpressions>
                  <GroupExpression>=month(Fields!TransactionDate.Value)</GroupExpression>
                </GroupExpressions>
              </Grouping>
              <Sorting>
                <SortBy>
                  <SortExpression>=month(Fields!TransactionDate.Value)</SortExpression>
                  <Direction>Ascending</Direction>
                </SortBy>
              </Sorting>
              <Label>=MonthName(month(Fields!TransactionDate.Value))</Label>
            </DynamicCategories>
          </CategoryGrouping>
        </CategoryGroupings>
        <Palette>Default</Palette>
        <ChartData>
          <ChartSeries>
            <DataPoints>
              <DataPoint>
                <DataValues>
                  <DataValue>
                    <Value>=Avg(Fields!DaysFromRecToApproval.Value)</Value>
                  </DataValue>
                </DataValues>
                <DataLabel />
                <Marker>
                  <Size>6pt</Size>
                </Marker>
              </DataPoint>
            </DataPoints>
          </ChartSeries>
        </ChartData>
        <Style>
          <BackgroundColor>White</BackgroundColor>
        </Style>
        <Title>
          <Caption>Number of Workdays Parts Spend in QC at Middlefield</Caption>
        </Title>
        <Height>4in</Height>
        <Left>0.125in</Left>
      </Chart>
    </ReportItems>
    <Height>4.25in</Height>
  </Body>
  <Language>en-US</Language>
  <TopMargin>1in</TopMargin>
</Report>