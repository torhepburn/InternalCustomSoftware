<?xml version="1.0" encoding="utf-8"?>
<Report xmlns="http://schemas.microsoft.com/sqlserver/reporting/2005/01/reportdefinition" xmlns:rd="http://schemas.microsoft.com/SQLServer/reporting/reportdesigner">
  <DataSources>
    <DataSource Name="FAST_Analysis.mdb">
      <rd:DataSourceID>1ccc8452-9861-43d1-ad5d-31aed89960ce</rd:DataSourceID>
      <DataSourceReference>FAST_Analysis.mdb</DataSourceReference>
    </DataSource>
  </DataSources>
  <InteractiveHeight>11in</InteractiveHeight>
  <rd:DrawGrid>true</rd:DrawGrid>
  <InteractiveWidth>8.5in</InteractiveWidth>
  <rd:SnapToGrid>true</rd:SnapToGrid>
  <RightMargin>1in</RightMargin>
  <LeftMargin>1in</LeftMargin>
  <BottomMargin>1in</BottomMargin>
  <rd:ReportID>2507c98b-6db4-43ba-91c9-7f92f92fd645</rd:ReportID>
  <DataSets>
    <DataSet Name="FAST_Analysis_mdb">
      <Fields>
        <Field Name="FASTDEFECTBDESC">
          <DataField>FASTDEFECTBDESC</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="TotalQuantity">
          <DataField>TotalQuantity</DataField>
          <rd:TypeName>System.Double</rd:TypeName>
        </Field>
        <Field Name="FASTDEFECTADESC">
          <DataField>FASTDEFECTADESC</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="F_ID">
          <DataField>F_ID</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
      </Fields>
      <Query>
        <DataSourceName>FAST_Analysis.mdb</DataSourceName>
        <CommandText>SELECT FASTDEFECTBDESC, TotalQuantity, FASTDEFECTADESC, MAX(FASTDEFECTBDESC) AS F_ID
FROM (SELECT FASTDEFECTBDESC, SUM(Qty) AS TotalQuantity, FASTDEFECTADESC, Qty
        FROM  (SELECT FASTDEFECTADESC, FASTDEFECTBDESC, DateCreated, Qty
                 FROM  dbo_VIEW_FAST_Escape_Query_IQC)
        WHERE (DateCreated &lt; NOW()) AND (DateCreated &gt; NOW() - 183)
        GROUP BY FASTDEFECTBDESC, FASTDEFECTADESC, Qty) derivedtbl_1
GROUP BY FASTDEFECTBDESC, TotalQuantity, FASTDEFECTADESC
HAVING (TotalQuantity &gt;= 1) AND (FASTDEFECTBDESC &lt;&gt; 'Performance') AND (FASTDEFECTBDESC &lt;&gt; 'Functional Failure') AND (FASTDEFECTBDESC &lt;&gt; 'Failed Component') AND (FASTDEFECTBDESC &lt;&gt; 'Performance/Function')
ORDER BY TotalQuantity DESC, FASTDEFECTADESC</CommandText>
        <rd:UseGenericDesigner>true</rd:UseGenericDesigner>
      </Query>
    </DataSet>
  </DataSets>
  <Width>8.625in</Width>
  <Body>
    <ReportItems>
      <Chart Name="chart1">
        <Legend>
          <Visible>true</Visible>
          <Style>
            <BorderStyle>
              <Default>Solid</Default>
            </BorderStyle>
          </Style>
          <Position>BottomCenter</Position>
        </Legend>
        <CategoryAxis>
          <Axis>
            <Title>
              <Caption>Reason for Escape</Caption>
            </Title>
            <MajorGridLines>
              <Style>
                <BorderStyle>
                  <Default>Solid</Default>
                </BorderStyle>
              </Style>
            </MajorGridLines>
            <MinorGridLines>
              <Style>
                <BorderStyle>
                  <Default>Solid</Default>
                </BorderStyle>
              </Style>
            </MinorGridLines>
            <MajorTickMarks>Outside</MajorTickMarks>
            <Min>0</Min>
            <Visible>true</Visible>
          </Axis>
        </CategoryAxis>
        <DataSetName>FAST_Analysis_mdb</DataSetName>
        <PlotArea>
          <Style>
            <BackgroundColor>LightGrey</BackgroundColor>
            <BorderStyle>
              <Default>Solid</Default>
            </BorderStyle>
          </Style>
        </PlotArea>
        <ThreeDProperties>
          <Rotation>30</Rotation>
          <Inclination>30</Inclination>
          <Shading>Simple</Shading>
          <WallThickness>50</WallThickness>
        </ThreeDProperties>
        <PointWidth>0</PointWidth>
        <SeriesGroupings>
          <SeriesGrouping>
            <DynamicSeries>
              <Grouping Name="chart1_SeriesGroup1">
                <GroupExpressions>
                  <GroupExpression>=Fields!FASTDEFECTADESC.Value</GroupExpression>
                </GroupExpressions>
                <Parent>=Fields!TotalQuantity.Value</Parent>
              </Grouping>
              <Sorting>
                <SortBy>
                  <SortExpression>=Fields!FASTDEFECTADESC.Value</SortExpression>
                  <Direction>Descending</Direction>
                </SortBy>
              </Sorting>
              <Label>=Fields!FASTDEFECTADESC.Value</Label>
            </DynamicSeries>
          </SeriesGrouping>
          <SeriesGrouping>
            <StaticSeries>
              <StaticMember>
                <Label>Sum Rejected</Label>
              </StaticMember>
            </StaticSeries>
          </SeriesGrouping>
        </SeriesGroupings>
        <Top>0.125in</Top>
        <Subtype>Stacked</Subtype>
        <ValueAxis>
          <Axis>
            <Title>
              <Caption>Occurance</Caption>
            </Title>
            <MajorGridLines>
              <ShowGridLines>true</ShowGridLines>
              <Style>
                <BorderStyle>
                  <Default>Solid</Default>
                </BorderStyle>
              </Style>
            </MajorGridLines>
            <MinorGridLines>
              <Style>
                <BorderStyle>
                  <Default>Solid</Default>
                </BorderStyle>
              </Style>
            </MinorGridLines>
            <MajorTickMarks>Outside</MajorTickMarks>
            <Min>0</Min>
            <Margin>true</Margin>
            <Visible>true</Visible>
            <Scalar>true</Scalar>
          </Axis>
        </ValueAxis>
        <Type>Column</Type>
        <Width>8in</Width>
        <CategoryGroupings>
          <CategoryGrouping>
            <DynamicCategories>
              <Grouping Name="DefectType">
                <GroupExpressions>
                  <GroupExpression>=Fields!FASTDEFECTBDESC.Value</GroupExpression>
                </GroupExpressions>
                <Parent>=Fields!FASTDEFECTADESC.Value</Parent>
              </Grouping>
              <Sorting>
                <SortBy>
                  <SortExpression>=Sum(Fields!TotalQuantity.Value)</SortExpression>
                  <Direction>Descending</Direction>
                </SortBy>
              </Sorting>
              <Label>=Fields!FASTDEFECTBDESC.Value</Label>
            </DynamicCategories>
          </CategoryGrouping>
        </CategoryGroupings>
        <Palette>Default</Palette>
        <ChartData>
          <ChartSeries>
            <DataPoints>
              <DataPoint>
                <DataValues>
                  <DataValue>
                    <Value>=Sum(Fields!TotalQuantity.Value)</Value>
                  </DataValue>
                </DataValues>
                <DataLabel />
                <Marker>
                  <Size>6pt</Size>
                </Marker>
              </DataPoint>
            </DataPoints>
          </ChartSeries>
        </ChartData>
        <Style>
          <BackgroundColor>White</BackgroundColor>
        </Style>
        <Title>
          <Caption>Quality Escapes By Defect For Trailing 6 Months</Caption>
        </Title>
        <Height>6.375in</Height>
        <Left>0.25in</Left>
      </Chart>
    </ReportItems>
    <Height>7in</Height>
  </Body>
  <Language>en-US</Language>
  <TopMargin>1in</TopMargin>
</Report>