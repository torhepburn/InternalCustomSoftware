  <rd:ReportID>8ef1bc84-0f50-4095-9406-79e87ab5bf2d</rd:ReportID>
  <DataSets>
    <DataSet Name="BackLogData">
      <Fields>
        <Field Name="Month">
          <DataField>Month</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
        <Field Name="Order_no">
          <DataField>Order_no</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="QualityInspectorAssigned">
          <DataField>QualityInspectorAssigned</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="PartNumber">
          <DataField>PartNumber</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="ReceiptNumber">
          <DataField>ReceiptNumber</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="ApprovedDate">
          <DataField>ApprovedDate</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="DaysToClose">
          <DataField>DaysToClose</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
      </Fields>
      <Query>
        <DataSourceName>Dashboard</DataSourceName>
        <CommandText>SELECT MONTH(ApprovedDate) AS [Month], Order_no, QualityInspectorAssigned, PartNumber, ReceiptNumber, ApprovedDate, DaysToClose
FROM dbo.Tracker_ExcelDump
WHERE (DaysToClose &gt; 14) AND (ReceiptNumber &gt; 700000) AND (YEAR(ApprovedDate) &gt; 2009) AND (MONTH(ApprovedDate) = MONTH( GetDate()-28))
ORDER BY Month</CommandText>
        <rd:UseGenericDesigner>true</rd:UseGenericDesigner>
      </Query>
    </DataSet>
  </DataSets>
  <Width>29in</Width>
