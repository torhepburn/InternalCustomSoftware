<?xml version="1.0" encoding="utf-8"?>
<Report xmlns="http://schemas.microsoft.com/sqlserver/reporting/2005/01/reportdefinition" xmlns:rd="http://schemas.microsoft.com/SQLServer/reporting/reportdesigner">
  <DataSources>
    <DataSource Name="FAST_Analysis.mdb">
      <rd:DataSourceID>c4763fb5-9a05-433b-b3e5-ab5b5b6bf56b</rd:DataSourceID>
      <DataSourceReference>FAST_Analysis.mdb</DataSourceReference>
    </DataSource>
  </DataSources>
  <InteractiveHeight>11in</InteractiveHeight>
  <rd:DrawGrid>true</rd:DrawGrid>
  <InteractiveWidth>8.5in</InteractiveWidth>
  <rd:SnapToGrid>true</rd:SnapToGrid>
  <RightMargin>1in</RightMargin>
  <LeftMargin>1in</LeftMargin>
  <BottomMargin>1in</BottomMargin>
  <rd:ReportID>4fbe06f8-bbb3-4074-bc7e-99645d5c83cd</rd:ReportID>
  <DataSets>
    <DataSet Name="FAST_Analysis_mdb">
      <Fields>
        <Field Name="DESCRIPTION">
          <DataField>DESCRIPTION</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="TotalPartValue">
          <DataField>TotalPartValue</DataField>
          <rd:TypeName>System.Double</rd:TypeName>
        </Field>
        <Field Name="FastOrigin">
          <DataField>FastOrigin</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
      </Fields>
      <Query>
        <DataSourceName>FAST_Analysis.mdb</DataSourceName>
        <CommandText>SELECT *
FROM 
(SELECT DESCRIPTION,  SUM(Value) AS TotalPartValue, FastOrigin
FROM (SELECT DateCreated, DESCRIPTION, Value, FastOrigin FROM FAST_MRB_VALUE_Query )
WHERE (Month(DateCreated) = Month(now()-28) ) AND (Year(DateCreated) = 2011 OR Year(DateCreated)=2010)
GROUP BY DESCRIPTION, FastOrigin ) 
WHERE TotalPartValue &gt; 2000
ORDER BY TotalPartValue, FastOrigin</CommandText>
        <rd:UseGenericDesigner>true</rd:UseGenericDesigner>
      </Query>
    </DataSet>
  </DataSets>
  <Width>8.55in</Width>
  <Body>
    <ReportItems>
      <Chart Name="chart1">
        <Legend>
          <Style>
            <BorderStyle>
              <Default>Solid</Default>
            </BorderStyle>
          </Style>
          <Position>RightCenter</Position>
        </Legend>
        <CategoryAxis>
          <Axis>
            <Title />
            <MajorGridLines>
              <Style>
                <BorderStyle>
                  <Default>Solid</Default>
                </BorderStyle>
              </Style>
            </MajorGridLines>
            <MinorGridLines>
              <Style>
                <BorderStyle>
                  <Default>Solid</Default>
                </BorderStyle>
              </Style>
            </MinorGridLines>
            <MajorTickMarks>Outside</MajorTickMarks>
            <Min>0</Min>
            <Max>10</Max>
            <Visible>true</Visible>
          </Axis>
        </CategoryAxis>
        <DataSetName>FAST_Analysis_mdb</DataSetName>
        <PlotArea>
          <Style>
            <BackgroundColor>SeaShell</BackgroundColor>
            <BorderStyle>
              <Default>Solid</Default>
            </BorderStyle>
          </Style>
        </PlotArea>
        <ThreeDProperties>
          <Rotation>30</Rotation>
          <Inclination>30</Inclination>
          <Shading>Simple</Shading>
          <WallThickness>50</WallThickness>
        </ThreeDProperties>
        <PointWidth>0</PointWidth>
        <SeriesGroupings>
          <SeriesGrouping>
            <DynamicSeries>
              <Grouping Name="chart1_SeriesGroup1">
                <GroupExpressions>
                  <GroupExpression>=Fields!FastOrigin.Value</GroupExpression>
                </GroupExpressions>
              </Grouping>
              <Label>=Fields!FastOrigin.Value</Label>
            </DynamicSeries>
          </SeriesGrouping>
        </SeriesGroupings>
        <Top>0.125in</Top>
        <Subtype>Stacked</Subtype>
        <ValueAxis>
          <Axis>
            <Title>
              <Caption>$ Value($)</Caption>
            </Title>
            <MajorGridLines>
              <ShowGridLines>true</ShowGridLines>
              <Style>
                <BorderStyle>
                  <Default>Solid</Default>
                </BorderStyle>
              </Style>
            </MajorGridLines>
            <MinorGridLines>
              <Style>
                <BorderStyle>
                  <Default>Solid</Default>
                </BorderStyle>
              </Style>
            </MinorGridLines>
            <MajorTickMarks>Outside</MajorTickMarks>
            <Min>0</Min>
            <Margin>true</Margin>
            <Visible>true</Visible>
            <Scalar>true</Scalar>
          </Axis>
        </ValueAxis>
        <Type>Column</Type>
        <Width>8.25in</Width>
        <CategoryGroupings>
          <CategoryGrouping>
            <DynamicCategories>
              <Grouping Name="chart1_CategoryGroup1">
                <GroupExpressions>
                  <GroupExpression>=Fields!DESCRIPTION.Value</GroupExpression>
                </GroupExpressions>
              </Grouping>
              <Sorting>
                <SortBy>
                  <SortExpression>=Fields!TotalPartValue.Value</SortExpression>
                  <Direction>Descending</Direction>
                </SortBy>
              </Sorting>
              <Label>=Fields!DESCRIPTION.Value</Label>
            </DynamicCategories>
          </CategoryGrouping>
        </CategoryGroupings>
        <Palette>Pastel</Palette>
        <ChartData>
          <ChartSeries>
            <DataPoints>
              <DataPoint>
                <DataValues>
                  <DataValue>
                    <Value>=Sum(Fields!TotalPartValue.Value)</Value>
                  </DataValue>
                </DataValues>
                <DataLabel />
                <Marker>
                  <Size>6pt</Size>
                </Marker>
              </DataPoint>
            </DataPoints>
          </ChartSeries>
        </ChartData>
        <Style>
          <BackgroundColor>White</BackgroundColor>
        </Style>
        <Title>
          <Caption>MRB Value By Part Description (VALUE &gt; $2K) FOR Last Month</Caption>
        </Title>
        <Height>6.25in</Height>
        <Left>0.125in</Left>
      </Chart>
    </ReportItems>
    <Height>7in</Height>
  </Body>
  <Language>en-US</Language>
  <TopMargin>1in</TopMargin>
</Report>