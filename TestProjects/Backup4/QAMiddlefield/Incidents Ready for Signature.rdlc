        </Field>
        <Field Name="ServiceLogStatus">
          <DataField>ServiceLogStatus</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
      </Fields>
      <Query>
        <DataSourceName>Dashboard</DataSourceName>
        <CommandText>SELECT dbo.VIEW_Incidents.IncidentID, dbo.VIEW_Incidents.ProductLineName, dbo.VIEW_Incidents.Status, dbo.VIEW_Incidents.ResponsibleSupportName, dbo.VIEW_Incidents.CustomerName, dbo.VIEW_Incidents.TotalOpenRMAs, 
        dbo.VIEW_Incidents.TotalOpenServices, dbo.VIEW_Incidents.IncidentStatus, dbo.VIEW_Services.IncidentID AS Expr1, dbo.VIEW_Services.ServiceLogID, dbo.VIEW_Services.ServiceLogStatus
FROM dbo.VIEW_Incidents, dbo.VIEW_Services
WHERE dbo.VIEW_Incidents.IncidentID = dbo.VIEW_Services.IncidentID AND (dbo.VIEW_Incidents.IncidentStatus &lt;&gt; 'closed') AND (dbo.VIEW_Incidents.TotalOpenRMAs IS NULL) AND (dbo.VIEW_Incidents.TotalOpenServices IS NULL) AND 
        (NOT (dbo.VIEW_Services.ServiceLogStatus = 'Cancelled'))
ORDER BY dbo.VIEW_Incidents.TotalOpenServices, dbo.VIEW_Incidents.TotalOpenRMAs</CommandText>
        <rd:UseGenericDesigner>true</rd:UseGenericDesigner>
      </Query>
    </DataSet>
    <DataSet Name="DataSet1">
      <Fields>
