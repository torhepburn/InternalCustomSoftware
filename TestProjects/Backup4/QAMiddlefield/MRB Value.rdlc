<?xml version="1.0" encoding="utf-8"?>
<Report xmlns="http://schemas.microsoft.com/sqlserver/reporting/2005/01/reportdefinition" xmlns:rd="http://schemas.microsoft.com/SQLServer/reporting/reportdesigner">
  <DataSources>
    <DataSource Name="FAST_Analysis.mdb">
      <rd:DataSourceID>28318e38-68d1-41da-b104-2653694ac6db</rd:DataSourceID>
      <DataSourceReference>FAST_Analysis.mdb</DataSourceReference>
    </DataSource>
  </DataSources>
  <InteractiveHeight>8.5in</InteractiveHeight>
  <rd:DrawGrid>true</rd:DrawGrid>
  <InteractiveWidth>11in</InteractiveWidth>
  <rd:SnapToGrid>true</rd:SnapToGrid>
  <RightMargin>1in</RightMargin>
  <LeftMargin>1in</LeftMargin>
  <BottomMargin>1in</BottomMargin>
  <rd:ReportID>f41ef4bb-5bb9-4f68-a867-945adee2ce10</rd:ReportID>
  <PageWidth>11in</PageWidth>
  <DataSets>
    <DataSet Name="FastDataset">
      <Fields>
        <Field Name="FastID">
          <DataField>FastID</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
        <Field Name="PartNumber">
          <DataField>PartNumber</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="STANDARD_COST_PRICE">
          <DataField>STANDARD_COST_PRICE</DataField>
          <rd:TypeName>System.Double</rd:TypeName>
        </Field>
        <Field Name="Value_1">
          <DataField>Value</DataField>
          <rd:TypeName>System.Double</rd:TypeName>
        </Field>
        <Field Name="DateCreated_1">
          <DataField>DateCreated</DataField>
          <rd:TypeName>System.DateTime</rd:TypeName>
        </Field>
        <Field Name="Qty">
          <DataField>Qty</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
        <Field Name="FastOrigin">
          <DataField>FastOrigin</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Value">
          <Value>=CDbl(Fields!Value.Value)</Value>
          <rd:TypeName>System.Double</rd:TypeName>
        </Field>
        <Field Name="DateCreated">
          <Value>=Fields!DateCreated.Value</Value>
          <rd:TypeName>System.DateTime</rd:TypeName>
        </Field>
        <Field Name="Month">
          <Value>=Month(Fields!DateCreated_1.Value)</Value>
        </Field>
        <Field Name="Year">
          <Value>=Year(Fields!DateCreated_1.Value)</Value>
        </Field>
      </Fields>
      <Query>
        <DataSourceName>FAST_Analysis.mdb</DataSourceName>
        <CommandText>SELECT FastID, PartNumber, STANDARD_COST_PRICE, Value, DateCreated, Qty, FastOrigin
FROM FAST_MRB_VALUE_Query
WHERE (DateCreated &lt; Now()) AND DateCreated &gt; (Now()-365)</CommandText>
        <rd:UseGenericDesigner>true</rd:UseGenericDesigner>
      </Query>
    </DataSet>
  </DataSets>
  <Code />
  <Width>9.5in</Width>
  <Body>
    <ReportItems>
      <Chart Name="MRBVALUE">
        <Legend>
          <Visible>true</Visible>
          <Style>
            <BorderStyle>
              <Default>Solid</Default>
            </BorderStyle>
          </Style>
          <Position>BottomCenter</Position>
          <Layout>Table</Layout>
        </Legend>
        <CategoryAxis>
          <Axis>
            <Title />
            <Style>
              <FontSize>14pt</FontSize>
            </Style>
            <MajorGridLines>
              <Style>
                <BorderStyle>
                  <Default>Solid</Default>
                </BorderStyle>
              </Style>
            </MajorGridLines>
            <MinorGridLines>
              <Style>
                <BorderStyle>
                  <Default>Solid</Default>
                </BorderStyle>
              </Style>
            </MinorGridLines>
            <MajorTickMarks>Outside</MajorTickMarks>
            <Min>0</Min>
            <Visible>true</Visible>
          </Axis>
        </CategoryAxis>
        <DataSetName>FastDataset</DataSetName>
        <PlotArea>
          <Style>
            <BackgroundColor>WhiteSmoke</BackgroundColor>
            <BorderStyle>
              <Default>Solid</Default>
            </BorderStyle>
          </Style>
        </PlotArea>
        <ThreeDProperties>
          <Rotation>30</Rotation>
          <Inclination>30</Inclination>
          <Shading>Simple</Shading>
          <WallThickness>50</WallThickness>
        </ThreeDProperties>
        <PointWidth>0</PointWidth>
        <Filters>
          <Filter>
            <FilterExpression />
            <Operator>Like</Operator>
            <FilterValues>
              <FilterValue />
            </FilterValues>
          </Filter>
        </Filters>
        <SeriesGroupings>
          <SeriesGrouping>
            <DynamicSeries>
              <Grouping Name="chart1_SeriesGroup1">
                <GroupExpressions>
                  <GroupExpression>=Fields!FastOrigin.Value</GroupExpression>
                </GroupExpressions>
              </Grouping>
              <Label>=Fields!FastOrigin.Value</Label>
            </DynamicSeries>
          </SeriesGrouping>
        </SeriesGroupings>
        <Top>0.125in</Top>
        <Subtype>Plain</Subtype>
        <ValueAxis>
          <Axis>
            <Title>
              <Caption>MRB Value ($)</Caption>
              <Style>
                <FontSize>18pt</FontSize>
              </Style>
            </Title>
            <Style>
              <FontSize>14pt</FontSize>
              <Format>C</Format>
            </Style>
            <MajorGridLines>
              <ShowGridLines>true</ShowGridLines>
              <Style>
                <BorderStyle>
                  <Default>Solid</Default>
                </BorderStyle>
              </Style>
            </MajorGridLines>
            <MinorGridLines>
              <Style>
                <BorderStyle>
                  <Default>Solid</Default>
                </BorderStyle>
              </Style>
            </MinorGridLines>
            <MajorTickMarks>Outside</MajorTickMarks>
            <Min>0</Min>
            <Margin>true</Margin>
            <Visible>true</Visible>
            <Scalar>true</Scalar>
          </Axis>
        </ValueAxis>
        <Type>Line</Type>
        <CategoryGroupings>
          <CategoryGrouping>
            <DynamicCategories>
              <Grouping Name="MRBVALUE_CategoryGroup1">
                <GroupExpressions>
                  <GroupExpression>=Fields!Year.Value</GroupExpression>
                </GroupExpressions>
              </Grouping>
              <Sorting>
                <SortBy>
                  <SortExpression>=Fields!Year.Value</SortExpression>
                  <Direction>Ascending</Direction>
                </SortBy>
              </Sorting>
              <Label>=Fields!Year.Value</Label>
            </DynamicCategories>
          </CategoryGrouping>
          <CategoryGrouping>
            <DynamicCategories>
              <Grouping Name="MRBVALUE_CategoryGroup2">
                <GroupExpressions>
                  <GroupExpression>=Fields!Month.Value</GroupExpression>
                </GroupExpressions>
              </Grouping>
              <Sorting>
                <SortBy>
                  <SortExpression>=Fields!Month.Value</SortExpression>
                  <Direction>Ascending</Direction>
                </SortBy>
              </Sorting>
              <Label>=MonthName(Fields!Month.Value)</Label>
            </DynamicCategories>
          </CategoryGrouping>
        </CategoryGroupings>
        <Palette>Pastel</Palette>
        <ChartData>
          <ChartSeries>
            <DataPoints>
              <DataPoint>
                <DataValues>
                  <DataValue>
                    <Value>=Sum(Fields!Value_1.Value)</Value>
                  </DataValue>
                </DataValues>
                <DataLabel />
                <Marker />
              </DataPoint>
            </DataPoints>
          </ChartSeries>
        </ChartData>
        <Style>
          <BackgroundColor>White</BackgroundColor>
          <FontSize>16pt</FontSize>
        </Style>
        <Title>
          <Caption>MRB Value by Year &amp; Location of Defect (All Product)</Caption>
          <Style>
            <FontSize>18pt</FontSize>
            <FontWeight>700</FontWeight>
          </Style>
        </Title>
        <Left>0.25in</Left>
      </Chart>
    </ReportItems>
    <Height>6.375in</Height>
  </Body>
  <Language>en-US</Language>
  <TopMargin>1in</TopMargin>
  <PageHeight>8.5in</PageHeight>
</Report>