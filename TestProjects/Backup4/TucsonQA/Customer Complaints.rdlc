      <Query>
        <DataSourceName>Dashboard</DataSourceName>
        <CommandText>SELECT dbo.VIEW_Incidents.IncidentID, dbo.VIEW_Incidents.DateOpened, dbo.VIEW_Incidents.DaysSinceOpened, dbo.VIEW_Incidents.CustomerName, dbo.VIEW_Incidents.Contact, dbo.VIEW_Incidents.OperatorName, dbo.VIEW_Incidents.IncidentType, 
        dbo.VIEW_Incidents.DateDue, dbo.VIEW_Incidents.ResponsibleSupportName, dbo.VIEW_Incidents.Description, dbo.VIEW_Incidents.DaysDue, dbo.VIEW_Incidents.IncidentStatus, dbo.VIEW_Incidents.Status, dbo.VIEW_Incidents.EscalationLevel, 
        dbo.VIEW_Incidents.EscalationDescription, dbo.VIEW_Incidents.Resolution, dbo.VIEW_Incidents.ProductLineName, dbo.VIEW_Incidents.ProductLine, dbo.VIEW_Incidents.DaysLate, dbo.VIEW_Incidents.DateClosed, dbo.VIEW_Incidents.EscalationDate, 
        dbo.VIEW_Incidents.CustomerID, dbo.VIEW_Incidents.MasterID, dbo.VIEW_Incidents.TotalOpenRMAs, dbo.VIEW_Incidents.TotalOpenServices, dbo.VIEW_Incidents.TotalOpenTasks, dbo.VIEW_Incidents.MK_Company_ID
FROM dbo.VIEW_Incidents, dbo.View_Customers, dbo.View_Customers View_Customers_1
WHERE (dbo.VIEW_Incidents.IncidentType = 'complaint') AND (dbo.VIEW_Incidents.MK_Company_ID = 600) AND (dbo.VIEW_Incidents.DaysSinceOpened &lt; 360)</CommandText>
      </Query>
