      </Fields>
      <Query>
        <DataSourceName>FAST_Analysis.mdb</DataSourceName>
        <CommandText>SELECT *, MONTH(DateCreated) AS MTH, YEAR(DateCreated) AS YR FROM FAST_Disposition_Open_Aging_Query_ZOS WHERE (DateCreated&gt; Now() -183)</CommandText>
        <rd:UseGenericDesigner>true</rd:UseGenericDesigner>
      </Query>
