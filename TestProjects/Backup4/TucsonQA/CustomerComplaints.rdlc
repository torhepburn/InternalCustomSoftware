      <Query>
        <DataSourceName>Dashboard</DataSourceName>
        <CommandText>SELECT IncidentID, DateOpened, DaysSinceOpened, CustomerName, Contact, OperatorName, IncidentType, DateDue, ResponsibleSupportName, Description, DaysDue, IncidentStatus, Status, EscalationLevel, EscalationDescription, Resolution, ProductLineName, 
        ProductLine, DaysLate, DateClosed, EscalationDate, CustomerID, MasterID, TotalOpenRMAs, TotalOpenServices, TotalOpenTasks, MK_Company_ID
FROM dbo.VIEW_Incidents
WHERE (DaysSinceOpened &lt; 180) AND (IncidentType LIKE 'complaint') AND (MK_Company_ID = 600)</CommandText>
      </Query>
