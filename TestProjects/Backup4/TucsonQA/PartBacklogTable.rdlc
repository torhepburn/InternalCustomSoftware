      </Fields>
      <Query>
        <DataSourceName>ZOS_Insp_Logs_DB.mdb</DataSourceName>
        <CommandText>SELECT DRAWING_NO, DESCRIPTION, PRODUCT_LINE, IQC_Type, Receipt_Traveler, InspectionTime, InspTimeEa, Inspection_Date, QTY, Month (Inspection_Date) AS [MONTH], Year (Inspection_Date) AS [YEAR] 
FROM (SELECT *
FROM IQC_InspectionTimePer_qry 
WHERE (Inspection_Date &gt;= (Now() -60)) )
WHERE (Month (Inspection_Date) = Month (Now()) -1)</CommandText>
        <rd:UseGenericDesigner>true</rd:UseGenericDesigner>
      </Query>
    </DataSet>
  </DataSets>
