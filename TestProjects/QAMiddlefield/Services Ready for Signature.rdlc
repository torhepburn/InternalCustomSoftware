      <Query>
        <DataSourceName>Dashboard</DataSourceName>
        <CommandText>SELECT dbo.VIEW_Incidents.IncidentID, dbo.VIEW_Services.IncidentID AS Expr1, dbo.VIEW_Incidents.ProductLineName, dbo.VIEW_Services.PermanentSolution, dbo.VIEW_Services.RootCauseFound, dbo.VIEW_Services.MKDateInvoiced, dbo.VIEW_Services.BillingCode, dbo.VIEW_Incidents.Status, dbo.VIEW_Incidents.ResponsibleSupportName, dbo.VIEW_Services.ServiceLogID, dbo.VIEW_Services.ServiceLogStatus, dbo.VIEW_Services.RepairOwnerName, dbo.VIEW_Services_Signoffs.ServiceLogID AS Expr2, dbo.VIEW_Services_Signoffs.MFGRep, dbo.VIEW_Services_Signoffs.MfgRepName, dbo.VIEW_Services_Signoffs.ProductRep, dbo.VIEW_Services_Signoffs.ProducRepName, dbo.VIEW_Services_Signoffs.ProductRepDate, dbo.VIEW_Services_Signoffs.QualityRep, dbo.VIEW_Services_Signoffs.QualityRepName, dbo.VIEW_Incidents.CustomerName, dbo.VIEW_Services.PartDescription FROM dbo.VIEW_Services_Signoffs, { oj dbo.VIEW_Services FULL OUTER JOIN dbo.VIEW_Incidents ON dbo.VIEW_Services.IncidentID = dbo.VIEW_Incidents.IncidentID } WHERE dbo.VIEW_Services_Signoffs.ServiceLogID = dbo.VIEW_Services.ServiceLogID AND (dbo.VIEW_Incidents.ProductLineName = 'ZMI') AND (dbo.VIEW_Services.PermanentSolution IS NOT NULL) AND (dbo.VIEW_Services.RootCauseFound IS NOT NULL) AND (dbo.VIEW_Services.MKDateInvoiced IS NOT NULL) AND (dbo.VIEW_Services.BillingCode &lt;&gt; 'Charge') AND (dbo.VIEW_Incidents.Status = 1) AND (dbo.VIEW_Services.ServiceLogStatus &lt;&gt; 'closed')</CommandText>
      </Query>
