  <DataSets>
    <DataSet Name="DTC">
      <Fields>
        <Field Name="TotalItems">
          <DataField>TotalItems</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
        <Field Name="DTCItems">
          <DataField>DTCItems</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
        <Field Name="PctDTC">
          <DataField>PctDTC</DataField>
          <rd:TypeName>System.Double</rd:TypeName>
        </Field>
        <Field Name="Mth">
          <DataField>Mth</DataField>
          <rd:TypeName>System.Int16</rd:TypeName>
        </Field>
        <Field Name="Yer">
          <DataField>Yer</DataField>
          <rd:TypeName>System.Int16</rd:TypeName>
        </Field>
      </Fields>
      <Query>
        <DataSourceName>DTC</DataSourceName>
        <CommandText>SELECT COUNT(Unique_Item_Codes_Last_n_Months_Query.ITEM_CODE) AS TotalItems, COUNT(Supp_Rcpts_NCMRS_Insp_Codes_NowDTS_OK_Query.ITEM_CODE) AS DTCItems, DTCItems / TotalItems AS PctDTC, (MONTH(NOW())) AS Mth, YEAR(NOW()) AS Yer
FROM { oj Unique_Item_Codes_Last_n_Months_Query LEFT OUTER JOIN
        Supp_Rcpts_NCMRS_Insp_Codes_NowDTS_OK_Query ON Unique_Item_Codes_Last_n_Months_Query.ITEM_CODE = Supp_Rcpts_NCMRS_Insp_Codes_NowDTS_OK_Query.ITEM_CODE }</CommandText>
        <rd:UseGenericDesigner>true</rd:UseGenericDesigner>
      </Query>
    </DataSet>
  </DataSets>
