      <Query>
        <DataSourceName>ReceiptsAwaitingApproval</DataSourceName>
        <CommandText>SELECT ReceiptSummaryQuery.SUPPLIER, ReceiptSummaryQuery.SupplierName, ReceiptSummaryQuery.Commodity, ReceiptSummaryQuery.ITEM_CODE, 
               ReceiptSummaryQuery.ITEM_DESCRIPTION, ReceiptSummaryQuery.Kanban, ReceiptSummaryQuery.ORDER_NO, 
               ReceiptSummaryQuery.[POSITION], ReceiptSummaryQuery.DELIVERED_QUANTITY, ReceiptSummaryQuery.RECEIPT_DATE, 
               ReceiptSummaryQuery.DaysInQC, ReceiptSummaryQuery.RECEIPT_NUMBER, ReceiptSummaryQuery.MFG_OnHand, 
               ReceiptSummaryQuery.NextDemandDate_FirmOnly, ReceiptSummaryQuery.TotalDemand_FirmOnly, 
               ReceiptSummaryQuery.NextDemandDate_IncludeMRP, ReceiptSummaryQuery.TotalDemand_IncludeMRP, ReceiptSummaryQuery.OnShortageList, 
               ReceiptSummaryQuery.DashboardTrackerID, ReceiptSummaryQuery.QualityPriority, ReceiptSummaryQuery.AssignedTo, 
               ReceiptSummaryQuery.DateTimeUpdated, Commodity_Class.Class
FROM  ReceiptSummaryQuery, Commodity_Class
WHERE ReceiptSummaryQuery.Commodity = Commodity_Class.Commodity</CommandText>
      </Query>
    </DataSet>
