      <Query>
        <DataSourceName>FAST_Analysis.mdb</DataSourceName>
        <CommandText>Select *, (Now() - DateCreated) As DaysOpen
From dbo_VIEW_FAST_RCCArqd_Query
Where MK_Company_ID = 200 And Status = 'Open'</CommandText>
        <rd:UseGenericDesigner>true</rd:UseGenericDesigner>
      </Query>
