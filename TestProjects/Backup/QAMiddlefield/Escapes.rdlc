      </Fields>
      <Query>
        <DataSourceName>FAST_Analysis.mdb</DataSourceName>
        <CommandText>SELECT *
FROM dbo_VIEW_FAST_Escape_Query_IQC
WHERE (DateCreated &lt; Now()) AND DateCreated &gt; (Now()-183) AND (FASTDEFECTBDESC &lt;&gt; 'Performance') AND (FASTDEFECTBDESC &lt;&gt; 'Functional Failure') AND (FASTDEFECTBDESC &lt;&gt; 'Failed Component')</CommandText>
        <rd:UseGenericDesigner>true</rd:UseGenericDesigner>
      </Query>
    </DataSet>
