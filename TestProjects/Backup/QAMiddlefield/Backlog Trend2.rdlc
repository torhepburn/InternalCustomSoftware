<?xml version="1.0" encoding="utf-8"?>
<Report xmlns="http://schemas.microsoft.com/sqlserver/reporting/2005/01/reportdefinition" xmlns:rd="http://schemas.microsoft.com/SQLServer/reporting/reportdesigner">
  <DataSources>
    <DataSource Name="ReceiptsAwaitingApproval">
      <rd:DataSourceID>703699b2-31bc-4145-bad6-d186679bdc5e</rd:DataSourceID>
      <DataSourceReference>ReceiptsAwaitingApproval</DataSourceReference>
    </DataSource>
  </DataSources>
  <InteractiveHeight>11in</InteractiveHeight>
  <rd:DrawGrid>true</rd:DrawGrid>
  <InteractiveWidth>8.5in</InteractiveWidth>
  <rd:SnapToGrid>true</rd:SnapToGrid>
  <RightMargin>1in</RightMargin>
  <LeftMargin>1in</LeftMargin>
  <BottomMargin>1in</BottomMargin>
  <rd:ReportID>e5fa102e-46f1-40bb-ace6-651a0405e405</rd:ReportID>
  <DataSets>
    <DataSet Name="ReceiptsAwaitingApproval">
      <Fields>
        <Field Name="BacklogMonth">
          <DataField>BacklogMonth</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="AvgOf_29">
          <DataField>AvgOf&gt;29</DataField>
          <rd:TypeName>System.Double</rd:TypeName>
        </Field>
        <Field Name="AvgOf_5">
          <DataField>AvgOf&lt;5</DataField>
          <rd:TypeName>System.Double</rd:TypeName>
        </Field>
        <Field Name="AvgOf5_x_29">
          <DataField>AvgOf5&gt;x&gt;29</DataField>
          <rd:TypeName>System.Double</rd:TypeName>
        </Field>
      </Fields>
      <Query>
        <DataSourceName>ReceiptsAwaitingApproval</DataSourceName>
        <CommandText>SELECT BacklogMonth, [AvgOf&gt;29], [AvgOf&lt;5], [AvgOf5&gt;x&gt;29]
FROM     Backlog_by_Month_Query
GROUP BY BacklogMonth, [AvgOf&gt;29], [AvgOf&lt;5], [AvgOf5&gt;x&gt;29], BacklogMonthSort
ORDER BY BacklogMonthSort</CommandText>
      </Query>
    </DataSet>
  </DataSets>
  <Width>22in</Width>
  <Body>
