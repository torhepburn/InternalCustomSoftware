          <DataField>PartNumber</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="OrderNum">
          <DataField>OrderNum</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Description">
          <DataField>Description</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Howold">
          <DataField>Howold</DataField>
          <rd:TypeName>System.Int16</rd:TypeName>
        </Field>
        <Field Name="Howlong">
          <DataField>Howlong</DataField>
          <rd:TypeName>System.Int16</rd:TypeName>
        </Field>
        <Field Name="MKReceiptTransactionID">
          <DataField>MKReceiptTransactionID</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
        <Field Name="Inspector">
          <DataField>Inspector</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
      </Fields>
      <Query>
        <DataSourceName>MaintainApprovalHistory</DataSourceName>
        <CommandText>SELECT tblTimeFromRecToQC_200.DaysFromRecToQC, tblTimeFromRecToQC_200.MaintainOperator, tblTimeFromRecToQC_200.ReceivedDate, 
                  tblTrackerLinkApproval_200.PartNumber, tblTrackerLinkApproval_200.OrderNum, tblTrackerLinkApproval_200.Description, MAX(cint(Datediff('d', 
                  tblTimeFromRecToQC_200.ReceivedDate, NOW()))) AS Howold, MAX(cint(tblTimeFromRecToQC_200.DaysFromRecToQC)) AS Howlong, 
                  tblTimeFromRecToQC_200.MKReceiptTransactionID, tblTrackerLinkApproval_200.Inspector
FROM     tblTimeFromRecToQC_200, tblTrackerLinkApproval_200
WHERE  tblTimeFromRecToQC_200.MKReceiptTransactionID = tblTrackerLinkApproval_200.MKReceiptTransactionID
GROUP BY tblTimeFromRecToQC_200.ReceivedDate, tblTimeFromRecToQC_200.DaysFromRecToQC, tblTimeFromRecToQC_200.MaintainOperator, 
                  tblTrackerLinkApproval_200.PartNumber, tblTrackerLinkApproval_200.OrderNum, tblTrackerLinkApproval_200.Description, 
                  tblTimeFromRecToQC_200.MKReceiptTransactionID, tblTrackerLinkApproval_200.Inspector
HAVING (MAX(cint(tblTimeFromRecToQC_200.DaysFromRecToQC)) &gt; 30) AND (MAX(cint(Datediff('d', tblTimeFromRecToQC_200.ReceivedDate, NOW()))) &lt; 182)</CommandText>
      </Query>
    </DataSet>
  </DataSets>
  <Width>24.20835in</Width>
