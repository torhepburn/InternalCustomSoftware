<?xml version="1.0" encoding="utf-8"?>
<Report xmlns="http://schemas.microsoft.com/sqlserver/reporting/2005/01/reportdefinition" xmlns:rd="http://schemas.microsoft.com/SQLServer/reporting/reportdesigner">
  <DataSources>
    <DataSource Name="Dashboard">
      <rd:DataSourceID>eef30233-f04d-4a93-8efb-bbe318f22e33</rd:DataSourceID>
      <DataSourceReference>Dashboard</DataSourceReference>
    </DataSource>
  </DataSources>
  <InteractiveHeight>11in</InteractiveHeight>
  <rd:DrawGrid>true</rd:DrawGrid>
  <InteractiveWidth>8.5in</InteractiveWidth>
  <rd:SnapToGrid>true</rd:SnapToGrid>
  <RightMargin>1in</RightMargin>
  <LeftMargin>1in</LeftMargin>
  <BottomMargin>1in</BottomMargin>
  <rd:ReportID>425013e1-eb54-4eb2-829d-da843e72a06c</rd:ReportID>
  <DataSets>
    <DataSet Name="DataSet1">
      <Fields>
        <Field Name="MKReceiptTransactionID">
          <DataField>MKReceiptTransactionID</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
        <Field Name="ReceivedDate">
          <DataField>ReceivedDate</DataField>
          <rd:TypeName>System.DateTime</rd:TypeName>
        </Field>
        <Field Name="Transactiondate">
          <DataField>Transactiondate</DataField>
          <rd:TypeName>System.DateTime</rd:TypeName>
        </Field>
        <Field Name="DaysFromReceiptToApproval">
          <DataField>DaysFromReceiptToApproval</DataField>
          <rd:TypeName>System.Decimal</rd:TypeName>
        </Field>
      </Fields>
      <Query>
        <DataSourceName>Dashboard</DataSourceName>
        <CommandText>SELECT t.MKReceiptTransactionID, t.ReceivedDate, m.Transactiondate, CASE WHEN (datediff(dd, t .receiveddate, m.transactiondate)) - (datediff(ww, t .receiveddate, 
                  m.transactiondate) * 2) = 0 THEN .5 ELSE (datediff(dd, t .receiveddate, m.transactiondate)) - (datediff(ww, t .receiveddate, m.transactiondate) * 2) 
                  END AS DaysFromReceiptToApproval
FROM     dbo.[Tracking - All] t, dbo.VIEW_Maintain_Approval m
WHERE  t.MKReceiptTransactionID = m.MKReceiptTransactionID AND (t.CompanyID = 600) AND (t.InspectionRequired = 1) AND (t.ReceivedDate &gt; '1/1/2010') AND 
                  (t.Location LIKE 'receiving dock %tucson%')</CommandText>
      </Query>
    </DataSet>
  </DataSets>
  <Width>6.5in</Width>
  <Body>
    <ReportItems>
      <Chart Name="chart1">
        <Legend>
          <Visible>true</Visible>
          <Style>
            <BorderStyle>
              <Default>Solid</Default>
            </BorderStyle>
          </Style>
          <Position>BottomCenter</Position>
        </Legend>
        <CategoryAxis>
          <Axis>
            <Title>
              <Caption>Date Recieved</Caption>
            </Title>
            <Style />
            <MajorGridLines>
              <Style>
                <BorderStyle>
                  <Default>Solid</Default>
                </BorderStyle>
              </Style>
            </MajorGridLines>
            <MinorGridLines>
              <Style>
                <BorderStyle>
                  <Default>Solid</Default>
                </BorderStyle>
              </Style>
            </MinorGridLines>
            <MajorTickMarks>Outside</MajorTickMarks>
            <Min>0</Min>
            <Visible>true</Visible>
          </Axis>
        </CategoryAxis>
        <DataSetName>DataSet1</DataSetName>
        <PlotArea>
          <Style>
            <BackgroundColor>LightGrey</BackgroundColor>
            <BorderStyle>
              <Default>Solid</Default>
            </BorderStyle>
          </Style>
        </PlotArea>
        <ThreeDProperties>
          <Rotation>30</Rotation>
          <Inclination>30</Inclination>
          <Shading>Simple</Shading>
          <WallThickness>50</WallThickness>
        </ThreeDProperties>
        <PointWidth>0</PointWidth>
        <Filters>
          <Filter>
            <FilterExpression>=Year(Fields!ReceivedDate.Value)</FilterExpression>
            <Operator>GreaterThanOrEqual</Operator>
            <FilterValues>
              <FilterValue>=year(now())-1</FilterValue>
            </FilterValues>
          </Filter>
        </Filters>
        <SeriesGroupings>
          <SeriesGrouping>
            <StaticSeries>
              <StaticMember>
                <Label>Average Days</Label>
              </StaticMember>
            </StaticSeries>
          </SeriesGrouping>
        </SeriesGroupings>
        <Top>0.125in</Top>
        <Subtype>Plain</Subtype>
        <ValueAxis>
          <Axis>
            <Title />
            <MajorGridLines>
              <ShowGridLines>true</ShowGridLines>
              <Style>
                <BorderStyle>
                  <Default>Solid</Default>
                </BorderStyle>
              </Style>
            </MajorGridLines>
            <MinorGridLines>
              <Style>
                <BorderStyle>
                  <Default>Solid</Default>
                </BorderStyle>
              </Style>
            </MinorGridLines>
            <MajorTickMarks>Outside</MajorTickMarks>
            <Min>0</Min>
            <Margin>true</Margin>
            <Visible>true</Visible>
            <Scalar>true</Scalar>
          </Axis>
        </ValueAxis>
        <Type>Column</Type>
        <Width>6.25in</Width>
        <CategoryGroupings>
          <CategoryGrouping>
            <DynamicCategories>
              <Grouping Name="chart1_CategoryGroup2">
                <GroupExpressions>
                  <GroupExpression>=year(Fields!Transactiondate.Value)</GroupExpression>
                </GroupExpressions>
              </Grouping>
              <Sorting>
                <SortBy>
                  <SortExpression>=Fields!Transactiondate.Value</SortExpression>
                  <Direction>Ascending</Direction>
                </SortBy>
              </Sorting>
              <Label>=year(Fields!Transactiondate.Value)</Label>
            </DynamicCategories>
          </CategoryGrouping>
          <CategoryGrouping>
            <DynamicCategories>
              <Grouping Name="chart1_CategoryGroup1">
                <GroupExpressions>
                  <GroupExpression>=Month(Fields!Transactiondate.Value)</GroupExpression>
                </GroupExpressions>
              </Grouping>
              <Sorting>
                <SortBy>
                  <SortExpression>=Fields!Transactiondate.Value</SortExpression>
                  <Direction>Ascending</Direction>
                </SortBy>
              </Sorting>
              <Label>=MonthName(Month(Fields!Transactiondate.Value))</Label>
            </DynamicCategories>
          </CategoryGrouping>
        </CategoryGroupings>
        <Palette>Default</Palette>
        <ChartData>
          <ChartSeries>
            <DataPoints>
              <DataPoint>
                <DataValues>
                  <DataValue>
                    <Value>=Avg(Fields!DaysFromReceiptToApproval.Value)</Value>
                  </DataValue>
                </DataValues>
                <DataLabel />
                <Marker>
                  <Size>6pt</Size>
                </Marker>
              </DataPoint>
            </DataPoints>
          </ChartSeries>
        </ChartData>
        <Style>
          <BackgroundColor>White</BackgroundColor>
        </Style>
        <Title />
        <Height>4in</Height>
        <Left>0.125in</Left>
      </Chart>
    </ReportItems>
    <Height>4.25in</Height>
  </Body>
  <Language>en-US</Language>
  <TopMargin>1in</TopMargin>
</Report>