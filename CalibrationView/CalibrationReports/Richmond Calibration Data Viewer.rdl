  <DataSets>
    <DataSet Name="DataSet1">
      <Query>
        <DataSourceName>CalibrationDS</DataSourceName>
        <QueryParameters>
          <QueryParameter Name="@Status">
            <Value>=Parameters!Status.Value</Value>
          </QueryParameter>
        </QueryParameters>
        <CommandText>SELECT * FROM webzep 

WHERE Status IN (@Status) 

ORDER BY id</CommandText>
        <rd:UseGenericDesigner>true</rd:UseGenericDesigner>
      </Query>
