  <connectionStrings>
    <add name="DefaultConnection" connectionString="Data Source=(LocalDb)\v11.0;AttachDbFilename=|DataDirectory|\aspnet-ParticleCountDataDisplay-20140512035953.mdf;Initial Catalog=aspnet-ParticleCountDataDisplay-20140512035953;Integrated Security=True" providerName="System.Data.SqlClient"/>
