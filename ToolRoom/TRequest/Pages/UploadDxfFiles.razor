@page "/uploadDxfFiles"

<PageTitle>Upload dxf Files</PageTitle>

<h1>Select dxf file to upload.</h1>

@using TRequest.Data
@using System.Data;
@using Microsoft.Data.SqlClient

@inject Global g
@inject NavigationManager NavMgr

<InputFile OnChange="@SingleUpload" accept=".DXF" />

@code 
{
    SqlDataReader dr;
    SqlConnection cnxn;
    SqlCommand cmd;
    DataTable dt;
    private string data ="";
    private string? selectedID;
    private string? reviewer;
    private byte[]? bytes;
    private bool pdf;
    private int flen;

    private string uploadedFilename=string.Empty;

    private async Task SingleUpload(InputFileChangeEventArgs e)
    {
        MemoryStream ms = new MemoryStream();
        try
        {
            await e.File.OpenReadStream(maxAllowedSize:2000000).CopyToAsync(ms);
        }
        catch (Exception ex)
        {
            ex.ToString();
        }
        bytes = ms.ToArray();

        uploadedFilename = e.File.Name;
        //flen = Convert.ToInt32(e.File.Size);

        if (e.File.Name.ToUpper().Contains("DXF"))
        {
            pdf = false;
            dxfUpload();
        }

        NavMgr.NavigateTo("ThankYou");
    }

    private void dxfUpload()
    {
        cnxn = new SqlConnection(g.db);

        SqlParameter prm1 = new SqlParameter
                ("@file", SqlDbType.VarBinary, Convert.ToInt32(bytes.Length));
                //("@file", SqlDbType.VarBinary, flen);
        prm1.Value = bytes;

        SqlCommand cmd = new SqlCommand
            ("Update Tool_Requests set uploaded_dxf = " + prm1 + "  " +
             " ,uploaded_filename = '" + uploadedFilename + "' " +
             " where id = " + g.requestID + " ", cnxn);
        cmd.Parameters.Add(prm1);

        cnxn.Open();
        cmd.ExecuteNonQuery();
        cnxn.Close();
    }
}
