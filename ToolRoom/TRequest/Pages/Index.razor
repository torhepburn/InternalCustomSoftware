@page "/"
@page "/index"

@using TRequest.Data

@using Microsoft.Data.SqlClient
@using System.ComponentModel.DataAnnotations
@using System.Data
@using static PopUp

@inject Global g
@*@inject FormModel f*@

@inject NavigationManager NavMgr
@*
<div class="popup-overlay @(pop.IsVisible ? "visible" : "")">
    <div class="popup-content">
        <h3>@pop.Title</h3>
        <p>@pop.Message</p>
        <button @onclick="pop.ClosePopup">Close</button>
