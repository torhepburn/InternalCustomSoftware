<PageTitle>Tool Room Requests</PageTitle>

<table width="100%">
    <tr>
        <td align="center">
            <h3>Tool Room Requests</h3>
        </td>
    </tr>
    <tr>
        <td align="center">
            Items marked with an asterisk * require an entry.<br />
        </td>
    </tr>
    <tr>
        <td align="center">
        <EditForm EditContext="EditContext" OnValidSubmit="DataEntry">
        <InputCheckbox @bind-Value="cbPersist"></InputCheckbox> Check this box if you want to make multiple entries and have some selections remain.
        </EditForm>
        </td>
    </tr>
    <tr>
        <td align="center">
            <br />
            After clicking the Submit button a window will open for attaching the checked document type.
        </td>
    </tr>
    <tr></tr>
</table>
<br />

<div style="display:flex;justify-content:center">
    <EditForm EditContext="EditContext">
        
            <div>
                <div>
                    <InputCheckbox @bind-Value="cbPDF"></InputCheckbox> Check if attaching pdf document. (Must be less than 500kb)
                </div> 
            
                <div>
                    <InputCheckbox @bind-Value="cbDXF"></InputCheckbox> Check if attaching dxf document - must be Scale 1:1 - no Step files.
                </div> 
            <br />
            <div>Select Employee:</div>
            </div>
    </EditForm>
</div>

<div style="display:flex;justify-content:center">
    <EditForm EditContext="EditContext">
        
            <div>
                <div>
                    <div>
                <InputSelect id="employees" style="width: 60%" @bind-Value="g.eIndex">
                        <option value="">Must Select an Employee</option>

                        @foreach (DataRow r in dtEmployees.Rows)
                        {
                                <option value="@r[0].ToString()">@r[1].ToString()</option>
                        }
                    </InputSelect>
                    </div>
                </div> 
            
                <div>
                    Contact Email :
                <InputText id="n3" placeholder="" style="width: 70%" @bind-Value="g.contactEmail" />
                </div> 
            <br />
            </div>
            <div>
                Phone Extension :
                    <InputText id="n13" placeholder="" style="width: 20%" @bind-Value="extension" />

            </div>
    </EditForm>
</div>

<div style="display:flex; justify-content:center">
    <EditForm Model="validations" OnValidSubmit="@HandleValidSubmit">
    <DataAnnotationsValidator />
    <ValidationSummary />

    <div style="display:flex">
        <div>

            <div>
                 * Priority :
                    <InputSelect class="form-control" style="width: 80%" @bind-Value="validations.Priority">
                        <option value="">Selection Required</option>
                        <option value="Routine">Routine</option>
                        <option value="Urgent">Urgent</option>
                        <option value="Production Down">Production Down</option>
                    </InputSelect>

                    <ValidationMessage For="()=> validations.Priority" style="display:inline" />

            </div>

            <div>
                * Request Reason :   
                    <InputSelect class="form-control" style="width: 80%" @bind-Value="validations.Request_Reason">
                        <option value="">Selection Required</option>
                        <option value="Tooling">R&D</option>
                        <option value="Tooling">Tooling</option>
                        <option value="Prototype">Prototype</option>
                        <option value="Production">Production</option>
                        
                    </InputSelect>
                    <ValidationMessage For="()=> validations.Request_Reason" />
            </div>

            <div>  * Request Type :

                    <select class="form-control" style="width: 80%" @onchange="OnCategoryChanged">
                    <option value="">Selection Required</option>
                    @foreach (var category in Categories)
                    {
                        <option value="@category.Id">@category.Name</option>
                    }
                </select>
                <ValidationMessage For="()=> validations.Request_Type" />
            </div>

                <div>
                    * Type SubCategory :
                    @if (filteredItems != null && filteredItems.Any())
                    {

                    <InputSelect class="form-control" style="width: 80%" @bind-Value="validations.TypeSubcategory">
                        
                        {
                            <option value="">Selection Required</option>
                            @foreach (var item in filteredItems )
                            {
                                <option value="@item.Name">@item.Name</option>
                            }
                        }
                    </InputSelect>
                    <ValidationMessage For="()=> validations.TypeSubcategory" />
                    }
                </div>

                
            <div>
                * Cost Center:
                    <br />
                            <InputSelect id="s4" class="form-control" style="width: 80%" @bind-Value="validations.CostCenter">

                            <option value="">Cost Center Lookup</option>
                            @foreach (System.Data.DataRow r in dtCostCenters.Rows)
                            {
                                        <option value="@r[0].ToString()">@r[0].ToString()</option>
                            }
                            </InputSelect>
                
                    <ValidationMessage For="()=> validations.CostCenter" />

            </div>

            <div>
                * Quantity :
                    <InputNumber id="n4" style="width: 20%" placeholder="" @bind-Value="validations.Quantity" />

                    <ValidationMessage For="()=> validations.Quantity" />
            </div>

            <div>
                
            </div>
        </div>

        <div>
            

            <div>
                * Time Savings Estimate (work days:  whole numbers only: no decimals) :
                    <InputNumber id="n100" style="width: 10%" placeholder="" @bind-Value="validations.TimeSavings" />
                    <ValidationMessage For="()=> validations.TimeSavings" style="display:inline" />
            </div>

            <div>
                Cost Savings Estimate (whole numbers only; no decimals: no $ sign: 0 for n/a):
                    <InputNumber id="n10" style="width: 10%" placeholder="" @bind-Value="validations.CostSavings" />
                    <ValidationMessage For="()=> validations.CostSavings" />
            </div>

    
            <div>
                 Revenue Savings Estimate (whole numbers only; no decimals: no $ sign: 0 for n/a):

                    <InputNumber id="n10" style="width: 10%" placeholder="" @bind-Value="validations.RevenueSavings" />
                    <ValidationMessage For="()=> validations.RevenueSavings" />
            </div>

            <div>
                Project :
                    <InputText id="n8" style="width: 50%" placeholder="" @bind-Value="g.project" />
            </div>

            <div>
                Rework # :
                    <InputText id="n9" style="width: 10%" placeholder="" @bind-Value="reworkNumber" />
            </div>

                <div>
                    Part Number :
                    <InputText id="n81" style="width: 50%" placeholder="if no part number enter 'no part number'" @bind-Value="validations.partnumber" />
                </div>

                <div>
                    FAST Number :
                    <InputText id="n82" style="width: 50%" placeholder="if no FAST number enter 'no FAST number'" @bind-Value="validations.FastNumber" />
                </div>

                <div>
                    Production Number :
                    <InputText id="n83" style="width: 50%" placeholder="if no production number enter 'no production number'" @bind-Value="validations.ProductionNumber" />
                </div>

            <div>
                * Select Requested Date :
                    <InputDate id="ds1" style="width: 50%; height: 50px" @bind-Value="validations.RequestedDate" />
                    <ValidationMessage For="()=> validations.RequestedDate" />
            </div>

            <div>
                * Describe Request/List Requirements :
                    <InputTextArea id="a13" placeholder="Requiremenets" style="width: 80%; height: 100px" @bind-Value="validations.Request" />
                    <ValidationMessage For="()=> validations.Request" />

            </div>

                <div>
                    Comments :
                    <InputTextArea id="a15" placeholder="Comments" style="width: 70%; height: 30px" @bind-Value="g.requestComments" />
                    

                </div>

            <div>
                <InputText id="a133" placeholder="Name" style="visibility:hidden" @bind-Value="validations.Employee" />
                    <ValidationMessage For="()=> validations.Employee" />
            </div>
    
        </div>
          <div>
                <button class="btn btn-primary" style="height:250px">Submit Request</button>
          </div>
         
    </div>
</EditForm>
</div>
               
  
@code
{
    private FormModel dataModel = new FormModel();

    public EditContext? EditContext;
    //private ValidationMessageStore? messageStore;

    PopUp pop = new PopUp();

    private string requestor = "";
    public string extension = "";
    //public int eIndex;
    private string reworkNumber = "";
    //private string project = "";
    private string requestType = "";
    private string pdf = "";
    private string dxf = "";

    private string? LCostCenter = " Cost Center  ";
    private string? LProjectNumber = " Project Number  ";
    private string? Lpdf = " Check if attaching pdf document.  ";
    public bool cbPersist = false;
    private bool cbPDF = false;
    private bool cbDXF = false;


    static string SqlTable = "Tool_Requests";
    static string filetypeLoaded;
    //static bool Ftwofiles = false;
    //static bool Ftwofiles2BUploaded = false;
    //static string filetypeSelected;

    //static string requestResponse;
    //static string requestReport;
    //static string subjectline;
    static string ename;
    static int uid;

    SqlDataReader dr;
    SqlConnection cnxn;
    SqlCommand cmd;
    System.Data.DataTable dtEmployees;
    System.Data.DataTable dtParts;
    System.Data.DataTable dtProjectCharges;
    System.Data.DataTable dtCostCenters;

    DataTable table;
    DataTable table1;
