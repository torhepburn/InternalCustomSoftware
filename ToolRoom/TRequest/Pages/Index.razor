<EditForm EditContext="EditContext">
    <table width="100%" cellpadding="8">
        <tr>
            <td>

            </td>
                <td>
                <InputCheckbox @bind-Value="cbPDF"></InputCheckbox> Check if attaching pdf document.
            </td>
            <td>
                <InputCheckbox @bind-Value="cbDXF"></InputCheckbox> Check if attaching dxf document - must be Scale 1:1 - no Step files.
            </td>
            </tr>
            
        <tr>
            <td>
                <p>
                    <label for="employees">
                        * Name :
                    </label>
                    <InputSelect id="employees" style="width: 60%" @bind-Value="eIndex">
                        <option value="">Must Select an Employee</option>

                        @foreach (DataRow r in dtEmployees.Rows)
                        {
                                <option value="@r[0].ToString()">@r[1].ToString()</option>
                        }
                    </InputSelect>
                </p>
            </td>
            <td></td>
            <td align="left"> Contact Email :
                <InputText id="n3" placeholder="" style="width: 70%" @bind-Value="g.contactEmail" />
                </td>
        </tr>
    </table>
</EditForm>

<EditForm Model="validations" OnValidSubmit="@HandleValidSubmit">
    <DataAnnotationsValidator />
    <ValidationSummary />
    <table width="100%" cellpadding="8">

        <tr>
            <td>
               
                Phone Extension :
                <InputText id="n13" placeholder="" style="width: 20%" @bind-Value="extension" />
            </td>
            
            <td>
                * Time Savings Estimate (work days:  whole numbers only: no decimals) :
                <InputNumber id="n100" style="width: 10%" placeholder="" @bind-Value="validations.TimeSavings" />
                <ValidationMessage For="()=> validations.TimeSavings" style="display:inline" />
            </td>

        </tr>
        <tr>
            <td align="left">
                 * Priority :
                <InputSelect class="form-control" style="width: 50%" @bind-Value="validations.Priority">
                    <option value="">Selection Required</option>
                    <option value="Routine">Routine</option>
                    <option value="Urgent">Urgent</option>
                    <option value="Production Down">Production Down</option>
                </InputSelect>

                <ValidationMessage For="()=> validations.Priority" style="display:inline" />
                
            </td>
            
            <td>
                * Cost Savings Estimate (whole numbers only; no decimals: no $ sign: 0 for n/a):
                <InputNumber id="n10" style="width: 10%" placeholder="" @bind-Value="validations.CostSavings" />
                <ValidationMessage For="()=> validations.CostSavings" />
            </td>
        </tr>

        <tr>
            <td>
               * Request Type :   <InputSelect class="form-control" style="width: 50%" @bind-Value="validations.RequestType">
                    <option value="">Selection Required</option>
                    <option value="Production">Production</option>
                    <option value="Prototype">Prototype</option>
                    <option value="Tooling">Tooling</option>
                   
                </InputSelect>
                <ValidationMessage For="()=> validations.RequestType" />
            </td>
            
            <td>
                * Revenue Savings Estimate (whole numbers only; no decimals: no $ sign: 0 for n/a):

                <InputNumber id="n10" style="width: 10%" placeholder="" @bind-Value="validations.RevenueSavings" />
                <ValidationMessage For="()=> validations.RevenueSavings" />
            </td>
        </tr>

        <tr>
            <td>
                * Cost Center:
                <br />
                        <InputSelect id="s4" class="form-control" style="width: 80%" @bind-Value="validations.CostCenter">

                            <option value="">Cost Center Lookup</option>
                        @foreach (System.Data.DataRow r in dtCostCenters.Rows)
                        {
                                    <option value="@r[0].ToString()">@r[0].ToString()</option>
                        }
                        </InputSelect>
                
                <ValidationMessage For="()=> validations.CostCenter" />

            </td>
            
            <td>
                Project :
                <InputText id="n8" style="width: 50%" placeholder="" @bind-Value="project" />
            </td>
        </tr>
       

        <tr>
            <td>
                * Quantity :
                <InputNumber id="n4" style="width: 20%" placeholder="" @bind-Value="validations.Quantity" />

                <ValidationMessage For="()=> validations.Quantity" />
            </td>
            

            <td>
                Rework # :
                <InputText id="n9" style="width: 10%" placeholder="" @bind-Value="reworkNumber" />
            </td>


        </tr>

        
        <tr>
            <td>
                * Select Requested Date :
                <InputDate id="ds1" style="width: 50%; height: 100px" @bind-Value="validations.RequestedDate" />
                <ValidationMessage For="()=> validations.RequestedDate" />

                

            </td>
            

            <td>
                * Describe Request/List Requirements :
                <InputText id="a13" placeholder="Requiremenets" style="width: 100%; height: 100px" @bind-Value="validations.Request" />
                <ValidationMessage For="()=> validations.Request" />

            </td>
        </tr>
        <tr>
            <td>
                <br />
                
            </td>
            
            <td>
                <button class="btn btn-primary">Submit Request</button>
            </td>
        </tr>

    </table>

</EditForm>





