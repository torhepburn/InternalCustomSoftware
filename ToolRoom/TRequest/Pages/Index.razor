    //static string SqlTable = "Tool_Requests";
    static string filetypeSelected;
    //static string filetypeLoaded;
    static bool Ftwofiles = false;
    static bool Ftwofiles2BUploaded = false;
    static string uploadedFilename;
    static string requestResponse;
    static string requestReport;
    static string calendarFlag;
    static string costcenter;
    static string Sql;
    static string db = "server=CT-MID-SQL11; user=readWrite; password=Read+Write!;" +
                       "database=AccessFrontEnds";
    static string subjectline;
    //static string ename;
    //static int uid;
    static string testing = "NO";


    private string? selectedID;

    private ValidationComponents validations = new ValidationComponents();

    public class Category
    {
        public int Id { get; set; }
        public string Name { get; set; }
    }
    public class Item
    {
        public int Id { get; set; }
        public string Name { get; set; }
        public int CategoryId { get; set; }
    }

    private List<Category> Categories = new()
    {
        new Category { Id = 1, Name = "New" }
        ,new Category { Id = 2, Name = "Modification" }
        ,new Category { Id = 3, Name = "Rework" }
    };

    private List<Item> Items = new()
    {
         new Item { Id = 1, Name = "Leadtime", CategoryId = 1 }
        ,new Item { Id = 2, Name = "Cost", CategoryId = 1 }
        ,new Item { Id = 3, Name = "Lost or Missing", CategoryId = 1 }
        ,new Item { Id = 4, Name = "Non-Std Type", CategoryId = 1 }
        ,new Item { Id = 5, Name = "ECO", CategoryId = 2 }
        ,new Item { Id = 6, Name = "Development", CategoryId = 2 }
        ,new Item { Id = 7, Name = "Supplier Quality", CategoryId = 3 }
        ,new Item { Id = 8, Name = "Training", CategoryId = 3 }
        ,new Item { Id = 9, Name = "Handling", CategoryId = 3 }
        ,new Item { Id = 10, Name = "Storage", CategoryId = 3 }
        ,new Item { Id = 11, Name = "Packaging", CategoryId = 3 }
        ,new Item { Id = 12, Name = "Dwg/Specification Error", CategoryId = 3 }
    };

    private void OnCategoryChanged(ChangeEventArgs e)
    {
        selectedCategoryId = Convert.ToInt32(e.Value);
        filteredItems = Items.Where(item => item.CategoryId == selectedCategoryId).ToList();
        validations.Request_Type = (Categories[selectedCategoryId - 1]).Name;
    }


    private int selectedCategoryId;
    private List<Item> filteredItems = new List<Item>();

    private void HandleValidSubmit()
    {
        DataEntry();
    }

    // protected override void OnParametersSet()
    // {
    //     base.OnParametersSet();
    // }





    protected override void OnInitialized()
    {
        EditContext = new EditContext(dataModel);
        EditContext.OnFieldChanged += EditContext_OnFieldChanged;
        //EditContext.OnValidationRequested += HandleValidationRequested;
        //messageStore = new(EditContext);

        //popup = new PopUp();

        dtEmployees = new DataTable();

        cnxn = new SqlConnection(g.db);

        cmd = new("select " +
                  "  ROW_NUMBER() OVER " +
                  "(Order BY sn) " +
                  ", SN + '  : ' + CN " +
                  ", mail " +
                  "FROM EmployeesAmetekAD " +
                  "WHERE BU = 'ct-mid' " +
                  "order by SN "
                  , cnxn);

        try
        {
            cnxn.Open();
            dr = cmd.ExecuteReader();
            dtEmployees.Load(dr);
        }
        catch (SqlException ex)
        {
            pop.Title = "Error";
            pop.Message = ex.ToString();
            pop.ShowPopup();
        }
        finally
        {
            cnxn.Close();

        }


        dtCostCenters = new System.Data.DataTable();

        cnxn = new SqlConnection(g.dbNAV);

        cmd = new SqlCommand(
            "select Code + '  ' + Name As Number from [ZYGO$Dimension Value] " +
            "WHERE [Dimension Code] = 'COSTCENTER' AND Blocked = 0 ORDER BY Number", cnxn);

        try
        {
            cnxn.Open();
            dr = cmd.ExecuteReader();
            dtCostCenters.Load(dr);
        }
        catch (SqlException ex)
        {
            ex.ToString();
        }
        finally
        {
            cnxn.Close();
        }

        if (g.persist == true)
        {
            validations.CostCenter = g.costcenter;
            g.costcenter = validations.CostCenter;
            validations.Priority = g.priority;
            validations.Request = g.request_text;
            validations.Employee = g.requestor;
            extension = g.requestorPhone;
            validations.Request_Type = g.request_Type;
            cbPersist = g.persist;

        }
        else
        {
            g.project = string.Empty;
            g.requestorPhone = string.Empty;
            g.requestor = string.Empty;
            g.eIndex = 0;
            g.contactEmail = string.Empty;
        }
    }

    public void DataEntry()
    {
        string submitDate = DateTime.Now.ToString();

        g.requestResponse =
            "Dear " + validations.Employee + "," +
            "\n\r" +
            "Here is the information which you submitted on your recent tool request:" +
            "\n\r" +
            "Date and Time of Submission: " +
            submitDate + "  Eastern Standard Time" +
            "\n\r" +
            "Name............: " + validations.Employee + "\n\r" +
            "Contact eMail...: " + g.contactEmail + "\n\r" +
            "Ext.............: " + extension + "\r" +
            "Priority........: " + validations.Priority + "\r" +
            "Quantity........: " + validations.Quantity.ToString() + "\r" +
            "Need Date.......: " + validations.RequestedDate.ToShortDateString() + "\r" +
            "Project.........: " + g.project + "\r" +
            "Rework #........: " + reworkNumber + "\r" +
            "Cost Center.....: " + validations.CostCenter + "\n\r" +
            "Time Savings Est: " + validations.TimeSavings.ToString() + "\n\r" +
            "Cost Savings Est: " + validations.CostSavings.ToString() + "\n\r" +
            "Revenue Savings Est: " + validations.RevenueSavings.ToString() + "\n\r" +
            "\n\r" +
            "Request Reason..: " + validations.Request_Reason + "\n\r" +
            "Request Type....: " + validations.Request_Type + "\n\r" +
            "Subcategory.....: " + validations.TypeSubcategory + "\n\r" +
            "Part Number.....: " + validations.partnumber + "\n\r" +
            "FAST Number.....: " + validations.FastNumber + "\n\r" +
            "Production Number.: " + validations.ProductionNumber + "\n\r" +
            "Request Comments..: " + g.requestComments + "\n\r" +
            "Tool Request Description: " +
            "\r\r" +
            validations.Request;


        // email to tool room to report request

        g.subjectLine = "Tool Request AA: " + g.contactEmail;

        g.requestReport =
                    "Tool Request Description: " +
                    "\r\r" +
                    validations.Request +
                    "\r\r" +
                    "Quantity.......: " + validations.Quantity.ToString() + "\r\r\r" +
                    "Name...........: " + validations.Employee + "\n\r" +
                    "Contact eMail..: " + g.contactEmail + "\n\r" +
                    "Extension........: " + extension + "\r" +
                    "Project.........: " + g.project + "\r" +
                    "Rework Number...: " + reworkNumber + "\r" +
                    "Cost Center.....: " + validations.CostCenter + "\r\r" +
                    "Request Reason..: " + validations.Request_Reason + "\n\r" +
                    "Request Type....: " + validations.Request_Type + "\n\r" +
                    "Subcategory.....: " + validations.TypeSubcategory + "\n\r" +
                    "Part Number.....: " + validations.partnumber + "\n\r" +
                    "FAST Number.....: " + validations.FastNumber + "\n\r" +
                    "Production Number.: " + validations.ProductionNumber + "\n\r" +
                    "Request Comments..: " + g.requestComments + "\n\r" +
                    "Date of Submission: " + submitDate;

        cnxn = new SqlConnection(g.db);

        g.persist = cbPersist;

        SqlParameter pSubjectLine = new SqlParameter("@subject_line", SqlDbType.VarChar, 4000);
        pSubjectLine.Value = g.subjectLine;

        SqlParameter pName = new SqlParameter("@name", SqlDbType.VarChar, 100);
        pName.Value = validations.Employee;

        SqlParameter Request_Text = new SqlParameter("@request_text", SqlDbType.VarChar, 4000);
        Request_Text.Value = validations.Request;

        SqlParameter Phone = new SqlParameter("@Phone", SqlDbType.VarChar, 50);
        Phone.Value = extension;

        SqlParameter pCostCenter = new SqlParameter("@costcenter", SqlDbType.VarChar, 50);
        pCostCenter.Value = validations.CostCenter.Substring(0,4);

        SqlParameter pProject = new SqlParameter("@Project", SqlDbType.VarChar, 20);
        pProject.Value = g.project;

        SqlParameter pQuantity = new SqlParameter("@quantity", SqlDbType.Int);
        pQuantity.Value = validations.Quantity;

        SqlParameter pContactEmail = new SqlParameter("@ContactEmail", SqlDbType.VarChar, 50);
        pContactEmail.Value = g.contactEmail;

        SqlParameter pPriority = new SqlParameter("@priority", SqlDbType.VarChar, 25);
        pPriority.Value = validations.Priority;

        SqlParameter report = new SqlParameter("@report", SqlDbType.VarChar, 5000);
        report.Value = g.requestReport;

        SqlParameter response = new SqlParameter("@response", SqlDbType.VarChar, 5000);
        response.Value = g.requestResponse;

        SqlParameter pReworkNumber = new SqlParameter("@reworkNumber", SqlDbType.VarChar, 50);
        pReworkNumber.Value = reworkNumber;
                
        SqlParameter pPartNumber = new SqlParameter("@partnumber", SqlDbType.VarChar, 30);
        pPartNumber.Value = validations.partnumber;

        SqlParameter pFASTnumber = new SqlParameter("@fastNumber", SqlDbType.VarChar, 10);
        pFASTnumber.Value = validations.FastNumber;

        SqlParameter pProductionNumber = new SqlParameter("@productionNumber", SqlDbType.VarChar, 10);
        pProductionNumber.Value = validations.ProductionNumber;

        SqlParameter pRequestComments = new SqlParameter("@requestComments", SqlDbType.VarChar, 5000);
        pRequestComments.Value = g.requestComments;

        //SqlParameter pFocalSurface = new SqlParameter("@FocalSurface", SqlDbType.VarChar, 50);
        //pFocalSurface.Value = surface;




        /* defining the paramater as output to be able to get the id of the row from the data being input into the database  */

        SqlParameter pRequestID = new SqlParameter("@ID", SqlDbType.Int);
        pRequestID.Direction = ParameterDirection.Output;


        cnxn.Open();

        SqlCommand cmd = new SqlCommand("Insert into " + SqlTable + " (" +
                    " request_date " +
                    ",request_text " +
                    ",quantity " +
                    ",cost_center " +
                    ",project" +              //5
                    ",request_need_date " +
                    ",priority " +
                    ",requestor " +                        //10
                    ",requestor_phone " +
                    ",requestor_email " +
                    ",subject_line " +
                    ",request_response_email_body " +
                    ",request_report_email_body " +
                    ",rework_order_number " +
                    ",Request_Type " +
                    ",TimeSavingsEstimate " +
                    ",CostSavingsEstimate " +
                    ",RevenueSavingsEstimate " +
                    ",PartNumber " +
                    ",FAST_Number " +
                    ",Production_Number " +
                    ",TypeSubcategory " +
                    ",Request_Reason " +
                    ",Request_Comments " +
                    ") values (" +
                    "'" + DateTime.Now.Date +        //1
                    "'," + Request_Text +
                    "," + pQuantity +
                    "," + pCostCenter +
                    "," + pProject +
                    ",'" + validations.RequestedDate.ToShortDateString() +
                    "'," + pPriority +                                
                    "," + pName +
                    "," + Phone +
                    "," + pContactEmail +
                    "," + pSubjectLine +
                    "," + response +
                    "," + report +
                    "," + pReworkNumber +
                    ",'" + validations.Request_Type.ToString() +
                    "','" + validations.TimeSavings.ToString() +
                    "','" + validations.CostSavings.ToString() +
                    "','" + validations.RevenueSavings.ToString() +
                    "'," + pPartNumber +
                    "," + pFASTnumber +
                    "," + pProductionNumber +
                    ",'" + validations.TypeSubcategory.ToString() +
                    "','" + validations.Request_Reason.ToString() +
                    "'," + pRequestComments +
                    ") SET @ID = SCOPE_IDENTITY() ", cnxn);
        cmd.Parameters.Add(Request_Text);
        cmd.Parameters.Add(pQuantity);
        cmd.Parameters.Add(Phone);
        cmd.Parameters.Add(pContactEmail);
        cmd.Parameters.Add(pPriority);
        cmd.Parameters.Add(response);
        cmd.Parameters.Add(pSubjectLine);
        cmd.Parameters.Add(pName);
        cmd.Parameters.Add(report);
        cmd.Parameters.Add(pCostCenter);
        cmd.Parameters.Add(pProject);
        cmd.Parameters.Add(pReworkNumber);
        cmd.Parameters.Add(pPartNumber);
        cmd.Parameters.Add(pFASTnumber);
        cmd.Parameters.Add(pProductionNumber);
        cmd.Parameters.Add(pRequestComments);
        cmd.Parameters.Add(pRequestID);
        try
        {
            int rowsReturned = cmd.ExecuteNonQuery();
            g.requestID = (int)cmd.Parameters["@ID"].Value;
        }
        catch (SqlException ex)
        {
            pop.Title = "Error";
            pop.Message = ex.ToString();
            pop.ShowPopup();
            return;
        }
        finally
        {
            cnxn.Close();
        }

        cmd.Dispose();

        if (cbPersist)
        {
            g.costcenter = validations.CostCenter;
            g.priority = validations.Priority;
            g.request_text = validations.Request;
            g.requestor = validations.Employee;
            g.requestorPhone = extension;
            g.request_Type = validations.Request_Type;
            g.persist = cbPersist;
        }

        if (!cbPDF & !cbDXF)
        {
            uid = 0;

            NavMgr.NavigateTo("thankyou");
        }
        else if (cbPDF & !cbDXF)
        {
            g.filetypeSelected = "pdf";
            g.Ftwofiles = false;
            NavMgr.NavigateTo("uploadpdffiles");
        }
        else if (cbPDF & cbDXF)
        {
            g.Ftwofiles = true;
            g.Ftwofiles2BUploaded = true;
            g.filetypeSelected = "pdf";
            NavMgr.NavigateTo("uploadpdffiles");
        }
        else if (!cbPDF & cbDXF)
        {
            g.Ftwofiles = false;
            NavMgr.NavigateTo("uploaddxffiles");
        }


        /*  this clears the fields  */

        validations = new ValidationComponents();

    }


    public void EditContext_OnFieldChanged(object sender, FieldChangedEventArgs e)
    {
        if (e.FieldIdentifier.FieldName == "eIndex")
        {
            validations.Employee = dtEmployees.Rows[g.eIndex - 1][1].ToString();
            g.contactEmail = dtEmployees.Rows[g.eIndex - 1][2].ToString();
        }
    }
}