@inherits LayoutComponentBase
@inject AuthenticationStateProvider auth
@using Pages
<PageTitle>CoatingSheet</PageTitle>

<div class="popup-overlay @(pop.IsVisible ? "visible" : "")">
    <div class="popup-content">
        <h3>@pop.Title</h3>
        <p>@pop.Message</p>
    </div>
</div>

<div class="page">
    <main style="width: 100%">
        <div style="display:flex">
            <div class="top-row" style="width:100%">
                <NavMenu />
            </div>
        </div>
        <article class="content px-4" style="flex-direction:column">
            @if (hasAccess)
            {
                @Body
            }
            
        </article>
    </main>
    
    
</div>

@code{
    PopUp pop = new PopUp();
    public bool hasAccess = true;
}