<h3 style="display:flex;justify-content:center">Search</h3>

@*ERROR MESSAGE POPUP*@
<div class="popup-overlay @(pop.IsVisible ? "visible" : "")">
    <div class="popup-content">
        <h3>@pop.Title</h3>
        <p>@pop.Message</p>
        <button class="button-85"  @onclick="pop.ClosePopup">Close</button>
    </div>
</div>


<div style="display:flex;justify-content:center;width:100vw">
    <div>
        <label>Run #:</label> <br />
        <input type="text" list="runNumList" @bind=RunNum></input>
        <datalist id="runNumList">
            @foreach (string item in runList)
            {
                <option>@item</option>
            }
        </datalist>
    </div>
    <div>
        <label>Chamber:</label> <br />
        <input type="text" list="chamberList" @bind=Chamber></input>
        <datalist id="chamberList">
            @foreach (string item in chamberList)
            {
                <option>@item</option>
            }
        </datalist>
    </div>
    <div>
        <label>Coating Type:</label> <br />
        <input type="text" list="coatingList" @bind=CoatingType></input>
        <datalist id="coatingList">
            @foreach (string item in coatingList)
            {
                <option>@item</option>
            }
        </datalist>
    </div>
    <div>
        <label>Substrate:</label> <br />
        <input type="text" list="substrateList" @bind=Substrate></input>
        <datalist id="substrateList">
            @foreach (string item in substrateList)
            {
                <option>@item</option>
            }
        </datalist>
    </div>
    <div>
        <label>Materials:</label> <br />
        <input type="text" list="materialList" @bind=Materials></input>
        <datalist id="materialList">
            @foreach (string item in materialList)
            {
                <option>@item</option>
            }
        </datalist>
    </div>
</div>
<br>
<div style="display:flex;justify-content:center"><button @onclick="Query">Search</button><br /></div>
<br />
@if(dt != null)
{
    if(dt.Rows.Count > 0)
    {
        <Table isSearch=true dt="dt" TableStyle="generic-table search-table"></Table>
    }
}

@code {

    private string? RunNum;
    private string? Chamber;
    private string? CoatingType;
    private string? Substrate;
    private string? Materials;
    PopUp pop = new PopUp();
    DataTable dt;

    private List<string> runList = new List<string>();
    private List<string> chamberList = new List<string>();
    private List<string> coatingList = new List<string>();
    private List<string> substrateList = new List<string>();
    private List<string> materialList = new List<string>();

    protected override async Task OnInitializedAsync()
    {
        try
        {
            SqlConnection cnxn = new SqlConnection(Databases.ZTEST);

            //**Dropdown querys/

            //RUN NUMBER
            SqlCommand cmd = new SqlCommand(@"
            SELECT [RUN #] FROM CoatingSheet
            ", cnxn);

            await cnxn.OpenAsync();
            using (SqlDataReader dr = cmd.ExecuteReader())
            {
                while (dr.Read())
                {
                    runList.Add(dr.GetString(0));
                }
            }

            //CHAMBER
            cmd = new SqlCommand(@"
            SELECT [CHAMBER] FROM CoatingSheet
            ", cnxn);
            using (SqlDataReader dr = cmd.ExecuteReader())
            {
                while (dr.Read())
                {
                    chamberList.Add(dr.GetString(0));
                }
                chamberList = chamberList.Distinct().ToList();
            }

            cmd = new SqlCommand(@"
            SELECT [COATING TYPE] FROM CoatingSheet
            ", cnxn);
            using (SqlDataReader dr = cmd.ExecuteReader())
            {
                while (dr.Read())
                {
                    coatingList.Add(dr.GetString(0));
                }
                coatingList = coatingList.Distinct().ToList();
            }

            cmd = new SqlCommand(@"
            SELECT [SUBSTRATE] FROM CoatingSheet
            ", cnxn);
            using (SqlDataReader dr = cmd.ExecuteReader())
            {
                while (dr.Read())
                {
                    substrateList.Add(dr.GetString(0));
                }
                substrateList = substrateList.Distinct().ToList();
            }

            cmd = new SqlCommand(@"
            SELECT 
            [MATERIAL 1]
            ,[MATERIAL 2]
            ,[MATERIAL 3]
            ,[MATERIAL 4]
            FROM CoatingSheet
            ", cnxn);
            using (SqlDataReader dr = cmd.ExecuteReader())
            {
                while (dr.Read())
                {
                    materialList.Add(dr.GetString(0));
                    materialList.Add(dr.GetString(1));
                    materialList.Add(dr.GetString(2));
                    materialList.Add(dr.GetString(3));
                }
                materialList = materialList.Distinct().ToList();
            }
            await cnxn.CloseAsync();
        }catch(SqlException ex)
        {
            pop.Title = "Error";
            pop.Message = ex.ToString();
            pop.ShowPopup();
        }

        
    }

    private void Query()
    {
        SqlConnection cnxn = new SqlConnection(Databases.ZTEST);
        dt = new DataTable();
        SqlCommand cmd = new SqlCommand(@"SELECT
        [CHAMBER]
      ,[OPERATOR]
      ,[RUN #]
      ,[DATE]
      ,[COATING TYPE]
      ,[SUBSTRATE]
      ,[RUN TYPE]
      ,[PROCESS #]
      ,[CRYSTAL]
      ,[E-GUN KV]
      ,[VACUUM]
      ,[CAPACITY]
      ,[SUSTRATE TEMP]
      ,[FIXTURE SPEED]
      ,[CRYO 1 TEMP]
      ,[CRYO 2 TEMP]
      ,[START PUMP]
      ,[START HEAT]
      ,[START COAT]
      ,[FINISH COAT]
      ,[MATERIAL 1]
      ,[MATERIAL 1 RATE]
      ,[MATERIAL 2]
      ,[MATERIAL 2 RATE]
      ,[MATERIAL 3]
      ,[MATERIAL 3 RATE]
      ,[MATERIAL 4]
      ,[MATERIAL 4 RATE]
        FROM [ZTEST].[dbo].[CoatingSheet]
        WHERE [Run #] LIKE @RunNum AND
              [Chamber] LIKE @Chamber AND
              [COATING TYPE] LIKE @CoatingType AND
              [SUBSTRATE] LIKE @Substrate AND
              CONCAT([MATERIAL 1], [MATERIAL 2], [MATERIAL 3], [MATERIAL 4]) LIKE @Materials
        ", cnxn);

        cmd.Parameters.Add(new SqlParameter("@RunNum", "%" + RunNum + "%"));
        cmd.Parameters.Add(new SqlParameter("@Chamber", "%" + Chamber + "%"));
        cmd.Parameters.Add(new SqlParameter("@CoatingType", "%" + CoatingType + "%"));
        cmd.Parameters.Add(new SqlParameter("@Substrate", "%" + Substrate + "%"));
        cmd.Parameters.Add(new SqlParameter("@Materials", "%" + Materials + "%"));

        try
        {
            cnxn.Open();
            using (SqlDataReader dr = cmd.ExecuteReader())
            {
                dt.Load(dr);
            }
            cnxn.Close();
            if (dt.Rows.Count == 0)
            {
                pop.Title = "Error";
                pop.Message = "No items found";
                pop.ShowPopup();
            }
        }
        catch (SqlException ex)
        {
            pop.Title = "Error";
            pop.Message = ex.ToString();
            pop.ShowPopup();
        }
        StateHasChanged();
    }
}