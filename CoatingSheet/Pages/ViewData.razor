            else
            {
                color = "yellow";
            }
            FTIRLineConfig.Data.Datasets.Add(new LineDataset<string>(GetColumnValues(testRun.dt.Columns[1].ToString(), testRun.dt))
                {
                    ShowLine = true,
                    PointRadius = 0,
                    PointHoverRadius = 5,
                    PointHitRadius = 15,
                    Fill = false,

