        }
    }


    private string[] GetColumnValues(string columnName, DataTable data)
    {
        var array = data.AsEnumerable()
       .Select(row =>
       {
           object value = row[columnName];
           if (value is int intValue)
           {
               return intValue.ToString();
           }
           return value != null ? value.ToString() : null;
       })
       .ToArray();
        Array.Reverse(array);
        return array;
    }


    private void DeleteRunSheet()
    {
        SqlConnection cnxn = new SqlConnection(Databases.ZTEST);

        SqlCommand cmd = new SqlCommand(@"DELETE FROM CoatingSheet WHERE [RUN #] = @RunNum", cnxn);
        cmd.Parameters.Add(new SqlParameter("@RunNum", RunSheetID));

        try
        {
            cnxn.Open();
            cmd.ExecuteNonQuery();
            cnxn.Close();

        }catch (SqlException ex)
        {
            pop.Title = "Error";
            pop.Message = ex.ToString();
            pop.ShowPopup();
            return;
        }

        DeleteCary();
        DeletePE();
        DeleteFTIR();

        deletedPop.Title = "Success";
        deletedPop.Message = "Run #" + RunSheetID + " has been deleted from the database";
        deletedPop.ShowPopup();
        confirmPop.ClosePopup();
    }

    private void DeleteCary()
    {
        SqlConnection cnxn = new SqlConnection(Databases.ZTEST);

        SqlCommand cmd = new SqlCommand(@"DELETE FROM Cary7000 WHERE [Run #] = @RunNum", cnxn);
        cmd.Parameters.Add(new SqlParameter("@RunNum", RunSheetID));

        try
        {
            cnxn.Open();
            cmd.ExecuteNonQuery();
            cnxn.Close();

        }
        catch (SqlException ex)
        {
            pop.Title = "Error";
            pop.Message = ex.ToString();
            pop.ShowPopup();
            return;
        }

        deletedPop.Title = "Success";
        deletedPop.Message = "Spectral data has been deleted from the database";
        deletedPop.ShowPopup();
        confirmPop.ClosePopup();

    }

