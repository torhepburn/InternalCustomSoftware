    private void FTIRConfigureLineConfig()
    {
        FTIRLineConfig = new LineConfig();

        FTIRLineConfig.Options = new LineOptions
            {
                ResponsiveAnimationDuration = 0,

                Responsive = true,
                Title = new OptionsTitle
                {
                    Display = true,
                    Text = "PE983"
                }

            };


        Array xAxis = GetColumnValues(FTIRTests[0].dt.Columns[0].ToString(), FTIRTests[0].dt);
        //Array.Reverse(xAxis);


        foreach (string num in xAxis)
        {
