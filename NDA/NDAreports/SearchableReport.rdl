        </Field>
        <Field Name="Restricted">
          <DataField>Restricted</DataField>
          <rd:TypeName>System.Boolean</rd:TypeName>
        </Field>
        <Field Name="NDA_ID">
          <DataField>NDA_ID</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
      </Fields>
