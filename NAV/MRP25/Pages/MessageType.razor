@page "/messagetype"

<PageTitle>Message Type</PageTitle>

@using MRP25.Data

@inject Global g
@inject NavigationManager NavMgr

<h1>Select Message Type</h1>
<br />
<br />

<div class="container">
    <div class="row">

        <div class="col">

            <button class="btn btn-primary" @onclick="BNotCancel_Click">Non-Cancel Messages</button>

        </div>

        <div class="col">

            <button class="btn btn-primary" @onclick="BCancel_Click">Cancel Messages</button>

        </div>

    </div>

</div>


@code 
{
    private void BNotCancel_Click()
    {
        g.messageCancel = false;
        g.messageChoice = " not ";
        Nexxt();
    }

    private void BCancel_Click()
    {
        g.messageCancel = true;
        g.messageChoice = " ";
        Nexxt();
    }

    private void Nexxt()
    {
        NavMgr.NavigateTo("reports");
    }
}
