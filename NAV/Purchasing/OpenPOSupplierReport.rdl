          <rd:TypeName>System.Double</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
    <DataSet Name="SupplierNumber">
      <Query>
        <DataSourceName>AccessFrontEnds</DataSourceName>
        <CommandText>SELECT DISTINCT supplier FROM Shortages_Open_PO_Lines_Supplier UNION Select '' as supplier ORDER BY supplier</CommandText>
        <Timeout>1</Timeout>
      </Query>
      <Fields>
        <Field Name="supplier">
          <DataField>supplier</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
    <DataSet Name="SupplierName">
      <Query>
        <DataSourceName>AccessFrontEnds</DataSourceName>
        <CommandText>SELECT DISTINCT Supplier_Name from Shortages_Open_PO_Lines_Supplier UNION Select '' as supplier_name ORDER BY supplier_name</CommandText>
        <Timeout>1</Timeout>
      </Query>
      <Fields>
        <Field Name="Supplier_Name">
          <DataField>Supplier_Name</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
    <DataSet Name="ItemCode">
