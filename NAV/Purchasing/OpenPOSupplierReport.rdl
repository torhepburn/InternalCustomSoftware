<?xml version="1.0" encoding="utf-8"?>
<Report MustUnderstand="df" xmlns="http://schemas.microsoft.com/sqlserver/reporting/2016/01/reportdefinition" xmlns:rd="http://schemas.microsoft.com/SQLServer/reporting/reportdesigner" xmlns:df="http://schemas.microsoft.com/sqlserver/reporting/2016/01/reportdefinition/defaultfontfamily">
  <df:DefaultFontFamily>Segoe UI</df:DefaultFontFamily>
  <AutoRefresh>0</AutoRefresh>
  <DataSources>
    <DataSource Name="AccessFrontEnds">
      <DataSourceReference>AccessFrontEnds</DataSourceReference>
      <rd:SecurityType>None</rd:SecurityType>
      <rd:DataSourceID>e5c6aaf7-5e1a-4ec5-a891-34d053d72031</rd:DataSourceID>
    </DataSource>
  </DataSources>
  <DataSets>
    <DataSet Name="DataSet1">
      <Query>
        <DataSourceName>AccessFrontEnds</DataSourceName>
        <QueryParameters>
          <QueryParameter Name="@Supplier">
            <Value>=Parameters!Supplier.Value</Value>
          </QueryParameter>
          <QueryParameter Name="@Supplier_Name">
            <Value>=Parameters!Supplier_Name.Value</Value>
          </QueryParameter>
          <QueryParameter Name="@Item_Code">
            <Value>=Parameters!Item_Code.Value</Value>
          </QueryParameter>
          <QueryParameter Name="@MaximumDaysUntilDue">
            <Value>=Parameters!MaximumDaysUntilDue.Value</Value>
          </QueryParameter>
        </QueryParameters>
        <CommandText>SELECT * FROM Shortages_Open_PO_Lines_Supplier

WHERE

((Supplier = CAST(@Supplier as int)) or (@Supplier is Null))
AND
(Supplier_Name like '%' +  @Supplier_Name + '%' or @Supplier_Name is Null)
AND
(Item_Code = @Item_Code or @Item_Code is Null)
AND
POLineDaysTillDue &lt;= @MaximumDaysUntilDue

        
        
        </CommandText>
        <rd:UseGenericDesigner>true</rd:UseGenericDesigner>
      </Query>
      <Fields>
        <Field Name="SUPPLIER">
          <DataField>SUPPLIER</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Supplier_Name">
          <DataField>Supplier_Name</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="ITEM_CODE">
          <DataField>ITEM_CODE</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="ITEM_DESCRIPTION">
          <DataField>ITEM_DESCRIPTION</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="ORDER_NO">
          <DataField>ORDER_NO</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
        <Field Name="POSITION">
          <DataField>POSITION</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
        <Field Name="DELIVERY_DATE">
          <DataField>DELIVERY_DATE</DataField>
          <rd:TypeName>System.DateTime</rd:TypeName>
        </Field>
        <Field Name="CHANGED_DELIVERY_DATE">
          <DataField>CHANGED_DELIVERY_DATE</DataField>
          <rd:TypeName>System.DateTime</rd:TypeName>
        </Field>
        <Field Name="DELIVERY_DATE_CONFIRMED">
          <DataField>DELIVERY_DATE_CONFIRMED</DataField>
          <rd:TypeName>System.DateTime</rd:TypeName>
        </Field>
        <Field Name="POLineLateFlag">
          <DataField>POLineLateFlag</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="POLineDaysLate">
          <DataField>POLineDaysLate</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
        <Field Name="POLineDaysTillDue">
          <DataField>POLineDaysTillDue</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
        <Field Name="QUANTITY">
          <DataField>QUANTITY</DataField>
          <rd:TypeName>System.Double</rd:TypeName>
