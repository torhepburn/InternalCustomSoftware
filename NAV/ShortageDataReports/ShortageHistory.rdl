  <DataSets>
    <DataSet Name="DataSet1">
      <Query>
        <DataSourceName>AccessFrontEnds</DataSourceName>
        <CommandText>SELECT        ID, PRODUCTLINE, [GROUP], PROJECT, PROJECTDESC, ItemCode, Description, Comments, [Reason Code], [IQC Y_N], [Orig Date], [Req Date], DateAddedtoList, 
                         WhoAdded, Buyer, Qty, STKOUT, [Custom Item], PO, Supplier, DateChanged, DateArchived, WOaffected, FinalPNaffected, FASTNCMR, HMO, IN_HOUSE_AT_ZYGO, 
                         FlagField, QtyNeeded, SERVICELOG, CurrDueDate, ZP2, HOT, RECEIVED, ITEM_RECEIVED
FROM            Shortage_List
ORDER BY itemcode</CommandText>
      </Query>
