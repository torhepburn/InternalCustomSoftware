            <tr>
                <td align="right">
                    Quality Rating :
                    <InputText id="n10" style="width: 40px;" @bind-Value ="g.qualityRating" />
                </td>

               
            </tr>


            <tr>
                <td align="right">
                    OTD Rating :
                    <InputText id="n11" style="width: 40px;" @bind-Value ="g.otdRating" />
                </td>

                
            </tr>

            <tr>
                <td align="right">
                    Payment Terms :
                    <InputText id="n11" style="width: 40px;" @bind-Value ="g.otdRating" />
                </td>

                <td align="right">
                    Annul Spend Actual :
                    <InputText id="n2" style="width: 100px;" @bind-Value ="g.annualspendActual" />
                </td>

                
            </tr>

            

            <tr>
                <td align="right">
                    Location :
                    <InputText id="n12" placeholder="Location" @bind-Value="g.locationRegion" />
                </td>

                <td align="right">
                    Annul Spend Projected :
                    <InputText id="n2" style="width: 100px;" @bind-Value ="g.annualspendActual" />
                </td>

                

            </tr>


            <tr>
                
                <td align="right">
                    Number of Critical Parts :
                    <InputText id="n2" p @bind-Value="g.numberCriticalParts" />
                </td>
                <td align="right">
                    Cost Savings Status :
                    <InputText id="n2" p @bind-Value="g.costSavingsStatus" />
                </td>
            </tr>

            <tr>
                

                <td align="right">
                    % of Coverage :
                    <InputText id="n2"  @bind-Value="g.percentOfCoverage" />
                </td>

            </tr>

            <tr>
                
                
            </tr>

            <tr>
                <td align="right">
                    ZM-0027 Expiration Date :
                    <InputDate id="n2" @bind-Value="g.ZM0027ExpirationDate" />
                </td>
            </tr>

            <tr>
                <td align="right">
                    NDA Expiration Date :
                    <InputDate id="n2" @bind-Value="g.ndaExpirationDate" />
                </td>
            </tr>
            <tr>
                <td align="right">
                    ISO 9001 Expiration Date :
                    <InputDate id="n2" @bind-Value="g.ISO9001ExpirationDate" />
                </td>
            </tr>
            <tr>
                <td align="right">
                    ISO 13485 Expiration Date :
                    <InputDate id="n2" @bind-Value="g.ISO13485ExpirationDate" />
                </td>
            </tr>

            
            <tr>
                <td align="right">
                    Lead Time Range :
                    <InputText id="n2" @bind-Value="g.leadTimeRange" />
                </td>

                @* <td align="right">
                    Notes :
                    <InputText id="n2" @bind-Value="g.leadTimeRange" />
                </td> *@
            </tr>



        </tbody>
    </table>
    <br />
    @* 
    Description of Failure :
    <InputText id="a13" placeholder="Description of Failure" style="width: 100%; height: 200px" @bind-Value="failuredescription" />
     *@



</EditForm>

<br />
<button class="btn btn-primary" @onclick="DataEntry">Save Data</button>





@code {

    public string item = "";
    //public string commentEntered = "";
    PopUp pop = new PopUp();

    SqlCommand cmd;
    SqlConnection cnxn;
    SqlDataReader dr;
    DataTable dt;
    DataTable dtc;

    protected override void OnInitialized()
    {
        dt = new DataTable();

        cnxn = new SqlConnection(g.db);

        cmd = new SqlCommand(
        "SELECT " +
        " CAST(DateEntered as varchar(10))" +
        ",TRIM(Name) " +
        ",[Overall Supplier Rating] " +
        ",[Quality Rating] " +
        ",[OTD Rating] " +
        ",[Payment Terms] " +
        ",[Annual Spend Actual] " +
        ",[Annual Spend Projected] " +
        ",[Location/Region] " +
        ",COALESCE([Commodity 1],' ') " +
        ",COALESCE([Commodity 2],' ') " +
        ",TRIM([Vendor Title])  " +
        ",CAST(SupplierNo as nchar(30)) " +
        ",TRIM([Purchaser Code])  " +
        ",[NDA Expiration Date] " +
        ",[ISO 9001 Exp Date] " +
        ",[ISO 13485 Exp Date] " +
        ",[AS9100 Exp Date] " +
        ",[Alternate Suppliers] " +
        ",[Parent Company Name] " +
        ",[Parent Company Location] " +
        ",[Headquarters Location] " +
        ",[Factory Locations] " +
        ",[Technology (Expertise)] " +
        ",[Number of Critical Parts] " +
        ",[Strategy] " +
        ",[Key Actions/Current Issues] " +
        ",[Cost Savings Plan] " +
        ",[Cost Savings Status] " +
        ",[Business Alignment] " +
        ",[Contracts Type] " +
        ",[Per Cent of Coverage] " +
        ",[Type Status] " +
        ",[Line of Business] " +
        ",[Payment Terms Plan] " +
        ",[Lead Time Plan] " +
        ",[Lead Time Range] " +
        ",[Notes] " +
        " from [SupplierData] " +
         "where " +
         "supplierNo = '" + g.supplierNo + "' ", cnxn);


        try
        {
            cnxn.Open();
            dr = cmd.ExecuteReader();

            dt.Load(dr);

            dr = cmd.ExecuteReader();

            while (dr.Read())
            {
                try
                {
                    //g.enteredOn = dr.GetString(0);
                    g.supplierName = dr.GetString(1);
                    g.supplierRating = dr.GetString(2).Trim();
                    g.qualityRating = dr.GetString(3).Trim();
                    g.otdRating = dr.GetString(4).Trim();
                    g.paymentTerms = dr.GetString(5).Trim();
                    g.annualspendActual = dr.GetInt32(6).ToString().Trim();
                    g.annualspendProjected = dr.GetInt32(7).ToString().Trim();
                    g.locationRegion = dr.GetString(8).Trim();
                    g.commodity1 = dr.GetString(9).Trim();
                    g.commodity2 = dr.GetString(10).Trim();
                    g.vendorTitle = dr.GetString(11).Trim();
                    g.supplierNo = dr.GetString(12).Trim();
                    g.buyer = dr.GetString(13).Trim();
                    if (!dr.IsDBNull(14))
                    {
                        g.ndaExpirationDate = dr.GetFieldValue<DateOnly>(14);
                    }
                    if (!dr.IsDBNull(15))
                    {
                        g.ISO9001ExpirationDate = dr.GetFieldValue<DateOnly>(15);
                    }
                    if (!dr.IsDBNull(16))
                    {
                        g.ISO13485ExpirationDate = dr.GetFieldValue<DateOnly>(16);
                    }
                    if (!dr.IsDBNull(17))
                    {
                        g.AS9100ExpirationDate = dr.GetFieldValue<DateOnly>(17);
                    }
                    if (!dr.IsDBNull(18))
                    {
                        g.alternateSuppliers = dr.GetString(18).Trim();
                    }
                    if (!dr.IsDBNull(19))
                    {
                        g.parentCompanyName = dr.GetString(19).Trim();
                    }
                    if (!dr.IsDBNull(20))
                    {
                        g.parentCompanyLocation = dr.GetString(20).Trim();
                    }
                    if (!dr.IsDBNull(21))
                    {
                        g.headquartersLocation = dr.GetString(21).Trim();
                    }
                    if (!dr.IsDBNull(22))
                    {
                        g.factoryLocations = dr.GetString(22).Trim();
                    }
                    if (!dr.IsDBNull(23))
                    {
                        g.technology = dr.GetString(23).Trim();
                    }
                    if (!dr.IsDBNull(24))
                    {
                        g.numberCriticalParts = dr.GetInt32(24).ToString().Trim();
                    }
                    if (!dr.IsDBNull(25))
                    {
                        g.strategy = dr.GetString(25).Trim();
                    }
                    if (!dr.IsDBNull(26))
                    {
                        g.keyIssues = dr.GetString(26).Trim();
                    }
                    if (!dr.IsDBNull(27))
                    {
                        g.costSavingsPlan = dr.GetString(27).Trim();
                    }
                    if (!dr.IsDBNull(28))
                    {
                        g.costSavingsStatus = dr.GetString(28).Trim();
                    }
                    if (!dr.IsDBNull(29))
                    {
                        g.businessAlignment = dr.GetString(29).Trim();
                    }
                    if (!dr.IsDBNull(30))
                    {
                        g.contractsType = dr.GetString(30).Trim();
                    }
                    if (!dr.IsDBNull(31))
                    { 
                        g.percentOfCoverage = dr.GetString(31).Trim();
                    }
                    if (!dr.IsDBNull(32))
                    {
                        g.typeStatus = dr.GetString(32).Trim();
                    }
                    if (!dr.IsDBNull(33))
                    {
                        g.lineofBusiness = dr.GetString(33).Trim();
                    }
                    if (!dr.IsDBNull(34))
                    {
                        g.paymentTermsPlan = dr.GetString(34).Trim();
                    }
                    if (!dr.IsDBNull(35))
                    {
                        g.leadTimePlan = dr.GetString(35).Trim();
                    }
                    if (!dr.IsDBNull(36))
                    {
                        g.leadTimeRange = dr.GetString(36).Trim();
                    }
                    if (!dr.IsDBNull(37))
                    {
                        g.notes = dr.GetString(37).Trim();
                    }
                }
                catch (Exception ex)
                {
                    pop.Title = "Error";
                    pop.Message = ex.ToString();
                    pop.ShowPopup();

                }
            }

            //dt.Load(dr);
        }
        catch (SqlException ex)
        {
            pop.Title = "Error";
            pop.Message = ex.ToString();
            pop.ShowPopup();
        }
        finally
        {
            cnxn.Close();

        }

        //NavMgr.NavigateTo("editData - copy");

    }

    public void DataEntry()
    {
        if (g.permission.Trim() == "EDIT" & g.permissionvalue.Trim() == "TRUE")
        {

            string sql = "";

            cnxn = new SqlConnection(g.db);

            sql = "SupplierNo = '" + g.supplierNo.Trim() + "' ";

            if (g.paymentTermsPlan is not null)
            {
                sql += " ,[Payment Terms Plan] ='" + g.paymentTermsPlan.Trim() + "' ";
            }


            if (g.parentCompanyName is not null)
            {
                sql += ",[Parent Company Name] ='" + g.parentCompanyName.Trim() + "' ";
            }

            if (g.parentCompanyLocation is not null)
            {
                sql += ",[Parent Company Location] ='" + g.parentCompanyLocation.Trim() + "' ";
            }

            if (g.headquartersLocation is not null)
            {
                sql += ",[Headquarters Location] ='" + g.headquartersLocation.Trim() + "' ";
            }

            if (g.factoryLocations is not null)
            {
                sql += ",[Factory Locations] ='" + g.factoryLocations.Trim() + "' ";
            }

            if (g.technology is not null)
            {
                sql += ",[Technology (Expertise)] ='" + g.technology.Trim() + "' ";
            }

            if (g.costSavingsPlan is not null)
            {
                sql += ",[Cost Savings Plan] ='" + g.costSavingsPlan.Trim() + "' ";
            }

            if (g.costSavingsStatus is not null)
            {
                sql += ",[Cost Savings Status] ='" + g.costSavingsStatus.Trim() + "' ";
            }

            if (g.keyIssues is not null)
            {
                sql += ",[Key Actions/Current Issues] ='" + g.keyIssues.Trim() + "' ";
            }

            if (g.leadTimePlan is not null)
            {
                sql += ",[Lead Time Plan] ='" + g.leadTimePlan.Trim() + "' ";
            }

            if (g.notes is not null)
            {
                sql += ",[Notes] ='" + g.notes.Trim() + "' ";
            }

            if (g.ndaExpirationDate is not null)
            {
                sql += ",[NDA Expiration Date] ='" + g.ndaExpirationDate + "' ";
            }

            if (g.ISO9001ExpirationDate is not null)
            {
                sql += ",[ISO 9001 Exp Date] ='" + g.ISO9001ExpirationDate + "' ";
            }

            if (g.ISO13485ExpirationDate is not null)
            {
                sql += ",[ISO 13485 Exp Date] ='" + g.ISO13485ExpirationDate + "' ";
            }

            if (g.AS9100ExpirationDate is not null)
            {
                sql += ",[AS9100 Exp Date] ='" + g.AS9100ExpirationDate + "' ";
            }

            if (g.alternateSuppliers is not null)
            {
                sql += ",[alternate suppliers] ='" + g.alternateSuppliers + "' ";
            }
            /*
            if (g.annualspendActual is not null)
            {
                sql += ",[Annual Spend Actual] =" + g.annualspendActual + " ";
                }

            if (g.annualspendProjected is not null)
            {
                sql += ",[Annual Spend Projected] =" + g.annualspendProjected + " ";
                }
            */
            
           cmd = new("UPDATE SupplierDataBank SET " + sql +
                     "WHERE SupplierNo = '" + g.supplierNo.Trim() + "' ", cnxn);


            try
            {
                cnxn.Open();
                cmd.ExecuteNonQuery();
            }
            catch (SqlException ex)
            {
                ex.ToString();
            }
            finally
            {
                cnxn.Close();
            }
            
            g.paymentTermsPlan = string.Empty;
            g.parentCompanyName = string.Empty;
            g.parentCompanyLocation = string.Empty;
            g.headquartersLocation = string.Empty;
            g.factoryLocations = string.Empty;
            g.technology = string.Empty;
            g.costSavingsPlan = string.Empty;
            g.costSavingsStatus = string.Empty;
            g.keyIssues = string.Empty;
            g.leadTimePlan = string.Empty;
            g.notes = string.Empty;
            g.ndaExpirationDate = null;
            g.ISO9001ExpirationDate = null;
            g.ISO13485ExpirationDate = null;
            g.AS9100ExpirationDate = null;
            g.alternateSuppliers = string.Empty;
            //g.supplierNo = string.Empty;
            
        }

        NavMgr.NavigateTo("home");
    }

}