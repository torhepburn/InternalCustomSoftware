@page "/editdata"
@rendermode @(new InteractiveServerRenderMode(prerender: false))

<PageTitle>Edit Data</PageTitle>

@using System.Data
@using Microsoft.Data.SqlClient
@using static PopUp

@inject Global g
@inject NavigationManager NavMgr

<h1>Edit Data</h1>

<div class="popup-overlay @(pop.IsVisible ? "visible" : "")">
    <div class="popup-content">
        <h3>@pop.Title</h3>
        <p>@pop.Message</p>
        <button class="button-85" @onclick="pop.ClosePopup">Close</button>
    </div>
</div>


<div class="container-lg">
    <!-- Table 1: Light Blue -->
    <div class="table-container mb-4 p-3" style="background-color: #d1ecf1; border-radius: 5px;">
        <table class="table table-bordered" >
            <thead>
                <tr>
                    <th width="30%">Supplier Name : @g.supplierName</th>
                    <th width="30%">Supplier No : @g.supplierNo</th>
                    <th width="30%">Buyer : @g.buyer</th>
                </tr>
            </thead>
            <tbody>

                <tr>
                    <td>Commodity 1 : @g.commodity1</td>
                    <td>Vendor Title : @g.vendorTitle</td>
                    <td></td>
                </tr>

                <tr>
                    <td>Commodity 2 : @g.commodity2</td>
                    
                    <td></td>
                   
                    <td></td>
                </tr>

            </tbody>
        </table>
    </div>

</div>
   <br>

<EditDataTextFields>


</EditDataTextFields>
<br />

<EditForm Model="item" OnValidSubmit="DataEntry">
    <DataAnnotationsValidator />
    <ValidationSummary />
    <table cellpadding="10px">
