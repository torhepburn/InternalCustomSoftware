                    <InputText id="n91" style="width: 500px; height:100px" @bind-Value="g.technology" />
                </td>
                
                <td align="right">
                    Payment Terms Plan :
                    <InputText id="n91" style="width: 500px; height:100px" @bind-Value="g.paymentTermsPlan" />
                </td>
                
            </tr>

            <tr>
                <td align="right">
                    Cost Savings Plan :
                    <InputText id="n91" style="width: 500px; height:100px" @bind-Value="g.costSavingsPlan" />
                </td>
                
                <td align="right">
                    Notes :
                    <InputText id="n91" style="width: 500px; height:100px" @bind-Value="g.notes" />
                </td>
                
            </tr>

            <tr>
                <td align="right">
                    Strategy :
                    <InputText id="n91" style="width: 500px; height:100px" @bind-Value="g.strategy" />
                </td>
                
                <td align="right">
                    Key Actions/Current Issues :
                    <InputText id="n91" style="width: 500px; height:100px" @bind-Value="g.keyIssues" />
