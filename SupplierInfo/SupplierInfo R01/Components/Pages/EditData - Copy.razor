@page "/editdata - copy"


<h3>Colored Tables Page</h3>

<div class="container mt-4">
    <!-- Table 1: Light Blue -->
    <div class="table-container mb-4 p-3" style="background-color: #d1ecf1; border-radius: 5px;">
        <h5>Table 1: Information</h5>
        <table class="table table-bordered">
            <thead>
                <tr><th>ID</th><th>Name</th></tr>
            </thead>
            <tbody>
                <tr><td>1</td><td>Sample A</td></tr>
                <tr><td>2</td><td>Sample B</td></tr>
            </tbody>
        </table>
    </div>

    <!-- Table 2: Light Green -->
    <div class="table-container mb-4 p-3" style="background-color: #d4edda; border-radius: 5px;">
        <h5>Table 2: Data</h5>
        <table class="table table-bordered">
            <thead>
                <tr><th>ID</th><th>Value</th></tr>
            </thead>
            <tbody>
                <tr><td>3</td><td>Sample C</td></tr>
                <tr><td>4</td><td>Sample D</td></tr>
            </tbody>
        </table>
    </div>

    <!-- Table 3: Light Yellow -->
    <div class="table-container mb-4 p-3" style="background-color: #fff3cd; border-radius: 5px;">
        <h5>Table 3: Results</h5>
        <table class="table table-bordered">
            <thead>
                <tr><th>ID</th><th>Result</th></tr>
            </thead>
            <tbody>
                <tr><td>5</td><td>Sample E</td></tr>
                <tr><td>6</td><td>Sample F</td></tr>
            </tbody>
        </table>
    </div>
</div>
