@page "/"
@page "/home"
@rendermode InteractiveServer

@using System.Data
@using Microsoft.Data.SqlClient
@using Microsoft.AspNetCore.Components.Authorization
@using static PopUp

@inject Global g
@inject NavigationManager NavMgr
@inject AuthenticationStateProvider auth


<div class="popup-overlay @(pop.IsVisible ? "visible" : "")">
    <div class="popup-content">
        <h3>@pop.Title</h3>
        <p>@pop.Message</p>
        <button class="button-85" @onclick="pop.ClosePopup">Close</button>
    </div>
</div>


 
 <div style="display:flex; gap:20px; justify-content:left"> 
    
    @* while the content looks to be right justified, it is actually centered in the whole container defined by the width of the table *@
    
    Filters
     <select @bind=@selectedRegion>
        <option value="">Select Location/Region</option>
        @foreach (System.Data.DataRow r in dtLocationRegion.Rows)
        {
            <option value="@r[0].ToString()">@r[0].ToString()</option>
        }
    </select>
 
     <select @bind=@selectedCommodity>
        <option value="">Select Commodity</option>
        @foreach (System.Data.DataRow r in dtCommodity.Rows)
        {
            <option value="@r[0].ToString()">@r[0].ToString()</option>
        }
    </select> 

     <select @bind=@selectedVendorTitle>
         <option value="">Select Vendor Title</option>
        @foreach (System.Data.DataRow r in dtVendorTitle.Rows)
        {
            <option value="@r[0].ToString()">@r[0].ToString()</option>
        }
    </select>  

    @* <select @bind=@selectedCommodity>
        <option value="">Select Cost Center</option>
         @foreach (System.Data.DataRow r in dtCostCenters.Rows)
        {
            <option value="@r[0].ToString()">@r[0].ToString()</option>
        } 
    </select> 
 *@
    <select @bind=@selectedBuyer>
        <option value="">Select Buyer</option>
