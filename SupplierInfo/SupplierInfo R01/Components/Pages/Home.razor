    public string selectedRegion = "";
    public string selectedVendorTitle = "";
    public string selectedBuyer = "";
    public string selectedRequestor = "";
    public string selectedCommodity = "";
    public string selection = "";
    private string? user;



    SqlCommand cmd;
    SqlConnection cnxn;
    SqlDataReader dr;
    DataTable dt;

    DataTable? dtLocationRegion;
    DataTable? dtVendorTitle;
    DataTable? dtBuyer;
    DataTable? dtCommodity;

    PopUp pop = new PopUp();


    protected override async Task OnInitializedAsync()
    {
        
        SqlConnection cnxn = new SqlConnection(g.db);
        DataTable dt = new DataTable();
        SqlCommand cmd = new SqlCommand(" Select UserName, permission, permissionValue from applicationsetup " +
        "WHERE Application = 'SupplierInfo'", cnxn);
        try
        {
            cnxn.Open();
            using (SqlDataReader dr = cmd.ExecuteReader())
            {
                dt.Load(dr);
                }
            cnxn.Close();
            user = auth.GetAuthenticationStateAsync().Result.User.Identity.Name;
            if (user.StartsWith("Z"))
            {
                user = user.Replace("ZYGOMIS\\", "");
                }
            else
            {
                user = user.Replace("AMETEK-AD\\", "");
                }

            foreach (DataRow row in dt.Rows)
            {
                if (row[0].ToString().ToUpper().Trim().Equals(user.ToUpper()))
                {
                    g.permission = row[1].ToString().ToUpper();
                    g.permissionvalue = row[2].ToString().ToUpper();
                    GetAsyncData();
                    }
                }
            }
        catch(SqlException ex)
        {

            }
        

                    await Task.Run(() => { _ = GetAsyncData(); });
    }

    private async Task GetAsyncData()
    {
        // Location Region

        dtLocationRegion = new DataTable();

        cnxn = new SqlConnection(g.dbNAV);

        cmd = new SqlCommand
            ("select Code + ' : ' + Name from [ZYGO$Country_Region] " +
             "order by Code", cnxn);
        try
        {
            cnxn.Open();
            dr = cmd.ExecuteReader();

            dtLocationRegion.Load(dr);
        }
        catch (SqlException ex)
        {
            ex.ToString();
        }
        finally
        {
            cnxn.Close();
        }
        
        // Vendor Title

        dtVendorTitle = new DataTable();

        cnxn = new SqlConnection(g.db);

        cmd = new SqlCommand
            ("select Distinct [Vendor Title] from SupplierData_s1 " +
             "order by [vendor title]", cnxn);
        try
        {
            cnxn.Open();
            dr = cmd.ExecuteReader();

            dtVendorTitle.Load(dr);
        }
        catch (SqlException ex)
        {
            ex.ToString();
        }
        finally
        {
            cnxn.Close();
        }

        // Commodity

        dtCommodity = new DataTable();

        cnxn = new SqlConnection(g.db);

        cmd = new SqlCommand
            ("select distinct [Commodity 1] FROM SupplierData_s1 " +
             "WHERE LEN([Commodity 1]) > 0 " +
             "order by [Commodity 1] ", cnxn);

        try
        {
            cnxn.Open();
            dr = cmd.ExecuteReader();

            dtCommodity.Load(dr);
        }
        catch (SqlException ex)
        {
            ex.ToString();
        }
        finally
        {
            cnxn.Close();
        }

        //buyer

        dtBuyer = new System.Data.DataTable();

        cnxn = new SqlConnection(g.db);

        cmd = new SqlCommand(
            "SELECT Code [Name] from [BuyerPlannerData] " +
            "ORDER BY Code", cnxn);

        try
        {
            cnxn.Open();
            dr = cmd.ExecuteReader();
            dtBuyer.Load(dr);
        }
        catch (SqlException ex)
        {
            ex.ToString();
        }
        finally
        {
            cnxn.Close();
        }
                
        GridData();

        await Task.Delay(15000);
    }

    
    private void Select(string SupplierNo)
    {
        g.supplierNo = SupplierNo;
        
        NavMgr.NavigateTo("editData");
        //NavMgr.NavigateTo("editDataTextFields");
    }

    private void selectFilter()
    {
         selection = string.Empty;

        if (selectedRegion.Length > 0)
        {
            selection += " and [Location/Region] = '" + selectedRegion.Substring(0,3) + "' ";
        }

        if (selectedCommodity.Length > 0)
        {
            selection += " and [Commodity 1] = '" + selectedCommodity + "' ";
        }

        if (selectedBuyer.Length > 0)
        {
            selection += " and [purchaser code] = '" + selectedBuyer + "' ";
        }

        if (selectedVendorTitle.Length > 0)
        {
            selection += " and [vendor title] = '" + selectedVendorTitle + "' ";
        }

       
         GridData();
    }

    private void GridData()
    {
        dt = new DataTable();

        cnxn = new SqlConnection(g.db);

        cmd = new SqlCommand(
         
                "SELECT " +
                "TRIM([Name]) Supplier " +  //0
                ",TRIM([SupplierNo]) [SupplierNo] " +          //1
                ",TRIM([Overall Supplier Rating]) [Overall Supplier Rating] " + //2
                ",TRIM([Quality Rating]) [Quality Rating] " +   //3
                ",TRIM([OTD Rating]) [OTD Rating] " +   //4
                ",TRIM([Payment Terms]) [Payment Terms] " + //5
                ",[Annual Spend Actual] [Annual Spend Actual] " +   //6
                ",[Annual Spend Projected] [Annual Spend Projected] " + //7
                ",TRIM([Location/Region]) [Location / Region] " + //8
                ",TRIM([Commodity 1]) " + //9
                ",TRIM([Vendor Title]) [Vendor Title] " +      //10
                ",TRIM([Purchaser Code]) [Purchaser Code] " +   //11
                ",[DateEntered] [DateEntered] " +   //12
                ",TRIM([Notes]) [Notes] " + //13
                " FROM SupplierData " +
                "where 1=1 " +
                selection +
                " ORDER BY Name "
         , cnxn);

        try
        {
            cnxn.Open();
            dr = cmd.ExecuteReader();

            dt.Load(dr);
        }
        catch (SqlException ex)
        {
            ex.ToString();
        }
        finally
        {
            cnxn.Close();
        }
    }


}

