<Window x:Class="WpfSquare.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="MainWindow" Height="450" Width="700">
    <Grid>
        <Canvas
            x:Name="cvs"
            Background="LightBlue"
            >
            <Line
                X1="100" Y1="10"
                X2="100" Y2="400"
                Stroke=" Black"
                StrokeThickness="2" />
            <Line
                X1="200" Y1="10"
                X2="200" Y2="400"
                Stroke=" Black"
                StrokeThickness="2" />
            <Line
                X1="300" Y1="10"
                X2="300" Y2="400"
                Stroke=" Black"
                StrokeThickness="2" />
            <Line
                X1="400" Y1="10"
                X2="400" Y2="400"
                Stroke=" Black"
                StrokeThickness="2" />
            <Line
                X1="500" Y1="10"
                X2="500" Y2="400"
                Stroke=" Black"
                StrokeThickness="2" />
            <Line
                X1="600" Y1="10"
                X2="600" Y2="400"
                Stroke=" Black"
                StrokeThickness="2" />


            <Rectangle 
                Name="R42 " 
                Canvas.Right="50" 
                Canvas.Top="40"
                Width="300"
                Height="100"
                Fill="Green"
                MouseLeftButtonDown="s_MouseLeftButtonDown"
                MouseLeftButtonUp="s_MouseLeftButtonUp"
                MouseMove="s_MouseMove"
                AllowDrop="True"
                Drop="R42_Drop" RenderTransformOrigin="0.5,0.5" Canvas.Left="299"
                >
                <Rectangle.RenderTransform>
                    <TransformGroup>
                        <ScaleTransform/>
                        <SkewTransform/>
                        <RotateTransform Angle="-0.191"/>
                        <TranslateTransform/>
                    </TransformGroup>
                </Rectangle.RenderTransform>
            </Rectangle>
            <Rectangle 
                Name="sq1" 
                Canvas.Left="50" 
                Canvas.Top="50"
                Width="50"
                Height="50"
                Fill="#FF0000FF" 
                MouseLeftButtonDown="s_MouseLeftButtonDown"
                MouseLeftButtonUp="s_MouseLeftButtonUp"
                MouseMove="s_MouseMove"
                
                />

        </Canvas>
    </Grid>
</Window>
