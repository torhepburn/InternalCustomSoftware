  <DataSets>
    <DataSet Name="DataSet1">
      <Query>
        <DataSourceName>AccessFrontEnds</DataSourceName>
        <QueryParameters>
          <QueryParameter Name="@Planner">
            <Value>=Parameters!Planner.Value</Value>
          </QueryParameter>
        </QueryParameters>
        <CommandText>select 

  Planner
, PlannedDate
, SupplierAcknowledgedDate
, SUPPLIER
, SupplierName
, ORDER_NO
, POS
, PRICE
, ITEM_CODE
, ITEM_DESCRIPTION
, Price
, Qty
, ORDER_DATE
, [2BDelivered]
, [OpenPOValue]
, ShipsTo
, TEXT
, DeliversTo

FROM PoPastDue

WHERE Planner IN (@Planner)

order by Planner, PlannedDate</CommandText>
        <rd:UseGenericDesigner>true</rd:UseGenericDesigner>
      </Query>
      <Fields>
        <Field Name="Planner">
          <DataField>Planner</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
