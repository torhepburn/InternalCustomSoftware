  <AutoRefresh>0</AutoRefresh>
  <DataSources>
    <DataSource Name="AccessFrontEndsSales">
      <ConnectionProperties>
        <DataProvider>SQL</DataProvider>
        <ConnectString>Server = MIDSQL01; user = ReadWrite; password = Read+Write!; database = AccessFrontEnds;</ConnectString>
      </ConnectionProperties>
      <rd:SecurityType>None</rd:SecurityType>
      <rd:DataSourceID>15cc69f9-d495-4868-8dc3-c222aa7d98a7</rd:DataSourceID>
    </DataSource>
  </DataSources>
  <DataSets>
    <DataSet Name="DataSet1">
      <Query>
        <DataSourceName>AccessFrontEndsSales</DataSourceName>
        <CommandText>SELECT        o.ORDER_NO, o.ORDER_DATE, c.NAME
FROM            MMX_SALES_ORDERS AS o INNER JOIN
                         MMX_CUSTOMERS AS c ON o.CUSTOMER = c.CUSTOMER
WHERE        (c.NAME LIKE 'canon%') AND (o.ORDER_DATE &gt; '2014-12-31')</CommandText>
      </Query>
      <Fields>
        <Field Name="ORDER_NO">
          <DataField>ORDER_NO</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
        <Field Name="ORDER_DATE">
          <DataField>ORDER_DATE</DataField>
          <rd:TypeName>System.DateTime</rd:TypeName>
        </Field>
        <Field Name="NAME">
          <DataField>NAME</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
  </DataSets>
  <rd:ReportUnitType>Inch</rd:ReportUnitType>
  <rd:ReportID>85ab1090-a96f-43d6-a235-fd3f5b3c021c</rd:ReportID>
