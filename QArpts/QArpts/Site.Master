<%@ Master Language="C#" AutoEventWireup="true" CodeBehind="Site.master.cs" Inherits="QArpts.SiteMaster" %>

<!DOCTYPE html PUBLIC "-//W3C//DTD XHTML 1.0 Strict//EN" "http://www.w3.org/TR/xhtml1/DTD/xhtml1-strict.dtd">
<html xmlns="http://www.w3.org/1999/xhtml" xml:lang="en">
<head runat="server">
    <title></title>
    <link href="~/Styles/Site.css" rel="stylesheet" type="text/css" />
    <asp:ContentPlaceHolder ID="HeadContent" runat="server">
    </asp:ContentPlaceHolder>
</head>
<body>
    <form runat="server">
    <div class="page">
        <div class="header">
            <div class="title">
                <h1>
                    Quality Storyboard Middlefield&nbsp;
                </h1>
            </div>
            <div class="loginDisplay">
            </div>
            <div class="clear hideSkiplink">
                <asp:Menu ID="NavigationMenu" runat="server" CssClass="menu" EnableViewState="false" IncludeStyleBlock="false" Orientation="Horizontal">
                    <Items>
                        <asp:MenuItem NavigateUrl="~/About.aspx" Text="About Lean" Value="About Lean"/>
                        <asp:MenuItem Text="Inspection Backlog" Value="Inspection Backlog">
                        </asp:MenuItem>
                        <asp:MenuItem Text="FQC Turnbacks" Value="FQC Turnbacks"></asp:MenuItem>
                        <asp:MenuItem Text="DTC" Value="DTC"></asp:MenuItem>
                        <asp:MenuItem Text="Quality Escapes" Value="Quality Escapes"></asp:MenuItem>
                        <asp:MenuItem Text="MRB A3 Charts" Value="MRB A3 Charts"></asp:MenuItem>
                        <asp:MenuItem Text="Cost of Quality" Value="Cost of Quality"></asp:MenuItem>
                        <asp:MenuItem Text="Customer Feedback" Value="Customer Feedback"></asp:MenuItem>
                        <asp:MenuItem Text="Calibration" Value="Calibration"></asp:MenuItem>
                        <asp:MenuItem Text="RCCA Age" Value="RCCA Age"></asp:MenuItem>
                        <asp:MenuItem Text="Incident Info" Value="Incident Info"></asp:MenuItem>
                        <asp:MenuItem NavigateUrl="~/About.aspx" Text="Time Parts Spend in QC" 
                            Value="Time Parts Spend in QC">
                            <asp:MenuItem NavigateUrl="~/TIQCnumbers30days.aspx" Text="Gross Numbers Past 30 Days" 
                                Value="New Item"></asp:MenuItem>
                            <asp:MenuItem NavigateUrl="~/QCTrend.aspx" Text="Two Year Trend Data" 
                                Value="New Item"></asp:MenuItem>
                            <asp:MenuItem NavigateUrl="~/AverageQCpast30.aspx" Text="Average Past 30 Days" 
                                Value="Average Past 30 Days"></asp:MenuItem>
                            <asp:MenuItem Text="Top 20 Items Past 30 Days" 
                                Value="Top 20 Items Past 30 Days" NavigateUrl="~/Top20Past30Days.aspx"></asp:MenuItem>
                        </asp:MenuItem>
                    </Items>
                </asp:Menu>
            </div>
        </div>
        <div class="main">
            <asp:ContentPlaceHolder ID="MainContent" runat="server"/>
        </div>
        <div class="clear">
        </div>
    </div>
    <div class="footer">
        
    </div>
    </form>
</body>
</html>
