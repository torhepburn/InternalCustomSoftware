        <local:AccessFrontEndsDataSet x:Key="accessFrontEndsDataSet"/>
        <CollectionViewSource x:Key="zygoCannonMappingsViewSource" Source="{Binding ZygoCannonMappings, Source={StaticResource accessFrontEndsDataSet}}"/>
    </Window.Resources>
    <Grid DataContext="{StaticResource zygoCannonMappingsViewSource}">
