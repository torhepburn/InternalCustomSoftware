          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="PL_DEL">
          <DataField>PL DEL</DataField>
          <rd:TypeName>System.DateTime</rd:TypeName>
        </Field>
        <Field Name="RQST_DEL">
          <DataField>RQST DEL</DataField>
          <rd:TypeName>System.DateTime</rd:TypeName>
        </Field>
        <Field Name="LINE_AMT">
          <DataField>LINE AMT</DataField>
          <rd:TypeName>System.Decimal</rd:TypeName>
        </Field>
        <Field Name="ORD_AMT">
          <DataField>ORD AMT</DataField>
          <rd:TypeName>System.Decimal</rd:TypeName>
        </Field>
        <Field Name="SHIP">
          <DataField>SHIP</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="GVT_RATED">
          <DataField>GVT RATED</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
      </Fields>
