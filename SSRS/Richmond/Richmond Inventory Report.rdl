<?xml version="1.0" encoding="utf-8"?>
<Report MustUnderstand="df" xmlns="http://schemas.microsoft.com/sqlserver/reporting/2016/01/reportdefinition" xmlns:rd="http://schemas.microsoft.com/SQLServer/reporting/reportdesigner" xmlns:df="http://schemas.microsoft.com/sqlserver/reporting/2016/01/reportdefinition/defaultfontfamily">
  <df:DefaultFontFamily>Segoe UI</df:DefaultFontFamily>
  <AutoRefresh>0</AutoRefresh>
  <DataSources>
    <DataSource Name="DataSource1">
      <ConnectionProperties>
        <DataProvider>SQL</DataProvider>
        <ConnectString>Data Source=PA-HOR-AS408;Initial Catalog=ZYGO-NAV-PROD</ConnectString>
      </ConnectionProperties>
      <rd:SecurityType>DataBase</rd:SecurityType>
      <rd:DataSourceID>3806c648-c394-4f3a-8f1d-92c98f70bec4</rd:DataSourceID>
    </DataSource>
  </DataSources>
  <DataSets>
    <DataSet Name="DataSet1">
      <Query>
        <DataSourceName>DataSource1</DataSourceName>
        <CommandText>WITH  sItem AS
(
SELECT

 i.No_
,Description
,P6
,F6
,[Replenishment System]

FROM ZYGO$Item i 

WHERE 

([Stock Location] = 'RIC' OR [Product Types] IN ('EPO','OPT') )
)
, sNettable AS
(

SELECT

[Item No_]
,COALESCE(SUM(CASE
				WHEN [Non-Nettable] = 0
				THEN Quantity
				END) ,0) Nettable
,COALESCE(SUM( 
	CASE
	WHEN [Non-Nettable] = 1 
	THEN Quantity
	END ),0) [NonNettable]

FROM [ZYGO$Item Ledger Entry] ile

LEFT JOIN sItem ON sItem.No_ = ile.[Item No_]

GROUP BY [Item No_]
)
, sOnOrder AS
(
 /*  stock on order  */

SELECT 

i.No_       
,COALESCE(SUM(L.[Outstanding Quantity]), 0) OnOrder

FROM [ZYGO$Purchase Line] L 

LEFT JOIN sItem i ON L.No_ = i.No_ 
                
WHERE 

([Replenishment System] = 0 and [Document Type] = 1 and [Outstanding Quantity] &gt; 0)

GROUP BY i.No_
)
, sBlocked AS
(
/* Blocked*/
SELECT

sItem.[No_]
,COALESCE(SUM([Quantity]),0) Blocked
                
FROM [ZYGO$Warehouse Entry] we

LEFT JOIN sItem ON sItem.No_ = we.[Item No_]

WHERE [Bin Code] like '%IQC%'

GROUP BY sItem.No_
)
, sProdOrdComponent AS
(

SELECT
     
sItem.No_
,COALESCE(SUM([Remaining Quantity]), 0) ProdOrderComponent

FROM [ZYGO$Prod_ Order Component] poc

LEFT JOIN sItem ON sItem.No_ = poc.[Item No_]

WHERE Status in (2, 3)

GROUP BY sItem.No_
)

, sSale AS
(
            /*  Sales Orders */

SELECT

sItem.No_
,COALESCE(SUM([Outstanding Quantity]), 0) Sale

FROM [ZYGO$Sales Line] sl

LEFT JOIN sItem ON sItem.No_ = sl.No_

WHERE Type = 2 

AND [Completely Shipped] = 0

GROUP BY sItem.No_
)

, sServ AS
(

            /*  Service Orders */

SELECT 

sItem.No_
,COALESCE(SUM([Outstanding Quantity]), 0) Serv

FROM [ZYGO$Service Line] sv

LEFT JOIN sItem on sItem.No_ = sv.No_

GROUP BY sItem.No_

)
, sJob AS
(

            /*  Job - Inventory Requests */

SELECT

sItem.No_
,COALESCE(SUM([Outstanding Quantity]), 0) Job

FROM [ZYGO$Job Journal Line] j

LEFT JOIN sItem ON sItem.No_ = j.No_

WHERE [Journal Template Name] = 'INVREQ'

GROUP BY sItem.No_
)
,sProdOrder AS
(
	SELECT
		[Item No_]
		,SUM([Remaining Quantity]) Quantity
	
	 from [ZYGO$Prod_ Order Line]

	WHERE [Status] in (2,3)

	GROUP BY [Item No_]
)

SELECT

i.No_
,i.Description
,CASE i.[Replenishment System]
	WHEN 0 THEN 'Purchased'
	WHEN 1 THEN 'Manufactured'
END [Replenishment System]
,COALESCE(n.Nettable,0) + COALESCE(n.NonNettable, 0) OnHand
,COALESCE(n.Nettable,0) Nettable
,COALESCE(n.NonNettable, 0) NonNettable
,COALESCE(o.OnOrder,0) [Purchase Order]
,COALESCE(b.Blocked,0) Blocked
,COALESCE(p.ProdOrderComponent,0) [Prod Order Component]
,COALESCE(s.Sale,0) [Sales Order]
,COALESCE(v.Serv,0) [Service Order]
,COALESCE(j.Job,0) [Job Inventory Request]
,COALESCE(COALESCE(p.ProdOrderComponent,0) + COALESCE(s.Sale,0) + COALESCE(v.Serv,0) + COALESCE(j.Job,0),0) Allocated
,COALESCE(d.Quantity,0) [Prod Order]

FROM sItem i

LEFT JOIN sNettable n ON i.No_ = n.[Item No_]

LEFT JOIN sOnOrder o ON i.No_ = o.No_

LEFT JOIN sBlocked b ON i.No_ = b.No_

LEFT JOIN sProdOrdComponent p  ON i.No_ = p.No_

LEFT JOIN sSale s  ON i.No_ = s.No_

LEFT JOIN sServ v  ON i.No_ = v.No_

LEFT JOIN sJob j  ON i.No_ = j.No_

LEFT JOIN sProdOrder d  ON i.No_ = d.[Item No_]</CommandText>
        <rd:UseGenericDesigner>true</rd:UseGenericDesigner>
      </Query>
      <Fields>
        <Field Name="No_">
          <DataField>No_</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Description">
          <DataField>Description</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Replenishment_System">
          <DataField>Replenishment System</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="OnHand">
          <DataField>OnHand</DataField>
          <rd:TypeName>System.Decimal</rd:TypeName>
        </Field>
        <Field Name="Nettable">
          <DataField>Nettable</DataField>
          <rd:TypeName>System.Decimal</rd:TypeName>
        </Field>
        <Field Name="NonNettable">
          <DataField>NonNettable</DataField>
          <rd:TypeName>System.Decimal</rd:TypeName>
        </Field>
        <Field Name="Purchase_Order">
          <DataField>Purchase Order</DataField>
          <rd:TypeName>System.Decimal</rd:TypeName>
        </Field>
        <Field Name="Blocked">
          <DataField>Blocked</DataField>
          <rd:TypeName>System.Decimal</rd:TypeName>
        </Field>
        <Field Name="Prod_Order_Component">
          <DataField>Prod Order Component</DataField>
          <rd:TypeName>System.Decimal</rd:TypeName>
        </Field>
        <Field Name="Prod_Order">
          <DataField>Prod Order</DataField>
          <rd:TypeName>System.Decimal</rd:TypeName>
        </Field>
        <Field Name="Sales_Order">
          <DataField>Sales Order</DataField>
          <rd:TypeName>System.Decimal</rd:TypeName>
        </Field>
        <Field Name="Service_Order">
          <DataField>Service Order</DataField>
          <rd:TypeName>System.Decimal</rd:TypeName>
        </Field>
        <Field Name="Job_Inventory_Request">
          <DataField>Job Inventory Request</DataField>
          <rd:TypeName>System.Decimal</rd:TypeName>
        </Field>
        <Field Name="Allocated">
          <DataField>Allocated</DataField>
          <rd:TypeName>System.Decimal</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
  </DataSets>
