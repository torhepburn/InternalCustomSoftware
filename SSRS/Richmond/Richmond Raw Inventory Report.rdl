<?xml version="1.0" encoding="utf-8"?>
<Report MustUnderstand="df" xmlns="http://schemas.microsoft.com/sqlserver/reporting/2016/01/reportdefinition" xmlns:rd="http://schemas.microsoft.com/SQLServer/reporting/reportdesigner" xmlns:df="http://schemas.microsoft.com/sqlserver/reporting/2016/01/reportdefinition/defaultfontfamily">
  <df:DefaultFontFamily>Segoe UI</df:DefaultFontFamily>
  <AutoRefresh>0</AutoRefresh>
  <DataSources>
    <DataSource Name="NAV">
      <DataSourceReference>NAV</DataSourceReference>
      <rd:SecurityType>None</rd:SecurityType>
      <rd:DataSourceID>2952c44f-2900-46a8-85dd-e138a76e6527</rd:DataSourceID>
    </DataSource>
  </DataSources>
  <DataSets>
    <DataSet Name="DataSet1">
      <Query>
        <DataSourceName>NAV</DataSourceName>
        <CommandText>SELECT 

[Item No_] [No.]
,i.Description
,CASE i.Vetted
	WHEN 0 THEN 'Vetted'
	ELSE 'Not Vetted'
END Vetted
,SUM(Quantity) [Quantity on Hand]
,CASE [Replenishment System]
	WHEN 0 THEN 'Purchase'
	ELSE 'Manufacture'
END [Replensihment System]
,[Buyer Planner Code]
,[Vendor No_]
,Name [Vendor Name]
,[Standard Cost]
,[Proposed Purchase Cost]
,ile.[Global Dimension 2 Code] [Business Segment]

FROM [ZYGO$Item Ledger Entry] ile

LEFT JOIN ZYGO$Item i ON ile.[Item No_] = i.No_

INNER JOIN ZYGO$Vendor v ON i.[Vendor No_] = v.No_

WHERE

[Inventory Posting Group] = 'RAW'

AND [Replenishment System] = 0 --Purchased

AND ile.[Location Code] = 'RIC'

AND [Low-Level Code] &gt; 0

AND LEN(ile.[Production BOM No_]) = 0

AND i.No_ LIKE '4022%'

GROUP BY

[Item No_]
,i.Description
,i.Vetted
,[Replenishment System]
,[Buyer Planner Code]
,[Vendor No_]
,Name
,[Standard Cost]
,[Proposed Purchase Cost]
,ile.[Global Dimension 2 Code]

HAVING SUM(Quantity) &gt; 0

ORDER BY ile.[Global Dimension 2 Code]</CommandText>
        <rd:UseGenericDesigner>true</rd:UseGenericDesigner>
      </Query>
      <Fields>
        <Field Name="No_">
          <DataField>No.</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Description">
          <DataField>Description</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Vetted">
          <DataField>Vetted</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Quantity_on_Hand">
          <DataField>Quantity on Hand</DataField>
          <rd:TypeName>System.Decimal</rd:TypeName>
        </Field>
        <Field Name="Replensihment_System">
          <DataField>Replensihment System</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Buyer_Planner_Code">
          <DataField>Buyer Planner Code</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Vendor_No_">
          <DataField>Vendor No_</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Vendor_Name">
          <DataField>Vendor Name</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Standard_Cost">
          <DataField>Standard Cost</DataField>
          <rd:TypeName>System.Decimal</rd:TypeName>
        </Field>
        <Field Name="Proposed_Purchase_Cost">
          <DataField>Proposed Purchase Cost</DataField>
          <rd:TypeName>System.Decimal</rd:TypeName>
        </Field>
        <Field Name="Business_Segment">
          <DataField>Business Segment</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
  </DataSets>
