<?xml version="1.0" encoding="utf-8"?>
<Report MustUnderstand="df" xmlns="http://schemas.microsoft.com/sqlserver/reporting/2016/01/reportdefinition" xmlns:rd="http://schemas.microsoft.com/SQLServer/reporting/reportdesigner" xmlns:df="http://schemas.microsoft.com/sqlserver/reporting/2016/01/reportdefinition/defaultfontfamily">
  <df:DefaultFontFamily>Segoe UI</df:DefaultFontFamily>
  <AutoRefresh>0</AutoRefresh>
  <DataSources>
    <DataSource Name="NAV">
      <DataSourceReference>NAV</DataSourceReference>
      <rd:SecurityType>None</rd:SecurityType>
      <rd:DataSourceID>2223c3a6-f04d-4603-81d4-84bbc91bfb32</rd:DataSourceID>
    </DataSource>
  </DataSources>
  <DataSets>
    <DataSet Name="DataSet1">
      <Query>
        <DataSourceName>NAV</DataSourceName>
        <CommandText>SELECT

CASE h.[Document Type]
	WHEN 1 THEN 'Order'
	WHEN 5 THEN 'REturn Order'
END [Document Type]
,l.[Document No_]
,l.[PO Line No_]
,l.No_
,l.Description
,l.[Location Code]
,CASE h.Status
	WHEN 0 THEN 'Open'
	WHEN 1 THEN 'Released'
END [PO Status]
,l.[Outstanding Quantity]
,h.[Quote No_ 2]
,l.[Unit of Measure]
,l.[Unit Cost]
,l.[Line Amount]
,CASE 
	WHEN CONVERT(char(8), CAST(l.[Promised Receipt Date]AS date),1) = '01/01/53' THEN ''
	ELSE CONVERT(char(8), CAST(l.[Promised Receipt Date]AS date),1)
END [Promised Receipt Date] 
,l.[Expected Receipt Date]
,l.[Promised Receipt Date] [sortDate]

FROM [ZYGO$Purchase Header] h

INNER JOIN [ZYGO$Purchase Line] l ON h.No_ = l.[Document No_]

WHERE 1=1

AND h.[Job No_] = 'OPT-EPO-00199'

AND l.[Outstanding Quantity] &gt; 0

AND l.[Location Code] = 'RIC'

AND h.[Document Type] IN (1,5)

ORDER BY l.[Promised Receipt Date]</CommandText>
        <rd:UseGenericDesigner>true</rd:UseGenericDesigner>
      </Query>
      <Fields>
        <Field Name="Document_Type">
          <DataField>Document Type</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Document_No_">
          <DataField>Document No_</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="PO_Line_No_">
