<?xml version="1.0" encoding="utf-8"?>
<Report MustUnderstand="df" xmlns="http://schemas.microsoft.com/sqlserver/reporting/2016/01/reportdefinition" xmlns:rd="http://schemas.microsoft.com/SQLServer/reporting/reportdesigner" xmlns:df="http://schemas.microsoft.com/sqlserver/reporting/2016/01/reportdefinition/defaultfontfamily">
  <df:DefaultFontFamily>Segoe UI</df:DefaultFontFamily>
  <AutoRefresh>0</AutoRefresh>
  <DataSources>
    <DataSource Name="DataSource1">
      <ConnectionProperties>
        <DataProvider>SQL</DataProvider>
        <ConnectString>Data Source=MIDDB01.zygo.com;Initial Catalog=Dashboard</ConnectString>
      </ConnectionProperties>
      <rd:SecurityType>DataBase</rd:SecurityType>
      <rd:DataSourceID>883b3f9d-0748-4de3-ac35-16d66df8e077</rd:DataSourceID>
    </DataSource>
  </DataSources>
  <DataSets>
    <DataSet Name="DataSet1">
      <Query>
        <DataSourceName>DataSource1</DataSourceName>
        <CommandText>SELECT DISTINCT  

  f.FastID  
  ,CASE f.SiteID  
	WHEN 11 THEN 'Richmond'
	ELSE 'Other'
 END Site
 ,'EPO' [Business Unit]
 ,f.PartNumber  
  ,f.Description  
  ,i.ItemGroup 
  ,f.Qty  
  ,f.Revision  
  ,CASE 
	WHEN COALESCE(f.ResponsibleUser,'') = ''  THEN f.GroupName
	ELSE f.ResponsibleUser 
END [Responsible User/Group Name]
,f.[Status]  
 ,CASE f.FastTypesID
	WHEN 1 THEN 'NCMR'
	WHEN 2 THen 'NCPR'
	ELSE ''
END [Fast Type]
,CASE f.FastIdentityTypeID  
	WHEN 0 THEN 'Serial Number'
	WHEN 1 THEN 'Lot Code'
	WHEN 2 then 'None'
	ELSE ''
END [Fast Identity Type]
,CASE f.FastOriginID  
	WHEN 1 THEN 'Incoming (E)'
	WHEN 3 THEN 'Shop Floor (P)'
	WHEN 5 THEN 'Project'
	WHEN 6 THEN 'Standard Part'
	WHEN 7 THEN 'Shop Floor (Component)'
	ELSE ''
END [Fast Origin]
  ,f.OriginWarehouse  
,CASE f.SODID  
	WHEN 1 THEN 'Customer'
	WHEN 2 THEN 'Supplier'
	WHEN 3 THEN 'Zygo'
	WHEN 4 THEN 'Unknown'
	ELSE ''
END [Source of Defect]

 ,f.ServiceLogID  
  ,f.TrackerID  
  ,f.ProductionOrder  
  ,f.Operation  
  ,f.[LineNo]  
  ,f.MKProjectID [Project] 
  ,f.Customer  
  ,f.Operator [Originator] 
  ,f.DateCreated  
  ,f.LastUpdated  
  ,f.PreviousFastID  
  ,f.RCCACount  
  FROM [Fast-BrowseFast] f  
  LEFT JOIN FastItemGroups i ON  f.MK_Company_ID = i.MKCompanyID AND f.PartNumber = i.ItemCode

  WHERE 
  
  Status &lt;&gt; 'Closed'

  AND MKProjectID = 'OPT-EPO-00004'
    
  ORDER BY f.FastID DESC</CommandText>
        <rd:UseGenericDesigner>true</rd:UseGenericDesigner>
      </Query>
