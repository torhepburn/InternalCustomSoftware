<?xml version="1.0" encoding="utf-8"?>
<Report MustUnderstand="df" xmlns="http://schemas.microsoft.com/sqlserver/reporting/2016/01/reportdefinition" xmlns:rd="http://schemas.microsoft.com/SQLServer/reporting/reportdesigner" xmlns:df="http://schemas.microsoft.com/sqlserver/reporting/2016/01/reportdefinition/defaultfontfamily">
  <df:DefaultFontFamily>Segoe UI</df:DefaultFontFamily>
  <AutoRefresh>0</AutoRefresh>
  <DataSources>
    <DataSource Name="NAV">
      <DataSourceReference>NAV</DataSourceReference>
      <rd:SecurityType>None</rd:SecurityType>
      <rd:DataSourceID>cebccbd0-b59e-42a7-ad1c-38df9e8f931a</rd:DataSourceID>
    </DataSource>
  </DataSources>
  <DataSets>
    <DataSet Name="DataSet1">
      <Query>
        <DataSourceName>NAV</DataSourceName>
        <CommandText>


WITH s1 AS
(
select 

[Production BOM No_]
,[Version Code]
,[Line No_]
,No_
,Description
,[Unit of Measure Code]
,Quantity

from [ZYGO$Production BOM Line]

WHERE [Production BOM No_] = '1094-AS-1208'

AND [Version Code] = '02'

UNION ALL

select 

[Production BOM No_]
,[Version Code]
,[Line No_]
,No_
,Description
,[Unit of Measure Code]
,Quantity

from [ZYGO$Production BOM Line]

WHERE [Production BOM No_] = '1094-AS-107'

AND [Version Code] = '04'

UNION ALL

select 

[Production BOM No_]
,[Version Code]
,[Line No_]
,No_
,Description
,[Unit of Measure Code]
,Quantity

from [ZYGO$Production BOM Line]

WHERE [Production BOM No_] = '1094-AS-139'

AND [Version Code] = '01'

UNION ALL

select 

[Production BOM No_]
,[Version Code]
,[Line No_]
,No_
,Description
,[Unit of Measure Code]
,Quantity

from [ZYGO$Production BOM Line]

WHERE [Production BOM No_] = '1094-AS-1990'

AND [Version Code] = '01'
)
,s2 AS  /*	on hand	*/
(
SELECT

[Item No_]
,SUM(Quantity) OH
,[Bin Code]
,[Location Code]

FROM [ZYGO$Warehouse Entry] WHERE [Item No_] IN

(select No_ from s1)

GROUP BY [Item No_], [Bin Code],[Location Code]
)
, s3 AS	/*	Allocations	*/
(
	
	/*	Prod order components	*/

	SELECT
	[Item No_]
	,COALESCE(SUM([Remaining Quantity]), 0) AllocProd
	FROM [ZYGO$Prod_ Order Component]
	WHERE
	 [Item No_] IN
	(select No_ from s1)
	AND Status in (2, 3)
	GROUP BY [Item No_]

	UNION ALL

	/*  Sales Orders */

	SELECT
	No_
	,COALESCE(SUM([Quantity]), 0) AllocSO
	FROM [ZYGO$Sales Line]
	WHERE 
	[No_] IN

(select No_ from s1)

	AND Type = 2 AND [Completely Shipped] = 0
	GROUP BY [No_]

	UNION ALL

	/*  Service Orders */

	SELECT
	No_
	,COALESCE(SUM([Outstanding Quantity]), 0) AllocSvc
	FROM [ZYGO$Service Line]
	WHERE  
	[No_] IN

(select No_ from s1)

	AND [Outstanding Quantity] &gt; 0
	GROUP BY [No_]

	UNION ALL

	 /*  Job - Inventory Requests */

	SELECT
	No_
	,COALESCE(SUM([Quantity]), 0) AllocJob
	FROM [ZYGO$Job Journal Line]
	WHERE
	[No_] IN

(select No_ from s1)

	AND [Journal Template Name] = 'INVREQ'
	GROUP BY [No_]

)

select 

s1.[Production BOM No_]
,s1.[Version Code]
,s1.[Line No_]
,s1.No_
,s1.Description
,s1.[Unit of Measure Code]
,s1.Quantity
,COALESCE(s2.[Bin Code],'') BinCode
,COALESCE(s2.OH,0) OnHand
,COALESCE(s3.AllocProd,0) Allocated
,COALESCE(s2.[Location Code],'') LocationCode

from s1

LEFT JOIN s2 ON s2.[Item No_] = s1.No_

LEFT JOIN s3 on s3.[Item No_] = s1.No_
</CommandText>
        <rd:UseGenericDesigner>true</rd:UseGenericDesigner>
      </Query>
      <Fields>
        <Field Name="Production_BOM_No_">
          <DataField>Production BOM No_</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Version_Code">
          <DataField>Version Code</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Line_No_">
          <DataField>Line No_</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
        <Field Name="No_">
          <DataField>No_</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Description">
          <DataField>Description</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Unit_of_Measure_Code">
          <DataField>Unit of Measure Code</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Quantity">
          <DataField>Quantity</DataField>
          <rd:TypeName>System.Decimal</rd:TypeName>
        </Field>
        <Field Name="BinCode">
          <DataField>BinCode</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="OnHand">
          <DataField>OnHand</DataField>
          <rd:TypeName>System.Decimal</rd:TypeName>
        </Field>
        <Field Name="Allocated">
          <DataField>Allocated</DataField>
          <rd:TypeName>System.Decimal</rd:TypeName>
        </Field>
        <Field Name="LocationCode">
          <DataField>LocationCode</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
  </DataSets>
