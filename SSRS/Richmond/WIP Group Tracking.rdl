<?xml version="1.0" encoding="utf-8"?>
<Report xmlns="http://schemas.microsoft.com/sqlserver/reporting/2016/01/reportdefinition" xmlns:rd="http://schemas.microsoft.com/SQLServer/reporting/reportdesigner" xmlns:df="http://schemas.microsoft.com/sqlserver/reporting/2016/01/reportdefinition/defaultfontfamily" MustUnderstand="df">
  <df:DefaultFontFamily>Segoe UI</df:DefaultFontFamily>
  <AutoRefresh>0</AutoRefresh>
  <DataSources>
    <DataSource Name="NAV">
      <DataSourceReference>NAV</DataSourceReference>
      <rd:SecurityType>None</rd:SecurityType>
      <rd:DataSourceID>11130322-5645-456c-991a-7c558bb3a5c8</rd:DataSourceID>
    </DataSource>
  </DataSources>
  <DataSets>
    <DataSet Name="DataSet1">
      <Query>
        <DataSourceName>NAV</DataSourceName>
        <CommandText>SELECT POL.[Prod_ Order No_]       AS 'Order_No' 
 ,R.[Operation No_]                  AS 'Operation' 
 ,R.[Operation No_] + R.[Description] AS 'OperationDescription' 
 ,POL.[Line No_]                     AS 'LineNo' 
 ,R.[Starting Date]                  AS 'StartingDate' 
 ,R.[Starting Date-Time]             AS 'Production_Date' 
 ,R.[Work Center No_]                AS 'WorkCenter' 
 ,R.[Description]                    AS 'Description' 
 ,R.[Setup Time]                     AS 'SetupTime' 
 ,R.[Setup Time Unit of Meas_ Code]  AS 'SetupTimeUoM' 
 ,R.[Run Time]                       AS 'RunTime' 
 ,R.[Run Time Unit of Meas_ Code]    AS 'RunTimeUoM' 
 ,POL.[Item No_]                     AS 'PartNumber' 
 ,I.[Description]                    AS 'PartNumberDescription' 
 ,POL.[Remaining Quantity]           AS 'RemainingQty' 
 ,POL.Quantity                       AS 'OriginalQty' 
 ,POL.[Scrap _]                      AS 'ScrappedQty' 
 ,W.[Component Type]                 AS 'ComponentType' 
 ,POL.[Job No_]                      AS 'Job' 
 ,J.[Description]                    AS 'JobDescription' 
 ,W.[Global Dimension 1 Code]        AS 'CostCenter' 
 ,DV1.Name                           AS 'CostCenterDescription' 
 ,R.[Operation Complete]             AS 'Operation_Completed'
 ,I.[Global Dimension 2 Code]
 FROM [ZYGO$Prod_ Order Line]        AS POL WITH (NOLOCK) 
 LEFT OUTER JOIN [ZYGO$Prod_ Order Routing Line] AS R WITH (NOLOCK) ON POL.[Prod_ Order No_] = R.[Prod_ Order No_] 
 LEFT OUTER JOIN [ZYGO$Item]            AS I WITH (NOLOCK)  ON  POL.[Item No_] = I.[No_] 
 LEFT OUTER JOIN [ZYGO$Work Center]     AS W WITH (NOLOCK)  ON  R.[Work Center No_] = W.[No_] 
 LEFT OUTER JOIN [ZYGO$Job]             AS J WITH (NOLOCK)  ON  POL.[Job No_] = J.[No_] 
 LEFT OUTER JOIN [ZYGO$Dimension Value] AS DV1 WITH (NOLOCK)  ON  W.[Global Dimension 1 Code] = DV1.[Code]  AND UPPER(DV1.[Dimension Code]) = 'COSTCENTER' 
 WHERE UPPER(R.[Operation No_]) &lt;&gt; '1000' 
 AND POL.[Status] = '3'  --_FilterPartNumber &amp;
AND I.[Global Dimension 2 Code] IN ('CRYSTALLINE OPTICS', 'MACHINED STRUCTURES','GLASS OPTICS' )
 ORDER BY POL.[Prod_ Order No_]</CommandText>
        <rd:UseGenericDesigner>true</rd:UseGenericDesigner>
      </Query>
