  <DataSources>
    <DataSource Name="NAV">
      <DataSourceReference>NAV</DataSourceReference>
      <rd:SecurityType>None</rd:SecurityType>
      <rd:DataSourceID>bf1ef900-45f7-4a1e-8f03-e4e7b1c1b254</rd:DataSourceID>
    </DataSource>
  </DataSources>
  <DataSets>
    <DataSet Name="DataSet1">
      <Query>
        <DataSourceName>NAV</DataSourceName>
        <CommandText>select 

[Prod_ Order No_]
,o.[Source No_]
,o.Description
,[Search Description]
,[Remaining Quantity]
,l.[Due Date]
,[Reference]



 from [ZYGO$Prod_ Order Line] l

 INNER JOIN [ZYGO$Production Order] o ON l.[Prod_ Order No_] = o.No_

WHERE l.[Job No_] = 'OPT-EPO-00004'

AND o.Status = 3

ORDER BY l.[Due Date]</CommandText>
        <rd:UseGenericDesigner>true</rd:UseGenericDesigner>
      </Query>
      <Fields>
        <Field Name="Prod__Order_No_">
          <DataField>Prod_ Order No_</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Source_No_">
          <DataField>Source No_</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Description">
          <DataField>Description</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Search_Description">
          <DataField>Search Description</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Remaining_Quantity">
          <DataField>Remaining Quantity</DataField>
          <rd:TypeName>System.Decimal</rd:TypeName>
        </Field>
        <Field Name="Reference">
