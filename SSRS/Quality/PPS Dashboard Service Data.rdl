  <DataSets>
    <DataSet Name="DataSet1">
      <Query>
        <DataSourceName>DataSource1</DataSourceName>
        <CommandText>CREATE TABLE #LogIDParts
(
 [logID] int
,[Parts] nvarchar(700)
)

declare @logID int
declare @part varchar(100)
declare @parts varchar(700)
SET @parts = ''

declare logCursor Cursor for 

select distinct servicelogid FROM ServiceLogs_ReplacedParts

WHERE itemCode is not null

order by [servicelogid]

open logCursor

fetch next from logCursor into @logID

while @@FETCH_STATUS = 0
begin

declare partCursor Cursor for 

SELECT itemCode FROM ServiceLogs_ReplacedParts

WHERE servicelogid = @logID  AND itemcode is not null

ORDER BY [itemCode]

OPEN partCursor

fetch next from partCursor into @part

while @@FETCH_STATUS = 0
begin

	
	SET @parts = @parts + ', ' +  @part

	
	
fetch next from partCursor into @part	
end

close partCursor
deallocate partCursor

--INSERT INTO #LogIDParts (logID, Parts) (SELECT @logID, (SUBSTRING(@parts,2, LEN(@parts - 1))))
INSERT INTO #LogIDParts (logID, Parts) (SELECT @logID, @parts)

SET @parts = ''
	
fetch next from logCursor into  @logID


end
close logCursor
deallocate logCursor;

SELECT 

 RMA.RMANumber [RMA #]
,ServiceLogs.Quantity [Qty]
,ServiceLogs.ModelPart [Part #]
,ServiceLogs.PartDescription [Description]
,ServiceLogs.SerialNumber [S/N]
,RMAItems.Cust_Ref_Number [Cust Ref #]
,COALESCE(RMA_Reasons.RMAReason,'') [Reason]
,COALESCE(RMA_Dispositions.RMADisposition,'') [Disposition]
,ServiceLogs.ProblemReported [Customer Reported Problem]
,SalesRegion.SalesRegion [Business Unit]
,ServiceLogs.ServiceLogID [Service #]
,ServiceLogs.IncidentID [Incident #]
,Customers.CustomerName [Company]
,Customers.Contact
,ServiceLogs.DateOpened [Date Opened]
,COALESCE(FORMAT(ServiceLogs.DateDue,'MM/dd/yyyy'),'') [Date Due]
,PartNumberTypes.PartNumberType [Product Line]
,Requisitioner.Name [Resposible User]
,COALESCE(NCMR,'') NCMR
,COALESCE(ServiceLogs.OriginalSalesOrderNumber,'') [Sales Order #]
,COALESCE(ServiceLogs.ServiceOrder,'') [Service Order #]
,COALESCE(ServiceLogs.ServiceItem,'') [Service Item #]
,COALESCE(ServiceLogs.MKWorkOrderNumber,'') [Work Order #]
,COALESCE(ServiceTypes.ServiceType,'') [Service Type]
,ServiceLogStatus [Status]
,COALESCE(ServiceLogs.DateClosed,'') [Date Closed]
,COALESCE(ServiceLogs.DateShipped,'') [Date Invoiced]
,COALESCE(ServiceLogs.CertificationNumber,'') [Certification #]
,COALESCE(ServiceLogs.FastItemDefectRCCAID,'') [RCCA #]
,COALESCE(ServiceLogs.TotalRegularHours,'') [Regular Hours]
,COALESCE(ServiceLogs.TotalTravelHours,'') [Travel Hours]
,COALESCE(ServiceLogs.TotalTravelCost,'') [Total Travel]
,COALESCE(ServiceLogs.TotalPartsCost,'') [Total Parts]
,COALESCE(#LogIDParts.Parts,'') [Replaced Parts]
/*

ServiceLogs_ReplacedParts where ServiceLogID = 19056

*/

FROM RMA_Dispositions RIGHT OUTER JOIN
RMA_Reasons RIGHT OUTER JOIN
RMA ON RMA_Reasons.RMAReasonID = RMA.Reason ON RMA_Dispositions.RMADispositionID = RMA.Disposition RIGHT OUTER JOIN
RMA_Warranty RIGHT OUTER JOIN
RMAItems LEFT OUTER JOIN
RMA_DeliverTo ON RMAItems.DeliverTo = RMA_DeliverTo.RMADeliverToID ON RMA_Warranty.WarrantyID = RMAItems.Warranty ON 
RMA.RMANumber = RMAItems.RMANumber RIGHT OUTER JOIN
Requisitioner RIGHT OUTER JOIN
CustomerIncident LEFT OUTER JOIN
Customers ON CustomerIncident.CustomerID = Customers.CustomerID AND CustomerIncident.CustomerID = Customers.CustomerID AND
CustomerIncident.CustomerID = Customers.CustomerID RIGHT OUTER JOIN
ServiceLogs ON CustomerIncident.IncidentID = ServiceLogs.IncidentID AND CustomerIncident.IncidentID = ServiceLogs.IncidentID AND
CustomerIncident.IncidentID = ServiceLogs.IncidentID LEFT OUTER JOIN
ServiceLogStatus ON ServiceLogs.Status = ServiceLogStatus.ServiceLogStatusIndex ON Requisitioner.ID = ServiceLogs.RepairOwner ON
RMAItems.RMAItemsNumber = ServiceLogs.RMAItemsNumber
LEFT OUTER JOIN SalesRegion ON CustomerIncident.SalesRegionID = SalesRegion.SalesRegionID
LEFT OUTER JOIN PartNumberTypes ON CustomerIncident.ProductLine = PartNumberTypes.PartNumberTypesNumber
LEFT JOIN ServiceTypes ON ServiceLogs.ServiceType = ServiceTypes.ServiceTypeID
LEFT JOIN #LogIDParts ON ServiceLogs.ServiceLogID = #LogIDParts.logID

WHERE SalesRegion = 'PPS'</CommandText>
        <rd:UseGenericDesigner>true</rd:UseGenericDesigner>
      </Query>
