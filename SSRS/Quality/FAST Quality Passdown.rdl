<?xml version="1.0" encoding="utf-8"?>
<Report MustUnderstand="df" xmlns="http://schemas.microsoft.com/sqlserver/reporting/2016/01/reportdefinition" xmlns:rd="http://schemas.microsoft.com/SQLServer/reporting/reportdesigner" xmlns:df="http://schemas.microsoft.com/sqlserver/reporting/2016/01/reportdefinition/defaultfontfamily">
  <df:DefaultFontFamily>Segoe UI</df:DefaultFontFamily>
  <AutoRefresh>0</AutoRefresh>
  <DataSources>
    <DataSource Name="DataSource1">
      <ConnectionProperties>
        <DataProvider>SQL</DataProvider>
        <ConnectString>Data Source=CT-MID-DB01.ametek.com;Initial Catalog=Dashboard</ConnectString>
      </ConnectionProperties>
      <rd:SecurityType>DataBase</rd:SecurityType>
      <rd:DataSourceID>b9085292-bad7-4921-8c73-a6aaef04ff16</rd:DataSourceID>
    </DataSource>
  </DataSources>
  <DataSets>
    <DataSet Name="DataSet1">
      <Query>
        <DataSourceName>DataSource1</DataSourceName>
        <QueryParameters>
          <QueryParameter Name="@BusinessUnit">
            <Value>=Parameters!BusinessUnit.Value</Value>
          </QueryParameter>
        </QueryParameters>
        <CommandText>
/*	FAST Quality Passdown  */

WITH s1 AS
(
	SELECT FASTID, PartNumber, Description FROM FAST 
	WHERE PartNumber IN
	(
	SELECT PartNumber from FAST
	WHERE DateCreated &gt; GETDATE()-90
	GROUP BY PartNumber
	HAVING COUNT(FASTID) &gt; 1)
	AND DateCreated &gt; GETDATE()-90
)
, s2 as
(
	SELECT FASTID, SUM(Qty) Quantity
	FROM FastItems
	WHERE FASTID IN (SELECT FASTID FROM s1)
	GROUP BY FASTID
)

SELECT DISTINCT

s1.FASTID [FAST ID]
,s2.[Quantity]
,fid.FastDefectPathName [Defect]
,fid.Comment [Defect Comment]
,f.DateCreated [Defect Date]
,COALESCE(fid.RCCAID,'') [RCCA ID]
,CASE f.SODID
		WHEN 1 THEN 'Customer'
		WHEN 2 THEN 'Supplier'
		WHEN 3 THEN 'Zygo'
		ELSE 'Unknown'
END [SOD (Source of Defect)]
,COALESCE(t.RCCAType ,'') [RCCA Type]
,r.Name [Responsible User]
,CASE 
	WHEN LEN(t.RCCAType) &gt; 0 THEN FORMAT(a.DateCreated,'MM/dd/yyyy') 
	ELSE ''
END [Date RCCA Opened]
, s1.PartNumber
,s1.Description
,CASE
	WHEN LEN(COALESCE(f.SODCostCenter,'')) &gt; 1 THEN f.SODCostCenter
	ELSE COALESCE(s.SupplierName,'')
END [Source of Defect]
,COALESCE(SalesRegion,'') BU

FROM

FAST f

INNER JOIN FASTItems fi on fi.FastID = f.FastID

INNER JOIN s1 ON s1.FastID = fi.FastID

INNER JOIN FastItemsDefects fid ON fid.FastItemID = fi.FastItemID

LEFT JOIN FastItemDefectRCCA a ON fid.RCCAID = a.FastItemDefectRCCAID

LEFT JOIN RCCATypes t on a.RCCATypeID = t.RCCATypeID

left join Requisitioner r on f.ResponsibleUser = r.ID

LEFT JOIN s2 on f.FastID = s2.FastID

LEFT JOIN SupplierMetricsScorecards s ON f.SODSupplier = s.Supplier

LEFT JOIN SalesRegion sr on f.SalesRegionID = sr.SalesRegionID

WHERE f.DateCreated &gt; GETDATE()-90

AND COALESCE(SalesRegion,'') IN (@BusinessUnit)</CommandText>
        <rd:UseGenericDesigner>true</rd:UseGenericDesigner>
      </Query>
      <Fields>
        <Field Name="FAST_ID">
          <DataField>FAST ID</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
        <Field Name="Quantity">
          <DataField>Quantity</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
        <Field Name="Defect">
          <DataField>Defect</DataField>
