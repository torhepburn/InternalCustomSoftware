          <rd:TypeName>System.DateTime</rd:TypeName>
        </Field>
        <Field Name="RCCA_ID">
          <DataField>RCCA ID</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
        <Field Name="SOD__Source_of_Defect_">
