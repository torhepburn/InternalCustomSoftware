<?xml version="1.0" encoding="utf-8"?>
<Report MustUnderstand="df" xmlns="http://schemas.microsoft.com/sqlserver/reporting/2016/01/reportdefinition" xmlns:rd="http://schemas.microsoft.com/SQLServer/reporting/reportdesigner" xmlns:df="http://schemas.microsoft.com/sqlserver/reporting/2016/01/reportdefinition/defaultfontfamily">
  <df:DefaultFontFamily>Segoe UI</df:DefaultFontFamily>
  <AutoRefresh>0</AutoRefresh>
  <DataSources>
    <DataSource Name="Dashboard">
      <ConnectionProperties>
        <DataProvider>SQL</DataProvider>
        <ConnectString>Data Source=MIDDB01.zygo.com;Initial Catalog=Dashboard</ConnectString>
      </ConnectionProperties>
      <rd:SecurityType>DataBase</rd:SecurityType>
      <rd:DataSourceID>f9ac82ba-41a8-495f-90f3-f2f3834f51d4</rd:DataSourceID>
    </DataSource>
  </DataSources>
  <DataSets>
    <DataSet Name="DataSet1">
      <Query>
        <DataSourceName>Dashboard</DataSourceName>
        <CommandText>WITH s1 AS
(
select

t.OrderNo
,t.Operation
,MIN(StartTime) MinStartTime
,t.CostCenter
,t.CostCenterDescription

from 

 [TimecardNAVProdHours] t 
 
 WHERE 1=1

AND CostCenter IN (5110,5125, 5135, 5145, 5160, 5177, 5185, 5310, 8074, 8077, 8177, 8190, 5200,5210, 5215, 5225, 5230)

GROUP BY
t.OrderNo
,t.Operation
,t.CostCenter
,t.CostCenterDescription

HAVING MIN(StartTime)&gt;GETDATE()-7
)
, s2 AS
(
	SELECT 

	SODCostCenter
	,COUNT(FastID) NumberofFASTs

	FROM [Dashboard].[dbo].[FASTMetricsDefects]

	WHERE

	DateCreated&gt; GETDATE()-7

	AND SODCostCenter IN (5110,5125, 5135, 5145, 5160, 5177, 5185, 5310, 8074, 8077, 8177, 8190, 5200,5210, 5215, 5225, 5230)

	GROUP BY SODCostCenter
),s3 AS
(

SELECT 

CostCenter
,CostCenterDescription
,COUNT(Operation) StartsPast7Days

FROM s1

GROUP BY

CostCenter
,CostCenterDescription
)

SELECT

s3.CostCenter
,s3.CostCenterDescription
,s3.StartsPast7Days
,COALESCE(s2.NumberofFASTs,0) NumberofFASTSPast7Days


FROM s3 LEFT JOIN s2 ON s3.CostCenter = s2.SODCostCenter</CommandText>
        <rd:UseGenericDesigner>true</rd:UseGenericDesigner>
      </Query>
      <Fields>
        <Field Name="CostCenter">
          <DataField>CostCenter</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="CostCenterDescription">
          <DataField>CostCenterDescription</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="StartsPast7Days">
          <DataField>StartsPast7Days</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
        <Field Name="NumberofFASTSPast7Days">
          <DataField>NumberofFASTSPast7Days</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
  </DataSets>
