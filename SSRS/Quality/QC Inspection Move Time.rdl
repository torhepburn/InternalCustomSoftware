<?xml version="1.0" encoding="utf-8"?>
<Report MustUnderstand="df" xmlns="http://schemas.microsoft.com/sqlserver/reporting/2016/01/reportdefinition" xmlns:rd="http://schemas.microsoft.com/SQLServer/reporting/reportdesigner" xmlns:df="http://schemas.microsoft.com/sqlserver/reporting/2016/01/reportdefinition/defaultfontfamily">
  <df:DefaultFontFamily>Segoe UI</df:DefaultFontFamily>
  <AutoRefresh>0</AutoRefresh>
  <DataSources>
    <DataSource Name="DataSource1">
      <ConnectionProperties>
        <DataProvider>SQL</DataProvider>
        <ConnectString>Data Source=ct-mid-sql11;Initial Catalog=AccessFrontEnds</ConnectString>
      </ConnectionProperties>
      <rd:SecurityType>DataBase</rd:SecurityType>
      <rd:DataSourceID>48df7104-c7dd-4a63-9fbd-150f8e5e08f0</rd:DataSourceID>
    </DataSource>
  </DataSources>
  <DataSets>
    <DataSet Name="DataSet1">
      <Query>
        <DataSourceName>DataSource1</DataSourceName>
        <CommandText>select 

CASE 
	WHEN rr.Name is not null THEN rr.Name
	ELSE r.name
END Inspector
,lt.TimeInLocation/60 TimeInHours
,PartNumber
,lt.MovedOutDate
,l.Location
--,rr.name

from [MIDDB01.zygo.com].Dashboard.dbo.LocationTracking lt

INNER JOIN [MIDDB01.zygo.com].Dashboard.dbo.Requisitioner r ON lt.MovedToOperator = r.ID



INNER JOIN [MIDDB01.zygo.com].Dashboard.dbo.Locations l ON lt.MovedToLocation = l.LocationID

LEFT JOIN [MIDDB01.zygo.com].Dashboard.dbo.MK_PurchaseReceipt_Approvals a ON lt.MKReceiptTransactionID = a.MKReceiptTransactionID AND lt.MovedToLocation = a.LocationTrackingID

LEFT JOIN [MIDDB01.zygo.com].Dashboard.dbo.MK_PurchaseReceipt_TransactionLog tl ON lt.MKReceiptTransactionID = tl.MKReceiptTransactionID

LEFT JOIN [MIDDB01.zygo.com].Dashboard.dbo.Requisitioner rr ON a.Operator = rr.ID

WHERE 1=1 --lt.MKReceiptTransactionID = 451164

AND (Location like 'QC IN O%'

OR Location LIKE 'QC OPT%'

OR Location LIKE 'QC OPT%'

OR Location LIKE 'QC OUT%'

OR Location = 'Incoming Work-cell testing')

ORDER BY 

CASE 
	WHEN rr.Name is not null THEN rr.Name
	ELSE r.name
END 
,PartNumber
,MovedOutDate</CommandText>
        <rd:UseGenericDesigner>true</rd:UseGenericDesigner>
      </Query>
      <Fields>
        <Field Name="Inspector">
          <DataField>Inspector</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="TimeInHours">
          <DataField>TimeInHours</DataField>
          <rd:TypeName>System.Double</rd:TypeName>
        </Field>
        <Field Name="PartNumber">
