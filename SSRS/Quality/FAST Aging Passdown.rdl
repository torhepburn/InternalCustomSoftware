<?xml version="1.0" encoding="utf-8"?>
<Report MustUnderstand="df" xmlns="http://schemas.microsoft.com/sqlserver/reporting/2016/01/reportdefinition" xmlns:rd="http://schemas.microsoft.com/SQLServer/reporting/reportdesigner" xmlns:df="http://schemas.microsoft.com/sqlserver/reporting/2016/01/reportdefinition/defaultfontfamily">
  <df:DefaultFontFamily>Segoe UI</df:DefaultFontFamily>
  <AutoRefresh>0</AutoRefresh>
  <DataSources>
    <DataSource Name="DataSource1">
      <ConnectionProperties>
        <DataProvider>SQL</DataProvider>
        <ConnectString>Data Source=CT-MID-DB01.ametek.com;Initial Catalog=Dashboard</ConnectString>
      </ConnectionProperties>
      <rd:SecurityType>DataBase</rd:SecurityType>
      <rd:DataSourceID>e65b6c7a-9e91-4a53-978e-e0b13c1e61cd</rd:DataSourceID>
    </DataSource>
  </DataSources>
  <DataSets>
    <DataSet Name="DataSet1">
      <Query>
        <DataSourceName>DataSource1</DataSourceName>
        <QueryParameters>
          <QueryParameter Name="@BusinessUnit">
            <Value>=Parameters!BusinessUnit.Value</Value>
            <rd:UserDefined>true</rd:UserDefined>
          </QueryParameter>
        </QueryParameters>
        <CommandText>
WITH s1 as 

(
  SELECT 

  FASTID
  ,Comments

  FROM [Dashboard].[dbo].[FASTComments]

  WHERE FASTCommentsID IN
  
  (SELECT

  MAX(FASTCommentsID)
   
  FROM [Dashboard].[dbo].[FASTComments]

  --WHERE LastUpdated is not null

  GROUP BY FastID)

  --ORDER BY FASTid desc

),s2 as
(
	SELECT MAX(FastItemDefectID) FIDID, FastItemID from FastItemsDefects 

	WHERE FASTitemID IN (SELECT MAX(FASTitemID) FROM FastItems GROUP BY FastID)

	GROUP BY FastItemID
),s3 as
(
	SELECT 

	Comment
	,s2.FastItemID

	from s2 INNER JOIN FastItemsDefects d on s2.FIDID = d.FastItemDefectID
)
,s4 AS
(
	SELECT

	PartNumber
	,Supplier
	,MAX(ReceivedDate) ReceivedDate

	FROM MK_PurchaseReceipt_TransactionLog

	WHERE ReceivedDate &gt; (GETDATE() - 800)

	GROUP BY Partnumber, Supplier
)
,s5 AS
(
	SELECT

	l.PartNumber
	,l.Supplier
	,COALESCE(l.InspectionCode,'') InspectionCode
	
	FROM MK_PurchaseReceipt_TransactionLog l

	INNER JOIN s4 on l.PartNumber = s4.PartNumber and l.Supplier = s4.Supplier AND s4.ReceivedDate = l.ReceivedDate

)


select Distinct

COALESCE(SalesRegion,'') BU
,f.FastID [FAST ID]
,f.PartNumber [P/N]
,Description
,i.Qty Quantity
,COALESCE(o.FastOrigin,'') + '/ ' + COALESCE(locationID,'') [Location of Part]
,FORMAT(DateCreated,'MM/dd/yyyy') [Date Created]
,r.Name [Resp User]
,DATEDIFF(D, DateCreated, GETDATE()) Age	
,CASE 
	WHEN z.Qty &gt; 0 THEN 'Yes'
	ELSE 'No'
END [Eval Reqd]
,COALESCE(CASE IsStandardPart
	WHEN 1 THEN 'Vetted'
	ELSE 'Non-vetted'
	End
,'') [Vetted/Non-vetted]
,COALESCE(s1.Comments,'') [Reason for Delay]
,COALESCE(InspectionCode,'') [Dock to Stock Code]
,COALESCE(p.[FastDisposition],'Unassigned') [Disposition Status]
,COALESCE(s3.[Comment],'') Comment


from FAST f

left join SalesRegion sr on f.SalesRegionID = sr.SalesRegionID

left join s1 on s1.FastID = f.FastID

left join Requisitioner r on f.ResponsibleUser = r.ID

LEFT JOIN FASTItems i on f.FastID = i.FastID

LEFT JOIN FASTOrigins o on f.FastOriginID = o.FastOriginsID

LEFT JOIN FASTDispositions p ON i.FastDispositionID = p.FastDispositionID

LEFT JOIN s5 ON f.PartNumber = s5.PartNumber

LEFT JOIN ZMMT z on i.FastItemID = z.FastItemID

INNER JOIN s3 ON i.FastItemID = s3.FastItemID


WHERE 

FastStatusIndex in (0,3)

AND COALESCE(SalesRegion,'') IN (@BusinessUnit)
--.FASTid = 45991

ORDER BY f.FASTID desc</CommandText>
        <rd:UseGenericDesigner>true</rd:UseGenericDesigner>
      </Query>
      <Fields>
        <Field Name="BU">
          <DataField>BU</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="FAST_ID">
          <DataField>FAST ID</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
        <Field Name="P_N">
          <DataField>P/N</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Description">
          <DataField>Description</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Quantity">
          <DataField>Quantity</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
        <Field Name="Location_of_Part">
          <DataField>Location of Part</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Date_Created">
          <DataField>Date Created</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Resp_User">
          <DataField>Resp User</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Age">
          <DataField>Age</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
        <Field Name="Eval_Reqd">
          <DataField>Eval Reqd</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Vetted_Non_vetted">
          <DataField>Vetted/Non-vetted</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Reason_for_Delay">
          <DataField>Reason for Delay</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Dock_to_Stock_Code">
          <DataField>Dock to Stock Code</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Disposition_Status">
          <DataField>Disposition Status</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Comment">
          <DataField>Comment</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
  </DataSets>
