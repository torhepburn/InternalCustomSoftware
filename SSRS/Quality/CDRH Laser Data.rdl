<?xml version="1.0" encoding="utf-8"?>
<Report MustUnderstand="df" xmlns="http://schemas.microsoft.com/sqlserver/reporting/2016/01/reportdefinition" xmlns:rd="http://schemas.microsoft.com/SQLServer/reporting/reportdesigner" xmlns:df="http://schemas.microsoft.com/sqlserver/reporting/2016/01/reportdefinition/defaultfontfamily">
  <df:DefaultFontFamily>Segoe UI</df:DefaultFontFamily>
  <AutoRefresh>0</AutoRefresh>
  <DataSources>
    <DataSource Name="DataSource1">
      <ConnectionProperties>
        <DataProvider>SQL</DataProvider>
        <ConnectString>Data Source=CT-MID-SQL11;Initial Catalog=AccessFrontEnds</ConnectString>
      </ConnectionProperties>
      <rd:SecurityType>DataBase</rd:SecurityType>
      <rd:DataSourceID>5d287e9a-d05d-4add-8eb6-eb5cab24b85c</rd:DataSourceID>
    </DataSource>
  </DataSources>
  <DataSets>
    <DataSet Name="DataSet1">
      <Query>
        <DataSourceName>DataSource1</DataSourceName>
        <CommandText>SELECT 

No_ [Part Number]
,COUNT(No_) Count
,'Domestic' [EndUser]

FROM LaserCDRHShipmentData 

WHERE No_ 

IN (SELECT [Part Number] FROM LaserCDRHList WHERE [Part Number] NOT LIKE '%-xx')

AND [VAT Country_Region Code] = 'USA'

GROUP BY No_


UNION

SELECT 

No_
,COUNT(No_)
,'International' [EndUser]

FROM LaserCDRHShipmentData 

WHERE No_ 

IN (SELECT [Part Number] FROM LaserCDRHList WHERE [Part Number] NOT LIKE '%-xx')

AND [VAT Country_Region Code] != 'USA'

GROUP BY No_

UNION

SELECT

LEFT(No_,9) + '-xx'
,COUNT(No_)
,'International' [EndUser]

FROM LaserCDRHShipmentData WHERE LEFT(No_,9) IN

(SELECT LEFT([Part Number],9) FROM LaserCDRHList WHERE [Part Number] LIKE '%-xx')

AND [VAT Country_Region Code] != 'USA'

GROUP BY LEFT(No_,9)

UNION

SELECT

LEFT(No_,9) + '-xx'
,COUNT(No_)
,'Domestic' [EndUser]

FROM LaserCDRHShipmentData WHERE LEFT(No_,9) IN

(SELECT LEFT([Part Number],9) FROM LaserCDRHList WHERE [Part Number] LIKE '%-xx')

AND [VAT Country_Region Code] = 'USA'

GROUP BY LEFT(No_,9)


UNION

SELECT

Description No_
,COUNT(No_)
,'International' [EndUser]

FROM LaserCDRHShipmentData WHERE Description IN

(SELECT [Part number] FROM LaserCDRHList WHERE [Part number] LIKE '%SSR%')

AND [VAT Country_Region Code] != 'USA'

GROUP BY Description

UNION

SELECT

Description No_
,COUNT(No_) Count
,'Domestic' [EndUser]

FROM LaserCDRHShipmentData WHERE Description IN

(SELECT [Part number] FROM LaserCDRHList WHERE [Part number] LIKE '%SSR%')

AND [VAT Country_Region Code] = 'USA'

GROUP BY Description
</CommandText>
        <rd:UseGenericDesigner>true</rd:UseGenericDesigner>
      </Query>
      <Fields>
        <Field Name="Part_Number">
          <DataField>Part Number</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Count">
          <DataField>Count</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
        <Field Name="EndUser">
          <DataField>EndUser</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
  </DataSets>
