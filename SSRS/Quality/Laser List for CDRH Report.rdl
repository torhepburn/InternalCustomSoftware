  <DataSets>
    <DataSet Name="DataSet1">
      <Query>
        <DataSourceName>DataSource1</DataSourceName>
        <CommandText>SELECT [ACC# NO#]
      ,[Part Number]
      ,[DESIGNATION]
      ,[MODEL]
      ,[Wavelength]
      ,[Product Function]
      ,[LASER MEDIA]
      ,[Class]
      ,[ACTIVE]
      ,[DISCONTINUED]
      ,[PLANT]
      ,[Comment]
  FROM [AccessFrontEnds].[dbo].[LaserCDRHList]

  WHERE Active LIKE '%X%'</CommandText>
        <rd:UseGenericDesigner>true</rd:UseGenericDesigner>
      </Query>
