<?xml version="1.0" encoding="utf-8"?>
<Report MustUnderstand="df" xmlns="http://schemas.microsoft.com/sqlserver/reporting/2016/01/reportdefinition" xmlns:rd="http://schemas.microsoft.com/SQLServer/reporting/reportdesigner" xmlns:df="http://schemas.microsoft.com/sqlserver/reporting/2016/01/reportdefinition/defaultfontfamily">
  <df:DefaultFontFamily>Segoe UI</df:DefaultFontFamily>
  <AutoRefresh>0</AutoRefresh>
  <DataSources>
    <DataSource Name="DataSource1">
      <ConnectionProperties>
        <DataProvider>SQL</DataProvider>
        <ConnectString>Data Source=CT-MID-SQL11;Initial Catalog=AccessFrontEnds</ConnectString>
      </ConnectionProperties>
      <rd:SecurityType>DataBase</rd:SecurityType>
      <rd:DataSourceID>02a9f8c2-74b5-428f-a9e2-c97c35a6d94a</rd:DataSourceID>
    </DataSource>
  </DataSources>
  <DataSets>
    <DataSet Name="DataSet1">
      <Query>
        <DataSourceName>DataSource1</DataSourceName>
        <CommandText>select

FASTID ID
,Site
,DateCreated [Date Created]
,COALESCE(SOD,'') SOD
,d.PartNumber [Part Number]
,MKProjectID Project
,ItemGroup
,CASE FastStatusIndex
	WHEN 0 THEN 'Open'
	WHEN 1 THEN 'Closed'
	WHEN 2 THEN 'Submitted'
	WHEN 3 THEN 'Signing'
	WHEN 4 THEN 'Disposition Pending'
	WHEN 5 THEN 'Disposition Completed'
END Status
,FastItemID
,Qty Quantity
,Identifier
,ResponsibleUserName [Responsible User/Group]
,COALESCE(CASE FastDispositionID 
	WHEN 1 THEN 'Scrap at Zygo Cost'
	WHEN 2 THEN 'Rework at Zygo Cost'
	WHEN 3 THEN	'Return to Supplier'
	WHEN 4 THEN 'Part Number Change'
	WHEN 6 THEN 'No Problem Found'
	WHEN 7 THEN 'Use As Is'
	WHEN 9 THEN 'Repair in Line'
	WHEN 10 THEN 'Return to Customer'
	WHEN 11 THEN 'Issue to Job/Scrap to Job'
END,'') Disposition
,COALESCE(d.ReasonCode + ' (' + r.DESCRIPTION + ')','') [Reason Code]
,COALESCE(ReworkProdNumber,'') [Rework Production Number]
,COALESCE(SupplierRMANumber,'') [Supplier RMA Number]
,COALESCE(ReworkPONumber,'') [Rework PO Number]
,COALESCE(DateDispositioned,'') [Date Dispositioned]
,COALESCE(DispositionedByName,'') [Dispositioned by]
,COALESCE(CASE FastDispositionID
	WHEN 2 THEN s.[Total Cost]
	WHEN 1 THEN Qty * [Standard Cost]
 END,0)  [Rework/Scrap Cost]

 
from [FAST Dispositions] d

LEFT JOIN MMX_SCRAP_REASON_CODES r ON d.ReasonCode = r.SCRAP_REASON_CODE

LEFT JOIN [Scrap and Rework] s ON UPPER(d.ReworkProdNumber) = s.[Document No_]

LEFT JOIN NAV.ItemStandardCost c on c.partnumber = d.partnumber

where Site = 'Zygo Richmond'

order by FastID desc</CommandText>
        <rd:UseGenericDesigner>true</rd:UseGenericDesigner>
      </Query>
      <Fields>
        <Field Name="ID">
          <DataField>ID</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
        <Field Name="Site">
          <DataField>Site</DataField>
          <rd:TypeName>System.String</rd:TypeName>
