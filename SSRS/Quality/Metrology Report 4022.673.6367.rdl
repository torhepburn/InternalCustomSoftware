        <ConnectString>Data Source=ct-mid-db01.ametek.com;Initial Catalog=Dashboard</ConnectString>
      </ConnectionProperties>
      <rd:SecurityType>DataBase</rd:SecurityType>
      <rd:DataSourceID>1cfdf112-a0b9-4a75-b5a0-2ae1b562c17d</rd:DataSourceID>
    </DataSource>
  </DataSources>
  <DataSets>
    <DataSet Name="DataSet1">
      <Query>
        <DataSourceName>DataSource1</DataSourceName>
        <CommandText>SELECT 

[MetrologyDescription]
,[ItemNumber]
 ,[SerialNumber]
 ,COALESCE([DateEntered],'') DateEntered
 ,[Name] [Criteria]
 ,COALESCE(SimplePassFail,'') PassFail
 ,[Units]
 ,[LowerBoundary]
  ,COALESCE([Data],'') [Data]
  ,[UpperBoundary]
  ,COALESCE(Comments,'') Comments
  ,COALESCE(EnteredBy,'') EnteredBy
  ,[MetrologyDataStatus] [Status]

      
  FROM [Dashboard].[dbo].[VIEW_MetrologyMeasurementsDetails]

  WHERE DocumentNumber = '4022.673.6367'

  ORDER BY MetrologyDataID
</CommandText>
        <rd:UseGenericDesigner>true</rd:UseGenericDesigner>
      </Query>
