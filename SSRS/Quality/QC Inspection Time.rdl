<?xml version="1.0" encoding="utf-8"?>
<Report MustUnderstand="df" xmlns="http://schemas.microsoft.com/sqlserver/reporting/2016/01/reportdefinition" xmlns:rd="http://schemas.microsoft.com/SQLServer/reporting/reportdesigner" xmlns:df="http://schemas.microsoft.com/sqlserver/reporting/2016/01/reportdefinition/defaultfontfamily">
  <df:DefaultFontFamily>Segoe UI</df:DefaultFontFamily>
  <AutoRefresh>0</AutoRefresh>
  <DataSources>
    <DataSource Name="DataSource1">
      <ConnectionProperties>
        <DataProvider>SQL</DataProvider>
        <ConnectString>Data Source=ct-mid-sql11;Initial Catalog=AccessFrontEnds</ConnectString>
      </ConnectionProperties>
      <rd:SecurityType>DataBase</rd:SecurityType>
      <rd:DataSourceID>3e16be5f-1963-49ef-beea-5c7755074683</rd:DataSourceID>
    </DataSource>
  </DataSources>
  <DataSets>
    <DataSet Name="DataSet1">
      <Query>
        <DataSourceName>DataSource1</DataSourceName>
        <CommandText>WITH s1 AS
(
Select

MKReceiptTransactionID
,PartNumber
,OperatorName
,Location
,MovedToDate
,MovedToQty
,MovedOutDate
,MovedOutQty
,OriginalQty
,TimeInMin
,LocationTrackingID
,ReceiptNumber
,KanbanTransactionID
,RMAItemsNumber
,ServiceID
,Name as SignatureName

FROM [Middb01.zygo.com].dashboard.dbo.view_tracking t

LEFT JOIN [Middb01.zygo.com].dashboard.dbo.view_employees_all e 

on t.signatureBadgeID = e.BadgeID

where MkReceiptTransactionId &gt; 0

--and ((MovedOutDate &gt; (GETDATE()-90)) OR (MovedOutDate is null))
)


select 

OperatorName
,TimeInMin
,PartNumber
,MovedOutDate
,Location


from s1

WHERE Location like 'QC TEST%'

OR Location = 'QC PROCESS'</CommandText>
        <rd:UseGenericDesigner>true</rd:UseGenericDesigner>
      </Query>
      <Fields>
        <Field Name="OperatorName">
          <DataField>OperatorName</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="TimeInMin">
          <DataField>TimeInMin</DataField>
          <rd:TypeName>System.Double</rd:TypeName>
        </Field>
        <Field Name="PartNumber">
          <DataField>PartNumber</DataField>
