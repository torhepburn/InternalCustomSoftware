        </QueryParameters>
        <CommandText>USE CALIBRATION;

SELECT 

	e.[ID]
      ,[Description]
      ,[DESC2]
      ,[SN]
      ,[MANUF]
      ,[MODEL]
      ,[SIZE]
      ,[DATE_NEW]
      ,[PURCHCOST]
