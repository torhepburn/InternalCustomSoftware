      ,[HISTORY3]
      ,[TEMP]
      ,[HUM]
      ,[PRESS]
      ,[PAR1B4]
      ,[PAR1PF]
      ,[PAR1AFT]
      ,[PAR1COND]
      ,[PAR2B4]
      ,[PAR2PF]
      ,[PAR2AFT]
      ,[PAR2COND]
      ,[PAR3B4]
      ,[PAR3PF]
      ,[PAR3AFT]
      ,[PAR3COND]
      ,[PAR4B4]
      ,[PAR4PF]
      ,[PAR4AFT]
      ,[PAR4COND]
      ,[PAR5B4]
      ,[PAR5PF]
      ,[PAR5AFT]
      ,[PAR5COND]
      ,[PAR6B4]
      ,[PAR6PF]
      ,[PAR6AFT]
      ,[PAR6COND]
      ,[PFBeforeCal]
      ,[PFAfterCal]
      ,[CORACT]
      ,[REFSTD1]
      ,[REFSTD1DATE]
      ,[REFSTD2]
      ,[REFSTD2DATE]
      ,[CERTNUM]
      ,[MEASUNCERT]
      ,[LIMITATIONS]
      ,[CALDATE_OUT]
      ,[CALDATE_IN]
      ,[CALTIME_DAYS]
      ,[Inspector]
      ,[LabelHyperlink]
      ,[OLD_REFSTD1]
      ,[OLD_REFSTD2]
      ,[EMAIL_OutOfSpec]
      ,[CurrentHistory]
      ,[CertPDF]
      ,[yesCertPDF]
      ,[Riskpdf]
      ,[yesRiskpdf]
      ,[Docspdf]
      ,[yesDocspdf]
      ,[Repairpdf]
      ,[yesRepairpdf]
      ,[calsourceDiscontinue]

FROM Equipment e INNER JOIN CalibrationData d

ON e.id = d.item

WHERE e.ID = @ItemID

ORDER BY d.Cal_Date</CommandText>
        <rd:UseGenericDesigner>true</rd:UseGenericDesigner>
      </Query>
