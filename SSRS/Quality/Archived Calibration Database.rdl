      ,[Manufacturer]
	  ,[ITEM]
      ,[CHG_DATE]
      ,[CAL_DATE]
      ,[CAL_INT]
      ,[CAL_NEXT]
      ,[CALSOURCE]
      ,[CALFEE]
      ,[HISTORY1]
