          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Country">
          <DataField>Country</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="NDA_ID">
          <DataField>NDA_ID</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
        <Field Name="PDF">
          <DataField>PDF</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Inactive_for_Procurement">
          <DataField>Inactive for Procurement</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
