      </ConnectionProperties>
      <rd:SecurityType>DataBase</rd:SecurityType>
      <rd:DataSourceID>300c140e-bc6d-4187-b6b1-2b4143e16add</rd:DataSourceID>
    </DataSource>
  </DataSources>
  <DataSets>
    <DataSet Name="DataSet1">
      <Query>
        <DataSourceName>DataSource1</DataSourceName>
        <CommandText>SELECT
      NDA_ID
	  ,[Company]
      ,[DateRcvd]
      ,[DateSigned]
      ,[PeriodEnds]
      ,[Administrator]
      ,[ZygoSigner]
      ,[Status]
      
  FROM [ZygoNonDisclosureAgreements].[dbo].[NDA]

  WHERE 
  
  PeriodEnds &gt;= '2021-06-01'

  AND PeriodEnds &lt;= '2022-01-31'</CommandText>
        <rd:UseGenericDesigner>true</rd:UseGenericDesigner>
      </Query>
      <Fields>
        <Field Name="NDA_ID">
          <DataField>NDA_ID</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
