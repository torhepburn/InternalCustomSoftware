      <rd:DataSourceID>36860f14-5665-49fe-804e-b45dec567e07</rd:DataSourceID>
    </DataSource>
  </DataSources>
  <DataSets>
    <DataSet Name="DataSet1">
      <Query>
        <DataSourceName>DataSource1</DataSourceName>
        <CommandText>SELECT

ProdLine
,Company
,Status
,PartyProtected
,DateSigned EffectiveDate
,PeriodEnds ExpirationDate

FROM NDA 

WHERE restricted = 0 AND

Status not in ( 'Terminated', 'Dead Issue', 'Expired')

ORDER BY Company</CommandText>
        <rd:UseGenericDesigner>true</rd:UseGenericDesigner>
      </Query>
