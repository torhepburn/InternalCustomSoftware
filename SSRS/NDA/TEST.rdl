  <AutoRefresh>0</AutoRefresh>
  <DataSources>
    <DataSource Name="NDAdataSource">
      <DataSourceReference>NDAdataSource</DataSourceReference>
      <rd:SecurityType>None</rd:SecurityType>
      <rd:DataSourceID>2f181edd-6fd1-469e-9e85-572f24bd1287</rd:DataSourceID>
    </DataSource>
  </DataSources>
  <DataSets>
    <DataSet Name="DataSet1">
      <Query>
        <DataSourceName>NDAdataSource</DataSourceName>
        <QueryParameters>
          <QueryParameter Name="@ID">
            <Value>=Parameters!ID.Value</Value>
          </QueryParameter>
          <QueryParameter Name="NDA_ID">
            <Value>=Parameters!ID.Value</Value>
            <rd:UserDefined>true</rd:UserDefined>
          </QueryParameter>
        </QueryParameters>
        <CommandText>SELECT 

NDA_ID, 
StoredPDF


FROM NDA

WHERE NDA_ID = @ID</CommandText>
        <rd:UseGenericDesigner>true</rd:UseGenericDesigner>
      </Query>
      <Fields>
        <Field Name="NDA_ID">
          <DataField>NDA_ID</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
        <Field Name="StoredPDF">
          <DataField>StoredPDF</DataField>
          <rd:TypeName>System.Boolean</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
  </DataSets>
