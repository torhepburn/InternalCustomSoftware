          <rd:TypeName>System.DateTime</rd:TypeName>
        </Field>
        <Field Name="Shipment_Creator">
          <DataField>Shipment Creator</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Posting_Date">
          <DataField>Posting Date</DataField>
          <rd:TypeName>System.DateTime</rd:TypeName>
        </Field>
        <Field Name="Sales_Order_Creator">
          <DataField>Sales Order Creator</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Document_Type">
          <DataField>Document Type</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Line_Type">
          <DataField>Line Type</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
