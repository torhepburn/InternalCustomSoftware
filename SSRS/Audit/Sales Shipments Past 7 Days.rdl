<?xml version="1.0" encoding="utf-8"?>
<Report MustUnderstand="df" xmlns="http://schemas.microsoft.com/sqlserver/reporting/2016/01/reportdefinition" xmlns:rd="http://schemas.microsoft.com/SQLServer/reporting/reportdesigner" xmlns:df="http://schemas.microsoft.com/sqlserver/reporting/2016/01/reportdefinition/defaultfontfamily">
  <df:DefaultFontFamily>Segoe UI</df:DefaultFontFamily>
  <AutoRefresh>0</AutoRefresh>
  <DataSources>
    <DataSource Name="NAV">
      <DataSourceReference>NAV</DataSourceReference>
      <rd:SecurityType>None</rd:SecurityType>
      <rd:DataSourceID>ffeb141f-5435-49af-9ac9-f96e35fe4307</rd:DataSourceID>
    </DataSource>
  </DataSources>
  <DataSets>
    <DataSet Name="DataSet1">
      <Query>
        <DataSourceName>NAV</DataSourceName>
        <CommandText>WITH s1 AS
(

SELECT

h.No_ [Sales Order No_]
, [SO Line No_]
,h.[Order Date]
,h.[Assigned User ID]
,CASE h.[Document Type]
	WHEN 1 THEN 'Order'
	WHEN 4 THEN 'Blanket Order'
	WHEN 5 THEN 'Return Order'
END [Document Type]
,CASE l.[Type]
	WHEN 1 THEN 'G/L Account'
	WHEN 2 THEN 'Item'
	WHEN 3 THEN 'Resource'
	WHEN 4 THEN 'Fixed Asset'
	WHEN 5 THEN 'Charge(Item)'
END [Line Type]

FROM [ZYGO$Sales Header] h

INNER JOIN [ZYGO$Sales Line] l ON h.No_ = l.[Document No_]

WHERE h.[Order Date] &gt;= '2021-01-01'

AND h.[Document Type] IN (1,4,5)
)
, s2 AS

(

SELECT

h.No_ [Shipment Document No_]
,h.[Order No_] [Sales Order no_]
, [SO Line No_]
,h.[Posting Date]
,h.[User ID]
--,CASE h.[Document Type]
--	WHEN 1 THEN 'Order'
--	WHEN 4 THEN 'Blanket Order'
--	WHEN 5 THEN 'Return Order'
--END [Document Type]

FROM [ZYGO$Sales Shipment Header] h

INNER JOIN [ZYGO$Sales Shipment Line] l ON h.No_ = l.[Document No_]

WHERE h.[Posting Date] &gt;= GETDATE() - 7



)

SELECT

[Shipment Document No_]
,[Sales Order No_]
,s1.[SO Line No_]
,s1.[Order Date]
,[User ID] [Shipment Creator]
,s2.[Posting Date]
,[Assigned User ID] [Sales Order Creator]
,[Document Type]
,[Line Type]



FROM s2 INNER JOIN s1 ON s2.[Sales Order no_] = s1.[Sales Order No_]

AND s2.[SO Line No_] = s1.[SO Line No_]

AND s2.[User ID] = s1.[Assigned User ID]</CommandText>
        <rd:UseGenericDesigner>true</rd:UseGenericDesigner>
      </Query>
      <Fields>
        <Field Name="Shipment_Document_No_">
          <DataField>Shipment Document No_</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Sales_Order_No_">
          <DataField>Sales Order No_</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="SO_Line_No_">
          <DataField>SO Line No_</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
        <Field Name="Order_Date">
