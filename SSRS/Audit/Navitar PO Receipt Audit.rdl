  <df:DefaultFontFamily>Segoe UI</df:DefaultFontFamily>
  <AutoRefresh>0</AutoRefresh>
  <DataSources>
    <DataSource Name="NAVITAR">
      <DataSourceReference>NAVITAR</DataSourceReference>
      <rd:SecurityType>None</rd:SecurityType>
      <rd:DataSourceID>1bf07402-dfbd-455d-b0e5-ed1f67609776</rd:DataSourceID>
    </DataSource>
  </DataSources>
  <DataSets>
    <DataSet Name="DataSet1">
      <Query>
        <DataSourceName>NAVITAR</DataSourceName>
        <QueryParameters>
          <QueryParameter Name="@startingdate">
            <Value>=Parameters!startingdate.Value</Value>
          </QueryParameter>
          <QueryParameter Name="@endingdate">
            <Value>=Parameters!endingdate.Value</Value>
          </QueryParameter>
        </QueryParameters>
        <CommandText>select

       t.[site_ref] [Site]
      ,[trans_num] [Transaction Number]
      ,[trans_date] [Transaction Date]
      ,CASE [trans_type] 
            WHEN 'R' THEN 'Receipt'
            ELSE ''
       END [Transaction Type]
      ,CASE ref_type
            WHEN 'P' THEN 'Purchase Order'
            ELSE ''
       END [Reference Type]
      ,[Backflush]
      ,COALESCE([whse],'') [Warehouse]
      ,COALESCE([loc],'') [Location]
      ,COALESCE([Lot],'') Lot
      ,COALESCE([wc],'') [Work Center]
      ,[ref_num] [Reference Number]
      ,[ref_line_suf] [Ref Line]
      ,[ref_release] [Ref Release]
      ,COALESCE(t.[reason_code],'') [Reason Code]
      ,COALESCE(r.Description,'') [Reason Description]
      ,[Item]
      ,[qty] [Quantity]
      
      
      ,[matl_cost] [Material Cost]
      ,[lbr_cost] [Labor Cost]
      ,[Fovhd_cost]
      ,[Vovhd_cost]
      ,[out_cost] [Outside Cost]
      ,[cost]
      ,[user_code] [User]
      ,COALESCE([cost_code],'') [Cost Code]
      ,COALESCE([emp_num],'') [Employee]
      ,t.createDate

from matltran_mst t

LEFT JOIN reason_mst r ON t.reason_code = r.reason_code

WHERE 

trans_type = 'R'

AND trans_date &gt;= @startingdate

AND trans_date &lt;= @endingdate

order by trans_num</CommandText>
        <rd:UseGenericDesigner>true</rd:UseGenericDesigner>
      </Query>
