        </Field>
        <Field Name="New_Value">
          <DataField>New Value</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Primary_Key_Field_1_Value">
          <DataField>Primary Key Field 1 Value</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
