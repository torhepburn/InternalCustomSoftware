      <rd:SecurityType>None</rd:SecurityType>
      <rd:DataSourceID>37edfba6-93db-43a0-9e7c-c2d78ca7a13f</rd:DataSourceID>
    </DataSource>
  </DataSources>
  <DataSets>
    <DataSet Name="DataSet1">
      <Query>
        <DataSourceName>NAV</DataSourceName>
        <CommandText>SELECT top 3000

[Date and Time]
, [User ID]
,[Table No_]
,[Field No_]
,[Type of Change]
,[Old Value]
,[New Value]
,[Primary Key Field 1 Value]


FROM [ZYGO$Change Log Entry]

WHERE [Table No_] = 27

AND [Field No_] = 24

AND [Date and Time] &gt;'2022-02-28'

--AND [Primary Key Field 1 Value] = '6401-0198-03'

ORDER BY [Date and Time] DESC</CommandText>
        <rd:UseGenericDesigner>true</rd:UseGenericDesigner>
      </Query>
      <Fields>
        <Field Name="Date_and_Time">
          <DataField>Date and Time</DataField>
          <rd:TypeName>System.DateTime</rd:TypeName>
        </Field>
        <Field Name="User_ID">
          <DataField>User ID</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Table_No_">
          <DataField>Table No_</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
        <Field Name="Field_No_">
          <DataField>Field No_</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
        <Field Name="Type_of_Change">
          <DataField>Type of Change</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
        <Field Name="Old_Value">
          <DataField>Old Value</DataField>
