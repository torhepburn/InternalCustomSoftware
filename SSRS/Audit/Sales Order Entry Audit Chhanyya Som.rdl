      <rd:DataSourceID>f2544793-d558-44a7-89ae-3352a6816f69</rd:DataSourceID>
    </DataSource>
  </DataSources>
  <DataSets>
    <DataSet Name="DataSet1">
      <Query>
        <DataSourceName>NAV</DataSourceName>
        <QueryParameters>
          <QueryParameter Name="@start">
            <Value>=Parameters!start.Value</Value>
          </QueryParameter>
          <QueryParameter Name="@end">
            <Value>=Parameters!end.Value</Value>
          </QueryParameter>
        </QueryParameters>
        <CommandText>SELECT 

No_ [SO#]
,[Bill-to Name] [Customer]
,[Order Date] [Creation Date]
,[Assigned User ID]

FROM [ZYGO$Sales Header]

WHERE ([Order Date] &gt;= @start and [Order Date] &lt;= @end)

AND [Assigned User ID] like '%CSOM'

ORDER BY 

[Order Date], No_</CommandText>
        <rd:UseGenericDesigner>true</rd:UseGenericDesigner>
      </Query>
      <Fields>
        <Field Name="SO_">
          <DataField>SO#</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Customer">
          <DataField>Customer</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Creation_Date">
          <DataField>Creation Date</DataField>
          <rd:TypeName>System.DateTime</rd:TypeName>
        </Field>
        <Field Name="Assigned_User_ID">
          <DataField>Assigned User ID</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
