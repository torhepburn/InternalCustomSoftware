  <df:DefaultFontFamily>Segoe UI</df:DefaultFontFamily>
  <AutoRefresh>0</AutoRefresh>
  <DataSources>
    <DataSource Name="NAVITAR">
      <DataSourceReference>NAVITAR</DataSourceReference>
      <rd:SecurityType>None</rd:SecurityType>
      <rd:DataSourceID>54d7bc7b-2815-4f53-93ec-a839a2b36ef8</rd:DataSourceID>
    </DataSource>
  </DataSources>
  <DataSets>
    <DataSet Name="DataSet1">
      <Query>
        <DataSourceName>NAVITAR</DataSourceName>
        <QueryParameters>
          <QueryParameter Name="@startingdate">
            <Value>=Parameters!startingdate.Value</Value>
          </QueryParameter>
          <QueryParameter Name="@endingdate">
            <Value>=Parameters!endingdate.Value</Value>
          </QueryParameter>
        </QueryParameters>
        <CommandText>select 


c.site_ref [Site]
,co_num [SO]
,CASE
	[type]
	WHEN 'B' THEN 'Long Term Agreement'
	WHEN 'R' THEN 'Regular Order'
	WHEN 'E' THEN 'Estimate/Quote'
	WHEN 'I' THEN 'Intercompany'
	WHEN 'T' THEN 'Transfer'
	ELSE ''
END [Order Type]
,c.CreateDate [Creation Date]
,a.Name [Customer]
,c.CreatedBy [Created By]


from co_mst c

LEFT JOIN custaddr_mst a ON c.cust_num = a.cust_num



WHERE a.cust_seq = 0

AND c.CreateDate &gt;= @startingdate

AND c.CreateDate &lt;= @endingdate</CommandText>
        <rd:UseGenericDesigner>true</rd:UseGenericDesigner>
      </Query>
      <Fields>
        <Field Name="Site">
          <DataField>Site</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="SO">
          <DataField>SO</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Order_Type">
          <DataField>Order Type</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Creation_Date">
          <DataField>Creation Date</DataField>
          <rd:TypeName>System.DateTime</rd:TypeName>
        </Field>
        <Field Name="Customer">
          <DataField>Customer</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Created_By">
          <DataField>Created By</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
  </DataSets>
