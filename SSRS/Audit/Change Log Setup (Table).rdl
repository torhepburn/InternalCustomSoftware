<?xml version="1.0" encoding="utf-8"?>
<Report MustUnderstand="df" xmlns="http://schemas.microsoft.com/sqlserver/reporting/2016/01/reportdefinition" xmlns:rd="http://schemas.microsoft.com/SQLServer/reporting/reportdesigner" xmlns:df="http://schemas.microsoft.com/sqlserver/reporting/2016/01/reportdefinition/defaultfontfamily">
  <df:DefaultFontFamily>Segoe UI</df:DefaultFontFamily>
  <AutoRefresh>0</AutoRefresh>
  <DataSources>
    <DataSource Name="NAV">
      <DataSourceReference>NAV</DataSourceReference>
      <rd:SecurityType>None</rd:SecurityType>
      <rd:DataSourceID>2999bba9-a921-49b9-af5d-8d7e87426eb1</rd:DataSourceID>
    </DataSource>
  </DataSources>
  <DataSets>
    <DataSet Name="DataSet1">
      <Query>
        <DataSourceName>NAV</DataSourceName>
        <CommandText>select

t.[Table No_]
,o.Name
,CASE t.[Log Insertion]
	WHEN 0 THEN ''
	WHEN 1 THEN 'Some Fields'
	WHEN 2 THEN 'All Fields'
END [Log Insertion]
,CASE t.[Log Modification]
WHEN 0 THEN ''
	WHEN 1 THEN 'Some Fields'
	WHEN 2 THEN 'All Fields'
END [Log Modification]
,CASE t.[Log Deletion]
WHEN 0 THEN ''
	WHEN 1 THEN 'Some Fields'
	WHEN 2 THEN 'All Fields'
END [Log Deletion ]
,t.[Type of Logging]
,t.[Retention Period]
,t.[Retention Period Text]


from [ZYGO$Change Log Setup (Table)] t

LEFT JOIN [Object] o ON t.[Table No_] = o.ID

WHERE [BLOB Reference] is null</CommandText>
        <rd:UseGenericDesigner>true</rd:UseGenericDesigner>
      </Query>
      <Fields>
        <Field Name="Table_No_">
          <DataField>Table No_</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
        <Field Name="Name">
          <DataField>Name</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Log_Insertion">
          <DataField>Log Insertion</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Log_Modification">
          <DataField>Log Modification</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Log_Deletion_">
          <DataField>Log Deletion </DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Type_of_Logging">
          <DataField>Type of Logging</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
        <Field Name="Retention_Period">
          <DataField>Retention Period</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Retention_Period_Text">
          <DataField>Retention Period Text</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
  </DataSets>
