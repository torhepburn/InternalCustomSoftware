  <DataSources>
    <DataSource Name="NAVITAR">
      <DataSourceReference>NAVITAR</DataSourceReference>
      <rd:SecurityType>None</rd:SecurityType>
      <rd:DataSourceID>02416df7-397a-424e-9ab5-7445ef6073d8</rd:DataSourceID>
    </DataSource>
  </DataSources>
  <DataSets>
    <DataSet Name="DataSet1">
      <Query>
        <DataSourceName>NAVITAR</DataSourceName>
        <CommandText>select

n.UserName [User Name]
,COALESCE(UserDesc,'') [User Description]
,CASE EditLevel
	WHEN 0 THEN 'None'
	WHEN 2 THEN 'Full User'
	WHEN 3 THEN 'Site Developer'
	ELSE ''
END [Editing Permissions]
,SuperUserFlag [Super User]
,COALESCE(WorkstationLogin,'') [Workstation Domain/ID]
,CASE Status
	WHEN 0 THEN 'Active'
	WHEN 2 THEN 'Disabled'
END [User Login Status]
,LoginFailures [Login Failures]
,LastActiveDate [Last Active Date]
,LEFT(UPPER(n.username),2) [User Initials]


from UserNames n

WHERE [Status] = 0

ORDER BY [User Name]</CommandText>
        <rd:UseGenericDesigner>true</rd:UseGenericDesigner>
      </Query>
      <Fields>
        <Field Name="User_Name">
          <DataField>User Name</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="User_Description">
          <DataField>User Description</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Editing_Permissions">
          <DataField>Editing Permissions</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Super_User">
          <DataField>Super User</DataField>
          <rd:TypeName>System.Byte</rd:TypeName>
        </Field>
        <Field Name="Workstation_Domain_ID">
          <DataField>Workstation Domain/ID</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="User_Login_Status">
          <DataField>User Login Status</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Login_Failures">
          <DataField>Login Failures</DataField>
          <rd:TypeName>System.Int16</rd:TypeName>
        </Field>
        <Field Name="Last_Active_Date">
          <DataField>Last Active Date</DataField>
          <rd:TypeName>System.DateTime</rd:TypeName>
        </Field>
        <Field Name="User_Initials">
          <DataField>User Initials</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
