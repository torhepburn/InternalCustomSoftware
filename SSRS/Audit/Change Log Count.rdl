<Report MustUnderstand="df" xmlns="http://schemas.microsoft.com/sqlserver/reporting/2016/01/reportdefinition" xmlns:rd="http://schemas.microsoft.com/SQLServer/reporting/reportdesigner" xmlns:df="http://schemas.microsoft.com/sqlserver/reporting/2016/01/reportdefinition/defaultfontfamily">
  <df:DefaultFontFamily>Segoe UI</df:DefaultFontFamily>
  <AutoRefresh>0</AutoRefresh>
  <DataSources>
    <DataSource Name="NAV">
      <DataSourceReference>NAV</DataSourceReference>
      <rd:SecurityType>None</rd:SecurityType>
      <rd:DataSourceID>3f6fc0c8-ba07-4b90-bf49-ee07f1cb54f7</rd:DataSourceID>
    </DataSource>
  </DataSources>
  <DataSets>
    <DataSet Name="DataSet1">
      <Query>
        <DataSourceName>NAV</DataSourceName>
        <QueryParameters>
          <QueryParameter Name="@tableNumber">
            <Value>=Parameters!tableNumber.Value</Value>
          </QueryParameter>
          <QueryParameter Name="@lessthanDate">
            <Value>=Parameters!lessthanDate.Value</Value>
          </QueryParameter>
        </QueryParameters>
        <CommandText>select  COUNT([Entry No_]) [Number of Entries]
,[Table No_]
,GETDATE() [Data as of Date]

 from [ZYGO$Change Log Entry] where [Table No_] = @tableNumber

 AND [Date and Time] &lt; @lessthanDate

GROUP BY [Table No_]</CommandText>
        <rd:UseGenericDesigner>true</rd:UseGenericDesigner>
      </Query>
      <Fields>
        <Field Name="Number_of_Entries">
          <DataField>Number of Entries</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
        <Field Name="Table_No_">
          <DataField>Table No_</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
        <Field Name="Data_as_of_Date">
          <DataField>Data as of Date</DataField>
          <rd:TypeName>System.DateTime</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
  </DataSets>
