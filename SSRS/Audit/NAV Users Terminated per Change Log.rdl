      <rd:DataSourceID>c7207c9f-1d26-440e-af2b-9e4897ed32fa</rd:DataSourceID>
    </DataSource>
  </DataSources>
  <DataSets>
    <DataSet Name="DataSet1">
      <Query>
        <DataSourceName>NAV</DataSourceName>
        <CommandText>select 

[Date and Time]
,[Old Value]
,[New Value]

from [ZYGO$Change Log Entry] 


where [Table No_] = 2000000120

AND [Field No_] IN (3,4)

AND [Date and Time] &gt;= '2026-04-01'

AND [Date and Time] &lt; '2026-07-01'

AND ([New Value] like '%TERM%' OR [New Value] like '%erm%')

ORDER BY [Old Value]</CommandText>
        <rd:UseGenericDesigner>true</rd:UseGenericDesigner>
      </Query>
      <Fields>
        <Field Name="Date_and_Time">
          <DataField>Date and Time</DataField>
          <rd:TypeName>System.DateTime</rd:TypeName>
        </Field>
        <Field Name="Old_Value">
          <DataField>Old Value</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="New_Value">
          <DataField>New Value</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
  </DataSets>
