<?xml version="1.0" encoding="utf-8"?>
<Report MustUnderstand="df" xmlns="http://schemas.microsoft.com/sqlserver/reporting/2016/01/reportdefinition" xmlns:rd="http://schemas.microsoft.com/SQLServer/reporting/reportdesigner" xmlns:df="http://schemas.microsoft.com/sqlserver/reporting/2016/01/reportdefinition/defaultfontfamily">
  <df:DefaultFontFamily>Segoe UI</df:DefaultFontFamily>
  <AutoRefresh>0</AutoRefresh>
  <DataSources>
    <DataSource Name="NAV">
      <DataSourceReference>NAV</DataSourceReference>
      <rd:SecurityType>None</rd:SecurityType>
      <rd:DataSourceID>996bf77b-9b49-463c-93a9-d307a6a815d6</rd:DataSourceID>
    </DataSource>
  </DataSources>
  <DataSets>
    <DataSet Name="DataSet1">
      <Query>
        <DataSourceName>NAV</DataSourceName>
        <CommandText>/*	SSRS SER Shipments	*/

select 

 [Document No_] 
 --,[Line No_]
--[Order No_]
,[SO Line No_]
,Quantity
--,[Quantity Invoiced]
,[Quantity] * [Unit Price] [Dollar Amount]
--,[VAT Base Amount]
--,[Item Charge Base Amount]
,No_
,Description
,COALESCE([Text],'') LineText
,CASE Type
	WHEN 2 THEN 'Item'
	WHEN 3 THEN 'Resource'
End Type
,[Location Code]
,[Job No_]
,[Shipment Date]
--,[Posting Date]
--,[Dimension Set ID]
--,[Text Set ID]
--,[Job Line Unique No_]
--,WBS

from [ZYGO$Sales Line] sl

LEFT JOIN [ZYGO$Text Module Line Document] t ON sl.[Text Set ID] = t.[Text ID]


where No_ = 'SER'

AND [Shipment Date] &gt; GETDATE() --CAST(GETDATE()-1 as date) 

--CAST('2023-01-05' as DATE)

--AND [Location Code] IN ('MID', 'MID SVC')

--AND Type = 2 --Item

--AND Quantity &gt; 0

--RDER BY [Posting Date] DESC

--AND [Document No_] = '10158'</CommandText>
        <rd:UseGenericDesigner>true</rd:UseGenericDesigner>
      </Query>
