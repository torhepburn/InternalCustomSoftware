<?xml version="1.0" encoding="utf-8"?>
<Report xmlns="http://schemas.microsoft.com/sqlserver/reporting/2016/01/reportdefinition" xmlns:rd="http://schemas.microsoft.com/SQLServer/reporting/reportdesigner" xmlns:df="http://schemas.microsoft.com/sqlserver/reporting/2016/01/reportdefinition/defaultfontfamily" MustUnderstand="df">
  <df:DefaultFontFamily>Segoe UI</df:DefaultFontFamily>
  <AutoRefresh>0</AutoRefresh>
  <DataSources>
    <DataSource Name="NAV">
      <DataSourceReference>NAV</DataSourceReference>
      <rd:SecurityType>None</rd:SecurityType>
      <rd:DataSourceID>91bf2af6-6519-4910-9874-b449b67626f0</rd:DataSourceID>
    </DataSource>
  </DataSources>
  <DataSets>
    <DataSet Name="DataSet1">
      <Query>
        <DataSourceName>NAV</DataSourceName>
        <CommandText>select
 
 [Primary Key Field 1 Value] 
,[Date and Time]
,[User ID]
,[Table No_]
,CASE [Field No_]
	WHEN 20 THEN 'Profit %'
	WHEN 22 THEN 'Unit Cost'
	WHEN 24 THEN 'Standard Cost'
	WHEN 25 THEN 'Last Direct Cost'
	WHEN 29 THEN 'Cost is Adjusted'
	WHEN 62 THEN 'Last Date Modified date'
	WHEN 63 THEN 'Last Time Modified time'
	WHEN 5400 THEN 'Low-Level Code'
	WHEN 5403 THEN 'Last Unit cost Calc. Date date'
	WHEN 5404 THEN 'Rolled-up Material Cost'
	WHEN 5405 THEN 'Rolled-up Capacity Cost'
	WHEN 7380 THEN 'Phys Invt Counting Period Code'
	WHEN 7381 THEN 'Last Counting Period Update date'
	WHEN 7386 THEN 'Next counting End Date date'
	WHEN 7385 THEN 'Next counting Start Date date'
	WHEN 50041 THEN 'P6'
	WHEN 50042 THEN 'F6'
	WHEN 50043 THEN 'EAU'
	WHEN 50044 THEN 'FAI Class'
	WHEN 50053 THEN 'Last Modified by'
	WHEN 50054 THEN 'Last Modified Date-Time datetime'
	WHEN 99000752 THEN 'Single-Level Material Cost'
	WHEN 99000753 THEN 'Single-Level Capacity Cost'
	WHEN 99000755 THEN 'Single-Level Cap. Ovhd Cost'
	WHEN 99000760 THEN 'Rolled-up Cap. Overhead Cost'
	ELSE 'Not Coded'
END [Field]
,[Type of Change]
,[Old Value]
,[New Value]

 from [ZYGO$Change Log Entry] 

where 

[Table No_] = 27

--and [Date and Time] &gt; '2022-01-01'

--and [Primary Key Field 1 Value] like '%1420-490-078%'

AND [Field No_] = 7380

ORDER BY [New Value]</CommandText>
        <rd:UseGenericDesigner>true</rd:UseGenericDesigner>
      </Query>
      <Fields>
        <Field Name="Primary_Key_Field_1_Value">
          <DataField>Primary Key Field 1 Value</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Date_and_Time">
          <DataField>Date and Time</DataField>
          <rd:TypeName>System.DateTime</rd:TypeName>
        </Field>
        <Field Name="User_ID">
          <DataField>User ID</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Table_No_">
          <DataField>Table No_</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
        <Field Name="Field">
          <DataField>Field</DataField>
