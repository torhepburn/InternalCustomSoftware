<?xml version="1.0" encoding="utf-8"?>
<Report MustUnderstand="df" xmlns="http://schemas.microsoft.com/sqlserver/reporting/2016/01/reportdefinition" xmlns:rd="http://schemas.microsoft.com/SQLServer/reporting/reportdesigner" xmlns:df="http://schemas.microsoft.com/sqlserver/reporting/2016/01/reportdefinition/defaultfontfamily">
  <df:DefaultFontFamily>Segoe UI</df:DefaultFontFamily>
  <AutoRefresh>0</AutoRefresh>
  <DataSources>
    <DataSource Name="NAV">
      <DataSourceReference>NAV</DataSourceReference>
      <rd:SecurityType>None</rd:SecurityType>
      <rd:DataSourceID>af218900-e5c0-40e4-b806-1ef96ea56d92</rd:DataSourceID>
    </DataSource>
  </DataSources>
  <DataSets>
    <DataSet Name="DataSet1">
      <Query>
        <DataSourceName>NAV</DataSourceName>
        <CommandText>SELECT

[Date and Time]
, [User ID]
--,[Table No_]
,[Field No_]
,CASE [Field No_]
	WHEN 1 THEN 'Document Type'
	WHEN 2 THEN 'Sell-to Customer No.'
	WHEN 3 THEN 'Document No.'
	WHEN 6 THEN 'No.'
	WHEN 8 THEN 'Posting Group'
	WHEN 10 THEN 'Shipment Date'
	
	WHEN 11 THEN 'Description'
	WHEN 15 THEN 'Quantity'
	WHEN 16 THEN 'Outstanding Quantity'

	WHEN 22 THEN 'Unit Price'
	WHEN 23 THEN 'Unit Cost (LCY)'
	WHEN 29 THEN 'Amount'
	WHEN 30 THEN 'Amount Including VAT'
	WHEN 35 THEN 'Net Weight'

	WHEN 41 THEN 'Shortcut Dimensioin 2 Code'
	WHEN 57 THEN 'Outstanding Amount'
	WHEN 60 THEN 'Quantity Shipped'
	WHEN 61 THEN 'Quantity Invoiced'
	WHEN 68 THEN 'Bill-to Customer No.'
	
	WHEN 73 THEN 'Reason Code'

	WHEN 85 THEN 'Tax Area Code'
	WHEN 86 THEN 'Tax Liable'
	WHEN 87 THEN 'Tax Group Code'

	WHEN 91 THEN 'Currency Code'
	WHEN 92 THEN 'Outstanding Amount (LCY)'
	WHEN 99 THEN 'VAT Base Amount'

	WHEN 100 THEN 'Unit Cost'
	WHEN 103 THEN 'Line Amount'

	WHEN 118 THEN 'Prepayment Tax Area Code'
	WHEN 119 THEN 'Prepayment Tax Liable'

	WHEN 5400 THEN 'Low-Level Code'
	WHEN 5403 THEN 'Bin Code'
	WHEN 5415 THEN 'Quantity (Base)'
	WHEN 5416 THEN 'Outstanding Qty. (Base)'
	
	WHEN 5705 THEN 'Cross Reference No.'
	WHEN 5706 THEN 'Unit of Measure (Cross Ref.)'
	WHEN 5707 THEN 'Cross Reference Type'
	WHEN 5708 THEN 'Cross Reference Type No.'
	WHEN 5709 THEN 'Item Category Code'
	
	WHEN 5790 THEN 'Requested Delivery Date'
	WHEN 5791 THEN 'Promised Deliver Date'
	WHEN 5794 THEN 'Planned Delivery Date'
	WHEN 5795 THEN 'Planned Shipment Date'
	WHEN 5796 THEN 'Shipping Agent Code'
	WHEN 5797 THEN 'Shipping Agent Service Code'

	
	WHEN 5813 THEN 'Inventory Posting Setup'
	
	WHEN 7001 THEN 'Allow Line Disc.'
	
	WHEN 9000 THEN 'Assigned User ID'
	WHEN 50000 THEN 'SO Line No.'
	WHEN 50001 THEN 'Orig. Requested Delivery Date'
	WHEN 50002 THEN 'Orig. Promised Delivery Date'
	WHEN 50004 THEN 'Shipping Account'
	WHEN 50005 THEN 'Contract Date'
	WHEN 50006 THEN 'Overtime Applicable'

	WHEN 5012583 THEN 'Sell-to Contact No.'
	WHEN 5013001 THEN 'Unit Price (LCY)'
	WHEN 5013482 THEN 'Description 5'
	WHEN 5013730 THEN 'Ending Date'
	WHEN 5013760 THEN 'Ending Date-Time'
	WHEN 5060610 THEN 'Last Modified by'
	WHEN 50054 THEN 'Last Modified Date-Time datetime'
	WHEN 99000752 THEN 'Single-Level Material Cost'
	WHEN 99000753 THEN 'Single-Level Capacity Cost'
	WHEN 99000755 THEN 'Single-Level Cap. Ovhd Cost'
	WHEN 99000760 THEN 'Rolled-up Cap. Overhead Cost'
	ELSE 'Not Coded'
END [Field]
--,[Type of Change]
--,CASE
--	WHEN [Field No_] = 50018 THEN
--COALESCE(CASE [Old Value]
--	WHEN '1' THEN 'Customer Requested Hold'
--	WHEN '2' THEN 'Lack of PO'
--	WHEN '3' THEN 'Lack of L/C or License'
--	WHEN '4' THEN 'Change Order Required'
--	WHEN '5' THEN 'No Back Orders Allowed'
--	WHEN '6' THEN 'Sales Administration'
--	WHEN '7' THEN 'Required Bar Code'
--	WHEN '8' THEN 'Required Special Invoice'
--	WHEN '9' THEN 'Customer Material Required'
--	WHEN '10' THEN 'Advance Payment Owed'
--	WHEN '11' THEN 'Customer Visit Required'
--	WHEN 'F01' THEN 'Finance Hold - Credit'
--	WHEN 'PHR' THEN 'Photos Required'
--END,'')
--	ELSE [Old Value]
--END [Old Value]
--,CASE
--	WHEN [Field No_] = 50018 THEN
--COALESCE(CASE [New Value]
--	WHEN '1' THEN 'Customer Requested Hold'
--	WHEN '2' THEN 'Lack of PO'
--	WHEN '3' THEN 'Lack of L/C or License'
--	WHEN '4' THEN 'Change Order Required'
--	WHEN '5' THEN 'No Back Orders Allowed'
--	WHEN '6' THEN 'Sales Administration'
--	WHEN '7' THEN 'Required Bar Code'
--	WHEN '8' THEN 'Required Special Invoice'
--	WHEN '9' THEN 'Customer Material Required'
--	WHEN '10' THEN 'Advance Payment Owed'
--	WHEN '11' THEN 'Customer Visit Required'
--	WHEN 'F01' THEN 'Finance Hold - Credit'
--	WHEN 'PHR' THEN 'Photos Required'
--END,'')
--	ELSE [New Value]
--END [New Value]
,[Old Value]
,[New Value]
--,[Sell-to Customer No_] [Customer No.]
--,[Sell-to Customer Name] [Name]
,[Primary Key Field 1 Value] 
,[Primary Key Field 2 Value] [Sales Order]


FROM [ZYGO$Change Log Entry] l

--LEFT JOIN [ZYGO$Sales Line] h ON l.[Primary Key Field 2 Value] = h.No_

WHERE [Table No_] = 37

AND [Field No_] IN (10,5790,5791,5794,5795,50001,50002,50005,501370,501610)

--AND LEN([New Value]) = 0

--'5813'	/*	Inventory Posting Setup	*/
--'50' /* Accounting Period */
--'99000754'	/* Work Center */
 

--AND [Field No_] = 
--50027  --Proposed Purchase Cost

--11  /* Inventory Posting Group */

--24 /*  Standard Cost  */

AND [Primary Key Field 2 Value] IN ('8313')

--AND [New Value] &gt; '279'

--AND [Date and Time] &gt;= '2023-03-26'

ORDER BY 

--[New Value]
[Date and Time]
,[Field No_]</CommandText>
        <rd:UseGenericDesigner>true</rd:UseGenericDesigner>
      </Query>
      <Fields>
        <Field Name="Date_and_Time">
          <DataField>Date and Time</DataField>
          <rd:TypeName>System.DateTime</rd:TypeName>
        </Field>
        <Field Name="User_ID">
          <DataField>User ID</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Field_No_">
          <DataField>Field No_</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
        <Field Name="Field">
          <DataField>Field</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Old_Value">
          <DataField>Old Value</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="New_Value">
          <DataField>New Value</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Primary_Key_Field_1_Value">
          <DataField>Primary Key Field 1 Value</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Sales_Order">
          <DataField>Sales Order</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
  </DataSets>
