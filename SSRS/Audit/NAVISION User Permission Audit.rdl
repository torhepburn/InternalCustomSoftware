  <DataSets>
    <DataSet Name="DataSet1">
      <Query>
        <DataSourceName>AFE</DataSourceName>
        <QueryParameters>
          <QueryParameter Name="@userName">
            <Value>=Parameters!userName.Value</Value>
          </QueryParameter>
        </QueryParameters>
        <CommandText>select * from [NAV_User_Permissions]

WHERE 1=1

AND (UserName =@userName or @userName is null)

ORDER BY [AD Group Name], [Role ID]</CommandText>
        <rd:UseGenericDesigner>true</rd:UseGenericDesigner>
      </Query>
      <Fields>
        <Field Name="UserName">
          <DataField>UserName</DataField>
