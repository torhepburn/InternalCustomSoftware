  <DataSources>
    <DataSource Name="NAVITAR">
      <DataSourceReference>NAVITAR</DataSourceReference>
      <rd:SecurityType>None</rd:SecurityType>
      <rd:DataSourceID>891c67a2-49ae-4a5b-9936-97abbab7b074</rd:DataSourceID>
    </DataSource>
  </DataSources>
  <DataSets>
    <DataSet Name="DataSet1">
      <Query>
        <DataSourceName>NAVITAR</DataSourceName>
        <QueryParameters>
          <QueryParameter Name="@startingdate">
            <Value>=Parameters!startingdate.Value</Value>
          </QueryParameter>
          <QueryParameter Name="@endingdate">
            <Value>=Parameters!endingdate.Value</Value>
          </QueryParameter>
        </QueryParameters>
        <CommandText>select

[LogDesc] [Log Description]
,MessageType [Message Type]
,CASE Category
	WHEN 'DA' THEN 'DatabaseAdd'
	ELSE Category
END Category
,MessageDesc [Message Description]
,KeyValue [Primary Key]
,COALESCE(OldValue,'') [Old Value]
,COALESCE(NewValue,'') [New Value]
,CreatedBy [User Name]
,CreateDate [Date/Time]

from AuditLog

where 

(createdate &gt;= @startingdate and createdate &lt;= @endingdate)

AND LogDesc = 'PurchaseOrderLines'

AND Category = 'DA'

order by createdate</CommandText>
        <rd:UseGenericDesigner>true</rd:UseGenericDesigner>
      </Query>
      <Fields>
        <Field Name="Log_Description">
          <DataField>Log Description</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Message_Type">
          <DataField>Message Type</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
        <Field Name="Category">
          <DataField>Category</DataField>
          <rd:TypeName>System.String</rd:TypeName>
