  <df:DefaultFontFamily>Segoe UI</df:DefaultFontFamily>
  <AutoRefresh>0</AutoRefresh>
  <DataSources>
    <DataSource Name="NAVITAR">
      <DataSourceReference>NAVITAR</DataSourceReference>
      <rd:SecurityType>None</rd:SecurityType>
      <rd:DataSourceID>1f904265-f321-464c-8367-0a42c8e8636f</rd:DataSourceID>
    </DataSource>
  </DataSources>
  <DataSets>
    <DataSet Name="DataSet1">
      <Query>
        <DataSourceName>NAVITAR</DataSourceName>
        <QueryParameters>
          <QueryParameter Name="@start">
            <Value>=Parameters!StartDate.Value</Value>
            <rd:UserDefined>true</rd:UserDefined>
          </QueryParameter>
          <QueryParameter Name="@end">
            <Value>=Parameters!EndDate.Value</Value>
            <rd:UserDefined>true</rd:UserDefined>
          </QueryParameter>
        </QueryParameters>
        <CommandText>WITH s1 AS
(
select

u.UserName [User Name]
,COALESCE(u.UserDesc,'') [User Description]
,'' [Employee ID]
,CASE u.SuperUserFlag
	WHEN 0 THEN '0'
	WHEN 1 THEN '1'
END [Super User]
,CASE u.Editlevel
	WHEN 0 THEN 'None'
	WHEN 2 THEN 'Full User'
	WHEN 3 THEN 'Site Developer'
	ELSE ''
END [Form Editing]
,g.GroupName [Group Name]
,g.GroupDesc [Group Description]
,u.CreateDate StartDate
,CASE u.Status
	WHEN 0 THEN DATEADD(yy, 50,GETDATE())
	WHEN 2 THEN u.LastActiveDate
END EndingDate
,CASE u.[Status]
	WHEN 0 THEN 'Active'
	WHEN 2 THEN 'Inactive'
	ELSE ''
END [Status]
	
from UserGroupMap_mst m

INNER JOIN UserNames u ON m.UserID = u.UserID

INNER JOIN GroupNames g ON m.GroupId = g.GroupId
)

select * from s1

WHERE ((EndingDate &lt;=@end AND EndingDate &gt;= @start)

OR

(StartDate &lt;=@start  AND EndingDate &gt;= @end))

ORDER BY [User Name], [Group Name]</CommandText>
        <rd:UseGenericDesigner>true</rd:UseGenericDesigner>
      </Query>
      <Fields>
        <Field Name="User_Name">
          <DataField>User Name</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="User_Description">
          <DataField>User Description</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Employee_ID">
          <DataField>Employee ID</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Super_User">
