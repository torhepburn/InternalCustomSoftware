<?xml version="1.0" encoding="utf-8"?>
<Report MustUnderstand="df" xmlns="http://schemas.microsoft.com/sqlserver/reporting/2016/01/reportdefinition" xmlns:rd="http://schemas.microsoft.com/SQLServer/reporting/reportdesigner" xmlns:df="http://schemas.microsoft.com/sqlserver/reporting/2016/01/reportdefinition/defaultfontfamily">
  <df:DefaultFontFamily>Segoe UI</df:DefaultFontFamily>
  <AutoRefresh>0</AutoRefresh>
  <DataSources>
    <DataSource Name="NAV">
      <DataSourceReference>NAV</DataSourceReference>
      <rd:SecurityType>None</rd:SecurityType>
      <rd:DataSourceID>62f539d5-90a6-49c1-87a0-ce30cf3562bd</rd:DataSourceID>
    </DataSource>
  </DataSources>
  <DataSets>
    <DataSet Name="DataSet1">
      <Query>
        <DataSourceName>NAV</DataSourceName>
        <CommandText>select

[Document No_]
,[SO Line No_]
,[Orig_ Promised Delivery Date]
,[Quantity]
,[Shipment Date]
, [Line Amount]
,DATEDIFF(dd, [Orig_ Promised Delivery Date],[Shipment Date]) DayOffset
,[Shortcut Dimension 2 Code] Segment

from [ZYGO$Sales Line]

WHERE [Outstanding Quantity] = 0

AND [Shipment Date] &gt;= '2024-01-01'

AND [Shipment Date] &lt; GETDATE()

AND ([Orig_ Promised Delivery Date] &gt; '2020-01-01' AND [Orig_ Promised Delivery Date] &lt; '2030-01-01')

AND [Type] = 2

ORDER BY [Document No_], [SO Line No_]</CommandText>
        <rd:UseGenericDesigner>true</rd:UseGenericDesigner>
      </Query>
      <Fields>
        <Field Name="Document_No_">
          <DataField>Document No_</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="SO_Line_No_">
          <DataField>SO Line No_</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
        <Field Name="Orig__Promised_Delivery_Date">
          <DataField>Orig_ Promised Delivery Date</DataField>
          <rd:TypeName>System.DateTime</rd:TypeName>
        </Field>
        <Field Name="Quantity">
          <DataField>Quantity</DataField>
          <rd:TypeName>System.Decimal</rd:TypeName>
        </Field>
        <Field Name="Shipment_Date">
          <DataField>Shipment Date</DataField>
          <rd:TypeName>System.DateTime</rd:TypeName>
        </Field>
        <Field Name="Line_Amount">
          <DataField>Line Amount</DataField>
          <rd:TypeName>System.Decimal</rd:TypeName>
        </Field>
        <Field Name="DayOffset">
          <DataField>DayOffset</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
        <Field Name="Segment">
          <DataField>Segment</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
  </DataSets>
