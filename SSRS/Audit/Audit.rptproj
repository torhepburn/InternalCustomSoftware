    <Report Include="SO Create Audit.rdl" />
    <Report Include="SO Create Ship User CSOM.rdl" />
    <Report Include="SO Credit Memo User Audit.rdl" />
    <Report Include="SO Invoice User Audit.rdl" />
    <Report Include="SO Item Shipment Audit.rdl" />
