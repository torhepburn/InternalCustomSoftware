<?xml version="1.0" encoding="utf-8"?>
<Report xmlns="http://schemas.microsoft.com/sqlserver/reporting/2016/01/reportdefinition" xmlns:rd="http://schemas.microsoft.com/SQLServer/reporting/reportdesigner" xmlns:df="http://schemas.microsoft.com/sqlserver/reporting/2016/01/reportdefinition/defaultfontfamily" MustUnderstand="df">
  <df:DefaultFontFamily>Segoe UI</df:DefaultFontFamily>
  <AutoRefresh>0</AutoRefresh>
  <DataSources>
    <DataSource Name="NAV">
      <DataSourceReference>NAV</DataSourceReference>
      <rd:SecurityType>None</rd:SecurityType>
      <rd:DataSourceID>3d29c09d-6d7f-48c2-9420-6c451631185b</rd:DataSourceID>
    </DataSource>
  </DataSources>
  <DataSets>
    <DataSet Name="DataSet1">
      <Query>
        <DataSourceName>NAV</DataSourceName>
        <CommandText>WITH s1 AS
(
select 

[Item No_]
--,Description
,COUNT(Quantity) TotalTransactions

from [ZYGO$Item Ledger Entry]

WHERE [Item No_] IN

(
	'1296-000-115'
,'6450-8112-93'
,'6300-3217-01'
,'1332-700-338'
,'6306-2003-03'
,'6450-0182-05'
,'1949-000-097'
,'220-3232-02'
,'1332-700-161'
,'6300-2665-01'
,'6306-6042-01'
,'6306-6042-02'
,'1115-801-981'
,'6306-6026-01'
,'6306-6016-01'
,'106-900-007'
,'6306-6028-01'
,'6306-6023-01'
,'6306-6024-01'
,'6306-6027-01'
,'6306-6025-01'
,'6306-6015-01'
,'1480-600-024'
,'6306-6013-01'
,'6306-6012-01'
,'6306-6022-01'
,'6306-6017-01'
,'6306-6021-01'
,'6306-6014-01'
,'6306-6011-01'
,'6306-6019-01'
,'1516-200-071'
,'6306-6018-01'
,'1330-000-025'
,'1330-000-024'
,'1330-000-022'
,'6306-1127-01'
,'6306-1126-01'
,'6450-8112-90'
,'1115-802-356'
,'6306-1003-01'
,'6300-3569-01'
,'6306-1126-01'
,'6306-1127-01'
,'1361-101-002'
,'6450-8109-91'
,'6450-8112-91'
,'6300-5019-01'
,'1709-320-058'
)

GROUP BY

[Item No_]
--,Description
)
,s2 AS
(
select 

[Item No_]
,COUNT(Quantity) TransactionsPast2Years

from [ZYGO$Item Ledger Entry]

WHERE [Item No_] IN

(
	'1296-000-115'
,'6450-8112-93'
,'6300-3217-01'
,'1332-700-338'
,'6306-2003-03'
,'6450-0182-05'
,'1949-000-097'
,'220-3232-02'
,'1332-700-161'
,'6300-2665-01'
,'6306-6042-01'
,'6306-6042-02'
,'1115-801-981'
,'6306-6026-01'
,'6306-6016-01'
,'106-900-007'
,'6306-6028-01'
,'6306-6023-01'
,'6306-6024-01'
,'6306-6027-01'
,'6306-6025-01'
,'6306-6015-01'
,'1480-600-024'
,'6306-6013-01'
,'6306-6012-01'
,'6306-6022-01'
,'6306-6017-01'
,'6306-6021-01'
,'6306-6014-01'
,'6306-6011-01'
,'6306-6019-01'
,'1516-200-071'
,'6306-6018-01'
,'1330-000-025'
,'1330-000-024'
,'1330-000-022'
,'6306-1127-01'
,'6306-1126-01'
,'6450-8112-90'
,'1115-802-356'
,'6306-1003-01'
,'6300-3569-01'
,'6306-1126-01'
,'6306-1127-01'
,'1361-101-002'
,'6450-8109-91'
,'6450-8112-91'
,'6300-5019-01'
,'1709-320-058'
)

AND [Posting Date] &gt; DATEADD(YY,-2,GETDATE())

GROUP BY

[Item No_]
)

select

s1.*
,COALESCE(s2.[TransactionsPast2Years],0)[TransactionsPast2Years]


from s1 left join s2 on s1.[Item No_] = s2.[Item No_]

order by s1.[Item No_]</CommandText>
        <rd:UseGenericDesigner>true</rd:UseGenericDesigner>
      </Query>
      <Fields>
        <Field Name="Item_No_">
          <DataField>Item No_</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="TotalTransactions">
          <DataField>TotalTransactions</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
        <Field Name="TransactionsPast2Years">
          <DataField>TransactionsPast2Years</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
  </DataSets>
