<?xml version="1.0" encoding="utf-8"?>
<Report MustUnderstand="df" xmlns="http://schemas.microsoft.com/sqlserver/reporting/2016/01/reportdefinition" xmlns:rd="http://schemas.microsoft.com/SQLServer/reporting/reportdesigner" xmlns:df="http://schemas.microsoft.com/sqlserver/reporting/2016/01/reportdefinition/defaultfontfamily">
  <df:DefaultFontFamily>Segoe UI</df:DefaultFontFamily>
  <AutoRefresh>0</AutoRefresh>
  <DataSources>
    <DataSource Name="DataSource1">
      <ConnectionProperties>
        <DataProvider>SQL</DataProvider>
        <ConnectString>Data Source=pa-hor-as408;Initial Catalog=ZYGO-NAV-PROD</ConnectString>
        <Prompt>Specify a user name and password for data source DataSource1:</Prompt>
      </ConnectionProperties>
      <rd:SecurityType>DataBase</rd:SecurityType>
      <rd:DataSourceID>97af2840-34bd-4e89-b81e-0b991190332b</rd:DataSourceID>
    </DataSource>
  </DataSources>
  <DataSets>
    <DataSet Name="DataSet1">
      <Query>
        <DataSourceName>DataSource1</DataSourceName>
        <CommandText>SELECT

h.No_ [Document No_]
, [SO Line No_]
,h.[Order Date]
,h.[Assigned User ID]
,CASE h.[Document Type]
	WHEN 1 THEN 'Order'
	WHEN 4 THEN 'Blanket Order'
	WHEN 5 THEN 'Return Order'
END [Document Type]
,CASE l.[Type]
	WHEN 1 THEN 'G/L Account'
	WHEN 2 THEN 'Item'
	WHEN 3 THEN 'Resource'
	WHEN 4 THEN 'Fixed Asset'
	WHEN 5 THEN 'Charge(Item)'
END [Line Type]
,l.No_

FROM [ZYGO$Sales Header] h

INNER JOIN [ZYGO$Sales Line] l ON h.No_ = l.[Document No_]

WHERE h.[Order Date] &gt;= GETDATE()-7

AND h.[Document Type] IN (1,4,5)

ORDER BY [Order Date], [Document No_], [SO Line No_]</CommandText>
        <rd:UseGenericDesigner>true</rd:UseGenericDesigner>
      </Query>
      <Fields>
        <Field Name="Document_No_">
          <DataField>Document No_</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="SO_Line_No_">
          <DataField>SO Line No_</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
        <Field Name="Order_Date">
          <DataField>Order Date</DataField>
          <rd:TypeName>System.DateTime</rd:TypeName>
        </Field>
        <Field Name="Assigned_User_ID">
          <DataField>Assigned User ID</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Document_Type">
          <DataField>Document Type</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Line_Type">
          <DataField>Line Type</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="No_">
          <DataField>No_</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
  </DataSets>
