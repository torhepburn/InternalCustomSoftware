  <df:DefaultFontFamily>Segoe UI</df:DefaultFontFamily>
  <AutoRefresh>0</AutoRefresh>
  <DataSources>
    <DataSource Name="NAVITAR">
      <DataSourceReference>NAVITAR</DataSourceReference>
      <rd:SecurityType>None</rd:SecurityType>
      <rd:DataSourceID>2ef5173d-c120-40fc-bba2-6397432348ce</rd:DataSourceID>
    </DataSource>
  </DataSources>
  <DataSets>
    <DataSet Name="DataSet1">
      <Query>
        <DataSourceName>NAVITAR</DataSourceName>
        <CommandText>select

--a.Id
 g.GroupName [Group]
,ObjectName1 [Object Name]
,CASE DeletePrivilege
	WHEN 1 THEN 'Granted'
	ELSE 'Not Granted'
END [Delete Privilege]
,CASE InsertPrivilege
	WHEN 1 THEN 'Granted'
	ELSE 'Not Granted'
END [Insert Privilege]
,CASE ReadPrivilege
	WHEN 1 THEN 'Granted'
	ELSE 'Not Granted'
END [Read Privilege]
,CASE UpdatePrivilege
	WHEN 1 THEN 'Granted'
	ELSE 'Not Granted'
END [Update Privilege]
,CASE BulkUpdatePrivilege
	WHEN 1 THEN 'Granted'
	ELSE 'Not Granted'
END [Bulk Update]



from AccountAuthorizations_mst a

LEFT JOIN GroupNames g on a.Id = g.GroupID

WHERE 

ObjectType = 0  /*	Form  */

AND GroupName is not null

AND GroupID IN

(
	8,9,117,199,19,20,24,28,96,29,30,214,48,49,198,51,53,54,56,58,203,204,208,211,210,195,209,207,206,205,31
	,32,135,94,213,41,99,42,136,137,138,141,142,143,144,145,146,154,148,149,150,151,152,43,44,45,100,46,7,59,124,125

)


ORDER BY g.GroupNAme, ObjectName1</CommandText>
        <rd:UseGenericDesigner>true</rd:UseGenericDesigner>
      </Query>
      <Fields>
        <Field Name="Group">
          <DataField>Group</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Object_Name">
          <DataField>Object Name</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Delete_Privilege">
