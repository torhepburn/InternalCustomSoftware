  <AutoRefresh>0</AutoRefresh>
  <DataSources>
    <DataSource Name="AFE">
      <ConnectionProperties>
        <DataProvider>SQL</DataProvider>
        <ConnectString>Data Source=CT-MID-SQL11;Initial Catalog=AccessFrontEnds</ConnectString>
      </ConnectionProperties>
      <rd:SecurityType>DataBase</rd:SecurityType>
      <rd:DataSourceID>1d56d868-96ef-4170-8492-140b48c28743</rd:DataSourceID>
    </DataSource>
  </DataSources>
  <DataSets>
    <DataSet Name="DataSet1">
      <Query>
        <DataSourceName>AFE</DataSourceName>
        <CommandText>select 

*


from 

[Nav User]

WHERE REPLACE([User Name],'AMETEK-AD\','') not in

(SELECT LoginName FROM AmetekAD_All
)

AND [User Name] NOT IN
(
	'AMETEK-AD\PA-HOR-GG-NAVADMINS'
	,'AMETEK-AD\PA-HOR-GG-ZYGOBROOKNAVACCOUNT'
	,'AMETEK-AD\PA-HOR-GG-ZYGOBROOKNAVACCOUNTADMIN'
	,'AMETEK-AD\PA-HOR-GG-ZYGOBROOKNAVACCOUNTREAD'
	,'AMETEK-AD\PA-HOR-GG-ZYGONAVACCT'
	,'AMETEK-AD\PA-HOR-GG-ZYGONAVACCTAP'
	,'AMETEK-AD\PA-HOR-GG-ZYGONAVACCTMANAGER'
	,'AMETEK-AD\PA-HOR-GG-ZYGONAVCOMMODITYMGR'
	,'AMETEK-AD\PA-HOR-GG-ZYGONAVCOSTACCT'
	,'AMETEK-AD\PA-HOR-GG-ZYGONAVDEVELOPERS'
	,'AMETEK-AD\PA-HOR-GG-ZYGONAVENGINEERING'
	,'AMETEK-AD\PA-HOR-GG-ZYGONAVITEMADMIN'
	,'AMETEK-AD\PA-HOR-GG-ZYGONAVOPERATIONS'
	,'AMETEK-AD\PA-HOR-GG-ZYGONAVPLANNER'
	,'AMETEK-AD\PA-HOR-GG-ZYGONAVPURCHASING'
	,'AMETEK-AD\PA-HOR-GG-ZYGONAVQUALITY'
	,'AMETEK-AD\PA-HOR-GG-ZYGONAVREADONLYALL'
	,'AMETEK-AD\PA-HOR-GG-ZYGONAVSALESADMIN'
	,'AMETEK-AD\PA-HOR-GG-ZYGONAVSERVICE'
	,'AMETEK-AD\PA-HOR-GG-ZYGONAVSHIPRECV'
	,'AMETEK-AD\PA-HOR-GG-ZYGONAVSTOCKROOM'
	,'AMETEK-AD\PA-HOR-GG-ZYGORICHNACACTOUNTADMIN'
	,'AMETEK-AD\PA-HOR-GG-ZYGORICHNAVACCOUNT'
	,'AMETEK-AD\PA-HOR-GG-ZYGORICHNAVACCOUNTREAD'
	,'AMETEK-AD\PA-HOR-ZYGOJETSCH'
	,'AMETEK-AD\PA-HOR-ZYGONAVSRV'
)

AND [Expiry Date] &lt; '2000-01-01'

AND [State] = 0

AND [User Name] NOT LIKE '%-SA'</CommandText>
        <rd:UseGenericDesigner>true</rd:UseGenericDesigner>
      </Query>
      <Fields>
        <Field Name="User_Name">
          <DataField>User Name</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Full_Name">
          <DataField>Full Name</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="State">
          <DataField>State</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
        <Field Name="Expiry_Date">
          <DataField>Expiry Date</DataField>
          <rd:TypeName>System.DateTime</rd:TypeName>
        </Field>
        <Field Name="DataDate">
          <DataField>DataDate</DataField>
          <rd:TypeName>System.DateTime</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
