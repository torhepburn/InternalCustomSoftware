<?xml version="1.0" encoding="utf-8"?>
<Report MustUnderstand="df" xmlns="http://schemas.microsoft.com/sqlserver/reporting/2016/01/reportdefinition" xmlns:rd="http://schemas.microsoft.com/SQLServer/reporting/reportdesigner" xmlns:df="http://schemas.microsoft.com/sqlserver/reporting/2016/01/reportdefinition/defaultfontfamily">
  <df:DefaultFontFamily>Segoe UI</df:DefaultFontFamily>
  <AutoRefresh>0</AutoRefresh>
  <DataSources>
    <DataSource Name="NAV">
      <DataSourceReference>NAV</DataSourceReference>
      <rd:SecurityType>None</rd:SecurityType>
      <rd:DataSourceID>7ce85875-a8f1-4ec5-b03b-6f4f4a6af7e7</rd:DataSourceID>
    </DataSource>
  </DataSources>
  <DataSets>
    <DataSet Name="DataSet1">
      <Query>
        <DataSourceName>NAV</DataSourceName>
        <QueryParameters>
          <QueryParameter Name="@SalesOrder">
            <Value>=Parameters!SalesOrder.Value</Value>
            <rd:UserDefined>true</rd:UserDefined>
          </QueryParameter>
        </QueryParameters>
        <CommandText>WITH s1 AS
(
	SELECT DISTINCT [Table ID],[Field ID], [Field Name]  
	
	FROM [ZYGO$Config_ Package Field]
)
SELECT

ROW_NUMBER() OVER
(Order BY [Entry No_])
,[Entry No_]
,[Date and Time]
,[User ID]
,[Field No_]
,[Field Name]
,[Type of Change]
,[Old Value]
,[New Value]
,[Primary Key Field 2 Value]
,[Primary Key Field 3 Value]

FROM [ZYGO$Change Log Entry] e

LEFT JOIN s1 f ON e.[Table No_] = f.[Table ID] AND e.[Field No_] = f.[Field ID]


where [Table ID] = 37

and [Primary Key Field 2 Value] = @SalesOrder

ORDER BY [Entry No_]</CommandText>
        <rd:UseGenericDesigner>true</rd:UseGenericDesigner>
      </Query>
      <Fields>
        <Field Name="ID">
          <DataField />
          <rd:TypeName>System.Int64</rd:TypeName>
        </Field>
        <Field Name="Entry_No_">
          <DataField>Entry No_</DataField>
          <rd:TypeName>System.Int64</rd:TypeName>
        </Field>
        <Field Name="Date_and_Time">
          <DataField>Date and Time</DataField>
          <rd:TypeName>System.DateTime</rd:TypeName>
        </Field>
        <Field Name="User_ID">
          <DataField>User ID</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Field_No_">
          <DataField>Field No_</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
        <Field Name="Field_Name">
          <DataField>Field Name</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Type_of_Change">
          <DataField>Type of Change</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
        <Field Name="Old_Value">
          <DataField>Old Value</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="New_Value">
          <DataField>New Value</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Primary_Key_Field_2_Value">
          <DataField>Primary Key Field 2 Value</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Primary_Key_Field_3_Value">
          <DataField>Primary Key Field 3 Value</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
  </DataSets>
