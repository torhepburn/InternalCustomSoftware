  <DataSets>
    <DataSet Name="DataSet1">
      <Query>
        <DataSourceName>NAVITAR</DataSourceName>
        <QueryParameters>
          <QueryParameter Name="startingdate">
            <Value>=Parameters!startingdate.Value</Value>
            <rd:UserDefined>true</rd:UserDefined>
          </QueryParameter>
          <QueryParameter Name="endingdate">
            <Value>=Parameters!endingdate.Value</Value>
            <rd:UserDefined>true</rd:UserDefined>
          </QueryParameter>
        </QueryParameters>
        <CommandText>select 

site_ref [Site]
,co_num [Document No]
,co_line [SO Line No]
,CreateDate [Order Date]
,createdby [Created By]
,item [Item]
,[description] [Item Description]

FROM coitem_mst

WHERE CreateDate &gt;= @startingdate

AND CreateDate &lt;= @endingdate

ORDER BY createdate, co_num, co_line</CommandText>
        <rd:UseGenericDesigner>true</rd:UseGenericDesigner>
      </Query>
      <Fields>
        <Field Name="Site">
          <DataField>Site</DataField>
          <rd:TypeName>System.String</rd:TypeName>
