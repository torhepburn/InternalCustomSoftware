<?xml version="1.0" encoding="utf-8"?>
<Report MustUnderstand="df" xmlns="http://schemas.microsoft.com/sqlserver/reporting/2016/01/reportdefinition" xmlns:rd="http://schemas.microsoft.com/SQLServer/reporting/reportdesigner" xmlns:df="http://schemas.microsoft.com/sqlserver/reporting/2016/01/reportdefinition/defaultfontfamily">
  <df:DefaultFontFamily>Segoe UI</df:DefaultFontFamily>
  <AutoRefresh>0</AutoRefresh>
  <DataSources>
    <DataSource Name="NAV">
      <DataSourceReference>NAV</DataSourceReference>
      <rd:SecurityType>None</rd:SecurityType>
      <rd:DataSourceID>c225bb91-e77d-4bb7-86b7-9cb6953dae2d</rd:DataSourceID>
    </DataSource>
  </DataSources>
  <DataSets>
    <DataSet Name="DataSet1">
      <Query>
        <DataSourceName>NAV</DataSourceName>
        <CommandText>Select 

No_
,[Starting Date]
,[Due Date]
,DATEDIFF(dd, [Starting Date], [Due Date]) Daycount

from [ZYGO$Requisition Line]

WHERE DATEDIFF(dd, [Starting Date], [Due Date]) &lt; 300

AND No_ In

(
select 

No_

from ZYGO$Item where 
 CASE  WHEN LEN([Lead Time Calculation]) = 0 THEN '0' 
           WHEN CHARINDEX(CHAR(3),[Lead Time Calculation]) &gt; 0
                THEN REPLACE([Lead Time Calculation], CHAR(3), '')
         WHEN CHARINDEX(CHAR(4),[Lead Time Calculation]) &gt; 0 THEN  --week 
            REPLACE([Lead Time Calculation], CHAR(4), '') * 5	     --convert to days 
         WHEN CHARINDEX(CHAR(5),[Lead Time Calculation]) &gt; 0 THEN  --month 
            REPLACE([Lead Time Calculation], CHAR(5), '') * 20	--convert to days 
        WHEN CHARINDEX(CHAR(2),[Lead Time Calculation]) &gt; 0 THEN  -- days 
            REPLACE([Lead Time Calculation], CHAR(2), '')		
  END = 300)
</CommandText>
        <rd:UseGenericDesigner>true</rd:UseGenericDesigner>
      </Query>
      <Fields>
        <Field Name="No_">
          <DataField>No_</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Starting_Date">
          <DataField>Starting Date</DataField>
          <rd:TypeName>System.DateTime</rd:TypeName>
        </Field>
        <Field Name="Due_Date">
          <DataField>Due Date</DataField>
          <rd:TypeName>System.DateTime</rd:TypeName>
        </Field>
        <Field Name="Daycount">
          <DataField>Daycount</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
  </DataSets>
