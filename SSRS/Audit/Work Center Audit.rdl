  <DataSets>
    <DataSet Name="DataSet1">
      <Query>
        <DataSourceName>NAV</DataSourceName>
        <CommandText>select  

'Work Center'
,No_
,[Last Date Modified] [Last Modified]

from [ZYGO$Work Center]

WHERE [Last Date Modified] &gt;= '2022-01-01'

ORDER BY [Last Date Modified] desc</CommandText>
        <rd:UseGenericDesigner>true</rd:UseGenericDesigner>
      </Query>
