<?xml version="1.0" encoding="utf-8"?>
<Report MustUnderstand="df" xmlns="http://schemas.microsoft.com/sqlserver/reporting/2016/01/reportdefinition" xmlns:rd="http://schemas.microsoft.com/SQLServer/reporting/reportdesigner" xmlns:df="http://schemas.microsoft.com/sqlserver/reporting/2016/01/reportdefinition/defaultfontfamily">
  <df:DefaultFontFamily>Segoe UI</df:DefaultFontFamily>
  <AutoRefresh>0</AutoRefresh>
  <DataSources>
    <DataSource Name="DataSource1">
      <ConnectionProperties>
        <DataProvider>SQL</DataProvider>
        <ConnectString>Data Source=CT-MID-SQL11;Initial Catalog=AccessFrontEnds</ConnectString>
      </ConnectionProperties>
      <rd:SecurityType>DataBase</rd:SecurityType>
      <rd:DataSourceID>99fa2e2f-549c-490a-9470-90088d4c6d03</rd:DataSourceID>
    </DataSource>
  </DataSources>
  <DataSets>
    <DataSet Name="DataSet1">
      <Query>
        <DataSourceName>DataSource1</DataSourceName>
        <CommandText>/****** Script for SelectTopNRows command from SSMS  ******/
SELECT [PartNumber]
      ,d.[Description] [DetailDescription]
	  ,o.Description [HeaderDescription]
      ,[Note]
      ,[Quantity]
      ,[UnitPrice]
       ,[MKOrderNo] [PO]
      ,[MKPosition] [PO Line]
	  ,[CCorPO]
	  ,[CCRefNumber]
      ,[Delivered]
      ,[SubTotal]
	  ,o.CostCenterDescription
	  ,o.SupplierID
	  ,o.DeliverTo
      ,d.[OperatorID]
      ,d.[CreatedOn]
      ,d.[LastUpdatedOn]
  FROM [MIDDB01.ZYGO.COM].[Dashboard].[dbo].[PurchaseOrderDetail] d

  LEFT JOIN  [MIDDB01.ZYGO.COM].[Dashboard].[dbo].[PurchaseOrder] o ON d.PurchaseOrderID = o.PurchaseOrderID

  where 

  --d.PurchaseOrderID = 46275
  
  PurchaseUsageID = 11 


  and d.createdon &gt;= '2023-01-01'

  --order by partnumber

  UNION ALL

  SELECT 
d.partnumber
      ,o.[Description] [HeaderDescription]
	  ,d.Description [DetailDescription]
      ,[Note]
      ,[Quantity]
      ,[UnitPrice]
      ,[MKOrderNo] [PO]
      ,[MKPosition] [PO Line]
	  ,[CCorPO]
      ,[CCRefNumber]
      ,[Delivered]
      ,[SubTotal]
	  ,o.CostCenterDescription
	  ,o.SupplierID
	  ,o.DeliverTo
      ,d.[OperatorID]
      ,d.[CreatedOn]
      ,d.[LastUpdatedOn]


  FROM [MIDDB01.ZYGO.COM].[Dashboard].[dbo].[PurchaseOrder] o

  LEFT JOIN [MIDDB01.ZYGO.COM].[Dashboard].[dbo].[PurchaseOrderDetail] d

  ON o.PurchaseOrderID = d.PurchaseOrderID

  where account = 'G COMPUTER'

  AND o.CreatedON &gt;= '2023-01-01'

  order by partnumber</CommandText>
        <rd:UseGenericDesigner>true</rd:UseGenericDesigner>
      </Query>
