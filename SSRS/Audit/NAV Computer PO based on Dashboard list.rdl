<?xml version="1.0" encoding="utf-8"?>
<Report MustUnderstand="df" xmlns="http://schemas.microsoft.com/sqlserver/reporting/2016/01/reportdefinition" xmlns:rd="http://schemas.microsoft.com/SQLServer/reporting/reportdesigner" xmlns:df="http://schemas.microsoft.com/sqlserver/reporting/2016/01/reportdefinition/defaultfontfamily">
  <df:DefaultFontFamily>Segoe UI</df:DefaultFontFamily>
  <AutoRefresh>0</AutoRefresh>
  <DataSources>
    <DataSource Name="NAV">
      <DataSourceReference>NAV</DataSourceReference>
      <rd:SecurityType>None</rd:SecurityType>
      <rd:DataSourceID>b7ac7494-dc7e-4faf-a4a8-a3c1942d0f93</rd:DataSourceID>
    </DataSource>
  </DataSources>
  <DataSets>
    <DataSet Name="DataSet1">
      <Query>
        <DataSourceName>NAV</DataSourceName>
        <CommandText>select 

[Document No_]
,[PO Line No_]
,h.[Order Date]
,l.[No_]
,[Posting Group]
,[Description]
,Quantity
,[Direct Unit Cost]
,[Amount Including VAT]
,[Gen_ Prod_ Posting Group]
,l.[Tax Liable]
,[Tax Group Code]
,l.[Dimension Set ID]
,m.[Text]



from [ZYGO$Purchase Line] l

INNER JOIN [ZYGO$Purchase Header] h on l.[Document No_] = h.No_

LEFT JOIN [ZYGO$Text Module Line Document] m ON l.[Text Set ID] = m.[Text ID]


--INNER JOIN [ZYGO$Purchase Header] h ON l.[Document No_] = h.No_



where



--[Tax Group Code] = 'DOWNLOAD'

[Document No_] 

IN

(
'P502485'
,'P502502'
,'P502520'
,'P502521'
,'P502578'
,'P502602'
,'P502636'
,'P502646'
,'P502702'
,'P502769'
,'P502809'
,'P502840'
,'P502854'
,'P502858'
,'P502863'
,'P502864'
,'P502963'
,'P502979'
,'P502997'
,'P503015'
,'P503062'
,'P503105'
,'P503150'
,'P704283'
,'P704332'
,'P704346'
,'P704484'
,'P704683'
,'P704695'
,'P704765'
,'P801905'
,'P801919'
,'P802049'
,'P802068'
,'P802092'
,'P802094'
,'P802103'
,'P802149'
,'P802273'
,'P802442'
,'P802460'
,'P903540'
,'P903564'
,'P903625'
,'P903639'

)



--[Gen_ Prod_ Posting Group] = 'G COMPUTER'

AND l.[Order Date] &gt;= '2023-01-01'

</CommandText>
        <rd:UseGenericDesigner>true</rd:UseGenericDesigner>
      </Query>
      <Fields>
        <Field Name="Document_No_">
          <DataField>Document No_</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="PO_Line_No_">
          <DataField>PO Line No_</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
