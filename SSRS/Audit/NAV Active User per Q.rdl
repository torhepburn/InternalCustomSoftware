  <DataSources>
    <DataSource Name="NAV">
      <DataSourceReference>NAV</DataSourceReference>
      <rd:SecurityType>None</rd:SecurityType>
      <rd:DataSourceID>18b91dda-7a8b-425e-bf7d-2145bd49d47a</rd:DataSourceID>
    </DataSource>
  </DataSources>
  <DataSets>
    <DataSet Name="DataSet1">
      <Query>
        <DataSourceName>NAV</DataSourceName>
        <CommandText>WITH s1 AS	/*	new users	*/
(
	select 

	[Date and Time]
	,[Old Value]
	,[New Value]
	,[Primary Key Field 1 Value]

	from [ZYGO$Change Log Entry] 


	where [Table No_] = 2000000120

	AND [Field No_] IN (3)

	AND [Date and Time] &gt;= '2026-04-01'

	AND [Date and Time] &lt; '2026-07-01'

	AND LEN([Old Value]) = 0
)
, s2 AS		/*		*/
(
	select 

	[Date and Time]
	,[Old Value]
	,[New Value]
	,[Primary Key Field 1 Value]
	,[User Name]
	,[Full Name]

	from [ZYGO$Change Log Entry] e

	INNER JOIN [User] u ON e.[Primary Key Field 1 Value] = u.[User Security ID]

	where [Table No_] = 2000000120

	AND [Field No_] IN (4)

	AND [Date and Time] &gt;= '2026-04-01'

	--AND [Date and Time] &lt; '2026-07-01'

	AND [New Value] = 1
)
,s3 AS	/*	new and disabled in Quarter	*/
(
select * from s2

WHERE [Primary Key Field 1 Value] IN

(SELECT [Primary Key Field 1 Value] from s1)
)

select

[User Name]

from [User]

WHERE [State] = 0

AND [User Name] NOT LIKE '%PA-HOR-%'

UNION ALL

select  

[User Name]

from s2</CommandText>
        <rd:UseGenericDesigner>true</rd:UseGenericDesigner>
      </Query>
      <Fields>
        <Field Name="User_Name">
          <DataField>User Name</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
  </DataSets>
