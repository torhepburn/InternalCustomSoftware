<?xml version="1.0" encoding="utf-8"?>
<Report MustUnderstand="df" xmlns="http://schemas.microsoft.com/sqlserver/reporting/2016/01/reportdefinition" xmlns:rd="http://schemas.microsoft.com/SQLServer/reporting/reportdesigner" xmlns:df="http://schemas.microsoft.com/sqlserver/reporting/2016/01/reportdefinition/defaultfontfamily">
  <df:DefaultFontFamily>Segoe UI</df:DefaultFontFamily>
  <AutoRefresh>0</AutoRefresh>
  <DataSources>
    <DataSource Name="DataSource1">
      <ConnectionProperties>
        <DataProvider>SQL</DataProvider>
        <ConnectString>Data Source=pa-hor-as408;Initial Catalog=ZYGO-NAV-PROD</ConnectString>
      </ConnectionProperties>
      <rd:SecurityType>DataBase</rd:SecurityType>
      <rd:DataSourceID>325720df-8708-4278-ae73-2c656b1b8d09</rd:DataSourceID>
    </DataSource>
  </DataSources>
  <DataSets>
    <DataSet Name="DataSet1">
      <Query>
        <DataSourceName>DataSource1</DataSourceName>
        <CommandText>WITH s1 AS
(
	SELECT

	h.No_ [Document No_]
	,[Srv Line No_]
	,h.[Order Date]
	,h.[Assigned User ID]
	,CASE h.[Document Type]
		WHEN 1 THEN 'Order'
		WHEN 4 THEN 'Blanket Order'
		WHEN 5 THEN 'Return Order'
	END [Document Type]
	,CASE l.[Type]
		WHEN 1 THEN 'Item'
		WHEN 2 THEN 'Resource'
		WHEN 3 THEN 'Cost'
		WHEN 4 THEN 'G/L Account'
	END [Line Type]
	,l.No_ [Item No]


	FROM [ZYGO$Service Header] h

	INNER JOIN [ZYGO$Service Line] l ON h.No_ = l.[Document No_]

	WHERE h.[Order Date] &gt;= '2021-10-01'

	AND h.[Order Date] &lt;= '2021-12-31'

	AND l.[Type] IN (1)
)

SELECT

	sih.No_ [Service Invoice No]
	,sih.[Posting Date] [Invoice Date]
	,sih.[User ID] [Inovice Creator matching Order Creator]
	,s1.[Order Date] [Service Order Date]
	,[Order No_] [Service Order No]
	,[Assigned User ID] [Service Order Creator]
	,s1.[Srv Line No_] [Service Line Number]
	, s1.[Item No]

	FROM [ZYGO$Service Invoice Header] sih

	INNER JOIN s1 ON s1.[Document No_] = sih.[Order No_]  AND s1.[Assigned User ID] = sih.[User ID]

	WHERE [Assigned User ID] like '%CSOM'</CommandText>
        <rd:UseGenericDesigner>true</rd:UseGenericDesigner>
      </Query>
      <Fields>
        <Field Name="Service_Invoice_No">
          <DataField>Service Invoice No</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Invoice_Date">
          <DataField>Invoice Date</DataField>
          <rd:TypeName>System.DateTime</rd:TypeName>
        </Field>
        <Field Name="Inovice_Creator_matching_Order_Creator">
          <DataField>Inovice Creator matching Order Creator</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Service_Order_Date">
          <DataField>Service Order Date</DataField>
          <rd:TypeName>System.DateTime</rd:TypeName>
        </Field>
        <Field Name="Service_Order_No">
          <DataField>Service Order No</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Service_Order_Creator">
          <DataField>Service Order Creator</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Service_Line_Number">
          <DataField>Service Line Number</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
        <Field Name="Item_No">
          <DataField>Item No</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
  </DataSets>
