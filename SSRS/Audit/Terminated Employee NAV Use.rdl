  <DataSources>
    <DataSource Name="NAV">
      <DataSourceReference>NAV</DataSourceReference>
      <rd:SecurityType>None</rd:SecurityType>
      <rd:DataSourceID>350cec01-a55c-4f45-98aa-dba1f5dd1f85</rd:DataSourceID>
    </DataSource>
  </DataSources>
  <DataSets>
    <DataSet Name="DataSet1">
      <Query>
        <DataSourceName>NAV</DataSourceName>
        <CommandText>WITH s1 AS  --terminated employees Q2 2026
(
select 

[Date and Time]
,[Old Value]
,[New Value]

from [ZYGO$Change Log Entry] 


where [Table No_] = 2000000120

AND [Field No_] IN (3,4)

AND [Date and Time] &gt;= '2026-04-01'

AND [Date and Time] &lt; '2026-07-01'

AND ([New Value] like '%TERM%' OR [New Value] like '%erm%')
)
,s2 AS
(
	SELECT

	[User Name]
	,[Full Name]

	FROM [User]

	where [Full Name] like '%TERM%'
)
,s3 AS
(
	SELECT 

	*

	FROM s1

	INNER JOIN s2 ON s1.[New Value] = s2.[Full Name]
)

SELECT

[User ID]
,MIN([Event Datetime]) [First Logon]
,MAX([Event Datetime]) [Last Logon]

FROM [Session Event] e

INNER JOIN s3 ON s3.[User Name] = e.[User ID]

GROUP BY [User ID]</CommandText>
        <rd:UseGenericDesigner>true</rd:UseGenericDesigner>
      </Query>
      <Fields>
        <Field Name="User_ID">
          <DataField>User ID</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="First_Logon">
          <DataField>First Logon</DataField>
          <rd:TypeName>System.DateTime</rd:TypeName>
        </Field>
        <Field Name="Last_Logon">
          <DataField>Last Logon</DataField>
          <rd:TypeName>System.DateTime</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
  </DataSets>
