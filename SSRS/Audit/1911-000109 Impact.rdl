  <DataSets>
    <DataSet Name="DataSet1">
      <Query>
        <DataSourceName>NAV</DataSourceName>
        <CommandText>--SELECT SUM(Quantity) FROM [ZYGO$Warehouse Entry] WHERE [Item No_] = '1911-000-109' 

WITH s2 AS
(
select

r.[Document No_]
,r.[SO Line No_]
,[Old Promised Delivery Date]
,[New Promised Delivery Date]
,[Last Date Modified]
,[Modified by User]

from [ZYGO$Change Sales Date Reason Entry] r

INNER JOIN 



(
SELECT 


--lanned Shipment Date]
[Document No_]
,[SO Line No_]
--,[No_]
--,[Description]
--,Quantity
--,[Quantity Shipped]
--,[Unit Price]


FROM [ZYGO$Sales Line] sl  --WHERE No_ IN

--SELECT * FROM [ZYGO$Production BOM Line] where No_ IN

--(select DISTINCT [Production BOM No_] from [ZYGO$Production BOM Line] where No_ = '1911-000-109')

--WITH s1 AS
--(SELECT * FROM [ZYGO$Production BOM Line] where No_ IN

--(select DISTINCT [Production BOM No_] from [ZYGO$Production BOM Line] where No_ = '1911-000-109'))

--SELECT * FROM s1



WHERE No_ IN
(
'6300-0830-02'
,'6300-0880-02'
,'6300-0895-01'
,'6300-0902-01'
,'6301-0162-01'
,'6301-0162-02'
,'6301-0162-03'
,'6301-0249-01'
,'6301-0250-01'
,'6301-0406-01'
,'6301-0406-01R'
,'6301-0407-01'
,'6301-0407-01R'
,'6307-0104-01'
,'6307-0104-02'
,'6307-0104-04'
,'6307-0104-05'
,'6307-0104-06'
,'6307-0104-07'
,'6307-0104-09'
,'6308-0104-01'
,'6308-0104-04'
,'6308-0104-06'
,'6308-0111-01'
,'6308-0111-01R'
,'6310-0122-03'
,'6311-0104-01'
,'6311-0104-21'
,'6311-0800-01'
,'6312-0104-01'
,'6312-0104-01 FAI'
,'6317-1122-01'
,'6505-6228-01'
,'6508-0252-05'
,'6508-0252-11'
,'6508-0252-20'
,'6508-0269-11'
,'6508-0269-12'
,'CH6307-0150-80'
,'PL6301-0275-05'
,'PL6301-0275-06'
,'PL6301-0280-01'
,'X1301906307-0104-05'
,'6300-0870-02'
,'6301-0275-07'
,'6301-0275-08'
,'6301-0278-01'
,'6301-0300-01'
,'6301-0301-01'
,'6301-0302-01'
,'6301-0890-01'
,'6307-0100-01'
,'6307-0100-05'
,'6307-0100-11'
,'6307-0100-15'
,'6307-0100-20'
,'6307-0100-25'
,'6307-0100-26'
,'6307-0100-30'
,'6308-0100-01'
,'6308-0100-03'
,'6308-0100-11'
,'6308-0100-30'
,'6308-0104-03'
,'6308-0104-05'
,'6310-0100-01'
,'6311-0100-01'
,'6311-0100-11'
,'6311-0104-22'
,'6311-0905-01'
,'6312-0100-01'
,'6312-0100-01 FAI'
,'6312-0100-03'
,'6312-0100-11'
,'6312-0100-21'
,'6312-0100-22'
,'6312-0100-23'
,'6317-0300-04'
,'6508-0248-05'
,'6508-0248-06'
,'6508-0248-07'
,'6508-0248-08'
,'6508-0248-50'
,'6508-0248-52'
,'6508-0248-53'
,'6508-0248-54'
,'6508-0248-55'
,'6508-0278-02'
,'6508-0278-03'
,'6508-0278-04'
,'6508-0278-05'
,'6508-0342-01'
,'6508-0344-01'
,'6508-0352-02'
,'6508-0353-02'
,'CH6307-0100-80'
,'PL-CH6301-0400-01'
,'PL-CH6301-0401-01'
,'PL-CH6308-0100-01'
,'PL-CH6308-0100-11'
,'PL6301-0275-05'
,'PL6301-0275-06'
,'PL6301-0280-01'
,'PL6301-0401-01'
,'PL6307-0100-01'
,'PL6307-0100-05'
,'PL6307-0100-11'
,'PL6307-0100-15'
,'PL6308-0100-01'
,'PL6308-0100-11'
,'X1301906307-0100-24'
,'X2312836508-0334-01'
,'6301-0281-01'
,'6301-0400-01'
,'6301-0401-01'
,'6301-0402-01'
,'6311-0100-21'
,'6317-0300-03'
,'6317-0300-05'
,'6317-0302-01'
,'6508-0253-05'
,'6508-0253-06'
,'6508-0253-07'
,'6508-0253-50'
,'6508-0253-52'
,'6508-0253-53'
,'6508-0253-54'
,'6508-0253-55'
,'PL-CH6301-0281-01'
,'PL-CH6301-0402-01'
,'PL6301-0281-01'
,'PL6301-0402-01'
,'X130190OEM ENHHASE 1'
,'X231283SER 4744A-1'
,'X231299SER 4778A-1'
,'X231301SER 4790A-1'
,'6317-0301-01'
,'6317-0301-03'
,'6317-0301-04'
,'X2312726317-0301-01'
,'X231292SER NXV-5XE-2'
,'X2312956317-0301-01'
,'X231297SER 4828A-1'
)

AND [Quantity Shipped] = 0

AND [Planned Shipment Date] &gt;= '04-01-2022') s1

ON r.[Document No_] = s1.[Document No_] AND r.[SO Line No_] = s1.[SO Line No_]

WHERE

[New Promised Delivery Date] &lt; '2022-06-01'

AND [New Promised Delivery Date] &gt;= '2022-05-01'

AND [Old Promised Delivery Date] &gt;= '2022-04-01'

AND [Old Promised Delivery Date] &lt;= '2022-04-30'
)
--ORDER BY [Last Date Modified] DESC


SELECT

s2.[Document No_]
,s2.[SO Line No_]
,s2.[Old Promised Delivery Date]
,s2.[New Promised Delivery Date]
,s2.[Last Date Modified]
,s2.[Modified by User]
,ssl.No_
,ssl.Quantity
,ssl.[Quantity Shipped]
,ssl.Amount


FROM s2

LEFT JOIN [ZYGO$Sales Line] ssl ON ssl.[Document No_] = s2.[Document No_] AND ssl.[SO Line No_] = s2.[SO Line No_]</CommandText>
        <rd:UseGenericDesigner>true</rd:UseGenericDesigner>
      </Query>
