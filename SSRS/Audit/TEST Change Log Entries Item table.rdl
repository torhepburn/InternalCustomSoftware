<?xml version="1.0" encoding="utf-8"?>
<Report xmlns="http://schemas.microsoft.com/sqlserver/reporting/2016/01/reportdefinition" xmlns:rd="http://schemas.microsoft.com/SQLServer/reporting/reportdesigner" xmlns:df="http://schemas.microsoft.com/sqlserver/reporting/2016/01/reportdefinition/defaultfontfamily" MustUnderstand="df">
  <df:DefaultFontFamily>Segoe UI</df:DefaultFontFamily>
  <AutoRefresh>0</AutoRefresh>
  <DataSources>
    <DataSource Name="NAV_TEST">
      <ConnectionProperties>
        <DataProvider>SQL</DataProvider>
        <ConnectString>Data Source=pa-hor-as406;Initial Catalog=ZYGO-NAV-TEST</ConnectString>
        <IntegratedSecurity>true</IntegratedSecurity>
      </ConnectionProperties>
      <rd:SecurityType>None</rd:SecurityType>
      <rd:DataSourceID>2a2c48c4-8836-4858-955b-129a4cda17f8</rd:DataSourceID>
    </DataSource>
  </DataSources>
  <DataSets>
    <DataSet Name="DataSet1">
      <Query>
        <DataSourceName>NAV_TEST</DataSourceName>
        <CommandText>WITH s1 AS
(
	SELECT DISTINCT [Table ID],[Field ID], [Field Name]  
	
	FROM [ZYGO$Config_ Package Field]

	WHERE [Table ID] = 27
)
SELECT 

[Field No_]
,[Field Name]
,COUNT([Entry No_]) Entries

FROM [ZYGO$Change Log Entry] e

LEFT JOIN s1 f ON e.[Table No_] = f.[Table ID] AND e.[Field No_] = f.[Field ID]

where [Table ID] = 27

GROUP BY [Field No_], [Field Name]


ORDER BY

COUNT([Entry No_])</CommandText>
        <rd:UseGenericDesigner>true</rd:UseGenericDesigner>
      </Query>
      <Fields>
        <Field Name="Field_No_">
          <DataField>Field No_</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
        <Field Name="Field_Name">
          <DataField>Field Name</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Entries">
          <DataField>Entries</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
  </DataSets>
