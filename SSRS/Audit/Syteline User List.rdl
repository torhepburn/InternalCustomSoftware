<?xml version="1.0" encoding="utf-8"?>
<Report xmlns="http://schemas.microsoft.com/sqlserver/reporting/2016/01/reportdefinition" xmlns:rd="http://schemas.microsoft.com/SQLServer/reporting/reportdesigner" xmlns:df="http://schemas.microsoft.com/sqlserver/reporting/2016/01/reportdefinition/defaultfontfamily" MustUnderstand="df">
  <df:DefaultFontFamily>Segoe UI</df:DefaultFontFamily>
  <AutoRefresh>0</AutoRefresh>
  <DataSources>
    <DataSource Name="NAVITAR">
      <DataSourceReference>NAVITAR</DataSourceReference>
      <rd:SecurityType>None</rd:SecurityType>
      <rd:DataSourceID>ef0ed711-f1e9-4f89-b5fd-e3a96e6ad9fc</rd:DataSourceID>
    </DataSource>
  </DataSources>
  <DataSets>
    <DataSet Name="DataSet1">
      <Query>
        <DataSourceName>NAVITAR</DataSourceName>
        <CommandText>select

n.UserName [User Name]
,COALESCE(UserDesc,'') [User Description]
,CASE EditLevel
	WHEN 0 THEN 'None'
	WHEN 2 THEN 'Full User'
	WHEN 3 THEN 'Site Developer'
	ELSE ''
END [Editing Permissions]
,SuperUserFlag [Super User]
,COALESCE(WorkstationLogin,'') [Workstation Domain/ID]
,CASE Status
	WHEN 0 THEN 'Active'
	WHEN 2 THEN 'Disabled'
END [User Login Status]
,LoginFailures [Login Failures]
,LastActiveDate [Last Active Date]
,LEFT(UPPER(n.username),2) [User Initials]
,COALESCE(UserAlias,'') [User ID]
,PasswordNeverExpires [Password Never Expires]
,COALESCE(CONVERT(varchar(10),PasswordExpirationDate,101),'') [Password Expiration Date]
,COALESCE(CONVERT(varchar(10),UnlockDate,101),'') [Unlock Date]
,PasswordSetDate [Password Set Date]
,COALESCE(LanguageCode,'') [Default Language]
,SendEmailNotifications [Send External Prompts]
,COALESCE(SourceControlUserName,'') [Source Control Username]
,COALESCE(MobileDefaultForm,'') [Mobile Default Form]
,AllowRemoteTrustedSession [Allow Remote Winstudio Sessions]
,COALESCE(e.EmailAddress,'') [Primary Email Address]
,SendEmailNotifications [Send External Notifications]
,COALESCE(e.EmailAddress,'') [External Notifications Email Address]
,COALESCE(e.EmailAddress,'') [External Prompts Email Address]
,COALESCE(LocalTimeZone,'') [Local Time Zone]
,COALESCE(ExternalEntity,'') [External Entity]
,COALESCE(Whse,'') Whse 
,site_ref [Multi-Site Group]
,hide_parent_grid_columns_option [Hide Parent Grid Columns]
,COALESCE(rfq_profile,'') [Profile]
,COALESCE(rfq_fax_num,'') [Fax Num]
,preq_limit [PO Req Limit]
,preqitem_limit [PO Req Line Limit]
,show_image [Show Image At Startup]
,'' [User Password]
,'' [sPasscodeUser]
,CASE EmailType
	WHEN 'P' THEN 'Primary'
	ELSE ''
END [Primary Email Description]
,'' [Use Reply To]
,CASE EmailType
	WHEN 'P' THEN 'Primary'
	ELSE ''
END [Reply To Email Description]
,COALESCE(e.EmailAddress,'') [Reply To Email Address]
,CASE EmailType
	WHEN 'P' THEN 'Primary'
	ELSE ''
END [External Notifications Email Description]
,CASE EmailType
	WHEN 'P' THEN 'Primary'
	ELSE ''
END [External Prompts Email Description]


from UserNames n

INNER JOIN user_local_mst m ON n.UserID = m.UserId

LEFT JOIN Useremail e ON n.username = e.username


ORDER BY [User Name]</CommandText>
        <rd:UseGenericDesigner>true</rd:UseGenericDesigner>
      </Query>
      <Fields>
        <Field Name="User_Name">
          <DataField>User Name</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="User_Description">
