      <rd:SecurityType>None</rd:SecurityType>
      <rd:DataSourceID>578290a6-0c2f-4d2c-b859-7755571b5fb4</rd:DataSourceID>
    </DataSource>
    <DataSource Name="TEST">
      <ConnectionProperties>
        <DataProvider>SQL</DataProvider>
        <ConnectString>Data Source=pa-hor-as406;Initial Catalog=ZYGO-NAV-TEST</ConnectString>
      </ConnectionProperties>
      <rd:SecurityType>DataBase</rd:SecurityType>
      <rd:DataSourceID>ad8a0399-c493-4563-9e87-5759748da6eb</rd:DataSourceID>
    </DataSource>
  </DataSources>
  <DataSets>
    <DataSet Name="DataSet1">
      <Query>
        <DataSourceName>TEST</DataSourceName>
        <CommandText>WITH s1 AS
(
	SELECT DISTINCT [Table ID],[Field ID], [Field Name]  
	
	FROM [ZYGO$Config_ Package Field]
)
SELECT DISTINCT

--ROW_NUMBER() OVER
--(Order BY [Entry No_])
--,[Entry No_]
--,[Date and Time]
--,[User ID]
[Field No_]
,[Field Name]
--,[Type of Change]
--,[Old Value]
--,[New Value]
--,[Primary Key Field 2 Value]
--,[Primary Key Field 3 Value]

FROM [ZYGO$Change Log Entry] e

LEFT JOIN s1 f ON e.[Table No_] = f.[Table ID] AND e.[Field No_] = f.[Field ID]


where [Table ID] = 27

--and [Primary Key Field 2 Value] = '8613'

ORDER BY

[Field No_]
--[Entry No_]</CommandText>
        <rd:UseGenericDesigner>true</rd:UseGenericDesigner>
      </Query>
      <Fields>
        <Field Name="Field_No_">
          <DataField>Field No_</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
        <Field Name="Field_Name">
          <DataField>Field Name</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
  </DataSets>
