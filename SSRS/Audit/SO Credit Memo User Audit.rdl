<?xml version="1.0" encoding="utf-8"?>
<Report MustUnderstand="df" xmlns="http://schemas.microsoft.com/sqlserver/reporting/2016/01/reportdefinition" xmlns:rd="http://schemas.microsoft.com/SQLServer/reporting/reportdesigner" xmlns:df="http://schemas.microsoft.com/sqlserver/reporting/2016/01/reportdefinition/defaultfontfamily">
  <df:DefaultFontFamily>Segoe UI</df:DefaultFontFamily>
  <AutoRefresh>0</AutoRefresh>
  <DataSources>
    <DataSource Name="DataSource1">
      <ConnectionProperties>
        <DataProvider>SQL</DataProvider>
        <ConnectString>Data Source=pa-hor-as408;Initial Catalog=ZYGO-NAV-PROD</ConnectString>
      </ConnectionProperties>
      <rd:SecurityType>DataBase</rd:SecurityType>
      <rd:DataSourceID>5b55a98d-2bc7-4847-9f65-7597d87c0896</rd:DataSourceID>
    </DataSource>
  </DataSources>
  <DataSets>
    <DataSet Name="DataSet1">
      <Query>
        <DataSourceName>DataSource1</DataSourceName>
        <CommandText>WITH s1 AS
(
	SELECT

	No_
	,[Posting Date]
	,[Applies-to Doc_ No_]
	,[Your Reference]
	,[User ID] [Credit Memo Processor]
	,[Posting Description]
	

	FROM [ZYGO$Sales Cr_Memo Header] sch WHERE [Posting Date] &gt;= '2021-10-01'

	AND [Posting Date] &lt;= '2021-12-31'


	AND [User ID] like '%CSOM'
)
,s2 AS
(
	SELECT

	No_
	,[Credit Memo Processor]
	,[Applies-to Doc_ No_]
	,[Your Reference]

	,COALESCE(CASE
		WHEN LEN([Applies-to Doc_ No_]) &gt; 0 THEN [Applies-to Doc_ No_]
		WHEN CHARINDEX('ZSI', [Your Reference], 0) &gt; 0 THEN RTRIM(SUBSTRING([Your Reference], CHARINDEX('ZSI', [Your Reference], 0),(LEN([Your Reference]) + 1) - CHARINDEX('ZSI', [Your Reference], 0)))
		WHEN No_ = '104224' THEN 'ZSI0005375'
		WHEN No_ = '104248' THEN 'ZSI0007449'
		WHEN No_ = '104285' THEN 'ZSI0009037'
	
	END,'') Invoice
	--,CASE
	--	WHEN LEN([Applies-to Doc_ No_]) &lt; 1 AND CHARINDEX('SO',[Your Reference]) = 0 THEN [Your Reference]
	--	WHEN LEN([Applies-to Doc_ No_]) &lt; 1 AND CHARINDEX('SO',[Your Reference]) &gt; 0 THEN LTRIM(REPLACE([Your Reference],'SO',''))
	--END SalesOrder

	FROM s1
)

SELECT * from s2
/*
sih.No_
,[Order No_] [SalesOrder]

FROM [ZYGO$Sales Invoice Header] sih

INNER JOIN s2 ON s2.Invoice = sih.No_
--ORDER BY No_, [Posting Date]*/</CommandText>
        <rd:UseGenericDesigner>true</rd:UseGenericDesigner>
      </Query>
      <Fields>
        <Field Name="No_">
          <DataField>No_</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Credit_Memo_Processor">
          <DataField>Credit Memo Processor</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Applies_to_Doc__No_">
          <DataField>Applies-to Doc_ No_</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Your_Reference">
          <DataField>Your Reference</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Invoice">
          <DataField>Invoice</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
