  <DataSources>
    <DataSource Name="NAVITAR">
      <DataSourceReference>NAVITAR</DataSourceReference>
      <rd:SecurityType>None</rd:SecurityType>
      <rd:DataSourceID>22b9eac0-df73-4633-826e-ce966b63c383</rd:DataSourceID>
    </DataSource>
  </DataSources>
  <DataSets>
    <DataSet Name="DataSet1">
      <Query>
        <DataSourceName>NAVITAR</DataSourceName>
        <QueryParameters>
          <QueryParameter Name="@startingdate">
            <Value>=Parameters!startingdate.Value</Value>
          </QueryParameter>
          <QueryParameter Name="@endingdate">
            <Value>=Parameters!endingdate.Value</Value>
          </QueryParameter>
        </QueryParameters>
        <CommandText>select

site_ref [Site]
,COALESCE(OldValue,'') [Vendor Number Old Value]
,NewValue [Vendor Number New Value]
,v.name [Vendor Name]
,UserName [Created By]
,a.CreateDate [Date Created]

from AuditLog a

LEFT JOIN vendaddr_mst v on a.NewValue = v.vend_num

WHERE 

Category = 'DA'

AND LogDesc = 'Vendors'

AND MessageDesc = '[vendor_mst].[vend_num]'

AND a.CreateDate &gt;= @startingdate

AND a.CreateDate &lt;= @endingdate</CommandText>
        <rd:UseGenericDesigner>true</rd:UseGenericDesigner>
      </Query>
      <Fields>
        <Field Name="Site">
          <DataField>Site</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Vendor_Number_Old_Value">
          <DataField>Vendor Number Old Value</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Vendor_Number_New_Value">
          <DataField>Vendor Number New Value</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Vendor_Name">
          <DataField>Vendor Name</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Created_By">
          <DataField>Created By</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Date_Created">
          <DataField>Date Created</DataField>
          <rd:TypeName>System.DateTime</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
