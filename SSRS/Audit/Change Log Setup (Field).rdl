<?xml version="1.0" encoding="utf-8"?>
<Report MustUnderstand="df" xmlns="http://schemas.microsoft.com/sqlserver/reporting/2016/01/reportdefinition" xmlns:rd="http://schemas.microsoft.com/SQLServer/reporting/reportdesigner" xmlns:df="http://schemas.microsoft.com/sqlserver/reporting/2016/01/reportdefinition/defaultfontfamily">
  <df:DefaultFontFamily>Segoe UI</df:DefaultFontFamily>
  <AutoRefresh>0</AutoRefresh>
  <DataSources>
    <DataSource Name="NAV">
      <DataSourceReference>NAV</DataSourceReference>
      <rd:SecurityType>None</rd:SecurityType>
      <rd:DataSourceID>3b8f6f65-017d-4d73-a7b8-679445c7232f</rd:DataSourceID>
    </DataSource>
  </DataSources>
  <DataSets>
    <DataSet Name="DataSet1">
      <Query>
        <DataSourceName>NAV</DataSourceName>
        <QueryParameters>
          <QueryParameter Name="@tableNo">
            <Value>=Parameters!tableNo.Value</Value>
          </QueryParameter>
        </QueryParameters>
        <CommandText>WITH s1 AS
(
	SELECT DISTINCT [Table ID],[Field ID], [Field Name]  
	
	FROM [ZYGO$Config_ Package Field]
)

select 

[Table No_]
,o.Name
,[Field No_]
,[Field Name]
,CASE [Log Insertion]
	WHEN 0 THEN 'No'
	WHEN 1 THEN 'Yes'
END [Log Insertion]
,CASE [Log Modification]
	WHEN 0 THEN 'No'
	WHEN 1 THEN 'Yes'
END [Log Modification]
,CASE [Log Deletion]
	WHEN 0 THEN 'No'
	WHEN 1 THEN 'Yes'
END [Log Deletion]


from [ZYGO$Change Log Setup (Field)] s

LEFT JOIN s1 ON s.[Field No_] = s1.[Field ID] AND s.[Table No_] = s1.[Table ID]

LEFT JOIN Object o ON s.[Table No_] = o.ID

WHERE 1=1

AND o.Type = 0

AND [Table No_] = @tableNo

ORDER BY [Table No_], [Field No_]</CommandText>
        <rd:UseGenericDesigner>true</rd:UseGenericDesigner>
      </Query>
      <Fields>
        <Field Name="Table_No_">
          <DataField>Table No_</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
        <Field Name="Name">
          <DataField>Name</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Field_No_">
          <DataField>Field No_</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
        <Field Name="Field_Name">
          <DataField>Field Name</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Log_Insertion">
          <DataField>Log Insertion</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Log_Modification">
          <DataField>Log Modification</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Log_Deletion">
          <DataField>Log Deletion</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
  </DataSets>
