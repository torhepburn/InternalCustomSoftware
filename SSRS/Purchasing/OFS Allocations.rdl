    </DataSource>
  </DataSources>
  <DataSets>
    <DataSet Name="DataSet1">
      <Query>
        <DataSourceName>DataSource1</DataSourceName>
        <CommandText>SELECT 
'Prod Order Component' [Source]
, [Item No_]
--, Quantity
--,[Expected Quantity]
, COALESCE([Remaining Quantity],0) [Outstanding Quantity]
, [Due Date]
, [Prod_ Order No_] [Order No]
, [Prod_ Order Line No_] [Line No]
,[Bin Code]

from [ZYGO$Prod_ Order Component] 

where Status in (2,3)  /*  firm planned, released */	

AND [Bin Code] = 'OFS'

AND [Remaining Quantity] &gt; 0

UNION ALL

SELECT
'Job'
, No_ [Item No_]
--,[Bin Code]
--,WBS
,COALESCE([Outstanding Quantity], 0) [Outstanding Quantity]
,[Due Date]
,[Job No_] [Order No]
,[Line No_] [Line No]
,[Bin Code]

FROM [ZYGO$Job Journal Line]
WHERE 1=1 
AND [Journal Template Name] = 'INVREQ'
AND [Outstanding Quantity] &gt; 0
AND LEN([Bin Code]) &gt; 0
AND [Bin Code] = 'OFS'
--GROUP BY [No_]

UNION ALL

SELECT

'Sales Order'
,No_
,COALESCE([Outstanding Quantity], 0) [Outstanding Amount]
,[Planned Shipment Date] [Due Date]
,[Document No_] [Order No]
,[SO Line No_] [Line No]
,[Bin Code]

FROM [ZYGO$Sales Line]
WHERE 1=1
AND Type = 2 
AND [Completely Shipped] = 0
AND [Outstanding Quantity] &gt; 0
AND [Bin Code] = 'OFS'

UNION ALL

SELECT

'Service Order'
,No_
,COALESCE([Outstanding Quantity], 0) [Outstanding Amount]
,[Planned Delivery Date] [Due Date]
,[Document No_] [Order No]
,[Srv Line No_] [Line No]
,[Bin Code]

FROM [ZYGO$Service Line]
WHERE 1=1
AND Type = 1 
AND [Completely Shipped] = 0
AND [Outstanding Quantity] &gt; 0
AND [Bin Code] = 'OFS'

UNION ALL

SELECT

'Prod Order'
,[Item No_]
,COALESCE([Remaining Quantity],0) [Outstanding Quantity]
,[Due Date]
,[Prod_ Order No_] [Order No]
,[Line No_] [Line No]
,[Bin Code]



from [ZYGO$Prod_ Order Line]

WHERE 

[Bin Code] = 'OFS'
AND Status IN (2,3)
AND [Remaining Quantity] &gt; 0
</CommandText>
        <rd:UseGenericDesigner>true</rd:UseGenericDesigner>
      </Query>
