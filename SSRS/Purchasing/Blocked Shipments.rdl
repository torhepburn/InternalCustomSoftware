        <Field Name="Bill_to_Customer_No_">
          <DataField>Bill-to Customer No_</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Bill_to_Name">
          <DataField>Bill-to Name</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Bill_to_Blocked">
          <DataField>Bill-to Blocked</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Bill_to_Credit_Limit">
          <DataField>Bill-to Credit Limit</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Planned_Shipment_Date">
          <DataField>Planned Shipment Date</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="On_Hold">
          <DataField>On Hold</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="On_Hold_Reason">
          <DataField>On Hold Reason</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="ShipmentTotal">
          <DataField>ShipmentTotal</DataField>
          <rd:TypeName>System.Decimal</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
  </DataSets>
