<?xml version="1.0" encoding="utf-8"?>
<Report MustUnderstand="df" xmlns="http://schemas.microsoft.com/sqlserver/reporting/2016/01/reportdefinition" xmlns:rd="http://schemas.microsoft.com/SQLServer/reporting/reportdesigner" xmlns:df="http://schemas.microsoft.com/sqlserver/reporting/2016/01/reportdefinition/defaultfontfamily">
  <df:DefaultFontFamily>Segoe UI</df:DefaultFontFamily>
  <AutoRefresh>0</AutoRefresh>
  <DataSources>
    <DataSource Name="DataSource1">
      <ConnectionProperties>
        <DataProvider>SQL</DataProvider>
        <ConnectString>Data Source=CT-MID-SQL01.zygo.com;Initial Catalog=AccessFrontEnds</ConnectString>
      </ConnectionProperties>
      <rd:SecurityType>DataBase</rd:SecurityType>
      <rd:DataSourceID>7f3a547d-d117-438d-892a-fe6025e39488</rd:DataSourceID>
    </DataSource>
  </DataSources>
  <DataSets>
    <DataSet Name="DataSet1">
      <Query>
        <DataSourceName>DataSource1</DataSourceName>
        <QueryParameters>
          <QueryParameter Name="@VendorTitle">
            <Value>=Parameters!VendorTitle.Value</Value>
            <rd:UserDefined>true</rd:UserDefined>
          </QueryParameter>
        </QueryParameters>
        <CommandText>With s1 AS
	(
	SELECT

	VendorNo
	,CASE 
		WHEN ContactNumber=1 THEN [Name]
		ELSE ''
	END Contact1
	,CASE 
		WHEN ContactNumber=1 THEN [E-Mail]
		ELSE ''
	END Contact1Email
	,CASE 
		WHEN ContactNumber=2 THEN [Name]
		ELSE ''
	END Contact2
	,CASE 
		WHEN ContactNumber=2 THEN [E-Mail]
		ELSE ''
	END Contact2Email
	,CASE 
		WHEN ContactNumber=3 THEN [Name]
		ELSE ''
	END Contact3
	,CASE 
		WHEN ContactNumber=3 THEN [E-Mail]
		ELSE ''
	END Contact3Email
	,CASE 
		WHEN ContactNumber=4 THEN [Name]
		ELSE ''
	END Contact4
	,CASE 
		WHEN ContactNumber=4 THEN [E-Mail]
		ELSE ''
	END Contact4Email
	,CASE 
		WHEN ContactNumber=5 THEN [Name]
		ELSE ''
	END Contact5
	,CASE 
		WHEN ContactNumber=5 THEN [E-Mail]
		ELSE ''
	END Contact5Email
	,CASE 
		WHEN ContactNumber=6 THEN [Name]
		ELSE ''
	END Contact6
	,CASE 
		WHEN ContactNumber=6 THEN [E-Mail]
		ELSE ''
	END Contact6Email
	,CASE 
		WHEN ContactNumber=7 THEN [Name]
		ELSE ''
	END Contact7
	,CASE 
		WHEN ContactNumber=7 THEN [E-Mail]
		ELSE ''
	END Contact7Email
	,CASE 
		WHEN ContactNumber=8 THEN [Name]
		ELSE ''
	END Contact8
	,CASE 
		WHEN ContactNumber=8 THEN [E-Mail]
		ELSE ''
	END Contact8Email
	FROM NAV.VendorContactS1
	)
,s2 as
(
	SELECT

	VendorNo
	,MAX(Contact1) Contact1
	,MAX(Contact1Email) Contact1Email
	
	,MAX(Contact2) Contact2
	,MAX(Contact2Email) Contact2Email
	
	,MAX(Contact3) Contact3
	,MAX(Contact3Email) Contact3Email
	
	,MAX(Contact4) Contact4
	,MAX(Contact4Email) Contact4Email
	
	,MAX(Contact5) Contact5
	,MAX(Contact5Email) Contact5Email
	
	,MAX(Contact6) Contact6
	,MAX(Contact6Email) Contact6Email

	,MAX(Contact7) Contact7
	,MAX(Contact7Email) Contact7Email

	,MAX(Contact8) Contact8
	,MAX(Contact8Email) Contact8Email

	FROM s1

	GROUP By VendorNo
)


SELECT

v.No_
,v.[Name]
,[Vendor Title]
,[Line of Business of a Supplier]
,[Balance Due]
,[Payment Terms Code]
,[Approval Status]
,[Country_Region Code]
,[Gen_ Bus_ Posting Group]
,[Vendor Posting Group]
,Contact
,[Phone No_]
,COALESCE(v.[EMail],'') Email
,COALESCE(s2.Contact1,'') Contact1
,COALESCE(s2.Contact1EMail,'') [Contact1 Email]

,COALESCE(s2.Contact2,'') Contact2
,COALESCE(s2.Contact2EMail,'') [Contact2 Email]

,COALESCE(s2.Contact3,'') Contact3
,COALESCE(s2.Contact3EMail,'') [Contact3 Email]

,COALESCE(s2.Contact4,'') Contact4
,COALESCE(s2.Contact4EMail,'') [Contact4 Email]

,COALESCE(s2.Contact5,'') Contact5
,COALESCE(s2.Contact5EMail,'') [Contact5 Email]

,COALESCE(s2.Contact6,'') Contact6
,COALESCE(s2.Contact6EMail,'') [Contact6 Email]

,COALESCE(s2.Contact7,'') Contact7
,COALESCE(s2.Contact7EMail,'') [Contact7 Email]

,COALESCE(s2.Contact8,'') Contact8
,COALESCE(s2.Contact8EMail,'') [Contact8 Email]

FROM NAV.Vendor v

LEFT JOIN s2 ON s2.VendorNo = v.No_

WHERE [Vendor Title] NOT IN ( 'EMP', 'FIN')

AND ([Vendor Title] in (@VendorTitle))</CommandText>
        <rd:UseGenericDesigner>true</rd:UseGenericDesigner>
      </Query>
      <Fields>
        <Field Name="No_">
          <DataField>No_</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Name">
          <DataField>Name</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
