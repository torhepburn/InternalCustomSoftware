<?xml version="1.0" encoding="utf-8"?>
<Report xmlns="http://schemas.microsoft.com/sqlserver/reporting/2016/01/reportdefinition" xmlns:rd="http://schemas.microsoft.com/SQLServer/reporting/reportdesigner" xmlns:df="http://schemas.microsoft.com/sqlserver/reporting/2016/01/reportdefinition/defaultfontfamily" MustUnderstand="df">
  <df:DefaultFontFamily>Segoe UI</df:DefaultFontFamily>
  <AutoRefresh>0</AutoRefresh>
  <DataSources>
    <DataSource Name="NAV">
      <DataSourceReference>NAV</DataSourceReference>
      <rd:SecurityType>None</rd:SecurityType>
      <rd:DataSourceID>96e29f5d-324c-4146-9315-7c8ccabfeb57</rd:DataSourceID>
    </DataSource>
  </DataSources>
  <DataSets>
    <DataSet Name="DataSet1">
      <Query>
        <DataSourceName>NAV</DataSourceName>
        <CommandText>SELECT

[Document No_] [PO Number]
,l.No_ [Item Number]
,l.Description [Item Description]
,l.[Unit of Measure] [UOM]
,Quantity [Total Order Quantity]
,[Quantity Received] [Received Quantity]
,[Outstanding Quantity] [Remaining Open Quantity]
,'USD' [Transaction Currency]
,l.[Unit Cost] [Unit Price]
,[Line Amount] [Total Spend]
,h.[Buy-from Vendor No_] [Supplier Number]
,v.Name [Supplier Name]
,[Country_Region Code] [Supplier Country]
,h.[Document Date] [Creation Date]
,l.[Requested Receipt Date] [Need By Date]
,COALESCE([HTS Code],'') [Harmonized System (HS) Code]
,COALESCE([Commodity],'') [Commodity Code]


FROM [ZYGO$Purchase Line] l

INNER JOIN [ZYGO$Purchase Header] h ON l.[Document No_] = h.No_

LEFT JOIN ZYGO$Vendor v ON l.[Buy-from Vendor No_] = v.No_

LEFT JOIN ZYGO$Item i ON l.No_ = i.No_


WHERE [Outstanding Quantity] &lt;&gt; 0

AND h.[Document Type] IN (1,4)

AND [Document Date] &gt;= '2025-01-01'

ORDER BY [Planned Receipt Date]</CommandText>
        <rd:UseGenericDesigner>true</rd:UseGenericDesigner>
      </Query>
