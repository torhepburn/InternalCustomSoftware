<?xml version="1.0" encoding="utf-8"?>
<Report MustUnderstand="df" xmlns="http://schemas.microsoft.com/sqlserver/reporting/2016/01/reportdefinition" xmlns:rd="http://schemas.microsoft.com/SQLServer/reporting/reportdesigner" xmlns:df="http://schemas.microsoft.com/sqlserver/reporting/2016/01/reportdefinition/defaultfontfamily">
  <df:DefaultFontFamily>Segoe UI</df:DefaultFontFamily>
  <AutoRefresh>0</AutoRefresh>
  <DataSources>
    <DataSource Name="NAV">
      <DataSourceReference>NAV</DataSourceReference>
      <rd:SecurityType>None</rd:SecurityType>
      <rd:DataSourceID>b5bfe4eb-067b-412f-b525-5bc0f9d675f9</rd:DataSourceID>
    </DataSource>
  </DataSources>
  <DataSets>
    <DataSet Name="DataSet1">
      <Query>
        <DataSourceName>NAV</DataSourceName>
        <CommandText>WITH s1 AS
(
SELECT
 CASE [Action Message]
	WHEN 1 THEN 'New'
	WHEN 2 THEN 'Change Quantity'
	WHEN 3 THEN 'Reschedule'
	WHEN 4 THEN 'Reschedule and Change Quantity'
	WHEN 5 THEN 'Cancel'
 END [Action Message]
,CASE
	WHEN LEN(l.[Buyer Planner Code]) &gt; 0 THEN (l.[Buyer Planner Code])
	ELSE ' No Buyer'
END [Buyer Planner Code]
,pl.[Buy-from Vendor No_]
,v.Name [Vendor]
,CASE 
	WHEN [Action Message] = 3 THEN
		CASE
			WHEN [Due Date] &gt; [Original Due Date] THEN 'Push Out'
			WHEN [Due Date] &lt; [Original Due Date] THEN 'Pull In'
			ELSE ''
		END
		ELSE ''
	END Direction
,CONVERT(varchar(10),[Due Date], 1) [Due Date]
,CASE COALESCE(pl.[Best Delivery],0) 
     WHEN 0 THEN '' 
     WHEN 1 THEN 'YES' 
 END Best
 
FROM [ZYGO$Requisition Line] l

LEFT JOIN ZYGO$Item i on l.No_ = i.No_

LEFT JOIN [ZYGO$Purchase Line] pl 

ON l.[Ref_ Order No_] = pl.[Document No_]

AND l.[Ref_ Line No_] = pl.[Line No_]

LEFT JOIN ZYGO$Vendor v on pl.[Buy-from Vendor No_] = v.No_

WHERE

[Ref_ Order Type] = 1	--Purchase

AND l.[Replenishment System] = 0	--Purchase

AND l.[Type] = 2

AND i.[Item Group Code] &lt;&gt; 'VMI'

--and [Action Message] in (3) -- Reschedule

AND [Worksheet Template Name] = 'PLANNING'

AND [Journal Batch Name] = 'DEFAULT'

AND i.[Selection Code] not like 'CFM%' 
 AND i.No_ &lt;&gt; '9999' 
 AND i.No_ != 'SERVICE ITEM' 

--AND [Remaining Quantity] &gt; 0

)
,sr1 AS
(
select distinct

r.No_
,r.[Buyer Planner Code]
,'Reschedule' [Action Message]
,CASE
	WHEN [Due Date] &gt; [Original Due Date] THEN 'Push Out'
	WHEN [Due Date] &lt; [Original Due Date] THEN 'Pull In'
	ELSE ''
END Direction
,r.[Original Due Date]
,r.[Due Date]
,r.[Order Date]

,CASE COALESCE(pl.[Best Delivery],0) 
     WHEN 0 THEN '' 
     WHEN 1 THEN 'YES' 
 END Best

 from [ZYGO$Requisition Line] r

INNER JOIN ZYGO$Item i ON r.No_ = i.No_

LEFT JOIN [ZYGO$Purchase Line] pl 

ON r.[Ref_ Order No_] = pl.[Document No_]

AND r.[Ref_ Line No_] = pl.[Line No_]

WHERE [Action Message] = 3

 AND [Ref_ Order Type] = 1                     -- 1 = purchase
 AND r.Type = 2                                --   // type 2 = item
 AND i.[Replenishment System] = 0              --    //0 = purchased 
 AND [Worksheet Template Name] = 'PLANNING' 
 AND [Journal Batch Name] = 'DEFAULT'
 AND i.[Selection Code] not like 'CFM%' 
 AND i.No_ &lt;&gt; '9999' 
 AND i.No_ != 'SERVICE ITEM' 
 AND i.[Item Group Code] &lt;&gt; 'VMI'
 )
 ,sr2 AS
 (
 SELECT * FROM sr1 WHERE

 Direction = 'Push Out'

 AND Best = 'YES'
 )
 ,sr3 AS
 (
 SELECT

 COUNT(Direction) MessageCount
 ,Direction
 ,[Buyer Planner Code]

 FROM sr2

 GROUP BY [Buyer Planner Code],Direction
 )
,s2 AS
(
SELECT

COUNT([Action Message]) MessageCount
,[Buyer Planner Code]
,[Action Message]
,Direction

FROM s1 

GROUP BY 


[Buyer Planner Code]
,[Action Message]
,Direction
)

SELECT 
	
s2.MessageCount - COALESCE(sr3.MessageCount,0) NetMessageCount
,COALESCE(sr3.MessageCount,0) 'OmittedCount'
,s2.[Action Message]
,s2.Direction
,s2.[Buyer Planner Code]

FROM s2

LEFT JOIN sr3 ON s2.[Buyer Planner Code] = sr3.[Buyer Planner Code] AND s2.Direction = sr3.Direction

ORDER BY  [Action Message],s2.Direction,s2.[Buyer Planner Code]

</CommandText>
        <rd:UseGenericDesigner>true</rd:UseGenericDesigner>
      </Query>
      <Fields>
        <Field Name="NetMessageCount">
          <DataField>NetMessageCount</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
        <Field Name="OmittedCount">
          <DataField>OmittedCount</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
        <Field Name="Action_Message">
          <DataField>Action Message</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Direction">
          <DataField>Direction</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Buyer_Planner_Code">
          <DataField>Buyer Planner Code</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
  </DataSets>
