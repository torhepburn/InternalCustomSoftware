<?xml version="1.0" encoding="utf-8"?>
<Report MustUnderstand="df" xmlns="http://schemas.microsoft.com/sqlserver/reporting/2016/01/reportdefinition" xmlns:rd="http://schemas.microsoft.com/SQLServer/reporting/reportdesigner" xmlns:df="http://schemas.microsoft.com/sqlserver/reporting/2016/01/reportdefinition/defaultfontfamily">
  <df:DefaultFontFamily>Segoe UI</df:DefaultFontFamily>
  <AutoRefresh>0</AutoRefresh>
  <DataSources>
    <DataSource Name="NAV">
      <DataSourceReference>NAV</DataSourceReference>
      <rd:SecurityType>None</rd:SecurityType>
      <rd:DataSourceID>7ecad22b-9223-4c54-8a3e-622a820a9ced</rd:DataSourceID>
    </DataSource>
  </DataSources>
  <DataSets>
    <DataSet Name="DataSet1">
      <Query>
        <DataSourceName>NAV</DataSourceName>
        <CommandText>with s1 AS
(
select 

SUM([Forecast Quantity]) ForecastQ
,[Item No_]


from [ZYGO$Production Forecast Entry]

GROUP BY [Item No_]
)
,s2 AS
(
	SELECT
	
	No_
	
	,SUM([Outstanding Quantity]) SOq

	FROM [ZYGO$Sales Line]
	
	GROUP BY No_
)
, s3 AS
(
	SELECT 

	[Item No_]
	,SUM([Remaining Quantity]) WOq

	FROM [ZYGO$Prod_ Order Line]

	WHERE Status IN (2,3)

	GROUP BY [Item No_]
)
,s4 AS
(
	select 

	
	SUM([Quantity]) MRPq
	, No_ 


	from [ZYGO$Requisition Line] l

	WHERE [Action Message] = 1

	GROUP BY No_
)
,s5 AS
(

select

s1.[Item No_]
,COALESCE(s1.ForecastQ,0) ForecastQ
,COALESCE(s2.SOq,0) SOq
,COALESCE(s3.WOq,0) WOq
,COALESCE(s4.MRPq,0) MRPnewQ

FROM s1 

LEFT JOIN s2 ON s1.[Item No_] = s2.No_
LEFT JOIN s3 ON s1.[Item No_] = s3.[Item No_]
LEFT JOIN s4 ON s1.[Item No_] = s4.No_
)
/*
select 

s5.*
,s5.SOq + s5.ForecastQ Demand
,s5.WOq + s5.MRPnewQ Supply
,CASE
	WHEN  (s5.SOq + s5.ForecastQ) &gt; (s5.WOq + s5.MRPnewQ) THEN 'Short'
	WHEN  (s5.SOq + s5.ForecastQ) &lt; (s5.WOq + s5.MRPnewQ) THEN 'Excess'
	ELSE 'BALANCED'
END InventorySituation

FROM s5
*/

select

s1.ForecastQ
,COALESCE(s2.SOq,0) SOq
,CASE
	WHEN ForecastQ &gt; SOq THEN 'FORECAST_OVER'
	WHEN SOq &gt; ForecastQ THEN 'FORECAST_UNDER'
	ELSE 'MATCHED'
END ForecastAccuracy


FROM s1 LEFT JOIN s2 On s1.[Item No_] = s2.No_</CommandText>
        <rd:UseGenericDesigner>true</rd:UseGenericDesigner>
      </Query>
      <Fields>
        <Field Name="ForecastQ">
          <DataField>ForecastQ</DataField>
          <rd:TypeName>System.Decimal</rd:TypeName>
        </Field>
        <Field Name="SOq">
          <DataField>SOq</DataField>
          <rd:TypeName>System.Decimal</rd:TypeName>
        </Field>
        <Field Name="ForecastAccuracy">
          <DataField>ForecastAccuracy</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
  </DataSets>
