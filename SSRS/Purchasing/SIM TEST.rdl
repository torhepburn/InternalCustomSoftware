        </Field>
        <Field Name="Total_Spend">
          <DataField>Total Spend</DataField>
          <rd:TypeName>System.Decimal</rd:TypeName>
        </Field>
        <Field Name="ID__of_Total">
          <DataField>% of Total</DataField>
          <rd:TypeName>System.Decimal</rd:TypeName>
        </Field>
        <Field Name="SIM_Letter">
          <DataField>SIM Letter</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="NAV_SIM">
          <DataField>NAV SIM</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="New_SIM">
          <DataField>New SIM</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
