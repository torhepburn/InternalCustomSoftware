<?xml version="1.0" encoding="utf-8"?>
<Report MustUnderstand="df" xmlns="http://schemas.microsoft.com/sqlserver/reporting/2016/01/reportdefinition" xmlns:rd="http://schemas.microsoft.com/SQLServer/reporting/reportdesigner" xmlns:df="http://schemas.microsoft.com/sqlserver/reporting/2016/01/reportdefinition/defaultfontfamily">
  <df:DefaultFontFamily>Segoe UI</df:DefaultFontFamily>
  <AutoRefresh>0</AutoRefresh>
  <DataSources>
    <DataSource Name="DataSource1">
      <ConnectionProperties>
        <DataProvider>SQL</DataProvider>
        <ConnectString>Data Source=pa-hor-as408;Initial Catalog=ZYGO-NAV-PROD</ConnectString>
      </ConnectionProperties>
      <rd:SecurityType>DataBase</rd:SecurityType>
      <rd:DataSourceID>e233093f-e558-4f75-aa34-c13d9fbf216e</rd:DataSourceID>
    </DataSource>
  </DataSources>
  <DataSets>
    <DataSet Name="DataSet1">
      <Query>
        <DataSourceName>DataSource1</DataSourceName>
        <CommandText>DECLARE @item varchar(50)
SET DATEFIRST 1;
DECLARE @vetted int

SET @vetted = 0

DECLARE @yearstart date
DECLARE @weekstart date

CREATE TABLE #Temp
(
[Item No.] varchar(50)
,[Standard Deviation] decimal(38,6)
,[Average Consumption] decimal(38,6)
,[SIM Number] int
,[CoV] decimal(38,6)
)

CREATE TABLE #LETTER
(
[Item No_] varchar(50)
,[Unit Cost] decimal(38,2)
,Quantity int
,[Item Spend] decimal(38,2)
,[Total Spend] decimal(38,6)
,[% of Total] decimal(38,6)
,[SIM Letter] varchar(1)
,[NAV SIM] varchar(2)
)

SET @yearstart = GETDATE() - 365

select @weekstart = dateadd(week, datediff(week, 0, @yearstart), 0);


DECLARE simCursor CURSOR FOR

/*	Get the list of all items which need to be considered */

SELECT 

No_

FROM ZYGO$Item WHERE (P6 &gt; 0 OR F6 &gt; 0)

AND [Replenishment System] = 0

AND Vetted = @vetted

OPEN simCursor

FETCH NEXT FROM simCursor INTO @item

WHILE @@FETCH_STATUS = 0
BEGIN

WITH s1 AS
(
SELECT 

DATEPART(WEEK,[Posting Date]) [Week Number]
,[Item No_]
,SUM(Quantity)* -1 [Weekly Consumption]

FROM [ZYGO$Item Ledger Entry] ile

INNER JOIN ZYGO$Item i ON ile.[Item No_] = i.No_

WHERE [Posting Date] &gt;= @weekstart

AND ([Entry Type] = 1 --Sale

OR [Entry Type] = 5) --Consumption

AND [Item No_] = @item

GROUP BY DATEPART(WEEK,[Posting Date]), [Item No_]

)
,s2 AS 
 (
  SELECT
  [Week Number]
  ,[Item No_]
  ,CAST([Weekly Consumption] AS decimal) [Weekly Consumption]
  ,1 AS LEVEL
  FROM s1
  UNION ALL
  SELECT
  CAST('1' AS int)
  ,t1.[Item No_]
  ,CAST(0 AS decimal)
  , LEVEL + 1
  FROM s1 t1
  INNER JOIN
  s2 t2
  ON t1.[Item No_] = t2.[Item No_]
  AND LEVEL &lt; 53
 )
 ,s3 AS
 (
SELECT TOP 53

*

FROM s2
)

INSERT INTO #TEMP
(
	[Item No.] 
	,[Standard Deviation] 
	,[Average Consumption]
	,[SIM Number] 
	,[CoV] 
)


SELECT

[Item No_]
,COALESCE(STDEV([Weekly Consumption]),0) Dev
,AVG([Weekly Consumption]) Av
,COALESCE(CASE
	WHEN COALESCE(AVG([Weekly Consumption]),0) &gt; 0
		THEN
	CASE
	WHEN COALESCE(STDEV([Weekly Consumption]),0)/AVG([Weekly Consumption]) = 0 THEN 3
	WHEN COALESCE(STDEV([Weekly Consumption]),0)/AVG([Weekly Consumption]) &gt;= 2 THEN 3
	WHEN COALESCE(STDEV([Weekly Consumption]),0)/AVG([Weekly Consumption]) &gt; 0 AND COALESCE(STDEV([Weekly Consumption]),0)/AVG([Weekly Consumption]) &lt; 1  THEN 2
	WHEN COALESCE(STDEV([Weekly Consumption]),0)/AVG([Weekly Consumption]) &gt;= 1 AND COALESCE(STDEV([Weekly Consumption]),0)/AVG([Weekly Consumption]) &lt; 2  THEN 1
END END,0) [SIM Number]
,COALESCE(CASE
	WHEN COALESCE(AVG([Weekly Consumption]),0) &gt; 0
		THEN COALESCE(STDEV([Weekly Consumption]),0)/AVG([Weekly Consumption])
	END,0) CoV 

FROM s3
GROUP BY [Item No_]







FETCH NEXT FROM simCursor INTO @item
END
CLOSE simCursor
DEALLOCATE simCursor;


WITH s1 AS
(
SELECT

[Item No_]
,SUM(Quantity) * -1 [Item Consumption]

FROM [ZYGO$Item Ledger Entry] ile

INNER JOIN ZYGO$Item i ON ile.[Item No_] = i.No_

WHERE

[Posting Date] &gt;= @weekstart

AND ([Entry Type] = 5 --consumption

OR [Entry Type] = 1) --sale

AND [Replenishment System] = 0

AND Vetted = 0

--AND [Unit Cost] &gt; 0

--AND [Item No_] = '1911-000-109'

GROUP BY [Item No_]
)
,s2 AS
(
SELECT

s1.[Item No_]
,i.[Standard Cost] [Unit Cost]
, [Item Consumption] * [Standard Cost] [Item Spend]
,CASE i.SIM 
	WHEN 0 THEN '0'
	WHEN 1 THEN 'A1'
	WHEN 2 THEN 'A2'
	WHEN 3 THEN 'A3'
	WHEN 4 THEN 'B1'
	WHEN 5 THEN 'B2'
	WHEN 6 THEN 'B3'
	WHEN 7 THEN 'C1'
	WHEN 8 THEN 'C2'
	WHEN 9 THEN 'C3'
END [NAV SIM]

FROM ZYGO$Item i INNER JOIN s1 ON i.No_ = s1.[Item No_]
)

INSERT INTO #LETTER
(
[Item No_]
,[Unit Cost]
,Quantity
,[Item Spend]
,[Total Spend]
,[% of Total]
,[SIM Letter]
,[NAV SIM]
)

SELECT

s1.[Item No_]
,s2.[Unit Cost]
,s1.[Item Consumption] [Quantity]
,s2.[Item Spend]
,SUM(s2.[Item Spend]) OVER ()  [Total Spend]
,s2.[Item Spend]/(SUM(s2.[Item Spend]) OVER ())* 100 [% of Total]
--,SUM([Item Spend]) OVER (ORDER BY [Item Spend]) RunningTotals
,CASE
	WHEN SUM([Item Spend]) OVER (ORDER BY [Item Spend]) &lt;= .05 * SUM([Item Spend]) OVER () THEN 'C'
	WHEN SUM([Item Spend]) OVER (ORDER BY [Item Spend]) &gt; .05 * SUM([Item Spend]) OVER () 
		AND SUM([Item Spend]) OVER (ORDER BY [Item Spend]) &lt; .2  * SUM([Item Spend]) OVER () THEN 'B'
	WHEN SUM([Item Spend]) OVER (ORDER BY [Item Spend]) &gt;= .2 * SUM([Item Spend]) OVER () THEN 'A'
END [SIM Letter]
,[NAV SIM]

FROM s1 LEFT JOIN s2 ON s1.[Item No_] = s2.[Item No_];







--SELECT * FROM #TEMP
--SELECT * FROM #LETTER

WITH sSIM as
(
SELECT

*
,[SIM Letter] + CAST([SIM Number] as varchar(1)) [New SIM]

FROM #TEMP t INNER JOIN #LETTER l ON t.[Item No.] = l.[Item No_] 
)

SELECT

*

--[New SIM]
--,COUNT([New SIM]) Parts
--,SUM([Item Spend]) Spend
--,(SUM([Item Spend])/[Total Spend]) * 100 [Pct of Total]

FROM sSIM

--GROUP BY [New SIM], [Total Spend]

ORDER BY [Item Spend]

--SELECT * FROM #TEMP

--ORDER BY [New SIM] 

--DROP TABLE #TEMP;DROP TABLE #LETTER</CommandText>
        <rd:UseGenericDesigner>true</rd:UseGenericDesigner>
      </Query>
