        </Field>
        <Field Name="Country_Region_Code">
          <DataField>Country_Region Code</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="PO_Number">
          <DataField>PO Number</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
  </DataSets>
