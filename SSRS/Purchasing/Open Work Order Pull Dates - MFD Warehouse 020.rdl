<?xml version="1.0" encoding="utf-8"?>
<Report MustUnderstand="df" xmlns="http://schemas.microsoft.com/sqlserver/reporting/2016/01/reportdefinition" xmlns:rd="http://schemas.microsoft.com/SQLServer/reporting/reportdesigner" xmlns:df="http://schemas.microsoft.com/sqlserver/reporting/2016/01/reportdefinition/defaultfontfamily">
  <df:DefaultFontFamily>Segoe UI</df:DefaultFontFamily>
  <AutoRefresh>0</AutoRefresh>
  <DataSources>
    <DataSource Name="NAV">
      <DataSourceReference>NAV</DataSourceReference>
      <rd:SecurityType>None</rd:SecurityType>
      <rd:DataSourceID>4ca423ed-c7be-4d61-94a4-699fde3b6dac</rd:DataSourceID>
    </DataSource>
  </DataSources>
  <DataSets>
    <DataSet Name="DataSet1">
      <Query>
        <DataSourceName>NAV</DataSourceName>
        <CommandText>WITH s1 AS
(
SELECT  DISTINCT

[Prod_ Order No_]

FROM [ZYGO$Prod_ Order Line] l

WHERE 

l.Status = 3

AND l.[Remaining Quantity] &gt; 0

AND [Finished Quantity] = 0

AND l.[Location Code] = 'MID'

AND [Prod_ Order No_] NOT IN (

	select [Prod_ Order No_] FROM [ZYGO$Prod_ Order Routing Line]

	WHERE [Routing Status] = 2

	AND [Operation No_] &gt; '1000'
		
	AND [Location Code] = 'MID'

	GROUP BY [Prod_ Order No_]

	HAVING MAX([Operation Complete]) = 1
)
)
,s2 AS
(
SELECT DISTINCT

c.[Prod_ Order No_] 


FROM [ZYGO$Prod_ Order Component] c

INNER JOIN s1 ON s1.[Prod_ Order No_] = c.[Prod_ Order No_]

WHERE [Bin Code] like '020%'
)

SELECT

MIN([Starting Date]) [Starting Date]
,l.[Prod_ Order No_]
, [Item No_]
, [Description]
, [Remaining Quantity]

FROM [ZYGO$Prod_ Order Line] l

INNER JOIN s2 ON l.[Prod_ Order No_] = s2.[Prod_ Order No_]

GROUP BY l.[Prod_ Order No_], [Item No_], [Description], [Remaining Quantity]

ORDER BY [Starting Date]</CommandText>
        <rd:UseGenericDesigner>true</rd:UseGenericDesigner>
      </Query>
      <Fields>
        <Field Name="Starting_Date">
          <DataField>Starting Date</DataField>
          <rd:TypeName>System.DateTime</rd:TypeName>
        </Field>
        <Field Name="Prod__Order_No_">
          <DataField>Prod_ Order No_</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Item_No_">
          <DataField>Item No_</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Description">
          <DataField>Description</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Remaining_Quantity">
          <DataField>Remaining Quantity</DataField>
          <rd:TypeName>System.Decimal</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
  </DataSets>
