  <df:DefaultFontFamily>Segoe UI</df:DefaultFontFamily>
  <AutoRefresh>0</AutoRefresh>
  <DataSources>
    <DataSource Name="AccessFrontEnds">
      <DataSourceReference>AccessFrontEnds</DataSourceReference>
      <rd:SecurityType>None</rd:SecurityType>
      <rd:DataSourceID>66a14a5f-361b-4e73-b0b1-593a9ca2bcfc</rd:DataSourceID>
    </DataSource>
  </DataSources>
  <DataSets>
    <DataSet Name="DataSet1">
      <Query>
        <DataSourceName>AccessFrontEnds</DataSourceName>
        <CommandText>
SELECT

ID
,ProdLine
,Priority
,ItemCode
,Description
,CONVERT(varchar(10),DateAddedtoList,101) DateAddedtoList
,COALESCE(CONVERT(varchar(10),DateArchived,101),'') DateArchived
,COALESCE(Supplier,'') Supplier
,COALESCE(Reason,'') Reason
,CASE 
	WHEN DateArchived is not null THEN DATEDIFF(dd,DateAddedtoList, DateArchived)
	ELSE DATEDIFF(dd, DateAddedtoList, GETDATE())
END DaysOnList
FROM Shortage_List

WHERE

(DateArchived is Null or

DateArchived &gt; DATEADD(dd, -7,CAST(GETDATE() as Date)))

ORDER BY Priority, ItemCode</CommandText>
        <rd:UseGenericDesigner>true</rd:UseGenericDesigner>
      </Query>
