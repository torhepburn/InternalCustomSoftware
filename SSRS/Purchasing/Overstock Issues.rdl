<?xml version="1.0" encoding="utf-8"?>
<Report MustUnderstand="df" xmlns="http://schemas.microsoft.com/sqlserver/reporting/2016/01/reportdefinition" xmlns:rd="http://schemas.microsoft.com/SQLServer/reporting/reportdesigner" xmlns:df="http://schemas.microsoft.com/sqlserver/reporting/2016/01/reportdefinition/defaultfontfamily">
  <df:DefaultFontFamily>Segoe UI</df:DefaultFontFamily>
  <AutoRefresh>0</AutoRefresh>
  <DataSources>
    <DataSource Name="NAV">
      <DataSourceReference>NAV</DataSourceReference>
      <rd:SecurityType>None</rd:SecurityType>
      <rd:DataSourceID>d3e29540-c72c-4056-b546-129c0ce82563</rd:DataSourceID>
    </DataSource>
  </DataSources>
  <DataSets>
    <DataSet Name="DataSet1">
      <Query>
        <DataSourceName>NAV</DataSourceName>
        <CommandText>WITH s1 AS
(
SELECT

[Item No_]
,SUM(Quantity) OnHand

FROM [ZYGO$Warehouse Entry]

WHERE [Item No_] IN

(
SELECT No_ FROM [ZYGO$Purchase Line] 

WHERE [Outstanding Quantity] &gt; 0

AND No_ &lt;&gt; '9999'
)

GROUP BY [Item No_]
)

SELECT 

i.No_
,EAU
,s1.OnHand
,[Buyer Planner Code]
,p.[Document No_]

,p.[PO Line No_]
,p.[Outstanding Quantity]
,p.[Expected Receipt Date]
,p.[Buy-from Vendor No_]
,v.Name

FROM ZYGO$Item i

INNER JOIN s1 ON i.No_ = s1.[Item No_]

LEFT JOIN [ZYGO$Purchase Line] p ON p.No_ = i.No_

LEFT JOIN ZYGO$Vendor v ON p.[Buy-from Vendor No_] = v.No_

WHERE i.EAU &lt; s1.OnHand

AND [Outstanding Quantity] &gt; 0

ORDER BY i.No_</CommandText>
        <rd:UseGenericDesigner>true</rd:UseGenericDesigner>
      </Query>
      <Fields>
        <Field Name="No_">
          <DataField>No_</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="EAU">
          <DataField>EAU</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
        <Field Name="OnHand">
          <DataField>OnHand</DataField>
          <rd:TypeName>System.Decimal</rd:TypeName>
        </Field>
        <Field Name="Buyer_Planner_Code">
          <DataField>Buyer Planner Code</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Document_No_">
          <DataField>Document No_</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="PO_Line_No_">
          <DataField>PO Line No_</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
        <Field Name="Outstanding_Quantity">
          <DataField>Outstanding Quantity</DataField>
          <rd:TypeName>System.Decimal</rd:TypeName>
        </Field>
        <Field Name="Expected_Receipt_Date">
          <DataField>Expected Receipt Date</DataField>
          <rd:TypeName>System.DateTime</rd:TypeName>
        </Field>
        <Field Name="Buy_from_Vendor_No_">
          <DataField>Buy-from Vendor No_</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Name">
          <DataField>Name</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
  </DataSets>
