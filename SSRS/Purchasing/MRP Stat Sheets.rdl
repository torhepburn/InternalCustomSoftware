<?xml version="1.0" encoding="utf-8"?>
<Report xmlns="http://schemas.microsoft.com/sqlserver/reporting/2016/01/reportdefinition" xmlns:rd="http://schemas.microsoft.com/SQLServer/reporting/reportdesigner" xmlns:df="http://schemas.microsoft.com/sqlserver/reporting/2016/01/reportdefinition/defaultfontfamily" MustUnderstand="df">
  <df:DefaultFontFamily>Segoe UI</df:DefaultFontFamily>
  <AutoRefresh>0</AutoRefresh>
  <DataSources>
    <DataSource Name="AccessFrontEnds">
      <DataSourceReference>AccessFrontEnds</DataSourceReference>
      <rd:SecurityType>None</rd:SecurityType>
      <rd:DataSourceID>66248a9a-2d84-4c5d-b611-b5dffc244d5e</rd:DataSourceID>
    </DataSource>
  </DataSources>
  <DataSets>
    <DataSet Name="DataSet1">
      <Query>
        <DataSourceName>AccessFrontEnds</DataSourceName>
        <CommandText>WITH s1 AS  /* middlefield purchase news */
(
select

COUNT(Item) MiddlefieldPurchaseNews
,[Buyer Planner Code]
,[Location Code]

from MRP_s1

WHERE 1=1

AND [SelectionCode] &lt;&gt; 'MMX  Min/Max'
AND [SelectionCode] not like 'K%'
AND [SelectionCode] &lt;&gt; 'LTA'
AND [Vetted] &lt;&gt; '1'
AND [ItemGroupCode] &lt;&gt; 'VMI' 
AND CHARINDEX('X', Item, 1) &lt;&gt; 1
AND [ReferenceComponent] &lt;&gt; 1
AND [Location Code] IN ('Middlefield', 'Middlefield MRB', 'Middlefield SVC') 

AND MessageGroup = 'NotCancelOnly'

AND Item IN

(Select No_ from MRP_s1p)

GROUP BY [Buyer Planner Code], [Location Code]
)
, s2 AS /* richmond purchase news*/
(
select

COUNT(Item) RichmondPurchaseNews
,[Buyer Planner Code]
,[Location Code]

from MRP_s1

WHERE 1=1

AND [SelectionCode] &lt;&gt; 'MMX  Min/Max'
AND [SelectionCode] not like 'K%'
AND [SelectionCode] &lt;&gt; 'LTA'
AND [Vetted] &lt;&gt; '1'
AND [ItemGroupCode] &lt;&gt; 'VMI' 
AND CHARINDEX('X', Item, 1) &lt;&gt; 1
AND [ReferenceComponent] &lt;&gt; 1
AND [Location Code] IN ('Richmond', 'Richmond MRB', 'Richmond SVC') 

AND MessageGroup = 'NotCancelOnly'

AND Item IN

(Select No_ from MRP_s1p)

GROUP BY [Buyer Planner Code], [Location Code]
)
,s3 AS /* Min maX purchase news*/
(
select

COUNT(Item) MiMaxPurchaseNews
,[Buyer Planner Code]
,[Location Code]

from MRP_s1

WHERE 1=1

	AND (([SelectionCode] = 'MMX  Min/Max'
    AND [ReferenceComponent] &lt;&gt; 1)
    OR ([ReferenceComponent] = 1 AND ([ItemGroupCode] = 'CNT' OR [SelectionCode] = 'SIC  Statistical Inv Control')))
    AND [Vetted] &lt;&gt; '1'
    AND [ItemGroupCode] &lt;&gt; 'VMI'
    AND [SelectionCode] not like 'K%'
    AND [SelectionCode] not like 'LTA%'
    AND CHARINDEX('X', Item, 1) &lt;&gt; 1 

AND MessageGroup = 'NotCancelOnly'

AND Item IN

(Select No_ from MRP_s1p)

GROUP BY [Buyer Planner Code], [Location Code]
)
,s4 AS /* X purchase news*/
(
select

COUNT(Item) XPurchaseNews
,[Buyer Planner Code]
,[Location Code]

from MRP_s1

WHERE 1=1

	AND (CHARINDEX('X', Item, 1) = 1 OR [Vetted] = '1')
    AND [ReferenceComponent] &lt;&gt; 1
    AND [Location Code] NOT IN ('IRV', 'IRV MRB', 'Richmond', 'Richmond MRB', 'Richmond SVC')
    AND [SelectionCode] not like 'K%'
    AND [SelectionCode] not like 'LTA%'
    AND [ItemGroupCode] &lt;&gt; 'VMI'  

AND MessageGroup = 'NotCancelOnly'

AND Item IN

(Select No_ from MRP_s1p)

GROUP BY [Buyer Planner Code], [Location Code]
)
,s5 AS /* Kanban purchase news*/
(
select

COUNT(Item) KanbanPurchaseNews
,[Buyer Planner Code]
,[Location Code]

from MRP_s1

WHERE 1=1

	AND [SelectionCode] like 'KBP%'
    AND [ReferenceComponent] &lt;&gt; 1
    AND [ItemGroupCode] &lt;&gt; 'VMI'  

AND MessageGroup = 'NotCancelOnly'

AND Item IN

(Select No_ from MRP_s1p)

GROUP BY [Buyer Planner Code], [Location Code]
)
,s6 AS /* LTA purchase news*/
(
select

COUNT(Item) LTAPurchaseNews
,[Buyer Planner Code]
--,[Location Code]

from MRP_s1

WHERE 1=1

	AND [SelectionCode] like 'LTA%'
    AND [ReferenceComponent] &lt;&gt; 1
    AND [ItemGroupCode] &lt;&gt; 'VMI'  

AND MessageGroup = 'NotCancelOnly'

AND Item IN

(Select No_ from MRP_s1p)

GROUP BY [Buyer Planner Code] --, [Location Code]
)
, s7 AS /* richmond X*/
(
select

COUNT(Item) RichmondX
,[Buyer Planner Code]
,[Location Code]

from MRP_s1

WHERE 1=1

	AND (CHARINDEX('X', Item, 1) = 1 OR [Vetted] = '1')
    AND [ReferenceComponent] &lt;&gt; 1
    AND [Location Code] IN ('Richmond', 'Richmond MRB', 'Richmond SVC')
    AND [SelectionCode] not like 'K%'
    AND [SelectionCode] &lt;&gt; 'LTA'
    AND [ItemGroupCode] &lt;&gt; 'VMI'  

AND MessageGroup = 'NotCancelOnly'

AND Item IN

(Select No_ from MRP_s1p)

GROUP BY [Buyer Planner Code], [Location Code]
)


,s1r AS  /* middlefield purchase news */
(
select

COUNT(Item) MiddlefieldReschedules
,[Buyer Planner Code]
,[Location Code]

from MRP_s1

WHERE 1=1

AND [SelectionCode] &lt;&gt; 'MMX  Min/Max'
AND [SelectionCode] not like 'K%'
AND [SelectionCode] &lt;&gt; 'LTA'
AND [Vetted] &lt;&gt; '1'
AND [ItemGroupCode] &lt;&gt; 'VMI' 
AND CHARINDEX('X', Item, 1) &lt;&gt; 1
AND [ReferenceComponent] &lt;&gt; 1
AND [Location Code] IN ('Middlefield', 'Middlefield MRB', 'Middlefield SVC') 

AND MessageGroup = 'NotCancelOnly'

AND Item IN

(Select No_ from MRP_s1o)

GROUP BY [Buyer Planner Code], [Location Code]
)
, s2r AS /* richmond purchase news*/
(
select

COUNT(Item) RichmondPurchaseNews
,[Buyer Planner Code]
,[Location Code]

from MRP_s1

WHERE 1=1

AND [SelectionCode] &lt;&gt; 'MMX  Min/Max'
AND [SelectionCode] not like 'K%'
AND [SelectionCode] &lt;&gt; 'LTA'
AND [Vetted] &lt;&gt; '1'
AND [ItemGroupCode] &lt;&gt; 'VMI' 
AND CHARINDEX('X', Item, 1) &lt;&gt; 1
AND [ReferenceComponent] &lt;&gt; 1
AND [Location Code] IN ('Richmond', 'Richmond MRB', 'Richmond SVC') 

AND MessageGroup = 'NotCancelOnly'

AND Item IN

(Select No_ from MRP_s1o)

GROUP BY [Buyer Planner Code], [Location Code]
)
,s3r AS /* Min maX purchase news*/
(
select

COUNT(Item) MiMaxPurchaseNews
,[Buyer Planner Code]
,[Location Code]

from MRP_s1

WHERE 1=1

	AND (([SelectionCode] = 'MMX  Min/Max'
    AND [ReferenceComponent] &lt;&gt; 1)
    OR ([ReferenceComponent] = 1 AND ([ItemGroupCode] = 'CNT' OR [SelectionCode] = 'SIC  Statistical Inv Control')))
    AND [Vetted] &lt;&gt; '1'
    AND [ItemGroupCode] &lt;&gt; 'VMI'
    AND [SelectionCode] not like 'K%'
    AND [SelectionCode] not like 'LTA%'
    AND CHARINDEX('X', Item, 1) &lt;&gt; 1 

AND MessageGroup = 'NotCancelOnly'

AND Item IN

(Select No_ from MRP_s1o)

GROUP BY [Buyer Planner Code], [Location Code]
)
,s4r AS /* X purchase news*/
(
select

COUNT(Item) XPurchaseNews
,[Buyer Planner Code]
,[Location Code]

from MRP_s1

WHERE 1=1

	AND (CHARINDEX('X', Item, 1) = 1 OR [Vetted] = '1')
    AND [ReferenceComponent] &lt;&gt; 1
    AND [Location Code] NOT IN ('IRV', 'IRV MRB', 'Richmond', 'Richmond MRB', 'Richmond SVC')
    AND [SelectionCode] not like 'K%'
    AND [SelectionCode] not like 'LTA%'
    AND [ItemGroupCode] &lt;&gt; 'VMI'  

AND MessageGroup = 'NotCancelOnly'

AND Item IN

(Select No_ from MRP_s1o)

GROUP BY [Buyer Planner Code], [Location Code]
)
,s5r AS /* Kanban purchase news*/
(
select

COUNT(Item) KanbanPurchaseNews
,[Buyer Planner Code]
,[Location Code]

from MRP_s1

WHERE 1=1

	AND [SelectionCode] like 'KBP%'
    AND [ReferenceComponent] &lt;&gt; 1
    AND [ItemGroupCode] &lt;&gt; 'VMI'  

AND MessageGroup = 'NotCancelOnly'

AND Item IN

(Select No_ from MRP_s1o)

GROUP BY [Buyer Planner Code], [Location Code]
)
,s6r AS /* LTA reschedules*/
(
select

COUNT(Item) LTAPurchaseNews
,[Buyer Planner Code]
--,[Location Code]

from MRP_s1

WHERE 1=1

	AND [SelectionCode] like 'LTA%'
    AND [ReferenceComponent] &lt;&gt; 1
    AND [ItemGroupCode] &lt;&gt; 'VMI'  

AND MessageGroup = 'NotCancelOnly'

AND Item IN

(Select No_ from MRP_s1o)

GROUP BY [Buyer Planner Code] --, [Location Code]
)
, s7r AS /* richmond X*/
(
select

COUNT(Item) RichmondX
,[Buyer Planner Code]
,[Location Code]

from MRP_s1

WHERE 1=1

	AND (CHARINDEX('X', Item, 1) = 1 OR [Vetted] = '1')
    AND [ReferenceComponent] &lt;&gt; 1
    AND [Location Code] IN ('Richmond', 'Richmond MRB', 'Richmond SVC')
    AND [SelectionCode] not like 'K%'
    AND [SelectionCode] &lt;&gt; 'LTA'
    AND [ItemGroupCode] &lt;&gt; 'VMI'  

AND MessageGroup = 'NotCancelOnly'

AND Item IN

(Select No_ from MRP_s1o)

GROUP BY [Buyer Planner Code], [Location Code]
)
,s8 AS
(
	SELECT 

	[Buyer Planner Code]
	,COUNT(Item) Cancels
	
	FROM MRP_S1 WHERE MessageGroup = 'CancelOnly'

	GROUP BY [Buyer Planner Code]
)

select

 s1.[Buyer Planner Code]
,COALESCE(s1.MiddlefieldPurchaseNews,0) MiddlefieldPurchaseNews
,COALESCE(s1r.MiddlefieldReschedules,0) MiddlefieldReschedules
,COALESCE(s2.RichmondPurchaseNews,0) RichmondPurchaseNews
,COALESCE(s2r.RichmondPurchaseNews,0) RichmondReschedules
,COALESCE(s3.MiMaxPurchaseNews,0) MinMaxPurchaseNews
,COALESCE(s3r.MiMaxPurchaseNews,0) MinMaxReschedules
,COALESCE(s4.XPurchaseNews,0) XPurchaseNews
,COALESCE(s4r.XPurchaseNews,0) XReschedules
,COALESCE(s5.KanbanPurchaseNews,0) KanbanPurchaseNews
,COALESCE(s5r.KanbanPurchaseNews,0) KanbanReschedules
,COALESCE(s6.LTAPurchaseNews,0) LTAPurchaseNews
,COALESCE(s6r.LTAPurchaseNews,0) LTAreschedules
,COALESCE(s7.RichmondX,0) RichmondXPurchaseNews
,COALESCE(s7r.RichmondX,0) RichmondXReschedules
,COALESCE(s8.Cancels,0) Cancels

from s1

LEFT JOIN s2 ON s1.[Buyer Planner Code] = s2.[Buyer Planner Code]
LEFT JOIN s3 ON s1.[Buyer Planner Code] = s3.[Buyer Planner Code]
LEFT JOIN s4 ON s1.[Buyer Planner Code] = s4.[Buyer Planner Code]
LEFT JOIN s5 ON s1.[Buyer Planner Code] = s5.[Buyer Planner Code]
LEFT JOIN s6 ON s1.[Buyer Planner Code] = s6.[Buyer Planner Code]
LEFT JOIN s7 ON s1.[Buyer Planner Code] = s7.[Buyer Planner Code]

LEFT JOIN s1r ON s1.[Buyer Planner Code] = s1r.[Buyer Planner Code]
LEFT JOIN s2r ON s1.[Buyer Planner Code] = s2r.[Buyer Planner Code]
LEFT JOIN s3r ON s1.[Buyer Planner Code] = s3r.[Buyer Planner Code]
LEFT JOIN s4r ON s1.[Buyer Planner Code] = s4r.[Buyer Planner Code]
LEFT JOIN s5r ON s1.[Buyer Planner Code] = s5r.[Buyer Planner Code]
LEFT JOIN s6r ON s1.[Buyer Planner Code] = s6r.[Buyer Planner Code]
LEFT JOIN s7r ON s1.[Buyer Planner Code] = s7r.[Buyer Planner Code]

LEFT JOIN s8 ON s1.[Buyer Planner Code] = s8.[Buyer Planner Code]</CommandText>
        <rd:UseGenericDesigner>true</rd:UseGenericDesigner>
      </Query>
      <Fields>
        <Field Name="Buyer_Planner_Code">
          <DataField>Buyer Planner Code</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="MiddlefieldPurchaseNews">
          <DataField>MiddlefieldPurchaseNews</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
        <Field Name="MiddlefieldReschedules">
