<?xml version="1.0" encoding="utf-8"?>
<Report MustUnderstand="df" xmlns="http://schemas.microsoft.com/sqlserver/reporting/2016/01/reportdefinition" xmlns:rd="http://schemas.microsoft.com/SQLServer/reporting/reportdesigner" xmlns:df="http://schemas.microsoft.com/sqlserver/reporting/2016/01/reportdefinition/defaultfontfamily">
  <df:DefaultFontFamily>Segoe UI</df:DefaultFontFamily>
  <AutoRefresh>0</AutoRefresh>
  <DataSources>
    <DataSource Name="NAV">
      <DataSourceReference>NAV</DataSourceReference>
      <rd:SecurityType>None</rd:SecurityType>
      <rd:DataSourceID>2ea957b3-01d1-4322-a053-87d45af63437</rd:DataSourceID>
    </DataSource>
  </DataSources>
  <DataSets>
    <DataSet Name="DataSet1">
      <Query>
        <DataSourceName>NAV</DataSourceName>
        <CommandText>WITH s1 AS
(
	SELECT DISTINCT [Table ID],[Field ID], [Field Name]  
	
	FROM [ZYGO$Config_ Package Field]
)
,s2 AS
(
SELECT

--[Entry No_]
--,[Date and Time]
--,[User ID]
--,[Field No_]
--,[Field Name]
--,[Type of Change]
MIN([Old Value]) Previous_Date
,MAX([New Value]) New_Date
--,[Primary Key Field 1 Value]
,[Primary Key Field 2 Value] PO_Number
,[Primary Key Field 3 Value] Line_Number

FROM [ZYGO$Change Log Entry] e

LEFT JOIN s1 f ON e.[Table No_] = f.[Table ID] AND e.[Field No_] = f.[Field ID]


where [Table ID] = 39

and [Type of Change] = 1 --modification

AND [Primary Key Field 1 Value] &lt;&gt; 2

AND [Field No_] IN (5791) --promised receipt date

AND [Date and Time] &gt;= DATEADD(ww, -1,GETDATE())

AND LEN([Old Value]) &gt; 0

AND [New Value] &gt; [Old Value]

GROUP BY

[Primary Key Field 2 Value]
,[Primary Key Field 3 Value] 

)

, s3 AS
(
SELECT 

h.[Pay-to Name] Supplier
,h.[Pay-to Vendor No_] Vendor_Number
,s2.PO_Number
,l.[Line No_]
,l.[PO Line No_]
,s2.Previous_Date
,s2.New_Date
,DATEDIFF(DD, s2.Previous_Date,s2.New_Date) DayChange
,l.[Outstanding Quantity]
,l.[Line Amount] [Current Line Amount]

FROM [ZYGO$Purchase Header] h 

INNER JOIN [ZYGO$Purchase Line] l ON h.No_ = l.[Document No_]

INNER JOIN s2 ON s2.PO_Number = h.No_ AND s2.Line_Number = l.[Line No_]

WHERE l.No_ &lt;&gt; '9999'

AND PO_Number NOT LIKE 'KB-%'

AND [Completely Received] = 0  --false
)

select *

--Supplier
--,Vendor_Number
--,s3.PO_Number
--,s3.[Line No_]
--,s3.[PO Line No_]
--,Previous_Date
--,New_Date
--,COALESCE(s21.Previous_Quantity,'') Previous_Qty
--,COALESCE(s21.New_Quantity,'') New_Qty

from s3

--left join s21 ON s3.PO_Number = s21.PO_Number AND s3.[Line No_] = s21.LineNumber

ORDER BY 

Supplier
,PO_Number
,[PO Line No_]

----[Primary Key Field 2 Value]
----,[Primary Key Field 3 Value]</CommandText>
        <rd:UseGenericDesigner>true</rd:UseGenericDesigner>
      </Query>
      <Fields>
        <Field Name="Supplier">
          <DataField>Supplier</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Vendor_Number">
          <DataField>Vendor_Number</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="PO_Number">
          <DataField>PO_Number</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Line_No_">
          <DataField>Line No_</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
        <Field Name="PO_Line_No_">
          <DataField>PO Line No_</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
        <Field Name="Previous_Date">
          <DataField>Previous_Date</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="New_Date">
          <DataField>New_Date</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="DayChange">
          <DataField>DayChange</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
        <Field Name="Outstanding_Quantity">
          <DataField>Outstanding Quantity</DataField>
          <rd:TypeName>System.Decimal</rd:TypeName>
        </Field>
        <Field Name="Current_Line_Amount">
          <DataField>Current Line Amount</DataField>
          <rd:TypeName>System.Decimal</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
  </DataSets>
