<?xml version="1.0" encoding="utf-8"?>
<Report MustUnderstand="df" xmlns="http://schemas.microsoft.com/sqlserver/reporting/2016/01/reportdefinition" xmlns:rd="http://schemas.microsoft.com/SQLServer/reporting/reportdesigner" xmlns:df="http://schemas.microsoft.com/sqlserver/reporting/2016/01/reportdefinition/defaultfontfamily">
  <df:DefaultFontFamily>Segoe UI</df:DefaultFontFamily>
  <AutoRefresh>0</AutoRefresh>
  <DataSources>
    <DataSource Name="NAV">
      <DataSourceReference>NAV</DataSourceReference>
      <rd:SecurityType>None</rd:SecurityType>
      <rd:DataSourceID>ad67fc97-5369-4024-bb4a-8999b78ef28a</rd:DataSourceID>
    </DataSource>
  </DataSources>
  <DataSets>
    <DataSet Name="DataSet1">
      <Query>
        <DataSourceName>NAV</DataSourceName>
        <CommandText>CREATE TABLE #Daily
(
	[Document No_] [nvarchar](20)
	,[Line No_] [int]
	,[No_] [nvarchar](20)
	,[Description] [nvarchar](50)
	,[Dollar Amount Shipped] [decimal](38, 20)
	,[Quantity Invoiced] [decimal](38, 20)
	,[Order No_] [nvarchar](20)
	,[VAT Base Amount] [decimal](38, 20)
);
	

WITH s1 AS
(

select 

 [Document No_] [Shipment Number]
 ,[Line No_]
,[Order No_]
,[SO Line No_]
,[Quantity Invoiced] 
,[Quantity Invoiced] * [Unit Price] [Dollar Amount Shipped]
,[VAT Base Amount]
,No_
,Description

from [ZYGO$Sales Shipment Line]

where [Posting Date] = CAST(GETDATE()-1 as date) 

AND [Location Code] IN ('MID', 'MID SVC')

AND Type = 2 --Item

AND Quantity &gt; 0

UNION ALL

select 

 [Document No_] d
,[Line No_]
,[Order No_]
,0
, [Quantity Invoiced]
,CASE
	WHEN [VAT Base Amount] &gt; 0 THEN [VAT Base Amount]
	WHEN [VAT Base Amount] = 0 THEN ([Quantity Invoiced] * [Unit Cost] )
END [Dollar Amount Shipped]
,[VAT Base Amount]
,No_
,Description

from [ZYGO$Service Shipment Line]

where 1=1

AND [Posting Date] = CAST(GETDATE()-1 as date) 

AND [Location Code] IN ('MID', 'MID SVC')

AND Type = 1 --Item

AND Quantity &gt; 0
)

INSERT INTO #Daily

(
	[Document No_]
	,[Line No_]
	,[No_]
	,[Description]
	,[Dollar Amount Shipped]
	,[Quantity Invoiced]
	,[Order No_]
	,[VAT Base Amount]
)

select 

[Shipment Number]
	,[Line No_]
	,[No_]
	,[Description]
	,[Dollar Amount Shipped]
	,[Quantity Invoiced]
	,[Order No_]
	,[VAT Base Amount]


from s1;

WITH s2 AS
(
	SELECT DISTINCT [Order No_] Orders FROM #Daily
)
, s3 AS
(
 SELECT COUNT([Orders])[Orders Shipped],0 [Lines Shipped], 0 [Dollars Shipped] FROM s2
--SELECT *  FROM #Daily 
UNION 

SELECT 

0
, Count([Order No_])[Lines Shipped] 
,SUM([Dollar Amount Shipped]) [Dollars Shipped] 

FROM #Daily

)

SELECT

SUM([Orders Shipped]) [Orders Shipped]
,SUM([Lines Shipped]) [Lines Shipped]
,SUM([Dollars Shipped]) [Dollars Shipped]

FROM s3

--DROP TABLE #Daily
--</CommandText>
        <rd:UseGenericDesigner>true</rd:UseGenericDesigner>
      </Query>
      <Fields>
        <Field Name="Orders_Shipped">
          <DataField>Orders Shipped</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
        <Field Name="Lines_Shipped">
          <DataField>Lines Shipped</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
        <Field Name="Dollars_Shipped">
          <DataField>Dollars Shipped</DataField>
          <rd:TypeName>System.Decimal</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
