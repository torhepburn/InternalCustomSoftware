<?xml version="1.0" encoding="utf-8"?>
<Report MustUnderstand="df" xmlns="http://schemas.microsoft.com/sqlserver/reporting/2016/01/reportdefinition" xmlns:rd="http://schemas.microsoft.com/SQLServer/reporting/reportdesigner" xmlns:df="http://schemas.microsoft.com/sqlserver/reporting/2016/01/reportdefinition/defaultfontfamily">
  <df:DefaultFontFamily>Segoe UI</df:DefaultFontFamily>
  <AutoRefresh>0</AutoRefresh>
  <DataSources>
    <DataSource Name="AccessFrontEnds">
      <DataSourceReference>AccessFrontEnds</DataSourceReference>
      <rd:SecurityType>None</rd:SecurityType>
      <rd:DataSourceID>bcd90c56-26a2-4598-b8a3-4be161c0777e</rd:DataSourceID>
    </DataSource>
  </DataSources>
  <DataSets>
    <DataSet Name="DataSet1">
      <Query>
        <DataSourceName>AccessFrontEnds</DataSourceName>
        <CommandText>WITH s1 AS
(
	SELECT PartNumber
,[PONumber]
      ,[POLineNumber]
      ,[InitiatedDate]
      ,[InitiatedQty]
      ,[InitiatedOwner]
	  ,p.Name
      ,[TransactionType]
      ,[CompletedDate]
      ,[CompletedQty]
      ,[CompletedOwner]
      ,t.[Status]
      ,[DueDate]
      ,[SupplierCommitDate]
      ,[SupplierCommitQty]
      ,[ContractLineReleaseConfirmation]
      ,[CommitOperator]
      ,[DateCommitted]
      ,[SupplierCommitComment]
      
      ,[ReceivedAtDock]
      ,[LocationTrackingConfirmation]
      ,[FromWarehouse]
      ,[ToWarehouse]
      ,[ProductionOrder]
      ,[PlannerUserID]
  FROM [MIDDB01.zygo.com].[Dashboard].[dbo].[KanbanTransactions] t

  INNER JOIN [MIDDB01.zygo.com].[Dashboard].[dbo].Kanban k ON t.KanbanID = k.KanbanID

  LEFT JOIN [MIDDB01.zygo.com].[Dashboard].[dbo].Person p on p.UserID = t.InitiatedOwner

  WHERE InitiatedDate between '2024-12-01' and '2024-12-31'


)
,s2 as
(


select 

n.item
,n.[Order Qty] NAVordqty
,n.[Dlvrd Qty] NAVdlvrqty
,n.[OPEN QTY] NAVopenqty
,s1.initiatedqty DBinitiatedqty
,n.[Order Date] NAVorderDate
,s1.initiateddate DBinitiatedDate
,n.RELEASE

 from KanbanDec24 n

INNER JOIN s1 ON n.ITEM = s1.partnumber  AND s1.InitiatedQty = n.[ORDER QTY]

AND CAST([Order Date] as date) = CAST(initiateddate as date)
)


select * from s2




/*
select distinct item from KanbanDec24

WHERE Item not in (select item from s2)
*/</CommandText>
        <rd:UseGenericDesigner>true</rd:UseGenericDesigner>
      </Query>
      <Fields>
        <Field Name="item">
          <DataField>item</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="NAVordqty">
          <DataField>NAVordqty</DataField>
          <rd:TypeName>System.Decimal</rd:TypeName>
        </Field>
        <Field Name="NAVdlvrqty">
          <DataField>NAVdlvrqty</DataField>
          <rd:TypeName>System.Decimal</rd:TypeName>
        </Field>
        <Field Name="NAVopenqty">
          <DataField>NAVopenqty</DataField>
          <rd:TypeName>System.Decimal</rd:TypeName>
        </Field>
        <Field Name="DBinitiatedqty">
          <DataField>DBinitiatedqty</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
        <Field Name="NAVorderDate">
          <DataField>NAVorderDate</DataField>
          <rd:TypeName>System.DateTime</rd:TypeName>
        </Field>
        <Field Name="DBinitiatedDate">
          <DataField>DBinitiatedDate</DataField>
          <rd:TypeName>System.DateTime</rd:TypeName>
        </Field>
        <Field Name="RELEASE">
          <DataField>RELEASE</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
