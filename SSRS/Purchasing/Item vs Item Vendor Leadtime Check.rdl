  <AutoRefresh>0</AutoRefresh>
  <DataSources>
    <DataSource Name="NAV">
      <DataSourceReference>NAV</DataSourceReference>
      <rd:SecurityType>None</rd:SecurityType>
      <rd:DataSourceID>1f1775b0-4900-45c0-9363-5465770c8206</rd:DataSourceID>
    </DataSource>
  </DataSources>
  <DataSets>
    <DataSet Name="DataSet1">
      <Query>
        <DataSourceName>NAV</DataSourceName>
        <CommandText>SELECT

'Lead Time' ErrorClass
,i.No_
,i.Description
,i.[Lead Time Calculation] [Item Lead Time]
,iv.[Lead Time Calculation] [Item Vendor Lead Time]
,i.[Safety Lead Time]
,iv.[Vendor No_]
,v.Name [Vendor Name]

FROM ZYGO$Item i

LEFT JOIN [ZYGO$Item Vendor] iv ON i.No_ = iv.[Item No_]

LEFT JOIN ZYGO$Vendor v ON iv.[Vendor No_] = v.No_

WHERE i.[Lead Time Calculation] &lt;&gt; iv.[Lead Time Calculation]</CommandText>
        <rd:UseGenericDesigner>true</rd:UseGenericDesigner>
      </Query>
      <Fields>
        <Field Name="ErrorClass">
          <DataField>ErrorClass</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="No_">
          <DataField>No_</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Description">
          <DataField>Description</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Item_Lead_Time">
          <DataField>Item Lead Time</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Item_Vendor_Lead_Time">
