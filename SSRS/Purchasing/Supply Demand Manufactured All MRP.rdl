<?xml version="1.0" encoding="utf-8"?>
<Report MustUnderstand="df" xmlns="http://schemas.microsoft.com/sqlserver/reporting/2016/01/reportdefinition" xmlns:rd="http://schemas.microsoft.com/SQLServer/reporting/reportdesigner" xmlns:df="http://schemas.microsoft.com/sqlserver/reporting/2016/01/reportdefinition/defaultfontfamily">
  <df:DefaultFontFamily>Segoe UI</df:DefaultFontFamily>
  <AutoRefresh>0</AutoRefresh>
  <DataSources>
    <DataSource Name="NAV">
      <DataSourceReference>NAV</DataSourceReference>
      <rd:SecurityType>None</rd:SecurityType>
      <rd:DataSourceID>cf97691c-74be-4020-92e7-495d550c1691</rd:DataSourceID>
    </DataSource>
  </DataSources>
  <DataSets>
    <DataSet Name="DataSet1">
      <Query>
        <DataSourceName>NAV</DataSourceName>
        <CommandText>with s1 AS
(
select 

SUM([Forecast Quantity]) ForecastQ
,[Item No_]

from [ZYGO$Production Forecast Entry]

where [Item No_] IN
(
select 

DISTINCT [Item No_]

from [ZYGO$Production Forecast Entry] f

LEFT JOIN ZYGO$Item i on f.[Item No_] = i.No_

WHERE i.[Replenishment System] = 1 /* manufactured item */
)


GROUP BY [Item No_]
)
,s2 AS
(
	SELECT
	
	No_
	
	,SUM([Outstanding Quantity]) SOq

	FROM [ZYGO$Sales Line]
	
	GROUP BY No_
)
, s3 AS
(
	SELECT 

	[Item No_]
	,SUM([Remaining Quantity]) WOq

	FROM [ZYGO$Prod_ Order Line]

	WHERE Status IN (2,3)

	GROUP BY [Item No_]
)
,s4 AS
(
	select 
	
	SUM([Quantity]) MRPq
	, No_ 

	from [ZYGO$Requisition Line] l

	WHERE [Worksheet Template Name] = 'PLANNING'

	AND [Journal Batch Name] = 'DEFAULT'
	
	AND [Action Message] = 1

	GROUP BY No_
)
,s4a AS
(
	SELECT
	[Item No_]
	 ,SUM([Remaining Quantity]) [Qty on Prod Order Component] 
	--,YEAR([Due Date]) yDate
	--,DATEPART(ISO_WEEK,[Due Date]) wDate
	
	FROM [ZYGO$Prod_ Order Component]
		
	WHERE Status in (2, 3)

	GROUP BY [Item No_]

)
,s4b AS
(
	select 

	[Item No_] 
	,SUM([Expected Quantity]) [Qty on Planning Component]
	--,YEAR([Due Date]) yDate
	--,DATEPART(ISO_WEEK,[Due Date]) wDate
	
	FROM [ZYGO$Planning Component]

	where 1=1

	AND [Worksheet Template Name] = 'PLANNING'

	AND [Worksheet Batch Name] = 'DEFAULT'

	GROUP BY [Item No_]
)
, s4c as
(	--Qty on Service Orders  Type 1 = Item Type 2 = Resource
	SELECT
	No_
    ,COALESCE(SUM([Outstanding Quantity]), 0) [Qty on Service Order]
	
	FROM [ZYGO$Service Line] WHERE [Type] = 1
		
    GROUP BY No_
	
)
, s4d as
(	--Qty on Inventory Request - Jobs
	SELECT
	No_
    ,COALESCE(SUM([Outstanding Quantity]), 0) [Qty on Inventory Request]
	
	FROM [ZYGO$Job Journal Line]
    WHERE [Journal Template Name] = 'INVREQ'
	AND [Outstanding Quantity] &gt; 0
	
	GROUP BY No_
	
)
,sOHn as
(	--On Hand Nettable
	SELECT 
	[Item No_]
	,SUM(Quantity) Nettable
	FROM [ZYGO$Item Ledger Entry]
	WHERE [Non-Nettable] = 0
	GROUP BY [Item No_]

)
,sOHnn as
(	--On Hand Non-Nettable
	SELECT 
	[Item No_]
	,SUM(Quantity) NonNettable
	FROM [ZYGO$Item Ledger Entry]
	WHERE [Non-Nettable] = 1
	GROUP BY [Item No_]
)

,s5 AS
(

select

s4.[No_]
,COALESCE(s1.ForecastQ,0) [Forecast Qty]
,COALESCE(s2.SOq,0) [Sales Order Qty]
,COALESCE(s4c.[Qty on Service Order],0) [Qty on Service Order]
,COALESCE(s4d.[Qty on Inventory Request],0) [Qty on inventory Request]
,COALESCE(s3.WOq,0) [WO Qty]
,COALESCE(s4a.[Qty on Prod Order Component],0) [WO Component Qty]
,COALESCE(s4.MRPq,0) MRPnewQ
, COALESCE(s4b.[Qty on Planning Component],0) PlnCompQty
,(COALESCE(s4.MRPq,0)) - COALESCE(s4b.[Qty on Planning Component],0) ActionMessages
,COALESCE(sOHn.Nettable,0) Nettable
,COALESCE(sOHnn.NonNettable,0) NonNettable

FROM s4 

LEFT JOIN s2 ON s4.[No_] = s2.No_
LEFT JOIN s3 ON s4.[No_] = s3.[Item No_]
LEFT JOIN s1 ON s4.[No_] = s1.[Item No_]
LEFT JOIN sOHn ON s4.[No_] = sOHn.[Item No_]
LEFT JOIN sOHnn ON s4.[No_] = sOHnn.[Item No_]
LEFT JOIN s4a ON s4.[No_] = s4a.[Item No_]
LEFT JOIN s4b ON s4.[No_] = s4b.[Item No_]
LEFT JOIN s4c ON s4.[No_] = s4c.[No_]
LEFT JOIN s4d ON s4.[No_] = s4d.[No_]

)

select 

s5.*
,s5.[Sales Order Qty] + s5.[Forecast Qty] + s5.[WO Component Qty] + [Qty on Service Order] + [Qty on inventory Request] Demand
,s5.[WO Qty] + (s5.MRPnewQ - s5.PlnCompQty) + s5.Nettable 'Supply (includes inv)'
,s5.Nettable + s5.NonNettable TotalInv
,CASE
	WHEN  (s5.[Sales Order Qty] + s5.[Forecast Qty] + s5.[WO Component Qty]  + [Qty on Service Order] + [Qty on inventory Request] ) &gt; (s5.[WO Qty] + (s5.MRPnewQ - s5.PlnCompQty) + s5.Nettable) THEN 'Short'
	WHEN  (s5.[Sales Order Qty] + s5.[Forecast Qty] + s5.[WO Component Qty]  + [Qty on Service Order] + [Qty on inventory Request] ) &lt; (s5.[WO Qty] + (s5.MRPnewQ - s5.PlnCompQty) + s5.Nettable) THEN 'Excess'
	ELSE 'BALANCED'
END InventorySituation

FROM s5

--where [No_] = '6024-1598-01'</CommandText>
        <rd:UseGenericDesigner>true</rd:UseGenericDesigner>
      </Query>
      <Fields>
        <Field Name="No_">
          <DataField>No_</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Forecast_Qty">
          <DataField>Forecast Qty</DataField>
          <rd:TypeName>System.Decimal</rd:TypeName>
        </Field>
        <Field Name="Sales_Order_Qty">
          <DataField>Sales Order Qty</DataField>
          <rd:TypeName>System.Decimal</rd:TypeName>
        </Field>
        <Field Name="Qty_on_Service_Order">
          <DataField>Qty on Service Order</DataField>
          <rd:TypeName>System.Decimal</rd:TypeName>
        </Field>
        <Field Name="Qty_on_inventory_Request">
          <DataField>Qty on inventory Request</DataField>
          <rd:TypeName>System.Decimal</rd:TypeName>
        </Field>
        <Field Name="WO_Qty">
          <DataField>WO Qty</DataField>
          <rd:TypeName>System.Decimal</rd:TypeName>
        </Field>
        <Field Name="WO_Component_Qty">
          <DataField>WO Component Qty</DataField>
          <rd:TypeName>System.Decimal</rd:TypeName>
        </Field>
        <Field Name="MRPnewQ">
          <DataField>MRPnewQ</DataField>
          <rd:TypeName>System.Decimal</rd:TypeName>
        </Field>
        <Field Name="PlnCompQty">
          <DataField>PlnCompQty</DataField>
          <rd:TypeName>System.Decimal</rd:TypeName>
        </Field>
        <Field Name="ActionMessages">
          <DataField>ActionMessages</DataField>
          <rd:TypeName>System.Decimal</rd:TypeName>
        </Field>
        <Field Name="Nettable">
          <DataField>Nettable</DataField>
          <rd:TypeName>System.Decimal</rd:TypeName>
        </Field>
        <Field Name="NonNettable">
          <DataField>NonNettable</DataField>
          <rd:TypeName>System.Decimal</rd:TypeName>
        </Field>
        <Field Name="Demand">
          <DataField>Demand</DataField>
          <rd:TypeName>System.Decimal</rd:TypeName>
        </Field>
        <Field Name="Supply__includes_inv_">
          <DataField>Supply (includes inv)</DataField>
          <rd:TypeName>System.Decimal</rd:TypeName>
        </Field>
        <Field Name="TotalInv">
          <DataField>TotalInv</DataField>
          <rd:TypeName>System.Decimal</rd:TypeName>
        </Field>
        <Field Name="InventorySituation">
          <DataField>InventorySituation</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
  </DataSets>
