<?xml version="1.0" encoding="utf-8"?>
<Report MustUnderstand="df" xmlns="http://schemas.microsoft.com/sqlserver/reporting/2016/01/reportdefinition" xmlns:rd="http://schemas.microsoft.com/SQLServer/reporting/reportdesigner" xmlns:df="http://schemas.microsoft.com/sqlserver/reporting/2016/01/reportdefinition/defaultfontfamily">
  <df:DefaultFontFamily>Segoe UI</df:DefaultFontFamily>
  <AutoRefresh>0</AutoRefresh>
  <DataSources>
    <DataSource Name="NAV">
      <DataSourceReference>NAV</DataSourceReference>
      <rd:SecurityType>None</rd:SecurityType>
      <rd:DataSourceID>d8bdc7c9-1ec9-41f4-ad37-44cd8ad8f0d1</rd:DataSourceID>
    </DataSource>
  </DataSources>
  <DataSets>
    <DataSet Name="DataSet1">
      <Query>
        <DataSourceName>NAV</DataSourceName>
        <QueryParameters>
          <QueryParameter Name="@StartingOldPromisedDeliveryDate">
            <Value>=Parameters!StartingOldPromisedDeliveryDate.Value</Value>
          </QueryParameter>
          <QueryParameter Name="@EndingOldPromisedDeliveryDate">
            <Value>=Parameters!EndingOldPromisedDeliveryDate.Value</Value>
          </QueryParameter>
          <QueryParameter Name="@StartingNewPromisedDeliveryDate">
            <Value>=Parameters!StartingNewPromisedDeliveryDate.Value</Value>
          </QueryParameter>
          <QueryParameter Name="@reasonCode">
            <Value>=Parameters!reasonCode.Value</Value>
          </QueryParameter>
          <QueryParameter Name="@EndingNewPromisedDeliveryDate">
            <Value>=Parameters!EndingNewPromisedDeliveryDate.Value</Value>
          </QueryParameter>
        </QueryParameters>
        <CommandText>SELECT

[Document No_]
,[Line No_]
,[SO Line No_]
,[Old Requested Delivery Date]
,[Old Promised Delivery Date]
,[New Requested Delivery Date]
,[New Promised Delivery Date]
,[Change Date Reason Code]
,[Last Date Modified]
,[Modified by User]
,Comment
,r.Description

FROM [ZYGO$Change Sales Date Reason Entry] e

LEFT JOIN [ZYGO$Change Date Reasons] r ON e.[Change Date Reason Code] = r.Code

WHERE 1=1

AND ([Old Promised Delivery Date] &gt;= @StartingOldPromisedDeliveryDate
OR @StartingOldPromisedDeliveryDate IS NULL)

AND([Old Promised Delivery Date] &lt;= @EndingOldPromisedDeliveryDate
OR @EndingOldPromisedDeliveryDate IS NULL)

AND ([New Promised Delivery Date] &gt;= @StartingNewPromisedDeliveryDate
OR @StartingNewPromisedDeliveryDate IS NULL)

AND([New Promised Delivery Date] &lt;= @EndingNewPromisedDeliveryDate
OR @EndingNewPromisedDeliveryDate IS NULL)

AND [Change Date Reason Code] = @reasonCode</CommandText>
        <rd:UseGenericDesigner>true</rd:UseGenericDesigner>
      </Query>
      <Fields>
        <Field Name="Document_No_">
          <DataField>Document No_</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Line_No_">
          <DataField>Line No_</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
        <Field Name="SO_Line_No_">
          <DataField>SO Line No_</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
        <Field Name="Old_Requested_Delivery_Date">
          <DataField>Old Requested Delivery Date</DataField>
          <rd:TypeName>System.DateTime</rd:TypeName>
        </Field>
        <Field Name="Old_Promised_Delivery_Date">
          <DataField>Old Promised Delivery Date</DataField>
          <rd:TypeName>System.DateTime</rd:TypeName>
        </Field>
        <Field Name="New_Requested_Delivery_Date">
          <DataField>New Requested Delivery Date</DataField>
          <rd:TypeName>System.DateTime</rd:TypeName>
        </Field>
        <Field Name="New_Promised_Delivery_Date">
          <DataField>New Promised Delivery Date</DataField>
          <rd:TypeName>System.DateTime</rd:TypeName>
        </Field>
        <Field Name="Change_Date_Reason_Code">
          <DataField>Change Date Reason Code</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Last_Date_Modified">
          <DataField>Last Date Modified</DataField>
          <rd:TypeName>System.DateTime</rd:TypeName>
        </Field>
        <Field Name="Modified_by_User">
          <DataField>Modified by User</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Comment">
          <DataField>Comment</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Description">
          <DataField>Description</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
    <DataSet Name="DataSet2">
      <Query>
        <DataSourceName>NAV</DataSourceName>
        <CommandText>SELECT Code from [ZYGO$Change Date Reasons] WHERE Sales = 1</CommandText>
      </Query>
      <Fields>
        <Field Name="Code">
          <DataField>Code</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
