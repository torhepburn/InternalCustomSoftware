<?xml version="1.0" encoding="utf-8"?>
<Report MustUnderstand="df" xmlns="http://schemas.microsoft.com/sqlserver/reporting/2016/01/reportdefinition" xmlns:rd="http://schemas.microsoft.com/SQLServer/reporting/reportdesigner" xmlns:df="http://schemas.microsoft.com/sqlserver/reporting/2016/01/reportdefinition/defaultfontfamily">
  <df:DefaultFontFamily>Segoe UI</df:DefaultFontFamily>
  <AutoRefresh>0</AutoRefresh>
  <DataSources>
    <DataSource Name="NAV">
      <DataSourceReference>NAV</DataSourceReference>
      <rd:SecurityType>None</rd:SecurityType>
      <rd:DataSourceID>0eede215-fe5c-40da-9fa0-2e985cd0bda1</rd:DataSourceID>
    </DataSource>
  </DataSources>
  <DataSets>
    <DataSet Name="DataSet1">
      <Query>
        <DataSourceName>NAV</DataSourceName>
        <CommandText>WITH s1 AS
(
SELECT DISTINCT

[Prod_ Order No_]
,[Item No_]
,Description
,[Remaining Quantity]
,[Bin Code]
,[Due Date]


FROM [ZYGO$Prod_ Order Component]

WHERE [Prod_ Order No_] IN

(SELECT DISTINCT

[Prod_ Order No_]

FROM [ZYGO$Prod_ Order Component]

WHERE Status = 3

AND [Remaining Quantity] = 0

AND [Location Code] = 'MID'

AND [Bin Code] LIKE '020%'

AND [Prod_ Order No_] IN

(
	SELECT DISTINCT

	[Prod_ Order No_]

	FROM [ZYGO$Prod_ Order Component]

	WHERE Status = 3

	AND [Remaining Quantity] &gt; 0

	AND [Bin Code] LIKE '020%'

	AND [Location Code] = 'MID'

	AND [Prod_ Order No_] IN

	(
		SELECT [Prod_ Order No_] FROM [ZYGO$Prod_ Order Component] 

		WHERE Status = 3

		AND [Remaining Quantity] &gt; 0

		AND [Location Code] = 'MID'

		AND [Bin Code] LIKE '020%'

		GROUP BY [Prod_ Order No_]

		 HAVING MAX([Prod_ Order Line No_]) = 10000
	)
)
)

AND [Remaining Quantity] &gt; 0

AND Description not like '#%'

AND [Bin Code] LIKE '020%'

AND [Item No_] NOT LIKE '1000-%'

--AND ASCII(LEFT(Description,1)) &lt;&gt; 37
)
, s2 AS
(
SELECT

[Item No_]
,SUM(Quantity) OnHand

FROM [ZYGO$Item Ledger Entry]

WHERE [Item No_] IN 
(
	SELECT DISTINCT [Item No_] FROM s1
)

GROUP BY [Item No_]
)
, s3 AS
(
SELECT 

s1.*
,COALESCE(s2.OnHand, 0) OnHand

FROM s1 LEFT JOIN s2 ON s1.[Item No_] = s2.[Item No_]

WHERE OnHand &gt; 0
)


select 

s3.*
, [Assigned User ID] [Planner]

from s3

LEFT JOIN [ZYGO$Production Order] o ON s3.[Prod_ Order No_] = o.No_

ORDER BY 

[Due Date]
</CommandText>
        <rd:UseGenericDesigner>true</rd:UseGenericDesigner>
      </Query>
      <Fields>
        <Field Name="Prod__Order_No_">
          <DataField>Prod_ Order No_</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Item_No_">
          <DataField>Item No_</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Description">
          <DataField>Description</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Remaining_Quantity">
          <DataField>Remaining Quantity</DataField>
          <rd:TypeName>System.Decimal</rd:TypeName>
        </Field>
        <Field Name="Bin_Code">
          <DataField>Bin Code</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Due_Date">
          <DataField>Due Date</DataField>
          <rd:TypeName>System.DateTime</rd:TypeName>
        </Field>
        <Field Name="OnHand">
          <DataField>OnHand</DataField>
          <rd:TypeName>System.Decimal</rd:TypeName>
        </Field>
        <Field Name="Planner">
          <DataField>Planner</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
  </DataSets>
