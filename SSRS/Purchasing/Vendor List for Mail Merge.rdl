<?xml version="1.0" encoding="utf-8"?>
<Report MustUnderstand="df" xmlns="http://schemas.microsoft.com/sqlserver/reporting/2016/01/reportdefinition" xmlns:rd="http://schemas.microsoft.com/SQLServer/reporting/reportdesigner" xmlns:df="http://schemas.microsoft.com/sqlserver/reporting/2016/01/reportdefinition/defaultfontfamily">
  <df:DefaultFontFamily>Segoe UI</df:DefaultFontFamily>
  <AutoRefresh>0</AutoRefresh>
  <DataSources>
    <DataSource Name="DataSource1">
      <ConnectionProperties>
        <DataProvider>SQL</DataProvider>
        <ConnectString>Data Source=pa-hor-as408.ametek.com;Initial Catalog=ZYGO-NAV-PROD</ConnectString>
      </ConnectionProperties>
      <rd:SecurityType>DataBase</rd:SecurityType>
      <rd:DataSourceID>2868584a-f223-4cea-8d9c-74142a363de9</rd:DataSourceID>
    </DataSource>
  </DataSources>
  <DataSets>
    <DataSet Name="DataSet1">
      <Query>
        <DataSourceName>DataSource1</DataSourceName>
        <QueryParameters>
          <QueryParameter Name="@VendorTitle">
            <Value>=Parameters!VendorTitle.Value</Value>
          </QueryParameter>
        </QueryParameters>
        <CommandText>WITH s1 as
(
	SELECT [Contact No_], No_ FROM [ZYGO$Contact Business Relation] WHERE [Business Relation Code] = 'SUPP'
)
, s2 as
(
SELECT 

Name
,[E-Mail]
,s1.No_

from [ZYGO$Contact] c

INNER JOIN s1 ON c.[Company No_] = s1.[Contact No_]
)
,s3 as
(
	SELECT  
	
		[Vendor No_]
		,SUM([Purchase (LCY)]) [Balance Due]

	FROM [ZYGO$Vendor Ledger Entry]
	
	GROUP BY [Vendor No_] 
)




SELECT

v.No_
,v.[Name]
,[Vendor Title]
,[Line of Business of a Supplier]
,COALESCE(s3.[Balance Due] * (-1),0) [Balance Due]
,[Payment Terms Code]
,CASE [Approval Status]
	WHEN 0 THEN 'Approved'
	WHEN 1 THEN 'Not Approved'
	ELSE ''
END [Approval Status]
,[Country_Region Code]
,[Gen_ Bus_ Posting Group]
,[Vendor Posting Group]
,Contact
,[Phone No_]
,COALESCE(v.[E-Mail],'') [Email]
,COALESCE(s2.[Name],'') [Other Contact]
,COALESCE(s2.[E-Mail],'') [Other Email]



FROM ZYGO$Vendor v

LEFT JOIN s2 on v.No_ = s2.No_

LEFT JOIN s3 on v.No_ = s3.[Vendor No_]

WHERE [Vendor Title] NOT IN ( 'EMP', 'FIN')

AND ([Vendor Title] in (@VendorTitle))


--AND v.No_ = '1100'</CommandText>
        <rd:UseGenericDesigner>true</rd:UseGenericDesigner>
      </Query>
      <Fields>
        <Field Name="No_">
          <DataField>No_</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Name">
          <DataField>Name</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Vendor_Title">
          <DataField>Vendor Title</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Line_of_Business_of_a_Supplier">
          <DataField>Line of Business of a Supplier</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Balance_Due">
          <DataField>Balance Due</DataField>
          <rd:TypeName>System.Decimal</rd:TypeName>
        </Field>
        <Field Name="Payment_Terms_Code">
