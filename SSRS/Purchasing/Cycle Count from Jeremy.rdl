        </Field>
        <Field Name="Bin_Code">
          <DataField>Bin Code</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Count">
          <DataField>Count</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="On_Hand">
          <DataField>On Hand</DataField>
          <rd:TypeName>System.Decimal</rd:TypeName>
        </Field>
        <Field Name="Pc_Variance">
          <DataField>Pc Variance</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Standard_Cost">
          <DataField>Standard Cost</DataField>
          <rd:TypeName>System.Decimal</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
