<?xml version="1.0" encoding="utf-8"?>
<Report MustUnderstand="df" xmlns="http://schemas.microsoft.com/sqlserver/reporting/2016/01/reportdefinition" xmlns:rd="http://schemas.microsoft.com/SQLServer/reporting/reportdesigner" xmlns:df="http://schemas.microsoft.com/sqlserver/reporting/2016/01/reportdefinition/defaultfontfamily">
  <df:DefaultFontFamily>Segoe UI</df:DefaultFontFamily>
  <AutoRefresh>0</AutoRefresh>
  <DataSources>
    <DataSource Name="NAV">
      <DataSourceReference>NAV</DataSourceReference>
      <rd:SecurityType>None</rd:SecurityType>
      <rd:DataSourceID>648673d1-d360-40f3-8dc3-8ece4926d2c1</rd:DataSourceID>
    </DataSource>
  </DataSources>
  <DataSets>
    <DataSet Name="DataSet1">
      <Query>
        <DataSourceName>NAV</DataSourceName>
        <CommandText>select

	[Prod_ Order No_]
	,[Prod_ Order Line No_]
	,[Item No_] i
	,i.[Description]
	,[Remaining Quantity]
	,[Selection Code]
	,o.[Source No_] [BOM]
	
	from [ZYGO$Prod_ Order Component] c

	INNER JOIN ZYGO$Item i on c.[Item No_] = i.No_

	INNER JOIN [ZYGO$Production Order] o ON c.[Prod_ Order No_] = o.No_

	WHERE c.Status IN (3)

	AND i.[Selection Code] = 'SIC'

	AND i.[Signal Code] != 'OBS'

	AND Vetted = 0

	--GROUP BY [Item No_], [Prod_ Order No_]

	AND [Remaining Quantity] &gt; 0

	order by [Item No_]</CommandText>
        <rd:UseGenericDesigner>true</rd:UseGenericDesigner>
      </Query>
      <Fields>
        <Field Name="Prod__Order_No_">
          <DataField>Prod_ Order No_</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Prod__Order_Line_No_">
          <DataField>Prod_ Order Line No_</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
        <Field Name="i">
          <DataField>i</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Description">
          <DataField>Description</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Remaining_Quantity">
          <DataField>Remaining Quantity</DataField>
          <rd:TypeName>System.Decimal</rd:TypeName>
        </Field>
        <Field Name="Selection_Code">
          <DataField>Selection Code</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="BOM">
          <DataField>BOM</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
  </DataSets>
