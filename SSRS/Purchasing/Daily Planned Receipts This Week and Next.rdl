<?xml version="1.0" encoding="utf-8"?>
<Report MustUnderstand="df" xmlns="http://schemas.microsoft.com/sqlserver/reporting/2016/01/reportdefinition" xmlns:rd="http://schemas.microsoft.com/SQLServer/reporting/reportdesigner" xmlns:df="http://schemas.microsoft.com/sqlserver/reporting/2016/01/reportdefinition/defaultfontfamily">
  <df:DefaultFontFamily>Segoe UI</df:DefaultFontFamily>
  <AutoRefresh>0</AutoRefresh>
  <DataSources>
    <DataSource Name="NAV">
      <DataSourceReference>NAV</DataSourceReference>
      <rd:SecurityType>None</rd:SecurityType>
      <rd:DataSourceID>259634ce-031f-43a2-8c1a-256bfc12f3a1</rd:DataSourceID>
    </DataSource>
  </DataSources>
  <DataSets>
    <DataSet Name="DataSet1">
      <Query>
        <DataSourceName>NAV</DataSourceName>
        <CommandText>select 

l.[Planned Receipt Date]
,v.Name Vendor
,[Document No_]
,[PO Line No_]
,l.No_
,l.Description
,l.[Outstanding Quantity]
, l.Amount

from [ZYGO$Purchase Line] l

LEFT JOIN ZYGO$Vendor v ON l.[Buy-from Vendor No_] = v.No_

where l.[Outstanding Quantity] &gt; 0

and l.[Document Type] = 1


AND DATEPART(weekday, GETDATE()) = 2  --Monday

AND [Planned Receipt Date] BETWEEN CAST(GETDATE() as date) AND DATEADD(dd, 13, CAST(GETDATE() as date))

UNION ALL

select 

l.[Planned Receipt Date]
,COALESCE(v.Name,'') Vendor
,[Document No_]
,[PO Line No_]
,l.No_
,l.Description
,l.[Outstanding Quantity]
, l.Amount

from [ZYGO$Purchase Line] l

LEFT JOIN ZYGO$Vendor v ON l.[Buy-from Vendor No_] = v.No_

where l.[Outstanding Quantity] &gt; 0

and l.[Document Type] = 1

AND DATEPART(weekday, GETDATE()) = 3  --Tuesday

AND [Planned Receipt Date] BETWEEN CAST(GETDATE() as date) AND DATEADD(dd, 13-1, CAST(GETDATE() as date))

UNION ALL

select 

l.[Planned Receipt Date]
,COALESCE(v.Name,'') Vendor
,[Document No_]
,[PO Line No_]
,l.No_
,l.Description
,l.[Outstanding Quantity]
, l.Amount

from [ZYGO$Purchase Line] l

LEFT JOIN ZYGO$Vendor v ON l.[Buy-from Vendor No_] = v.No_

where l.[Outstanding Quantity] &gt; 0

and l.[Document Type] = 1


AND DATEPART(weekday, GETDATE()) = 4  --Wednesday

AND [Planned Receipt Date] BETWEEN CAST(GETDATE() as date) AND DATEADD(dd, 13-2, CAST(GETDATE() as date))

UNION ALL

select 

l.[Planned Receipt Date]
,v.Name Vendor
,[Document No_]
,[PO Line No_]
,l.No_
,l.Description
,l.[Outstanding Quantity]
, l.Amount

from [ZYGO$Purchase Line] l

LEFT JOIN ZYGO$Vendor v ON l.[Buy-from Vendor No_] = v.No_

where l.[Outstanding Quantity] &gt; 0

and l.[Document Type] = 1

AND DATEPART(weekday, GETDATE()) = 5  --Thursday

AND [Planned Receipt Date] BETWEEN CAST(GETDATE() as date) AND DATEADD(dd, 13-3, CAST(GETDATE() as date))

UNION ALL

select 

l.[Planned Receipt Date]
,v.Name Vendor
,[Document No_]
,[PO Line No_]
,l.No_
,l.Description
,l.[Outstanding Quantity]
, l.Amount

from [ZYGO$Purchase Line] l

LEFT JOIN ZYGO$Vendor v ON l.[Buy-from Vendor No_] = v.No_

where l.[Outstanding Quantity] &gt; 0

and l.[Document Type] = 1

AND DATEPART(weekday, GETDATE()) = 6  --Friday

AND [Planned Receipt Date] BETWEEN CAST(GETDATE() as date) AND DATEADD(dd, 13-4, CAST(GETDATE() as date))

ORDER BY [Planned Receipt Date]</CommandText>
        <rd:UseGenericDesigner>true</rd:UseGenericDesigner>
      </Query>
      <Fields>
        <Field Name="Planned_Receipt_Date">
          <DataField>Planned Receipt Date</DataField>
          <rd:TypeName>System.DateTime</rd:TypeName>
        </Field>
        <Field Name="Vendor">
          <DataField>Vendor</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Document_No_">
          <DataField>Document No_</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="PO_Line_No_">
