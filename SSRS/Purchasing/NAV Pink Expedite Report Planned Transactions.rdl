	(Fields!Trans_Type.Value.ToString().Contains("Issue")) AND (Fields!Pl_Trans_Date.Value&lt;Now()),"BLUE"
	,Fields!Trans_Type.Value.ToString().Contains("Receipt") AND (Fields!Pl_Trans_Date.Value&lt;Now()),"RED"
	)</Color>
