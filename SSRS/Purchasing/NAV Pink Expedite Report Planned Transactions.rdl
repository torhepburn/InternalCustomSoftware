  <DataSources>
    <DataSource Name="AccessFrontEnds">
      <DataSourceReference>AccessFrontEnds</DataSourceReference>
      <rd:SecurityType>None</rd:SecurityType>
      <rd:DataSourceID>224b8f6e-2efe-4aaa-a5c2-3fe99a36ba5a</rd:DataSourceID>
    </DataSource>
  </DataSources>
  <DataSets>
    <DataSet Name="DataSet1">
      <Query>
        <DataSourceName>AccessFrontEnds</DataSourceName>
        <CommandText>select * from NAV_Stock_Transaction_Report

WHERE (LEN([Late]) &gt; 0 OR LEN(NegInvBal) &gt; 0)

AND [Pl Trans Date] &lt;= DATEADD(week,8,GETDATE())

AND LEFT(Description,1) NOT IN ('&amp;','#')

ORDER BY 

[Business Segment], [Item No_], R#</CommandText>
        <rd:UseGenericDesigner>true</rd:UseGenericDesigner>
      </Query>
      <Fields>
        <Field Name="R_">
          <DataField>R#</DataField>
          <rd:TypeName>System.Int64</rd:TypeName>
        </Field>
