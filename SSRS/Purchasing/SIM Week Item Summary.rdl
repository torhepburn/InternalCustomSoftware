<?xml version="1.0" encoding="utf-8"?>
<Report MustUnderstand="df" xmlns="http://schemas.microsoft.com/sqlserver/reporting/2016/01/reportdefinition" xmlns:rd="http://schemas.microsoft.com/SQLServer/reporting/reportdesigner" xmlns:df="http://schemas.microsoft.com/sqlserver/reporting/2016/01/reportdefinition/defaultfontfamily">
  <df:DefaultFontFamily>Segoe UI</df:DefaultFontFamily>
  <AutoRefresh>0</AutoRefresh>
  <DataSources>
    <DataSource Name="DataSource1">
      <ConnectionProperties>
        <DataProvider>SQL</DataProvider>
        <ConnectString>Data Source=pa-hor-as408;Initial Catalog=ZYGO-NAV-PROD</ConnectString>
      </ConnectionProperties>
      <rd:SecurityType>DataBase</rd:SecurityType>
      <rd:DataSourceID>4ab3e277-69b3-415c-981e-35277d6a2c77</rd:DataSourceID>
    </DataSource>
  </DataSources>
  <DataSets>
    <DataSet Name="DataSet1">
      <Query>
        <DataSourceName>DataSource1</DataSourceName>
        <QueryParameters>
          <QueryParameter Name="@item">
            <Value>=Parameters!ItemCode.Value</Value>
          </QueryParameter>
        </QueryParameters>
        <CommandText>--DECLARE @item varchar(50)

--SET @item = '01-0723';

WITH s1 AS
(
SELECT

DATEPART(WEEK,[Posting Date]) [Week Number]
,[Item No_]
,SUM(Quantity) [Weekly Consumption]

FROM [ZYGO$Item Ledger Entry] ile

INNER JOIN ZYGO$Item i ON ile.[Item No_] = i.No_

WHERE [Posting Date] &gt;= GETDATE()-365

AND [Document Type] = 5 --Consumption

AND [Item No_] = @item

--AND SIM &gt; 0

GROUP BY DATEPART(WEEK,[Posting Date]), [Item No_]
),

 recurs AS 
 (
  SELECT
  [Week Number]
  ,[Item No_]
  ,CAST([Weekly Consumption] AS int) [Weekly Consumption]
    , 1 AS LEVEL
  FROM s1
  UNION ALL
  SELECT
  CAST('1' AS int)
  ,t1.[Item No_]
  ,0
  , LEVEL + 1
  FROM s1 t1
  INNER JOIN
  recurs t2
  ON t1.[Item No_] = t2.[Item No_]
  AND LEVEL &lt; 53
 ), s3 AS
 (
SELECT TOP 53 *
FROM recurs
)

SELECT

[Item No_]
,COALESCE(STDEV([Weekly Consumption]),0) Dev
,AVG(CAST([Weekly Consumption] as decimal (38,6))) Av
,COALESCE(CASE
	WHEN COALESCE(AVG([Weekly Consumption]),0) &gt; 0
		THEN
	CASE
	WHEN COALESCE(STDEV([Weekly Consumption]),0)/AVG([Weekly Consumption]) = 0 THEN 3
	WHEN COALESCE(STDEV([Weekly Consumption]),0)/AVG([Weekly Consumption]) &gt;= 2 THEN 3
	WHEN COALESCE(STDEV([Weekly Consumption]),0)/AVG([Weekly Consumption]) &gt; 0 AND COALESCE(STDEV([Weekly Consumption]),0)/AVG([Weekly Consumption]) &lt; 1  THEN 2
	WHEN COALESCE(STDEV([Weekly Consumption]),0)/AVG([Weekly Consumption]) &gt;= 1 AND COALESCE(STDEV([Weekly Consumption]),0)/AVG([Weekly Consumption]) &lt; 2  THEN 1
END END,0) [SIM Number]
,COALESCE(CASE
	WHEN COALESCE(AVG([Weekly Consumption]),0) &gt; 0
		THEN COALESCE(STDEV([Weekly Consumption]),0)/AVG([Weekly Consumption])
	END,0) CoV 

FROM s3
GROUP BY [Item No_]</CommandText>
        <rd:UseGenericDesigner>true</rd:UseGenericDesigner>
      </Query>
      <Fields>
        <Field Name="Item_No_">
          <DataField>Item No_</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Dev">
          <DataField>Dev</DataField>
          <rd:TypeName>System.Double</rd:TypeName>
        </Field>
        <Field Name="Av">
          <DataField>Av</DataField>
          <rd:TypeName>System.Decimal</rd:TypeName>
        </Field>
        <Field Name="SIM_Number">
          <DataField>SIM Number</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
        <Field Name="CoV">
          <DataField>CoV</DataField>
          <rd:TypeName>System.Double</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
