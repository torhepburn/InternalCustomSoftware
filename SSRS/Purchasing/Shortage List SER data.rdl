  <DataSets>
    <DataSet Name="DataSet1">
      <Query>
        <DataSourceName>DataSource1</DataSourceName>
        <CommandText>select * from SHORTAGE_List 

where 1=1

AND ([GROUP] like 'SER%' OR ProductLine = 'SERrpt')

AND DateAddedtoList &gt;= '2019-01-01'

ORDER BY DateAddedtoList</CommandText>
        <rd:UseGenericDesigner>true</rd:UseGenericDesigner>
      </Query>
