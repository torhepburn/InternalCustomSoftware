      <rd:DataSourceID>1176919c-d3f8-477c-b461-5bd77d16ef2e</rd:DataSourceID>
    </DataSource>
  </DataSources>
  <DataSets>
    <DataSet Name="DataSet1">
      <Query>
        <DataSourceName>NAV</DataSourceName>
        <CommandText>WITH s1 AS
(
	select

	 No_
	,Name

	from ZYGO$Vendor

	WHERE [Vendor Title] IN ('APP','CAP','MAP','PRE','PRO')
)
,s2 AS
(
select

[Buy-from Vendor No_]
,Name VendorName
,Amount

from 

[ZYGO$Purch_ Inv_ Line] p

INNER JOIN s1 ON s1.No_ = p.[Buy-from Vendor No_]

WHERE [Posting Date] BETWEEN DATEADD(yy,-1,GETDATE()) AND GETDATE()

AND Type = 2
)

SELECT

[Buy-from Vendor No_]
,VendorName
,SUM(Amount) PastYrSpend

FROM s2

GROUP BY [Buy-from Vendor No_], VendorName</CommandText>
        <rd:UseGenericDesigner>true</rd:UseGenericDesigner>
      </Query>
      <Fields>
        <Field Name="Buy_from_Vendor_No_">
          <DataField>Buy-from Vendor No_</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="VendorName">
          <DataField>VendorName</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="PastYrSpend">
          <DataField>PastYrSpend</DataField>
          <rd:TypeName>System.Decimal</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
  </DataSets>
