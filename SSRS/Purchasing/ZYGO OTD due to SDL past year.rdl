<?xml version="1.0" encoding="utf-8"?>
<Report MustUnderstand="df" xmlns="http://schemas.microsoft.com/sqlserver/reporting/2016/01/reportdefinition" xmlns:rd="http://schemas.microsoft.com/SQLServer/reporting/reportdesigner" xmlns:df="http://schemas.microsoft.com/sqlserver/reporting/2016/01/reportdefinition/defaultfontfamily">
  <df:DefaultFontFamily>Segoe UI</df:DefaultFontFamily>
  <AutoRefresh>0</AutoRefresh>
  <DataSources>
    <DataSource Name="NAV">
      <DataSourceReference>NAV</DataSourceReference>
      <rd:SecurityType>None</rd:SecurityType>
      <rd:DataSourceID>1e7587ee-d2b0-4cbb-a1b6-af3969c89133</rd:DataSourceID>
    </DataSource>
  </DataSources>
  <DataSets>
    <DataSet Name="DataSet1">
      <Query>
        <DataSourceName>NAV</DataSourceName>
        <CommandText>WITH s1 AS
(
	SELECT 

		'Y' Affiliate
		,No_

		FROM ZYGO$Customer where No_ IN

		(
		'9999AJ'	--ZYGO BU AMETEK CO., LTD.
		,'9999CM'	--ZYGO CORP-COSTA MESA
		,'9999CI'	--ZYGO CORPORATION
		,'9999D1'	--ZYGO CORPORATION
		,'9999D3'	--ZYGO CORPORATION
		,'9999EI'	--ZYGO CORPORATION (USE 9999D1)
		,'9999RS'	--ZYGO EXTREME PRECISION OPTICS
		,'9999KI'	--ZYGO KK
		,'9999KS'	--ZYGO KK
		,'9999VS'	--ZYGO VISION CANADA
		,'3273CI'	--ZYGOLAMDA METROLOGY INSTRUMENT
		,'C00036'	--ZYGOLAMDA METROLOGY INSTRUMENT (SHANGHAI) CO LTD

		,'C00026'	--AMETEK CO LTD ZYGO BU
		,'C01083'	--AMETEK (THAILAND) CO LTD
		,'C00026'	--AMETEK CO LTD ZYGO BU
		,'4217CI'	--AMETEK COMMERCIAL ENTERPRISE
		,'C00112'	--AMETEK COMMERCIAL ENTERPRISE (SHANGHAI) CO LTD
		,'1056LS'	--AMETEK GERMANY GmbH
		,'1056LI'	--AMETEK GERMANY GmbH
		,'C00027'	--AMETEK GERMANY GMBH
		,'C01056'	--AMETEK INSTRUMENTS INDIA PVT LTD
		,'C01094'	--AMETEK KOREA CO LTD
		,'9999AS'	--AMETEK SINGAPORE PTE LTD
		,'9999PI'	--AMETEK SINGAPORE PTE LTD
		,'C00180'	--AMETEK SINGAPORE PTE LTD
		,'AM1147'	--AMETEK SRL (ZYGO ITALY)
		,'C00046'	--AMETEK TAIWAN CO LTD
		,'3525TI'	--AMETEK Taiwan Co., Ltd
		)	
)
,s2 AS
(
select 

ssl.[Job No_]
,(ssl.[Order No_] + '-' + CAST(ssl.[SO Line No_] as nvarchar)) 'SO+Line'
,ssl.[Shipment Date]
,sl.[Orig_ Promised Delivery Date]
,ssl.[Location Code]
,ssl.No_ [Item No]
,ssl.Description [Item Description]
,ssl.[Quantity] ShipQuantity
,sl.[Quantity (Base)] SOQuantity
,ssh.[Ship-to Country_Region Code]
,c.Name Customer
--,s2.[Change Date Reason Code]
--,s2.Description 'Change Date Reason'
,CASE 
		WHEN  DATEDIFF(dd,sl.[Orig_ Promised Delivery Date], ssl.[Shipment Date]) &lt;= 0 THEN 'On Time'
		WHEN  DATEDIFF(dd,sl.[Orig_ Promised Delivery Date], ssl.[Shipment Date]) &gt; 0 THEN 'Late'
	END [Delivery Status]
,ssl.Quantity * ssl.[Unit Price] Amount
,CASE ssl.[Shortcut Dimension 2 Code]
	WHEN 'PPS COMPONENTS' THEN 'PPS'
	WHEN 'PPS COMPONENTS' THEN 'PPS'
	WHEN 'PPS PRODUCTS' THEN 'PPS'
	WHEN 'PPS SERVICES' THEN 'PPS'
	WHEN 'ELECTRO-OPTICS OTHER' THEN 'EO'
	WHEN 'GLASS OPTICS' THEN 'EPO'
	WHEN 'MACHINED STRUCTURES' THEN 'EPO'
	WHEN 'CRYSTALLINE OPTICS' THEN 'EPO'
	WHEN 'LASER INTERF PROD' THEN 'INSTRUMENTS'
	WHEN 'LASER INTERF SVCS' THEN 'INSTRUMENTS'
	WHEN 'LASER INTERFEROMETER' THEN 'INSTRUMENTS'
	WHEN 'OPT PROFILER PROD' THEN 'INSTRUMENTS'
	WHEN 'OPT PROFILER SVCS' THEN 'INSTRUMENTS'
	WHEN 'OPT PROFILER' THEN 'INSTRUMENTS'
	WHEN 'LFO VALUE STREAM' THEN 'MFO'
	WHEN 'PO VALUE STREAM' THEN 'MFO'
	ELSE ''
END [Business Segment]
,ssl.[Shortcut Dimension 2 Code] [Value Stream]
--,Comment
,COALESCE(s1.Affiliate,'N') InterCompany
,i.[Inventory Posting Group]

FROM [ZYGO$Sales Shipment Line] ssl 

inner join [ZYGO$Sales Line] sl on ssl.[Order No_] = sl.[Document No_] and ssl.[SO Line No_] = sl.[SO Line No_] 

inner join [ZYGO$Sales Header] ssh on ssh.No_ = sl.[Document No_] 

inner join ZYGO$Customer c on ssl.[Sell-to Customer No_] = c.No_

left join ZYGO$Item i on sl.No_ = i.No_ 

LEFT JOIN s1 ON s1.No_ = c.No_

WHERE

YEAR(sl.[Orig_ Promised Delivery Date]) &gt;= YEAR(GETDATE())-1

AND sl.[Orig_ Promised Delivery Date] NOT IN ('1753-01-01', '12-30-2030', '12-30-2050')

AND sl.[Orig_ Promised Delivery Date] &lt;= GETDATE()

AND sl.No_ NOT IN 
(
 'FREIGHT'
,'FREIGHT COMMERCE'
,'FREIGHT EXPORT'
,'FREIGHT INT''L'
,'FREIGHT ITAR'
,'EXP FEE'
,'FLD LABOR'
,'F-RATE'
,'OPTEST'
,'RENTAL'
,'SERVICE REPAIR'
,'SRVC'
,'SVC BILLABLE'
,'SVC CREDIT'
,'TRAIN'
,'WARR'
,'Z-PART'
,'R&amp;D'
,'DISCOUNT'
,'AF'
,'AMAT CERT-COMPLIANCE'
,'APPS'
,'IH LABOR'
,'LOCAL PURCHASE'
,'NRE'
,'PRICE ADJ'
,'SVC CNTRCT WTY UPGY1'
,'SVC CNTRCT YR1'
,'SVC CNTRCT YR1 FUTUR'
,'SVC CNTRCT YR2'
,'SVC CNTRCT YR3'
,'TRAVEL'
,'VER-BAS-DOM'
,'VER-BAS-TSFR'
,'VER-PRM-DOM'
,'Z-1'
,'Z-3'
,'Z-4'
,'ZEG-3PR-DOM'
,'ZEG-BAS-TSFR'
,'ZEG-PRM-DOM'
,'COMM'
,'NV-BAS-TSFR'
,'NEX-BAS-DOM'
,'NV-BAS-DOM'
,'NV-PRM-TSFR'
,'NV-STD-TSFR'
)
)
,s3 AS
(
SELECT DISTINCT s2.* from s2

INNER JOIN [ZYGO$Change Sales Date Reason Entry] r ON (r.[Document No_] + '-' + CAST(r.[SO Line No_] as nvarchar)) = s2.[SO+Line]

WHERE r.[Change Date Reason Code] = 'SDL'
)

select s3.* from s3 

WHERE [Delivery Status] = 'Late'

--INNER JOIN [ZYGO$Item] i on s3.[Item No] = i.No_  WHERE i.[Replenishment System] = 0 --purchase</CommandText>
        <rd:UseGenericDesigner>true</rd:UseGenericDesigner>
      </Query>
      <Fields>
        <Field Name="Job_No_">
          <DataField>Job No_</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="SO_Line">
          <DataField>SO+Line</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Shipment_Date">
          <DataField>Shipment Date</DataField>
          <rd:TypeName>System.DateTime</rd:TypeName>
        </Field>
        <Field Name="Orig__Promised_Delivery_Date">
          <DataField>Orig_ Promised Delivery Date</DataField>
          <rd:TypeName>System.DateTime</rd:TypeName>
        </Field>
        <Field Name="Location_Code">
          <DataField>Location Code</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Item_No">
          <DataField>Item No</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Item_Description">
          <DataField>Item Description</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="ShipQuantity">
          <DataField>ShipQuantity</DataField>
          <rd:TypeName>System.Decimal</rd:TypeName>
        </Field>
        <Field Name="SOQuantity">
          <DataField>SOQuantity</DataField>
          <rd:TypeName>System.Decimal</rd:TypeName>
        </Field>
        <Field Name="Ship_to_Country_Region_Code">
          <DataField>Ship-to Country_Region Code</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Customer">
          <DataField>Customer</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Delivery_Status">
          <DataField>Delivery Status</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Amount">
          <DataField>Amount</DataField>
          <rd:TypeName>System.Decimal</rd:TypeName>
        </Field>
        <Field Name="Business_Segment">
          <DataField>Business Segment</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Value_Stream">
          <DataField>Value Stream</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="InterCompany">
          <DataField>InterCompany</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Inventory_Posting_Group">
          <DataField>Inventory Posting Group</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
  </DataSets>
