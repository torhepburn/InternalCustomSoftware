<?xml version="1.0" encoding="utf-8"?>
<Report MustUnderstand="df" xmlns="http://schemas.microsoft.com/sqlserver/reporting/2016/01/reportdefinition" xmlns:rd="http://schemas.microsoft.com/SQLServer/reporting/reportdesigner" xmlns:df="http://schemas.microsoft.com/sqlserver/reporting/2016/01/reportdefinition/defaultfontfamily">
  <df:DefaultFontFamily>Segoe UI</df:DefaultFontFamily>
  <AutoRefresh>0</AutoRefresh>
  <DataSources>
    <DataSource Name="DataSource1">
      <ConnectionProperties>
        <DataProvider>SQL</DataProvider>
        <ConnectString>Data Source=pa-hor-as408.ametek.com;Initial Catalog=ZYGO-NAV-PROD</ConnectString>
      </ConnectionProperties>
      <rd:SecurityType>DataBase</rd:SecurityType>
      <rd:DataSourceID>e24a6a7a-f9e0-45fb-a1a6-b73faf4981d2</rd:DataSourceID>
    </DataSource>
  </DataSources>
  <DataSets>
    <DataSet Name="DataSet1">
      <Query>
        <DataSourceName>DataSource1</DataSourceName>
        <CommandText>SELECT

FORMAT([Due Date],'MM/dd/yy') 'Job Due Date (Demand)'
,'' 'Prod Order Due Date (Supply)'
,CASE [Posting Date]
	WHEN '1753-01-01 00:00:00.000' THEN ' '
	WHEN '1900-01-01 00:00:00.000' THEN ' '
	ELSE FORMAT([Posting Date], 'MM/dd/yy')
END 'Posting Date'
,[Document No_]
,[Job No_]
,'' 'Prod Order No_'
,WBS
,jjl.No_ [Item No_]
,jjl.Description
,[Shortcut Dimension 2 Code] 'Business Segment Code'
,[Location Code]
,[Bin Code]
,Quantity
,[Unit of Measure Code]
,[Buyer_Planner Code]
,'Job Due Date Today or Passed' 'Data Source'

FROM [ZYGO$Job Journal Line] jjl

INNER JOIN ZYGO$Job j on jjl.[Job No_] = j.No_

WHERE 

[Due Date] &lt;= GETDATE()
AND
Quantity &gt; 0
AND
SUBSTRING([Location Code],1,3) != 'MID'

AND [Journal Template Name] = 'INVREQ'

UNION ALL

SELECT  

COALESCE(jjl.[Due Date], '1900-01-01') [Job Due Date (Demand)]
,prl.[Due Date] [Prod Order Due Date (Supply)]
,jjl.[Posting Date]
,jjl.[Document No_]
,prl.[Job No_]
,prl.[Prod_ Order No_]
,prl.WBS 
,[Item No_] 
,prl.[Description]
,pro.[Shortcut Dimension 2 Code]
,prl.[Location Code]
,prl.[Bin Code]
,prl.[Remaining Quantity] [Quantity]
,prl.[Unit of Measure Code]
,[Buyer Planner Code]
,'Prod Order Due Date Greater than Job Due Date' 'Data Source'

FROM

[ZYGO$Prod_ Order Line] prl

INNER JOIN [ZYGO$Production Order] pro ON prl.[Prod_ Order No_] = pro.No_

LEFT JOIN [ZYGO$Job Journal Line] jjl ON prl.[Job No_] = jjl.[Job No_] AND prl.[WBS] = jjl.[WBS]

WHERE

LEN(prl.[Job No_]) &gt; 0

AND prl.Status IN (2,3)

AND jjl.[Due Date] &lt; prl.[Due Date]

AND SUBSTRING(jjl.[Location Code],1,3) != 'MID'

AND [Journal Template Name] = 'INVREQ'

ORDER BY [Job Due Date (Demand)]</CommandText>
        <rd:UseGenericDesigner>true</rd:UseGenericDesigner>
      </Query>
      <Fields>
        <Field Name="Job_Due_Date__Demand_">
          <DataField>Job Due Date (Demand)</DataField>
