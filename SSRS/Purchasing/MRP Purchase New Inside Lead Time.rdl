<?xml version="1.0" encoding="utf-8"?>
<Report MustUnderstand="df" xmlns="http://schemas.microsoft.com/sqlserver/reporting/2016/01/reportdefinition" xmlns:rd="http://schemas.microsoft.com/SQLServer/reporting/reportdesigner" xmlns:df="http://schemas.microsoft.com/sqlserver/reporting/2016/01/reportdefinition/defaultfontfamily">
  <df:DefaultFontFamily>Segoe UI</df:DefaultFontFamily>
  <AutoRefresh>0</AutoRefresh>
  <DataSources>
    <DataSource Name="NAV">
      <DataSourceReference>NAV</DataSourceReference>
      <rd:SecurityType>None</rd:SecurityType>
      <rd:DataSourceID>7b3610aa-af8c-4e45-926e-250b4eb7b7b4</rd:DataSourceID>
    </DataSource>
  </DataSources>
  <DataSets>
    <DataSet Name="DataSet1">
      <Query>
        <DataSourceName>NAV</DataSourceName>
        <CommandText>with s1 as
(
SELECT

No_
,CASE  WHEN LEN(i.[Lead Time Calculation]) = 0 THEN '0' 
                              WHEN CHARINDEX(CHAR(3),i.[Lead Time Calculation]) &gt; 0 
                                   THEN REPLACE(i.[Lead Time Calculation], CHAR(3), '') 
                            WHEN CHARINDEX(CHAR(4),i.[Lead Time Calculation]) &gt; 0 THEN  --week 
                               REPLACE(i.[Lead Time Calculation], CHAR(4), '') * 5	       --convert to days 
                            WHEN CHARINDEX(CHAR(5),i.[Lead Time Calculation]) &gt; 0 THEN  --month 
                               REPLACE(i.[Lead Time Calculation], CHAR(5), '') * 20	--convert to days 
                           WHEN CHARINDEX(CHAR(2),i.[Lead Time Calculation]) &gt; 0 THEN  -- days 
                               REPLACE(i.[Lead Time Calculation], CHAR(2), '')		
                        END [Lead Time Calculation]
,[Item Group Code]

FROM ZYGO$Item i

WHERE Vetted = 0  --vetted = 0 is vetted

AND [Item Group Code] != 'VMI'
)

select 

r.No_
,CAST([Due Date] as date) [Requested Date]
--,CAST([Starting Date] as date) [Starting Date]
,s1.[Lead Time Calculation]
,CAST(GETDATE() + s1.[Lead Time Calculation] as date) [Today+Leadtime]
,r.[Vendor No_]
,COALESCE(v.Name,'') Vendor
,[Item Category Code]
,[Item Group Code]

from [ZYGO$Requisition Line] r

INNER JOIN s1 ON r.No_ = s1.No_

LEFT JOIN ZYGO$Vendor v on r.[Vendor No_] = v.No_

where 

r.[Ref_ Order Type] = 1  --purchased

AND r.Type = 2  --item

AND r.[Worksheet Template Name] = 'PLANNING'

AND r.[Journal Batch Name] = 'DEFAULT'

AND [Action Message] = 1 --purchase new

AND r.[Due Date] &lt; (GETDATE() + s1.[Lead Time Calculation])

--AND [Due Date] &gt; GETDATE()

order by [Due Date]</CommandText>
        <rd:UseGenericDesigner>true</rd:UseGenericDesigner>
      </Query>
      <Fields>
        <Field Name="No_">
          <DataField>No_</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Requested_Date">
          <DataField>Requested Date</DataField>
          <rd:TypeName>System.DateTime</rd:TypeName>
        </Field>
        <Field Name="Lead_Time_Calculation">
          <DataField>Lead Time Calculation</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
        <Field Name="Today_Leadtime">
          <DataField>Today+Leadtime</DataField>
          <rd:TypeName>System.DateTime</rd:TypeName>
        </Field>
        <Field Name="Vendor_No_">
          <DataField>Vendor No_</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Vendor">
          <DataField>Vendor</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Item_Category_Code">
          <DataField>Item Category Code</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Item_Group_Code">
          <DataField>Item Group Code</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
  </DataSets>
