<?xml version="1.0" encoding="utf-8"?>
<Report MustUnderstand="df" xmlns="http://schemas.microsoft.com/sqlserver/reporting/2016/01/reportdefinition" xmlns:rd="http://schemas.microsoft.com/SQLServer/reporting/reportdesigner" xmlns:df="http://schemas.microsoft.com/sqlserver/reporting/2016/01/reportdefinition/defaultfontfamily">
  <df:DefaultFontFamily>Segoe UI</df:DefaultFontFamily>
  <AutoRefresh>0</AutoRefresh>
  <DataSources>
    <DataSource Name="NAV">
      <DataSourceReference>NAV</DataSourceReference>
      <rd:SecurityType>None</rd:SecurityType>
      <rd:DataSourceID>b8f5654d-fc98-4059-9561-a1d1a5325b3c</rd:DataSourceID>
    </DataSource>
  </DataSources>
  <DataSets>
    <DataSet Name="DataSet1">
      <Query>
        <DataSourceName>NAV</DataSourceName>
        <CommandText>SELECT
 CASE [Action Message]
	WHEN 3 THEN 'Reschedule'
	WHEN 4 THEN '+Qty+Date'
	WHEN 5 THEN 'Cancel'
 END [Action Message]
,l.[Buyer Planner Code]
,pl.[Buy-from Vendor No_]
,v.Name [Vendor]
,CASE 
	WHEN CONVERT(varchar(10),[Original Due Date], 1) = '01/01/53' THEN ''
	ELSE CONVERT(varchar(10),[Original Due Date], 1)
END [Original Due Date]

,CASE 
	WHEN CONVERT(varchar(10),pl.[Requested Receipt Date], 1) = '01/01/53' THEN ''
	ELSE CONVERT(varchar(10),pl.[Requested Receipt Date], 1)
END [PO Requested Receipt Date]
,CASE 
	WHEN CONVERT(varchar(10),pl.[Promised Receipt Date], 1) = '01/01/53' THEN ''
	ELSE CONVERT(varchar(10),pl.[Promised Receipt Date], 1)
END [Promised Receipt Date],CONVERT(varchar(10),[Due Date], 1) [MRP Pull-in Date]
,l.[Location Code]
,[Ref_ Order No_]
,pl.[PO Line No_]
,l.No_ [Part Number]
,l.Description
,FORMAT([Remaining Quantity],'N0', 'en-us') [Order Quantity]
,CASE COALESCE(pl.[Best Delivery],0) 
                           WHEN 0 THEN '' 
                           WHEN 1 THEN 'YES' 
                        END Best


FROM [ZYGO$Requisition Line] l

LEFT JOIN ZYGO$Item i on l.No_ = i.No_

LEFT JOIN [ZYGO$Purchase Line] pl 

ON l.[Ref_ Order No_] = pl.[Document No_]

AND l.[Ref_ Line No_] = pl.[Line No_]

LEFT JOIN ZYGO$Vendor v on pl.[Buy-from Vendor No_] = v.No_

WHERE

[Ref_ Order Type] = 1	--Purchase

AND l.[Replenishment System] = 0

and [Action Message] in (3) -- Reschedule

AND [Worksheet Template Name] = 'PLANNING'

AND [Journal Batch Name] = 'DEFAULT'

AND [Remaining Quantity] &gt; 0</CommandText>
        <rd:UseGenericDesigner>true</rd:UseGenericDesigner>
      </Query>
      <Fields>
        <Field Name="Action_Message">
          <DataField>Action Message</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Buyer_Planner_Code">
          <DataField>Buyer Planner Code</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Buy_from_Vendor_No_">
