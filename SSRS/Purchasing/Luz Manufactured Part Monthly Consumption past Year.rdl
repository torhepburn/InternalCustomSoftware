<?xml version="1.0" encoding="utf-8"?>
<Report xmlns="http://schemas.microsoft.com/sqlserver/reporting/2016/01/reportdefinition" xmlns:rd="http://schemas.microsoft.com/SQLServer/reporting/reportdesigner" xmlns:df="http://schemas.microsoft.com/sqlserver/reporting/2016/01/reportdefinition/defaultfontfamily" MustUnderstand="df">
  <df:DefaultFontFamily>Segoe UI</df:DefaultFontFamily>
  <AutoRefresh>0</AutoRefresh>
  <DataSources>
    <DataSource Name="NAV">
      <DataSourceReference>NAV</DataSourceReference>
      <rd:SecurityType>None</rd:SecurityType>
      <rd:DataSourceID>d483f899-4aaa-48e7-aaea-de69d2984693</rd:DataSourceID>
    </DataSource>
  </DataSources>
  <DataSets>
    <DataSet Name="DataSet1">
      <Query>
        <DataSourceName>NAV</DataSourceName>
        <CommandText>DECLARE @item varchar(50)
DECLARE @vetted int
DECLARE @replenishment int

SET @vetted = 0
SET @replenishment = 1  -- 0 = purchased  1 = production order  2 = transfer
SET DATEFIRST 1;

DECLARE @yearstart date
DECLARE @monthstart date

SET @yearstart = GETDATE() - 365

select @monthstart = dateadd(MONTH, datediff(MONTH, 0, GETDATE()-365), 0)

CREATE TABLE #Temp
(
 [Month Number] int
,[Item] varchar(50)
,[Monthly Consumption] decimal(38,2)
)

DECLARE simCursor CURSOR FOR

/*	Get the list of all items which need to be considered */

SELECT

No_

FROM ZYGO$Item WHERE [Replenishment System] = @replenishment

AND [Signal Code] != 'OBS'

--AND Vetted = @vetted


OPEN simCursor

FETCH NEXT FROM simCursor INTO @item

WHILE @@FETCH_STATUS = 0
BEGIN

WITH s1 AS
(
SELECT 

DATEPART(MONTH,[Posting Date]) [Month Number]
,[Item No_]
,SUM(Quantity) * -1 [Monthly Consumption]

FROM [ZYGO$Item Ledger Entry] ile

INNER JOIN ZYGO$Item i ON ile.[Item No_] = i.No_

WHERE [Posting Date] &gt;= @monthstart

AND ([Entry Type] = 1 --Sale

OR [Entry Type] = 5) --Consumption


AND [Item No_] = @item

GROUP BY DATEPART(MONTH,[Posting Date]), [Item No_]

)

,s2 AS --recursive cte to add 53 weeks consumption of zero for the blank weeks - 'level' as the counter
 (
  SELECT
  [Month Number]
  ,[Item No_]
  ,CAST([Monthly Consumption] AS decimal) [Monthly Consumption]
  ,1 AS LEVEL
  FROM s1
  UNION ALL
  SELECT
  CAST('1' AS int)
  ,t1.[Item No_]
  ,CAST(0 AS decimal)
  , LEVEL + 1
  FROM s1 t1
  INNER JOIN
  s2 t2
  ON t1.[Item No_] = t2.[Item No_]
  AND LEVEL &lt; 13
 )
 ,s3 AS
 (
SELECT TOP 12

*

FROM s2
)


INSERT INTO #TEMP
(
	[Month Number]
	,[Item] 
	,[Monthly Consumption]
)

SELECT

	[Month Number]
	,[Item No_] 
	,[Monthly Consumption]

FROM s3

FETCH NEXT FROM simCursor INTO @item
END
CLOSE simCursor
DEALLOCATE simCursor;

SELECT * FROM #TEMP

ORDER BY Item, [Month Number]

--DROP TABLE #TEMP;</CommandText>
        <rd:UseGenericDesigner>true</rd:UseGenericDesigner>
      </Query>
      <Fields>
        <Field Name="Month_Number">
          <DataField>Month Number</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
        <Field Name="Item">
          <DataField>Item</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Monthly_Consumption">
          <DataField>Monthly Consumption</DataField>
          <rd:TypeName>System.Decimal</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
