<?xml version="1.0" encoding="utf-8"?>
<Report MustUnderstand="df" xmlns="http://schemas.microsoft.com/sqlserver/reporting/2016/01/reportdefinition" xmlns:rd="http://schemas.microsoft.com/SQLServer/reporting/reportdesigner" xmlns:df="http://schemas.microsoft.com/sqlserver/reporting/2016/01/reportdefinition/defaultfontfamily">
  <df:DefaultFontFamily>Segoe UI</df:DefaultFontFamily>
  <AutoRefresh>0</AutoRefresh>
  <DataSources>
    <DataSource Name="NAV">
      <DataSourceReference>NAV</DataSourceReference>
      <rd:SecurityType>None</rd:SecurityType>
      <rd:DataSourceID>b26e4636-9189-4669-ad5e-87dbe4a5c205</rd:DataSourceID>
    </DataSource>
  </DataSources>
  <DataSets>
    <DataSet Name="DataSet1">
      <Query>
        <DataSourceName>NAV</DataSourceName>
        <CommandText>SELECT 


[Sheet Name]
,[Tag No_]
,[Item No_]
,i.Description
,c.[Location Code]
,c.[Bin Code]
,c.[Quantity]
,c.[Unit of Measure Code]
,c.[Quantity (Base)]
,c.[Expected Quantity]
,c.[Difference Qty_]
,CASE 
	WHEN [Expected Quantity] &gt; 0 THEN (c.[Quantity (Base)]/c.[Expected Quantity]) 
	ELSE 0
END [Count Percentage]
,[Unit Cost]
,([Quantity (Base)] * [Unit Cost]) [Total Cost (Quantity Base x Unit Cost]
,([Expected Quantity] * [Unit Cost]) [Total Expected Cost (Expected Quantity x Unit Cost]
,([Difference Qty_] * [Unit Cost]) [Total Difference Cost (difference Qty x Unit Cost]

FROM [ZYGO$IWX Count Sheet Line] c

LEFT JOIN ZYGO$Item i ON c.[Item No_] = i.No_

WHERE [Location Code] = 'MID'

AND CAST([Date Entered] as date) ='2023-08-11'

order by [Tag No_] </CommandText>
        <rd:UseGenericDesigner>true</rd:UseGenericDesigner>
      </Query>
      <Fields>
