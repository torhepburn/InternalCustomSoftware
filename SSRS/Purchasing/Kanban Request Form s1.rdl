  <df:DefaultFontFamily>Segoe UI</df:DefaultFontFamily>
  <AutoRefresh>0</AutoRefresh>
  <DataSources>
    <DataSource Name="NAV">
      <DataSourceReference>NAV</DataSourceReference>
      <rd:SecurityType>None</rd:SecurityType>
      <rd:DataSourceID>c6708f82-9066-411c-9f41-d1f15f74d5f2</rd:DataSourceID>
    </DataSource>
  </DataSources>
  <DataSets>
    <DataSet Name="DataSet1">
      <Query>
        <DataSourceName>NAV</DataSourceName>
        <QueryParameters>
          <QueryParameter Name="@supplierNo">
            <Value>=Parameters!supplierNo.Value</Value>
          </QueryParameter>
        </QueryParameters>
        <CommandText>--DECLARE @supplierNo varchar(30)
--SET @supplierNo = 'V00290';


WITH s1 AS     /*	kanban parts and not FAI	*/
(     
    SELECT     
    No_ ItemNo   
    FROM ZYGO$Item     
    WHERE     
    [Selection Code] = 'KBP'
	AND LEFT(No_, 1) != 'X'		/*	mised some because it was looking for any X rather then just the first position	*/  
    AND No_ NOT LIKE '%FAI'
	AND [Signal Code] != 'OBS'
) 
,s91 AS
(
	SELECT  
	
	l.No_ ItemNo
	,h.No_ KB
	,Quantity
	,[Outstanding Quantity]
	,CONVERT(VARCHAR,[Contract Start Date],1) [Contract Start Date]
	,DATEDIFF(mm,[Contract Start Date], [Contract End Date]) [Contract Length]

	FROM [ZYGO$Purchase Line] l  
	
	INNER JOIN [ZYGO$Purchase Header] h ON l.[Document No_] = h.No_ 

	INNER JOIN ZYGO$Item i ON i.No_ = l.No_
		
	WHERE 
	
	h.[Document Type] = 4

	and i.[Selection Code] = 'KBP'

	AND [Outstanding Quantity] &gt; 0
)

SELECT distinct

[Buyer Planner Code] Buyer
,[Name] Supplier
,[Vendor No_] SupplierNo
,CASE v.[Country_Region Code]
	WHEN 'USA' THEN 'Y'
	ELSE 'N'
END [Domestic (Y/N)]
,CASE
	WHEN LEN(COALESCE(s91.KB,'')) &gt; 0 THEN 'R'
	ELSE 'N'
 END [New Contract or Renewal?]
,CAST(i.[Reorder Quantity] AS int) [Current Bin Size]
,COALESCE(CAST(s91.Quantity as int),0) [Original Contract Quantity]
,COALESCE(CAST(s91.[Outstanding Quantity] as int),0) [Outstanding Quantity]
,CAST(i.[Supplier Replenishment] as varchar(3)) + 'WD' [Replenishment Time]
,i.No_ 
,i.Description
,i.[Standard Cost]
,''[Supplier Price for this contract]
,COALESCE(s91.[Contract Start Date],'') [Estimated Contract Start Date (first scan date)]
,'' Bin
,i.P6
,i.F6
,i.EAU
,COALESCE(i.[No_ of Bins],0) [# of Bins]
,'' [New Bin size]
,s91.[Contract Length] [Contract Length Months]
,'' [Contract Quantity]


FROM ZYGO$Item i 

INNER JOIN s1 ON s1.ItemNo = i.No_
LEFT JOIN s91 ON s91.ItemNo = i.No_
LEFT JOIN ZYGO$Vendor v ON i.[Vendor No_] = v.No_

WHERE [Vendor No_] = @supplierNo

order by No_</CommandText>
        <rd:UseGenericDesigner>true</rd:UseGenericDesigner>
      </Query>
      <Fields>
        <Field Name="Buyer">
          <DataField>Buyer</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Supplier">
          <DataField>Supplier</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="SupplierNo">
          <DataField>SupplierNo</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Domestic__Y_N_">
