        </Field>
        <Field Name="Supplier_Price_for_this_contract">
          <DataField>Supplier Price for this contract</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Estimated_Contract_Start_Date__first_scan_date_">
          <DataField>Estimated Contract Start Date (first scan date)</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Bin">
          <DataField>Bin</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="P6">
          <DataField>P6</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
        <Field Name="F6">
          <DataField>F6</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
        <Field Name="EAU">
          <DataField>EAU</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
        <Field Name="ID__of_Bins">
          <DataField># of Bins</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
        <Field Name="New_Bin_size">
          <DataField>New Bin size</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Contract_Length_Months">
          <DataField>Contract Length Months</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
        <Field Name="Contract_Quantity">
          <DataField>Contract Quantity</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
