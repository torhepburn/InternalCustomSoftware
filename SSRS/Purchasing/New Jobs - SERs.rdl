          <rd:TypeName>System.Decimal</rd:TypeName>
        </Field>
        <Field Name="Price">
          <DataField>Price</DataField>
          <rd:TypeName>System.Decimal</rd:TypeName>
        </Field>
        <Field Name="RQST_DEL">
          <DataField>RQST DEL</DataField>
          <rd:TypeName>System.DateTime</rd:TypeName>
        </Field>
        <Field Name="PLAN_DEL">
          <DataField>PLAN DEL</DataField>
          <rd:TypeName>System.DateTime</rd:TypeName>
        </Field>
        <Field Name="End_User">
          <DataField>End User</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="GVT_Rated">
          <DataField>GVT Rated</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
