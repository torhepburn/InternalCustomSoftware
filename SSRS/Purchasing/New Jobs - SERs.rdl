<?xml version="1.0" encoding="utf-8"?>
<Report MustUnderstand="df" xmlns="http://schemas.microsoft.com/sqlserver/reporting/2016/01/reportdefinition" xmlns:rd="http://schemas.microsoft.com/SQLServer/reporting/reportdesigner" xmlns:df="http://schemas.microsoft.com/sqlserver/reporting/2016/01/reportdefinition/defaultfontfamily">
  <df:DefaultFontFamily>Segoe UI</df:DefaultFontFamily>
  <AutoRefresh>0</AutoRefresh>
  <DataSources>
    <DataSource Name="DataSource1">
      <DataSourceReference>NAV</DataSourceReference>
      <rd:SecurityType>DataBase</rd:SecurityType>
      <rd:DataSourceID>52ad9c0e-34e2-4d97-aebf-acf1b3cac735</rd:DataSourceID>
    </DataSource>
  </DataSources>
  <DataSets>
    <DataSet Name="DataSet1">
      <Query>
        <DataSourceName>DataSource1</DataSourceName>
        <CommandText>WITH s1 AS
(
SELECT

c.Name Customer
,j.No_ [Job No]
,j.Description [Job Description]
,j.[Job Type]
,j.[Creation Date]

,COALESCE(l.[Document No_],'') [Order]
,COALESCE(l.[SO Line No_],'') [Pos]
,COALESCE(l.No_,'') [Item]
,COALESCE(l.Description,'') [Item Description]
,COALESCE(l.[Outstanding Quantity],0) [Qty]
,COALESCE(l.[Unit Price (LCY)],0) [Price]
,COALESCE(l.[Requested Delivery Date],'') [RQST DEL] 
,COALESCE(l.[Planned Delivery Date],'') [PLAN DEL]
,COALESCE(h.[End User Customer Name],'') [End User]
,COALESCE(CASE
	WHEN LEN(h.[Govt_ Priority Rating Code]) &gt; 0 THEN 'YES'
	ELSE 'NO'
END,'') [GVT Rated]


from [ZYGO$Job] j 

LEFT JOIN [ZYGO$Sales Line] l on j.No_ = l.[Job No_]

LEFT JOIN [ZYGO$Sales Header] h ON l.[Document No_] = h.No_

LEFT JOIN ZYGO$Customer c ON j.[Sell-to Customer No_] = c.No_

WHERE [Creation Date] &lt; GETDATE() AND [Creation Date] &gt; GETDATE() - 2

AND j.No_ NOT LIKE 'OPT-PO%'

AND j.No_ NOT LIKE 'OPT-LFO%'

--ORDER BY Name, [Document No_], [SO Line No_]
)

select * FROM s1

UNION ALL

select

c.Name Customer
,j.No_ [Job No]
,j.Description [Job Description]
,j.[Job Type]
,j.[Creation Date]

,COALESCE(l.[Document No_],'') [Order]
,COALESCE(l.[SO Line No_],'') [Pos]
,COALESCE(l.No_,'') [Item]
,COALESCE(l.Description,'') [Item Description]
,COALESCE(l.[Outstanding Quantity],0) [Qty]
,COALESCE(l.[Unit Price (LCY)],0) [Price]
,COALESCE(l.[Requested Delivery Date],'') [RQST DEL]
,COALESCE(l.[Planned Delivery Date],'') [PLAN DEL]
,COALESCE(h.[End User Customer Name],'') [End User]
,COALESCE(CASE
	WHEN LEN(h.[Govt_ Priority Rating Code]) &gt; 0 THEN 'YES'
	ELSE 'NO'
END,'') [GVT Rated]


from [ZYGO$Job] j 

LEFT JOIN [ZYGO$Sales Line] l on j.No_ = l.[Job No_]

LEFT JOIN [ZYGO$Sales Header] h ON l.[Document No_] = h.No_

LEFT JOIN ZYGO$Customer c ON j.[Sell-to Customer No_] = c.No_

WHERE h.[Order Date]  &lt; GETDATE() AND h.[Order Date] &gt; GETDATE() - 2

AND j.No_ NOT LIKE 'OPT-PO%'

AND j.No_ NOT LIKE 'OPT-LFO%'

AND j.No_ not in (Select [Job No] from s1)

ORDER BY Customer, [Job No], [Order], Pos</CommandText>
        <rd:UseGenericDesigner>true</rd:UseGenericDesigner>
      </Query>
      <Fields>
        <Field Name="Customer">
          <DataField>Customer</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Job_No">
          <DataField>Job No</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Job_Description">
          <DataField>Job Description</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Job_Type">
