<?xml version="1.0" encoding="utf-8"?>
<Report MustUnderstand="df" xmlns="http://schemas.microsoft.com/sqlserver/reporting/2016/01/reportdefinition" xmlns:rd="http://schemas.microsoft.com/SQLServer/reporting/reportdesigner" xmlns:df="http://schemas.microsoft.com/sqlserver/reporting/2016/01/reportdefinition/defaultfontfamily">
  <df:DefaultFontFamily>Segoe UI</df:DefaultFontFamily>
  <AutoRefresh>0</AutoRefresh>
  <DataSources>
    <DataSource Name="DataSource1">
      <ConnectionProperties>
        <DataProvider>SQL</DataProvider>
        <ConnectString>Data Source=ct-mid-sql11;Initial Catalog=AccessFrontEnds</ConnectString>
      </ConnectionProperties>
      <rd:SecurityType>DataBase</rd:SecurityType>
      <rd:DataSourceID>0ebbf333-73c7-4414-87e2-173717342d04</rd:DataSourceID>
    </DataSource>
  </DataSources>
  <DataSets>
    <DataSet Name="DataSet1">
      <Query>
        <DataSourceName>DataSource1</DataSourceName>
        <CommandText>with s1 as
(
select  shortageid, mAX(commentid) CID from shortagelistcomments  group by shortageid 
),
s2 as
(
select  shortageid, mAX(commentid) CID from shortagelistcomments where commentid not in (select CID from s1)  group by shortageid 
),
s3 as
(
select s1.shortageid, RTRIM(comment) + ' : ' + SUBSTRING(Enteredby, 1, 2) + ' : ' + 
		CONVERT(nchar(5),EnteredOn,  1) + ' :: ' comments from s1 inner join shortagelistcomments c on s1.cid = c.CommentID
),
s4 as
(
select s2.shortageid, RTRIM(comment) + ' : ' + SUBSTRING(Enteredby, 1, 2) + ' : ' + 
		CONVERT(nchar(5),EnteredOn,  1) comments from s2 inner join shortagelistcomments c on s2.cid = c.CommentID
),
s5 as
(
select s3.ShortageID, s3.comments + ' ' 
+ CASE 
	WHEN s4.comments is not null THEN s4.comments
	WHEN s4.comments is null THEN ' '
END comments
from s3 left join s4 on s3.ShortageID = s4.ShortageID
)

select  
l.ID 
,LateFlag 
,[Inspection Code] 
,[ItemCode] 
,[Description] 
,s5.[Comments] 
,[QtyNeeded] [Need Qty] 
,[Qty] [PO Qty] 
,SUBSTRING(PO, 0,10) PO 
,SUBSTRING(Supplier, 0, 12) Supplier 
,[DateAddedtoList] [List Date] 
,[Orig_ Requested Receipt Date] [Orig Rqst Rcpt Date]
,[Req Date] [[Rqd Date]
,[CurrDueDate] [Curr Due Date]
,[IQCCompleteDate] [IQC Comp Date]
, Buyer
,[GROUP] 
,Project
,ItemStatus
,ProductLine
from [Shortage_List] l 
inner join ShortageList_ActiveFlags f
on l.id = f.id
left join s5 on l.id =  s5.shortageid
WHERE buyer = 'MATT W'
AND COALESCE(itemStatus,'') not in ('IQC', 'MOVED')
order by buyer, hot, sortgroup, lateflagsort, itemstatussort, productline, [group], itemcode, l.id</CommandText>
        <rd:UseGenericDesigner>true</rd:UseGenericDesigner>
      </Query>
