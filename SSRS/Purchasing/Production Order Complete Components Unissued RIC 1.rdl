<?xml version="1.0" encoding="utf-8"?>
<Report MustUnderstand="df" xmlns="http://schemas.microsoft.com/sqlserver/reporting/2016/01/reportdefinition" xmlns:rd="http://schemas.microsoft.com/SQLServer/reporting/reportdesigner" xmlns:df="http://schemas.microsoft.com/sqlserver/reporting/2016/01/reportdefinition/defaultfontfamily">
  <df:DefaultFontFamily>Segoe UI</df:DefaultFontFamily>
  <AutoRefresh>0</AutoRefresh>
  <DataSources>
    <DataSource Name="NAV">
      <DataSourceReference>NAV</DataSourceReference>
      <rd:SecurityType>None</rd:SecurityType>
      <rd:DataSourceID>cb814f18-2246-4b0e-8c05-8b9631b891c4</rd:DataSourceID>
    </DataSource>
  </DataSources>
  <DataSets>
    <DataSet Name="DataSet1">
      <Query>
        <DataSourceName>NAV</DataSourceName>
        <CommandText>WITH s1 AS
(
	SELECT 

	 [ZYGO$Prod_ Order Line].[Prod_ Order No_],
	 [ZYGO$Production Order].Status
	,CASE  [ZYGO$Production Order].Status
		WHEN 0 THEN 'Simulated'
		WHEN 1 THEN 'Planned'
		WHEN 2 THEN 'Firm-Planned'
		WHEN 3 THEN 'Released'
		WHEN 4 THEN 'Finished'
	END Prod_Ord_Status_Desc
	,Rework
	,CASE Rework
		WHEN 0 THEN 'No'
		WHEN 1 THEN 'Yes'
	End ReworkDescription
	,[ZYGO$Production Order].[Finished Date]
	 ,[ZYGO$Prod_ Order Line].[Line No_] AS Pro_Order_Line_LIne_No,
	 [ZYGO$Prod_ Order Line].[Item No_] AS Prod_Order_Line_Item,
	 [ZYGO$Prod_ Order Line].Description AS Prod_Order_Line_Item_Desc,
	 [ZYGO$Prod_ Order Line].[Shortcut Dimension 2 Code],
	 [ZYGO$Prod_ Order Line].[Quantity] AS Prod_Order_Line_Quantity,
	 [ZYGO$Prod_ Order Line].[Finished Quantity] AS Prod_Order_Line_Finished_Quantity,
	 [ZYGO$Prod_ Order Line].[Scrap _] AS Prod_Order_Line_Scrap_Quantity,
	 [ZYGO$Prod_ Order Line].[Remaining Quantity] AS Prod_Order_Line_Remaining_Qty,
	 [ZYGO$Prod_ Order Line].[Location Code] AS Prod_Order_Line_Location_Code,
	 [ZYGO$Prod_ Order Component].[Reference Component],
	 [ZYGO$Prod_ Order Component].[Flushing Method]
	 ,CASE [Flushing Method]
		WHEN 0 THEN 'Manual'
		WHEN 1 THEN 'Forward'
		WHEN 2 THEN 'Backward'
		WHEN 3 THEN 'Pick+Forward'
		WHEN 4 THEN 'Pcik+Backward'
	End Flushing_Method_Desc,
	 [ZYGO$Prod_ Order Component].[Line No_] AS Comp_Line_No,
	 [ZYGO$Prod_ Order Component].Position,
	 [ZYGO$Prod_ Order Component].[Item No_] AS Comp_Item_No,
	 [ZYGO$Prod_ Order Component].Description AS Comp_Item_Desc,
	 [ZYGO$Prod_ Order Component].[Location Code] AS Comp_Location_Code,
	 [ZYGO$Prod_ Order Component].[Bin Code],
	 [ZYGO$Prod_ Order Component].[Quantity] AS Comp_Quantity,
	[ZYGO$Prod_ Order Component].[Remaining Quantity] AS Comp_Remaining_Quantity,
	 [ZYGO$Production Order].[Assigned User ID],
	 GETDATE() AS Data_Date
	

	FROM [ZYGO$Production Order] 

	INNER JOIN [ZYGO$Prod_ Order Line] ON [ZYGO$Production Order].No_ = [ZYGO$Prod_ Order Line].[Prod_ Order No_] 
	INNER JOIN [ZYGO$Prod_ Order Component] 
		ON ([ZYGO$Prod_ Order Line].[Line No_] = [ZYGO$Prod_ Order Component].[Prod_ Order Line No_]) 
		AND ([ZYGO$Prod_ Order Line].[Prod_ Order No_] = [ZYGO$Prod_ Order Component].[Prod_ Order No_]) 

WHERE [ZYGO$Production Order].Status &gt; 2
)
,s2 AS
(
	SELECT 

	 [ZYGO$Warehouse Entry].[Item No_],
	 [ZYGO$Warehouse Entry].[Location Code] AS Whs_Location_Code,
	 [ZYGO$Warehouse Entry].[Bin Code] AS Whs_Bin_Code,
	 Sum([ZYGO$Warehouse Entry].Quantity) AS SumOfQuantity

	FROM [ZYGO$Warehouse Entry]

	GROUP BY

	 [ZYGO$Warehouse Entry].[Item No_],
	 [ZYGO$Warehouse Entry].[Location Code],
	 [ZYGO$Warehouse Entry].[Bin Code]


)

SELECT 
 
 s1.Prod_Order_Line_Location_Code,
 s1.[Shortcut Dimension 2 Code],
 s1.Prod_Order_Line_Item,
 s1.Prod_Order_Line_Item_Desc,
 s1.[Prod_ Order No_],
 s1.Pro_Order_Line_LIne_No,
 s1.Status,
 s1.Prod_Ord_Status_Desc,
 s1.ReworkDescription,
 s1.[Finished Date],
 s1.Prod_Order_Line_Quantity,
 s1.Prod_Order_Line_Finished_Quantity,
 s1.Prod_Order_Line_Scrap_Quantity,
 s1.Prod_Order_Line_Remaining_Qty,
 s1.[Reference Component],
 s1.[Flushing Method],
 s1.Flushing_Method_Desc,
 s1.Comp_Line_No,
 s1.Position,
 s1.Comp_Item_No,
 s1.Comp_Item_Desc,
 s1.Comp_Location_Code,
 s1.[Bin Code],
 s1.Comp_Quantity,
 s1.Comp_Remaining_Quantity,
 s1.[Assigned User ID],
 s1.Data_Date,
 s2.SumOfQuantity

FROM s1 

LEFT JOIN s2 ON 

s1.[Bin Code] = s2.Whs_Bin_Code 
AND s1.Comp_Location_Code = s2.Whs_Location_Code
AND s1.Comp_Item_No = s2.[Item No_]

WHERE 
(
((((s1.Prod_Ord_Status_Desc)&lt;&gt;'Finished') 
AND (s1.Prod_Order_Line_Remaining_Qty)=0) 
AND (s1.[Reference Component]=0) 
AND (s1.Comp_Remaining_Quantity&lt;&gt;0)) 

OR 

(((((s1.[Finished Date])=CAST(GETDATE() as date)) 
--(((((s1.[Finished Date]) &lt;&gt; '1753-01-01 00:00:00.000') 
AND (s1.Prod_Order_Line_Remaining_Qty)=0) 
AND (s1.[Reference Component])=0) 
AND (s1.Comp_Remaining_Quantity)&lt;&gt;0)
)

AND s1.Prod_Order_Line_Location_Code IN ('RIC')

ORDER BY 
 
 s1.Prod_Order_Line_Location_Code,
 s1.[Shortcut Dimension 2 Code],
 s1.Prod_Order_Line_Item,
 s1.[Prod_ Order No_],
 s1.Comp_Line_No;</CommandText>
        <rd:UseGenericDesigner>true</rd:UseGenericDesigner>
      </Query>
