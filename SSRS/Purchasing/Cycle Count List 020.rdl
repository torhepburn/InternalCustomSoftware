<?xml version="1.0" encoding="utf-8"?>
<Report MustUnderstand="df" xmlns="http://schemas.microsoft.com/sqlserver/reporting/2016/01/reportdefinition" xmlns:rd="http://schemas.microsoft.com/SQLServer/reporting/reportdesigner" xmlns:df="http://schemas.microsoft.com/sqlserver/reporting/2016/01/reportdefinition/defaultfontfamily">
  <df:DefaultFontFamily>Segoe UI</df:DefaultFontFamily>
  <AutoRefresh>0</AutoRefresh>
  <DataSources>
    <DataSource Name="NAV">
      <DataSourceReference>NAV</DataSourceReference>
      <rd:SecurityType>None</rd:SecurityType>
      <rd:DataSourceID>01647ef4-894b-4a5c-a6a7-a53aa63d4b60</rd:DataSourceID>
    </DataSource>
  </DataSources>
  <DataSets>
    <DataSet Name="DataSet1">
      <Query>
        <DataSourceName>NAV</DataSourceName>
        <CommandText>WITH s1 AS
(
	SELECT 
	
	SUM(Quantity) OH
	,[Item No_]
	,[Bin Code]
	
	FROM [ZYGO$Warehouse Entry]

	WHERE [Bin Code] LIKE '020%'

	GROUP BY 

	 [Item No_]
	,[Bin Code]
)

SELECT top 100

'' CycleCountQuantity
,s1.*
,s1.OH * i.[Standard Cost] DollarValue

FROM s1 

LEFT JOIN ZYGO$Item i ON s1.[Item No_] = i.No_

WHERE

OH &gt; 0 AND

[Item No_] IN 

(

select [Item No_] from [ZYGO$Bin Content]

WHERE  [Bin Code] LIKE '020%'

AND [Item No_] NOT IN

(SELECT [Item No_] FROM [ZYGO$Bin Content]

WHERE [Bin Code] NOT LIKE '020%' AND [Location Code] = 'MID')

)

ORDER BY s1.OH * i.[Standard Cost] DESC</CommandText>
        <rd:UseGenericDesigner>true</rd:UseGenericDesigner>
      </Query>
      <Fields>
        <Field Name="CycleCountQuantity">
          <DataField>CycleCountQuantity</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="OH">
          <DataField>OH</DataField>
          <rd:TypeName>System.Decimal</rd:TypeName>
        </Field>
        <Field Name="Item_No_">
          <DataField>Item No_</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Bin_Code">
          <DataField>Bin Code</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="DollarValue">
          <DataField>DollarValue</DataField>
          <rd:TypeName>System.Decimal</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
  </DataSets>
