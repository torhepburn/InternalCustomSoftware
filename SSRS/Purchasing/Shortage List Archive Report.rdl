  <AutoRefresh>0</AutoRefresh>
  <DataSources>
    <DataSource Name="DataSource1">
      <DataSourceReference>AccessFrontEnds</DataSourceReference>
      <rd:SecurityType>DataBase</rd:SecurityType>
      <rd:DataSourceID>4c304d08-c45c-407d-a8e7-952c3587fdbb</rd:DataSourceID>
    </DataSource>
  </DataSources>
  <DataSets>
    <DataSet Name="DataSet1">
      <Query>
        <DataSourceName>DataSource1</DataSourceName>
        <QueryParameters>
          <QueryParameter Name="@ProductLine">
            <Value>=Parameters!ProductLine.Value</Value>
            <rd:UserDefined>true</rd:UserDefined>
          </QueryParameter>
          <QueryParameter Name="@WhoAdded">
            <Value>=Parameters!WhoAdded.Value</Value>
            <rd:UserDefined>true</rd:UserDefined>
          </QueryParameter>
          <QueryParameter Name="@WhoArchived">
            <Value>=Parameters!WhoArchived.Value</Value>
            <rd:UserDefined>true</rd:UserDefined>
          </QueryParameter>
        </QueryParameters>
        <CommandText>select

ID
,itemCode
,WhoAdded
,DateAddedtoList
,WhoArchived
,DateArchived

from Shortage_List

where DateArchived is not null

and ProductLine = @ProductLine

AND ((WhoAdded = @WhoAdded) OR @WhoAdded is null)

AND ((WhoArchived = @WhoArchived) OR @WhoArchived is null)

order by DateArchived desc</CommandText>
        <rd:UseGenericDesigner>true</rd:UseGenericDesigner>
      </Query>
      <Fields>
        <Field Name="ID">
          <DataField>ID</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
        <Field Name="itemCode">
          <DataField>itemCode</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="WhoAdded">
          <DataField>WhoAdded</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="DateAddedtoList">
          <DataField>DateAddedtoList</DataField>
          <rd:TypeName>System.DateTime</rd:TypeName>
        </Field>
        <Field Name="WhoArchived">
          <DataField>WhoArchived</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="DateArchived">
          <DataField>DateArchived</DataField>
          <rd:TypeName>System.DateTime</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
    <DataSet Name="DataSet2">
      <Query>
        <DataSourceName>DataSource1</DataSourceName>
        <CommandText>select

DISTINCT WhoAdded

from Shortage_List

ORDER BY WhoAdded</CommandText>
      </Query>
      <Fields>
        <Field Name="WhoAdded">
          <DataField>WhoAdded</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
    <DataSet Name="DataSet3">
      <Query>
        <DataSourceName>DataSource1</DataSourceName>
        <CommandText>select

DISTINCT WhoArchived

from Shortage_List

ORDER BY WhoArchived</CommandText>
      </Query>
      <Fields>
        <Field Name="WhoArchived">
          <DataField>WhoArchived</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
  </DataSets>
