<?xml version="1.0" encoding="utf-8"?>
<Report MustUnderstand="df" xmlns="http://schemas.microsoft.com/sqlserver/reporting/2016/01/reportdefinition" xmlns:rd="http://schemas.microsoft.com/SQLServer/reporting/reportdesigner" xmlns:df="http://schemas.microsoft.com/sqlserver/reporting/2016/01/reportdefinition/defaultfontfamily">
  <df:DefaultFontFamily>Segoe UI</df:DefaultFontFamily>
  <AutoRefresh>0</AutoRefresh>
  <DataSources>
    <DataSource Name="NAV">
      <DataSourceReference>NAV</DataSourceReference>
      <rd:SecurityType>None</rd:SecurityType>
      <rd:DataSourceID>198a11f2-63a7-4497-aba0-bbd4caad87ad</rd:DataSourceID>
    </DataSource>
  </DataSources>
  <DataSets>
    <DataSet Name="DataSet1">
      <Query>
        <DataSourceName>NAV</DataSourceName>
        <CommandText>WITH sl1 AS
(
	SELECT DISTINCT [Table ID],[Field ID], [Field Name]  
	
	FROM [ZYGO$Config_ Package Field]
)
,sl2 AS
(
SELECT

--[Entry No_]
[Date and Time]
,[User ID]
--,[Field No_]
,[Field Name]
--,[Type of Change]
--MIN([Old Value]) [Previous Line Amount]
--,MAX([New Value]) [New_Line Amount]
,[Old Value] [Previous Line Amount]
,[New Value] [New Line Amount]


--,[Primary Key Field 1 Value]
,[Primary Key Field 2 Value] PO_Number
,[Primary Key Field 3 Value] Line_Number

FROM [ZYGO$Change Log Entry] e

LEFT JOIN sl1 f ON e.[Table No_] = f.[Table ID] AND e.[Field No_] = f.[Field ID]


where [Table ID] = 39

and [Type of Change] = 1 --modification

AND [Primary Key Field 1 Value] &lt;&gt; 2

AND [Field No_] IN (103) --line amount

AND [Date and Time] &gt;= DATEADD(ww, -1,GETDATE())

AND [Old Value] &gt; '0'

AND [Primary Key Field 2 Value] NOT LIKE 'KB-%'

--AND [New Value] &gt; [Old Value]

--GROUP BY

--[Primary Key Field 2 Value]
--,[Primary Key Field 3 Value] 
)

select * from sl2</CommandText>
        <rd:UseGenericDesigner>true</rd:UseGenericDesigner>
      </Query>
      <Fields>
        <Field Name="Date_and_Time">
          <DataField>Date and Time</DataField>
          <rd:TypeName>System.DateTime</rd:TypeName>
        </Field>
        <Field Name="User_ID">
          <DataField>User ID</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Field_Name">
          <DataField>Field Name</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Previous_Line_Amount">
          <DataField>Previous Line Amount</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="New_Line_Amount">
          <DataField>New Line Amount</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="PO_Number">
          <DataField>PO_Number</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Line_Number">
          <DataField>Line_Number</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
  </DataSets>
