<?xml version="1.0" encoding="utf-8"?>
<Report MustUnderstand="df" xmlns="http://schemas.microsoft.com/sqlserver/reporting/2016/01/reportdefinition" xmlns:rd="http://schemas.microsoft.com/SQLServer/reporting/reportdesigner" xmlns:df="http://schemas.microsoft.com/sqlserver/reporting/2016/01/reportdefinition/defaultfontfamily">
  <df:DefaultFontFamily>Segoe UI</df:DefaultFontFamily>
  <AutoRefresh>0</AutoRefresh>
  <DataSources>
    <DataSource Name="NAV">
      <DataSourceReference>NAV</DataSourceReference>
      <rd:SecurityType>None</rd:SecurityType>
      <rd:DataSourceID>ea8513e4-08cf-4222-b05b-5bfc293c4c9b</rd:DataSourceID>
    </DataSource>
  </DataSources>
  <DataSets>
    <DataSet Name="DataSet1">
      <Query>
        <DataSourceName>NAV</DataSourceName>
        <QueryParameters>
          <QueryParameter Name="@prodorderno">
            <Value>=Parameters!prodorderno.Value</Value>
          </QueryParameter>
        </QueryParameters>
        <CommandText>WITH s1 AS
(
SELECT 

SUM(Quantity) OnHand
,[Item No_]

FROM [ZYGO$Item Ledger Entry]

WHERE [Item No_] IN
(
select 

[Item No_]

from [ZYGO$Prod_ Order Component] c

where [Prod_ Order No_] = @prodorderno
)
GROUP BY [Item No_]

)

select 

c.[Item No_]
,Description
--,Quantity
--,[Quantity per]
,[Remaining Quantity] [QTY NEEDED]
,COALESCE(OnHand,0) [On Hand]
,[Bin Code]
,[Prod_ Order No_]
,[Prod_ Order Line No_]
,[Line No_]


from [ZYGO$Prod_ Order Component] c

LEFT JOIN s1 ON c.[Item No_] = s1.[Item No_]

where [Prod_ Order No_] = @prodorderno</CommandText>
        <rd:UseGenericDesigner>true</rd:UseGenericDesigner>
      </Query>
      <Fields>
        <Field Name="Item_No_">
          <DataField>Item No_</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Description">
          <DataField>Description</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="QTY_NEEDED">
          <DataField>QTY NEEDED</DataField>
          <rd:TypeName>System.Decimal</rd:TypeName>
        </Field>
        <Field Name="On_Hand">
          <DataField>On Hand</DataField>
          <rd:TypeName>System.Decimal</rd:TypeName>
        </Field>
        <Field Name="Bin_Code">
          <DataField>Bin Code</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Prod__Order_No_">
          <DataField>Prod_ Order No_</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Prod__Order_Line_No_">
          <DataField>Prod_ Order Line No_</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
        <Field Name="Line_No_">
          <DataField>Line No_</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
  </DataSets>
