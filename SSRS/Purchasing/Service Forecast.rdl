<?xml version="1.0" encoding="utf-8"?>
<Report MustUnderstand="df" xmlns="http://schemas.microsoft.com/sqlserver/reporting/2016/01/reportdefinition" xmlns:rd="http://schemas.microsoft.com/SQLServer/reporting/reportdesigner" xmlns:df="http://schemas.microsoft.com/sqlserver/reporting/2016/01/reportdefinition/defaultfontfamily">
  <df:DefaultFontFamily>Segoe UI</df:DefaultFontFamily>
  <AutoRefresh>0</AutoRefresh>
  <DataSources>
    <DataSource Name="DataSource1">
      <ConnectionProperties>
        <DataProvider>SQL</DataProvider>
        <ConnectString>Data Source=pa-hor-as408;Initial Catalog=ZYGO-NAV-PROD</ConnectString>
      </ConnectionProperties>
      <rd:SecurityType>DataBase</rd:SecurityType>
      <rd:DataSourceID>df963135-d1d7-4398-8efe-125c546c15aa</rd:DataSourceID>
    </DataSource>
  </DataSources>
  <DataSets>
    <DataSet Name="DataSet1">
      <Query>
        <DataSourceName>DataSource1</DataSourceName>
        <CommandText>WITH s1 AS
(
	SELECT 

	No_
	,[Description]
	,[Standard Cost]
	,[Buyer Planner Code]
	,CASE [Replenishment System]
		WHEN 0 THEN 'Purchase'
		WHEN 1 THEN 'Manufacture'
	END Replenishment
	FROM ZYGO$Item

	where [Description 3] = 'SVC FORECAST'
)
,s2 AS
(
	SELECT

	[Item No_]
	,SUM(Quantity) [Total OH]
	
	FROM [ZYGO$Item Ledger Entry] ile

	INNER JOIN s1 ON s1.No_ = ile.[Item No_]

	--WHERE [Item No_] = '1195-500-027'

	GROUP BY [Item No_]
)
,s3 AS
(
	SELECT

	[Item No_]
	,SUM(Quantity) [Qty in SVC]
	
	FROM [ZYGO$Item Ledger Entry] ile

	INNER JOIN s1 ON s1.No_ = ile.[Item No_]

	WHERE [Non-Nettable] = 1

	AND [Location Code] = 'MID SVC'

	GROUP BY [Item No_]
)
,s4 AS
(
	SELECT
	
	pl.No_
	,SUM([Outstanding Quantity]) POqty

	FROM [ZYGO$Purchase Line] pl

	INNER JOIN s1 ON s1.No_ = pl.No_

	WHERE [Outstanding Quantity] &gt; 0

	GROUP BY pl.No_
)
,s5 AS
(
	SELECT
	
	prod.[Item No_]
	,SUM([Remaining Quantity]) ProdQty
	
	FROM [ZYGO$Prod_ Order Line] prod

	INNER JOIN s1 ON s1.No_ = prod.[Item No_]

	WHERE [Remaining Quantity] &gt; 0

	GROUP BY prod.[Item No_]
)
,s6 AS
(
	SELECT
	[Item No_]
	,COALESCE(SUM([Remaining Quantity]), 0) AlocProdCmpnt
	FROM [ZYGO$Prod_ Order Component]
	WHERE [Item No_] IN (Select No_ FROM s1)
	AND Status in (2, 3)
	GROUP BY [Item No_]
)
,s7 AS
(
	SELECT
	No_
	,COALESCE(SUM([Quantity]), 0) AlocSO
	FROM [ZYGO$Sales Line]
	WHERE [No_] IN (Select No_ FROM s1)
	AND Type = 2 AND [Completely Shipped] = 0
	GROUP BY [No_]
)
,s8 AS
(
	SELECT
	No_
	,COALESCE(SUM([Outstanding Quantity]), 0) AlocSvc
	FROM [ZYGO$Service Line]
	WHERE [No_] IN (Select No_ FROM s1)
	AND [Outstanding Quantity] &gt; 0
	GROUP BY [No_]
)
,s9 AS
(
	SELECT
	No_
	,COALESCE(SUM([Quantity]), 0) AlocJob
	FROM [ZYGO$Job Journal Line]
	WHERE [No_] IN (Select No_ FROM s1)
	AND [Journal Template Name] = 'INVREQ'
	GROUP BY [No_]
)


SELECT 

pfe.[Item No_]
,s1.[Description]
,[Total OH]
,[Qty in SVC]
,[Replenishment]
,COALESCE(CASE
	WHEN POqty is null THEN ProdQty
	ELSE POqty
END,0) [On  Order]
,COALESCE(AlocProdCmpnt,0) AlocProdCmpnt
,COALESCE(AlocSO,0) AlocSO
,COALESCE(AlocSvc,0) AlocSvc
,COALESCE(AlocJob,0) AlocJob
,[Buyer Planner Code]
,[Standard Cost]
,[Forecast Quantity]
,[Forecast Date]


FROM [ZYGO$Production Forecast Entry] pfe

INNER JOIN s1 ON s1.No_ = pfe.[Item No_]

INNER JOIN s2 ON s1.No_ = s2.[Item No_]

INNER JOIN s3 ON s1.No_ = s3.[Item No_]

LEFT JOIN s4 ON s1.No_ = s4.No_

LEFT JOIN s5 ON s1.No_ = s5.[Item No_]

LEFT JOIN s6 ON s1.No_ = s6.[Item No_]
LEFT JOIN s7 ON s1.No_ = s7.[No_]
LEFT JOIN s8 ON s1.No_ = s8.[No_]
LEFT JOIN s9 ON s1.No_ = s9.[No_]

WHERE [Forecast Date] &gt; GETDATE()

order by pfe.[Item No_]

--select * from s2 INNER JOIN s3 ON s2.[Item No_] = s3.[Item No_]

--ORDER BY s2.[Item No_]</CommandText>
        <rd:UseGenericDesigner>true</rd:UseGenericDesigner>
      </Query>
      <Fields>
        <Field Name="Item_No_">
          <DataField>Item No_</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Description">
          <DataField>Description</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Total_OH">
          <DataField>Total OH</DataField>
          <rd:TypeName>System.Decimal</rd:TypeName>
        </Field>
        <Field Name="Qty_in_SVC">
          <DataField>Qty in SVC</DataField>
          <rd:TypeName>System.Decimal</rd:TypeName>
        </Field>
        <Field Name="Replenishment">
          <DataField>Replenishment</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="On__Order">
          <DataField>On  Order</DataField>
          <rd:TypeName>System.Decimal</rd:TypeName>
        </Field>
        <Field Name="AlocProdCmpnt">
          <DataField>AlocProdCmpnt</DataField>
          <rd:TypeName>System.Decimal</rd:TypeName>
        </Field>
        <Field Name="AlocSO">
          <DataField>AlocSO</DataField>
          <rd:TypeName>System.Decimal</rd:TypeName>
        </Field>
        <Field Name="AlocSvc">
          <DataField>AlocSvc</DataField>
          <rd:TypeName>System.Decimal</rd:TypeName>
        </Field>
        <Field Name="AlocJob">
          <DataField>AlocJob</DataField>
          <rd:TypeName>System.Decimal</rd:TypeName>
        </Field>
        <Field Name="Buyer_Planner_Code">
          <DataField>Buyer Planner Code</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Standard_Cost">
          <DataField>Standard Cost</DataField>
          <rd:TypeName>System.Decimal</rd:TypeName>
        </Field>
        <Field Name="Forecast_Quantity">
          <DataField>Forecast Quantity</DataField>
          <rd:TypeName>System.Decimal</rd:TypeName>
        </Field>
        <Field Name="Forecast_Date">
          <DataField>Forecast Date</DataField>
          <rd:TypeName>System.DateTime</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
  </DataSets>
