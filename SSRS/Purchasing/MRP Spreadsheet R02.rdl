  <DataSets>
    <DataSet Name="DataSet1">
      <Query>
        <DataSourceName>NAV</DataSourceName>
        <CommandText>/*
             *  Get the list of MRP purchased parts for which reports are needed 
             *  use all worksheets 
             *  [Ref_ Order Type] = 1 = Purchase
             *  Type = 2 = Item
             *  Action Message 1 new 2 change quantity 3 reschedule 4 reschedule and change quantity 5 cancel
             *  Vetted 0-vetted 1-notvetted
  
 */

 CREATE TABLE #PNewDelivery
(
 [No_] nvarchar(20)
,[Text] nvarchar(500)
)

declare @item varchar(30)
declare @text varchar(100)
declare @salesText varchar(500)
SET @salesText = ''

/*
	Item Cursor for MRP Purchase New not customer furnished material, not kanban

*/


declare itemCursor Cursor for 

select distinct r.[No_] FROM [ZYGO$Requisition Line] r

left join ZYGO$Item i on r.No_ = i.No_ 

WHERE 

0=0

AND r.[Ref_ Order Type] = 1

AND r.Type = 2

AND i.[Replenishment System] = 0

AND r.[Worksheet Template Name] = 'PLANNING'

AND r.[Journal Batch Name] = 'DEFAULT'

AND i.[Selection Code] not like 'K%'

AND i.[Selection Code] not like 'CFM%'

AND [Action Message] IN (1)  --purchase new

order by [No_]

open itemCursor

fetch next from itemCursor into @item

while @@FETCH_STATUS = 0
begin

declare textCursor Cursor for 

SELECT FORMAT(Quantity,'####') + '  for '+ FORMAT([Due Date],'MM/dd/yy') FROM [ZYGO$Requisition Line]

WHERE No_ = @item AND [Action Message] = 1  --purchase new

ORDER BY [Due Date]

OPEN textCursor

fetch next from textCursor into @text

while @@FETCH_STATUS = 0
begin
	
	SET @salesText = @salesText + ', ' +  @text
	
fetch next from textCursor into @text	
end

close textCursor
deallocate textCursor

INSERT INTO #PNewDelivery (No_, Text) SELECT @item, SUBSTRING(@salesText,2, (LEN(@salesText) - 1))

SET @salesText = ''
	
fetch next from itemCursor into  @item

end
close itemCursor
deallocate itemCursor;


 CREATE TABLE #RescheduleOutDelivery
(
 [No_] nvarchar(20)
,[Text] nvarchar(500)
)

--declare @item varchar(30)
--declare @text varchar(100)
--declare @salesText varchar(500)
SET @salesText = ''

/*
	Item Cursor for MRP Reschedule Push Out not customer furnished material, not kanban
*/

declare itemCursor Cursor for 

select distinct r.[No_] FROM [ZYGO$Requisition Line] r

left join ZYGO$Item i on r.No_ = i.No_ 

WHERE 

0=0

AND r.[Ref_ Order Type] = 1

AND r.Type = 2

AND i.[Replenishment System] = 0

AND r.[Worksheet Template Name] = 'PLANNING'

AND r.[Journal Batch Name] = 'DEFAULT'

AND i.[Selection Code] not like 'K%'

AND i.[Selection Code] not like 'CFM%'

AND [Action Message] IN (3)  --reschedule

AND [Original Due Date] &lt; [Due Date]

order by [No_]

open itemCursor
 
fetch next from itemCursor into @item

while @@FETCH_STATUS = 0
begin

declare textCursor Cursor for 

SELECT FORMAT(Quantity,'####') + '  for '+ FORMAT([Due Date],'MM/dd/yy') FROM [ZYGO$Requisition Line]

WHERE No_ = @item AND [Action Message] IN (3)  --reschedule

AND [Original Due Date] &lt; [Due Date]

ORDER BY [Due Date]

OPEN textCursor

fetch next from textCursor into @text

while @@FETCH_STATUS = 0
begin
	
	SET @salesText = @salesText + ', ' +  @text
	
fetch next from textCursor into @text	
end

close textCursor
deallocate textCursor

INSERT INTO #RescheduleOutDelivery (No_, Text) SELECT @item, SUBSTRING(@salesText,2, (LEN(@salesText) - 1))

SET @salesText = ''

/*
	Item Cursor for MRP Reschedule Pull In not customer furnished material, not kanban
*/
	
fetch next from itemCursor into  @item

end
close itemCursor
deallocate itemCursor;


 CREATE TABLE #RescheduleInDelivery
(
 [No_] nvarchar(20)
,[Text] nvarchar(500)
)

--declare @item varchar(30)
--declare @text varchar(100)
--declare @salesText varchar(500)
SET @salesText = ''

declare itemCursor Cursor for 

select distinct r.[No_] FROM [ZYGO$Requisition Line] r

left join ZYGO$Item i on r.No_ = i.No_ 

WHERE 

0=0

AND r.[Ref_ Order Type] = 1

AND r.Type = 2

AND i.[Replenishment System] = 0

AND r.[Worksheet Template Name] = 'PLANNING'

AND r.[Journal Batch Name] = 'DEFAULT'

AND i.[Selection Code] not like 'K%'

AND i.[Selection Code] not like 'CFM%'

AND [Action Message] IN (3)  --reschedule

AND [Original Due Date] &gt; [Due Date]

order by [No_]

open itemCursor
 
fetch next from itemCursor into @item

while @@FETCH_STATUS = 0
begin

declare textCursor Cursor for 

SELECT FORMAT(Quantity,'####') + '  for '+ FORMAT([Due Date],'MM/dd/yy') FROM [ZYGO$Requisition Line]

WHERE No_ = @item AND [Action Message] IN (3)  --reschedule

AND [Original Due Date] &gt; [Due Date]

ORDER BY [Due Date]

OPEN textCursor

fetch next from textCursor into @text

while @@FETCH_STATUS = 0
begin
	
	SET @salesText = @salesText + ', ' +  @text
	
fetch next from textCursor into @text	
end

close textCursor
deallocate textCursor

INSERT INTO #RescheduleInDelivery (No_, Text) SELECT @item, SUBSTRING(@salesText,2, (LEN(@salesText) - 1))

SET @salesText = ''
	
fetch next from itemCursor into  @item

end
close itemCursor
deallocate itemCursor;


WITH s1 AS		/*	all action messages except for cancel, not kanban, not customer furnished material, not vendor managed items - within 14 days	*/
(
	select 

	distinct 

	r.No_
	,r.[Buyer Planner Code]
	,r.[Vendor No_]

	from [ZYGO$Requisition Line] r

	left join ZYGO$Item i on r.No_ = i.No_ 

	WHERE 

	0=0

	AND r.[Ref_ Order Type] = 1

	AND r.Type = 2

	AND i.[Replenishment System] = 0

	AND r.[Worksheet Template Name] = 'PLANNING'

	AND r.[Journal Batch Name] = 'DEFAULT'

	AND i.[Selection Code] not like 'K%'

	AND i.[Selection Code] not like 'CFM%'

	AND [Action Message] NOT IN (5) -- cancel

	AND i.[Item Group Code] &lt;&gt; 'VMI'

	AND r.[Starting Date] &lt; (GETDATE() + 14)
)
,s1a AS
(
	select 
		
	r.No_
	,MIN(r.[Starting Date]) EarliestPurchaseNew

	from [ZYGO$Requisition Line] r

	left join ZYGO$Item i on r.No_ = i.No_ 

	WHERE 

	0=0

	AND r.[Ref_ Order Type] = 1

	AND r.Type = 2

	AND i.[Replenishment System] = 0

	AND r.[Worksheet Template Name] = 'PLANNING'

	AND r.[Journal Batch Name] = 'DEFAULT'

	AND i.[Selection Code] not like 'K%'

	AND i.[Selection Code] not like 'CFM%'

	AND [Action Message] IN (1) -- purchase new

	AND i.[Item Group Code] &lt;&gt; 'VMI'

	AND r.[Starting Date] &lt;= (DATEADD(WEEK, 3, GETDATE()))

	GROUP BY r.No_

)
,s2 AS
(
	SELECT

	 l.No_
	,[Action Message]
	,COALESCE(CASE [Action Message]
		WHEN 1 THEN CAST(SUM(Quantity) as int) 
	END,0) [Purchase New Quantity]
	,COALESCE(CASE [Action Message]
		WHEN 2 THEN CAST(SUM(Quantity) as int)
	END,0) [Change Quantity]
	,COALESCE(CASE [Action Message]
		WHEN 3 THEN CAST(SUM(Quantity)  as int)
		END,0) [Reschedule No Change Quantity] 
	,COALESCE(CASE [Action Message]
		WHEN 4 THEN CAST(SUM(Quantity) as int)
	END,0) [Reschedule Change Quantity]

	FROM [ZYGO$Requisition Line] l 
	
	INNER JOIN s1 ON s1.No_ = l.No_
	
	GROUP BY l.No_,[Action Message]
)
,s3 AS
(
	SELECT

	No_
	,SUM([Purchase New Quantity]) [Purchase New Quantity]
	,SUM([Change Quantity]) [Change Quantity]
	,SUM([Reschedule No Change Quantity]) [Reschedule No Change Quantity]
	,SUM([Reschedule Change Quantity]) [Reschedule Change Quantity]
	
	FROM s2

	GROUP BY No_
)
,s4 as
(
	SELECT

	[Item No_]
	,SUM(Quantity) [MRB Quantity]

	FROM [ZYGO$Item Ledger Entry] ile

	INNER JOIN s1 ON ile.[Item No_] = s1.No_

	WHERE [Location Code] LIKE '%MRB%'

	GROUP BY [Item No_]

	HAVING SUM(Quantity) &gt; 0
)
,s5 AS
(

SELECT DISTINCT

s1.[Buyer Planner Code]
, s1.[Vendor No_]
,COALESCE(v.Name,'') Vendor
,s1.No_
,i.Description
,i.[Revision Level]
,CASE i.Vetted
	WHEN 0 THEN 'Vetted'
	WHEN 1 THEN 'Not-Vetted'
END Vetted
,s3.[Purchase New Quantity]
,s3.[Change Quantity]
,s3.[Reschedule No Change Quantity]
,s3.[Reschedule Change Quantity]
,'' [New Price]
,CASE  WHEN LEN(i.[Lead Time Calculation]) = 0 THEN '0'
      WHEN CHARINDEX(CHAR(3),i.[Lead Time Calculation]) &gt; 0
           THEN REPLACE(i.[Lead Time Calculation], CHAR(3), '')
    WHEN CHARINDEX(CHAR(4),i.[Lead Time Calculation]) &gt; 0 THEN   --week 
       REPLACE(i.[Lead Time Calculation], CHAR(4), '') * 5       --convert to days 
    WHEN CHARINDEX(CHAR(5),i.[Lead Time Calculation]) &gt; 0 THEN  --month 
       REPLACE(i.[Lead Time Calculation], CHAR(5), '') * 20	    --convert to days 
   WHEN CHARINDEX(CHAR(2),i.[Lead Time Calculation]) &gt; 0 THEN   -- days 
       REPLACE(i.[Lead Time Calculation], CHAR(2), '')		
END [Lead Time Calculation]
,[Last Direct Cost] [Last Purchase Price]
,[Standard Cost]
,COALESCE(EarliestPurchaseNew,'') [Earliest Purchase New Start Date]
,COALESCE(d.Text,'') [Purchase New Requested Delivery]
,COALESCE(nin.Text,'') [Reschedule In Requested Delivery]
,COALESCE(o.Text,'') [Reschedule Out Delivery]
,COALESCE(CAST([MRB Quantity] as int),0) [MRB Quantity]
,''Comments
,i.[Signal Code]
,i.[Selection Code]


FROM s1 LEFT JOIN ZYGO$Item i ON s1.No_ = i.No_

LEFT JOIN s2 ON s1.No_ = s2.No_

LEFT JOIN s3 ON s1.No_ = s3.No_

LEFT JOIN ZYGO$Vendor v ON s1.[Vendor No_] = v.No_

LEFT JOIN #PNewDelivery d ON  d.No_ = s1.No_ COLLATE DATABASE_DEFAULT

LEFT JOIN #RescheduleOutDelivery o ON  o.No_ = s1.No_ COLLATE DATABASE_DEFAULT

LEFT JOIN #RescheduleInDelivery nin ON  nin.No_ = s1.No_ COLLATE DATABASE_DEFAULT

LEFT JOIN s1a ON s1.No_ = s1a.No_

LEFT JOIN s4 ON s1.No_ = s4.[Item No_]
)

select * from s5 where [Earliest Purchase New Start Date] &lt;= DATEADD(ww,3,GETDATE()) AND [Earliest Purchase New Start Date] &lt;&gt; '1900-01-01'

ORDER BY

--[Earliest Purchase New Start Date] desc
[Buyer Planner Code]
,[Vendor No_]
,No_

--DROP TABLE #ItemDelivery
--DROP TABLE #PNewDelivery;DROP TABLE #RescheduleOutDelivery;DROP TABLE #RescheduleInDelivery</CommandText>
        <rd:UseGenericDesigner>true</rd:UseGenericDesigner>
      </Query>
