        <Field Name="Reschedule_Out_Delivery">
          <DataField>Reschedule Out Delivery</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="MRB_Quantity">
          <DataField>MRB Quantity</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
        <Field Name="Comments">
          <DataField>Comments</DataField>
