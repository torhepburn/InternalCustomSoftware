<?xml version="1.0" encoding="utf-8"?>
<Report MustUnderstand="df" xmlns="http://schemas.microsoft.com/sqlserver/reporting/2016/01/reportdefinition" xmlns:rd="http://schemas.microsoft.com/SQLServer/reporting/reportdesigner" xmlns:df="http://schemas.microsoft.com/sqlserver/reporting/2016/01/reportdefinition/defaultfontfamily">
  <df:DefaultFontFamily>Segoe UI</df:DefaultFontFamily>
  <AutoRefresh>0</AutoRefresh>
  <DataSources>
    <DataSource Name="DataSource1">
      <DataSourceReference>NAV</DataSourceReference>
      <rd:SecurityType>DataBase</rd:SecurityType>
      <rd:DataSourceID>e03458fe-fc81-46f8-8f02-8bc8cbdb8514</rd:DataSourceID>
    </DataSource>
  </DataSources>
  <DataSets>
    <DataSet Name="DataSet1">
      <Query>
        <DataSourceName>DataSource1</DataSourceName>
        <CommandText>DECLARE @item varchar(50)
--DECLARE @vetted int

--SET @vetted = 0
SET DATEFIRST 1;

DECLARE @yearstart date
DECLARE @weekstart date

SET @yearstart = GETDATE() - 365

select @weekstart = dateadd(week, datediff(week, 0, @yearstart), 0);


CREATE TABLE #Temp
(
 [Item] varchar(50)
,[Standard Deviation] decimal(38,6)
,[Average Consumption] decimal(38,6)
,[SIM Number] int
,[CoV] decimal(38,6)
)

CREATE TABLE #LETTER
(
 [Item] varchar(50)
,[DESCRIPTION] varchar(60)
,[BUYER] varchar(30)
,[VENDOR] varchar(50)
,[COMMODITY CODE] varchar(10)
,[COMMODITY CODE DESCRIPTION] varchar(50)
,[BUSINESS SEGMENT CODE] varchar(50)
,[SELECTION CODE] varchar(10)
,[SIGNAL CODE] varchar(10)
,NETTABLE int
,NONNETTABLE int
,[NETTABLE DOLLARS] decimal(38,2)
,[NONNETTABLE DOLLARS] decimal(38,2)
,[QTY ON ORDER] int
,[DOLLARS ON ORDER] decimal(38,2)
,[SAFETY STOCK] int
,[Standard Cost] decimal(38,2)
,EAU int
,P6 int
,F6 int
,[Item Spend] decimal(38,2)
,[VETTED] varchar(10)
,[LEAD TIME] varchar(10)
,[LOCATION] varchar(50)
,[PHYSICAL INVENTORY COUNTING PERIOD] varchar(1)
,[RECEIPT COUNT] int
,[NAV SIM] varchar(2)
,[SIM Comments] varchar(250)
,[SIM Letter] varchar(1)
,[Lot Accumulation Period] varchar(10)
)



DECLARE simCursor CURSOR FOR

/*	Get the list of all items which need to be considered */

SELECT 

No_

FROM ZYGO$Item WHERE (P6 &gt; 0 OR F6 &gt; 0)

AND [Replenishment System] = 0


OPEN simCursor

FETCH NEXT FROM simCursor INTO @item

WHILE @@FETCH_STATUS = 0
BEGIN

WITH s1 AS
(
SELECT 

DATEPART(WEEK,[Posting Date]) [Week Number]
,[Item No_]
,SUM(Quantity) * -1 [Weekly Consumption]

FROM [ZYGO$Item Ledger Entry] ile

INNER JOIN ZYGO$Item i ON ile.[Item No_] = i.No_

WHERE [Posting Date] &gt;= @weekstart

AND ([Entry Type] = 1 --Sale

OR [Entry Type] = 5) --Consumption

AND [Item No_] = @item

GROUP BY DATEPART(WEEK,[Posting Date]), [Item No_]

)
,s2 AS --recursive cte to add 53 weeks consumption of zero for the blank weeks - 'level' as the counter
 (
  SELECT
  [Week Number]
  ,[Item No_]
  ,CAST([Weekly Consumption] AS decimal) [Weekly Consumption]
  ,1 AS LEVEL
  FROM s1
  UNION ALL
  SELECT
  CAST('1' AS int)
  ,t1.[Item No_]
  ,CAST(0 AS decimal)
  , LEVEL + 1
  FROM s1 t1
  INNER JOIN
  s2 t2
  ON t1.[Item No_] = t2.[Item No_]
  AND LEVEL &lt; 53
 )
 ,s3 AS
 (
SELECT TOP 53

*

FROM s2
)

INSERT INTO #TEMP
(
	[Item] 
	,[Standard Deviation] 
	,[Average Consumption]
	,[SIM Number] 
	,[CoV] 
)


SELECT

[Item No_]
,COALESCE(STDEV([Weekly Consumption]),0) Dev
,AVG([Weekly Consumption]) Av
,COALESCE(CASE
	WHEN COALESCE(AVG([Weekly Consumption]),0) &gt; 0
		THEN
	CASE
	WHEN COALESCE(STDEV([Weekly Consumption]),0)/AVG([Weekly Consumption]) = 0 THEN 3
	WHEN COALESCE(STDEV([Weekly Consumption]),0)/AVG([Weekly Consumption]) &gt;= 2 THEN 3
	WHEN COALESCE(STDEV([Weekly Consumption]),0)/AVG([Weekly Consumption]) &gt; 0 AND COALESCE(STDEV([Weekly Consumption]),0)/AVG([Weekly Consumption]) &lt; 1  THEN 2
	WHEN COALESCE(STDEV([Weekly Consumption]),0)/AVG([Weekly Consumption]) &gt;= 1 AND COALESCE(STDEV([Weekly Consumption]),0)/AVG([Weekly Consumption]) &lt; 2  THEN 1
END END,0) [SIM Number]
,COALESCE(CASE
	WHEN COALESCE(AVG([Weekly Consumption]),0) &gt; 0
		THEN COALESCE(STDEV([Weekly Consumption]),0)/AVG([Weekly Consumption])
	END,0) CoV 

FROM s3
GROUP BY [Item No_]


FETCH NEXT FROM simCursor INTO @item
END
CLOSE simCursor
DEALLOCATE simCursor;


WITH s1 AS
(
select

[Item No_] [Item]

,SUM( 
	CASE
	WHEN [Document Type] = 5 --purchase receipt
	AND [Posting Date]&gt;= @weekstart
	THEN Quantity
	END ) ReceiptCount
,SUM( 
	CASE
	WHEN ([Entry Type] = 5 --consumption
	OR [Entry Type] = 1) --sale
	AND [Posting Date]&gt;= @weekstart
	THEN Quantity * -1
	END ) [Item Consumption]
,SUM( 
	CASE
	WHEN [Non-Nettable] = 0 
	THEN Quantity
	END ) [Nettable]
,SUM( 
	CASE
	WHEN [Non-Nettable] = 1 
	THEN Quantity
	END ) [NonNettable]
	
	FROM [ZYGO$Item Ledger Entry] ile

	INNER JOIN ZYGO$Item i ON ile.[Item No_] = i.No_

	WHERE 1=1

	AND [Replenishment System] = 0

	GROUP BY [Item No_]
)

,sOrder AS
(
	SELECT
	i.No_ [Item]
	,SUM(l.[Outstanding Quantity]) [Qty On Order]
	,SUM(l.[Outstanding Amount]) [Dollars On Order]
	FROM [ZYGO$Purchase Line] l
	INNER JOIN [ZYGO$Item] i ON l.No_ = i.No_
	WHERE ([Replenishment System] = 0  --purchased
	and [Document Type] = 1  --order
	and [Outstanding Quantity] &gt; 0)
	GROUP BY i.No_
)
,s2 AS
(
SELECT

s1.[Item]
,i.[Standard Cost]
, [Item Consumption] * [Standard Cost] [Item Spend]
,CASE i.SIM 
	WHEN 0 THEN '0'
	WHEN 1 THEN 'A1'
	WHEN 2 THEN 'A2'
	WHEN 3 THEN 'A3'
	WHEN 4 THEN 'B1'
	WHEN 5 THEN 'B2'
	WHEN 6 THEN 'B3'
	WHEN 7 THEN 'C1'
	WHEN 8 THEN 'C2'
	WHEN 9 THEN 'C3'
END [NAV SIM]
,[Stock Location] [LOCATION]
, CASE Vetted
	WHEN 0 THEN 'Vetted'
	WHEN 1 THEN 'Not Vetted'
END VETTED
,[Buyer Planner Code] BUYER
,COALESCE(v.Name,'') VENDOR
,i.Description [DESCRIPTION]
,i.[Selection Code] [SELECTION CODE]
,i.[Signal Code] [SIGNAL CODE]
,i.Commodity [COMMODITY CODE]
,c.Description [COMMODITY CODE DESCRIPTION]
,i.[Global Dimension 2 Code] [BUSINESS SEGMENT CODE]
,i.[Phys Invt Counting Period Code] [PHYSICAL INVENTORY COUNTING PERIOD]
,COALESCE(CASE  
      WHEN CHARINDEX(CHAR(3),i.[Lead Time Calculation]) &gt; 0 
	        THEN REPLACE(i.[Lead Time Calculation], CHAR(3), 'WD')
END,'') [LEAD TIME]
--,COALESCe(CASE  
--      WHEN CHARINDEX(CHAR(3),i.[Lead Time Calculation]) &gt; 0 
--	        THEN REPLACE(i.[Lead Time Calculation], CHAR(3), '')
--END,'') [TOTAL LT]
--,COALESCE(CASE 
--	WHEN LEN(i.[Lead Time Calculation]) &gt; 0 THEN
--	CAST(CASE  
--      WHEN CHARINDEX(CHAR(3),i.[Lead Time Calculation]) &gt; 0 
--	        THEN REPLACE(i.[Lead Time Calculation], CHAR(3), '')
--END AS int) - 10 
--END, '') [ORDER LT]
--,i.[Safety Lead Time] [SAFETY LEAD TIME]
,CAST (i.[Safety Stock Quantity] as int) [SAFETY STOCK]
--,i.[Safety Stock Quantity] * i.[Standard Cost] [NAV SFT STK]
,s1.Nettable
,s1.NonNettable
,EAU
,P6
,F6
,[Phys Invt Counting Period Code]
,[SIM Comments]
,CASE 
   WHEN CHARINDEX(CHAR(3),[Lot Accumulation Period]) &gt; 0 THEN    --work days 
        REPLACE([Lot Accumulation Period], CHAR(3), 'WD') 
    WHEN CHARINDEX(CHAR(4),[Lot Accumulation Period]) &gt; 0 THEN   --week 
       REPLACE([Lot Accumulation Period], CHAR(4), 'W')	    --convert to days 
    WHEN CHARINDEX(CHAR(5),[Lot Accumulation Period]) &gt; 0 THEN   --month 
       REPLACE([Lot Accumulation Period], CHAR(5), 'M') 	       --convert to days 
   WHEN CHARINDEX(CHAR(2),[Lot Accumulation Period]) &gt; 0 THEN       -- days 
       REPLACE([Lot Accumulation Period], CHAR(2), 'D')		
   WHEN LEN([Lot Accumulation Period]) = 0 THEN '0' 
 END [Lot Accumulation Period]

FROM ZYGO$Item i INNER JOIN s1 ON i.No_ = s1.[Item]

LEFT JOIN [ZYGO$Vendor] v ON v.No_ = i.[Vendor No_]

LEFT JOIN ZYGO$Commodity c ON i.Commodity = c.Code
)

INSERT INTO #LETTER
(
 [ITEM]
,[DESCRIPTION]
,[BUYER]
,[VENDOR]
,[COMMODITY CODE]
,[COMMODITY CODE DESCRIPTION]
,[BUSINESS SEGMENT CODE]
,[SELECTION CODE]
,[SIGNAL CODE]
,NETTABLE
,[NETTABLE DOLLARS]
,NONNETTABLE
,[NONNETTABLE DOLLARS]
,[QTY ON ORDER]
,[DOLLARS ON ORDER]
,[SAFETY STOCK]
,[Standard Cost]
,EAU
,P6
,F6
,[Item Spend]
,[VETTED]
,[LEAD TIME]
,[LOCATION]
,[PHYSICAL INVENTORY COUNTING PERIOD]
,[RECEIPT COUNT]
,[NAV SIM]
,[SIM Comments]
,[SIM Letter]
,[Lot Accumulation Period]
)

SELECT

s1.[Item] [ITEM]
,DESCRIPTION
,BUYER
,VENDOR
,[COMMODITY CODE]
,[COMMODITY CODE DESCRIPTION]
,[BUSINESS SEGMENT CODE]
,[SELECTION CODE]
,[SIGNAL CODE]
,s1.Nettable
,s1.Nettable * [Standard Cost]
,s1.NonNettable
,s1.NonNettable * [Standard Cost]
,[Qty On Order]
,[Dollars On Order]
,[SAFETY STOCK]
,s2.[Standard Cost]
,EAU
,P6
,F6
,[Item Spend]
,VETTED
,[LEAD TIME]
,LOCATION
,[PHYSICAL INVENTORY COUNTING PERIOD]
,ReceiptCount
,[NAV SIM]
,[SIM Comments]
,CASE
	WHEN SUM([Item Spend]) OVER (ORDER BY [Item Spend]) &lt;= .05 * SUM([Item Spend]) OVER () THEN 'C'
	WHEN (SUM([Item Spend]) OVER (ORDER BY [Item Spend]) &gt; .05 * SUM([Item Spend]) OVER ())
		AND (SUM([Item Spend]) OVER (ORDER BY [Item Spend]) &lt; .2  * SUM([Item Spend]) OVER ()) THEN 'B'
	WHEN SUM([Item Spend]) OVER (ORDER BY [Item Spend]) &gt;= .2 * SUM([Item Spend]) OVER () THEN 'A'
END [SIM Letter]
,[Lot Accumulation Period]

FROM s1 LEFT JOIN s2 ON s1.[Item] = s2.[Item]

LEFT JOIN sOrder ON s1.Item = sOrder.Item


--ORDER BY [Item Spend]




SELECT

l.ITEM
,DESCRIPTION
,BUYER
,VENDOR
,[COMMODITY CODE]
,COALESCE([COMMODITY CODE DESCRIPTION],'') [COMMODITY CODE DESCRIPTION]
,[BUSINESS SEGMENT CODE]
,[SELECTION CODE]
,[SIGNAL CODE]
,NETTABLE [QTY NETTABLE]
,[NETTABLE DOLLARS]
,COALESCE([QTY ON ORDER],0) [QTY ON ORDER]
,COALESCE([DOLLARS ON ORDER],'0.00')[DOLLARS ON ORDER]
,COALESCE([NONNETTABLE],0) [QTY NONNETTTABLE]
,COALESCE([NONNETTABLE DOLLARS],'0.00') [NONNETTABLE DOLLARS]
,[SAFETY STOCK]
,[Standard Cost] [STANDARD COST]
,EAU
,P6
,F6
,[Item Spend] [ITEM SPEND]
,VETTED [Vetted or Non-vetted]
,[LEAD TIME]
,LOCATION
,[PHYSICAL INVENTORY COUNTING PERIOD]
,COALESCE([RECEIPT COUNT],0) [RECEIPT COUNT]
,[NAV SIM] [NAV SIM CODE]
,[SIM Letter] + CAST([SIM Number] as varchar(1)) [SUGGESTED SIM CODE]
,CASE
	WHEN [SIM Letter] + CAST([SIM Number] as varchar(1)) != [NAV SIM] THEN 'Change'
	ELSE ''
END [CHANGE]
,[SIM Comments] [COMMENT]
,[Lot Accumulation Period]

FROM #TEMP t INNER JOIN #LETTER l ON t.[Item] = l.[Item] 

ORDER BY [ITEM SPEND]

--SELECT * FROM #TEMP

--DROP TABLE #TEMP;DROP TABLE #LETTER
--DROP TABLE #TEMP;DROP TABLE #LETTER</CommandText>
        <rd:UseGenericDesigner>true</rd:UseGenericDesigner>
      </Query>
