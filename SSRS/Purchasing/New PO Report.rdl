<?xml version="1.0" encoding="utf-8"?>
<Report MustUnderstand="df" xmlns="http://schemas.microsoft.com/sqlserver/reporting/2016/01/reportdefinition" xmlns:rd="http://schemas.microsoft.com/SQLServer/reporting/reportdesigner" xmlns:df="http://schemas.microsoft.com/sqlserver/reporting/2016/01/reportdefinition/defaultfontfamily">
  <df:DefaultFontFamily>Segoe UI</df:DefaultFontFamily>
  <AutoRefresh>0</AutoRefresh>
  <DataSources>
    <DataSource Name="NAV">
      <DataSourceReference>NAV</DataSourceReference>
      <rd:SecurityType>None</rd:SecurityType>
      <rd:DataSourceID>b100ec2f-f62a-4022-9bc5-0ddd03092437</rd:DataSourceID>
    </DataSource>
  </DataSources>
  <DataSets>
    <DataSet Name="DataSet1">
      <Query>
        <DataSourceName>NAV</DataSourceName>
        <QueryParameters>
          <QueryParameter Name="@startDate">
            <Value>=Parameters!startDate.Value</Value>
          </QueryParameter>
          <QueryParameter Name="@endDate">
            <Value>=Parameters!endDate.Value</Value>
          </QueryParameter>
        </QueryParameters>
        <CommandText>WITH s1 AS
(
	SELECT 
	
	SUM(Amount) DollarValue
	,COUNT([Document No_])  LineCount
	,[Document No_]
	,SUM(Quantity * [Direct Unit Cost])	[Qty x Cost]
	
	FROM [ZYGO$Purchase Line]

	WHERE [Document No_] IN 

	(SELECT No_ 
		FROM [ZYGO$Purchase Header]

		WHERE 
                                     [Document Date] &gt;= @startDate
                                     AND [Document Date] &lt;= @endDate

)

		GROUP BY [Document No_]
)
SELECT

No_ [PO #]
,[Document Date]
,[Purchaser Code]
,COALESCE(s1.LineCount,0) LineCount
,COALESCE(s1.DollarValue,0) DollarValue
,COALESCE ([Qty x Cost],0) [Qty x Direct Unit Cost]

FROM [ZYGO$Purchase Header] h

LEFT JOIN s1 ON h.No_ = s1.[Document No_]

WHERE

                                    [Document Date] &gt;= @startDate
                                     AND [Document Date] &lt;= @endDate

ORDER BY [PO #]</CommandText>
        <rd:UseGenericDesigner>true</rd:UseGenericDesigner>
      </Query>
      <Fields>
        <Field Name="PO__">
          <DataField>PO #</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Document_Date">
          <DataField>Document Date</DataField>
          <rd:TypeName>System.DateTime</rd:TypeName>
        </Field>
        <Field Name="Purchaser_Code">
          <DataField>Purchaser Code</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="LineCount">
          <DataField>LineCount</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
        <Field Name="DollarValue">
          <DataField>DollarValue</DataField>
          <rd:TypeName>System.Decimal</rd:TypeName>
        </Field>
        <Field Name="Qty_x_Direct_Unit_Cost">
          <DataField>Qty x Direct Unit Cost</DataField>
          <rd:TypeName>System.Decimal</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
  </DataSets>
