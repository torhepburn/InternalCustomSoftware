  <DataSources>
    <DataSource Name="AccessFrontEnds">
      <DataSourceReference>AccessFrontEnds</DataSourceReference>
      <rd:SecurityType>None</rd:SecurityType>
      <rd:DataSourceID>edb9c9bb-75c0-4311-8bcb-f01955765e0e</rd:DataSourceID>
    </DataSource>
  </DataSources>
  <DataSets>
    <DataSet Name="DataSet1">
      <Query>
        <DataSourceName>AccessFrontEnds</DataSourceName>
        <CommandText>select

s3.*
 ,s.KB1_Contract
 ,s.KB1_Contract_Start_Date
 ,s.KB1_Contract_End_Date
 ,s.KB1_Quantity
 ,s.KB1_LeadtimeInsufficient
 ,n.KB1_Contract_Note
 ,s.KB2_Contract
 ,s.KB2_Contract_Start_Date
 ,s.KB2_Contract_End_Date
 ,s.KB2_Quantity
 ,s.KB2_LeadtimeInsufficient
 ,LeadTime
 ,QualifiedLeadtime
 ,OrderDate


from KBs4 n

INNER JOIN KBs1 s ON s.ItemNo = n.item_id

INNER JOIN KBs3 s3 ON s.ItemNo = s3.No_

</CommandText>
        <rd:UseGenericDesigner>true</rd:UseGenericDesigner>
      </Query>
