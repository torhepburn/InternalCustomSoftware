<?xml version="1.0" encoding="utf-8"?>
<Report MustUnderstand="df" xmlns="http://schemas.microsoft.com/sqlserver/reporting/2016/01/reportdefinition" xmlns:rd="http://schemas.microsoft.com/SQLServer/reporting/reportdesigner" xmlns:df="http://schemas.microsoft.com/sqlserver/reporting/2016/01/reportdefinition/defaultfontfamily">
  <df:DefaultFontFamily>Segoe UI</df:DefaultFontFamily>
  <AutoRefresh>0</AutoRefresh>
  <DataSources>
    <DataSource Name="NAV">
      <DataSourceReference>NAV</DataSourceReference>
      <rd:SecurityType>None</rd:SecurityType>
      <rd:DataSourceID>146cb75a-e91e-4c32-98e9-83b70ae7fdc9</rd:DataSourceID>
    </DataSource>
    <DataSource Name="REFRESH">
      <ConnectionProperties>
        <DataProvider>SQL</DataProvider>
        <ConnectString>Data Source=PA-HOR-AS406;Initial Catalog=ZYGO-NAV-REFRESH</ConnectString>
      </ConnectionProperties>
      <rd:SecurityType>DataBase</rd:SecurityType>
      <rd:DataSourceID>2b5b21cf-28fe-46b4-8fde-36638c32b49d</rd:DataSourceID>
    </DataSource>
  </DataSources>
  <DataSets>
    <DataSet Name="DataSet1">
      <Query>
        <DataSourceName>REFRESH</DataSourceName>
        <CommandText>SELECT
 CASE [Action Message]
	WHEN 3 THEN 'Reschedule'
	WHEN 4 THEN '+Qty+Date'
	WHEN 5 THEN 'Cancel'
 END [Action Message]
,CONVERT(varchar(10),l.[Order Date], 1) [Order Date]
,CONVERT(varchar(10),[Original Due Date], 1) [Original Due Date]
,CONVERT(varchar(10),[Due Date], 1) [Due Date]
,FORMAT([Original Quantity],'N0', 'en-us') [Original Quantity]
,FORMAT([Remaining Quantity],'N0', 'en-us') [Order Quantity]
,FORMAT([Cost Amount], 'C', 'en-us') Cost
,l.[Location Code]
,l.[Bin Code]
,[Ref_ Order No_]
,SUBSTRING(CONVERT(varchar(10),[Ref_ Line No_]), 1, LEN([Ref_ Line No_])-3) [PO Line No_]
,l.No_ [Part Number]
,l.Description
, [Starting Date]
,CASE COALESCE(pl.[Best Delivery],0) 
                           WHEN 0 THEN '' 
                           WHEN 1 THEN 'YES' 
                        END Best
,l.[Buyer Planner Code]

FROM [ZYGO$Requisition Line] l

LEFT JOIN ZYGO$Item i on l.No_ = i.No_

LEFT JOIN [ZYGO$Purchase Line] pl 

ON l.[Ref_ Order No_] = pl.[Document No_]

AND l.[Ref_ Line No_] = pl.[Line No_]


WHERE

[Ref_ Order Type] = 1	--Purchase

AND l.[Replenishment System] = 0

and [Action Message] in (3,4) -- Reschedule, Reschedule and change quantity

AND [Worksheet Template Name] = 'PLANNING'

AND [Journal Batch Name] = 'DEFAULT'

AND [Best Delivery] = 1

AND [Remaining Quantity] &gt; 0</CommandText>
        <rd:UseGenericDesigner>true</rd:UseGenericDesigner>
      </Query>
      <Fields>
        <Field Name="Action_Message">
          <DataField>Action Message</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Order_Date">
          <DataField>Order Date</DataField>
          <rd:TypeName>System.String</rd:TypeName>
