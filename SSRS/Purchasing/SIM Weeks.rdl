<?xml version="1.0" encoding="utf-8"?>
<Report MustUnderstand="df" xmlns="http://schemas.microsoft.com/sqlserver/reporting/2016/01/reportdefinition" xmlns:rd="http://schemas.microsoft.com/SQLServer/reporting/reportdesigner" xmlns:df="http://schemas.microsoft.com/sqlserver/reporting/2016/01/reportdefinition/defaultfontfamily">
  <df:DefaultFontFamily>Segoe UI</df:DefaultFontFamily>
  <AutoRefresh>0</AutoRefresh>
  <DataSources>
    <DataSource Name="DataSource1">
      <ConnectionProperties>
        <DataProvider>SQL</DataProvider>
        <ConnectString>Data Source=pa-hor-as408;Initial Catalog=ZYGO-NAV-PROD</ConnectString>
      </ConnectionProperties>
      <rd:SecurityType>DataBase</rd:SecurityType>
      <rd:DataSourceID>ae8fc35f-0d6c-4848-a6cb-d9f48ff81f1d</rd:DataSourceID>
    </DataSource>
  </DataSources>
  <DataSets>
    <DataSet Name="DataSet1">
      <Query>
        <DataSourceName>DataSource1</DataSourceName>
        <QueryParameters>
          <QueryParameter Name="@item">
            <Value>=Parameters!ItemCode.Value</Value>
            <rd:UserDefined>true</rd:UserDefined>
          </QueryParameter>
        </QueryParameters>
        <CommandText>--DECLARE @item varchar(50)

--SET @item = '01-0723';

WITH s1 AS
(
SELECT

DATEPART(WEEK,[Posting Date]) [Week Number]
,[Item No_]
,SUM(Quantity) * -1 [Weekly Consumption]

FROM [ZYGO$Item Ledger Entry] ile

INNER JOIN ZYGO$Item i ON ile.[Item No_] = i.No_

WHERE [Posting Date] &gt;= GETDATE()-365

AND ([Entry Type] = 1 --Sale

OR [Entry Type] = 5) --Consumption

AND [Item No_] = @item

--AND SIM &gt; 0

GROUP BY DATEPART(WEEK,[Posting Date]), [Item No_]
),

 recurs AS 
 (
  SELECT
  [Week Number]
  ,[Item No_]
  ,CAST([Weekly Consumption] AS int) [Weekly Consumption]
    , 1 AS LEVEL
  FROM s1
  UNION ALL
  SELECT
  CAST('1' AS int)
  ,t1.[Item No_]
  ,0
  , LEVEL + 1
  FROM s1 t1
  INNER JOIN
  recurs t2
  ON t1.[Item No_] = t2.[Item No_]
  AND LEVEL &lt; 53
 )

SELECT TOP 53 *
FROM recurs</CommandText>
        <rd:UseGenericDesigner>true</rd:UseGenericDesigner>
      </Query>
      <Fields>
        <Field Name="Week_Number">
          <DataField>Week Number</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
        <Field Name="Item_No_">
          <DataField>Item No_</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Weekly_Consumption">
          <DataField>Weekly Consumption</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
        <Field Name="LEVEL">
          <DataField>LEVEL</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
  </DataSets>
