  <df:DefaultFontFamily>Segoe UI</df:DefaultFontFamily>
  <AutoRefresh>0</AutoRefresh>
  <DataSources>
    <DataSource Name="NAV">
      <DataSourceReference>NAV</DataSourceReference>
      <rd:SecurityType>None</rd:SecurityType>
      <rd:DataSourceID>4503eb79-ada1-4c8e-ac0a-319d111f95a7</rd:DataSourceID>
    </DataSource>
  </DataSources>
  <DataSets>
    <DataSet Name="DataSet1">
      <Query>
        <DataSourceName>NAV</DataSourceName>
        <CommandText>/* ==== SAFETY: start clean so temp tables aren't stale ==== */
IF OBJECT_ID('tempdb..#TEMP')   IS NOT NULL DROP TABLE #TEMP;
IF OBJECT_ID('tempdb..#LETTER') IS NOT NULL DROP TABLE #LETTER;
/* ======================================================== */

DECLARE @item varchar(50);

--DECLARE @vetted int
--SET @vetted = 0

SET DATEFIRST 1;

DECLARE @yearstart date;
DECLARE @weekstart date;

SET @yearstart = GETDATE() - 365;
SELECT @weekstart = DATEADD(week, DATEDIFF(week, 0, @yearstart), 0);

CREATE TABLE #Temp
(
    -- Option A: align temp-table key to database collation
    [Item] varchar(50) COLLATE DATABASE_DEFAULT,
    [Standard Deviation] decimal(38,6),
    [Average Consumption] decimal(38,6),

    /* MARK (1-NUM): computed SIM Number (1/2/3) from volatility (CoV) */
    [SIM Number] int,

    /* MARK (1-COV): coefficient of variation used to derive SIM Number */
    [CoV] decimal(38,6)
);

CREATE TABLE #LETTER
(
    -- Option A: align temp-table key to database collation
    [Item] varchar(50) COLLATE DATABASE_DEFAULT,

    [DESCRIPTION] varchar(60),
    [BUYER] varchar(30),
    [VENDOR] varchar(50),
    [COMMODITY CODE] varchar(10),
    [COMMODITY CODE DESCRIPTION] varchar(50),
    [BUSINESS SEGMENT CODE] varchar(50),
    [SELECTION CODE] varchar(10),
    [SIGNAL CODE] varchar(10),
    NETTABLE int,
    NONNETTABLE int,
    [NETTABLE DOLLARS] decimal(38,2),
    [NONNETTABLE DOLLARS] decimal(38,2),
    [QTY ON ORDER] int,
    [DOLLARS ON ORDER] decimal(38,2),
    [SAFETY STOCK] int,
    [Standard Cost] decimal(38,2),
    EAU int,
    P6 int,
    F6 int,
    [Item Spend] decimal(38,2),

    /* MARK (2-RIS): Revised Item Spend basis for letter assignment */
    [Revised Item Spend] decimal(38,2),

    [VETTED] varchar(10),
    [LEAD TIME] varchar(10),
    [LOCATION] varchar(50),
    [PHYSICAL INVENTORY COUNTING PERIOD] varchar(1),
    [RECEIPT COUNT] int,

    /* NAV SIM pulled from NAV for comparison &amp; fallback digit */
    [NAV SIM] varchar(2),

    [SIM Comments] varchar(250),

    /* MARK (3A-LTR): ABC based on Item Spend */
    [SIM Letter] varchar(1),

    /* MARK (3B-LTR-RIS): ABC based on Revised Item Spend (RIS) */
    [SIM Letter (RIS)] varchar(1),

    /* MARK (4-ASSEM): Suggested SIM Code built from RIS letter + number */
    [Suggested SIM Code (RIS)] varchar(3),

    [Lot Accumulation Period] varchar(10)
);

DECLARE simCursor CURSOR FOR
SELECT No_
FROM ZYGO$Item
WHERE (P6 &gt; 0 OR F6 &gt; 0)
  AND [Replenishment System] = 0;

OPEN simCursor;
FETCH NEXT FROM simCursor INTO @item;

WHILE @@FETCH_STATUS = 0
BEGIN
    WITH s1 AS
    (
        SELECT
            DATEPART(WEEK,[Posting Date]) AS [Week Number],
            [Item No_],
            SUM(Quantity) * -1 AS [Weekly Consumption]
        FROM [ZYGO$Item Ledger Entry] ile
        INNER JOIN ZYGO$Item i ON ile.[Item No_] = i.No_
        WHERE [Posting Date] &gt;= @weekstart
          AND ([Entry Type] = 1 OR [Entry Type] = 5)  -- Sale or Consumption
          AND [Item No_] = @item
        GROUP BY DATEPART(WEEK,[Posting Date]), [Item No_]
    ),
    s2r AS  -- recursive helper to add 53 weeks of zeros
    (
        SELECT [Week Number], [Item No_], CAST([Weekly Consumption] AS decimal) AS [Weekly Consumption], 1 AS LEVEL
        FROM s1
        UNION ALL
        SELECT CAST(1 AS int), t1.[Item No_], CAST(0 AS decimal), LEVEL + 1
        FROM s1 t1
        INNER JOIN s2r t2 ON t1.[Item No_] = t2.[Item No_] AND LEVEL &lt; 53
    ),
    s3 AS
    (
        SELECT TOP 53 * FROM s2r
    )
    /* MARK (1): Compute CoV &amp; SIM Number from 53-week window */
    INSERT INTO #TEMP
    (
        [Item], [Standard Deviation], [Average Consumption], [SIM Number], [CoV]
    )
    SELECT
        [Item No_],
        COALESCE(STDEV([Weekly Consumption]),0) AS [Standard Deviation],
        AVG([Weekly Consumption]) AS [Average Consumption],
        COALESCE(CASE
            WHEN COALESCE(AVG([Weekly Consumption]),0) &gt; 0 THEN
                CASE
                    WHEN COALESCE(STDEV([Weekly Consumption]),0)/AVG([Weekly Consumption]) = 0 THEN 3
                    WHEN COALESCE(STDEV([Weekly Consumption]),0)/AVG([Weekly Consumption]) &gt;= 2 THEN 3
                    WHEN COALESCE(STDEV([Weekly Consumption]),0)/AVG([Weekly Consumption]) &gt; 0
                         AND COALESCE(STDEV([Weekly Consumption]),0)/AVG([Weekly Consumption]) &lt; 1 THEN 2
                    WHEN COALESCE(STDEV([Weekly Consumption]),0)/AVG([Weekly Consumption]) &gt;= 1
                         AND COALESCE(STDEV([Weekly Consumption]),0)/AVG([Weekly Consumption]) &lt; 2 THEN 1
                END
        END,0) AS [SIM Number],
        COALESCE(CASE
            WHEN COALESCE(AVG([Weekly Consumption]),0) &gt; 0
            THEN COALESCE(STDEV([Weekly Consumption]),0)/AVG([Weekly Consumption])
        END,0) AS [CoV]
    FROM s3
    GROUP BY [Item No_];

    FETCH NEXT FROM simCursor INTO @item;
END

CLOSE simCursor;
DEALLOCATE simCursor;

WITH s1 AS
(
    /* MARK (A): Item-level aggregates (receipts, consumption, nettable splits) */
    SELECT
        [Item No_] AS [Item],
        SUM(CASE WHEN [Document Type] = 5 AND [Posting Date] &gt;= @weekstart THEN Quantity END) AS [ReceiptCount],
        SUM(CASE WHEN ([Entry Type] = 5 OR [Entry Type] = 1) AND [Posting Date] &gt;= @weekstart THEN Quantity * -1 END) AS [Item Consumption],
        SUM(CASE WHEN [Non-Nettable] = 0 THEN Quantity END) AS [Nettable],
        SUM(CASE WHEN [Non-Nettable] = 1 THEN Quantity END) AS [NonNettable]
    FROM [ZYGO$Item Ledger Entry] ile
    INNER JOIN ZYGO$Item i ON ile.[Item No_] = i.No_
    WHERE [Replenishment System] = 0
    GROUP BY [Item No_]
),
sOrder AS
(
    /* MARK (B): Open PO quantities &amp; dollars */
    SELECT
        i.No_ AS [Item],
        SUM(l.[Outstanding Quantity]) AS [Qty On Order],
        SUM(l.[Outstanding Amount])   AS [Dollars On Order]
    FROM [ZYGO$Purchase Line] l
    INNER JOIN [ZYGO$Item] i ON l.No_ = i.No_
    WHERE ([Replenishment System] = 0
       AND [Document Type] = 1
       AND [Outstanding Quantity] &gt; 0)
    GROUP BY i.No_
),
/* s2: enrich items with master data + compute Item Spend + RIS */
s2 AS
(
    SELECT
        s1.[Item],
        i.[Standard Cost],
        [Item Consumption] * [Standard Cost] AS [Item Spend],

        /* MARK (2): === Revised Item Spend (RIS) computed here === */
        CAST(
           CASE
               WHEN CAST(F6 AS DECIMAL(18,6)) &gt; CAST(P6 AS DECIMAL(18,6))
                AND CAST(P6 AS DECIMAL(18,6)) &gt; 0.5
                AND CAST(F6 AS DECIMAL(18,6)) &lt; 2 * CAST(P6 AS DECIMAL(18,6))
               THEN CAST(EAU AS DECIMAL(18,6)) * COALESCE(i.[Standard Cost], 0)
               ELSE CAST(F6 AS DECIMAL(18,6)) * 2 * COALESCE(i.[Standard Cost], 0)
           END
         AS DECIMAL(38,2)
        ) AS [Revised Item Spend],
        /* =================================================== */

        /* NAV SIM brought forward for comparison and fallback use */
        CASE i.SIM
            WHEN 0 THEN '0'  WHEN 1 THEN 'A1' WHEN 2 THEN 'A2' WHEN 3 THEN 'A3'
            WHEN 4 THEN 'B1' WHEN 5 THEN 'B2' WHEN 6 THEN 'B3'
            WHEN 7 THEN 'C1' WHEN 8 THEN 'C2' WHEN 9 THEN 'C3'
        END AS [NAV SIM],
        [Stock Location] AS [LOCATION],
        CASE Vetted WHEN 0 THEN 'Vetted' WHEN 1 THEN 'Not Vetted' END AS VETTED,
        [Buyer Planner Code] AS BUYER,
        COALESCE(v.Name,'') AS VENDOR,
        i.Description AS [DESCRIPTION],
        i.[Selection Code] AS [SELECTION CODE],
        i.[Signal Code] AS [SIGNAL CODE],
        i.Commodity AS [COMMODITY CODE],
        c.Description AS [COMMODITY CODE DESCRIPTION],
        i.[Global Dimension 2 Code] AS [BUSINESS SEGMENT CODE],
        i.[Phys Invt Counting Period Code] AS [PHYSICAL INVENTORY COUNTING PERIOD],
        COALESCE(CASE WHEN CHARINDEX(CHAR(3),i.[Lead Time Calculation]) &gt; 0
                      THEN REPLACE(i.[Lead Time Calculation], CHAR(3), 'WD') END,'') AS [LEAD TIME],
        CAST (i.[Safety Stock Quantity] as int) AS [SAFETY STOCK],
        s1.Nettable,
        s1.NonNettable,
        EAU,
        P6,
        F6,
        [Phys Invt Counting Period Code],
        [SIM Comments],
        CASE
           WHEN CHARINDEX(CHAR(3),[Lot Accumulation Period]) &gt; 0 THEN REPLACE([Lot Accumulation Period], CHAR(3), 'WD')
           WHEN CHARINDEX(CHAR(4),[Lot Accumulation Period]) &gt; 0 THEN REPLACE([Lot Accumulation Period], CHAR(4), 'W')
           WHEN CHARINDEX(CHAR(5),[Lot Accumulation Period]) &gt; 0 THEN REPLACE([Lot Accumulation Period], CHAR(5), 'M')
           WHEN CHARINDEX(CHAR(2),[Lot Accumulation Period]) &gt; 0 THEN REPLACE([Lot Accumulation Period], CHAR(2), 'D')
           WHEN LEN([Lot Accumulation Period]) = 0 THEN '0'
        END AS [Lot Accumulation Period]
    FROM ZYGO$Item i
    INNER JOIN s1 ON i.No_ = s1.[Item]
    LEFT JOIN [ZYGO$Vendor] v ON v.No_ = i.[Vendor No_]
    LEFT JOIN ZYGO$Commodity c ON i.Commodity = c.Code
),
/* sClass: calculate both SIM letters once, with window functions */
sClass AS
(
    SELECT
        s2.*,

        /* MARK (3A): Existing SIM Letter — ABC over Item Spend */
        CASE
            WHEN SUM(s2.[Item Spend]) OVER (ORDER BY s2.[Item Spend])
                 &lt;= 0.05 * SUM(s2.[Item Spend]) OVER () THEN 'C'
            WHEN SUM(s2.[Item Spend]) OVER (ORDER BY s2.[Item Spend])  &gt; 0.05 * SUM(s2.[Item Spend]) OVER ()
             AND SUM(s2.[Item Spend]) OVER (ORDER BY s2.[Item Spend])  &lt; 0.20 * SUM(s2.[Item Spend]) OVER () THEN 'B'
            WHEN SUM(s2.[Item Spend]) OVER (ORDER BY s2.[Item Spend])
                 &gt;= 0.20 * SUM(s2.[Item Spend]) OVER () THEN 'A'
        END AS [SIM Letter],

        /* MARK (3B): NEW — SIM Letter (RIS) — ABC over Revised Item Spend */
        CASE
            WHEN SUM(s2.[Revised Item Spend]) OVER (ORDER BY s2.[Revised Item Spend])
                 &lt;= 0.05 * SUM(s2.[Revised Item Spend]) OVER () THEN 'C'
            WHEN SUM(s2.[Revised Item Spend]) OVER (ORDER BY s2.[Revised Item Spend])  &gt; 0.05 * SUM(s2.[Revised Item Spend]) OVER ()
             AND SUM(s2.[Revised Item Spend]) OVER (ORDER BY s2.[Revised Item Spend])  &lt; 0.20 * SUM(s2.[Revised Item Spend]) OVER () THEN 'B'
            WHEN SUM(s2.[Revised Item Spend]) OVER (ORDER BY s2.[Revised Item Spend])
                 &gt;= 0.20 * SUM(s2.[Revised Item Spend]) OVER () THEN 'A'
        END AS [SIM Letter (RIS)]
    FROM s2
)

INSERT INTO #LETTER
(
    [ITEM],[DESCRIPTION],[BUYER],[VENDOR],
    [COMMODITY CODE],[COMMODITY CODE DESCRIPTION],
    [BUSINESS SEGMENT CODE],[SELECTION CODE],[SIGNAL CODE],
    NETTABLE,[NETTABLE DOLLARS],NONNETTABLE,[NONNETTABLE DOLLARS],
    [QTY ON ORDER],[DOLLARS ON ORDER],[SAFETY STOCK],[Standard Cost],
    EAU,P6,F6,[Item Spend],
    [Revised Item Spend],
    [VETTED],[LEAD TIME],[LOCATION],
    [PHYSICAL INVENTORY COUNTING PERIOD],[RECEIPT COUNT],
    [NAV SIM],[SIM Comments],
    [SIM Letter],
    [SIM Letter (RIS)],
    [Suggested SIM Code (RIS)],
    [Lot Accumulation Period]
)
SELECT
    s1.[Item] AS [ITEM],
    sc.[DESCRIPTION],
    sc.BUYER,
    sc.VENDOR,
    sc.[COMMODITY CODE],
    sc.[COMMODITY CODE DESCRIPTION],
    sc.[BUSINESS SEGMENT CODE],
    sc.[SELECTION CODE],
    sc.[SIGNAL CODE],
    s1.Nettable,
    s1.Nettable * sc.[Standard Cost] AS [NETTABLE DOLLARS],
    s1.NonNettable,
    s1.NonNettable * sc.[Standard Cost] AS [NONNETTABLE DOLLARS],
    sOrder.[Qty On Order],
    sOrder.[Dollars On Order],
    sc.[SAFETY STOCK],
    sc.[Standard Cost],
    sc.EAU,
    sc.P6,
    sc.F6,
    sc.[Item Spend],
    sc.[Revised Item Spend],
    sc.VETTED,
    sc.[LEAD TIME],
    sc.[LOCATION],
    sc.[PHYSICAL INVENTORY COUNTING PERIOD],
    s1.[ReceiptCount],
    sc.[NAV SIM],
    sc.[SIM Comments],

    /* pull SIM Letters from sClass */
    sc.[SIM Letter],
    sc.[SIM Letter (RIS)],

    /* MARK (4-PATCH): Suggested SIM Code (RIS)
       - If SIM Number = 0, use the digit from NAV SIM (e.g., A1 -&gt; 1).
       - Else, use SIM Number from #TEMP.
       - Always prefix with SIM Letter (RIS). */
    CASE
        WHEN ISNULL(tSim.[SIM Number], 0) = 0 THEN
            sc.[SIM Letter (RIS)]
            + CASE
                WHEN TRY_CONVERT(int, RIGHT(sc.[NAV SIM], 1)) IS NOT NULL
                THEN RIGHT(sc.[NAV SIM], 1)
                ELSE '0'  -- NAV SIM '0' or malformed; safe fallback
              END
        ELSE
            sc.[SIM Letter (RIS)]
            + CAST(tSim.[SIM Number] AS varchar(1))
    END AS [Suggested SIM Code (RIS)],

    sc.[Lot Accumulation Period]
FROM s1
LEFT JOIN sClass sc ON s1.[Item] = sc.[Item]
LEFT JOIN sOrder    ON s1.Item   = sOrder.Item

/* ===== Patch 1: collate both operands in this join ===== */
LEFT JOIN #TEMP tSim
  ON tSim.[Item] COLLATE DATABASE_DEFAULT
   = s1.[Item]  COLLATE DATABASE_DEFAULT;

/* ======== REPORTING / PRESENTATION ======== */
SELECT
    l.ITEM,
    l.[DESCRIPTION],
    l.BUYER,
    l.VENDOR,
    l.[COMMODITY CODE],
    COALESCE(l.[COMMODITY CODE DESCRIPTION],'') AS [COMMODITY CODE DESCRIPTION],
    l.[BUSINESS SEGMENT CODE],
    l.[SELECTION CODE],
    l.[SIGNAL CODE],
    l.NETTABLE AS [QTY NETTABLE],
    l.[NETTABLE DOLLARS],
    COALESCE(l.[QTY ON ORDER],0) AS [QTY ON ORDER],
    COALESCE(l.[DOLLARS ON ORDER],'0.00') AS [DOLLARS ON ORDER],
    COALESCE(l.[NONNETTABLE],0) AS [QTY NONNETTTABLE],
    COALESCE(l.[NONNETTABLE DOLLARS],'0.00') AS [NONNETTABLE DOLLARS],
    l.[SAFETY STOCK],
    l.[Standard Cost] AS [STANDARD COST],
    l.EAU,
    l.P6,
    l.F6,
    l.[Item Spend]          AS [ITEM SPEND (IS)],
    l.[Revised Item Spend]  AS [REVISED ITEM SPEND (RIS)],
    l.VETTED AS [Vetted or Non Vetted],
    l.[LEAD TIME] AS [LEAD TIME],
    l.[LOCATION] AS [LOCATION],
    l.[PHYSICAL INVENTORY COUNTING PERIOD] AS [PHYSICAL INVENTORY COUNTING PERIOD],
    --l.[ReceiptCount] AS [ReceiptCount],
 
    /* MARK (3A-OUT): Both SIM letters side-by-side */
    l.[SIM Letter]          AS [SIM LETTER (IS)],
    l.[SIM Letter (RIS)]    AS [SIM LETTER (RIS)],

    l.[NAV SIM] [NAV SIM CODE],

    /* Original Suggested SIM Code (Item Spend-based) still available */
    l.[SIM Letter] + CAST(t.[SIM Number] AS varchar(1)) AS [SUGGESTED SIM CODE (IS)],

    /* MARK (4-OUT): RIS-based suggested code (now with fallback) */
    l.[SUGGESTED SIM CODE (RIS)],
 
    /* Change flag if RIS-based suggestion differs from current NAV SIM */
    CASE WHEN l.[Suggested SIM Code (RIS)] != l.[NAV SIM] THEN 'Change' ELSE '' END AS [CHANGE],

    l.[SIM Comments] AS [COMMENT],
    l.[Lot Accumulation Period]
FROM #TEMP t

/* ===== Patch 2: collate both operands in this join ===== */
INNER JOIN #LETTER l
  ON t.[Item] COLLATE DATABASE_DEFAULT
   = l.[Item] COLLATE DATABASE_DEFAULT

ORDER BY [REVISED ITEM SPEND] DESC;

/* ==== SAFETY: teardown so next run starts fresh ==== */
IF OBJECT_ID('tempdb..#TEMP')   IS NOT NULL DROP TABLE #TEMP;
IF OBJECT_ID('tempdb..#LETTER') IS NOT NULL DROP TABLE #LETTER;</CommandText>
        <rd:UseGenericDesigner>true</rd:UseGenericDesigner>
      </Query>
      <Fields>
        <Field Name="ITEM">
          <DataField>ITEM</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="DESCRIPTION">
          <DataField>DESCRIPTION</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="BUYER">
          <DataField>BUYER</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="VENDOR">
          <DataField>VENDOR</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="COMMODITY_CODE">
          <DataField>COMMODITY CODE</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="COMMODITY_CODE_DESCRIPTION">
          <DataField>COMMODITY CODE DESCRIPTION</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="BUSINESS_SEGMENT_CODE">
          <DataField>BUSINESS SEGMENT CODE</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="SELECTION_CODE">
          <DataField>SELECTION CODE</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="SIGNAL_CODE">
          <DataField>SIGNAL CODE</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="QTY_NETTABLE">
          <DataField>QTY NETTABLE</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
        <Field Name="NETTABLE_DOLLARS">
          <DataField>NETTABLE DOLLARS</DataField>
          <rd:TypeName>System.Decimal</rd:TypeName>
        </Field>
        <Field Name="QTY_ON_ORDER">
          <DataField>QTY ON ORDER</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
        <Field Name="DOLLARS_ON_ORDER">
          <DataField>DOLLARS ON ORDER</DataField>
          <rd:TypeName>System.Decimal</rd:TypeName>
        </Field>
        <Field Name="QTY_NONNETTTABLE">
          <DataField>QTY NONNETTTABLE</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
        <Field Name="NONNETTABLE_DOLLARS">
          <DataField>NONNETTABLE DOLLARS</DataField>
          <rd:TypeName>System.Decimal</rd:TypeName>
        </Field>
        <Field Name="SAFETY_STOCK">
          <DataField>SAFETY STOCK</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
        <Field Name="STANDARD_COST">
          <DataField>STANDARD COST</DataField>
          <rd:TypeName>System.Decimal</rd:TypeName>
        </Field>
        <Field Name="EAU">
          <DataField>EAU</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
        <Field Name="P6">
          <DataField>P6</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
        <Field Name="F6">
          <DataField>F6</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
        <Field Name="ITEM_SPEND__IS_">
          <DataField>ITEM SPEND (IS)</DataField>
          <rd:TypeName>System.Decimal</rd:TypeName>
        </Field>
        <Field Name="REVISED_ITEM_SPEND__RIS_">
          <DataField>REVISED ITEM SPEND (RIS)</DataField>
          <rd:TypeName>System.Decimal</rd:TypeName>
        </Field>
        <Field Name="Vetted_or_Non_Vetted">
          <DataField>Vetted or Non Vetted</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="LEAD_TIME">
          <DataField>LEAD TIME</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="LOCATION">
          <DataField>LOCATION</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="PHYSICAL_INVENTORY_COUNTING_PERIOD">
          <DataField>PHYSICAL INVENTORY COUNTING PERIOD</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="SIM_LETTER__IS_">
          <DataField>SIM LETTER (IS)</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="SIM_LETTER__RIS_">
          <DataField>SIM LETTER (RIS)</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="NAV_SIM_CODE">
          <DataField>NAV SIM CODE</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="SUGGESTED_SIM_CODE__IS_">
          <DataField>SUGGESTED SIM CODE (IS)</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="SUGGESTED_SIM_CODE__RIS_">
          <DataField>SUGGESTED SIM CODE (RIS)</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="CHANGE">
          <DataField>CHANGE</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="COMMENT">
          <DataField>COMMENT</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Lot_Accumulation_Period">
          <DataField>Lot Accumulation Period</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
  </DataSets>
  <ReportSections>
    <ReportSection>
      <Body>
        <ReportItems>
          <Textbox Name="textbox1">
            <CanGrow>true</CanGrow>
            <KeepTogether>true</KeepTogether>
            <Paragraphs>
              <Paragraph>
                <TextRuns>
                  <TextRun>
                    <Value>SIM All Items-Forward Look</Value>
                    <Style>
                      <FontFamily>Segoe UI Light</FontFamily>
                      <FontSize>24pt</FontSize>
                      <FontWeight>Bold</FontWeight>
                    </Style>
                  </TextRun>
                </TextRuns>
                <Style />
              </Paragraph>
            </Paragraphs>
            <rd:DefaultName>textbox1</rd:DefaultName>
            <Height>0.43in</Height>
            <Width>34in</Width>
            <Style>
              <PaddingLeft>2pt</PaddingLeft>
              <PaddingRight>2pt</PaddingRight>
              <PaddingTop>2pt</PaddingTop>
              <PaddingBottom>2pt</PaddingBottom>
            </Style>
