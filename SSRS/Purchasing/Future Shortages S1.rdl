        </Field>
        <Field Name="Business_Segment">
          <DataField>Business Segment</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Qty_on_PO">
          <DataField>Qty on PO</DataField>
          <rd:TypeName>System.Decimal</rd:TypeName>
        </Field>
        <Field Name="Qty_on_Production_Order">
          <DataField>Qty on Production Order</DataField>
          <rd:TypeName>System.Decimal</rd:TypeName>
        </Field>
        <Field Name="Qty_on_SO">
          <DataField>Qty on SO</DataField>
          <rd:TypeName>System.Decimal</rd:TypeName>
        </Field>
        <Field Name="Qty_on_Inventory_Request">
          <DataField>Qty on Inventory Request</DataField>
          <rd:TypeName>System.Decimal</rd:TypeName>
        </Field>
        <Field Name="Qty_on_Service_Order">
          <DataField>Qty on Service Order</DataField>
          <rd:TypeName>System.Decimal</rd:TypeName>
        </Field>
        <Field Name="Standard_Cost">
          <DataField>Standard Cost</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Qty_on_hand_nettable_x_Standard_Cost">
          <DataField>Qty on hand nettable x Standard Cost</DataField>
          <rd:TypeName>System.Decimal</rd:TypeName>
        </Field>
        <Field Name="Buyer_Planner_Code">
          <DataField>Buyer Planner Code</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Vetted">
          <DataField>Vetted</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
  </DataSets>
