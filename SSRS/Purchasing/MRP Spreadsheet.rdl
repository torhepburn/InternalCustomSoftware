<?xml version="1.0" encoding="utf-8"?>
<Report MustUnderstand="df" xmlns="http://schemas.microsoft.com/sqlserver/reporting/2016/01/reportdefinition" xmlns:rd="http://schemas.microsoft.com/SQLServer/reporting/reportdesigner" xmlns:df="http://schemas.microsoft.com/sqlserver/reporting/2016/01/reportdefinition/defaultfontfamily">
  <df:DefaultFontFamily>Segoe UI</df:DefaultFontFamily>
  <AutoRefresh>0</AutoRefresh>
  <DataSources>
    <DataSource Name="NAV">
      <DataSourceReference>NAV</DataSourceReference>
      <rd:SecurityType>None</rd:SecurityType>
      <rd:DataSourceID>c67e3c77-2989-425e-95bd-5b3ee1066de8</rd:DataSourceID>
    </DataSource>
  </DataSources>
  <DataSets>
    <DataSet Name="DataSet1">
      <Query>
        <DataSourceName>NAV</DataSourceName>
        <CommandText>/*
             *  Get the list of MRP purchased parts for which reports are needed 
             *  use all worksheets 
             *  [Ref_ Order Type] = 1 = Purchase
             *  Type = 2 = Item
  
 */

 CREATE TABLE #ItemDelivery
(
 [No_] nvarchar(20)
,[Text] nvarchar(500)
)

declare @item varchar(30)
declare @text varchar(100)
declare @salesText varchar(500)
SET @salesText = ''

declare itemCursor Cursor for 

select distinct r.[No_] FROM [ZYGO$Requisition Line] r

left join ZYGO$Item i on r.No_ = i.No_ 

WHERE 

0=0

AND r.[Ref_ Order Type] = 1

AND r.Type = 2

AND i.[Replenishment System] = 0

AND r.[Worksheet Template Name] = 'PLANNING'

AND r.[Journal Batch Name] = 'DEFAULT'

--AND r.Quantity &gt; r.[Original Quantity]	/**/

AND i.[Selection Code] not like 'K%'

AND i.[Selection Code] not like 'CFM%'

AND [Action Message] IN (1)

--AND i.No_ &lt;&gt; 'SERVICE ITEM'


order by [No_]

open itemCursor

fetch next from itemCursor into @item

while @@FETCH_STATUS = 0
begin

declare textCursor Cursor for 

SELECT FORMAT(Quantity,'####') + '  for '+ FORMAT([Due Date],'MM/dd/yy') FROM [ZYGO$Requisition Line]

WHERE No_ = @item

ORDER BY [Due Date]

OPEN textCursor

fetch next from textCursor into @text

while @@FETCH_STATUS = 0
begin

	
	SET @salesText = @salesText + ', ' +  @text

	
	
fetch next from textCursor into @text	
end

close textCursor
deallocate textCursor

INSERT INTO #ItemDelivery (No_, Text) SELECT @item, SUBSTRING(@salesText,2, (LEN(@salesText) - 1))

SET @salesText = ''
	
fetch next from itemCursor into  @item


end
close itemCursor
deallocate itemCursor;


WITH s1 AS
(
select 

distinct 

r.No_
,r.[Buyer Planner Code]
,r.[Vendor No_]
--,i.[Stock Location]
--,r.[Location Code]

from [ZYGO$Requisition Line] r

left join ZYGO$Item i on r.No_ = i.No_ 

WHERE 

0=0

AND r.[Ref_ Order Type] = 1

AND r.Type = 2

AND i.[Replenishment System] = 0

AND r.[Worksheet Template Name] = 'PLANNING'

AND r.[Journal Batch Name] = 'DEFAULT'

--AND r.Quantity &gt; r.[Original Quantity]	/**/

AND i.[Selection Code] not like 'K%'

AND i.[Selection Code] not like 'CFM%'

AND [Action Message] IN (1)

--AND i.No_ &lt;&gt; 'SERVICE ITEM'



/* specific to main	*/

--AND i.[Selection Code] &lt;&gt; 'MMX'

--AND i.Vetted &lt;&gt; '1'

AND i.[Item Group Code] &lt;&gt; 'VMI'

--AND CHARINDEX('X', r.No_, 1) &lt;&gt; 1

--AND [Reference Component] &lt;&gt; 1

AND r.[Starting Date] &lt; (GETDATE() + 15)

--AND i.[Stock Location] NOT IN ('IRV','IRV MRB', 'RIC', 'RIC MRB')

)
,s2 AS
(
	SELECT

	s1.No_
	,SUM(Quantity) Quantity

	FROM [ZYGO$Requisition Line] l INNER JOIN s1 ON s1.No_ = l.No_

	GROUP BY s1.No_
)

SELECT

s1.[Buyer Planner Code]
, s1.[Vendor No_]
,COALESCE(v.Name,'') Vendor
,s1.No_
,i.Description
,i.[Revision Level]
,s2.Quantity
,'' [New Price]
,CASE  WHEN LEN(i.[Lead Time Calculation]) = 0 THEN '0'
      WHEN CHARINDEX(CHAR(3),i.[Lead Time Calculation]) &gt; 0
           THEN REPLACE(i.[Lead Time Calculation], CHAR(3), '')
    WHEN CHARINDEX(CHAR(4),i.[Lead Time Calculation]) &gt; 0 THEN   --week 
       REPLACE(i.[Lead Time Calculation], CHAR(4), '') * 5       --convert to days 
    WHEN CHARINDEX(CHAR(5),i.[Lead Time Calculation]) &gt; 0 THEN  --month 
       REPLACE(i.[Lead Time Calculation], CHAR(5), '') * 20	    --convert to days 
   WHEN CHARINDEX(CHAR(2),i.[Lead Time Calculation]) &gt; 0 THEN   -- days 
       REPLACE(i.[Lead Time Calculation], CHAR(2), '')		
END [Lead Time Calculation]
,[Last Direct Cost] [Last Purchase Price]
,Text [Requested Delivery]
,''Comments


FROM s1 LEFT JOIN ZYGO$Item i ON s1.No_ = i.No_

LEFT JOIN s2 ON s1.No_ = s2.No_

LEFT JOIN ZYGO$Vendor v ON s1.[Vendor No_] = v.No_

LEFT JOIN #ItemDelivery d ON  d.No_ = s1.No_ COLLATE DATABASE_DEFAULT


ORDER BY

[Buyer Planner Code]
,[Vendor No_]
,s1.No_

--DROP TABLE #ItemDelivery</CommandText>
        <rd:UseGenericDesigner>true</rd:UseGenericDesigner>
      </Query>
