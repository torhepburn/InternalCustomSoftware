<?xml version="1.0" encoding="utf-8"?>
<Report MustUnderstand="df" xmlns="http://schemas.microsoft.com/sqlserver/reporting/2016/01/reportdefinition" xmlns:rd="http://schemas.microsoft.com/SQLServer/reporting/reportdesigner" xmlns:df="http://schemas.microsoft.com/sqlserver/reporting/2016/01/reportdefinition/defaultfontfamily">
  <df:DefaultFontFamily>Segoe UI</df:DefaultFontFamily>
  <AutoRefresh>0</AutoRefresh>
  <DataSources>
    <DataSource Name="DataSource1">
      <ConnectionProperties>
        <DataProvider>SQL</DataProvider>
        <ConnectString>Data Source=pa-hor-as408;Initial Catalog=ZYGO-NAV-PROD</ConnectString>
      </ConnectionProperties>
      <rd:SecurityType>DataBase</rd:SecurityType>
      <rd:DataSourceID>d0592c6e-6f35-4486-9ced-2d1c9ce5f502</rd:DataSourceID>
    </DataSource>
  </DataSources>
  <DataSets>
    <DataSet Name="DataSet1">
      <Query>
        <DataSourceName>DataSource1</DataSourceName>
        <CommandText>WITH s1 AS
(
	SELECT 

	r.[Prod_ Order No_]
	,r.[Routing No_] [Parent Item Number]
	,p.[Description] [Parent Item Description]
	,p.[Remaining Quantity] [Parent Item Remaining Quantity]
	,r.[Description]
	
	,r.[Ending Date] [Prod Order Ending Date]
	,l.[Document No_]
	,l.[Expected Receipt Date]
	,l.[Outstanding Quantity]
	


	FROM [ZYGO$Prod_ Order Routing Line] r

	LEFT JOIN [ZYGO$Purchase Line] l ON r.[Prod_ Order No_] = l.[Prod_ Order No_]

	LEFT JOIN [ZYGO$Prod_ Order Line] p ON r.[Prod_ Order No_] = p.[Prod_ Order No_]

	WHERE r.[Status] = 3

	AND LEFT (r.Description, 8) = 'Subcontr'

	AND p.[Remaining Quantity] &gt; 0
)

select * from s1 WHERE [Document No_] is null</CommandText>
        <rd:UseGenericDesigner>true</rd:UseGenericDesigner>
      </Query>
      <Fields>
        <Field Name="Prod__Order_No_">
          <DataField>Prod_ Order No_</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Parent_Item_Number">
          <DataField>Parent Item Number</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Parent_Item_Description">
          <DataField>Parent Item Description</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Parent_Item_Remaining_Quantity">
          <DataField>Parent Item Remaining Quantity</DataField>
          <rd:TypeName>System.Decimal</rd:TypeName>
        </Field>
        <Field Name="Description">
          <DataField>Description</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Prod_Order_Ending_Date">
          <DataField>Prod Order Ending Date</DataField>
          <rd:TypeName>System.DateTime</rd:TypeName>
        </Field>
        <Field Name="Document_No_">
          <DataField>Document No_</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Expected_Receipt_Date">
          <DataField>Expected Receipt Date</DataField>
          <rd:TypeName>System.DateTime</rd:TypeName>
        </Field>
        <Field Name="Outstanding_Quantity">
          <DataField>Outstanding Quantity</DataField>
          <rd:TypeName>System.Decimal</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
  </DataSets>
