<?xml version="1.0" encoding="utf-8"?>
<Report MustUnderstand="df" xmlns="http://schemas.microsoft.com/sqlserver/reporting/2016/01/reportdefinition" xmlns:rd="http://schemas.microsoft.com/SQLServer/reporting/reportdesigner" xmlns:df="http://schemas.microsoft.com/sqlserver/reporting/2016/01/reportdefinition/defaultfontfamily">
  <df:DefaultFontFamily>Segoe UI</df:DefaultFontFamily>
  <AutoRefresh>0</AutoRefresh>
  <DataSources>
    <DataSource Name="DataSource1">
      <DataSourceReference>NAV</DataSourceReference>
      <rd:SecurityType>DataBase</rd:SecurityType>
      <rd:DataSourceID>eb6bb55b-8c23-4a9b-85a8-9d1c006e15d9</rd:DataSourceID>
    </DataSource>
  </DataSources>
  <DataSets>
    <DataSet Name="DataSet1">
      <Query>
        <DataSourceName>DataSource1</DataSourceName>
        <QueryParameters>
          <QueryParameter Name="@vetted">
            <Value>=Parameters!vetted.Value</Value>
          </QueryParameter>
        </QueryParameters>
        <CommandText>WITH s1 AS
(
SELECT 

[Item No_]
,SUM(Quantity * [Standard Cost]) InventoryValue
,CASE i.SIM 
	WHEN 0 THEN '0'
	WHEN 1 THEN 'A1'
	WHEN 2 THEN 'A2'
	WHEN 3 THEN 'A3'
	WHEN 4 THEN 'B1'
	WHEN 5 THEN 'B2'
	WHEN 6 THEN 'B3'
	WHEN 7 THEN 'C1'
	WHEN 8 THEN 'C2'
	WHEN 9 THEN 'C3'
END [SIM]

,COALESCE(SUM( 
	CASE
	WHEN [Non-Nettable] = 0 
	THEN Quantity
	END ),0) * [Standard Cost] [ON HAND Balance]
,COALESCE(SUM( 
	CASE
	WHEN [Non-Nettable] = 1 AND [Location Code] LIKE '%MRB%'
	THEN Quantity
	END ),0) * [Standard Cost] [MRB Balance]
,COALESCE(SUM( 
	CASE
	WHEN [Non-Nettable] = 1 AND [Location Code] LIKE '%SVC%'
	THEN Quantity
	END ),0) * [Standard Cost] [SVC Balance]



FROM [ZYGO$Item Ledger Entry] ile LEFT JOIN ZYGO$Item i ON ile.[Item No_] = i.No_

WHERE 

Vetted = @vetted

and [Replenishment System] = 0

GROUP BY [Item No_], [Standard Cost], SIM
)


SELECT

SIM
,COUNT(SIM) Parts
,SUM([InventoryValue]) [SIM Inventory]
,SUM([ON HAND Balance]) [SIM OH]
,SUM([MRB Balance]) [SIM MRB]
,SUM([SVC Balance]) [SIM SVC]

,LEFT(SIM,1) [SIM GROUP]

FROM s1

GROUP BY SIM;</CommandText>
        <rd:UseGenericDesigner>true</rd:UseGenericDesigner>
      </Query>
      <Fields>
        <Field Name="SIM">
          <DataField>SIM</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Parts">
          <DataField>Parts</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
        <Field Name="SIM_Inventory">
          <DataField>SIM Inventory</DataField>
          <rd:TypeName>System.Decimal</rd:TypeName>
        </Field>
        <Field Name="SIM_OH">
          <DataField>SIM OH</DataField>
          <rd:TypeName>System.Decimal</rd:TypeName>
        </Field>
        <Field Name="SIM_MRB">
          <DataField>SIM MRB</DataField>
          <rd:TypeName>System.Decimal</rd:TypeName>
        </Field>
        <Field Name="SIM_SVC">
          <DataField>SIM SVC</DataField>
          <rd:TypeName>System.Decimal</rd:TypeName>
        </Field>
        <Field Name="SIM_GROUP">
          <DataField>SIM GROUP</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
  </DataSets>
