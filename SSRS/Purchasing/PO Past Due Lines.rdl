<?xml version="1.0" encoding="utf-8"?>
<Report MustUnderstand="df" xmlns="http://schemas.microsoft.com/sqlserver/reporting/2016/01/reportdefinition" xmlns:rd="http://schemas.microsoft.com/SQLServer/reporting/reportdesigner" xmlns:df="http://schemas.microsoft.com/sqlserver/reporting/2016/01/reportdefinition/defaultfontfamily">
  <df:DefaultFontFamily>Segoe UI</df:DefaultFontFamily>
  <AutoRefresh>0</AutoRefresh>
  <DataSources>
    <DataSource Name="NAV">
      <DataSourceReference>NAV</DataSourceReference>
      <rd:SecurityType>None</rd:SecurityType>
      <rd:DataSourceID>7eb769cd-669a-49e5-93fc-3a6b92f6006e</rd:DataSourceID>
    </DataSource>
  </DataSources>
  <DataSets>
    <DataSet Name="DataSet1">
      <Query>
        <DataSourceName>NAV</DataSourceName>
        <CommandText>SELECT


 CASE 
	WHEN LEN(ph.[Purchaser Code]) &gt; 0 THEN ph.[Purchaser Code]
	ELSE ' No Purchaser'
 END [Purchaser Code]
,ph.[Pay-to Name] Vendor
,pl.[Document No_] [Order]
,pl.[PO Line No_]
,pl.No_ Item
,pl.Description
,pl.Quantity
,pl.[Quantity Received]
,pl.[Outstanding Quantity]
,pl.[Outstanding Amount]
,ph.[Document Date]
,pl.[Requested Receipt Date]
,pl.[Promised Receipt Date]
,pl.[Planned Receipt Date]
,DATEDIFF(dd,pl.[Requested Receipt Date],CAST(GETDATE() as date)) [Days Late]
,pl.[Location Code]
,ph.[Deliver To]

FROM [ZYGO$Purchase Line] pl

INNER JOIN [ZYGO$Purchase Header] ph ON ph.No_ = pl.[Document No_]

WHERE

[Outstanding Quantity] &lt;&gt; 0

AND [Planned Receipt Date] &lt;  DATEADD(week,1,CAST(GETDATE()-1 as date))  --Monday past due

AND ph.[Document Type] IN (1,5)  --1= order, 5 = return order

ORDER BY [Purchaser Code]</CommandText>
        <rd:UseGenericDesigner>true</rd:UseGenericDesigner>
      </Query>
      <Fields>
