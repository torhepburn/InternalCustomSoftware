  <DataSets>
    <DataSet Name="DataSet1">
      <Query>
        <DataSourceName>DataSource1</DataSourceName>
        <QueryParameters>
          <QueryParameter Name="@Itemcode">
            <Value>=Parameters!ItemCode.Value</Value>
            <rd:UserDefined>true</rd:UserDefined>
          </QueryParameter>
        </QueryParameters>
        <CommandText>SELECT

ItemCode
,Description
,QtyNeeded
,DateAddedtoList
,WhoAdded
,Supplier
,DateArchived
,ID

FROM shortage_list

WHERE  ItemCode = @Itemcode</CommandText>
