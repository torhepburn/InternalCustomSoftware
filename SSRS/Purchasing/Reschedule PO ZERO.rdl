<?xml version="1.0" encoding="utf-8"?>
<Report MustUnderstand="df" xmlns="http://schemas.microsoft.com/sqlserver/reporting/2016/01/reportdefinition" xmlns:rd="http://schemas.microsoft.com/SQLServer/reporting/reportdesigner" xmlns:df="http://schemas.microsoft.com/sqlserver/reporting/2016/01/reportdefinition/defaultfontfamily">
  <df:DefaultFontFamily>Segoe UI</df:DefaultFontFamily>
  <AutoRefresh>0</AutoRefresh>
  <DataSources>
    <DataSource Name="AccessFrontEnds">
      <DataSourceReference>AccessFrontEnds</DataSourceReference>
      <rd:SecurityType>None</rd:SecurityType>
      <rd:DataSourceID>e2b86a17-9aee-4bb3-a500-3ee58d6250b0</rd:DataSourceID>
    </DataSource>
    <DataSource Name="DataSource1">
      <ConnectionProperties>
        <DataProvider>SQL</DataProvider>
        <ConnectString>Data Source=pa-hor-as408;Initial Catalog=ZYGO-NAV-PROD</ConnectString>
      </ConnectionProperties>
      <rd:SecurityType>DataBase</rd:SecurityType>
      <rd:DataSourceID>b4ea30c3-bb16-4a2d-97ac-9f7244fadaaf</rd:DataSourceID>
    </DataSource>
  </DataSources>
  <DataSets>
    <DataSet Name="DataSet1">
      <Query>
        <DataSourceName>AccessFrontEnds</DataSourceName>
        <CommandText>WITH s1 AS
(
select Item from MRPresched1

where document not like 'PRIR%'
              
AND DueDate &lt;= '2023-06-30'
)
,s2 AS
(
select DISTINCT m.* from MRPresched1 m

INNER JOIN s1 ON m.Item = s1.Item

WHERE MONTH(DueDate) &lt;&gt; MONTH(RescheduleDate)

AND Document not like '%Resched IN%'
)

select

s2.*
,DATEDIFF(dd,DueDate, rescheduleDate) PushoutDays

FROM s2

--WHERE DATEDIFF(dd,DueDate, rescheduleDate) &gt;30

Order by item, duedate</CommandText>
        <rd:UseGenericDesigner>true</rd:UseGenericDesigner>
      </Query>
      <Fields>
        <Field Name="Item">
          <DataField>Item</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Document">
          <DataField>Document</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="POLine">
          <DataField>POLine</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
        <Field Name="Quantity">
          <DataField>Quantity</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
        <Field Name="DueDate">
          <DataField>DueDate</DataField>
          <rd:TypeName>System.DateTime</rd:TypeName>
        </Field>
        <Field Name="rescheduleDate">
          <DataField>rescheduleDate</DataField>
          <rd:TypeName>System.DateTime</rd:TypeName>
        </Field>
        <Field Name="Buyer">
          <DataField>Buyer</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Vendor">
