        </Field>
        <Field Name="Value">
          <DataField>Value</DataField>
          <rd:TypeName>System.Decimal</rd:TypeName>
        </Field>
        <Field Name="TwoWeekUSE">
          <DataField>TwoWeekUSE</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
        <Field Name="StockLocation">
          <DataField>StockLocation</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="SIM">
          <DataField>SIM</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="PushoutDays">
          <DataField>PushoutDays</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
