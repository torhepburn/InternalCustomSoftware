<?xml version="1.0" encoding="utf-8"?>
<Report MustUnderstand="df" xmlns="http://schemas.microsoft.com/sqlserver/reporting/2016/01/reportdefinition" xmlns:rd="http://schemas.microsoft.com/SQLServer/reporting/reportdesigner" xmlns:df="http://schemas.microsoft.com/sqlserver/reporting/2016/01/reportdefinition/defaultfontfamily">
  <df:DefaultFontFamily>Segoe UI</df:DefaultFontFamily>
  <AutoRefresh>0</AutoRefresh>
  <DataSources>
    <DataSource Name="DataSource1">
      <ConnectionProperties>
        <DataProvider>SQL</DataProvider>
        <ConnectString>Data Source=pa-hor-as408;Initial Catalog=ZYGO-NAV-PROD</ConnectString>
      </ConnectionProperties>
      <rd:SecurityType>DataBase</rd:SecurityType>
      <rd:DataSourceID>1acf013d-845b-40af-a6e3-cf4d4764ffe3</rd:DataSourceID>
    </DataSource>
  </DataSources>
  <DataSets>
    <DataSet Name="DataSet1">
      <Query>
        <DataSourceName>DataSource1</DataSourceName>
        <CommandText>
SET DATEFIRST 1;

DECLARE @startdate date
DECLARE @enddate date

set @startdate = '2022-01-01'
set @enddate = '2022-12-31';


WITH s1 AS
(
SELECT

[Item No_]
,SUM(Quantity) * -1 [Item Consumption]
,[Standard Cost]
,CASE i.SIM 
	WHEN 0 THEN '0'
	WHEN 1 THEN 'A1'
	WHEN 2 THEN 'A2'
	WHEN 3 THEN 'A3'
	WHEN 4 THEN 'B1'
	WHEN 5 THEN 'B2'
	WHEN 6 THEN 'B3'
	WHEN 7 THEN 'C1'
	WHEN 8 THEN 'C2'
	WHEN 9 THEN 'C3'
END [SIM]

FROM [ZYGO$Item Ledger Entry] ile

INNER JOIN ZYGO$Item i ON ile.[Item No_] = i.No_

WHERE

[Posting Date] &gt;= @startdate

AND [Posting Date] &lt;= @enddate

AND ([Entry Type] = 1 --Sale

OR [Entry Type] = 5) --Consumption

AND [Replenishment System] = 0

AND Vetted = 0

--AND [Unit Cost] &gt; 0

--AND [Item No_] = '1911-000-109'

GROUP BY [Item No_], [Standard Cost], SIM
)
,s2 AS
(
SELECT
	[Item No_]
	,[Item Consumption] * [Standard Cost] [Item Spend]
	,SIM

FROM s1
)
,sSIMs AS

(
SELECT

COALESCE(SIM,'') SIM
,COUNT(SIM) Parts
,SUM([Item Spend]) [SIM Spend]
,COALESCE(LEFT(SIM, 1),'') [SIM Group]

FROM s2

GROUP BY SIM
)
,s3 AS
(
SELECT

LEFT(SIM, 1) [SIM Rating]
,SUM([SIM Spend]) [Spend]


FROM sSIMs

GROUP BY LEFT(SIM, 1)

)


SELECT 

*

,[SIM Spend]/SUM([SIM Spend]) OVER () * 100 [Pct of Total]

FROM sSIMs;</CommandText>
        <rd:UseGenericDesigner>true</rd:UseGenericDesigner>
      </Query>
      <Fields>
        <Field Name="SIM">
          <DataField>SIM</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Parts">
          <DataField>Parts</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
        <Field Name="SIM_Spend">
          <DataField>SIM Spend</DataField>
          <rd:TypeName>System.Decimal</rd:TypeName>
        </Field>
        <Field Name="SIM_Group">
          <DataField>SIM Group</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Pct_of_Total">
          <DataField>Pct of Total</DataField>
          <rd:TypeName>System.Decimal</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
  </DataSets>
