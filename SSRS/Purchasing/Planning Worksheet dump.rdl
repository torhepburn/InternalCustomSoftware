  <DataSets>
    <DataSet Name="DataSet1">
      <Query>
        <DataSourceName>NAV</DataSourceName>
        <CommandText>select * from [ZYGO$Requisition Line]


WHERE [Worksheet Template Name] = 'PLANNING'

AND [Journal Batch Name] = 'DEFAULT'

AND [Action Message] = 1

AND [Due Date] BETWEEN '2026-01-01' AND '2026-12-31'

AND [Ref_ Order Type] = 1</CommandText>
        <rd:UseGenericDesigner>true</rd:UseGenericDesigner>
      </Query>
