<?xml version="1.0" encoding="utf-8"?>
<Report MustUnderstand="df" xmlns="http://schemas.microsoft.com/sqlserver/reporting/2016/01/reportdefinition" xmlns:rd="http://schemas.microsoft.com/SQLServer/reporting/reportdesigner" xmlns:df="http://schemas.microsoft.com/sqlserver/reporting/2016/01/reportdefinition/defaultfontfamily">
  <df:DefaultFontFamily>Segoe UI</df:DefaultFontFamily>
  <AutoRefresh>0</AutoRefresh>
  <DataSources>
    <DataSource Name="NAV">
      <DataSourceReference>NAV</DataSourceReference>
      <rd:SecurityType>None</rd:SecurityType>
      <rd:DataSourceID>397ddec9-ab4f-4439-bcbd-795b00a3cef0</rd:DataSourceID>
    </DataSource>
  </DataSources>
  <DataSets>
    <DataSet Name="DataSet1">
      <Query>
        <DataSourceName>NAV</DataSourceName>
        <CommandText>WITH s1 AS
(
SELECT

COUNT(pl.[Line No_]) 'Past Due'
,SUM([Outstanding Amount]) 'Current Total Amount'
,[Purchaser Code]


FROM [ZYGO$Purchase Line] pl

INNER JOIN [ZYGO$Purchase Header] ph ON ph.No_ = pl.[Document No_]

WHERE

[Outstanding Quantity] &lt;&gt; 0

AND [Planned Receipt Date] &lt; CAST(GETDATE() as date)   --Monday past due when run on Monday

AND ph.[Document Type] IN (1,5)  --1= order, 5 = return order


GROUP BY [Purchaser Code]
)
,s2 AS
(
SELECT

COUNT(pl.[Line No_]) '1 Week'
,SUM([Outstanding Amount]) '1 Week Total Amount'
,[Purchaser Code]

FROM [ZYGO$Purchase Line] pl

INNER JOIN [ZYGO$Purchase Header] ph ON ph.No_ = pl.[Document No_]

WHERE

[Outstanding Quantity] &lt;&gt; 0

AND [Planned Receipt Date] between  CAST(GETDATE() as date)  AND DATEADD(week,1,CAST(GETDATE() as date))

AND ph.[Document Type] IN (1,5)  --1= order, 5 = return order

GROUP BY [Purchaser Code]
)
,s3 AS
(
SELECT

s1.*
,s2.[1 Week]
,s2.[1 Week Total Amount]

FROM s1 LEFT JOIN s2 ON s1.[Purchaser Code] = s2.[Purchaser Code]
)


SELECT


 ph.[Purchaser Code]
,ph.[Pay-to Name] Vendor
,pl.[Document No_] [Order]
,pl.[PO Line No_]
,pl.No_ Item
,pl.Description
,pl.Quantity
,pl.[Quantity Received]
,pl.[Outstanding Quantity]
,pl.Amount
,ph.[Document Date]
,pl.[Requested Receipt Date]
,pl.[Promised Receipt Date]
,pl.[Planned Receipt Date]
,DATEDIFF(dd,pl.[Requested Receipt Date],CAST(GETDATE() as date)) [Days Late]
,pl.[Location Code]
,ph.[Deliver To]
,s3.[Past Due]
,s3.[Current Total Amount]
,s3.[1 Week]
,s3.[1 Week Total Amount]


FROM [ZYGO$Purchase Line] pl

INNER JOIN [ZYGO$Purchase Header] ph ON ph.No_ = pl.[Document No_]

left join s3 on ph.[Purchaser Code] = s3.[Purchaser Code]

WHERE

[Outstanding Quantity] &lt;&gt; 0

AND [Planned Receipt Date] &lt; GETDATE() -1  --Monday past due

AND ph.[Document Type] IN (1,5)  --1= order, 5 = return order

AND ph.[Purchaser Code] = 'ANGIE W'</CommandText>
        <rd:UseGenericDesigner>true</rd:UseGenericDesigner>
      </Query>
