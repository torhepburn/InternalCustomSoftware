<?xml version="1.0" encoding="utf-8"?>
<Report MustUnderstand="df" xmlns="http://schemas.microsoft.com/sqlserver/reporting/2016/01/reportdefinition" xmlns:rd="http://schemas.microsoft.com/SQLServer/reporting/reportdesigner" xmlns:df="http://schemas.microsoft.com/sqlserver/reporting/2016/01/reportdefinition/defaultfontfamily">
  <df:DefaultFontFamily>Segoe UI</df:DefaultFontFamily>
  <AutoRefresh>0</AutoRefresh>
  <DataSources>
    <DataSource Name="NAV">
      <DataSourceReference>NAV</DataSourceReference>
      <rd:SecurityType>None</rd:SecurityType>
      <rd:DataSourceID>25577771-b50a-4079-8838-ff92f07618f0</rd:DataSourceID>
    </DataSource>
  </DataSources>
  <DataSets>
    <DataSet Name="DataSet1">
      <Query>
        <DataSourceName>NAV</DataSourceName>
        <CommandText>SELECT DISTINCT 
	
	v.[Production BOM No_]
	,ii.Description [BOM Description]
	,l.No_
	,i.Description [Item Description]
	,l.Quantity
	, i.[Selection Code]
	,CASE v.Status
		WHEN 1 THEN 'Certified'
		ELSE 'Not Certified'
	END [Status]
                  ,l.[Version Code]
	,i.[Signal Code]
	,CASE i.[Reference Component]
		WHEN 1 THEN 'Yes'
		WHEN 0 THEN 'No'
	END [Item Card Reference Component]
	,CASE l.[Reference Component]
		WHEN 1 THEN 'Yes'
		WHEN 0 THEN 'No'
	END [BOM Identified Reference Component]
	,CASE ii.Vetted
		WHEN 0 THEN 'BOM Vetted'
		WHEN 1 THEN 'BOM Not Vetted'
	END [BOM Vetted]
	,CASE i.Vetted
		WHEN 0 THEN 'Item Vetted'
		WHEN 1 THEN 'Item Not Vetted'
	END [ITEM Vetted]

	FROM [ZYGO$Production BOM Version] v

	INNER JOIN [ZYGO$Production BOM Line] l ON v.[Production BOM No_] = l.[Production BOM No_]

	AND v.[Version Code] = l.[Version Code]

	INNER JOIN ZYGO$Item i ON l.No_ = i.No_

	INNER JOIN ZYGO$Item ii ON v.[Production BOM No_] = ii.No_

	WHERE v.Status = 1

	AND i.[Selection Code] != 'SIC'

	AND i.[Signal Code] != 'OBS'

	AND ii.[Signal Code] != 'OBS'

	AND l.Quantity = 0

	AND i.[Reference Component] != 1

	AND i.Vetted = 0

	and ii.Vetted = 0

	AND v.[Production BOM No_] IN (SELECT [Source No_] FROM [ZYGO$Production Order])</CommandText>
        <rd:UseGenericDesigner>true</rd:UseGenericDesigner>
      </Query>
      <Fields>
        <Field Name="Production_BOM_No_">
          <DataField>Production BOM No_</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="BOM_Description">
          <DataField>BOM Description</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Status">
          <DataField>Status</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="No_">
