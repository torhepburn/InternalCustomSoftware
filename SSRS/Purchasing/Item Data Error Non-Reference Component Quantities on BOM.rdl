          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="BOM_Vetted">
          <DataField>BOM Vetted</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="BOM_Identified_Reference_Component">
