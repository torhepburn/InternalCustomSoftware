  <AutoRefresh>0</AutoRefresh>
  <DataSources>
    <DataSource Name="NAV">
      <DataSourceReference>NAV</DataSourceReference>
      <rd:SecurityType>None</rd:SecurityType>
      <rd:DataSourceID>c3c9a9d5-6820-4832-8ce3-d32fdf8085a2</rd:DataSourceID>
    </DataSource>
    <DataSource Name="REFRESH">
      <ConnectionProperties>
        <DataProvider>SQL</DataProvider>
        <ConnectString>Data Source=pa-hor-as406.ametek.com;Initial Catalog=ZYGO-NAV-REFRESH</ConnectString>
      </ConnectionProperties>
      <rd:SecurityType>DataBase</rd:SecurityType>
      <rd:DataSourceID>52e262e2-b322-4136-b1f4-c891fdcbf8cb</rd:DataSourceID>
    </DataSource>
  </DataSources>
  <DataSets>
    <DataSet Name="DataSet1">
      <Query>
        <DataSourceName>REFRESH</DataSourceName>
        <CommandText>/*	
	For Luz Signal Code determines item active 

*/
declare @item varchar(20);

set @item = '1115-800-055';


WITH s1 as
(	--On Hand Nettable
	SELECT 
	[Item No_]
	,SUM(Quantity) Nettable
	FROM [ZYGO$Item Ledger Entry]
	WHERE [Non-Nettable] = 0
	GROUP BY [Item No_]

)
,s1a as
(	--On Hand Non-Nettable
	SELECT 
	[Item No_]
	,SUM(Quantity) NonNettable
	FROM [ZYGO$Item Ledger Entry]
	WHERE [Non-Nettable] = 1
	GROUP BY [Item No_]
)
,s1b as
(	--Forecast Quantity
	SELECT 
	[Item No_]
	,SUM([Forecast Quantity]) [Qty on Production Forecast]
	--,[Forecast Quantity] [Qty on Production Forecast]
	--,YEAR([Forecast Date]) yDate
		
	FROM [ZYGO$Production Forecast Entry]
	WHERE [Production Forecast Name] = 'ZYGO'

	AND YEAR([Forecast Date]) = 2025
	
	GROUP BY [Item No_]
	

)
, s2 as
(	--Stock on Purchase Order
	SELECT
	I.No_
    ,COALESCE(SUM(L.[Outstanding Quantity]), '0') [Qty on PO ]
	FROM [ZYGO$Purchase Line] L 
    INNER JOIN [ZYGO$Item] I ON L.No_ = I.No_
    WHERE ([Replenishment System] = 0 and [Document Type] = 1
    and [Outstanding Quantity] &gt; 0)
	AND YEAR([Planned Receipt Date]) = 2025
	GROUP BY I.No_
	
)

, s3 as
(	--Qty on Sales Orders -- Type 2 = Item	Type 3 = Resource
	SELECT
	No_
	,COALESCE(SUM([Outstanding Quantity]), 0) [Qty on SO]
	
	FROM [ZYGO$Sales Line]

	WHERE Type = 2 AND [Completely Shipped] = 0
		
	AND YEAR([Shipment Date]) = 2025

	GROUP BY No_
	
)
, s4 as
(	--Qty on Service Orders  Type 1 = Item Type 2 = Resource
	SELECT
	No_
    ,COALESCE(SUM([Outstanding Quantity]), 0) [Qty on Service Order]
	
	FROM [ZYGO$Service Line] WHERE [Type] = 1

	AND YEAR([Planned Delivery Date]) = 2025
    GROUP BY No_
	
)
, s5 as
(	--Qty on Inventory Request - Jobs
	SELECT
	No_
    ,COALESCE(SUM([Remaining Qty_]), 0) [Qty on Inventory Request]
	
	FROM [ZYGO$Job Journal Line]
    WHERE [Journal Template Name] = 'INVREQ'
	AND [Remaining Qty_] &gt; 0
	AND YEAR([Due Date]) = 2025
	GROUP BY No_
	
)
, s6 as
(	--Qty on Production Order  --Status 2 = Firm Planned Status 3 = Released
	SELECT
	[Item No_]
    ,COALESCE(SUM([Remaining Quantity]), 0) [Qty on Production Order]
	
	FROM [ZYGO$Prod_ Order Line]
    WHERE [Remaining Quantity] &gt; 0 and [Status] in (2,3)

	AND YEAR([Due Date]) = 2025
	GROUP BY [Item No_]
	
)


, sPC as
(
	SELECT
	[Item No_]
	 ,COALESCE(SUM([Remaining Quantity]), 0) [Qty on Prod Order Component] 
	

	FROM [ZYGO$Prod_ Order Component]

	WHERE Status in (2, 3)

	AND YEAR([Due Date]) = 2025

	GROUP BY [Item No_]
	
)
,sPLc AS
(
	select 

	[Item No_] 
	,SUM([Expected Quantity]) [Qty on Planning Component]

	FROM [ZYGO$Planning Component]

	where 1=1

	AND [Worksheet Template Name] = 'PLANNING'

	AND [Worksheet Batch Name] = 'DEFAULT'

	AND YEAR([Due Date]) = 2025

	GROUP BY [Item No_]
	

)
,
sRp AS
(
	select 

	 No_ [Item No.]
	,SUM([Remaining Quantity]) [Qty on Requisition Line]
	

	FROM [ZYGO$Requisition Line]

	where 1=1

	AND [Action Message] = 1

	AND [Worksheet Template Name] = 'PLANNING'

	AND [Journal Batch Name] = 'DEFAULT'

	AND YEAR([Order Date]) = 2025

	GROUP BY No_
	
)
,sX AS
(
SELECT

 i.No_
,i.Description
,CONVERT(NUMERIC(10),COALESCE(s1.Nettable, 0)) [Qty on hand Nettable]
,CASE [Replenishment System]
	WHEN 0 THEN 'Purchased'
	WHEN 1 THEN 'Manufactured'
END 'Replenishment System'

,CONVERT(NUMERIC(10),COALESCE(s2.[Qty on PO], 0)) [Qty on PO]
,CONVERT(NUMERIC(10),COALESCE(s6.[Qty on Production Order], 0)) [Qty on Production Order]
,CONVERT(NUMERIC(10),COALESCE(s3.[Qty on SO], 0)) [Qty on SO]
,CONVERT(NUMERIC(10),COALESCE(s5.[Qty on Inventory Request], 0)) [Qty on Inventory Request]
,CONVERT(NUMERIC(10),COALESCE(s4.[Qty on Service Order], 0)) [Qty on Service Order]
,CONVERT(NUMERIC(10),COALESCE([NonNettable],0)) NonNettable
,CONVERT(NUMERIC(10),COALESCE([Qty on Production Forecast],0)) [Qty on Production Forecast]
,CONVERT(NUMERIC(10),COALESCE([Qty on Prod Order Component],0)) [Qty on Prod Order Component]
,CONVERT(NUMERIC(10),COALESCE([Qty on Planning Component],0)) [Qty on Planning Component]
,CONVERT(NUMERIC(10),COALESCE(sRp.[Qty on Requisition Line],0)) [Qty on Requisition Line]
,CONVERT(NUMERIC(10),COALESCE(sRp.[Qty on Requisition Line],0) + COALESCE(sPLc.[Qty on Planning Component], 0)) * -1 ActionMessageQty
,i.[Buyer Planner Code]

FROM [ZYGO$Item] i

LEFT JOIN s1 on s1.[Item No_] = i.No_
LEFT JOIN s1b ON s1b.[Item No_] = i.No_
LEFT JOIN s2 on s2.[No_] = s1b.[Item No_] 
LEFT JOIN s3 on s3.[No_] = s1b.[Item No_] 
LEFT JOIN s4 on s4.[No_] = s1b.[Item No_] 
LEFT JOIN s5 on s5.[No_] = s1b.[Item No_] 
LEFT JOIN s6 on s6.[Item No_] = s1b.[Item No_] 
LEFT JOIN s1a ON s1a.[Item No_] = i.No_

LEFT JOIN sPC ON sPC.[Item No_] = s1b.[Item No_] 
LEFT JOIN sPLc ON sPLc.[Item No_] = s1b.[Item No_] 
LEFT JOIN sRp ON sRp.[Item No.] = s1b.[Item No_] 

WHERE 1=1

and [Signal Code] != 'OBS'
)
--, sZ AS
--(
select distinct


No_ ItemNo
,Description
,[Qty on hand Nettable]
,NonNettable [Qty on Hand Non-Nettable]
,[Qty on PO]
,[Qty on SO]
,[Qty on Service Order]
,[Qty on Inventory Request]
,[Qty on Production Order]
,[Qty on Prod Order Component]
,[Qty on Production Forecast]
,[Qty on Requisition Line]
,[Qty on Planning Component]
,ActionMessageQty
,([Qty on Production Order] + [Qty on PO]) ScheduledReceipts
,([Qty on SO] + [Qty on Service Order] + [Qty on Inventory Request] + [Qty on Prod Order Component] ) GrossRequirements

,([Qty on hand Nettable] + [Qty on Production Order] + [Qty on PO]) - ([Qty on SO] + [Qty on Service Order] + [Qty on Inventory Request] + [Qty on Prod Order Component] ) [Projected Inventory]
,([Qty on hand Nettable] + [Qty on Production Order] + [Qty on PO]) - ([Qty on SO] + [Qty on Service Order] + [Qty on Inventory Request] + [Qty on Prod Order Component] ) /* projected inventory */
- ([Qty on Production Forecast] - [Qty on SO]) [Forecast Projected Inventory]
,CASE [Replenishment System]
	WHEN 'Manufactured' THEN
(([Qty on hand Nettable] + [Qty on Production Order] + [Qty on PO]) - ([Qty on SO] + [Qty on Service Order] + [Qty on Inventory Request] + [Qty on Prod Order Component] ) /* projected inventory */
- ([Qty on Production Forecast] - [Qty on SO]) ) - ActionMessageQty
	WHEN 'Purchased' THEN (([Qty on hand Nettable] + [Qty on Production Order] + [Qty on PO]) - ([Qty on SO] + [Qty on Service Order] + [Qty on Inventory Request] + [Qty on Prod Order Component] ) /* projected inventory */
- ([Qty on Production Forecast] - [Qty on SO]) ) + ActionMessageQty
END [Suggested Projected Inventory]
,[Replenishment System]
,[Buyer Planner Code]

from sX






</CommandText>
        <rd:UseGenericDesigner>true</rd:UseGenericDesigner>
      </Query>
