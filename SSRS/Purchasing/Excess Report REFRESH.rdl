        </Field>
        <Field Name="Qty_on_Prod_Order_Component">
          <DataField>Qty on Prod Order Component</DataField>
          <rd:TypeName>System.Decimal</rd:TypeName>
        </Field>
        <Field Name="ActionMessageQty">
          <DataField>ActionMessageQty</DataField>
          <rd:TypeName>System.Decimal</rd:TypeName>
        </Field>
        <Field Name="Qty_on_Requisition_Line">
          <DataField>Qty on Requisition Line</DataField>
