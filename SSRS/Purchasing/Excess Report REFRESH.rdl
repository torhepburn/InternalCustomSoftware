        </Field>
        <Field Name="ScheduledReceipts">
          <DataField>ScheduledReceipts</DataField>
          <rd:TypeName>System.Decimal</rd:TypeName>
        </Field>
        <Field Name="GrossRequirements">
          <DataField>GrossRequirements</DataField>
          <rd:TypeName>System.Decimal</rd:TypeName>
        </Field>
        <Field Name="Qty_on_Production_Forecast">
          <DataField>Qty on Production Forecast</DataField>
          <rd:TypeName>System.Decimal</rd:TypeName>
        </Field>
        <Field Name="Qty_on_Planning_Component">
          <DataField>Qty on Planning Component</DataField>
          <rd:TypeName>System.Decimal</rd:TypeName>
        </Field>
        <Field Name="Projected_Inventory">
          <DataField>Projected Inventory</DataField>
          <rd:TypeName>System.Decimal</rd:TypeName>
        </Field>
        <Field Name="Replenishment_System">
          <DataField>Replenishment System</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Forecast_Projected_Inventory">
          <DataField>Forecast Projected Inventory</DataField>
          <rd:TypeName>System.Decimal</rd:TypeName>
        </Field>
        <Field Name="Suggested_Projected_Inventory">
          <DataField>Suggested Projected Inventory</DataField>
          <rd:TypeName>System.Decimal</rd:TypeName>
        </Field>
        <Field Name="Buyer_Planner_Code">
          <DataField>Buyer Planner Code</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
      </Fields>
