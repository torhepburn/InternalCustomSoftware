<?xml version="1.0" encoding="utf-8"?>
<Report MustUnderstand="df" xmlns="http://schemas.microsoft.com/sqlserver/reporting/2016/01/reportdefinition" xmlns:rd="http://schemas.microsoft.com/SQLServer/reporting/reportdesigner" xmlns:df="http://schemas.microsoft.com/sqlserver/reporting/2016/01/reportdefinition/defaultfontfamily">
  <df:DefaultFontFamily>Segoe UI</df:DefaultFontFamily>
  <AutoRefresh>0</AutoRefresh>
  <DataSources>
    <DataSource Name="NAV">
      <DataSourceReference>NAV</DataSourceReference>
      <rd:SecurityType>None</rd:SecurityType>
      <rd:DataSourceID>1ee11cd4-cc9d-432e-abba-485be745d382</rd:DataSourceID>
    </DataSource>
  </DataSources>
  <DataSets>
    <DataSet Name="DataSet1">
      <Query>
        <DataSourceName>NAV</DataSourceName>
        <CommandText>declare @item varchar(30)
declare @document varchar(30)
declare @quantity int
declare @balance int
declare @polineno int
declare @cost decimal(38,4)
declare @value decimal(38,4)
declare @duedate date
declare @reportCutoffDate date
declare @purchaser varchar(30)
declare @vendor varchar(60)
declare @twoweekUSE int

SET @reportCutoffDate = '2024-12-31'

--DROP Table #Temp

CREATE TABLE #Temp
(
[Due Date] date
,[Item No] varchar(30)
,[Quantity] int
,[Balance] int
,[Document] varchar(30)
,[PO Line No] int
,[Value] decimal(38,4)
,Buyer varchar(30)
,Vendor varchar(60)
)

CREATE TABLE #Supply
(
[Due Date] date
,[Item No] varchar(30)
,[Quantity] int
,[Balance] int
,[Document] varchar(30)
,[PO Line No] int
,[Value] decimal(38,4)
,Buyer varchar(30)
,Vendor varchar(60)
)





declare itemCursor Cursor for 
	
	select

	No_
	,[Standard Cost]
	,CASE 
		WHEN EAU/26 &lt;1 THEN 1
		WHEN EAU/26 &gt; 0 THEN EAU/26
	END
	

	from [ZYGO$Item] 

	WHERE SIM IN (1,2,3) --A

	AND No_ not like '%FAI%'

	AND F6 != 0

	AND [Replenishment System] = 0

open itemCursor
fetch next from itemCursor into @item, @cost,@twoweekUSE
while @@FETCH_STATUS = 0
begin

SET @duedate = getdate()

SELECT @balance = SUM(Quantity) FROM [ZYGO$Item Ledger Entry]

WHERE [Item No_] = @item
	
INSERT INTO #Temp

SELECT

@duedate
,@item
,0
,@balance
,'On Hand'
,0
,0
,''
,''

		DECLARE orderCursor Cursor for

			SELECT 

			[Document No_]
			,CASE l.[Document Type]
				WHEN 1 THEN [Outstanding Quantity] 
				WHEN 5 THEN [Outstanding Quantity] * -1
			END [Quantity]
			,l.[Expected Receipt Date] [Due Date]
			,[PO Line No_]
			,[Purchaser Code]
			,[Pay-to Name]

			FROM [ZYGO$Purchase Line] l

			INNER JOIN [ZYGO$Purchase Header] h on l.[Document No_] = h.No_

			WHERE l.No_  = @item

			AND [Outstanding Quantity] &gt; 0

			AND l.[Expected Receipt Date] &lt;= @reportCutoffDate

			AND [Document No_] NOT LIKE 'KB%'

		UNION ALL

			select 

			[Prod_ Order No_] [Document No_]
			,[Remaining Quantity]*-1 Quantity
			,[Due Date]
			,0
			,''
			,''

			from [ZYGO$Prod_ Order Component]

			where

			Status IN (2,3)

			AND [Item No_] = @item

			AND [Remaining Quantity] &gt; 0

			AND [Due Date] &lt;= @reportCutoffDate

		UNION ALL
			/*	Jobs  minus  */

			select

			[Document No_]
			,Quantity * (-1) Quantity
			,[Due Date] 
			,0
			,''
			,''

			FROM [ZYGO$Job Journal Line]

			WHERE No_ = @item

			AND [Journal Template Name] = 'INVREQ'

			AND [Due Date] &lt;= @reportCutoffDate

	UNION ALL
			/*	sales minus	*/

			select

			[Document No_] 
			,[Outstanding Quantity] * (-1) [Quantity]
			,[Shipment Date] [Due Date]
			,0
			,''
			,''

			from 
			
			[ZYGO$Sales Line]

			WHERE 1=1

				AND [Outstanding Quantity] &gt; 0

				AND [Shipment Date] &lt;= @reportCutoffDate

				AND No_ = @item

	UNION ALL

		/*	planned forecast  minus	*/

		SELECT
		
		'Planning'
		,[Expected Quantity] * (-1) Quantity
		,[Due Date] 
		,0
		,''
		,''

		from [ZYGO$Planning Component]

		WHERE [Item No_] = @item

		AND [Due Date] &lt;= @reportCutoffDate

	UNION ALL   /*	MRP	*/
		
		select 
		
		'MRP Add'
		,Quantity
		,[Due Date]
		,0
		,[Buyer Planner Code]
		,v.Name

		from [ZYGO$Requisition Line] r 
		
		LEFT JOIN ZYGO$Vendor v ON r.[Supply From] = v.No_

		WHERE 

		[Worksheet Template Name] = 'PLANNING'

		AND [Journal Batch Name] = 'DEFAULT'

		AND r.[No_]=  @item

	UNION ALL   /*	MRP Resched	*/
		
		select 
		
		'MRP Resched'
		,Quantity * -1
		,[Original Due Date]
		,0
		,[Buyer Planner Code]
		,v.Name

		from [ZYGO$Requisition Line] r 
		
		LEFT JOIN ZYGO$Vendor v ON r.[Supply From] = v.No_

		WHERE 

		[Worksheet Template Name] = 'PLANNING'

		AND [Journal Batch Name] = 'DEFAULT'

		AND [Action Message] = 3

		AND r.[No_]=  @item


		order by [Due Date]


		open orderCursor
		fetch next from orderCursor into @document, @quantity, @duedate,@polineno,@purchaser,@vendor
		while @@FETCH_STATUS = 0
		begin

		IF @quantity &gt; 0			/*	if supply evaluate	*/
			BEGIN
				IF @balance &gt; @twoweekUSE
					BEGIN

						INSERT INTO #Supply 
		
						SELECT
		
						@duedate
						,@item
						,@quantity
						,@balance
						,@document
						,@polineno
						,@value
						,@purchaser
						,@vendor
					END
				
				
				IF @balance &lt;= @twoweekUSE
					BEGIN

					/*	take top line from supply and add in to variables then delete that line	*/



						SET @balance = @balance + @quantity
						SET @value = @quantity * @cost
					
						INSERT INTO #Temp 
		
						SELECT
		
						@duedate
						,@item
						,@quantity
						,@balance
						,@document
						,@polineno
						,@value
						,@purchaser
						,@vendor
					END
			END

		IF @quantity &lt; 0
		BEGIN
			SET @balance = @balance + @quantity
			SET @value = @quantity * @cost

			INSERT INTO #Temp 
		
			SELECT
		
			@duedate
			,@item
			,@quantity
			,@balance
			,@document
			,@polineno
			,@value
			,@purchaser
			,@vendor
		END
		
				
		fetch next from orderCursor into @document, @quantity, @duedate, @polineno,@purchaser,@vendor
		end
		close orderCursor
		deallocate orderCursor


fetch next from itemCursor into  @item, @cost,@twoweekUSE
end
close itemCursor
deallocate itemCursor

--select * from #Temp

--WHERE [Item No] = '1600-000-134'

--ORDER BY [Item No], [Due Date]

SELECT * FROM #Supply  WHERE Document not like 'MRP%' AND Document != 'Planning' --and [Item No] = '1600-000-134'

Order by [Item No],[Due Date]
--DROP Table #Temp;  DROP Table #Supply;</CommandText>
        <rd:UseGenericDesigner>true</rd:UseGenericDesigner>
      </Query>
