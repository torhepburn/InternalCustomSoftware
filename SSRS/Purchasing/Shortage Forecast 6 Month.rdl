  <DataSources>
    <DataSource Name="NAV">
      <DataSourceReference>NAV</DataSourceReference>
      <rd:SecurityType>None</rd:SecurityType>
      <rd:DataSourceID>5e0221f3-8d3d-47b4-b161-261115e2f3ad</rd:DataSourceID>
    </DataSource>
