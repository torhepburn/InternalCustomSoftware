  <DataSets>
    <DataSet Name="DataSet1">
      <Query>
        <DataSourceName>NAV</DataSourceName>
        <CommandText>WITH OO as
(
	SELECT 
	No_
	,SUM([On Order]) OnOrder

	FROM
	(
		SELECT

		No_
		,COALESCE(CONVERT(INT,SUM([Outstanding Quantity])),0)  [On Order]

		FROM [ZYGO$Purchase Line]

		WHERE [Outstanding Quantity] &gt; 0

		GROUP BY No_

		UNION ALL

		SELECT 

		[Item No_]
		,COALESCE(CONVERT(INT,SUM([Remaining Quantity])),0) [On Order]
	

		FROM [ZYGO$Prod_ Order Line]

		WHERE 

		[Remaining Quantity] &gt; 0

		AND Status &lt; 4

		AND [Prod_ Order No_] + ':' + CAST([Line No_] as varchar(6))

		NOT IN
			(
			SELECT

			  [Prod_ Order No_] + ':' + CAST([Prod_ Order Line No_] as varchar(6))

			FROM [ZYGO$Purchase Line]

			WHERE 

			(([Outstanding Quantity] &gt; 0)

			 AND (([Document Type])=1)

			 AND ((Type)=2))

			 AND [Document No_] LIKE 'S%'
			 )
		GROUP BY [Item No_]) a

		Group BY No_
)
,NonNettableOH AS
(
	SELECT

	[Item No_]
	,COALESCE(CONVERT(INT,SUM([Quantity])), 0) NonNettable

	FROM [ZYGO$Item Ledger Entry]

	WHERE [Non-Nettable] = 1

	AND [Location Code] IN ('MID MRB', 'IRV MRB', 'RIC MRB')

	GROUP BY [Item No_]
)
,NettableOH AS
(
	SELECT

	[Item No_]
	,COALESCE(CONVERT(INT,SUM([Quantity])),0) Nettable

	FROM [ZYGO$Item Ledger Entry]

	WHERE [Non-Nettable] = 0

	GROUP BY [Item No_]
)
,FAIOO as
(
	SELECT

	No_ Item
	,CASE 
		WHEN No_ LIKE '%FAI' THEN COALESCE(CONVERT(INT,SUM([Outstanding Quantity])),0)
		ELSE 0
	END [FAI On Order]

	FROM [ZYGO$Purchase Line]

	WHERE [Outstanding Quantity] &gt; 0

	GROUP BY No_
)
,F_OO AS
(
	SELECT 

	REPLACE(Item, 'FAI','') Item
	,SUM([FAI On Order]) F_OO
	FROM FAIOO

	GROUP BY REPLACE(Item, 'FAI','')
)
,FAINonNettableOH AS
(
	SELECT

	[Item No_] Item
	
	,CASE 
		WHEN [Item No_] LIKE '%FAI' THEN COALESCE(CONVERT(INT,SUM([Quantity])),0)
		ELSE 0
	END [FAINonNettableOH]

	FROM [ZYGO$Item Ledger Entry]

	WHERE [Non-Nettable] = 1

	AND [Location Code] IN ('MID MRB', 'IRV MRB', 'RIC MRB')

	GROUP BY [Item No_]
)
,F_NN AS
(
	SELECT 

	REPLACE(Item, 'FAI','') Item
	,SUM(FAINonNettableOH) F_NN

	FROM FAINonNettableOH

	GROUP BY REPLACE(Item, 'FAI','')
)
,FAINettableOH AS
(
	SELECT

	[Item No_] Item
	,CASE 
		WHEN [Item No_] LIKE '%FAI' THEN COALESCE(CONVERT(INT,SUM([Quantity])),0)
		ELSE 0
	END FAINettableOH

	FROM [ZYGO$Item Ledger Entry]

	WHERE [Non-Nettable] = 0

	GROUP BY [Item No_]
)
,F_N AS
(
	SELECT 

	REPLACE(Item, 'FAI','') Item
	,SUM(FAINettableOH) F_N

	FROM FAINettableOH

	GROUP BY REPLACE(Item, 'FAI','')
)

,BlockedStock AS
(
	SELECT
	 [Item No_]
    ,COALESCE(CONVERT(INT,SUM([Quantity])), 0) Blocked
     FROM [ZYGO$Warehouse Entry]
     WHERE [Bin Code] like '%IQC%'
    GROUP BY  [Item No_] 

)
,AS1 AS /*	allocated prod ord component	*/
(
	SELECT 
                        
	[Item No_]
	,COALESCE(SUM([Remaining Quantity]), 0) as1 
	 FROM [ZYGO$Prod_ Order Component] 
	 WHERE Status in (2, 3) 
	 GROUP BY [Item No_]
)
,AS2 AS /*	allocated sales order	*/
(
	SELECT 
                        
	[No_]
	,COALESCE(SUM([Quantity]), 0)  as2
	 FROM [ZYGO$Sales Line] 
	 WHERE Type = 2
	 AND [Completely Shipped] = 0
	 GROUP BY [No_]
)
,AS3 AS /*	allocated service order	*/
(
	SELECT 
                        
	[No_]
	,COALESCE(SUM([Outstanding Quantity]), 0)  as3
	 FROM [ZYGO$Service Line] 
	 
	 GROUP BY [No_]
)
,AS4 AS /*	allocated Job Inventory Requests	*/
(
	SELECT 
                        
	[No_]
	,COALESCE(SUM([Quantity]), 0)  as4
	 FROM [ZYGO$Job Journal Line] 
	 WHERE [Journal Template Name] = 'INVREQ'
	 GROUP BY [No_]
)
, IB AS
(
	select

	 sI.No_
	,COALESCE(OO.[OnOrder],0) OnOrder
	,COALESCE(noh.Nettable,0) NettableOH
	,COALESCE(nnoh.NonNettable,0) NonNettableOH
	,COALESCE(F_OO.[F_OO],0) F_OnOrder
	,COALESCE(F_N.F_N,0) F_NettableOH
	,COALESCE(F_NN.F_NN,0) F_NonNettableOH
	,CONVERT(INT,(COALESCE(AS1.as1,0) +
	COALESCE(AS2.as2,0) +
	COALESCE(AS3.as3,0) +
	COALESCE(AS4.as4,0))) Allocated
	,COALESCE(b.Blocked,0) Blocked
	,CAST(GETDATE() as date) DataDate

	from ZYGO$Item sI

	LEFT JOIN AS1 ON sI.No_ = AS1.[Item No_]
	LEFT JOIN AS2 ON sI.No_ = AS2.[No_]
	LEFT JOIN AS3 ON sI.No_ = AS3.[No_]
	LEFT JOIN AS4 ON sI.No_ = AS4.[No_]

	LEFT JOIN OO ON sI.No_ = OO.No_
	LEFT JOIN NettableOH noh ON sI.No_ = noh.[Item No_]
	LEFT JOIN NonNettableOH nnoh ON sI.No_ = nnoh.[Item No_]
	LEFT JOIN F_OO ON sI.No_ = F_OO.Item
	LEFT JOIN F_N ON sI.No_ = F_N.[Item]
	LEFT JOIN F_NN ON sI.No_ = F_NN.[Item]
	LEFT JOIN BlockedStock b ON sI.No_ = b.[Item No_] 
)
,s1 AS
(
	SELECT

	 'Production Issue' [Trans Type]
	 ,5 TypeSortOrder
	 ,[Due Date] [Pl Trans Date]
	 ,[Prod_ Order No_] [Order No]
	 ,0 [Pl Rcpt Qty]
	 ,[Remaining Quantity] [Pl Issue Qty]
	 ,[Location Code] [From Loc]
	 ,[Item No_]
	 ,c.[Description]

	FROM [ZYGO$Prod_ Order Component] c

	INNER JOIN ZYGO$Item i ON c.[Item No_] = i.No_

	WHERE 

	[Remaining Quantity] &gt; 0

	AND Status &lt; 4

	AND [Replenishment System] = 0

UNION ALL

	SELECT

	 'Purchase Receipt' [Trans Type]
	 ,2 TypeSortOrder
	 ,[Planned Receipt Date] [Pl Trans Date]
	 ,[Document No_] [Order No]
	 ,[Outstanding Quantity] [Pl Rcpt Qty]
	 ,0 [Pl Issue Qty]
	 ,[Location Code] [From Loc]
	 ,l.No_
	 ,l.[Description]


	FROM [ZYGO$Purchase Line] l

	INNER JOIN ZYGO$Item i ON l.[No_] = i.No_

	WHERE 

	(([Outstanding Quantity] &gt; 0)

	 AND (([Document Type])=1)

	 AND ((l.Type)=2))

	 AND LEN([Prod_ Order No_]) = 0  /*	not subcontract	*/

	 AND [Replenishment System] = 0

UNION ALL

	SELECT

	 'Sales Dlvry' [Trans Type]
	 ,8 TypeSortOrder
	 ,[Planned Delivery Date] [Pl Trans Date]
	 ,[Document No_] [Order No]
	 ,0 [Pl Rcpt Qty]
	 ,[Outstanding Quantity] [Pl Issue Qty]
	 ,[Location Code] [From Loc]
	 ,l.No_
	 ,l.[Description]

	FROM [ZYGO$Sales Line] l

	INNER JOIN ZYGO$Item i ON l.[No_] = i.No_

	WHERE 

	[Outstanding Quantity] &gt; 0

	AND l.[Type] = 2 

	AND [Document Type] = 1
)
,s2 AS
(
	select DISTINCT [Item No_] from s1  /*	6,047 parts	*/
)
,s3 AS
(
	SELECT
	
	[Item No_]
	,SUM(Quantity) OHBalance
	
	FROM [ZYGO$Item Ledger Entry]

	GROUP BY [Item No_]
)
,s4 AS
(
	select

	COALESCE(s3.OHBalance,0) OH
	,s1.*

	from s2

	LEFT JOIN s3 ON s2.[Item No_] = s3.[Item No_] 

	LEFT JOIN s1 ON s1.[Item No_] = s2.[Item No_]
)
,s5 AS	/*	row numbers	*/
(
	Select

	ROW_NUMBER() OVER
	(Order BY [Item No_],[Pl Trans Date],TypeSortOrder) R#

	,* from s4
)
, s6 AS
(
	select
 
	 R#
	,[Item No_]
	,OH + SUM([Pl Rcpt Qty] - [Pl Issue Qty]) OVER (PARTITION BY [Item No_] ORDER BY R#) [Inv Bal]

	from s5
)
,s7 as
(
	select 

	MIN(R#) RN
	,[Item No_]
	,[Inv Bal]
	from s6

	GROUP BY [Item No_], [Inv Bal]

	HAVING [Inv Bal] &lt; 0
)
,s8 AS
(
	select

	MIN(RN) R#
	,[Item No_]

	FROM s7

	Group by [Item No_]
)
,s9 AS
(
	select

	s6.*

	from s8

	INNER JOIN s6 ON s8.R# = s6.R#
)
,s10 AS /*	6 month negative qty  */
(
	select 

	s5.[Item No_]
	,SUM([Pl Issue Qty]) TotalNeg6Mon

	from s5 

	INNER JOIN s9 ON s5.[Item No_] = s9.[Item No_]

	where  [Pl Trans Date] &lt;= DATEADD(mm, 6, GETDATE())

	AND s5.R# &gt;= s9.R#

	GROUP BY s5.[Item No_]
)

select 

 s5.[Item No_]
,s5.Description
,COALESCE(v.Name,'') Vendor
--,s9.[Inv Bal]
,IB.NettableOH
,IB.Allocated
,IB.OnOrder
,IB.NettableOH - IB.Allocated [Avail Stock]
,i.F6 [F6 includes Planning Forecast]
,i.F6 - IB.Allocated [F6 minus Allocated]
,s10.TotalNeg6Mon [TotalNeg6MonTransactions]
,s5.[Pl Trans Date] [Date Negative]
,i.[Item Category Code]
,s5.[Order No]
,s5.[Pl Issue Qty]

from s5

INNER JOIN s9 ON s5.R# = s9.R#

LEFT JOIN IB ON s5.[Item No_] = IB.No_

LEFT JOIN ZYGO$Item i on s5.[Item No_] = i.No_

LEFT JOIN ZYGO$Vendor v ON i.[Vendor No_] = v.No_

LEFT JOIN s10 ON s5.[Item No_] = s10.[Item No_]

WHERE [Pl Trans Date] &lt;= DATEADD(mm,6,GETDATE())

AND LEFT(s5.Description,1) != '#' 

AND i.[Replenishment System] = 0

order by [Pl Trans Date]</CommandText>
        <rd:UseGenericDesigner>true</rd:UseGenericDesigner>
      </Query>
      <Fields>
        <Field Name="Item_No_">
          <DataField>Item No_</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Description">
          <DataField>Description</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Vendor">
          <DataField>Vendor</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="NettableOH">
          <DataField>NettableOH</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
        <Field Name="Allocated">
          <DataField>Allocated</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
        <Field Name="OnOrder">
          <DataField>OnOrder</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
        <Field Name="Avail_Stock">
          <DataField>Avail Stock</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
        <Field Name="F6_includes_Planning_Forecast">
          <DataField>F6 includes Planning Forecast</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
        <Field Name="F6_minus_Allocated">
          <DataField>F6 minus Allocated</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
        <Field Name="Date_Negative">
          <DataField>Date Negative</DataField>
          <rd:TypeName>System.DateTime</rd:TypeName>
        </Field>
        <Field Name="TotalNeg6MonTransactions">
          <DataField>TotalNeg6MonTransactions</DataField>
          <rd:TypeName>System.Decimal</rd:TypeName>
        </Field>
        <Field Name="Item_Category_Code">
          <DataField>Item Category Code</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Order_No">
          <DataField>Order No</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Pl_Issue_Qty">
          <DataField>Pl Issue Qty</DataField>
          <rd:TypeName>System.Decimal</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
  </DataSets>
