<?xml version="1.0" encoding="utf-8"?>
<Report MustUnderstand="df" xmlns="http://schemas.microsoft.com/sqlserver/reporting/2016/01/reportdefinition" xmlns:rd="http://schemas.microsoft.com/SQLServer/reporting/reportdesigner" xmlns:df="http://schemas.microsoft.com/sqlserver/reporting/2016/01/reportdefinition/defaultfontfamily">
  <df:DefaultFontFamily>Segoe UI</df:DefaultFontFamily>
  <AutoRefresh>0</AutoRefresh>
  <DataSources>
    <DataSource Name="DataSource1">
      <ConnectionProperties>
        <DataProvider>SQL</DataProvider>
        <ConnectString>Data Source=pa-hor-as408.ametek.com;Initial Catalog=ZYGO-NAV-PROD</ConnectString>
      </ConnectionProperties>
      <rd:SecurityType>DataBase</rd:SecurityType>
      <rd:DataSourceID>24e13d44-3f46-4217-a1b4-755413f85dca</rd:DataSourceID>
    </DataSource>
  </DataSources>
  <DataSets>
    <DataSet Name="DataSet1">
      <Query>
        <DataSourceName>DataSource1</DataSourceName>
        <CommandText>select --DISTINCT

  ph.[Purchaser Code]
, ph.[Buy-from Vendor No_] as [Vendor No]
, [Buy-from Vendor Name] as [Vendor Name]
, pl.No_ as [Subcontract Item No]
, pd.Description as [Item Description]


, pl.[Document No_] as [PO No]
, pl.[PO Line No_]
,pl.[Order Date]
,CASE
	WHEN CONVERT(varchar,pl.[Promised Receipt Date],1) = '01/01/53' THEN ''
	ELSE CONVERT(varchar,pl.[Promised Receipt Date],1)
 END [Promised Receipt Date]

, CAST(pl.Quantity as int) [PO Quantity]
,CAST(pl.Quantity as int) - CAST(pl.[Outstanding Quantity] as int) 'Delivered'
, CAST(pl.[Outstanding Quantity] as int) [Open]


, pd.No_ as [SFC Order]
, CAST(dl.Quantity as INT) [SFO Quantity]
,CAST(dl.Quantity as int) - CAST(dl.[Remaining Quantity] as int) 'Cmpl'
, CAST(dl.[Remaining Quantity] as int) [Remaining]
, dl.[Due Date]


from [ZYGO$Purchase Line] pl
inner join [ZYGO$Purchase Header] ph on pl.[Document No_] = ph.No_
inner join [ZYGO$Production Order] pd on pl.[Prod_ Order No_] = pd.[No_]
INNER JOIN  [ZYGO$Prod_ Order Line] dl on dl.[Prod_ Order No_] = pd.[No_]

where pl.[Prod_ Order No_] &lt;&gt; ''
and pl.[Outstanding Quantity] &lt;&gt; 0
and pd.Status &lt;&gt; 4 -- closed

AND pl.[Promised Receipt Date] &lt;&gt; dl.[Due Date]

ORDER BY [Purchaser Code], [Vendor Name], [Subcontract Item No]</CommandText>
        <rd:UseGenericDesigner>true</rd:UseGenericDesigner>
      </Query>
      <Fields>
        <Field Name="Purchaser_Code">
          <DataField>Purchaser Code</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Vendor_No">
          <DataField>Vendor No</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Vendor_Name">
          <DataField>Vendor Name</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Subcontract_Item_No">
          <DataField>Subcontract Item No</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Item_Description">
          <DataField>Item Description</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="PO_No">
          <DataField>PO No</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="PO_Line_No_">
          <DataField>PO Line No_</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
        <Field Name="Order_Date">
          <DataField>Order Date</DataField>
          <rd:TypeName>System.DateTime</rd:TypeName>
        </Field>
        <Field Name="Promised_Receipt_Date">
          <DataField>Promised Receipt Date</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="PO_Quantity">
          <DataField>PO Quantity</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
        <Field Name="Delivered">
          <DataField>Delivered</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
        <Field Name="Open">
          <DataField>Open</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
        <Field Name="SFC_Order">
          <DataField>SFC Order</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="SFO_Quantity">
          <DataField>SFO Quantity</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
        <Field Name="Cmpl">
          <DataField>Cmpl</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
        <Field Name="Remaining">
          <DataField>Remaining</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
        <Field Name="Due_Date">
          <DataField>Due Date</DataField>
          <rd:TypeName>System.DateTime</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
