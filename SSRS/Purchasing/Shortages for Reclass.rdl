    </DataSource>
  </DataSources>
  <DataSets>
    <DataSet Name="DataSet1">
      <Query>
        <DataSourceName>AccessFrontEnds</DataSourceName>
        <CommandText>select 

PRODUCTLINE
,[Group]
,ItemCode
,Description
,WhoAdded

from shortage_list where datearchived is null

and productline = 'INST'</CommandText>
        <rd:UseGenericDesigner>true</rd:UseGenericDesigner>
      </Query>
      <Fields>
