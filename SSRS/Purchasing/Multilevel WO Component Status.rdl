<?xml version="1.0" encoding="utf-8"?>
<Report MustUnderstand="df" xmlns="http://schemas.microsoft.com/sqlserver/reporting/2016/01/reportdefinition" xmlns:rd="http://schemas.microsoft.com/SQLServer/reporting/reportdesigner" xmlns:df="http://schemas.microsoft.com/sqlserver/reporting/2016/01/reportdefinition/defaultfontfamily">
  <df:DefaultFontFamily>Segoe UI</df:DefaultFontFamily>
  <AutoRefresh>0</AutoRefresh>
  <DataSources>
    <DataSource Name="NAV">
      <DataSourceReference>NAV</DataSourceReference>
      <rd:SecurityType>None</rd:SecurityType>
      <rd:DataSourceID>cd21489e-d87d-4591-bd4c-97da7b3611f6</rd:DataSourceID>
    </DataSource>
  </DataSources>
  <DataSets>
    <DataSet Name="DataSet1">
      <Query>
        <DataSourceName>NAV</DataSourceName>
        <QueryParameters>
          <QueryParameter Name="@wo">
            <Value>=Parameters!WO.Value</Value>
            <rd:UserDefined>true</rd:UserDefined>
          </QueryParameter>
        </QueryParameters>
        <CommandText>WITH s1 as
(	--On Hand Nettable
	SELECT 
	[Item No_]
	,SUM(Quantity) Nettable
	FROM [ZYGO$Item Ledger Entry]
	WHERE [Non-Nettable] = 0
	GROUP BY [Item No_]

)
, s2 as
(	--Stock on Purchase Order
	SELECT
	I.No_
    ,COALESCE(SUM(L.[Outstanding Quantity]), '0.00') [Qty on PO ]
	FROM [ZYGO$Purchase Line] L 
    INNER JOIN [ZYGO$Item] I ON L.No_ = I.No_
    WHERE ([Replenishment System] = 0 and [Document Type] = 1
    and [Outstanding Quantity] &gt; 0)
	GROUP BY I.No_
)
, s3 as
(	--Qty on Sales Orders -- Type 2 = Item	Type 3 = Resource
	SELECT
	No_
    ,COALESCE(SUM([Outstanding Quantity]), 0) [Qty on SO]
    FROM [ZYGO$Sales Line]
    WHERE Type = 2 AND [Completely Shipped] = 0
	GROUP BY No_
)
, s4 as
(	--Qty on Service Orders  Type 1 = Item Type 2 = Resource
	SELECT
	No_
    ,COALESCE(SUM([Quantity]), 0) [Qty on Service Order]
    FROM [ZYGO$Service Line] WHERE [Type] = 1
    GROUP BY No_
)
, s5 as
(	--Qty on Inventory Request - Jobs
	SELECT
	No_
    ,COALESCE(SUM([Quantity]), 0) [Qty on Inventory Request]
    FROM [ZYGO$Job Journal Line]
    WHERE [Journal Template Name] = 'INVREQ'
	GROUP BY No_
)
, s6 as
(	--Qty on Production Order  --Status 2 = Firm Planned Status 3 = Released
	SELECT
	[Item No_]
    ,COALESCE(SUM([Remaining Quantity]), 0) [Qty on Production Order]
    FROM [ZYGO$Prod_ Order Line]
    WHERE [Remaining Quantity] &gt; 0 and [Status] in (2,3)
	GROUP BY [Item No_]
)
,s7 AS
(
	SELECT
	 No_
	,MIN([Promised Receipt Date]) [Promised Receipt Date]

	FROM [ZYGO$Purchase Line]

	WHERE 
	
	[Outstanding Quantity] &gt; 0

	GROUP BY No_
)
,s8 AS
(
	SELECT
	 l.No_
	,[Outstanding Quantity]
	,[Document No_]
	,l.[Promised Receipt Date]

	FROM [ZYGO$Purchase Line] l

	INNER JOIN s7 ON s7.No_ = l.No_ and s7.[Promised Receipt Date] = l.[Promised Receipt Date]

	WHERE 
	
	[Outstanding Quantity] &gt; 0

)




SELECT

m.[Item No_]
,m.Description
,m.[Remaining Qty_ (Base)]
,COALESCE(Nettable,0) [OH Nettable]
,COALESCE([Qty on PO ],0) [Qty on PO]
,COALESCE([Qty on SO ],0) [Qty on SO]
,COALESCE([Qty on Service Order],0) [Qty on Service Order]
,COALESCE([Qty on Inventory Request],0) [Qty on Inventory Request]
,COALESCE([Qty on Production Order],0) [Qty on Production Order]
,COALESCE(s8.[Document No_],'') PO
,COALESCE(s8.[Outstanding Quantity],0) [PO Qty]
,COALESCE(s8.[Promised Receipt Date],'') [Promised Receipt Date]

FROM [ZYGO$Prod_ Order Component] m

LEFT JOIN s1 ON m.[Item No_] = s1.[Item No_]
LEFT JOIN s2 ON m.[Item No_] = s2.[No_]
LEFT JOIN s3 ON m.[Item No_] = s3.[No_]
LEFT JOIN s4 ON m.[Item No_] = s4.[No_]
LEFT JOIN s5 ON m.[Item No_] = s5.[No_]
LEFT JOIN s6 ON m.[Item No_] = s6.[Item No_]
LEFT JOIN s8 ON m.[Item No_] = s8.[No_]

where m.[Prod_ Order No_] = @wo
</CommandText>
        <rd:UseGenericDesigner>true</rd:UseGenericDesigner>
      </Query>
      <Fields>
        <Field Name="Item_No_">
          <DataField>Item No_</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Description">
          <DataField>Description</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Remaining_Qty___Base_">
          <DataField>Remaining Qty_ (Base)</DataField>
          <rd:TypeName>System.Decimal</rd:TypeName>
        </Field>
        <Field Name="OH_Nettable">
          <DataField>OH Nettable</DataField>
          <rd:TypeName>System.Decimal</rd:TypeName>
        </Field>
        <Field Name="Qty_on_PO">
          <DataField>Qty on PO</DataField>
          <rd:TypeName>System.Decimal</rd:TypeName>
        </Field>
        <Field Name="Qty_on_SO">
          <DataField>Qty on SO</DataField>
          <rd:TypeName>System.Decimal</rd:TypeName>
        </Field>
        <Field Name="Qty_on_Service_Order">
          <DataField>Qty on Service Order</DataField>
          <rd:TypeName>System.Decimal</rd:TypeName>
        </Field>
        <Field Name="Qty_on_Inventory_Request">
          <DataField>Qty on Inventory Request</DataField>
          <rd:TypeName>System.Decimal</rd:TypeName>
        </Field>
        <Field Name="Qty_on_Production_Order">
          <DataField>Qty on Production Order</DataField>
          <rd:TypeName>System.Decimal</rd:TypeName>
        </Field>
        <Field Name="PO">
          <DataField>PO</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="PO_Qty">
          <DataField>PO Qty</DataField>
          <rd:TypeName>System.Decimal</rd:TypeName>
        </Field>
        <Field Name="Promised_Receipt_Date">
          <DataField>Promised Receipt Date</DataField>
          <rd:TypeName>System.DateTime</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
  </DataSets>
