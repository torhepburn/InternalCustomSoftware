              <Paragraph>
                <TextRuns>
                  <TextRun>
                    <Value>SIM Data for Mfg Parts</Value>
                    <Style>
                      <FontFamily>Segoe UI Light</FontFamily>
                      <FontSize>24pt</FontSize>
                      <FontWeight>Bold</FontWeight>
                    </Style>
                  </TextRun>
