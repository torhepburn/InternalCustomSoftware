<?xml version="1.0" encoding="utf-8"?>
<Report MustUnderstand="df" xmlns="http://schemas.microsoft.com/sqlserver/reporting/2016/01/reportdefinition" xmlns:rd="http://schemas.microsoft.com/SQLServer/reporting/reportdesigner" xmlns:df="http://schemas.microsoft.com/sqlserver/reporting/2016/01/reportdefinition/defaultfontfamily">
  <df:DefaultFontFamily>Segoe UI</df:DefaultFontFamily>
  <AutoRefresh>0</AutoRefresh>
  <DataSources>
    <DataSource Name="NAV">
      <DataSourceReference>NAV</DataSourceReference>
      <rd:SecurityType>None</rd:SecurityType>
      <rd:DataSourceID>09a4833d-3b8d-46c5-a29b-4af48768e712</rd:DataSourceID>
    </DataSource>
  </DataSources>
  <DataSets>
    <DataSet Name="DataSet1">
      <Query>
        <DataSourceName>NAV</DataSourceName>
        <CommandText>DECLARE @item varchar(50)
DECLARE @vetted int
DECLARE @replenishment int

SET @vetted = 0
SET @replenishment = 1  -- 0 = purchased  1 = production order  2 = transfer
SET DATEFIRST 1;

DECLARE @monthstart date

select @monthstart = dateadd(MONTH, datediff(MONTH, 0, GETDATE()-365), 0)

CREATE TABLE #Temp
(
 [Item] varchar(50)
,[Consumption M-1] int
,[Consumption M-2] int
,[Consumption M-3] int
,[Consumption M-4] int
,[Consumption M-5] int
,[Consumption M-6] int
,[Consumption M-7] int
,[Consumption M-8] int
,[Consumption M-9] int
,[Consumption M-10] int
,[Consumption M-11] int
,[Consumption M-12] int

)

DECLARE simCursor CURSOR FOR

/*	Get the list of all items which need to be considered */

SELECT

No_

FROM ZYGO$Item WHERE [Replenishment System] = @replenishment

AND [Signal Code] != 'OBS'

--AND Vetted = @vetted


OPEN simCursor

FETCH NEXT FROM simCursor INTO @item

WHILE @@FETCH_STATUS = 0
BEGIN

WITH s21 AS
(
SELECT 

DATEPART(MONTH,[Posting Date]) [Month Number]
,[Item No_]
,CASE
	WHEN DATEPART(MONTH,[Posting Date]) = 1 THEN SUM(Quantity) * -1 
	ELSE 0
END [Consumption M-1]
,CASE
	WHEN DATEPART(MONTH,[Posting Date]) = 2 THEN SUM(Quantity) * -1 
	ELSE 0
END [Consumption M-2]
,CASE
	WHEN DATEPART(MONTH,[Posting Date]) = 3 THEN SUM(Quantity) * -1 
	ELSE 0
END [Consumption M-3]
,CASE

	WHEN DATEPART(MONTH,[Posting Date]) = 4 THEN SUM(Quantity) * -1 
	ELSE 0
END [Consumption M-4]
,CASE
	WHEN DATEPART(MONTH,[Posting Date]) = 5 THEN SUM(Quantity) * -1 
	ELSE 0
END [Consumption M-5]
,CASE
	WHEN DATEPART(MONTH,[Posting Date]) = 6 THEN SUM(Quantity) * -1 
	ELSE 0
END [Consumption M-6]
,CASE
	WHEN DATEPART(MONTH,[Posting Date]) = 7 THEN SUM(Quantity) * -1 
	ELSE 0
END [Consumption M-7]
,CASE
	WHEN DATEPART(MONTH,[Posting Date]) = 8 THEN SUM(Quantity) * -1 
	ELSE 0
END [Consumption M-8]
,CASE
	WHEN DATEPART(MONTH,[Posting Date]) = 9 THEN SUM(Quantity) * -1 
	ELSE 0
END [Consumption M-9]
,CASE
	WHEN DATEPART(MONTH,[Posting Date]) = 10 THEN SUM(Quantity) * -1 
	ELSE 0
END [Consumption M-10]
,CASE
	WHEN DATEPART(MONTH,[Posting Date]) = 11 THEN SUM(Quantity) * -1 
	ELSE 0
END [Consumption M-11]
,CASE
	WHEN DATEPART(MONTH,[Posting Date]) = 12 THEN SUM(Quantity) * -1 
	ELSE 0
END [Consumption M-12]
		
FROM [ZYGO$Item Ledger Entry] ile

INNER JOIN ZYGO$Item i ON ile.[Item No_] = i.No_

WHERE [Posting Date] &gt;= @monthstart

AND ([Entry Type] = 1 --Sale

OR [Entry Type] = 5) --Consumption

AND [Item No_] = @item

GROUP BY DATEPART(MONTH,[Posting Date]), [Item No_]

)
,s22 AS
(
	SELECT
	
	 [Item No_] 
	,SUM([Consumption M-1]) [Consumption M-1]
	,SUM([Consumption M-2]) [Consumption M-2]
	,SUM([Consumption M-3]) [Consumption M-3]
	,SUM([Consumption M-4]) [Consumption M-4]
	,SUM([Consumption M-5]) [Consumption M-5]
	,SUM([Consumption M-6]) [Consumption M-6]
	,SUM([Consumption M-7]) [Consumption M-7]
	,SUM([Consumption M-8]) [Consumption M-8]
	,SUM([Consumption M-9]) [Consumption M-9]
	,SUM([Consumption M-10]) [Consumption M-10]
	,SUM([Consumption M-11]) [Consumption M-11]
	,SUM([Consumption M-12]) [Consumption M-12]
	

FROM s21

GROUP BY [Item No_]

)


INSERT INTO #TEMP
(
	 [Item] 
	,[Consumption M-1]
	,[Consumption M-2]
	,[Consumption M-3]
	,[Consumption M-4]
	,[Consumption M-5]
	,[Consumption M-6]
	,[Consumption M-7]
	,[Consumption M-8]
	,[Consumption M-9]
	,[Consumption M-10]
	,[Consumption M-11]
	,[Consumption M-12]
)

SELECT

	[Item No_] 
	,[Consumption M-1]
	,[Consumption M-2]
	,[Consumption M-3]
	,[Consumption M-4]
	,[Consumption M-5]
	,[Consumption M-6]
	,[Consumption M-7]
	,[Consumption M-8]
	,[Consumption M-9]
	,[Consumption M-10]
	,[Consumption M-11]
	,[Consumption M-12]

FROM s22

FETCH NEXT FROM simCursor INTO @item
END
CLOSE simCursor
DEALLOCATE simCursor;

WITH s1 as
(	--On Hand Nettable
	SELECT 
	[Item No_]
	,SUM(Quantity) Nettable
	FROM [ZYGO$Item Ledger Entry]
	WHERE [Non-Nettable] = 0
	GROUP BY [Item No_]

)
, s2 as
(	--Stock on Purchase Order
	SELECT
	I.No_
    ,COALESCE(SUM(L.[Outstanding Quantity]), '0.00') [Qty on PO ]
	FROM [ZYGO$Purchase Line] L 
    INNER JOIN [ZYGO$Item] I ON L.No_ = I.No_
    WHERE ([Replenishment System] = 0 and [Document Type] = 1
    and [Outstanding Quantity] &gt; 0)
	GROUP BY I.No_
)
, s3 as
(	--Qty on Sales Orders -- Type 2 = Item	Type 3 = Resource
	SELECT
	No_
    ,COALESCE(SUM([Outstanding Quantity]), 0) [Qty on SO]
    FROM [ZYGO$Sales Line]
    WHERE Type = 2 AND [Completely Shipped] = 0
	GROUP BY No_
)
, s4 as
(	--Qty on Service Orders  Type 1 = Item Type 2 = Resource
	SELECT
	No_
    ,COALESCE(SUM([Quantity]), 0) [Qty on Service Order]
    FROM [ZYGO$Service Line] WHERE [Type] = 1
    GROUP BY No_
)
, s5 as
(	--Qty on Inventory Request - Jobs
	SELECT
	No_
    ,COALESCE(SUM([Quantity]), 0) [Qty on Inventory Request]
    FROM [ZYGO$Job Journal Line]
    WHERE [Journal Template Name] = 'INVREQ'
	GROUP BY No_
)
, s6 as
(	--Qty on Production Order  --Status 2 = Firm Planned Status 3 = Released
	SELECT
	[Item No_]
    ,COALESCE(SUM([Remaining Quantity]), 0) [Qty on Production Order]
    FROM [ZYGO$Prod_ Order Line]
    WHERE [Remaining Quantity] &gt; 0 and [Status] in (2,3)
	GROUP BY [Item No_]
)
, s7 as
(
	SELECT
	[Item No_] ItemNo
    ,COALESCE(SUM([Remaining Quantity]), 0) F9   
    FROM [ZYGO$Prod_ Order Component]    
    WHERE 1=1    
    AND [Due Date] &lt;= DATEADD(m, 9, GETDATE())    
    AND Status in (2, 3)
	--AND [Shortcut Dimension 2 Code] like 'PPS%'
    GROUP BY [Item No_]      

UNION

	SELECT    
    No_ ItemNo
	,COALESCE(SUM([Quantity]), 0) F9   
    FROM [ZYGO$Sales Line]    
    WHERE    
    [Promised Delivery Date] &lt;= DATEADD(m, 9, GETDATE())    
	AND [Promised Delivery Date] &gt;= GETDATE()
    AND Type = 2 
	AND [Completely Shipped] = 0 
	--AND [Shortcut Dimension 2 Code] LIKE 'PPS%'
    GROUP BY [No_]

UNION

	SELECT    
    No_ ItemNo
	,COALESCE(SUM([Outstanding Quantity]), 0) F9   
    FROM [ZYGO$Service Line]    
    WHERE 1=1 
	--AND [Shortcut Dimension 2 Code] like 'PPS%'
	AND [Planned Delivery Date] &lt;= DATEADD(m, 9, GETDATE())
    AND [Type] = 1    
    GROUP BY  [No_]

UNION

	SELECT    
    No_ ItemNo
	,COALESCE(SUM([Outstanding Quantity]), 0) F9
    FROM [ZYGO$Job Journal Line]    
    WHERE    
    [Due Date] &lt;= DATEADD(m, 9, GETDATE())    
    AND [Journal Template Name] = 'INVREQ'
	--AND [Shortcut Dimension 2 Code] like 'PPS%'
    GROUP BY [No_] 

UNION

	SELECT
	[Item No_] ItemNo
    ,COALESCE(SUM([Expected Quantity]),0) F9   
    FROM [ZYGO$Planning Component]     
    WHERE    
    [Ref_ Order Status] = 1   --'PLANNED'    
    AND [Due Date] &lt;= DATEADD(m, 9, GETDATE())   
    --AND [Shortcut Dimension 2 Code] like '%PPS%'
    GROUP BY [Item No_] 
)
, s8 as
(
	select 

		ItemNo
		,SUM(F9) F9 

	from s7

	GROUP BY ItemNo
)
, s9 as
(
	SELECT
	[Item No_] ItemNo
    ,COALESCE(SUM([Remaining Quantity]), 0) F12   
    FROM [ZYGO$Prod_ Order Component]    
    WHERE 1=1    
    AND [Due Date] &lt;= DATEADD(m, 12, GETDATE())    
    AND Status in (2, 3)
	GROUP BY [Item No_]      

UNION

	SELECT    
    No_ ItemNo
	,COALESCE(SUM([Quantity]), 0) F12
    FROM [ZYGO$Sales Line]    
    WHERE    
    [Promised Delivery Date] &lt;= DATEADD(m, 12, GETDATE())    
	AND [Promised Delivery Date] &gt;= GETDATE()
    AND Type = 2 
	AND [Completely Shipped] = 0 
	GROUP BY [No_]

UNION

	SELECT    
    No_ ItemNo
	,COALESCE(SUM([Outstanding Quantity]), 0) F12
    FROM [ZYGO$Service Line]    
    WHERE 1=1 
	AND [Planned Delivery Date] &lt;= DATEADD(m, 12, GETDATE())
    AND [Type] = 1    
    GROUP BY  [No_]

UNION

	SELECT    
    No_ ItemNo
	,COALESCE(SUM([Outstanding Quantity]), 0) F12
    FROM [ZYGO$Job Journal Line]    
    WHERE    
    [Due Date] &lt;= DATEADD(m, 12, GETDATE())    
    AND [Journal Template Name] = 'INVREQ'
	GROUP BY [No_] 

UNION

	SELECT
	[Item No_] ItemNo
    ,COALESCE(SUM([Expected Quantity]),0) F12
    FROM [ZYGO$Planning Component]     
    WHERE    
    [Ref_ Order Status] = 1   --'PLANNED'    
    AND [Due Date] &lt;= DATEADD(m, 12, GETDATE())   
    GROUP BY [Item No_] 
)
, s10 as
(
	select 

		ItemNo
		,SUM(F12) F12 

	from s9

	GROUP BY ItemNo
)
,s112 AS
(
SELECT

[Item No_]
,SUM(l.Quantity)*-1 p

FROM [ZYGO$Item Ledger Entry] l

LEFT JOIN [ZYGO$Production Order] p ON l.[Order No_] = p.No_

WHERE

[Posting Date] &gt;= DATEADD(m, -12, GETDATE())

AND [Entry Type] = 1 --Sale

GROUP BY [Item No_]
),
s212 AS
(
SELECT

[Item No_]
,SUM(l.Quantity)*-1 p

FROM [ZYGO$Item Ledger Entry] l

LEFT JOIN [ZYGO$Production Order] p ON l.[Order No_] = p.No_

WHERE

[Posting Date] &gt;= DATEADD(m, -12, GETDATE())

AND ([Entry Type] = 5 --Consumption

AND [Order Type] = 1  --Production

AND LEN([Order No_]) &gt; 0)

AND p.Rework = 0  --not rework

GROUP BY [Item No_]
),
s312 AS
(
	SELECT

[Item No_]
,SUM(Quantity)*-1 p

FROM [ZYGO$Item Ledger Entry]

WHERE

[Posting Date] &gt;= DATEADD(m, -12, GETDATE())

AND [Entry Type] = 3  --Negative Adjustment

AND

(LEN([Global Dimension 1 Code]) &gt; 0 OR [Document No_] like 'PRIR%')

GROUP BY [Item No_]

), s412 AS
(
SELECT

*

FROM s112

UNION ALL

SELECT 

*

FROM s212

UNION ALL

SELECT

*

FROM s312
)
,s11 AS
(
SELECT

[Item No_]
,SUM(p) P12

FROM s412

GROUP BY [Item No_]
)

SELECT

i.No_
,i.Description
,EAU
,P6
,COALESCE(CONVERT(NUMERIC(10,0),s11.P12),0) P12
,F6
,COALESCE(CONVERT(NUMERIC(10,0),s8.F9),0) F9
,COALESCE(CONVERT(NUMERIC(10,0),s10.F12),0) F12
,CONVERT(NUMERIC(10,2),COALESCE(s1.Nettable, 0.00)) [Qty on hand Nettable]
,CASE [Replenishment System]
	WHEN 0 THEN 'Purchased'
	WHEN 1 THEN 'Manfuactured'
END 'Replenishment System'
,CASE
   WHEN LEN([Signal Code]) &gt; 0 THEN [Signal Code]  + '  ' + g.Description 
   WHEN LEN([Signal Code]) = 0 THEN ''
END [Signal Code]
,i.[Global Dimension 2 Code] [Business Segment]
,[Inventory Posting Group]
,[Gen_ Prod_ Posting Group]
,CASE
   WHEN LEN([Selection Code]) &gt; 0 THEN [Selection Code]  + '  ' + s.Description 
   WHEN LEN([Selection Code]) = 0 THEN ''       
END [Selection Code]
,FORMAT([Standard Cost], 'C', 'en-us') 'Standard Cost'
,CONVERT(NUMERIC(10,2),COALESCE(s1.Nettable, 0.00) * COALESCE([Standard Cost],0.00)) [Qty on hand nettable x Standard Cost]
,[Buyer Planner Code]
,CASE Vetted
	WHEN 0 THEN 'Vetted'
	WHEN 1 THEN 'Non-Vetted'
END Vetted
,COALESCE([Consumption M-1],0) [Consumption M-1]
,COALESCE([Consumption M-2],0) [Consumption M-2]
,COALESCE([Consumption M-3],0) [Consumption M-3]
,COALESCE([Consumption M-4],0) [Consumption M-4]
,COALESCE([Consumption M-5],0) [Consumption M-5]
,COALESCE([Consumption M-6],0) [Consumption M-6]
,COALESCE([Consumption M-7],0) [Consumption M-7]
,COALESCE([Consumption M-8],0) [Consumption M-8]
,COALESCE([Consumption M-9],0) [Consumption M-9]
,COALESCE([Consumption M-10],0) [Consumption M-10]
,COALESCE([Consumption M-11],0) [Consumption M-11]
,COALESCE([Consumption M-12],0) [Consumption M-12]
,i.[Phys Invt Counting Period Code]
,CASE i.SIM 
	WHEN 0 THEN '0'
	WHEN 1 THEN 'A1'
	WHEN 2 THEN 'A2'
	WHEN 3 THEN 'A3'
	WHEN 4 THEN 'B1'
	WHEN 5 THEN 'B2'
	WHEN 6 THEN 'B3'
	WHEN 7 THEN 'C1'
	WHEN 8 THEN 'C2'
	WHEN 9 THEN 'C3'
END [SIM]


FROM [ZYGO$Item] i

LEFT JOIN [ZYGO$Commodity] c ON i.[Commodity] = c.Code
LEFT JOIN [ZYGO$Product Types] p ON i.[Product Types] = p.Code
LEFT JOIN [ZYGO$Selection Codes] s ON i.[Selection Code] = s.Code
LEFT JOIN [ZYGO$Signal Code] g ON i.[Signal Code] = g.Code
LEFT JOIN [ZYGO$Item Group] ig ON i.[Item Group Code] = ig.Code
LEFT JOIN [ZYGO$Item Vendor] iv ON i.[No_] = iv.[Item No_] AND i.[Vendor No_] = iv.[Vendor No_]
LEFT JOIN [ZYGO$Vendor] v on i.[Vendor No_] = v.No_
LEFT JOIN s1 on s1.[Item No_] = i.No_
LEFT JOIN s2 on s2.[No_] = i.No_
LEFT JOIN s3 on s3.[No_] = i.No_
LEFT JOIN s4 on s4.[No_] = i.No_
LEFT JOIN s5 on s5.[No_] = i.No_
LEFT JOIN s6 on s6.[Item No_] = i.No_
LEFT JOIN s8 on s8.ItemNo = i.No_
LEFT JOIN s10 on s10.ItemNo = i.No_
LEFT JOIN s11 ON s11.[Item No_] = i.No_
LEFT JOIN #Temp t ON t.Item = i.No_ COLLATE SQL_Latin1_General_CP1_CI_AS

WHERE 1=1

and [Signal Code] != 'OBS'

and [Replenishment System] = 1 --Production Order</CommandText>
        <rd:UseGenericDesigner>true</rd:UseGenericDesigner>
      </Query>
      <Fields>
        <Field Name="No_">
          <DataField>No_</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Description">
          <DataField>Description</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="EAU">
          <DataField>EAU</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
        <Field Name="P6">
          <DataField>P6</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
        <Field Name="P12">
          <DataField>P12</DataField>
          <rd:TypeName>System.Decimal</rd:TypeName>
        </Field>
        <Field Name="F6">
          <DataField>F6</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
        <Field Name="F9">
          <DataField>F9</DataField>
          <rd:TypeName>System.Decimal</rd:TypeName>
        </Field>
        <Field Name="F12">
          <DataField>F12</DataField>
          <rd:TypeName>System.Decimal</rd:TypeName>
        </Field>
        <Field Name="Qty_on_hand_Nettable">
          <DataField>Qty on hand Nettable</DataField>
          <rd:TypeName>System.Decimal</rd:TypeName>
        </Field>
        <Field Name="Replenishment_System">
          <DataField>Replenishment System</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Signal_Code">
          <DataField>Signal Code</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Business_Segment">
          <DataField>Business Segment</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Inventory_Posting_Group">
          <DataField>Inventory Posting Group</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Gen__Prod__Posting_Group">
          <DataField>Gen_ Prod_ Posting Group</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Selection_Code">
          <DataField>Selection Code</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Standard_Cost">
          <DataField>Standard Cost</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Qty_on_hand_nettable_x_Standard_Cost">
          <DataField>Qty on hand nettable x Standard Cost</DataField>
          <rd:TypeName>System.Decimal</rd:TypeName>
        </Field>
        <Field Name="Buyer_Planner_Code">
          <DataField>Buyer Planner Code</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Vetted">
          <DataField>Vetted</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Consumption_M_1">
          <DataField>Consumption M-1</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
        <Field Name="Consumption_M_2">
          <DataField>Consumption M-2</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
        <Field Name="Consumption_M_3">
          <DataField>Consumption M-3</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
        <Field Name="Consumption_M_4">
          <DataField>Consumption M-4</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
        <Field Name="Consumption_M_5">
          <DataField>Consumption M-5</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
        <Field Name="Consumption_M_6">
          <DataField>Consumption M-6</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
        <Field Name="Consumption_M_7">
          <DataField>Consumption M-7</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
        <Field Name="Consumption_M_8">
          <DataField>Consumption M-8</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
        <Field Name="Consumption_M_9">
          <DataField>Consumption M-9</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
        <Field Name="Consumption_M_10">
          <DataField>Consumption M-10</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
        <Field Name="Consumption_M_11">
          <DataField>Consumption M-11</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
        <Field Name="Consumption_M_12">
          <DataField>Consumption M-12</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
        <Field Name="Phys_Invt_Counting_Period_Code">
          <DataField>Phys Invt Counting Period Code</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="SIM">
          <DataField>SIM</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
  </DataSets>
  <ReportSections>
    <ReportSection>
      <Body>
