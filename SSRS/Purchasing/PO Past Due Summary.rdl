<?xml version="1.0" encoding="utf-8"?>
<Report MustUnderstand="df" xmlns="http://schemas.microsoft.com/sqlserver/reporting/2016/01/reportdefinition" xmlns:rd="http://schemas.microsoft.com/SQLServer/reporting/reportdesigner" xmlns:df="http://schemas.microsoft.com/sqlserver/reporting/2016/01/reportdefinition/defaultfontfamily">
  <df:DefaultFontFamily>Segoe UI</df:DefaultFontFamily>
  <AutoRefresh>0</AutoRefresh>
  <DataSources>
    <DataSource Name="NAV">
      <DataSourceReference>NAV</DataSourceReference>
      <rd:SecurityType>None</rd:SecurityType>
      <rd:DataSourceID>4c32c7de-fa8e-4364-9e0e-286a4bd633fb</rd:DataSourceID>
    </DataSource>
  </DataSources>
  <DataSets>
    <DataSet Name="DataSet1">
      <Query>
        <DataSourceName>NAV</DataSourceName>
        <CommandText>WITH s1 AS
(
SELECT

COUNT(pl.[Line No_]) 'Total Count Past Due'
,SUM([Outstanding Amount]) 'Total Current Past Due Amount'
,[Purchaser Code]


FROM [ZYGO$Purchase Line] pl

INNER JOIN [ZYGO$Purchase Header] ph ON ph.No_ = pl.[Document No_]

WHERE

[Outstanding Quantity] &lt;&gt; 0

AND [Planned Receipt Date] &lt; CAST(GETDATE() as date)   --Friday past due when run on Friday

AND ph.[Document Type] IN (1,5)  --1= order, 5 = return order


GROUP BY [Purchaser Code]
)
,s2 AS
(
SELECT

COUNT(pl.[Line No_]) '1 Week Count'
,SUM([Outstanding Amount]) '1 Week Total Amount'
,[Purchaser Code]

FROM [ZYGO$Purchase Line] pl

INNER JOIN [ZYGO$Purchase Header] ph ON ph.No_ = pl.[Document No_]

WHERE

[Outstanding Quantity] &lt;&gt; 0

AND [Planned Receipt Date] between  DATEADD(week,-1,CAST(GETDATE() as date)) AND CAST(GETDATE()-1 as date) 

AND ph.[Document Type] IN (1,5)  --1= order, 5 = return order

GROUP BY [Purchaser Code]
)
,s2u AS
(
SELECT

COUNT(pl.[Line No_]) 'Older Count'
,SUM([Outstanding Amount]) 'Older Amount'
,[Purchaser Code]

FROM [ZYGO$Purchase Line] pl

INNER JOIN [ZYGO$Purchase Header] ph ON ph.No_ = pl.[Document No_]

WHERE

[Outstanding Quantity] &lt;&gt; 0

AND pl.[Planned Receipt Date] &lt; DATEADD(week,-1,CAST(GETDATE() as date))
 
AND ph.[Document Type] IN (1,5)  --1= order, 5 = return order

GROUP BY [Purchaser Code]
)
,s3 AS
(
SELECT

s1.*
,s2.[1 Week Count]
,s2.[1 Week Total Amount]

FROM s1 LEFT JOIN s2 ON s1.[Purchaser Code] = s2.[Purchaser Code]
)


SELECT


CASE 
	WHEN LEN(s3.[Purchaser Code]) &gt; 0 THEN s3.[Purchaser Code]
	ELSE ' No Purchaser'
 END [Purchaser Code]
,s3.[Total Count Past Due]
,s3.[Total Current Past Due Amount]
,COALESCE(s3.[1 Week Count],0)[1 Week Count]
,COALESCE(s3.[1 Week Total Amount],0) [1 Week Total Amount]
,COALESCE(s2u.[Older Count],0) [Older Count]
,COALESCE(s2u.[Older Amount],0) [Older Amount]


FROM  s3

LEFT JOIN s2u on s3.[Purchaser Code] = s2u.[Purchaser Code]

ORDER BY [Purchaser Code]</CommandText>
        <rd:UseGenericDesigner>true</rd:UseGenericDesigner>
      </Query>
      <Fields>
        <Field Name="Total_Count_Past_Due">
          <DataField>Total Count Past Due</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
        <Field Name="Purchaser_Code">
          <DataField>Purchaser Code</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Total_Current_Past_Due_Amount">
          <DataField>Total Current Past Due Amount</DataField>
          <rd:TypeName>System.Decimal</rd:TypeName>
        </Field>
        <Field Name="ID1_Week_Count">
          <DataField>1 Week Count</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
        <Field Name="ID1_Week_Total_Amount">
          <DataField>1 Week Total Amount</DataField>
          <rd:TypeName>System.Decimal</rd:TypeName>
        </Field>
        <Field Name="Older_Count">
          <DataField>Older Count</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
        <Field Name="Older_Amount">
          <DataField>Older Amount</DataField>
          <rd:TypeName>System.Decimal</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
  </DataSets>
