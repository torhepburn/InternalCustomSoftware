<?xml version="1.0" encoding="utf-8"?>
<Report MustUnderstand="df" xmlns="http://schemas.microsoft.com/sqlserver/reporting/2016/01/reportdefinition" xmlns:rd="http://schemas.microsoft.com/SQLServer/reporting/reportdesigner" xmlns:df="http://schemas.microsoft.com/sqlserver/reporting/2016/01/reportdefinition/defaultfontfamily">
  <df:DefaultFontFamily>Segoe UI</df:DefaultFontFamily>
  <AutoRefresh>0</AutoRefresh>
  <DataSources>
    <DataSource Name="DataSource1">
      <DataSourceReference>NAV</DataSourceReference>
      <rd:SecurityType>DataBase</rd:SecurityType>
      <rd:DataSourceID>8bf5abc9-e9b2-42d2-9264-ebbf5caf7ca3</rd:DataSourceID>
    </DataSource>
  </DataSources>
  <DataSets>
    <DataSet Name="DataSet1">
      <Query>
        <DataSourceName>DataSource1</DataSourceName>
        <CommandText>/*
             *  Get the list of MRP purchased parts for which reports are needed 
             *  use all worksheets 
             *  [Ref_ Order Type] = 1 = Purchase
             *  Type = 2 = Item
             */


select 

distinct 

r.No_
,r.[Buyer Planner Code]
,r.[Vendor No_]

from [ZYGO$Requisition Line] r

left join ZYGO$Item i on r.No_ = i.No_ 

WHERE 

0=0

AND r.[Ref_ Order Type] = 1

AND r.Type = 2

AND r.[Worksheet Template Name] = 'PLANNING'

AND r.[Journal Batch Name] = 'DEFAULT'

AND r.Quantity &gt; r.[Original Quantity]	/**/

AND i.[Selection Code] not like 'K%'

AND i.[Selection Code] not like 'CFM%'

AND [Action Message] NOT IN (3,5)

AND i.No_ &lt;&gt; 'SERVICE ITEM'

AND r.[Starting Date] &lt; (GETDATE() + 7)

/* specific to main	*/

AND i.[Selection Code] &lt;&gt; 'MMX'

AND i.Vetted &lt;&gt; '1'

AND i.[Item Group Code] &lt;&gt; 'VMI'

AND CHARINDEX('X', r.No_, 1) &lt;&gt; 1

AND [Reference Component] &lt;&gt; 1

AND i.[Stock Location] NOT IN ('IRV','IRV MRB')

ORDER BY

r.[Buyer Planner Code]
,r.[Vendor No_]
,r.No_</CommandText>
        <rd:UseGenericDesigner>true</rd:UseGenericDesigner>
      </Query>
      <Fields>
        <Field Name="No_">
          <DataField>No_</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Buyer_Planner_Code">
          <DataField>Buyer Planner Code</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Vendor_No_">
          <DataField>Vendor No_</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
    <DataSet Name="DataSet2">
      <Query>
        <DataSourceName>DataSource1</DataSourceName>
        <CommandText>WITH s1 AS

(
select 

distinct 

r.No_
,r.[Buyer Planner Code]
,r.[Vendor No_]

from [ZYGO$Requisition Line] r

left join ZYGO$Item i on r.No_ = i.No_ 

WHERE 

0=0

AND r.[Ref_ Order Type] = 1

AND r.Type = 2

AND r.[Worksheet Template Name] = 'PLANNING'

AND r.[Journal Batch Name] = 'DEFAULT'

AND r.Quantity &gt; r.[Original Quantity]	/**/

AND i.[Selection Code] not like 'K%'

AND i.[Selection Code] not like 'CFM%'

AND [Action Message] NOT IN (3,5)

AND i.No_ &lt;&gt; 'SERVICE ITEM'

AND r.[Starting Date] &lt; (GETDATE() + 7)

/* specific to main	*/

AND i.[Selection Code] &lt;&gt; 'MMX'

AND i.Vetted &lt;&gt; '1'

AND i.[Item Group Code] &lt;&gt; 'VMI'

AND CHARINDEX('X', r.No_, 1) &lt;&gt; 1

AND [Reference Component] &lt;&gt; 1

AND i.[Stock Location] NOT IN ('IRV','IRV MRB')
)

Select 

COUNT(s1.No_) ListCount

FROM s1
</CommandText>
      </Query>
      <Fields>
        <Field Name="ListCount">
          <DataField>ListCount</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
  </DataSets>
