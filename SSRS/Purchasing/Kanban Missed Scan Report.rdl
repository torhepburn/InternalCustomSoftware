<?xml version="1.0" encoding="utf-8"?>
<Report MustUnderstand="df" xmlns="http://schemas.microsoft.com/sqlserver/reporting/2016/01/reportdefinition" xmlns:rd="http://schemas.microsoft.com/SQLServer/reporting/reportdesigner" xmlns:df="http://schemas.microsoft.com/sqlserver/reporting/2016/01/reportdefinition/defaultfontfamily">
  <df:DefaultFontFamily>Segoe UI</df:DefaultFontFamily>
  <AutoRefresh>0</AutoRefresh>
  <DataSources>
    <DataSource Name="NAV">
      <DataSourceReference>NAV</DataSourceReference>
      <rd:SecurityType>None</rd:SecurityType>
      <rd:DataSourceID>6c2ebd3c-8476-4a45-9fac-6de484abbd14</rd:DataSourceID>
    </DataSource>
  </DataSources>
  <DataSets>
    <DataSet Name="DataSet1">
      <Query>
        <DataSourceName>NAV</DataSourceName>
        <CommandText>WITH s1 AS
(
select 

No_ [Item No_]
,Description
,[Reorder Quantity]
,CASE([Replenishment System])
	WHEN 0 THEN 'Purchased'
	WHEN 1 THEN 'Manufactured'
END ReplenishmentSystem
,COALESCE([No_ of Bins],0) Bins
,P6,F6

from ZYGO$Item where [Selection Code] in ('KBP','KBM') AND P6 &gt; 0 and F6 &gt;0
)
, s2 AS
(
	SELECT

	l.[Item No_]
	,SUM( Quantity) OnHand

	FROM [ZYGO$Item Ledger Entry] l INNER JOIN s1 ON l.[Item No_] = s1.[Item No_] 

	WHERE [Non-Nettable] = 0
	
	GROUP BY l.[Item No_]
)
,s3 AS
(
	SELECT

	l.No_ [Item No_]
	,COALESCE(SUM([Outstanding Quantity]), '0') OnPO
	
	FROM [ZYGO$Purchase Line] l

	INNER JOIN s1  ON l.No_ = s1.[Item No_]
	
	WHERE ([ReplenishmentSystem] = 'Purchased' and [Document Type] = 1 and [Outstanding Quantity] &gt; 0)

	GROUP BY l.No_
)	
,s4 AS
(
	SELECT

	l.[Item No_]
	,COALESCE(SUM([Remaining Quantity]), '0') OnProdOrd
	
	FROM [ZYGO$Prod_ Order Line] l

	INNER JOIN s1  ON l.[Item No_] = s1.[Item No_]
	
	WHERE (Status IN (2,3) and [Remaining Quantity] &gt; 0)

	GROUP BY l.[Item No_]

	
)	
,s5 AS
(
SELECT

s1.[Item No_]
,s1.Description
,ReplenishmentSystem
,COALESCE(s1.Bins,0) Bins
,COALESCE(s1.Bins -1,0) q
,COALESCE(s1.[Reorder Quantity],0) [Reorder Quantity]
,P6
,F6


,s2.OnHand
,COALESCE(s3.OnPO,0) OnPO
,COALESCE(s4.OnProdOrd,0) OnProdOrd

FROM s1

--ORDER BY  s1.Bins -1
LEFT JOIN s2 on s1.[Item No_] = s2.[Item No_]
LEFT JOIN s3 on s1.[Item No_] = s3.[Item No_]
LEFT JOIN s4 on s1.[Item No_] = s4.[Item No_]
)
,s6 AS
(
	select distinct

	[Item No_]
	,[Bin Code]

	from  [ZYGO$Bin Content] 

	where  [Default] = 1 AND [Bin Code] NOT LIKE '%MRB%'

	AND [Bin Code] NOT LIKE '%SER%'

	AND [Bin Code] NOT LIKE '%OFS%'

	AND [Bin Code] NOT LIKE '%SVC%'
)

SELECT

s5.[Item No_]
,Description
,Bins
,[Reorder Quantity]
,OnHand
,OnPO
,OnProdOrd
,ReplenishmentSystem
,[Bin Code] DefaultBin

FROM s5 

LEFT JOIN s6 on s5.[Item No_] = s6.[Item No_]

WHERE OnHand + OnPO + OnProdOrd &lt;=q * [Reorder Quantity]
</CommandText>
        <rd:UseGenericDesigner>true</rd:UseGenericDesigner>
      </Query>
      <Fields>
        <Field Name="Item_No_">
          <DataField>Item No_</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Description">
          <DataField>Description</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Bins">
          <DataField>Bins</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
        <Field Name="Reorder_Quantity">
          <DataField>Reorder Quantity</DataField>
          <rd:TypeName>System.Decimal</rd:TypeName>
        </Field>
        <Field Name="OnHand">
          <DataField>OnHand</DataField>
          <rd:TypeName>System.Decimal</rd:TypeName>
        </Field>
        <Field Name="OnPO">
          <DataField>OnPO</DataField>
          <rd:TypeName>System.Decimal</rd:TypeName>
        </Field>
        <Field Name="OnProdOrd">
          <DataField>OnProdOrd</DataField>
          <rd:TypeName>System.Decimal</rd:TypeName>
        </Field>
        <Field Name="ReplenishmentSystem">
          <DataField>ReplenishmentSystem</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="DefaultBin">
          <DataField>DefaultBin</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
  </DataSets>
