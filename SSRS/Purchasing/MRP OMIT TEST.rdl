        <Field Name="Best">
          <DataField>Best</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="M">
          <DataField>M</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
        <Field Name="ID24am">
          <DataField>24am</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="CN">
          <DataField>CN</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
        <Field Name="ID25am">
          <DataField>25am</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
  </DataSets>
