<?xml version="1.0" encoding="utf-8"?>
<Report xmlns="http://schemas.microsoft.com/sqlserver/reporting/2016/01/reportdefinition" xmlns:rd="http://schemas.microsoft.com/SQLServer/reporting/reportdesigner" xmlns:df="http://schemas.microsoft.com/sqlserver/reporting/2016/01/reportdefinition/defaultfontfamily" MustUnderstand="df">
  <df:DefaultFontFamily>Segoe UI</df:DefaultFontFamily>
  <AutoRefresh>0</AutoRefresh>
  <DataSources>
    <DataSource Name="NAV">
      <DataSourceReference>NAV</DataSourceReference>
      <rd:SecurityType>None</rd:SecurityType>
      <rd:DataSourceID>178d3ce9-c76b-428d-9b11-a9f169b3e206</rd:DataSourceID>
    </DataSource>
  </DataSources>
  <DataSets>
    <DataSet Name="DataSet1">
      <Query>
        <DataSourceName>NAV</DataSourceName>
        <CommandText>WITH s1 AS
(
SELECT
 CASE [Action Message]
	WHEN 1 THEN 'New'
	WHEN 2 THEN 'Change Quantity'
	WHEN 3 THEN 'Reschedule'
	WHEN 4 THEN 'Reschedule and Change Quantity'
	WHEN 5 THEN 'Cancel'
 END [Action Message]
,l.[Buyer Planner Code]
,pl.[Buy-from Vendor No_]
,v.Name [Vendor]
,CASE 
	WHEN CONVERT(varchar(10),[Original Due Date], 1) = '01/01/53' THEN ''
	ELSE CONVERT(varchar(10),[Original Due Date], 1)
END [Original Due Date]

,CASE 
	WHEN CONVERT(varchar(10),pl.[Requested Receipt Date], 1) = '01/01/53' THEN ''
	ELSE CONVERT(varchar(10),pl.[Requested Receipt Date], 1)
END [PO Requested Receipt Date]
,CASE 
	WHEN CONVERT(varchar(10),pl.[Promised Receipt Date], 1) = '01/01/53' THEN ''
	ELSE CONVERT(varchar(10),pl.[Promised Receipt Date], 1)
END [Promised Receipt Date]
,CASE 
	WHEN [Action Message] = 3 THEN
		CASE
			WHEN [Due Date] &gt; [Original Due Date] THEN 'Push Out'
			WHEN [Due Date] &lt; [Original Due Date] THEN 'Pull In'
			ELSE ''
		END
		ELSE ''
	END Direction
,CONVERT(varchar(10),[Due Date], 1) [Due Date]
,l.[Location Code]
,[Ref_ Order No_]
--,SUBSTRING(CONVERT(varchar(10),[Ref_ Line No_]), 1, LEN([Ref_ Line No_])-3) [PO Line No_]
,l.No_ [Part Number]
,l.Description
,FORMAT([Remaining Quantity],'N0', 'en-us') [Order Quantity]
,CASE COALESCE(pl.[Best Delivery],0) 
     WHEN 0 THEN '' 
     WHEN 1 THEN 'YES' 
 END Best


FROM [ZYGO$Requisition Line] l

LEFT JOIN ZYGO$Item i on l.No_ = i.No_

LEFT JOIN [ZYGO$Purchase Line] pl 

ON l.[Ref_ Order No_] = pl.[Document No_]

AND l.[Ref_ Line No_] = pl.[Line No_]

LEFT JOIN ZYGO$Vendor v on pl.[Buy-from Vendor No_] = v.No_

WHERE

[Ref_ Order Type] = 1	--Purchase

AND l.[Replenishment System] = 0	--Purchase

--and [Action Message] in (3) -- Reschedule

AND [Worksheet Template Name] = 'PLANNING'

AND [Journal Batch Name] = 'DEFAULT'

--AND [Remaining Quantity] &gt; 0

)
,sr1 AS
(
select distinct

r.No_
,r.[Buyer Planner Code]
,'Reschedule' [Action Message]
,CASE
	WHEN [Due Date] &gt; [Original Due Date] THEN 'Push Out'
	WHEN [Due Date] &lt; [Original Due Date] THEN 'Pull In'
	ELSE ''
END Direction
,r.[Original Due Date]
,r.[Due Date]
,r.[Order Date]

,CASE COALESCE(pl.[Best Delivery],0) 
     WHEN 0 THEN '' 
     WHEN 1 THEN 'YES' 
 END Best

 from [ZYGO$Requisition Line] r

INNER JOIN ZYGO$Item i ON r.No_ = i.No_

LEFT JOIN [ZYGO$Purchase Line] pl 

ON r.[Ref_ Order No_] = pl.[Document No_]

AND r.[Ref_ Line No_] = pl.[Line No_]


WHERE [Action Message] = 3

 AND [Ref_ Order Type] = 1                     -- 1 = purchase
 AND r.Type = 2                                --   // type 2 = item
 AND i.[Replenishment System] = 0              --    //0 = purchased 
 AND [Worksheet Template Name] = 'PLANNING' 
 AND [Journal Batch Name] = 'DEFAULT'
 AND i.[Selection Code] not like 'CFM%' 
 AND i.No_ &lt;&gt; '9999' 
 AND i.No_ != 'SERVICE ITEM' 
 )
 ,sr2 AS
 (
 SELECT * FROM sr1 WHERE

 Direction = 'Push Out'

 AND Best = 'YES'
 )
 ,sr3 AS
 (
 SELECT

 COUNT(Direction) MessageCount
 ,Direction
 ,[Buyer Planner Code]

 FROM sr2

 GROUP BY [Buyer Planner Code],Direction
 )
,s2 AS
(
SELECT

COUNT([Action Message]) MessageCount
,[Buyer Planner Code]
,[Action Message]
,Direction

FROM s1 

GROUP BY 


[Buyer Planner Code]
,[Action Message]
,Direction
)


/*
SELECT 




	
s2.MessageCount - COALESCE(sr3.MessageCount,0) NetMessageCount
--,s2.MessageCount A
,COALESCE(sr3.MessageCount,0) 'OmittedCount'
,s2.[Action Message]
,s2.[Buyer Planner Code]
,s2.Direction

FROM s2

LEFT JOIN sr3 ON s2.[Buyer Planner Code] = sr3.[Buyer Planner Code] AND s2.Direction = sr3.Direction


ORDER BY s2.[Buyer Planner Code], [Action Message],s2.Direction


*/

,s21 AS
(
select

COUNT([Action Message]) MessageCount
,[Action Message]
,[Part Number]

from s1

WHERE [Action Message] = 'New'

GROUP BY [Part Number], [Action Message]
)
,s22 AS
(
	select

COUNT([Action Message]) MessageCount
,[Action Message]
,[Part Number]

from s1

WHERE [Action Message] = 'Change Quantity'

GROUP BY [Part Number], [Action Message]
)
,s23 AS
(
select

COUNT([Action Message]) MessageCount
,[Action Message]
,Direction
,[Part Number]
,Best

from s1

WHERE [Action Message] = 'Reschedule'

GROUP BY [Part Number], [Action Message],Direction,Best
)
,s24 AS
(
select

COUNT([Action Message]) MessageCount
,[Action Message]
,[Part Number]

from s1

WHERE [Action Message] = 'Reschedule and Change Quantity'

GROUP BY [Part Number], [Action Message]
)

,s25 AS
(
select

COUNT([Action Message]) MessageCount
,[Action Message]
,[Part Number]

from s1

WHERE [Action Message] = 'Cancel'

GROUP BY [Part Number], [Action Message]
)
,s26 AS
(
select 

No_
,s21.MessageCount N
,s21.[Action Message] '21am'
,s22.MessageCount C
,s22.[Action Message] '22am'
,s23.MessageCount R
,s23.[Action Message] '23am'
,s23.Direction
,s23.Best
,s24.MessageCount M
,s24.[Action Message] '24am'
,s25.MessageCount CN
,s25.[Action Message] '25am'

from ZYGO$Item i


LEFT JOIN s21 ON i.No_ = s21.[Part Number]
LEFT JOIN s22 ON i.No_ = s22.[Part Number]
LEFT JOIN s23 ON i.No_ = s23.[Part Number]
LEFT JOIN s24 ON i.No_ = s24.[Part Number]
LEFT JOIN s25 ON i.No_ = s25.[Part Number]

WHERE i.[Replenishment System] = 0
)


SELECT


*

FROM s26

WHERE R &gt; 0

AND Direction = 'Push Out'

AND Best = 'YES'</CommandText>
        <rd:UseGenericDesigner>true</rd:UseGenericDesigner>
      </Query>
      <Fields>
        <Field Name="No_">
          <DataField>No_</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="N">
          <DataField>N</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
        <Field Name="ID21am">
