<?xml version="1.0" encoding="utf-8"?>
<Report MustUnderstand="df" xmlns="http://schemas.microsoft.com/sqlserver/reporting/2016/01/reportdefinition" xmlns:rd="http://schemas.microsoft.com/SQLServer/reporting/reportdesigner" xmlns:df="http://schemas.microsoft.com/sqlserver/reporting/2016/01/reportdefinition/defaultfontfamily">
  <df:DefaultFontFamily>Segoe UI</df:DefaultFontFamily>
  <AutoRefresh>0</AutoRefresh>
  <DataSources>
    <DataSource Name="DataSource1">
      <ConnectionProperties>
        <DataProvider>SQL</DataProvider>
        <ConnectString>Data Source=pa-hor-as408.ametek.com;Initial Catalog=ZYGO-NAV-PROD</ConnectString>
      </ConnectionProperties>
      <rd:SecurityType>DataBase</rd:SecurityType>
      <rd:DataSourceID>231c3cc6-a72e-43c7-86d5-7b7a2548bc6e</rd:DataSourceID>
    </DataSource>
  </DataSources>
  <DataSets>
    <DataSet Name="DataSet1">
      <Query>
        <DataSourceName>DataSource1</DataSourceName>
        <CommandText>SELECT 

CASE [Planning Flexibility]
	WHEN 1 then'NONE'
	WHEN 0 THEN 'UNLIMITED'
END [Planning Flexibility]
,CASE pl.Type
	WHEN 2 THEN 'ITEM'
END [Type]
,[Document No_]
,[PO Line No_]
,[Buy-from Vendor Name]
,pl.No_
,pl.Description
--,Quantity
,[Outstanding Quantity]
--,[Qty_ to Receive]
,pl.[Expected Receipt Date]

 FROM [ZYGO$Purchase Line] pl

INNER JOIN [ZYGO$Purchase Header] ph ON pl.[Document No_] = ph.No_
INNER JOIN ZYGO$Item i on i.No_ = pl.No_

WHERE [Planning Flexibility] = 0

--AND [Qty_ to Receive] &gt; 0
AND [Outstanding Quantity] &gt; 0

AND pl.Type = 2

AND pl.No_ != '9999'

AND [Selection Code] != 'KBP'

--AND ph.No_ = 'P800592'

ORDER BY pl.[Expected Receipt Date] desc</CommandText>
        <rd:UseGenericDesigner>true</rd:UseGenericDesigner>
      </Query>
      <Fields>
        <Field Name="Planning_Flexibility">
          <DataField>Planning Flexibility</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Type">
          <DataField>Type</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Document_No_">
          <DataField>Document No_</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="PO_Line_No_">
          <DataField>PO Line No_</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
        <Field Name="Buy_from_Vendor_Name">
          <DataField>Buy-from Vendor Name</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="No_">
          <DataField>No_</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Description">
          <DataField>Description</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Outstanding_Quantity">
          <DataField>Outstanding Quantity</DataField>
          <rd:TypeName>System.Decimal</rd:TypeName>
        </Field>
        <Field Name="Expected_Receipt_Date">
          <DataField>Expected Receipt Date</DataField>
          <rd:TypeName>System.DateTime</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
  </DataSets>
