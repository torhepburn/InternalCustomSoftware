<?xml version="1.0" encoding="utf-8"?>
<Report MustUnderstand="df" xmlns="http://schemas.microsoft.com/sqlserver/reporting/2016/01/reportdefinition" xmlns:rd="http://schemas.microsoft.com/SQLServer/reporting/reportdesigner" xmlns:df="http://schemas.microsoft.com/sqlserver/reporting/2016/01/reportdefinition/defaultfontfamily">
  <df:DefaultFontFamily>Segoe UI</df:DefaultFontFamily>
  <AutoRefresh>0</AutoRefresh>
  <DataSources>
    <DataSource Name="DataSource1">
      <ConnectionProperties>
        <DataProvider>SQL</DataProvider>
        <ConnectString>Data Source=pa-hor-as408;Initial Catalog=ZYGO-NAV-PROD</ConnectString>
      </ConnectionProperties>
      <rd:SecurityType>DataBase</rd:SecurityType>
      <rd:DataSourceID>7c68109b-3b3d-4224-b777-85e4f7ab30f2</rd:DataSourceID>
    </DataSource>
  </DataSources>
  <DataSets>
    <DataSet Name="DataSet1">
      <Query>
        <DataSourceName>DataSource1</DataSourceName>
        <CommandText>WITH s1 AS
(
	SELECT 

	r.[Prod_ Order No_]
	,r.[Routing No_] [Parent Item Number]
	,p.[Description] [Parent Item Description]
	,p.[Remaining Quantity] [Parent Item Remaining Quantity]
	,r.[Description]
	
	,r.[Ending Date] [Prod Order Ending Date]
	,l.[Document No_] [Parent Item PO]
	,l.[Expected Receipt Date]
	,l.[Outstanding Quantity] [Parent PO Outstanding Quantity]
	,i.[Buyer Planner Code]
	,i.[Stock Location]

	FROM [ZYGO$Prod_ Order Routing Line] r

	LEFT JOIN [ZYGO$Purchase Line] l ON r.[Prod_ Order No_] = l.[Prod_ Order No_]

	LEFT JOIN [ZYGO$Prod_ Order Line] p ON r.[Prod_ Order No_] = p.[Prod_ Order No_]

	LEFT JOIN ZYGO$Item i ON r.[Routing No_] = i.No_

	WHERE r.[Status] = 3

	AND LEFT (r.Description, 8) = 'Subcontr'

	AND p.[Remaining Quantity] &gt; 0

	AND l.[Outstanding Quantity] &gt; 0
)
, s2 AS
(
select s1.* 

,c.[Item No_] [Raw Item Number]
,c.Description [Raw Item Description]
,c.[Remaining Quantity] [Raw Remaining Quantity]

FROM s1

LEFT JOIN [ZYGO$Prod_ Order Component] c ON s1.[Prod_ Order No_] = c.[Prod_ Order No_]

WHERE [Parent Item PO] is not null

and c.[Remaining Quantity] &gt; 0

AND c.[Reference Component] &lt;&gt; 1

)
, s3 AS
(
	SELECT 
	
	SUM(Quantity) [Raw OH]
	, [Item No_] 
	
	FROM [ZYGO$Item Ledger Entry]

	WHERE [Item No_] IN (Select [Raw Item Number] from s2)

	GROUP BY [Item No_]
)
, s4 AS
(
	SELECT s2.*, COALESCE([Raw OH], 0) [Raw OH] FROM s2

	left join s3 on s2.[Raw Item Number] = s3.[Item No_]
)
, s5 AS
(
	SELECT 

	No_
	,[Outstanding Quantity]
	,[Expected Receipt Date]
	,[Document No_]

	FROM [ZYGO$Purchase Line] 

	WHERE No_ IN (SELECT [Raw Item Number] FROM s4)

	AND [Outstanding Quantity] &gt; 0
)
,s6 AS
(
SELECT DISTINCT

s4.*
,COALESCE(s5.[Outstanding Quantity],0) [Raw PO Outstanding Quantity]
,COALESCE(s5.[Expected Receipt Date],'') [Raw PO Expected Receipt Date]
,COALESCE(s5.[Document No_],'') [Raw PO Number]

FROM s4 

LEFT JOIN s5 ON s4.[Raw Item Number] = s5.No_
)

SELECT 

s6.* 
,sfo.[Last Date Modified]
FROM s6

LEFT JOIN [ZYGO$Production Order] sfo ON s6.[Prod_ Order No_] = sfo.No_

ORDER BY [Raw Item Number] </CommandText>
        <rd:UseGenericDesigner>true</rd:UseGenericDesigner>
      </Query>
      <Fields>
        <Field Name="Prod__Order_No_">
          <DataField>Prod_ Order No_</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
