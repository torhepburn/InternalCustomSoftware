<?xml version="1.0" encoding="utf-8"?>
<Report MustUnderstand="df" xmlns="http://schemas.microsoft.com/sqlserver/reporting/2016/01/reportdefinition" xmlns:rd="http://schemas.microsoft.com/SQLServer/reporting/reportdesigner" xmlns:df="http://schemas.microsoft.com/sqlserver/reporting/2016/01/reportdefinition/defaultfontfamily">
  <df:DefaultFontFamily>Segoe UI</df:DefaultFontFamily>
  <AutoRefresh>0</AutoRefresh>
  <DataSources>
    <DataSource Name="DataSource1">
      <ConnectionProperties>
        <DataProvider>SQL</DataProvider>
        <ConnectString>Data Source=CT-MID-SQL11;Initial Catalog=BuildingLog</ConnectString>
      </ConnectionProperties>
      <rd:SecurityType>DataBase</rd:SecurityType>
      <rd:DataSourceID>7ee5843c-6020-4f5a-ae40-a233de5c1691</rd:DataSourceID>
    </DataSource>
  </DataSources>
  <DataSets>
    <DataSet Name="DataSet1">
      <Query>
        <DataSourceName>DataSource1</DataSourceName>
        <CommandText>select

EmployeeName
,CASE ValidCovidTest
	WHEN 0 THEN 'NO'
	WHEN 1 THEN 'YES'
END ValidCovidTest
,HighTemperature
,l.LogDate [ScanDate]
,l.CovidTestDate [Logged COVID Test Date]
,d.CovidTestDate [On File COVID Test Date]
, DATEDIFF(d,l.covidtestdate, d.CovidTestDate) Difference 

from covidlog l inner join EmployeeData d on l.AMETEK_ID = d.AmetekNumber

ORDER BY id desc</CommandText>
        <rd:UseGenericDesigner>true</rd:UseGenericDesigner>
      </Query>
      <Fields>
        <Field Name="EmployeeName">
          <DataField>EmployeeName</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="ValidCovidTest">
          <DataField>ValidCovidTest</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="HighTemperature">
          <DataField>HighTemperature</DataField>
          <rd:TypeName>System.Boolean</rd:TypeName>
        </Field>
        <Field Name="ScanDate">
          <DataField>ScanDate</DataField>
          <rd:TypeName>System.DateTime</rd:TypeName>
        </Field>
        <Field Name="Logged_COVID_Test_Date">
          <DataField>Logged COVID Test Date</DataField>
          <rd:TypeName>System.DateTime</rd:TypeName>
        </Field>
        <Field Name="On_File_COVID_Test_Date">
          <DataField>On File COVID Test Date</DataField>
          <rd:TypeName>System.DateTime</rd:TypeName>
        </Field>
        <Field Name="Difference">
          <DataField>Difference</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
  </DataSets>
