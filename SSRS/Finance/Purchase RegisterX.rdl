<?xml version="1.0" encoding="utf-8"?>
<Report MustUnderstand="df" xmlns="http://schemas.microsoft.com/sqlserver/reporting/2016/01/reportdefinition" xmlns:rd="http://schemas.microsoft.com/SQLServer/reporting/reportdesigner" xmlns:df="http://schemas.microsoft.com/sqlserver/reporting/2016/01/reportdefinition/defaultfontfamily">
  <df:DefaultFontFamily>Segoe UI</df:DefaultFontFamily>
  <AutoRefresh>0</AutoRefresh>
  <DataSources>
    <DataSource Name="DataSource1">
      <ConnectionProperties>
        <DataProvider>SQL</DataProvider>
        <ConnectString>Data Source=pa-hor-as408.ametek.com;Initial Catalog=ZYGO-NAV-PROD</ConnectString>
      </ConnectionProperties>
      <rd:SecurityType>DataBase</rd:SecurityType>
      <rd:DataSourceID>addb8d30-0746-4c1f-9222-3c42e11b2a4e</rd:DataSourceID>
    </DataSource>
  </DataSources>
  <DataSets>
    <DataSet Name="DataSet1">
      <Query>
        <DataSourceName>DataSource1</DataSourceName>
        <QueryParameters>
          <QueryParameter Name="@StartDate">
            <Value>=Parameters!StartDate.Value</Value>
            <rd:UserDefined>true</rd:UserDefined>
          </QueryParameter>
          <QueryParameter Name="@endDate">
            <Value>=Parameters!EndDate.Value</Value>
            <rd:UserDefined>true</rd:UserDefined>
          </QueryParameter>
          <QueryParameter Name="@GLAccountNo">
            <Value>=Parameters!GLAccountNo.Value</Value>
            <rd:UserDefined>true</rd:UserDefined>
          </QueryParameter>
          <QueryParameter Name="@DocumentType">
            <Value>=Parameters!DocumentType.Value</Value>
            <rd:UserDefined>true</rd:UserDefined>
          </QueryParameter>
          <QueryParameter Name="@Segment">
            <Value>=Parameters!Segment.Value</Value>
            <rd:UserDefined>true</rd:UserDefined>
          </QueryParameter>
        </QueryParameters>
        <CommandText>SELECT

gle.[Posting Date]
,CASE gle.[Document Type]
	WHEN 1 THEN 'Payment'
	WHEN 2 THEN 'Invoice'
	WHEN 3 THEN 'Credit Memo'
	WHEN 4 THEN 'Finance Charge Memo'
	WHEN 5 THEN 'Reminder'
	WHEN 6 THEN 'Refund
	'
	ELSE ''
END [Document Type]
,gle.[Document No_]
,CASE
	WHEN COALESCE(prh.No_,'') = '' AND COALESCE(pih.[No_],'') = '' THEN 'gle'
	WHEN COALESCE(prh.No_,'') = '' THEN 'PInv ' + COALESCE(pih.[No_],'')
	WHEN COALESCE(pih.No_,'') = ''  THEN 'PRcpt ' + COALESCE(prh.[No_],'')
	END [Source]
,CASE 
	WHEN COALESCE(prh.[Order No_],'') = '' THEN COALESCE(pih.[Order No_],'')
	WHEN COALESCE(pih.[Order No_],'') = '' THEN COALESCE(prh.[Order No_],'')
END [PO Number]
,CASE
	WHEN COALESCE(prh.[Pay-to Vendor No_],'')= '' THEN COALESCE(pih.[Pay-to Vendor No_],'')
	WHEN COALESCE(pih.[Pay-to Vendor No_],'')= '' THEN COALESCE(prh.[Pay-to Vendor No_],'')
END [Vendor Number]
,CASE
	WHEN COALESCE(prh.[Pay-to Name],'') = '' THEN COALESCE(pih.[Pay-to Name],'')
	WHEN COALESCE(pih.[Pay-to Name],'') = '' THEN COALESCE(prh.[Pay-to Name],'')
END [Vendor Name]
,[G_L Account No_]
,gle.Amount
,gle.[Global Dimension 2 Code] [Segment]
,CASE
	WHEN COALESCE(gle.[External Document No_],'') != ''  THEN COALESCE(pih.[Vendor Invoice No_],'')
	WHEN COALESCE(gle.[External Document No_],'') != '' THEN gle.[External Document No_]
	ELSE ''
END [External Document No_]
,CASE
	WHEN COALESCE(prh.[Vendor Posting Group],'') = '' THEN COALESCE(pih.[Vendor Posting Group],'') 
	WHEN COALESCE(pih.[Vendor Posting Group],'') = '' THEN COALESCE(prh.[Vendor Posting Group],'') 
END [Vendor Posting Group]
,gle.[User ID]

FROM [ZYGO$G_L Entry] gle

LEFT JOIN [ZYGO$Purch_ Rcpt_ Header] prh on gle.[Document No_] = prh.[No_]

AND prh.[Posting Date] = gle.[Posting Date]

LEFT JOIN [ZYGO$Purch_ Inv_ Header] pih on gle.[Document No_] = pih.[No_]

AND pih.[Posting Date] = gle.[Posting Date]

WHERE gle.[G_L Account No_] IN (@GLAccountNo)

AND (gle.[Posting Date] &gt;= @StartDate and gle.[Posting Date] &lt;=@endDate)

AND gle.[Global Dimension 2 Code] IN (@Segment)

AND gle.[Document Type] in (@DocumentType)

ORDER BY gle.[Posting Date]</CommandText>
        <rd:UseGenericDesigner>true</rd:UseGenericDesigner>
      </Query>
      <Fields>
        <Field Name="Posting_Date">
          <DataField>Posting Date</DataField>
          <rd:TypeName>System.DateTime</rd:TypeName>
        </Field>
        <Field Name="Document_Type">
          <DataField>Document Type</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Document_No_">
          <DataField>Document No_</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Source">
          <DataField>Source</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="PO_Number">
          <DataField>PO Number</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Vendor_Number">
          <DataField>Vendor Number</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Vendor_Name">
          <DataField>Vendor Name</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="G_L_Account_No_">
          <DataField>G_L Account No_</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Amount">
          <DataField>Amount</DataField>
          <rd:TypeName>System.Decimal</rd:TypeName>
        </Field>
        <Field Name="Segment">
          <DataField>Segment</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="External_Document_No_">
          <DataField>External Document No_</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="User_ID">
          <DataField>User ID</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Vendor_Posting_Group">
          <DataField>Vendor Posting Group</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
    <DataSet Name="DataSet2">
      <Query>
        <DataSourceName>DataSource1</DataSourceName>
        <CommandText>select distinct 

[Global Dimension 2 Code] Segment

from [ZYGO$G_L Entry]</CommandText>
      </Query>
      <Fields>
        <Field Name="Segment">
          <DataField>Segment</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
  </DataSets>
