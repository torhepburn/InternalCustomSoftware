<?xml version="1.0" encoding="utf-8"?>
<Report MustUnderstand="df" xmlns="http://schemas.microsoft.com/sqlserver/reporting/2016/01/reportdefinition" xmlns:rd="http://schemas.microsoft.com/SQLServer/reporting/reportdesigner" xmlns:df="http://schemas.microsoft.com/sqlserver/reporting/2016/01/reportdefinition/defaultfontfamily">
  <df:DefaultFontFamily>Segoe UI</df:DefaultFontFamily>
  <AutoRefresh>0</AutoRefresh>
  <DataSources>
    <DataSource Name="NAV">
      <DataSourceReference>NAV</DataSourceReference>
      <rd:SecurityType>None</rd:SecurityType>
      <rd:DataSourceID>8905ea9a-dc4e-4662-bbb7-013c5cb689e5</rd:DataSourceID>
    </DataSource>
  </DataSources>
  <DataSets>
    <DataSet Name="DataSet1">
      <Query>
        <DataSourceName>NAV</DataSourceName>
        <CommandText>WITH s1 AS
(
	SELECT

	[Dimension 3 Code] Site
	,[Job Posting Group]
	,[Job Type]
	,[Global Dimension 2 Code] [Business Segment]
	,j.No_ Job
	,s.[Sell-to Customer Name] Customer
	,CASE j.Status
		WHEN 0 THEN 'Planning'
		WHEN 1 THEN 'Quote'
		WHEN 2 THEN 'Open'
		WHEN 3 THEN 'Completed'
	END Status
	,Description
	,j.[External Document No_]
	,CASE j.[Overtime Applicable]
		WHEN 1 THEN 'Yes'
		WHEN 2 THEN 'No'
		ELSE ''
	End [Overtime Applicable]
	,j.[Project Manager]


	FROM [ZYGO$Job] j

	LEFT JOIN [ZYGO$Sales Header] s ON j.[Sales Order No_] = s.No_

	WHERE j.[Job Posting Group] IN ('BILL AME','BILL ZYGO','BILLABLE','SERVICE','LOANDEMO')

	AND j.Status = 2
)
,s2 AS
(
	SELECT

	[Job No_]
	,SUM([Total Cost (LCY)]) JobTotalCost

	FROM [ZYGO$Job Ledger Entry]

	WHERE [Entry Type] = 0

	GROUP BY [Job No_]
)
,s3 AS
(
	SELECT

	[Job No_]
	,SUM([Amount]) [Amount]

	FROM [ZYGO$G_L Entry]

	WHERE [G_L Account No_] IN ('50110.001','50110.002','50110.003')

	AND [Document No_] NOT LIKE 'SO%'

	GROUP BY [Job No_]
)
,s4 AS
(
	SELECT

	[Job No_]
	,SUM([Amount]) [Amount]

	FROM [ZYGO$G_L Entry]

	WHERE [G_L Account No_] IN ('41010.001','41010.002','41010.003','41010.004','41015.001','41015.002','41015.003','41015.004')

	GROUP BY [Job No_]
)

select 

s1.Site
,s1.[Job Posting Group]
,s1.[Job Type]
,s1.[Business Segment]
,s1.Job
,COALESCE(s1.Customer,'') Customer
,s1.Status
,s1.Description						--K
, COALESCE(s2.JobTotalCost,0.00) Charges			--L
,COALESCE(s3.Amount,0.00) COGS						--M
,COALESCE(s2.JobTotalCost,0.00) - COALESCE(s3.Amount,0.00) [Net Balance]  --N
,s1.[External Document No_] [Order]											--O
,s1.[Overtime Applicable]							--Q
,s1.[Project Manager] ProjectManager							--R
,REPLACE(s1.[Project Manager],'AMETEK-AD\','') Manager		--S
,(COALESCE(s2.JobTotalCost,0.00) - COALESCE(s3.Amount,0.00)) - COALESCE(s3.Amount,0.00) [GL Balance]  --U
,COALESCE((s4.Amount * -1 ),0) [Reported Revenue]				--W
,(COALESCE((s4.Amount * -1 ),0)) - COALESCE(s3.Amount,0.00) [GM]	--X
,CASE
	WHEN COALESCE((s4.Amount * -1 ),0) &lt;&gt; 0 THEN ROUND(((COALESCE((s4.Amount * -1 ),0)) - COALESCE(s3.Amount,0.00))/COALESCE((s4.Amount * -1 ),0),2)
	ELSE 0
END [GM%]
,COALESCE(s4.Amount,0) [Revenue]

from s1

LEFT JOIN s2 ON s1.Job = s2.[Job No_]
LEFT JOIN s3 ON s1.Job = s3.[Job No_]
LEFT JOIN s4 ON s1.Job = s4.[Job No_]

ORDER BY [Business Segment], s1.Job</CommandText>
        <rd:UseGenericDesigner>true</rd:UseGenericDesigner>
      </Query>
      <Fields>
        <Field Name="Site">
          <DataField>Site</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Job_Posting_Group">
          <DataField>Job Posting Group</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Job_Type">
          <DataField>Job Type</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Business_Segment">
          <DataField>Business Segment</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Job">
          <DataField>Job</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Customer">
          <DataField>Customer</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Status">
          <DataField>Status</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Description">
          <DataField>Description</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Charges">
          <DataField>Charges</DataField>
          <rd:TypeName>System.Decimal</rd:TypeName>
        </Field>
        <Field Name="COGS">
          <DataField>COGS</DataField>
          <rd:TypeName>System.Decimal</rd:TypeName>
        </Field>
        <Field Name="Net_Balance">
          <DataField>Net Balance</DataField>
          <rd:TypeName>System.Decimal</rd:TypeName>
        </Field>
        <Field Name="Order">
          <DataField>Order</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Overtime_Applicable">
          <DataField>Overtime Applicable</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="ProjectManager">
          <DataField>ProjectManager</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Manager">
          <DataField>Manager</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="GL_Balance">
          <DataField>GL Balance</DataField>
          <rd:TypeName>System.Decimal</rd:TypeName>
        </Field>
        <Field Name="Reported_Revenue">
          <DataField>Reported Revenue</DataField>
          <rd:TypeName>System.Decimal</rd:TypeName>
        </Field>
        <Field Name="GM">
          <DataField>GM</DataField>
          <rd:TypeName>System.Decimal</rd:TypeName>
        </Field>
        <Field Name="GM_">
          <DataField>GM%</DataField>
          <rd:TypeName>System.Decimal</rd:TypeName>
        </Field>
        <Field Name="Revenue">
          <DataField>Revenue</DataField>
          <rd:TypeName>System.Decimal</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
  </DataSets>
