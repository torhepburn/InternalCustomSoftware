    </DataSource>
  </DataSources>
  <DataSets>
    <DataSet Name="DataSet1">
      <Query>
        <DataSourceName>AFE</DataSourceName>
        <CommandText>SELECT [CUSTOMER_NUMBER]
	  ,c.[Name] CUSTOMER_NAME
      ,[INVOICE_NUMBER]
      ,[PERIOD_NUMBER]
      ,[JOURNAL_NUMBER]
      ,[BATCH_NUMBER]
      ,[INVOICE_DATE]
      ,h.[CURRENCY]
      ,[CONVERSION_FACTOR]
      ,[AMOUNT]
      ,[AMOUNT_IN_HOME_CURRENCY]
      ,[VAT_AMOUNT]
      ,[VAT_AMOUNT_IN_HOME_CURRENCY]
      ,[REFERENCE]
      ,[CONTROL_LEDGER_ACCOUNT]
      ,[DUE_DATE]
      ,[ORIGINAL_INVOICE_NUMBER]
      ,h.[TERMS_OF_PAYMENT]
      ,[LATE_PMT_SURCHARGE]
      ,[TAXABLE]
      ,[VAT_CODE_NUMERIC]
      ,[INVOICE_PRINTED]
      ,[DOCUMENT_TYPE]
      
  FROM [AccessFrontEnds].[dbo].[MMX_SALES_POSTED_INVOICE_HEADER] h

  LEFT JOIN MMX_CUSTOMERS c ON h.CUSTOMER_NUMBER = c.CUSTOMER

  ORDER BY PERIOD_NUMBER, INVOICE_NUMBER</CommandText>
        <rd:UseGenericDesigner>true</rd:UseGenericDesigner>
      </Query>
