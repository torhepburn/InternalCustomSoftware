  <DataSources>
    <DataSource Name="NAV">
      <DataSourceReference>NAV</DataSourceReference>
      <rd:SecurityType>None</rd:SecurityType>
      <rd:DataSourceID>c6508a5a-7a9e-44b6-9387-0a06f422f099</rd:DataSourceID>
    </DataSource>
  </DataSources>
  <DataSets>
    <DataSet Name="DataSet1">
      <Query>
        <DataSourceName>NAV</DataSourceName>
        <CommandText>WITH s1 AS
(
	select

	[Date and Time]
	,[User ID]
	,[Old Value] [Old Planned Shipment Date]
	,[New Value] [New Planned Shipment Date]
	,[Primary Key Field 2 Value] [Sales Order]
	,[Primary Key Field 3 Value] [Line Number]


	from [ZYGO$Change Log Entry]

	where [Table No_] = 37

	AND [Field No_] = 5795

	AND  [Date and Time] &gt; DATEADD(month, -1, GETDATE())

	AND [New Value] &lt; '2026-05-01'

	AND [New Value] &gt; '2026-03-23'
)
SELECT DISTINCT

e.[Last Date Modified] [Reason Date Change]
,s1.[Date and Time] [Planned Shipment Date Change Date]
,[Change Date Reason Code]
,r.Description Reason
,e.[Document No_]
,e.[SO Line No_]
,l.[Sell-to Customer No_]
,c.Name Customer
,l.No_ Item
,l.Description ItemDescription
,[Old Promised Delivery Date]
,[New Promised Delivery Date]
,s1.[New Planned Shipment Date]
,l.Amount
,e.[Modified by User] [Reason Change User]

,s1.[User ID] [Planned Date Change User]


FROM [ZYGO$Change Sales Date Reason Entry] e

LEFT JOIN [ZYGO$Change Date Reasons] r ON e.[Change Date Reason Code] = r.Code

LEFT JOIN [ZYGO$Sales Line] l ON e.[Document No_] = l.[Document No_] and e.[SO Line No_] = l.[SO Line No_]

LEFT JOIN ZYGO$Customer c ON l.[Sell-to Customer No_] = c.No_

INNER JOIN s1 ON s1.[Sales Order] = e.[Document No_] and s1.[Line Number] = e.[Line No_]

WHERE r.Code not in ('NISO','ZDP')

AND l.[SO Line No_] &lt; 500

AND l.No_ NOT LIKE 'FREIGHT%'</CommandText>
        <rd:UseGenericDesigner>true</rd:UseGenericDesigner>
      </Query>
      <Fields>
        <Field Name="Reason_Date_Change">
          <DataField>Reason Date Change</DataField>
          <rd:TypeName>System.DateTime</rd:TypeName>
        </Field>
        <Field Name="Planned_Shipment_Date_Change_Date">
