  <DataSets>
    <DataSet Name="DataSet1">
      <Query>
        <DataSourceName>NAV</DataSourceName>
        <CommandText>select v.Name, i.* from [ZYGO$Purch_ Inv_ Line] i

LEFT JOIN ZYGO$Vendor v ON i.[Buy-from Vendor No_] = v.No_

WHERE [Posting Date] &gt;= '2024-01-01'

AND i.No_ IN 
(
--no
--'51016'
--'61140'

--yes
'62008'
,'62013'
,'62015'
,'62040'
,'62050'
,'62290'
,'50160.001'
,'50160.002'
,'50160.004'
,'74851'


)</CommandText>
        <rd:UseGenericDesigner>true</rd:UseGenericDesigner>
      </Query>
