  <AutoRefresh>0</AutoRefresh>
  <DataSources>
    <DataSource Name="AFE">
      <ConnectionProperties>
        <DataProvider>SQL</DataProvider>
        <ConnectString>Data Source=ct-mid-sql11;Initial Catalog=AccessFrontEnds</ConnectString>
      </ConnectionProperties>
      <rd:SecurityType>DataBase</rd:SecurityType>
      <rd:DataSourceID>1ac053e4-4635-4ff6-856a-b090628a8c61</rd:DataSourceID>
    </DataSource>
  </DataSources>
  <DataSets>
    <DataSet Name="DataSet1">
      <Query>
        <DataSourceName>AFE</DataSourceName>
        <QueryParameters>
          <QueryParameter Name="@customer">
            <Value>=Parameters!Customer.Value</Value>
            <rd:UserDefined>true</rd:UserDefined>
          </QueryParameter>
          <QueryParameter Name="@startPeriod">
            <Value>=Parameters!StartPeriod.Value</Value>
            <rd:UserDefined>true</rd:UserDefined>
          </QueryParameter>
          <QueryParameter Name="@endPeriod">
            <Value>=Parameters!EndPeriod.Value</Value>
            <rd:UserDefined>true</rd:UserDefined>
          </QueryParameter>
        </QueryParameters>
        <CommandText>SELECT [CUSTOMER_NUMBER]
	  ,c.Name CUSTOMER_NAME
      ,[INVOICE_NUMBER]
      ,[PERIOD_NUMBER]
      ,[JOURNAL_NUMBER]
      ,[BATCH_NUMBER]
      ,[LINE_NUMBER]
      ,[SHIFT_VAT]
      ,[CODE_VAT]
      ,[VAT_LEDGER_ACCOUNT]
      ,[CONTRA_VAT_LEDGER_ACCOUNT]
      ,[LEDGER_ACCOUNT_NUMBER]
      ,[COST_CENTER_NUMBER]
      ,[AMOUNT]
      ,[AMOUNT_IN_HOME_CURRENCY]
      ,[VAT_AMOUNT]
      ,[VAT_AMOUNT_IN_HOME_CURRENCY]
      ,[QUANTITY]
      ,[LINE_REFERENCE]
      ,[TAXABLE]
      ,[VAT_CODE_1]
      
  FROM [AccessFrontEnds].[dbo].[MMX_SALES_POSTED_INVOICE_LINE] l

  LEFT JOIN MMX_CUSTOMERS c ON l.CUSTOMER_NUMBER = c.CUSTOMER

WHERE c.Name = @customer

AND PERIOD_NUMBER &gt;= @startPeriod

AND PERIOD_NUMBER &lt;= @endPeriod 

ORDER BY PERIOD_NUMBER, INVOICE_NUMBER</CommandText>
        <rd:UseGenericDesigner>true</rd:UseGenericDesigner>
      </Query>
      <Fields>
        <Field Name="CUSTOMER_NUMBER">
          <DataField>CUSTOMER_NUMBER</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="CUSTOMER_NAME">
          <DataField>CUSTOMER_NAME</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="INVOICE_NUMBER">
          <DataField>INVOICE_NUMBER</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
        <Field Name="PERIOD_NUMBER">
