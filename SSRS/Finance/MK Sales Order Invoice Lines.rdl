    <DataSet Name="DataSet2">
      <Query>
        <DataSourceName>AFE</DataSourceName>
        <CommandText>SELECT DISTINCT
	  c.[Name] CUSTOMER_NAME
      
  FROM [AccessFrontEnds].[dbo].[MMX_SALES_POSTED_INVOICE_HEADER] h

  INNER JOIN MMX_CUSTOMERS c ON h.CUSTOMER_NUMBER = c.CUSTOMER

  ORDER BY c.Name</CommandText>
      </Query>
      <Fields>
        <Field Name="CUSTOMER_NAME">
          <DataField>CUSTOMER_NAME</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
    <DataSet Name="PeriodNumbers">
      <Query>
        <DataSourceName>AFE</DataSourceName>
        <CommandText>SELECT 

DISTINCT PERIOD_NUMBER


  FROM [AccessFrontEnds].[dbo].[MMX_SALES_POSTED_INVOICE_LINE]

  ORDER BY PERIOD_NUMBER
</CommandText>
      </Query>
      <Fields>
        <Field Name="PERIOD_NUMBER">
          <DataField>PERIOD_NUMBER</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
    <DataSet Name="JournalNumbers">
      <Query>
        <DataSourceName>AFE</DataSourceName>
        <CommandText>SELECT 

DISTINCT JOURNAL_NUMBER


  FROM [AccessFrontEnds].[dbo].[MMX_SALES_POSTED_INVOICE_LINE]

  ORDER BY JOURNAL_NUMBER</CommandText>
      </Query>
      <Fields>
        <Field Name="JOURNAL_NUMBER">
          <DataField>JOURNAL_NUMBER</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
    <DataSet Name="BatchNumbers">
      <Query>
        <DataSourceName>AFE</DataSourceName>
        <CommandText>select DISTINCT

BATCH_NUMBER

FROM [AccessFrontEnds].[dbo].[MMX_SALES_POSTED_INVOICE_HEADER]

ORDER BY BATCH_NUMBER</CommandText>
      </Query>
      <Fields>
        <Field Name="BATCH_NUMBER">
          <DataField>BATCH_NUMBER</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
