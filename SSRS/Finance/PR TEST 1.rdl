<?xml version="1.0" encoding="utf-8"?>
<Report MustUnderstand="df" xmlns="http://schemas.microsoft.com/sqlserver/reporting/2016/01/reportdefinition" xmlns:rd="http://schemas.microsoft.com/SQLServer/reporting/reportdesigner" xmlns:df="http://schemas.microsoft.com/sqlserver/reporting/2016/01/reportdefinition/defaultfontfamily">
  <df:DefaultFontFamily>Segoe UI</df:DefaultFontFamily>
  <AutoRefresh>0</AutoRefresh>
  <DataSources>
    <DataSource Name="NAV">
      <DataSourceReference>NAV</DataSourceReference>
      <rd:SecurityType>None</rd:SecurityType>
      <rd:DataSourceID>a9040f18-2787-4bd2-aad4-5e7b87a028eb</rd:DataSourceID>
    </DataSource>
  </DataSources>
  <DataSets>
    <DataSet Name="DataSet1">
      <Query>
        <DataSourceName>NAV</DataSourceName>
        <CommandText>SELECT

gle.[Posting Date]
,CASE gle.[Document Type]
	WHEN 1 THEN 'Payment'
	WHEN 2 THEN 'Invoice'
	WHEN 3 THEN 'Credit Memo'
	WHEN 4 THEN 'Finance Charge Memo'
	WHEN 5 THEN 'Reminder'
	WHEN 6 THEN 'Refund
	'
	ELSE ''
END [Document Type]
,gle.[Document No_]
,CASE
	WHEN COALESCE(prh.No_,'') = '' AND COALESCE(pih.[No_],'') = '' THEN 'gle'
	WHEN COALESCE(prh.No_,'') = '' THEN 'PInv ' + COALESCE(pih.[No_],'')
	WHEN COALESCE(pih.No_,'') = ''  THEN 'PRcpt ' + COALESCE(prh.[No_],'')
	END [Source]
,CASE 
	WHEN COALESCE(prh.[Order No_],'') = '' THEN COALESCE(pih.[Order No_],'')
	WHEN COALESCE(pih.[Order No_],'') = '' THEN COALESCE(prh.[Order No_],'')
END [PO Number]
,CASE
	WHEN COALESCE(prh.[Pay-to Vendor No_],'')= '' THEN COALESCE(pih.[Pay-to Vendor No_],'')
	WHEN COALESCE(pih.[Pay-to Vendor No_],'')= '' THEN COALESCE(prh.[Pay-to Vendor No_],'')
END [Vendor Number]
,CASE
	WHEN COALESCE(prh.[Pay-to Name],'') = '' THEN COALESCE(pih.[Pay-to Name],'')
	WHEN COALESCE(pih.[Pay-to Name],'') = '' THEN COALESCE(prh.[Pay-to Name],'')
END [Vendor Name]
,[G_L Account No_]
,gle.Amount
,gle.[Global Dimension 2 Code] [Segment]
,CASE
	WHEN COALESCE(gle.[External Document No_],'') != ''  THEN COALESCE(pih.[Vendor Invoice No_],'')
	WHEN COALESCE(gle.[External Document No_],'') != '' THEN gle.[External Document No_]
	ELSE ''
END [External Document No_]
,CASE
	WHEN COALESCE(prh.[Vendor Posting Group],'') = '' THEN COALESCE(pih.[Vendor Posting Group],'') 
	WHEN COALESCE(pih.[Vendor Posting Group],'') = '' THEN COALESCE(prh.[Vendor Posting Group],'') 
END [Vendor Posting Group]
,gle.[User ID]

FROM [ZYGO$G_L Entry] gle

LEFT JOIN [ZYGO$Purch_ Rcpt_ Header] prh on gle.[Document No_] = prh.[No_]

AND prh.[Posting Date] = gle.[Posting Date]

LEFT JOIN [ZYGO$Purch_ Inv_ Header] pih on gle.[Document No_] = pih.[No_]

AND pih.[Posting Date] = gle.[Posting Date]

WHERE 1=1

AND gle.[G_L Account No_] IN ('21411')

AND (gle.[Posting Date] &gt;= '2019-01-01' and gle.[Posting Date] &lt;= '2023-11-30')</CommandText>
        <rd:UseGenericDesigner>true</rd:UseGenericDesigner>
      </Query>
      <Fields>
        <Field Name="Posting_Date">
          <DataField>Posting Date</DataField>
          <rd:TypeName>System.DateTime</rd:TypeName>
        </Field>
        <Field Name="Document_Type">
          <DataField>Document Type</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Document_No_">
