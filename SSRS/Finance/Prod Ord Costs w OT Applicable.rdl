  <DataSources>
    <DataSource Name="NAV">
      <DataSourceReference>NAV</DataSourceReference>
      <rd:SecurityType>None</rd:SecurityType>
      <rd:DataSourceID>6ce4f7df-f924-428e-a339-5544f0ae849f</rd:DataSourceID>
    </DataSource>
  </DataSources>
  <DataSets>
    <DataSet Name="DataSet1">
      <Query>
        <DataSourceName>NAV</DataSourceName>
        <CommandText>WITH s2 AS	/*  Jet   R7     */
(
	SELECT
	
	 SUM([Cost Amount (Actual)]) [Material]
	,[Document No_] 
	
	FROM [ZYGO$Value Entry]
	
	WHERE [Item Ledger Entry Type] = 5  --Consumption

	GROUP BY [Document No_]
)
,s3 AS
(
	SELECT
	SUM([Credit Amount]) + SUM([Debit Amount]) [Labor]
	
	, [Document No_] 
	
	FROM [ZYGO$G_L Entry] WHERE [G_L Account No_] = '62305'

	GROUP BY [Document No_]
)
,s4 AS
(
	SELECT 
		 SUM([Credit Amount]) + SUM([Debit Amount])  [Overhead Cost]
		,[Document No_] 
	
	FROM [ZYGO$G_L Entry] WHERE [G_L Account No_] = '62306'

	GROUP BY [Document No_]
)
,s5 AS
(
	SELECT 
	
	 SUM([Cost Amount (Actual)]) [SubContract]
	,[Document No_] 
	
	FROM [ZYGO$Value Entry] WHERE 
	
	[Gen_ Prod_ Posting Group] = 'SUBCTRT'

	GROUP BY [Document No_]
)
,s6 AS	/*  X7     */
(
	
	SELECT
	
	 SUM([Cost Amount (Expected)]) [Output Post]
	,[Document No_] 
	
	FROM [ZYGO$Value Entry]
	
	WHERE [Item Ledger Entry Type] = 6  /*	Output	*/

	GROUP BY [Document No_]
)

SELECT

 o.[Location Code] [Location]							--C7
,o.[Shortcut Dimension 2 Code] [Business Segment]		--D7
,o.No_ [Prod Order]									--E7
,CASE o.Status
	WHEN 3 THEN 'Released'
	WHEN 4 THEN 'Finished'
	ELSE ''
End [Status]										--F7
,o.[Job No_]										--G7
,o.[Starting Date]
,o.[Last Date Modified]
,l.[Item No_]
,o.[Description]
,i.[Standard Cost]									--N7
,o.Quantity											--O7
,l.[Remaining Quantity]
,l.[Finished Quantity]
,COALESCE(s2.[Material],0) [Consumption Total]
,COALESCE((s2.[Material] * -1),0) [Issued Material]			/*	S7	excel O*/
,COALESCE(s3.[Labor],0) + COALESCE(s4.[Overhead Cost],0) [Issued Labor plus Overhead Cost]						/*	U7	excel Q*/
,COALESCE(s5.[SubContract],0) [Issued SubContract]
,(COALESCE((s2.[Material] * -1),0) + COALESCE(s3.Labor,0) + COALESCE(s4.[Overhead Cost],0) + COALESCE(s5.[SubContract],0) ) [Issued Charges Total]
,COALESCE(s6.[Output Post],0) [Output Post]					/*	X	*/
,COALESCE(i.[Rolled-up Material Cost],0) [STD Mat]	/*	Y	*/
,COALESCE(i.[Rolled-up Subcontracted Cost],0) [STD SC]	/*	AB	*/
,(COALESCE(i.[Rolled-up Material Cost],0) + COALESCE(i.[Rolled-up Capacity Cost],0) + COALESCE(i.[Rolled-up Cap_ Overhead Cost],0) + COALESCE(i.[Rolled-up Subcontracted Cost],0))	[STD Ext Std Cst]	/*	AC	*/
,(COALESCE(i.[Rolled-up Capacity Cost],0) + COALESCE(i.[Rolled-up Cap_ Overhead Cost],0))[STD Labor plus Overhead]
,(COALESCE(s6.[Output Post],0) * -1) [Completions Amount]	/*	AE	*/
,(COALESCE(s2.[Material] * -1,0) + COALESCE(s3.Labor,0) + COALESCE(s4.[Overhead Cost],0) + COALESCE(s5.[SubContract],0)  +  COALESCE((s6.[Output Post] * -1),0)) [Net WIP Amount $]	/*	AG	*/
,COALESCE((s2.[Material] * -1),0) - COALESCE(i.[Rolled-up Material Cost],0)	[Mat Variance]				/*	AI	*/
,(COALESCE(s3.[Labor],0) - COALESCE(i.[Rolled-up Capacity Cost],0)) + (COALESCE(s4.[Overhead Cost],0)	- COALESCE(i.[Rolled-up Cap_ Overhead Cost],0)) [Lbr plus Ovh Variance ]			/*	AK	*/
,COALESCE(s5.[SubContract],0) - COALESCE(i.[Rolled-up Subcontracted Cost],0)	[SC Variance]			/*	AL	*/
,(COALESCE((s2.[Material] * -1),0) - COALESCE(i.[Rolled-up Material Cost],0)) +
(COALESCE(s3.[Labor],0) - COALESCE(i.[Rolled-up Capacity Cost],0)) +
(COALESCE(s4.[Overhead Cost],0)	- COALESCE(i.[Rolled-up Cap_ Overhead Cost],0)) +
(COALESCE(s5.[SubContract],0) - COALESCE(i.[Rolled-up Subcontracted Cost],0))	[Total Variance]		/*  AM	*/
,CASE l.[Overtime Applicable]
		WHEN 0 THEN ''
		WHEN 1 THEN 'Yes'
		WHEN 2 THEN 'No'
		WHEN 3 THEN 'Silent'
		WHEN 4 THEN ''
		WHEN 5 THEN 'ZYGO Affiliate'
	END [Overtime Applicable]


FROM [ZYGO$Production Order] o

INNER JOIN [ZYGO$Prod_ Order Line] l ON o.[No_] = l.[Prod_ Order No_]

INNER JOIN ZYGO$Item i ON l.[Item No_] = i.No_

LEFT JOIN s2 ON s2.[Document No_] = o.No_

LEFT JOIN s3 ON s3.[Document No_] = o.No_

LEFT JOIN s4 ON s4.[Document No_] = o.No_

LEFT JOIN s5 ON s5.[Document No_] = o.No_

LEFT JOIN s6 ON s6.[Document No_] = o.No_

WHERE o.Status = 3 --released

AND l.[Overtime Applicable] IN (1,5)  --yes, Zygo Affiliate

--AND LEN(o.[Source No_]) &gt; 0

ORDER BY o.No_</CommandText>
        <rd:UseGenericDesigner>true</rd:UseGenericDesigner>
      </Query>
