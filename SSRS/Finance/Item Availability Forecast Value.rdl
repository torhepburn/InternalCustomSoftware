<?xml version="1.0" encoding="utf-8"?>
<Report MustUnderstand="df" xmlns="http://schemas.microsoft.com/sqlserver/reporting/2016/01/reportdefinition" xmlns:rd="http://schemas.microsoft.com/SQLServer/reporting/reportdesigner" xmlns:df="http://schemas.microsoft.com/sqlserver/reporting/2016/01/reportdefinition/defaultfontfamily">
  <df:DefaultFontFamily>Segoe UI</df:DefaultFontFamily>
  <AutoRefresh>0</AutoRefresh>
  <DataSources>
    <DataSource Name="DataSource1">
      <ConnectionProperties>
        <DataProvider>SQL</DataProvider>
        <ConnectString>Data Source=PA-HOR-AS408;Initial Catalog=ZYGO-NAV-PROD</ConnectString>
      </ConnectionProperties>
      <rd:SecurityType>DataBase</rd:SecurityType>
      <rd:DataSourceID>8b248f80-1cc1-432f-a213-f5260f42bb1a</rd:DataSourceID>
    </DataSource>
  </DataSources>
  <DataSets>
    <DataSet Name="DataSet1">
      <Query>
        <DataSourceName>DataSource1</DataSourceName>
        <QueryParameters>
          <QueryParameter Name="@item">
            <Value>=Parameters!Item.Value</Value>
            <rd:UserDefined>true</rd:UserDefined>
          </QueryParameter>
          <QueryParameter Name="@DueDate">
            <Value>=Parameters!DueDate.Value</Value>
            <rd:UserDefined>true</rd:UserDefined>
          </QueryParameter>
        </QueryParameters>
        <CommandText>/*	Inventory Forecast Details		*/

/*

	First get quantities and then apply the standard cost

*/

--DECLARE @item varchar(20
--DECLARE @DueDate date 

--SET @item = '6024-0444-15'
--SET @DueDate = '2021-08-01';

WITH s1 AS
(

--DECLARE @item varchar(20)
--DECLARE @DueDate date 

--SET @item = '6024-0444-15'
--SET @DueDate = '2021-08-01'



/*	Inventory Current	*/

select 

'Inventory' [Type]
,'Balance' [Source]
,@item [Item No.]
,''[Description]
,SUM(Quantity) [Quantity Change]
,'' [Document No_]
,GETDATE() [Due Date]

from [ZYGO$Item Ledger Entry]

WHERE [Item No_] = @item

UNION ALL


/*	requisition line	*/
/*	MRP planned item	*/

	select 
'MRP'[Type]
,CASE [Action Message]
	WHEN 1 THEN 
	CASE [MPS Order]
		WHEN 0 THEN 'Purchase New'
		WHEN 1 THEN 'Production New'
	END
	WHEN 5 THEN
		CASE [MPS Order]
		WHEN 0 THEN 'Cancel Purchase'
		WHEN 1 THEN 'Cancel Production'
	END
	
END [Source]

,No_ [Item No.]
,Description
,[Remaining Quantity] - [Original Quantity] [Quantity Change]
,'' [Document No.]
,[Due Date] 

	FROM [ZYGO$Requisition Line]

	where 1=1

	AND [Worksheet Template Name] = 'PLANNING'

	AND [Journal Batch Name] = 'DEFAULT'

	AND [Due Date] &lt;= @DueDate

	AND No_ = @item

UNION ALL

/*	MRP Planned Component	*/

	select 
'MRP'[Type]
--,CASE [Action Message]
--	WHEN 1 THEN 
--	CASE [MPS Order]
--		WHEN 0 THEN 'Purchase New'
--		WHEN 1 THEN 'Production New'
--	END
--	WHEN 5 THEN
--		CASE [MPS Order]
--		WHEN 0 THEN 'Cancel Purchase'
--		WHEN 1 THEN 'Cancel Production'
--	END
	
--END 
,'Component New' [Source]

,[Item No_] [Item No.]
,Description
,[Expected Quantity] * (-1) [Quantity Change]
,'' [Document No.]
,[Due Date] 

	FROM [ZYGO$Planning Component]

	where 1=1

	AND [Worksheet Template Name] = 'PLANNING'

	AND [Worksheet Batch Name] = 'DEFAULT'

	AND [Due Date] &lt;= @DueDate

	AND [Item No_] = @item

	UNION ALL

		
		/*	top level production order plus	*/
		
	select

	'Production' [Type]
	,CASE Status
		WHEN 2 THEN 'Production Firm Planned'
		WHEN 3 THEN 'Production Released'
		ELSE ''
	END [Source]
	,[Source No_] [Item No.]
	,Description
	,Quantity [Quantity Change]
	, [No_] [Document No.]
	,[Due Date]

	from [ZYGO$Production Order]

	WHERE 1=1 

	AND Status IN (2,3)

	AND [Due Date] &lt;= @DueDate

	AND [Due Date] &gt;= GETDATE()

	AND [Source No_] = @item

UNION ALL
	

	/*	production components minus	*/

select

'Component' [Type]
,CASE Status
		WHEN 2 THEN 'Component Firm Planned'
		WHEN 3 THEN 'Component Released'
		ELSE ''
	END [Source]
, [Item No_]
,Description
,Quantity * (-1) [Change Quantity]

,[Prod_ Order No_] [Document No.]
,[Due Date]

from [ZYGO$Prod_ Order Component]

WHERE 1=1 

AND [Item No_] = @item

AND Status IN (2,3)

AND [Remaining Quantity] &gt; 0

AND [Due Date] &lt;= @DueDate

	/*	sales minus	*/

UNION ALL

select

'Sale' [Type]
,'Sales Order' [Source]
,No_ [Item No.]
,[Description]
,[Outstanding Quantity] * (-1) [Quantity Change]
,[Document No_] [Document No.]
,[Shipment Date] [Due Date]


from 


[ZYGO$Sales Line]

WHERE 1=1

	AND [Outstanding Quantity] &gt; 0

	AND [Shipment Date] &lt;= @DueDate

	AND No_ = @item


UNION ALL

select

'Job Journal Line' [Type]
,'Job Inventory Request' [Source]
,No_ [Item No.]
,Description
,Quantity * (-1) [Quantity Change]
,[Document No_] [Document No.]
,[Due Date] 


FROM [ZYGO$Job Journal Line]

WHERE No_ = @item

AND [Journal Template Name] = 'INVREQ'

AND [Due Date] &lt;= @DueDate


)
, s2 AS
(
SELECT

s1.[Item No.]
,SUM(s1.[Quantity Change]) [Quantity]

FROM s1

GROUP BY [Item No.]
)

SELECT 

@DueDate [Due Date]
,s2.[Item No.]
,s2.Quantity
,[Standard Cost]
,s2.[Quantity] * [Standard Cost] [Inventory Value]

FROM s2 LEFT JOIN ZYGO$Item i ON s2.[Item No.] = i.No_</CommandText>
        <rd:UseGenericDesigner>true</rd:UseGenericDesigner>
      </Query>
      <Fields>
        <Field Name="Due_Date">
          <DataField>Due Date</DataField>
          <rd:TypeName>System.Object</rd:TypeName>
        </Field>
        <Field Name="Item_No_">
          <DataField>Item No.</DataField>
          <rd:TypeName>System.Object</rd:TypeName>
        </Field>
        <Field Name="Quantity">
          <DataField>Quantity</DataField>
          <rd:TypeName>System.Decimal</rd:TypeName>
        </Field>
        <Field Name="Standard_Cost">
          <DataField>Standard Cost</DataField>
          <rd:TypeName>System.Decimal</rd:TypeName>
        </Field>
        <Field Name="Inventory_Value">
          <DataField>Inventory Value</DataField>
          <rd:TypeName>System.Decimal</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
  </DataSets>
