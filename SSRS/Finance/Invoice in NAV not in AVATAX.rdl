<?xml version="1.0" encoding="utf-8"?>
<Report MustUnderstand="df" xmlns="http://schemas.microsoft.com/sqlserver/reporting/2016/01/reportdefinition" xmlns:rd="http://schemas.microsoft.com/SQLServer/reporting/reportdesigner" xmlns:df="http://schemas.microsoft.com/sqlserver/reporting/2016/01/reportdefinition/defaultfontfamily">
  <df:DefaultFontFamily>Segoe UI</df:DefaultFontFamily>
  <AutoRefresh>0</AutoRefresh>
  <DataSources>
    <DataSource Name="DataSource1">
      <ConnectionProperties>
        <DataProvider>SQL</DataProvider>
        <ConnectString>Data Source=pa-hor-as408.ametek.com;Initial Catalog=ZYGO-NAV-PROD</ConnectString>
      </ConnectionProperties>
      <rd:SecurityType>DataBase</rd:SecurityType>
      <rd:DataSourceID>9cc2f890-25f5-4ece-b35b-e5c8b5d17317</rd:DataSourceID>
    </DataSource>
  </DataSources>
  <DataSets>
    <DataSet Name="DataSet1">
      <Query>
        <DataSourceName>DataSource1</DataSourceName>
        <QueryParameters>
          <QueryParameter Name="@start">
            <Value>=Parameters!start.Value</Value>
          </QueryParameter>
          <QueryParameter Name="@end">
            <Value>=Parameters!end.Value</Value>
          </QueryParameter>
        </QueryParameters>
        <CommandText>WITH s1 AS
(

SELECT

No_
,[Ship-to Country_Region Code]
,[Posting Date]

 FROM [ZYGO$Service Invoice Header] vih 

 UNION

 SELECT

No_
,[Ship-to Country_Region Code]
,[Posting Date]

 FROM [ZYGO$Sales Invoice Header] sih 

 UNION

 SELECT No_
,[Ship-to Country_Region Code]
,[Posting Date]

 FROM [ZYGO$Sales Cr_Memo Header] sch 

  UNION

 SELECT No_
,[Ship-to Country_Region Code]
,[Posting Date]

 FROM [ZYGO$Service Cr_Memo Header] vch 
 )
 , s2 AS
 (
	SELECT DISTINCT

 h.[Document No_] [DOC CODE]
,[Document Date] [DOC DATE]
, CASE [Document Status]
	WHEN 3 THEN 'Committed'
END [DOC STATUS]
, [Customer No_] [CUST/VENDOR CODE]
, SUBSTRING(dh.[Tax Name], 1,2) REGION
, COALESCE(CASE
	WHEN [Exempted Amount] &gt; 0 THEN [Exempted Amount]
	WHEN [Taxable Amount] &gt; 0 THEN [Taxable Amount]
  END, 0) AMOUNT
, [Exempted Amount] [NOT TAXED]
, [Taxable Amount] TAXABLE
,[Tax Amount] TAX


--,*

FROM [ZYGO-NAV-PROD].[dbo].[ZYGO$AVA Header History] h

LEFT JOIN [ZYGO$AVA Detail History] dh on h.[Document No_] = dh.[Document No_]

 )
 , s3 AS
 (
 SELECT * FROM s1

 WHERE No_ NOT IN (SELECT [DOC CODE] FROM s2)
 )

 SELECT 

 No_

 FROM s3 

 WHERE

 [Ship-to Country_Region Code] = 'USA'

 AND [Posting Date] &gt;= @start

 AND [Posting Date] &lt;= @end</CommandText>
        <rd:UseGenericDesigner>true</rd:UseGenericDesigner>
      </Query>
      <Fields>
        <Field Name="No_">
          <DataField>No_</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
  </DataSets>
