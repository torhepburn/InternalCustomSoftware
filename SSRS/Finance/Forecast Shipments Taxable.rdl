<?xml version="1.0" encoding="utf-8"?>
<Report MustUnderstand="df" xmlns="http://schemas.microsoft.com/sqlserver/reporting/2016/01/reportdefinition" xmlns:rd="http://schemas.microsoft.com/SQLServer/reporting/reportdesigner" xmlns:df="http://schemas.microsoft.com/sqlserver/reporting/2016/01/reportdefinition/defaultfontfamily">
  <df:DefaultFontFamily>Segoe UI</df:DefaultFontFamily>
  <AutoRefresh>0</AutoRefresh>
  <DataSources>
    <DataSource Name="NAV">
      <DataSourceReference>NAV</DataSourceReference>
      <rd:SecurityType>None</rd:SecurityType>
      <rd:DataSourceID>008eb6a3-2702-4ebf-92cb-e0051c78ec1a</rd:DataSourceID>
    </DataSource>
  </DataSources>
  <DataSets>
    <DataSet Name="DataSet1">
      <Query>
        <DataSourceName>NAV</DataSourceName>
        <CommandText>
SET DATEFIRST 1;

SELECT 

[Planned Delivery Date]
,c.[No_] [Customer Number]
,c.Name [Customer Name]
,sh.[End User Customer Name]
,REPLACE(sh.[Assigned User ID],'AMETEK-AD\','') AssignedUser
,[Document No_]
,[SO Line No_]
,sl. No_
,[Description]
,sl.[Location Code]
,[Outstanding Quantity]
,sl.[Line Amount]
,sl.[Amount Including VAT]
,sl.[Amount Including VAT] - sl.Amount [Tax]
,COALESCE(sh.[Ship-to County], '') [Ship-to Code]

FROM [ZYGO$Sales Line] sl

INNER JOIN ZYGO$Customer c on sl.[Sell-to Customer No_] = c.No_

LEFT JOIN [ZYGO$Sales Header] sh on sl.[Document No_] = sh.No_

WHERE 1=1

AND [Outstanding Quantity] &gt; 0

AND [Planned Delivery Date] &gt;= GETDATE()

AND [Planned Delivery Date] &lt;= (DATEADD(Wk,4, GETDATE()))

AND [Ship-to Country_Region Code] = 'USA'


UNION ALL


SELECT
		
	svl.[Planned Delivery Date]
	,svl.[Bill-to Customer No_] [Sell-to Customer No_]
	,c.Name [Customer Name]
	,svh.[End User Customer Name] 
	,REPLACE(svh.[Assigned User ID],'AMETEK-AD\','') AssignedUser
	,svl.[Document No_]
	,svl.[Srv Line No_]
	,svl.No_ 
	,svl.Description [DESCRIPTION]
	,svl.[Location Code]
	
	,svl.[Outstanding Quantity]
	,svl.[Line Amount]
,svl.[Amount Including VAT]
,svl.[Amount Including VAT] - svl.[Line Amount] [Tax]
,COALESCE(svh.[Ship-to County], '') [Ship-to Code]

	FROM [ZYGO$Service Header] svh

	INNER JOIN [ZYGO$Service Line] svl ON svh.No_ = svl.[Document No_]

	LEFT JOIN ZYGO$Customer c ON svl.[Bill-to Customer No_] = c.No_

	WHERE 

	 [Outstanding Quantity] &gt; 0

AND [Planned Delivery Date] &gt;= GETDATE()

AND [Planned Delivery Date] &lt;= (DATEADD(Wk,4, GETDATE()))

AND [Ship-to Country_Region Code] = 'USA'



ORDER BY [Planned Delivery Date]



</CommandText>
        <rd:UseGenericDesigner>true</rd:UseGenericDesigner>
      </Query>
      <Fields>
        <Field Name="Planned_Delivery_Date">
          <DataField>Planned Delivery Date</DataField>
