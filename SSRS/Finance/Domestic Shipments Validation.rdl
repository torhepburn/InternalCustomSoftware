<?xml version="1.0" encoding="utf-8"?>
<Report MustUnderstand="df" xmlns="http://schemas.microsoft.com/sqlserver/reporting/2016/01/reportdefinition" xmlns:rd="http://schemas.microsoft.com/SQLServer/reporting/reportdesigner" xmlns:df="http://schemas.microsoft.com/sqlserver/reporting/2016/01/reportdefinition/defaultfontfamily">
  <df:DefaultFontFamily>Segoe UI</df:DefaultFontFamily>
  <AutoRefresh>0</AutoRefresh>
  <DataSources>
    <DataSource Name="NAV">
      <DataSourceReference>NAV</DataSourceReference>
      <rd:SecurityType>None</rd:SecurityType>
      <rd:DataSourceID>7afffc3f-b7ca-4327-aba2-a856e880cc1e</rd:DataSourceID>
    </DataSource>
  </DataSources>
  <DataSets>
    <DataSet Name="DataSet1">
      <Query>
        <DataSourceName>NAV</DataSourceName>
        <QueryParameters>
          <QueryParameter Name="@startingPostingDate">
            <Value>=Parameters!startingPostingDate.Value</Value>
          </QueryParameter>
          <QueryParameter Name="@endingPostingDate">
            <Value>=Parameters!endingPostingDate.Value</Value>
          </QueryParameter>
        </QueryParameters>
        <CommandText>SELECT

sih.[Posting Date]
,CAST(YEAR(sih.[Posting Date]) as nchar(4)) + '-' + CAST(MONTH(sih.[Posting Date]) as nchar(2)) [Date]
,di.[Dimension Value Code] [Industry]
,dvi.Name [Industry Name]
,sih.[Sell-to Customer Name] [Customer]
,[Ship-to Country_Region Code] [Country]
,cr.Name [Country Name]
,sil.[Line Amount] [Amount]
,YEAR(sih.[Posting Date]) [Year]
,MONTH(sih.[Posting Date]) [Month]
,DAY(sih.[Posting Date]) [Day]
,sih.No_
,sil.[SO Line No_] [LineNo]
,'Posted Sales Invoice' [Type]

FROM [ZYGO$Sales Invoice Header] sih

INNER JOIN [ZYGO$Sales Invoice Line] sil ON sih.No_ = sil.[Document No_]

LEFT JOIN [ZYGO$Dimension Set Entry] di ON sil.[Dimension Set ID] = di.[Dimension Set ID] and di.[Dimension Code] = 'INDUSTRY'

LEFT JOIN [ZYGO$Dimension Set Entry] dr ON sil.[Dimension Set ID] = dr.[Dimension Set ID] and dr.[Dimension Code] = 'REGION'

LEFT JOIN [ZYGO$Country_Region] cr ON sih.[Ship-to Country_Region Code] = cr.Code

LEFT JOIN [ZYGO$Dimension Value] dvi ON di.[Dimension Value Code] = dvi.Code

LEFT JOIN [ZYGO$Dimension Value] dvr ON dr.[Dimension Value Code] = dvr.Code

WHERE sih.[Posting Date] BETWEEN @startingPostingDate AND @endingPostingDate

AND [Sell-to Customer Name] NOT LIKE 'AMETEK%'

AND [Sell-to Customer Name] NOT LIKE 'ZYGO%'

AND sil.Type &lt;&gt; ''

AND sil.No_ &lt;&gt; ''

AND sil.Quantity &lt;&gt; 0

AND sil.[SO Line No_] &lt; 500

UNION ALL

select

h.[Posting Date]
,CAST(YEAR(h.[Posting Date]) as nchar(4)) + '-' + CAST(MONTH(h.[Posting Date]) as nchar(2)) [Date]
,di.[Dimension Value Code] [Industry]
,dvi.Name [Industry Name]
,h.[Sell-to Customer Name] [Customer]
,[Ship-to Country_Region Code] [Country]
,cr.Name [Country Name]
,l.[Line Amount] [Amount]
,YEAR(h.[Posting Date]) [Year]
,MONTH(h.[Posting Date]) [Month]
,DAY(h.[Posting Date]) [Day]
,h.No_
,l.[SO Line No_]
,'Posted Sales Credit Memo'

from [ZYGO$Sales Cr_Memo Header] h 

INNER JOIN [ZYGO$Sales Cr_Memo Line] l on l.[Document No_] = h.[No_]

LEFT JOIN [ZYGO$Dimension Set Entry] di ON l.[Dimension Set ID] = di.[Dimension Set ID] and di.[Dimension Code] = 'INDUSTRY'

LEFT JOIN [ZYGO$Dimension Value] dvi ON di.[Dimension Value Code] = dvi.Code

LEFT JOIN [ZYGO$Country_Region] cr ON h.[Ship-to Country_Region Code] = cr.Code


WHERE h.[Posting Date] BETWEEN @startingPostingDate AND @endingPostingDate

AND l.No_ &lt;&gt; ''

AND Quantity &lt;&gt; 0

AND [Sell-to Customer Name] NOT LIKE 'AMETEK%'

AND [Sell-to Customer Name] NOT LIKE 'ZYGO%'

UNION ALL

SELECT

sih.[Posting Date]
,CAST(YEAR(sih.[Posting Date]) as nchar(4)) + '-' + CAST(MONTH(sih.[Posting Date]) as nchar(2)) [Date]
,di.[Dimension Value Code] [Industry]
,dvi.Name [Industry Name]
,sih.[Bill-to Name] [Customer]
,[Ship-to Country_Region Code] [Country]
,cr.Name [Country Name]
,sil.[Line Amount] [Amount]
,YEAR(sih.[Posting Date]) [Year]
,MONTH(sih.[Posting Date]) [Month]
,DAY(sih.[Posting Date]) [Day]
,sih.No_
,sil.[Srv Line No_]
,'Posted Service Invoice'

FROM [ZYGO$Service Invoice Header] sih

INNER JOIN [ZYGO$Service Invoice Line] sil ON sih.No_ = sil.[Document No_]

LEFT JOIN [ZYGO$Dimension Set Entry] di ON sil.[Dimension Set ID] = di.[Dimension Set ID] and di.[Dimension Code] = 'INDUSTRY'

LEFT JOIN [ZYGO$Dimension Set Entry] dr ON sil.[Dimension Set ID] = dr.[Dimension Set ID] and dr.[Dimension Code] = 'REGION'

LEFT JOIN [ZYGO$Country_Region] cr ON sih.[Ship-to Country_Region Code] = cr.Code

LEFT JOIN [ZYGO$Dimension Value] dvi ON di.[Dimension Value Code] = dvi.Code

LEFT JOIN [ZYGO$Dimension Value] dvr ON dr.[Dimension Value Code] = dvr.Code

WHERE sih.[Posting Date] BETWEEN @startingPostingDate AND @endingPostingDate

AND [Bill-to Name] NOT LIKE 'AMETEK%'

AND [Bill-to Name] NOT LIKE 'ZYGO%'

AND sil.Type &lt;&gt; ''

AND sil.No_ &lt;&gt; ''

AND sil.Quantity &lt;&gt; 0

UNION ALL

select

 h.[Posting Date]
,CAST(YEAR(h.[Posting Date]) as nchar(4)) + '-' + CAST(MONTH(h.[Posting Date]) as nchar(2)) [Date]
,di.[Dimension Value Code] [Industry]
,dvi.Name [Industry Name]
,h.[Bill-to Name] [Customer]
,[Ship-to Country_Region Code] [Country]
,cr.Name [Country Name]
,l.[Line Amount] [Amount]
,YEAR(h.[Posting Date]) [Year]
,MONTH(h.[Posting Date]) [Month]
,DAY(h.[Posting Date]) [Day]
,h.No_
,l.[Line No_]
,'Posted Service Credit Memo'

from [ZYGO$Service Cr_Memo Header] h 

INNER JOIN [ZYGO$Service Cr_Memo Line] l on l.[Document No_] = h.[No_]

LEFT JOIN [ZYGO$Dimension Set Entry] di ON l.[Dimension Set ID] = di.[Dimension Set ID] and di.[Dimension Code] = 'INDUSTRY'

LEFT JOIN [ZYGO$Dimension Value] dvi ON di.[Dimension Value Code] = dvi.Code

LEFT JOIN [ZYGO$Country_Region] cr ON h.[Ship-to Country_Region Code] = cr.Code


WHERE h.[Posting Date] BETWEEN @startingPostingDate AND @endingPostingDate

AND l.No_ &lt;&gt; ''

AND Quantity &lt;&gt; 0

AND [Bill-to Name] NOT LIKE 'AMETEK%'

AND [Bill-to Name] NOT LIKE 'ZYGO%'

ORDER BY Customer</CommandText>
        <rd:UseGenericDesigner>true</rd:UseGenericDesigner>
      </Query>
