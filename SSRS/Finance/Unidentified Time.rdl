<?xml version="1.0" encoding="utf-8"?>
<Report MustUnderstand="df" xmlns="http://schemas.microsoft.com/sqlserver/reporting/2016/01/reportdefinition" xmlns:rd="http://schemas.microsoft.com/SQLServer/reporting/reportdesigner" xmlns:df="http://schemas.microsoft.com/sqlserver/reporting/2016/01/reportdefinition/defaultfontfamily">
  <df:DefaultFontFamily>Segoe UI</df:DefaultFontFamily>
  <AutoRefresh>0</AutoRefresh>
  <DataSources>
    <DataSource Name="AFE">
      <DataSourceReference>AFE</DataSourceReference>
      <rd:SecurityType>None</rd:SecurityType>
      <rd:DataSourceID>6d3da3d3-75c2-45b9-b412-7f7d1f86ee96</rd:DataSourceID>
    </DataSource>
  </DataSources>
  <DataSets>
    <DataSet Name="DataSet1">
      <Query>
        <DataSourceName>AFE</DataSourceName>
        <CommandText>select

d.Name
,ADP.[Worked Hours] ADPWorkedHours 
,d.ProdHours + IndirectHours + ServiceHours + saleshours + ProjectHours DashboradReportedTime
,(d.ProdHours + IndirectHours + ServiceHours + saleshours + ProjectHours)/ADP.[Worked Hours] percentIdentified
,adp.SortDate


from ADP

LEFT JOIN LaborDashboardReported d ON ADP.[Empl ID] = d.AMETEK_ID and ADP.SortDate = d.sortDate

WHERE adp.SortDate like '20%'

AND Name is not null

order by sortdate desc</CommandText>
        <rd:UseGenericDesigner>true</rd:UseGenericDesigner>
      </Query>
      <Fields>
        <Field Name="Name">
          <DataField>Name</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="ADPWorkedHours">
          <DataField>ADPWorkedHours</DataField>
          <rd:TypeName>System.Double</rd:TypeName>
        </Field>
        <Field Name="DashboradReportedTime">
          <DataField>DashboradReportedTime</DataField>
          <rd:TypeName>System.Double</rd:TypeName>
        </Field>
        <Field Name="percentIdentified">
          <DataField>percentIdentified</DataField>
          <rd:TypeName>System.Double</rd:TypeName>
        </Field>
        <Field Name="SortDate">
          <DataField>SortDate</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
  </DataSets>
