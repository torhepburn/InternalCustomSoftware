<?xml version="1.0" encoding="utf-8"?>
<Report MustUnderstand="df" xmlns="http://schemas.microsoft.com/sqlserver/reporting/2016/01/reportdefinition" xmlns:rd="http://schemas.microsoft.com/SQLServer/reporting/reportdesigner" xmlns:df="http://schemas.microsoft.com/sqlserver/reporting/2016/01/reportdefinition/defaultfontfamily">
  <df:DefaultFontFamily>Segoe UI</df:DefaultFontFamily>
  <AutoRefresh>0</AutoRefresh>
  <DataSources>
    <DataSource Name="NAV">
      <DataSourceReference>NAV</DataSourceReference>
      <rd:SecurityType>None</rd:SecurityType>
      <rd:DataSourceID>93926368-fd52-45da-9085-ea1f4f7293c4</rd:DataSourceID>
    </DataSource>
  </DataSources>
  <DataSets>
    <DataSet Name="DataSet1">
      <Query>
        <DataSourceName>NAV</DataSourceName>
        <QueryParameters>
          <QueryParameter Name="@start">
            <Value>=Parameters!start.Value</Value>
          </QueryParameter>
        </QueryParameters>
        <CommandText>WITH s1 AS  /*	first material issue	*/
(
select 

[Document No_]
,MIN([Posting Date]) FirstMaterialIssue

FROM [ZYGO$Item Ledger Entry]

where [Entry Type] = 5   /*	consumption	*/

AND [Order Type] = 1	/*	production	*/


GROUP BY [Document No_]
)


select 

s1.*
, p.[Source No_] 
,CASE p.[Status]
	WHEN 3 THEN 'Released'
	WHEN 2 THEN 'Firm Planned'
	WHEN 4 THEN 'Finished'
END Status
,p.[Quantity]
,p.[Buyer Planner Code]

from s1

INNER JOIN [ZYGO$Production Order] p ON s1.[Document No_] = p.No_

WHERE p.Status &gt; 2

AND FirstMaterialIssue &gt;= @start

ORDER BY [Document No_]</CommandText>
        <rd:UseGenericDesigner>true</rd:UseGenericDesigner>
      </Query>
      <Fields>
        <Field Name="Document_No_">
          <DataField>Document No_</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="FirstMaterialIssue">
          <DataField>FirstMaterialIssue</DataField>
          <rd:TypeName>System.DateTime</rd:TypeName>
        </Field>
        <Field Name="Source_No_">
          <DataField>Source No_</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Status">
          <DataField>Status</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Quantity">
          <DataField>Quantity</DataField>
          <rd:TypeName>System.Decimal</rd:TypeName>
        </Field>
        <Field Name="Buyer_Planner_Code">
          <DataField>Buyer Planner Code</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
  </DataSets>
