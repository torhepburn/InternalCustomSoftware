<?xml version="1.0" encoding="utf-8"?>
<Report MustUnderstand="df" xmlns="http://schemas.microsoft.com/sqlserver/reporting/2016/01/reportdefinition" xmlns:rd="http://schemas.microsoft.com/SQLServer/reporting/reportdesigner" xmlns:df="http://schemas.microsoft.com/sqlserver/reporting/2016/01/reportdefinition/defaultfontfamily">
  <df:DefaultFontFamily>Segoe UI</df:DefaultFontFamily>
  <AutoRefresh>0</AutoRefresh>
  <DataSources>
    <DataSource Name="NAV">
      <DataSourceReference>NAV</DataSourceReference>
      <rd:SecurityType>None</rd:SecurityType>
      <rd:DataSourceID>8fdcc0ee-98a4-4e56-83cc-558be3298457</rd:DataSourceID>
    </DataSource>
  </DataSources>
  <DataSets>
    <DataSet Name="DataSet1">
      <Query>
        <DataSourceName>NAV</DataSourceName>
        <CommandText>select 

cu.No_ [Bill-to Customer Number]
,cu.Name [Customer Name]
,cu.[Payment Terms Code]


from ZYGO$Customer cu

INNER JOIN [ZYGO$Sales Header] s ON s.[Bill-to Customer No_] = cu.No_

WHERE [Order Date] &gt; '2023-01-01'


AND cu.No_ NOT IN

(
SELECT DISTINCT

--c.[Job Title Code]
u.No_ [Customer Number]
--,u.Name [Customer Name]
--,u.[Gen_ Bus_ Posting Group] [General Business Posting Group]
--,u.[Customer Posting Group]
--,u.[Country_Region Code]
--,c.[E-Mail]

FROM ZYGO$Contact c

INNER JOIN [ZYGO$Contact Business Relation] r ON c.[Company No_] = r.[Contact No_]

INNER JOIN ZYGO$Customer u on r.[No_] = u.No_

WHERE c.[Job Title Code] = 'AP'
)

GROUP BY cu.No_, cu.Name, cu.[Payment Terms Code]</CommandText>
        <rd:UseGenericDesigner>true</rd:UseGenericDesigner>
      </Query>
      <Fields>
        <Field Name="Bill_to_Customer_Number">
          <DataField>Bill-to Customer Number</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Customer_Name">
          <DataField>Customer Name</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Payment_Terms_Code">
          <DataField>Payment Terms Code</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
  </DataSets>
