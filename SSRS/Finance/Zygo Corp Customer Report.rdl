<?xml version="1.0" encoding="utf-8"?>
<Report xmlns="http://schemas.microsoft.com/sqlserver/reporting/2016/01/reportdefinition" xmlns:rd="http://schemas.microsoft.com/SQLServer/reporting/reportdesigner" xmlns:df="http://schemas.microsoft.com/sqlserver/reporting/2016/01/reportdefinition/defaultfontfamily" MustUnderstand="df">
  <df:DefaultFontFamily>Segoe UI</df:DefaultFontFamily>
  <AutoRefresh>0</AutoRefresh>
  <DataSources>
    <DataSource Name="NAV">
      <DataSourceReference>NAV</DataSourceReference>
      <rd:SecurityType>None</rd:SecurityType>
      <rd:DataSourceID>af3dcb33-0ded-4f0e-bc8a-9eadfe2d02bc</rd:DataSourceID>
    </DataSource>
  </DataSources>
  <DataSets>
    <DataSet Name="DataSet1">
      <Query>
        <DataSourceName>NAV</DataSourceName>
        <CommandText>WITH s1 AS
(
select

CASE
 WHEN COUNT([Customer No_]) &gt; 1 THEN 'Yes'
 ELSE 'No'
END [Does Customer have Multiple Ship To Locations?]
,[Customer No_] [Customer Code]

from 

[ZYGO$Ship-to Address]

GROUP BY [Customer No_]
)
,s2 as
(
	select 

	cbr.No_ CustomerNo
	,c.[Contact Tax No_] [Taxpayer UUID]
	,c.[First Name] + ' ' + c.Surname [Customer Contact Name]
	,c.Address [Customer Contact Street Address]
	,c.[Address 2] [Customer Contact Street Address Line 2]
	,c.City [Customer Contact City]
	,c.County [Customer Contact State or Province]
	,c.[Post Code] [Customer Contact Zip]
	,c.[Country_Region Code] [Customer Contact Country]
	,c.[Phone No_] [Customer Contact Phone Number]
	,c.[Fax No_] [Customer Contact Fax]
	,c.[E-Mail] [Customer Contact Email]


	from [ZYGO$Contact Business Relation] cbr

	INNER JOIN ZYGO$Contact c ON cbr.[Contact No_] = c.[Company No_]

	where [Business Relation Code] = 'CUST'
)
,s3 AS
(
	SELECT
	 
	 [Customer No_]
	,Address [Customer Ship-to Street Address]
	,[Address 2] [Customer Ship-to Street Address Line 2]
	,City [Customer Ship-to City]
	,County [Customer Ship-to State or Province]
	,[Post Code] [Customer Ship-to Zip]
	,[Country_Region Code] [Customer Ship-to Country]

	FROM [ZYGO$Ship-to Address]
)
,s4 AS
(

SELECT

s1.*
--,[Primary Contact No_]
,cus.Name [Customer Name]
,'' [Parent Customer Code]
,s2.[Taxpayer UUID]
,s2.[Customer Contact Name]
,s2.[Customer Contact Street Address]
,s2.[Customer Contact Street Address Line 2]
,s2.[Customer Contact City]
,s2.[Customer Contact State or Province]
,s2.[Customer Contact Zip]
,s2.[Customer Contact Country]
,s2.[Customer Contact Phone Number]
,s2.[Customer Contact Fax]
,s2.[Customer Contact Email]
,s3.[Customer Ship-to Street Address]
,s3.[Customer Ship-to Street Address Line 2]
,s3.[Customer Ship-to City]
,s3.[Customer Ship-to State or Province]
,s3.[Customer Ship-to Zip]
,s3.[Customer Ship-to Country]



FROM ZYGO$Customer cus

LEFT JOIN s1 ON s1.[Customer Code] = cus.No_

LEFT JOIN s2 ON s1.[Customer Code] = s2.CustomerNo

LEFT JOIN s3 ON s1.[Customer Code] = s3.[Customer No_]
)

SELECT DISTINCT *  FROM s4 

WHERE [Customer Code] is not null

ORDER BY [Customer Code]</CommandText>
        <rd:UseGenericDesigner>true</rd:UseGenericDesigner>
      </Query>
      <Fields>
        <Field Name="Does_Customer_have_Multiple_Ship_To_Locations_">
          <DataField>Does Customer have Multiple Ship To Locations?</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
