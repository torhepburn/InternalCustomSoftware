<?xml version="1.0" encoding="utf-8"?>
<Report MustUnderstand="df" xmlns="http://schemas.microsoft.com/sqlserver/reporting/2016/01/reportdefinition" xmlns:rd="http://schemas.microsoft.com/SQLServer/reporting/reportdesigner" xmlns:df="http://schemas.microsoft.com/sqlserver/reporting/2016/01/reportdefinition/defaultfontfamily">
  <df:DefaultFontFamily>Segoe UI</df:DefaultFontFamily>
  <AutoRefresh>0</AutoRefresh>
  <DataSources>
    <DataSource Name="NAVPROD">
      <ConnectionProperties>
        <DataProvider>SQL</DataProvider>
        <ConnectString>Data Source=PA-HOR-AS408.ametek.com;Initial Catalog=ZYGO-NAV-PROD</ConnectString>
      </ConnectionProperties>
      <rd:SecurityType>DataBase</rd:SecurityType>
      <rd:DataSourceID>3dd3aca6-c838-409d-bf59-fe59ac84720b</rd:DataSourceID>
    </DataSource>
  </DataSources>
  <DataSets>
    <DataSet Name="DataSet1">
      <Query>
        <DataSourceName>NAVPROD</DataSourceName>
        <CommandText>select 
       il.[Posting Date], 
il.[Document No_], 
il.[Location Code],
       v.No_ [Vendor No], 
v.Name [Vendor], 
       i.No_ [Item No],
 i.Description,
      FORMAT(il.Quantity, 'N') [Quantity],
 FORMAT(il.[Invoiced Quantity], 'N') [Invoiced Quantity],
 FORMAT(il.Quantity - il.[Invoiced Quantity],'N')  as [Uninvoiced Quantity],
       FORMAT((il.Quantity - il.[Invoiced Quantity])  * i.[Standard Cost],'C') as [Expected Cost],
       prh.[Order No_]
, pl.[PO Line No_]

from 
       [ZYGO$Item Ledger Entry] il
       inner join ZYGO$Item i on i.No_ = il.[Item No_]
       inner join ZYGO$Vendor v on v.No_ = il.[Source No_]
       inner join [ZYGO$Purch_ Rcpt_ Header] prh on prh.No_ = il.[Document No_]
       INNER JOIN [ZYGO$Purchase Line] pl on prh.[Order No_] = pl.[Document No_]
	   AND pl.No_ = i.No_
where 
       il.Quantity - il.[Invoiced Quantity] &lt;&gt;0
       and il.[Document Type] = 5
       and i.[Inventory Value Zero] = 0</CommandText>
        <rd:UseGenericDesigner>true</rd:UseGenericDesigner>
      </Query>
      <Fields>
        <Field Name="Posting_Date">
          <DataField>Posting Date</DataField>
          <rd:TypeName>System.DateTime</rd:TypeName>
        </Field>
        <Field Name="Document_No_">
          <DataField>Document No_</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Location_Code">
          <DataField>Location Code</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Vendor_No">
