          <rd:TypeName>System.String</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
    <DataSet Name="POSuppliers">
      <Query>
        <DataSourceName>AFE</DataSourceName>
        <CommandText>select 

DISTINCT Supplier 

from MMX_Purchase_order_Lines

order by supplier</CommandText>
      </Query>
      <Fields>
        <Field Name="Supplier">
          <DataField>Supplier</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
    <DataSet Name="POOrders">
      <Query>
        <DataSourceName>AFE</DataSourceName>
        <CommandText>select 

DISTINCT ORDER_No

from MMX_Purchase_order_Lines

WHERE Order_date &gt;= '2016-01-01'

order by ORDER_NO</CommandText>
      </Query>
      <Fields>
        <Field Name="ORDER_No">
          <DataField>ORDER_No</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
  </DataSets>
