<?xml version="1.0" encoding="utf-8"?>
<Report MustUnderstand="df" xmlns="http://schemas.microsoft.com/sqlserver/reporting/2016/01/reportdefinition" xmlns:rd="http://schemas.microsoft.com/SQLServer/reporting/reportdesigner" xmlns:df="http://schemas.microsoft.com/sqlserver/reporting/2016/01/reportdefinition/defaultfontfamily">
  <df:DefaultFontFamily>Segoe UI</df:DefaultFontFamily>
  <AutoRefresh>0</AutoRefresh>
  <DataSources>
    <DataSource Name="AFE">
      <DataSourceReference>AFE</DataSourceReference>
      <rd:SecurityType>None</rd:SecurityType>
      <rd:DataSourceID>dc102a36-c48e-46d9-a147-5e393869d577</rd:DataSourceID>
    </DataSource>
  </DataSources>
  <DataSets>
    <DataSet Name="DataSet1">
      <Query>
        <DataSourceName>AFE</DataSourceName>
        <QueryParameters>
          <QueryParameter Name="@orderNo">
            <Value>=Parameters!orderNo.Value</Value>
            <rd:UserDefined>true</rd:UserDefined>
          </QueryParameter>
          <QueryParameter Name="@Supplier">
            <Value>=Parameters!Supplier.Value</Value>
            <rd:UserDefined>true</rd:UserDefined>
          </QueryParameter>
        </QueryParameters>
        <CommandText>SELECT [ORDER_NO]
      ,[POSITION]
      ,p.[SUPPLIER]
	  ,s.NAME SUPPLIER_NAME
      ,[ITEM_CODE]
      ,[ITEM_DESCRIPTION]
      ,[ORDER_DATE]
      ,[DELIVERY_DATE]
      ,[DELIVERY_DATE_2]
      ,[QUANTITY]
      ,[AMOUNT]
      ,[TOTAL_DELIVERED_QUANTITY]
      ,[PROJECT]
      ,[PRODUCTION_ORDER]
      ,[OPERATION]
	  ,t.TEXT
      
  FROM [AccessFrontEnds].[dbo].[MMX_PURCHASE_ORDER_LINES] p

  LEFT JOIN MMX_SUPPLIERS s ON p.SUPPLIER = s.SUPPLIER

  LEFT JOIN MMX_ITEM_TEXT t ON p.ORDER_LINE_TEXT = t.TEXTKEY

WHERE p.Supplier in ( @Supplier )

AND ((p.Order_No = @orderNo) or (@orderNo is null))</CommandText>
        <rd:UseGenericDesigner>true</rd:UseGenericDesigner>
      </Query>
      <Fields>
        <Field Name="ORDER_NO">
          <DataField>ORDER_NO</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
        <Field Name="POSITION">
          <DataField>POSITION</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
        <Field Name="SUPPLIER">
          <DataField>SUPPLIER</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="SUPPLIER_NAME">
          <DataField>SUPPLIER_NAME</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="ITEM_CODE">
          <DataField>ITEM_CODE</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="ITEM_DESCRIPTION">
          <DataField>ITEM_DESCRIPTION</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="ORDER_DATE">
          <DataField>ORDER_DATE</DataField>
          <rd:TypeName>System.DateTime</rd:TypeName>
        </Field>
        <Field Name="DELIVERY_DATE">
          <DataField>DELIVERY_DATE</DataField>
          <rd:TypeName>System.DateTime</rd:TypeName>
        </Field>
        <Field Name="DELIVERY_DATE_2">
          <DataField>DELIVERY_DATE_2</DataField>
          <rd:TypeName>System.DateTime</rd:TypeName>
        </Field>
        <Field Name="QUANTITY">
          <DataField>QUANTITY</DataField>
          <rd:TypeName>System.Double</rd:TypeName>
        </Field>
        <Field Name="AMOUNT">
          <DataField>AMOUNT</DataField>
          <rd:TypeName>System.Double</rd:TypeName>
        </Field>
        <Field Name="TOTAL_DELIVERED_QUANTITY">
          <DataField>TOTAL_DELIVERED_QUANTITY</DataField>
          <rd:TypeName>System.Double</rd:TypeName>
        </Field>
        <Field Name="PROJECT">
          <DataField>PROJECT</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="PRODUCTION_ORDER">
          <DataField>PRODUCTION_ORDER</DataField>
