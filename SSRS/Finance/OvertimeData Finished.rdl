<?xml version="1.0" encoding="utf-8"?>
<Report MustUnderstand="df" xmlns="http://schemas.microsoft.com/sqlserver/reporting/2016/01/reportdefinition" xmlns:rd="http://schemas.microsoft.com/SQLServer/reporting/reportdesigner" xmlns:df="http://schemas.microsoft.com/sqlserver/reporting/2016/01/reportdefinition/defaultfontfamily">
  <df:DefaultFontFamily>Segoe UI</df:DefaultFontFamily>
  <AutoRefresh>0</AutoRefresh>
  <DataSources>
    <DataSource Name="NAV">
      <DataSourceReference>NAV</DataSourceReference>
      <rd:SecurityType>None</rd:SecurityType>
      <rd:DataSourceID>d3ef1e93-29b4-4c3e-8554-e77b6614efca</rd:DataSourceID>
    </DataSource>
  </DataSources>
  <DataSets>
    <DataSet Name="DataSet1">
      <Query>
        <DataSourceName>NAV</DataSourceName>
        <QueryParameters>
          <QueryParameter Name="@start">
            <Value>=Parameters!start.Value</Value>
          </QueryParameter>
          <QueryParameter Name="@end">
            <Value>=Parameters!end.Value</Value>
          </QueryParameter>
        </QueryParameters>
        <CommandText>WITH s1 AS
(
	SELECT 
	
	[Prod_ Order No_]
	,CASE [Overtime Applicable]
		WHEN 0 THEN 'selection not made'
		WHEN 1 THEN 'Yes'
		WHEN 2 THEN 'No'
		WHEN 3 THEN 'Silent'
		WHEN 4 THEN '4'
		WHEN 5 THEN 'ZYGO Affiliate'
	END [Overtime Applicable]
	,[Remaining Quantity]
	,[Job No_]

	from [ZYGO$Prod_ Order Line]

	--WHERE [Overtime Applicable] IN (1,5)
)
,s2 AS
(
	SELECT

	[Prod_ Order No_]
	,[Operation No_]
	,'Yes' [Operation Complete]

	from [ZYGO$Prod_ Order Routing Line]

	WHERE 

	Status &gt; 1

	and [Operation Complete] = 1
)
,s3 AS
(
	SELECT 

	SUM([Quantity]) [Time Spent]
	, [Document No_] [Prod_ Order No_]
	,[Operation No_]


	FROM [ZYGO$Capacity Ledger Entry]

	GROUP BY 

	[Document No_]
	,[Operation No_]
)
,s4 AS
(
	SELECT
	
	 SUM([Cost Amount (Actual)]) [Material]
	,[Document No_] 
	
	FROM [ZYGO$Value Entry]
	
	WHERE [Item Ledger Entry Type] = 5  --Consumption

	GROUP BY [Document No_]
)
,s5 AS
(
	select

	[Prod_ Order No_]
	,CASE 
		WHEN  COUNT([Line No_]) = 1 THEN 'Single'
		WHEN  COUNT([Line No_]) &gt; 1 THEN 'Multi'
	END BOMtype

	from [ZYGO$Prod_ Order Line]

	where [Status] &gt; 1

	GROUP BY [Prod_ Order No_]


)
,s6 AS
(

select 

CASE Status
    WHEN 0 THEN 'Simulated'
	WHEN 1 THEN 'Planned'
	WHEN 2 THEN 'Firm Planned'
	WHEN 3 THEN 'Released'
	WHEN 4 THEN 'Finished'
End [Status	]
,s1.[Overtime Applicable]
,[Job No_]
,prl.[Prod_ Order No_]
,prl.[Operation No_]
,prl.[Description]
,prl.[Routing No_] [Item No_]
,i.Description [Item Description]
,s1.[Remaining Quantity]
,[Expected Operation Cost Amt_]
,[Standard Cost]
,prl.[Run Time]
,COALESCE(s3.[Time Spent],0) [Time Spent]
,COALESCE(s2.[Operation Complete],'No') [Operation Complete]




FROM [ZYGO$Prod_ Order Routing Line] prl

INNER JOIN s1 ON prl.[Prod_ Order No_] = s1.[Prod_ Order No_]

LEFT JOIN ZYGO$Item i ON prl.[Routing No_] = i.No_

LEFT JOIN s2 On prl.[Prod_ Order No_] = s2.[Prod_ Order No_] and s2.[Operation No_] = prl.[Operation No_]

LEFT JOIN s3 On prl.[Prod_ Order No_] = s3.[Prod_ Order No_] and s3.[Operation No_] = prl.[Operation No_]

WHERE 1=1

AND prl.[Status] IN (4)

AND Rework = 0

--AND [Starting Date] BETWEEN '2024-03-01' AND '2024-03-31'

AND [Starting Date] BETWEEN @start AND @end

--AND s1.[Remaining Quantity] &gt; 0
)

select 

s6.* 
,s4.Material
,s5.BOMtype

from s6

LEFT JOIN s4 ON s6.[Prod_ Order No_] = s4.[Document No_]

LEFT JOIN s5 ON s6.[Prod_ Order No_] = s5.[Prod_ Order No_]</CommandText>
        <rd:UseGenericDesigner>true</rd:UseGenericDesigner>
      </Query>
      <Fields>
        <Field Name="Status_">
          <DataField>Status	</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Overtime_Applicable">
          <DataField>Overtime Applicable</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Job_No_">
          <DataField>Job No_</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Prod__Order_No_">
          <DataField>Prod_ Order No_</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Operation_No_">
          <DataField>Operation No_</DataField>
