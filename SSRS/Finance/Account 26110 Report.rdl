<?xml version="1.0" encoding="utf-8"?>
<Report MustUnderstand="df" xmlns="http://schemas.microsoft.com/sqlserver/reporting/2016/01/reportdefinition" xmlns:rd="http://schemas.microsoft.com/SQLServer/reporting/reportdesigner" xmlns:df="http://schemas.microsoft.com/sqlserver/reporting/2016/01/reportdefinition/defaultfontfamily">
  <df:DefaultFontFamily>Segoe UI</df:DefaultFontFamily>
  <AutoRefresh>0</AutoRefresh>
  <DataSources>
    <DataSource Name="NAV">
      <DataSourceReference>NAV</DataSourceReference>
      <rd:SecurityType>None</rd:SecurityType>
      <rd:DataSourceID>7376600a-8051-488f-8902-6ec40778f3cd</rd:DataSourceID>
    </DataSource>
  </DataSources>
  <DataSets>
    <DataSet Name="DataSet1">
      <Query>
        <DataSourceName>NAV</DataSourceName>
        <QueryParameters>
          <QueryParameter Name="@start">
            <Value>=Parameters!start.Value</Value>
          </QueryParameter>
          <QueryParameter Name="@end">
            <Value>=Parameters!end.Value</Value>
          </QueryParameter>
        </QueryParameters>
        <CommandText>select distinct

gl.[Posting Date] [G_L Posting Date]
,gl.[G_L Account No_]
,gl.[Document No_]
,gl.Description
,pil.[Buy-from Vendor No_] as [Vendor No]
,COALESCE(v.Name,'') as [Vendor Name]
,gl.[Entry No_]
,gl.[Journal Batch Name]
,gl.[External Document No_]
,gl.Amount
,gl.[Debit Amount]
,gl.[Credit Amount]
,COALESCE(v.[Payment Terms Code],'') [Payment Terms Code]
,pih.[Document Date] [Invoice Date]

from   [ZYGO$G_L Entry] gl

LEFT JOIN [ZYGO$Purch_ Inv_ Line] pil ON pil.[Document No_] = RIGHT(gl.Description, 6)

INNER JOIN [ZYGO$Purch_ Inv_ Header] pih ON pil.[Document No_] = pih.No_

left join ZYGO$Vendor v on pil.[Buy-from Vendor No_]= v.No_

where  [G_L Account No_] = '26110'

AND [Journal Batch Name] IN ('AMETEK BL', 'AMETEK WTA', 'AMETEK WTB')

AND pil.Type = 2

AND gl.[Posting Date] BETWEEN @start and @end

ORDER BY gl.[Posting Date]</CommandText>
        <rd:UseGenericDesigner>true</rd:UseGenericDesigner>
      </Query>
      <Fields>
        <Field Name="G_L_Posting_Date">
          <DataField>G_L Posting Date</DataField>
          <rd:TypeName>System.DateTime</rd:TypeName>
        </Field>
        <Field Name="G_L_Account_No_">
          <DataField>G_L Account No_</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Document_No_">
