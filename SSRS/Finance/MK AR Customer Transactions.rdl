<?xml version="1.0" encoding="utf-8"?>
<Report MustUnderstand="df" xmlns="http://schemas.microsoft.com/sqlserver/reporting/2016/01/reportdefinition" xmlns:rd="http://schemas.microsoft.com/SQLServer/reporting/reportdesigner" xmlns:df="http://schemas.microsoft.com/sqlserver/reporting/2016/01/reportdefinition/defaultfontfamily">
  <df:DefaultFontFamily>Segoe UI</df:DefaultFontFamily>
  <AutoRefresh>0</AutoRefresh>
  <DataSources>
    <DataSource Name="AFE">
      <DataSourceReference>AFE</DataSourceReference>
      <rd:SecurityType>None</rd:SecurityType>
      <rd:DataSourceID>f809d4fc-e1f8-47b6-8ae8-9928cfd626af</rd:DataSourceID>
    </DataSource>
  </DataSources>
  <DataSets>
    <DataSet Name="DataSet1">
      <Query>
        <DataSourceName>AFE</DataSourceName>
        <QueryParameters>
          <QueryParameter Name="@customer">
            <Value>=Parameters!Customer.Value</Value>
            <rd:UserDefined>true</rd:UserDefined>
          </QueryParameter>
        </QueryParameters>
        <CommandText>SELECT

l.PERIOD_NUMBER
,l.JOURNAL_NUMBER
,l.BATCH_NUMBER
,l.INVOICE_NUMBER
,h.INVOICE_DATE
,l.AMOUNT
,h.CUSTOMER_NUMBER
,c.NAME CUSTOMER_NAME

FROM MMX_SALES_POSTED_INVOICE_LINE l

LEFT JOIN MMX_SALES_POSTED_INVOICE_HEADER h ON l.INVOICE_NUMBER = h.INVOICE_NUMBER

LEFT JOIN MMX_CUSTOMERS c ON h.CUSTOMER_NUMBER = c.CUSTOMER

WHERE h.customer_number = @customer

ORDER BY l.PERIOD_NUMBER</CommandText>
        <rd:UseGenericDesigner>true</rd:UseGenericDesigner>
      </Query>
      <Fields>
        <Field Name="PERIOD_NUMBER">
          <DataField>PERIOD_NUMBER</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
        <Field Name="JOURNAL_NUMBER">
          <DataField>JOURNAL_NUMBER</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
        <Field Name="BATCH_NUMBER">
          <DataField>BATCH_NUMBER</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
        <Field Name="INVOICE_NUMBER">
          <DataField>INVOICE_NUMBER</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
        <Field Name="INVOICE_DATE">
          <DataField>INVOICE_DATE</DataField>
          <rd:TypeName>System.DateTime</rd:TypeName>
        </Field>
        <Field Name="AMOUNT">
          <DataField>AMOUNT</DataField>
          <rd:TypeName>System.Double</rd:TypeName>
        </Field>
        <Field Name="CUSTOMER_NUMBER">
          <DataField>CUSTOMER_NUMBER</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="CUSTOMER_NAME">
          <DataField>CUSTOMER_NAME</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
    <DataSet Name="Customers">
      <SharedDataSet>
        <SharedDataSetReference>Customers</SharedDataSetReference>
      </SharedDataSet>
      <Fields>
        <Field Name="CUSTOMER">
          <DataField>CUSTOMER</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
  </DataSets>
