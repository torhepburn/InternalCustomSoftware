      <rd:SecurityType>None</rd:SecurityType>
      <rd:DataSourceID>5d199646-c340-4c25-9424-1cb56ece1630</rd:DataSourceID>
    </DataSource>
  </DataSources>
  <DataSets>
    <DataSet Name="DataSet1">
      <Query>
        <DataSourceName>AFE</DataSourceName>
        <QueryParameters>
          <QueryParameter Name="@LedgerAccount">
            <Value>=Parameters!LedgerAccount.Value</Value>
            <rd:UserDefined>true</rd:UserDefined>
          </QueryParameter>
          <QueryParameter Name="@startingPeriod">
            <Value>=Parameters!startingPeriod.Value</Value>
            <rd:UserDefined>true</rd:UserDefined>
          </QueryParameter>
          <QueryParameter Name="@endingPeriod">
            <Value>=Parameters!EndingPeriod.Value</Value>
            <rd:UserDefined>true</rd:UserDefined>
          </QueryParameter>
        </QueryParameters>
        <CommandText>select

LEDGER_ACCOUNT
,PERIOD_NUMBER
,JOURNAL_NUMBER
,BATCH_NUMBER
,DOCUMENT_NUMBER
,LINE_REFERENCE [DESCRIPTION]
,BOOKING_POSTING_DATE
,AMOUNT

FROM MMX_Posted_Ledger_Transactions

where Ledger_Account = @LedgerAccount

AND Period_number &gt;= @startingPeriod

AND Period_number &lt;= @endingPeriod

ORDER BY Period_Number

,Journal_number
,Batch_number</CommandText>
        <rd:UseGenericDesigner>true</rd:UseGenericDesigner>
      </Query>
