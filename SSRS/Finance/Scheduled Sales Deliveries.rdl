    </DataSource>
  </DataSources>
  <DataSets>
    <DataSet Name="DataSet1">
      <Query>
        <DataSourceName>NAV</DataSourceName>
        <CommandText>select 

[Shortcut Dimension 2 Code]
,[Document No_]
,[SO Line No_]
,[Job No_]
,No_
,[Line Amount] 
,[VAT Difference] 
,[Planned Shipment Date]


--* from [ZYGO$Sales Header] where No_ = '7132'

--select 
 

from [ZYGO$Sales Line] where 1=1

--[Sell-to Customer No_] = 'C00279'

AND [Outstanding Quantity] &gt; 0

AND [Overtime Applicable] &lt;&gt; 0

AND [Planned Shipment Date] &lt; '2030-01-01'

--[Document No_] = '7132'

ORDER BY [Planned Shipment Date]</CommandText>
        <rd:UseGenericDesigner>true</rd:UseGenericDesigner>
      </Query>
      <Fields>
        <Field Name="Shortcut_Dimension_2_Code">
          <DataField>Shortcut Dimension 2 Code</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
