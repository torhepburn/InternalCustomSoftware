<?xml version="1.0" encoding="utf-8"?>
<Report MustUnderstand="df" xmlns="http://schemas.microsoft.com/sqlserver/reporting/2016/01/reportdefinition" xmlns:rd="http://schemas.microsoft.com/SQLServer/reporting/reportdesigner" xmlns:df="http://schemas.microsoft.com/sqlserver/reporting/2016/01/reportdefinition/defaultfontfamily">
  <df:DefaultFontFamily>Segoe UI</df:DefaultFontFamily>
  <AutoRefresh>0</AutoRefresh>
  <DataSources>
    <DataSource Name="NAV">
      <DataSourceReference>NAV</DataSourceReference>
      <rd:SecurityType>None</rd:SecurityType>
      <rd:DataSourceID>a498976c-4d30-40a6-84ad-88be35d07871</rd:DataSourceID>
    </DataSource>
  </DataSources>
  <DataSets>
    <DataSet Name="DataSet1">
      <Query>
        <DataSourceName>NAV</DataSourceName>
        <CommandText>SELECT

--[Arrival Date]  
--,[Depr_ until FA Posting Date]  
[Expected Receipt Date]  
--,[FA Posting Date]  
--,[Order Date] ordDate 
,[Orig_ Promised Receipt Date]  
--,[Orig_ Requested Receipt Date]  
,[Planned Receipt Date]  
,[Promised Receipt Date]  
--,[Release Date]  
--,[Rental End Date]  
--,[Rental Start Date]  
--,[Requested Receipt Date]  
--,[Returns Deferral Start Date] 
,[Document No_]
,[PO Line No_]
,No_
,Description
,[Outstanding Quantity]
,[Unit Cost (LCY)]
,Amount


FROM [ZYGO$Purchase Line]

WHERE 

--([Orig_ Promised Receipt Date] between '2022-10-01' and '2022-12-31' OR

--[Orig_ Promised Receipt Date] &gt; '2049')

([Planned Receipt Date] between '2022-10-01' and '2022-12-31' OR

[Planned Receipt Date] &gt; '2049')

and [Outstanding Quantity] &gt; 0

order by [Orig_ Promised Receipt Date]</CommandText>
        <rd:UseGenericDesigner>true</rd:UseGenericDesigner>
      </Query>
      <Fields>
        <Field Name="Expected_Receipt_Date">
          <DataField>Expected Receipt Date</DataField>
          <rd:TypeName>System.DateTime</rd:TypeName>
        </Field>
        <Field Name="Orig__Promised_Receipt_Date">
          <DataField>Orig_ Promised Receipt Date</DataField>
          <rd:TypeName>System.DateTime</rd:TypeName>
        </Field>
        <Field Name="Planned_Receipt_Date">
          <DataField>Planned Receipt Date</DataField>
          <rd:TypeName>System.DateTime</rd:TypeName>
        </Field>
        <Field Name="Promised_Receipt_Date">
          <DataField>Promised Receipt Date</DataField>
          <rd:TypeName>System.DateTime</rd:TypeName>
        </Field>
        <Field Name="Document_No_">
          <DataField>Document No_</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="PO_Line_No_">
          <DataField>PO Line No_</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
        <Field Name="No_">
          <DataField>No_</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Description">
          <DataField>Description</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Outstanding_Quantity">
          <DataField>Outstanding Quantity</DataField>
          <rd:TypeName>System.Decimal</rd:TypeName>
        </Field>
        <Field Name="Unit_Cost__LCY_">
          <DataField>Unit Cost (LCY)</DataField>
          <rd:TypeName>System.Decimal</rd:TypeName>
        </Field>
        <Field Name="Amount">
          <DataField>Amount</DataField>
          <rd:TypeName>System.Decimal</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
  </DataSets>
