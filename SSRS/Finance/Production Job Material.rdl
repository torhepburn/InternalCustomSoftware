<?xml version="1.0" encoding="utf-8"?>
<Report MustUnderstand="df" xmlns="http://schemas.microsoft.com/sqlserver/reporting/2016/01/reportdefinition" xmlns:rd="http://schemas.microsoft.com/SQLServer/reporting/reportdesigner" xmlns:df="http://schemas.microsoft.com/sqlserver/reporting/2016/01/reportdefinition/defaultfontfamily">
  <df:DefaultFontFamily>Segoe UI</df:DefaultFontFamily>
  <AutoRefresh>0</AutoRefresh>
  <DataSources>
    <DataSource Name="NAV">
      <DataSourceReference>NAV</DataSourceReference>
      <rd:SecurityType>None</rd:SecurityType>
      <rd:DataSourceID>5d07a9a7-6187-45ad-b483-d3c2ed5448ae</rd:DataSourceID>
    </DataSource>
  </DataSources>
  <DataSets>
    <DataSet Name="DataSet1">
      <Query>
        <DataSourceName>NAV</DataSourceName>
        <CommandText>WITH s1 AS
(
	SELECT DISTINCT
	
	[Job No_]

	from [ZYGO$Prod_ Order Line]

	WHERE [Overtime Applicable] IN (1,5)
)
, s2 AS
(
	SELECT

	[Prod_ Order No_]
	,s1.[Job No_]

	FROM [ZYGO$Prod_ Order Line] l

	INNER JOIN s1 ON l.[Job No_] = s1.[Job No_]

)
, s3 AS
(
	SELECT
	
	 SUM([Cost Amount (Actual)]) [Material]
	,[Document No_]
	,s2.[Job No_]
	
	FROM [ZYGO$Value Entry] e

	INNER JOIN s2 ON e.[Document No_] = s2.[Prod_ Order No_]
	
	WHERE [Item Ledger Entry Type] = 5  -- Consumption

	GROUP BY [Document No_], s2.[Job No_]
)
,s4 AS
(
	select 

	[Prod_ Order No_]
	, [Operation No_]
	,CASE [Operation Complete]
		WHEN 0 THEN 'No'
		WHEN 1 THEN 'Yes'
	END [Operation Complete]
	,[Expected Operation Cost Amt_]
	,CASE Status
		WHEN 0 THEN 'Simulated'
		WHEN 1 THEN 'Planned'
		WHEN 2 THEN 'Firm Planned'
		WHEN 3 THEN 'Released'
		WHEN 4 THEN 'Finished'
	End [Status	]


	 from [ZYGO$Prod_ Order Routing Line]

	WHERE Status &gt; 1
)
,s5 AS
(
	select

	r.[Prod_ Order No_]
	,l.[Job No_]
	,r.[Operation No_]
	,r.[Expected Operation Cost Amt_]
	,'Firm Planned' [Status]
	
	from [ZYGO$Prod_ Order Line] l 

	LEFT JOIN [ZYGO$Prod_ Order Routing Line] r ON r.[Prod_ Order No_] = l.[Prod_ Order No_]

	WHERE l.Status = 2

                   AND r.[Routing Reference No_] = 10000  /*	single level bills	*/

	AND LEN(l.[Job No_]) &gt; 0

)
,s6 AS
(
	SELECT
	
	c.[Prod_ Order No_]
	,SUM([Cost Amount]) Material
	
	FROM [ZYGO$Prod_ Order Component] c

	INNER JOIN s5 ON c.[Prod_ Order No_] = s5.[Prod_ Order No_]
	
	GROUP BY c.[Prod_ Order No_]

)


select

s3.[Job No_]
,s4.*

,s3.Material

from s3

LEFT JOIN s4 ON s3.[Document No_] = s4.[Prod_ Order No_]

WHERE LEN([Job No_]) &gt; 0

UNION 


select

s5.[Job No_]
,s5.[Prod_ Order No_]
,s5.[Operation No_]
,'No'
,s5.[Expected Operation Cost Amt_]
,s5.Status
,s6.Material

from s5 LEFT JOIN s6 ON s5.[Prod_ Order No_] = s6.[Prod_ Order No_]</CommandText>
        <rd:UseGenericDesigner>true</rd:UseGenericDesigner>
      </Query>
      <Fields>
        <Field Name="Material">
          <DataField>Material</DataField>
          <rd:TypeName>System.Decimal</rd:TypeName>
        </Field>
        <Field Name="Job_No_">
          <DataField>Job No_</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Prod__Order_No_">
          <DataField>Prod_ Order No_</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Operation_No_">
          <DataField>Operation No_</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Operation_Complete">
          <DataField>Operation Complete</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Status_">
          <DataField>Status	</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Expected_Operation_Cost_Amt_">
          <DataField>Expected Operation Cost Amt_</DataField>
          <rd:TypeName>System.Decimal</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
  </DataSets>
