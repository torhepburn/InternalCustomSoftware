<?xml version="1.0" encoding="utf-8"?>
<Report MustUnderstand="df" xmlns="http://schemas.microsoft.com/sqlserver/reporting/2016/01/reportdefinition" xmlns:rd="http://schemas.microsoft.com/SQLServer/reporting/reportdesigner" xmlns:df="http://schemas.microsoft.com/sqlserver/reporting/2016/01/reportdefinition/defaultfontfamily">
  <df:DefaultFontFamily>Segoe UI</df:DefaultFontFamily>
  <AutoRefresh>0</AutoRefresh>
  <DataSources>
    <DataSource Name="DataSource1">
      <ConnectionProperties>
        <DataProvider>SQL</DataProvider>
        <ConnectString>Data Source=pa-hor-as408;Initial Catalog=ZYGO-NAV-PROD</ConnectString>
      </ConnectionProperties>
      <rd:SecurityType>DataBase</rd:SecurityType>
      <rd:DataSourceID>1b2be6c3-f99e-4b7a-bd86-73e9aafcf3c6</rd:DataSourceID>
    </DataSource>
  </DataSources>
  <DataSets>
    <DataSet Name="DataSet1">
      <Query>
        <DataSourceName>DataSource1</DataSourceName>
        <QueryParameters>
          <QueryParameter Name="@ItemNumber">
            <Value>=Parameters!ItemNumber.Value</Value>
          </QueryParameter>
          <QueryParameter Name="@PeriodEndDate">
            <Value>=Parameters!PeriodEndDate.Value</Value>
            <rd:UserDefined>true</rd:UserDefined>
          </QueryParameter>
        </QueryParameters>
        <CommandText>
select 

'Inventory' [Type]
,'Balance' [Source]
,'' [Item No.]
,''[Description]
,SUM(Quantity) [Quantity Change]
,'' [Document No_]
,GETDATE() [Due Date]

from [ZYGO$Item Ledger Entry]

WHERE [Item No_] = @ItemNumber

UNION ALL

	select 
'MRP'[Type]
,CASE [Action Message]
	WHEN 1 THEN 
	CASE [MPS Order]
		WHEN 0 THEN 'Purchase New'
		WHEN 1 THEN 'Production New'
	END
	WHEN 5 THEN
		CASE [MPS Order]
		WHEN 0 THEN 'Cancel Purchase'
		WHEN 1 THEN 'Cancel Production'
	END
	
END [Source]

,No_ [Item No.]
,Description
,[Remaining Quantity] - [Original Quantity] [Quantity Change]
,'' [Document No.]
,[Due Date] 

	FROM [ZYGO$Requisition Line]

	where 1=1

	AND [Worksheet Template Name] = 'PLANNING'

	AND [Journal Batch Name] = 'DEFAULT'

	AND [Due Date] &lt;= @PeriodEndDate

	AND No_ = @ItemNumber

	UNION ALL
	
	select

	'Production' [Type]
	,CASE Status
		WHEN 2 THEN 'Production Firm Planned'
		WHEN 3 THEN 'Production Released'
		ELSE ''
	END [Source]
	,[Source No_] [Item No.]
	,Description
	,Quantity [Quantity Change]
	, [No_] [Document No.]
	,[Due Date]

	from [ZYGO$Production Order]

	WHERE 1=1 

	AND Status IN (2,3)

	AND [Due Date] &lt;= @PeriodEndDate

	AND [Due Date] &gt;= GETDATE()

	AND [Source No_] = @ItemNumber

	
--)
--, s2b as	/*	production components minus	*/
--(
--	select
--	[Item No_]
--	,SUM(Quantity)*-1 [Quantity Change]

--    from [ZYGO$Prod_ Order Component]

--	WHERE 1=1 

--	AND Status IN (2,3)

--	AND [Due Date] &lt;= '2021-03-31'

--	GROUP BY [Item No_]

--)
--,s3 AS	/*	sales minus	*/
--(

UNION ALL

select

'Sale' [Type]
,'Sales Order' [Source]
,No_ [Item No.]
,[Description]
,[Outstanding Quantity] * (-1) [Quantity Change]
,[Document No_] [Document No.]
,[Shipment Date] [Due Date]


from 


[ZYGO$Sales Line]

WHERE 1=1

	AND [Outstanding Quantity] &gt; 0

	AND [Shipment Date] &lt;= @PeriodEndDate

	AND No_ LIKE @ItemNumber

--	SELECT

--	No_
--	,SUM([Quantity])*-1 [Quantity Change]
	
--	FROM

--	[ZYGO$Sales Line]

--	WHERE 1=1

--	AND [Outstanding Quantity] &gt; 0

--	AND [Shipment Date] &lt;= @PeriodEndDate

--	GROUP BY No_
--)
--, s4 AS
--(
--	SELECT '1' [a] FROM [ZYGO$Item Ledger Entry]
--)



order by [Due Date]</CommandText>
        <rd:UseGenericDesigner>true</rd:UseGenericDesigner>
      </Query>
      <Fields>
        <Field Name="Type">
          <DataField>Type</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Source">
          <DataField>Source</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Item_No_">
          <DataField>Item No.</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Description">
