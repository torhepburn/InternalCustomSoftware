<?xml version="1.0" encoding="utf-8"?>
<Report MustUnderstand="df" xmlns="http://schemas.microsoft.com/sqlserver/reporting/2016/01/reportdefinition" xmlns:rd="http://schemas.microsoft.com/SQLServer/reporting/reportdesigner" xmlns:df="http://schemas.microsoft.com/sqlserver/reporting/2016/01/reportdefinition/defaultfontfamily">
  <df:DefaultFontFamily>Segoe UI</df:DefaultFontFamily>
  <AutoRefresh>0</AutoRefresh>
  <DataSources>
    <DataSource Name="NAV">
      <DataSourceReference>NAV</DataSourceReference>
      <rd:SecurityType>None</rd:SecurityType>
      <rd:DataSourceID>90be99ae-ffbb-4b34-bec5-d1537a0c5eda</rd:DataSourceID>
    </DataSource>
  </DataSources>
  <DataSets>
    <DataSet Name="DataSet1">
      <Query>
        <DataSourceName>NAV</DataSourceName>
        <QueryParameters>
          <QueryParameter Name="@StartDate">
            <Value>=Parameters!StartDate.Value</Value>
            <rd:UserDefined>true</rd:UserDefined>
          </QueryParameter>
          <QueryParameter Name="@EndDate">
            <Value>=Parameters!EndDate.Value</Value>
            <rd:UserDefined>true</rd:UserDefined>
          </QueryParameter>
        </QueryParameters>
        <CommandText>--DECLARE @StartDate date
--,@EndDate date

--SET @StartDate = '10-01-2022'
--SET @EndDate = '2025-10-17';



with s1 AS
(
SELECT

No_ 
, MIN([Posting Date]) [Ship Date]

FROM [ZYGO$Sales Invoice Line]

GROUP BY No_
)
,s2 AS
(
select 

l.[Document No_]
,'Posted Sales Invoice' [Document Type]
,[SO Line No_]
,v.Name
,s1.No_ [Item number]
,l.Description [Item Description]
,l.[Posting Date] [Ship Date]
,l.Amount [Amount Excluding Tax]
,l.[Shortcut Dimension 2 Code] [Business Segment]
,i.[Date Created]


from s1

INNER JOIN [ZYGO$Sales Invoice Line] l ON s1.No_ = l.No_

LEFT JOIN ZYGO$Customer v on l.[Sell-to Customer No_] = v.No_

LEFT JOIN ZYGO$Item i ON s1.No_ = i.No_

WHERE 1=1

AND l.Amount &gt; 0

AND l.[Posting Date] &gt; DATEADD(YY,-3, GETDATE())

AND i.[Date Created] &gt; '2019-07-01'
)

select * from s2 where 1=1

AND [Ship Date] &gt; @StartDate

AND [Ship Date] &lt; @EndDate


ORDER BY Name, [Item number], [Ship Date]</CommandText>
        <rd:UseGenericDesigner>true</rd:UseGenericDesigner>
      </Query>
      <Fields>
        <Field Name="Document_No_">
          <DataField>Document No_</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Document_Type">
          <DataField>Document Type</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="SO_Line_No_">
          <DataField>SO Line No_</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
        <Field Name="Name">
