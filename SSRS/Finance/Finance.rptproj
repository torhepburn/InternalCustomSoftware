<?xml version="1.0" encoding="utf-8"?>
<Project ToolsVersion="Current" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup Condition=" '$(Configuration)' == 'Debug' ">
    <FullPath>Debug</FullPath>
    <OutputPath>bin\Debug</OutputPath>
    <ErrorLevel>2</ErrorLevel>
    <OverwriteDatasets>False</OverwriteDatasets>
    <OverwriteDataSources>False</OverwriteDataSources>
    <TargetServerVersion>SSRS2016</TargetServerVersion>
    <Platform>Win32</Platform>
    <TargetReportFolder>Finance</TargetReportFolder>
    <TargetDatasetFolder>Datasets</TargetDatasetFolder>
    <TargetDatasourceFolder>Data Sources</TargetDatasourceFolder>
    <TargetReportPartFolder>Report Parts</TargetReportPartFolder>
    <TargetServerURL>http://ct-mid-sql11/reportserver</TargetServerURL>
  </PropertyGroup>
  <PropertyGroup Condition=" '$(Configuration)' == 'DebugLocal' ">
    <FullPath>DebugLocal</FullPath>
    <OutputPath>bin\DebugLocal</OutputPath>
    <ErrorLevel>2</ErrorLevel>
    <OverwriteDatasets>False</OverwriteDatasets>
    <OverwriteDataSources>False</OverwriteDataSources>
    <TargetServerVersion>SSRS2016</TargetServerVersion>
    <Platform>Win32</Platform>
    <TargetReportFolder>Finance</TargetReportFolder>
    <TargetDatasetFolder>Datasets</TargetDatasetFolder>
    <TargetDatasourceFolder>Data Sources</TargetDatasourceFolder>
    <TargetReportPartFolder>Report Parts</TargetReportPartFolder>
    <TargetServerURL>http://ct-mid-sql11/reportserver</TargetServerURL>
  </PropertyGroup>
  <PropertyGroup Condition=" '$(Configuration)' == 'Release' ">
    <FullPath>Release</FullPath>
    <OutputPath>bin\Release</OutputPath>
    <ErrorLevel>2</ErrorLevel>
    <OverwriteDatasets>False</OverwriteDatasets>
    <OverwriteDataSources>False</OverwriteDataSources>
    <TargetServerVersion>SSRS2016</TargetServerVersion>
    <Platform>Win32</Platform>
    <TargetReportFolder>Finance</TargetReportFolder>
    <TargetDatasetFolder>Datasets</TargetDatasetFolder>
    <TargetDatasourceFolder>Data Sources</TargetDatasourceFolder>
    <TargetReportPartFolder>Report Parts</TargetReportPartFolder>
    <TargetServerURL>http://ct-mid-sql11/reportserver</TargetServerURL>
  </PropertyGroup>
  <PropertyGroup>
    <State>$base64$</State>
    <DataSources>@(DataSource)</DataSources>
    <DataSets>@(DataSet)</DataSets>
    <Reports>@(Report)</Reports>
  </PropertyGroup>
  <ItemGroup>
    <DataSource Include="AFE.rds" />
    <DataSource Include="DataSource1.rds" />
    <DataSource Include="NAV.rds" />
    <DataSource Include="NAVDEV.rds" />
    <DataSource Include="NAVPROD.rds" />
    <DataSource Include="NAVTEST.rds" />
  </ItemGroup>
  <ItemGroup>
    <Report Include="'New' Item Shipments - Select Dates.rdl" />
    <Report Include="Account 21105.003 Details.rdl" />
    <Report Include="Account 21411 Details.rdl" />
    <Report Include="All NAV Items.rdl" />
    <Report Include="AP Purchase Returns.rdl" />
    <Report Include="AVATAX Document Summary.rdl" />
    <Report Include="AVATAX Report.rdl" />
    <Report Include="AVATAX State Totals.rdl" />
    <Report Include="Budget Maestro v05.rdl" />
    <Report Include="Customer Change.rdl" />
    <Report Include="Dashboard Dates.rdl" />
    <Report Include="Finance Setup Change Report.rdl" />
    <Report Include="First Draft UnpostedJournals.rdl" />
    <Report Include="Forecast Shipments Taxable.rdl" />
    <Report Include="Inventory Detail Items for PBI.rdl" />
    <Report Include="Inventory Forcast Value.rdl" />
    <Report Include="Inventory Last Receipt.rdl" />
    <Report Include="Invoice in NAV not in AVATAX.rdl" />
    <Report Include="Invoice in NAV.rdl" />
    <Report Include="Item Availability by Event Details.rdl" />
    <Report Include="Item Availability by Event.rdl" />
    <Report Include="Item Availability Forecast Value.rdl" />
    <Report Include="MFIX22.rdl" />
    <Report Include="MK Dates.rdl" />
    <Report Include="Monthly Sales Register.rdl" />
    <Report Include="NAV Daily Audit Report.rdl" />
    <Report Include="NAV Item Data ABC.rdl" />
    <Report Include="NAV On Hand.rdl" />
    <Report Include="New Items First Shipment.rdl" />
    <Report Include="PO Line Pushout Evaluation.rdl" />
    <Report Include="Posted Journals.rdl" />
    <Report Include="Posted Sales Invoices.rdl" />
    <Report Include="Purchase Invoices for Use Tax Consideration.rdl" />
    <Report Include="Purchase Register.rdl" />
    <Report Include="Sales Deliveries v02.rdl" />
    <Report Include="toredtestrdl.rdl" />
    <Report Include="UAT3UnpostedJournals.rdl" />
    <Report Include="Uninvoiced Receipts.rdl" />
    <Report Include="Unposted Journals.rdl" />
    <Report Include="Unposted JournalsUAT3.rdl" />
    <Report Include="Use Tax from GL iPower.rdl" />
    <Report Include="Use Tax from GL.rdl" />
    <Report Include="Vendor Changes.rdl" />
    <Report Include="Vendor Listing.rdl" />
    <Report Include="Vendors for AP.rdl" />
  </ItemGroup>
  <Import Project="$(MSBuildExtensionsPath)\Reporting Services\Microsoft.ReportingServices.MSBuilder.targets" />
</Project>