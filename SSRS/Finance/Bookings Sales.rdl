<?xml version="1.0" encoding="utf-8"?>
<Report MustUnderstand="df" xmlns="http://schemas.microsoft.com/sqlserver/reporting/2016/01/reportdefinition" xmlns:rd="http://schemas.microsoft.com/SQLServer/reporting/reportdesigner" xmlns:df="http://schemas.microsoft.com/sqlserver/reporting/2016/01/reportdefinition/defaultfontfamily">
  <df:DefaultFontFamily>Segoe UI</df:DefaultFontFamily>
  <AutoRefresh>0</AutoRefresh>
  <DataSources>
    <DataSource Name="NAV">
      <DataSourceReference>NAV</DataSourceReference>
      <rd:SecurityType>None</rd:SecurityType>
      <rd:DataSourceID>2f42b9a7-73fc-4ef5-ab35-f448fc813799</rd:DataSourceID>
    </DataSource>
  </DataSources>
  <DataSets>
    <DataSet Name="DataSet1">
      <Query>
        <DataSourceName>NAV</DataSourceName>
        <CommandText>DECLARE @days int
SET @days = 1;

WITH s1 AS	/*	all line amount changes in time frame	*/
(
select 

DATEADD(hh, -5, [Date and Time]) TransactionDate
,[Old Value]
,[New Value]
,[Primary Key Field 2 Value] pk2
,[Primary Key Field 3 Value] pk3
,[Primary Key Field 2 Value] + [Primary Key Field 3 Value] FreightLineTest

from 

[ZYGO$Change Log Entry]

WHERE [Table No_] = 37  --Sales Line

AND CAST(DATEADD(hh, -5, [Date and Time]) AS date) = CAST(GETDATE()-@days as date)

AND [Field No_] IN (103) --Line Amount

)
,s2 AS	/*	get all lines where SO Line Number &gt;= 500	*/

(	
	SELECT 

   [Primary Key Field 2 Value] + [Primary Key Field 3 Value] FreightLines
	
	from 

	[ZYGO$Change Log Entry]

	WHERE [Table No_] = 37  --Sales Line

	AND CAST(DATEADD(hh, -5, [Date and Time]) AS date) = CAST(GETDATE()-@days as date)

	AND [Primary Key Field 2 Value] IN (Select pk2 from s1)
	
	AND [Field No_] = 50000

	AND [New Value] &gt;= 500
)
,s3 AS
(
select

 SUM(CAST([Old Value] as float)) old
,SUM(CAST([New Value] as float)) new
,SUM(CAST([New Value] as float)) - SUM(CAST([Old Value] as float)) Net_Amount
,s1.pk2

FROM s1

WHERE s1.FreightLineTest NOT IN (Select FreightLines from s2)

GROUP BY s1.pk2
)
,s4 AS
(	
	SELECT

	[New Value] + ' - ' + COALESCE(i.Description,'') Item
	,[Primary Key Field 2 Value] pk2
	,[Primary Key Field 3 Value] pk3
	

	FROM [ZYGO$Change Log Entry] cle

	/*Need to get the description from the sales Line due to SERs.  */

	INNER JOIN s3 ON s3.pk2 = cle.[Primary Key Field 2 Value]

	INNER JOIN [ZYGO$Sales Line] i on s3.pk2 = i.[Document No_] and cle.[Primary Key Field 3 Value] = i.[Line No_]

	WHERE 

	[Table No_] = 37	--sales line

	AND [Field No_] = 6	--No_

	AND LEFT([New Value],5)&lt;&gt; '50160'  /*	filtering out freight account numbers	*/
	
	AND CAST([Date and Time] as date) = CAST(GETDATE()-1 as date)
	
	AND (COALESCE([Primary Key Field 2 Value],'') + COALESCE([Primary Key Field 3 Value],''))

	NOT IN (Select FreightLines from s2)
)
,s5 AS	/*  fnding the first item line as it will be the most significant for Linda Z	*/
(
	SELECT
	
	 pk2
	,MIN(pk3) linkLine

	FROM s4

	GROUP BY pk2
)
, s6 AS
(
	SELECT

	s4.pk2
	,Item

	FROM s4 INNER JOIN s5 ON s5.pk2 = s4.pk2 and s5.linkLine = s4.pk3
)


SELECT 

CAST(GETDATE() - 1 as date) TransactionDate
,s3.pk2
--,Net_Amount
,h.[Sell-to Customer Name]
,h.[Sell-to County]
,h.[Sell-to Country_Region Code]
,c.[Customer Group Code]
,h.[Ship-to County]
,h.[Ship-to Country_Region Code]
,h.[External Document No_] [Customer PO]
,Net_Amount
,vreg.Name'Region'
,dreg.[Dimension Value Code] 'Region Code'
,COALESCE(h.[Salesperson Code],'') Sales_Agent
,vind.Name 'Industry'
,dind.[Dimension Value Code]'Industry Code'
,COALESCE(Item,'') Item
,dseg.[Dimension Value Code]'Segment'


FROM s3

INNER JOIN [ZYGO$Sales Header] h ON s3.pk2 = h.[No_]

left join	[ZYGO$Dimension Set Entry] dseg on h.[Dimension Set ID] = dseg.[Dimension Set ID] and dseg.[Dimension Code] = 'SEGMENT'
left join	[ZYGO$Dimension Set Entry] dind on h.[Dimension Set ID] = dind.[Dimension Set ID] and dind.[Dimension Code] = 'INDUSTRY'
left join	[ZYGO$Dimension Set Entry] dreg on h.[Dimension Set ID] = dreg.[Dimension Set ID] and dreg.[Dimension Code] = 'REGION'

left join [ZYGO$Dimension Value] vreg ON dreg.[Dimension Value ID] = vreg.[Dimension Value ID] and dreg.[Dimension Code] = 'REGION'
left join [ZYGO$Dimension Value] vind on dind.[Dimension Value ID] = vind.[Dimension Value ID] and dind.[Dimension Code] = 'INDUSTRY'

lEFT JOIN ZYGO$Customer c ON h.[Sell-to Customer No_] = c.No_

INNER JOIN s6 ON s3.pk2 = s6.pk2

WHERE h.[Document Type] = 1

ORDER BY s3.pk2
</CommandText>
        <rd:UseGenericDesigner>true</rd:UseGenericDesigner>
      </Query>
      <Fields>
        <Field Name="TransactionDate">
          <DataField>TransactionDate</DataField>
          <rd:TypeName>System.DateTime</rd:TypeName>
        </Field>
        <Field Name="pk2">
          <DataField>pk2</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Sell_to_Customer_Name">
          <DataField>Sell-to Customer Name</DataField>
