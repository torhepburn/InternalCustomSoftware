  <DataSets>
    <DataSet Name="DataSet1">
      <Query>
        <DataSourceName>NAV</DataSourceName>
        <CommandText>/*	09-15-21 populating invoice and invoice date per dan simha request	*/

DECLARE 
	 @start datetime
	,@end datetime

SET @start = '05-01-2024'
SET @end = '05-31-2024';


WITH s1 AS
(
	SELECT 
	
	 [Item No_] ITEM_CODE
	,[Sales Code] SALES_PRICE_LIST
	,[Unit Price] PRICE

	FROM [ZYGO$Sales Price]

	WHERE 
	
	[Ending Date] &gt;= @end
	AND [Starting Date] &lt;= @end

)

SELECT DISTINCT

 ds.[Dimension Value Code]  AREA
,dv.Name AreaDesc
,sil.[Bin Code] WAREHOUSE
,b.Description WHDesc
,sil.[Sell-to Customer No_] CUSTOMER
,c.Name NAME
,sh.[External Document No_] CUSTOMER_PO
,sh.[End User Customer Name] EndUserName
,sh.[No_] ORDER_NO
,sil.[Job No_] PROJECT
,sil.[SO Line No_] POSITION
,'' SRNO
,sil.[Shipment Date] DELIVERY_DATE
,sil.No_ ITEM_CODE
,CASE 
	WHEN LEN(sil.[Job No_]) &gt; 0 THEN j.Description + ';  ' + j.[Description 2] + ' (' + i.Description + ')'
	ELSE i.Description
 
 END GenericDesc
,i.Description ITEM_DESCRIPTION
,CASE i.[Replenishment System]
	WHEN 0 THEN 'P'
	WHEN 1 THEN 'M'
END ItemTypeDesc
 ,sh.[Order Date] ORDER_DATE
 ,sl.[Requested Delivery Date] REQUESTED_DATE
 ,sl.Quantity ORDERED_QUANTITY
 ,sil.[Quantity] DELIVERED_QUANTITY
 ,sl.[Outstanding Quantity] BACK_ORDER
 ,'' DISPATCH_NOTE_NUMBER
 --,'' INVOICE_DATE
 --,'' INVOICE
 ,sih.[Posting Date] INVOICE_DATE
 ,sih.No_ INVOICE
 ,sil.[Unit Price] PRICE
 ,sil.[Inv_ Discount Amount] ORDER_DISCOUNT
 ,sil.[Line Discount Amount] DISCOUNT
 ,sil.[Line Amount] NetSell
  ,0 NetSellTransferMargin
  ,0 AS NetSellZJVTransferMargin
 ,sil.[Unit Cost (LCY)] COST_PRICE
 ,i.[Standard Cost] STANDARD_COST_PRICE
 ,i.[Rolled-up Material Cost] MATERIAL_COSTS
 ,i.[Standard Cost] - i.[Rolled-up Material Cost] OPERATION_COSTS
 ,[Quantity Shipped] * i.[Standard Cost] AS StdCostSell					/*	DELIVERED_QUANTITY * PLCost	*/
 ,([Quantity Shipped] * (i.[Standard Cost] - i.[Rolled-up Material Cost])) AS OpsCostSell		/*	DELIVERED_QUANTITY * OPERATION_COSTS*/
 ,[Quantity Shipped] * i.[Rolled-up Material Cost] AS MatlCostSell				/*DELIVERED_QUANTITY * MATERIAL_COSTS*/
  , 0 as StdTransferMargin
  ,0 as ZJVTransferMargin
 ,0 Transfer
 ,0 TransferCalc
 ,0 DomList
 ,0 DomCalc
 ,0 ZJV
 ,0 ZJVCalc
 ,0  AS ZJVSell		/* DELIVERED_QUANTITY * ZJV */
 ,0 AS TransferSell	/*DELIVERED_QUANTITY * Transfer	*/
 ,0 PLCost
 ,0 PLBasis
 ,0 LeadTime
 ,0 DaysLate
 ,0 OnTime
 ,sh.[Payment Terms Code] TERMS_OF_PAYMENT
 ,sh.[Shipment Method Code] TERMS_OF_DELIVERY
 ,sh.[Ship-to Code] DELIVERY_ADDRESS
 ,sh.[Customer Price Group] SO_Price_List
 ,s1.PRICE ListPrice
 
 

from [ZYGO$Sales Header] sh 
 
LEFT JOIN [ZYGO$Dimension Set Entry] ds on sh.[Dimension Set ID] = ds.[Dimension Set ID] and [Dimension Code] = 'REGION'

LEFT JOIN [ZYGO$Dimension Value] dv on ds.[Dimension Value ID] = dv.[Dimension Value ID]

INNER JOIN [ZYGO$Sales Line] sl on sl.[Document No_] = sh.No_

LEFT JOIN [ZYGO$Bin] b on b.Code = sl.[Bin Code]

INNER JOIN ZYGO$Customer c on sl.[Sell-to Customer No_] = c.No_

LEFT JOIN [ZYGO$Job] j on j.No_ = sl.[Job No_]

LEFT JOIN ZYGO$Item i on sl.No_ = i.No_

INNER JOIN [ZYGO$Sales Shipment Header] ssh on ssh.[Order No_] = sh.[No_]

INNER JOIN [ZYGO$Sales Shipment Line] ssl on ssh.[No_] = ssl.[Document No_] and ssl.[SO Line No_] = sl.[SO Line No_]

INNER JOIN [ZYGO$Sales Invoice Header] sih on sih.[Order No_] = sh.[No_]

INNER JOIN [ZYGO$Sales Invoice Line] sil on sih.[No_] = sil.[Document No_] and ssl.[SO Line No_] = sil.[SO Line No_]

LEFT JOIN s1 on s1.SALES_PRICE_LIST = sh.[Customer Price Group] and s1.ITEM_CODE = sl.No_

WHERE 
 
 sil.[Shipment Date] &gt;= @start

 AND

 sil.[Shipment Date] &lt;= @end

 AND 
 
 sl.[SO Line No_] &lt; 500

 AND (sil.Quantity) != 0

--AND ((sil.[Sell-to Customer No_] LIKE '%' + @CustomerNumber +  '%') OR @CustomerNumber is null )

--AND ((c.[Name] LIKE '%' + @CustomerName +  '%') OR @CustomerName is null )</CommandText>
        <rd:UseGenericDesigner>true</rd:UseGenericDesigner>
      </Query>
