,'6500-0620-11'
,'6507-0435-01'
,'6507-0435-02'
,'6550-0122-02'
,'6550-0145-01'
,'6550-0146-02'
)

GROUP BY

l.No_
,l.Description
,CASE dseg.[Dimension Value Code]
	WHEN 'LASER INTERF PROD' THEN 'LAS'
	WHEN 'LASER INTERF SVCS' THEN 'LAS'
	WHEN 'LASER INTERFEROMETER' THEN 'LAS'
	WHEN 'OPT PROFILER PROD' THEN 'OPT'
	WHEN 'OPT PROFILER SVCS' THEN 'OPT'
	WHEN 'OPT PROFILER' THEN 'OPT'
END 
,dreg.[Dimension Value Code]
,dv.Name
,CAST(YEAR(l.[Promised Delivery Date]) as nchar(4)) +
CASE MONTH(l.[Promised Delivery Date]) 
	WHEN 1 THEN '01'
	WHEN 2 THEN '02'
	WHEN 3 THEN '03'
	WHEN 4 THEN '04'
	WHEN 5 THEN '05'
	WHEN 6 THEN '06'
	WHEN 7 THEN '07'
	WHEN 8 THEN '08'
	WHEN 9 THEN '09'
	WHEN 10 THEN '10'
	WHEN 11 THEN '11'
	WHEN 12 THEN '12'
	ELSE ''
END</CommandText>
        <rd:UseGenericDesigner>true</rd:UseGenericDesigner>
      </Query>
