<?xml version="1.0" encoding="utf-8"?>
<Report MustUnderstand="df" xmlns="http://schemas.microsoft.com/sqlserver/reporting/2016/01/reportdefinition" xmlns:rd="http://schemas.microsoft.com/SQLServer/reporting/reportdesigner" xmlns:df="http://schemas.microsoft.com/sqlserver/reporting/2016/01/reportdefinition/defaultfontfamily">
  <df:DefaultFontFamily>Segoe UI</df:DefaultFontFamily>
  <AutoRefresh>0</AutoRefresh>
  <DataSources>
    <DataSource Name="NAV">
      <DataSourceReference>NAV</DataSourceReference>
      <rd:SecurityType>None</rd:SecurityType>
      <rd:DataSourceID>8951b6db-62c4-4397-9940-44f98fbebd59</rd:DataSourceID>
    </DataSource>
  </DataSources>
  <DataSets>
    <DataSet Name="DataSet1">
      <Query>
        <DataSourceName>NAV</DataSourceName>
        <CommandText>SELECT

l.No_
,l.Description
,SUM(l.Amount) ProjectedRevenue
,CASE dseg.[Dimension Value Code]
	WHEN 'LASER INTERF PROD' THEN 'LAS'
	WHEN 'LASER INTERF SVCS' THEN 'LAS'
	WHEN 'LASER INTERFEROMETER' THEN 'LAS'
	WHEN 'OPT PROFILER PROD' THEN 'OPT'
	WHEN 'OPT PROFILER SVCS' THEN 'OPT'
	WHEN 'OPT PROFILER' THEN 'OPT'
END Segment
,dreg.[Dimension Value Code] Region
,dv.Name
,CAST(YEAR(l.[Promised Delivery Date]) as nchar(4)) +
CASE MONTH(l.[Promised Delivery Date]) 
	WHEN 1 THEN '01'
	WHEN 2 THEN '02'
	WHEN 3 THEN '03'
	WHEN 4 THEN '04'
	WHEN 5 THEN '05'
	WHEN 6 THEN '06'
	WHEN 7 THEN '07'
	WHEN 8 THEN '08'
	WHEN 9 THEN '09'
	WHEN 10 THEN '10'
	WHEN 11 THEN '11'
	WHEN 12 THEN '12'
	ELSE ''
END [Promised Delivery Date]

from [ZYGO$Sales Header] h

INNER JOIN [ZYGO$Sales Line] l ON h.No_ = l.[Document No_] and h.[Document Type] = l.[Document Type]

left join	[ZYGO$Dimension Set Entry] dseg on l.[Dimension Set ID] = dseg.[Dimension Set ID] and dseg.[Dimension Code] = 'SEGMENT'

left join	[ZYGO$Dimension Set Entry] dreg on l.[Dimension Set ID] = dreg.[Dimension Set ID] and dreg.[Dimension Code] = 'REGION'


LEFT JOIN [ZYGO$Dimension Value] dv ON dreg.[Dimension Value Code] = dv.Code

LEFT JOIN ZYGO$Customer c ON h.[Sell-to Customer No_] = c.No_

WHERE [Outstanding Quantity] &lt;&gt; 0

AND h.[Document Type] = 1

AND l.[Promised Delivery Date] &lt; '2024-12-31'

AND l.No_ IN

(
 '6024-0161-01'
,'6024-0283-01'
,'6024-0302-01'
,'6024-0304-01'
,'6024-0309-11'
,'6024-0311-11'
,'6024-0312-01'
,'6024-0314-11'
,'6024-0317-11'
,'6024-0322-01'
,'6024-0323-01'
,'6024-0356-01'
,'6024-0371-02'
,'6024-0385-11'
,'6024-0399-11'
,'6024-0399-13'
,'6024-0399-14'
,'6024-0419-11'
,'6024-0420-01'
,'6024-0429-01'
,'6024-0430-11'
,'6024-0430-13'
,'6024-0456-11'
,'6068-0444-01'
,'6300-0194-02'
,'6300-0307-01'
