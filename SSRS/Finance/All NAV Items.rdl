    </DataSource>
  </DataSources>
  <DataSets>
    <DataSet Name="DataSet1">
      <Query>
        <DataSourceName>DataSource1</DataSourceName>
        <CommandText>SELECT 

No_
,Description
,[Description 5]
,CASE Vetted
	WHEN 0 THEN 'Vetted'
	WHEN 1 THEN 'Non-vetted'
END Vetted
,[Base Unit of Measure]
,[Standard Cost]
,[Inventory Posting Group]
,[Gen_ Prod_ Posting Group]
,[Item Category Code]
,[Global Dimension 1 Code] [CostCenter]
,[Global Dimension 2 Code] Segment
,'' [Dashboard Last Date]
,'' [MK Last Date]
,'' [NAV Last Date]
,'' [Last Date]
,P6
,F6
,EAU

FROM ZYGO$Item</CommandText>
        <rd:UseGenericDesigner>true</rd:UseGenericDesigner>
      </Query>
      <Fields>
        <Field Name="No_">
          <DataField>No_</DataField>
          <rd:TypeName>System.String</rd:TypeName>
