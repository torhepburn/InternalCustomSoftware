  <DataSets>
    <DataSet Name="DataSet1">
      <Query>
        <DataSourceName>NAV</DataSourceName>
        <CommandText>select * from [ZYGO$G_L Entry]

WHERE [G_L Account No_] in 
(
 '62050'
, '62013'
, '50160.004'
,'51016'
,'61140'
,'62023'
,'50160.001'
,'62008'
,'62040'
,'62290'
,'62015'
,'74851'
,'50160.002'
)

AND [Posting Date] &gt;= '2024-01-01'</CommandText>
        <rd:UseGenericDesigner>true</rd:UseGenericDesigner>
      </Query>
