<?xml version="1.0" encoding="utf-8"?>
<Report MustUnderstand="df" xmlns="http://schemas.microsoft.com/sqlserver/reporting/2016/01/reportdefinition" xmlns:rd="http://schemas.microsoft.com/SQLServer/reporting/reportdesigner" xmlns:df="http://schemas.microsoft.com/sqlserver/reporting/2016/01/reportdefinition/defaultfontfamily">
  <df:DefaultFontFamily>Segoe UI</df:DefaultFontFamily>
  <AutoRefresh>0</AutoRefresh>
  <DataSources>
    <DataSource Name="NAV">
      <DataSourceReference>NAV</DataSourceReference>
      <rd:SecurityType>None</rd:SecurityType>
      <rd:DataSourceID>728c1e7d-d083-468b-8051-16b881948fcd</rd:DataSourceID>
    </DataSource>
  </DataSources>
  <DataSets>
    <DataSet Name="DataSet1">
      <Query>
        <DataSourceName>NAV</DataSourceName>
        <CommandText>WITH s1 AS
(
	SELECT

	[Item No_]
	,SUM(Quantity) OnHand

	FROM [ZYGO$Item Ledger Entry]

	GROUP BY [Item No_]
)

SELECT --top 20

[Inventory Posting Group]
,i.[Global Dimension 2 Code] [Business Segment]
,i.[Item Group Code]
,i.No_ [Item]
,i.Description
,s1.OnHand Quantity					/*	L	*/
,[Standard Cost]					/*	M	*/
,s1.OnHand * [Standard Cost] [Ext Std]		/*	N   */
,(i.[Rolled-up Material Cost]*s1.OnHand) 
	+ (i.[Rolled-up Subcontracted Cost]*s1.OnHand) [Ext Material]		/*	O	*/
,i.[Rolled-up Capacity Cost]*s1.OnHand [Ext Lbr]					/*	P	*/
,i.[Rolled-up Cap_ Overhead Cost]*s1.OnHand [Ext OH]			/*	Q	*/
,i.[Rolled-up Material Cost]	    /*  R   */
,i.[Rolled-up Capacity Cost]		/*  S   */
,i.[Rolled-up Cap_ Overhead Cost]	/*	T	*/
,i.[Rolled-up Subcontracted Cost]	/*	U	*/
,i.[Signal Code]					/*	V	*/
,i.[Last Counting Period Update]	/*	W	*/
--,i.Kanban							/*	X	*/
,i.[Selection Code]
,i.[Safety Stock Quantity]
,CASE i.Vetted
	WHEN 0 THEN 'Vetted'
	WHEN 1 THEN 'Unvetted'
	ELSE ''
END Vetted
,i.[Service Item Group]
,i.[Lead Time Calculation]
--,i.Job

,CASE i.[Replenishment System]
	WHEN 0 THEN 'Purchase'
	WHEN 1 THEN 'Production Order'
END Procurement
,i.[Vendor No_]
,v.Name [Vendor Name]


FROM ZYGO$Item i

INNER JOIN s1 ON i.No_ = s1.[Item No_]

INNER JOIN ZYGO$Vendor v ON i.[Vendor No_] = v.No_

WHERE [Inventory Posting Group] &lt;&gt; 'EXP'

AND OnHand &gt; 0</CommandText>
        <rd:UseGenericDesigner>true</rd:UseGenericDesigner>
      </Query>
