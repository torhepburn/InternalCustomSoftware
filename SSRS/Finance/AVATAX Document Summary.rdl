<?xml version="1.0" encoding="utf-8"?>
<Report MustUnderstand="df" xmlns="http://schemas.microsoft.com/sqlserver/reporting/2016/01/reportdefinition" xmlns:rd="http://schemas.microsoft.com/SQLServer/reporting/reportdesigner" xmlns:df="http://schemas.microsoft.com/sqlserver/reporting/2016/01/reportdefinition/defaultfontfamily">
  <df:DefaultFontFamily>Segoe UI</df:DefaultFontFamily>
  <AutoRefresh>0</AutoRefresh>
  <DataSources>
    <DataSource Name="DataSource1">
      <ConnectionProperties>
        <DataProvider>SQL</DataProvider>
        <ConnectString>Data Source=pa-hor-as408;Initial Catalog=ZYGO-NAV-PROD</ConnectString>
      </ConnectionProperties>
      <rd:SecurityType>DataBase</rd:SecurityType>
      <rd:DataSourceID>3d143b21-a78f-4cb2-95dc-1f2af31a5c04</rd:DataSourceID>
    </DataSource>
  </DataSources>
  <DataSets>
    <DataSet Name="DataSet1">
      <Query>
        <DataSourceName>DataSource1</DataSourceName>
        <CommandText>WITH s1 AS
(
SELECT DISTINCT

 h.[Document No_] [Document Code]
,h.[Customer No_] [Customer Vendor Code]
,CASE

	WHEN sih.[Posting Date] is not null THEN sih.[Posting Date]
	WHEN vih.[Posting Date] is not null THEN vih.[Posting Date]
END [Document Date]
, COALESCE(CASE
	WHEN [Exempted Amount] &gt; 0 THEN [Exempted Amount]
	WHEN [Taxable Amount] &gt; 0 THEN [Taxable Amount]
  END, 0) [Total Sales]
, CASE [Document Status]
	WHEN 3 THEN 'Committed'
END [DOC STATUS]

, SUBSTRING(dh.[Tax Name], 1,2) REGION
, COALESCE(CASE
	WHEN [Exempted Amount] &gt; 0 THEN [Exempted Amount]
	WHEN [Taxable Amount] &gt; 0 THEN [Taxable Amount]
  END, 0) AMOUNT
, [Exempted Amount] [NOT TAXED]
, [Taxable Amount] TAXABLE
,[Tax Amount] TAX


--,*

FROM [ZYGO-NAV-PROD].[dbo].[ZYGO$AVA Header History] h

INNER JOIN [ZYGO$AVA Detail History] dh on h.[Document No_] = dh.[Document No_]

INNER JOIN [ZYGO$AVA Juris_ History] j ON dh.[Document No_] = j.[Document No_] AND dh.[Document Line No_] = j.[Document Line No_]

LEFT JOIN [ZYGO$Sales Invoice Header] sih ON sih.No_ = h.[Document No_]

LEFT JOIN [ZYGO$Service Invoice Header] vih ON vih.No_ = h.[Document No_]

WHERE 
(
(sih.[Posting Date] &gt;= '2021-09-01' and sih.[Posting Date] &lt;= '2021-09-30')
or
(vih.[Posting Date] &gt;= '2021-09-01' and vih.[Posting Date] &lt;= '2021-09-30')
)
AND j.[Tax Description] NOT IN 
(
'ARGENTINA'
,'CANADA'
,'COSTA RICA'
,'DOMINICAN REPUBLIC'
,'GERMANY'
,'INDIA'
,'ITALY'
,'JAPAN'
,'LAO PEOPLE''S DEMOCRATIC REPUBLIC'
,'MALAYSIA'
,'MEXICO'
,'NETHERLANDS'
,'REPUBLIC OF KOREA'
,'SINGAPORE'
,'SWITZERLAND'
,'THAILAND'
,'UNITED KINGDOM'
,'AUSTRALIA'
,'BRAZIL'
,'CHINA'
,'FRANCE'
,'GERMANY'
,'HONG KONG'
,'INDONESIA'
,'IRELAND'
,'ISRAEL'
,'JAPAN'
,'KOREA, REPUBLIC OF'
,'PHILIPPINES'
,'PUERTO RICO'
,'QATAR'
,'RUSSIAN FEDERATION'
,'SOUTH AFRICA'
,'TAIWAN'
,'VIETNAM'
)
)

SELECT * FROM s1 ORDER BY [Document Date]

--and h.[Document No_] like 'SOI%'</CommandText>
        <rd:UseGenericDesigner>true</rd:UseGenericDesigner>
      </Query>
      <Fields>
        <Field Name="Document_Code">
          <DataField>Document Code</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Customer_Vendor_Code">
          <DataField>Customer Vendor Code</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Document_Date">
