    </DataSource>
  </DataSources>
  <DataSets>
    <DataSet Name="DataSet1">
      <Query>
        <DataSourceName>NAV</DataSourceName>
        <CommandText>SELECT 

No_
, [Assigned User ID]
,[Source No_]
, [Description] 
,CASE [Status]
	WHEN 2 THEN 'Firm Planned'
	WHEN 3 THEN 'Released'
END [Status]
,[Due Date]


FROM [ZYGO$Production Order] 

WHERE 1=1 

AND Quantity &gt; 0

AND Status in (2,3)

order by [Creation Date] desc</CommandText>
        <rd:UseGenericDesigner>true</rd:UseGenericDesigner>
      </Query>
      <Fields>
        <Field Name="No_">
          <DataField>No_</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Assigned_User_ID">
          <DataField>Assigned User ID</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Source_No_">
          <DataField>Source No_</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Description">
          <DataField>Description</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Status">
          <DataField>Status</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Due_Date">
          <DataField>Due Date</DataField>
          <rd:TypeName>System.DateTime</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
