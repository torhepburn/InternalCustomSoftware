<?xml version="1.0" encoding="utf-8"?>
<Report MustUnderstand="df" xmlns="http://schemas.microsoft.com/sqlserver/reporting/2016/01/reportdefinition" xmlns:rd="http://schemas.microsoft.com/SQLServer/reporting/reportdesigner" xmlns:df="http://schemas.microsoft.com/sqlserver/reporting/2016/01/reportdefinition/defaultfontfamily">
  <df:DefaultFontFamily>Segoe UI</df:DefaultFontFamily>
  <AutoRefresh>0</AutoRefresh>
  <DataSources>
    <DataSource Name="NAV">
      <ConnectionProperties>
        <DataProvider>SQL</DataProvider>
        <ConnectString>Data Source=pa-hor-as408;Initial Catalog=ZYGO-NAV-PROD</ConnectString>
      </ConnectionProperties>
      <rd:SecurityType>DataBase</rd:SecurityType>
      <rd:DataSourceID>63031ee6-2458-4060-900d-e4bb2c1d2f63</rd:DataSourceID>
    </DataSource>
  </DataSources>
  <DataSets>
    <DataSet Name="DataSet1">
      <Query>
        <DataSourceName>NAV</DataSourceName>
        <QueryParameters>
          <QueryParameter Name="@StartDate">
            <Value>=Parameters!StartDate.Value</Value>
          </QueryParameter>
          <QueryParameter Name="@EndDate">
            <Value>=Parameters!EndDate.Value</Value>
          </QueryParameter>
          <QueryParameter Name="@ExternalDocNumber">
            <Value>=Parameters!ExternalDocNumber.Value</Value>
          </QueryParameter>
        </QueryParameters>
        <CommandText>select 

ent.[G_L Account No_], 
acc.Name, 
[Posting Date], 
[Document No_],
Description, 
Amount, 
ent.[Global Dimension 1 Code] as CostCenter, 
ent.[Global Dimension 2 Code] as BusinessSegment, 
[User ID], 
[Journal Batch Name], 
[External Document No_]

from [ZYGO$G_L Entry] ent

left join [ZYGO$G_L Account] acc on ent.[G_L Account No_] = acc.No_

WHERE

(([Posting Date] &gt;= @StartDate AND [Posting Date] &lt;= @EndDate) OR (@StartDate is null) OR (@EndDate is null))

AND (([External Document No_] LIKE '%' + @ExternalDocNumber +  '%') OR @ExternalDocNumber is null )</CommandText>
        <rd:UseGenericDesigner>true</rd:UseGenericDesigner>
      </Query>
      <Fields>
        <Field Name="G_L_Account_No_">
          <DataField>G_L Account No_</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Name">
          <DataField>Name</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Posting_Date">
          <DataField>Posting Date</DataField>
          <rd:TypeName>System.DateTime</rd:TypeName>
        </Field>
        <Field Name="Document_No_">
          <DataField>Document No_</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Description">
          <DataField>Description</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Amount">
          <DataField>Amount</DataField>
          <rd:TypeName>System.Decimal</rd:TypeName>
        </Field>
        <Field Name="CostCenter">
          <DataField>CostCenter</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="BusinessSegment">
          <DataField>BusinessSegment</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="User_ID">
          <DataField>User ID</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Journal_Batch_Name">
          <DataField>Journal Batch Name</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="External_Document_No_">
          <DataField>External Document No_</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
      </Fields>
      <CaseSensitivity>False</CaseSensitivity>
    </DataSet>
    <DataSet Name="JournalBatchNames">
      <Query>
        <DataSourceName>NAV</DataSourceName>
        <CommandText>select DISTINCT [Journal Batch Name] from [ZYGO$G_L Entry]</CommandText>
      </Query>
      <Fields>
        <Field Name="Journal_Batch_Name">
          <DataField>Journal Batch Name</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
