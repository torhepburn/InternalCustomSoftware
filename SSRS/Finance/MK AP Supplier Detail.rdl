<?xml version="1.0" encoding="utf-8"?>
<Report MustUnderstand="df" xmlns="http://schemas.microsoft.com/sqlserver/reporting/2016/01/reportdefinition" xmlns:rd="http://schemas.microsoft.com/SQLServer/reporting/reportdesigner" xmlns:df="http://schemas.microsoft.com/sqlserver/reporting/2016/01/reportdefinition/defaultfontfamily">
  <df:DefaultFontFamily>Segoe UI</df:DefaultFontFamily>
  <AutoRefresh>0</AutoRefresh>
  <DataSources>
    <DataSource Name="AFE">
      <DataSourceReference>AFE</DataSourceReference>
      <rd:SecurityType>None</rd:SecurityType>
      <rd:DataSourceID>79e9c4cc-2493-44ff-b06c-8f9c9b9600f8</rd:DataSourceID>
    </DataSource>
  </DataSources>
  <DataSets>
    <DataSet Name="DataSet1">
      <Query>
        <DataSourceName>AFE</DataSourceName>
        <QueryParameters>
          <QueryParameter Name="@supplier">
            <Value>=Parameters!supplier.Value</Value>
            <rd:UserDefined>true</rd:UserDefined>
          </QueryParameter>
          <QueryParameter Name="@periodEnd">
            <Value>=Parameters!periodEnd.Value</Value>
            <rd:UserDefined>true</rd:UserDefined>
          </QueryParameter>
          <QueryParameter Name="@supplierName">
            <Value>=Parameters!supplierName.Value</Value>
            <rd:UserDefined>true</rd:UserDefined>
          </QueryParameter>
          <QueryParameter Name="@periodStart">
            <Value>=Parameters!periodStart.Value</Value>
            <rd:UserDefined>true</rd:UserDefined>
          </QueryParameter>
        </QueryParameters>
        <CommandText>WITH s1 AS
(
SELECT 

p.Period_Number
,p.Journal_Number
,p.Batch
,p.Invoice
--,p.Payment_Document
,p.Payment_Date
,p.AMT [Debit Amount]
,0 [Credit Amount]
,p.SUPPLIER
,s.Name
,'p' s

from  MMX_Payments_On_Purch_Invoices p

INNER JOIN MMX_Suppliers s ON p.Supplier = s.supplier

WHERE 1=1

AND ((p.supplier = @supplier) or @supplier is null)

AND ((s.Name like '%' + @supplierName + '%') or @supplierName is null)

AND  p.Period_Number between @periodStart and @periodEnd

UNION

SELECT

p.Period_Number
,p.Journal_Number
,p.Batch
,p.Invoice
--,p.REference
,p.Invoice_Date
,0 [Debit Amount]
,p.Invoice_Amount [Credit Amount]
,p.supplier
,s.Name
,'i' s

from  MMX_AP_Purchase_Invoices p

INNER JOIN MMX_Suppliers s ON p.Supplier = s.supplier

WHERE 1=1

AND ((p.supplier = @supplier) or @supplier is null)

AND ((s.Name like '%' + @supplierName + '%') or @supplierName is null)

AND p.Period_Number between @periodStart and @periodEnd

union

select 

t.Period_Number
,t.Journal_Number
,t.Batch_Number
,t.Document_Number
--,t.Invoice_Number
,t.Document_Date
,0 [Debit Amount]
,t.Amount [Credit Amount]
,t.Customer_Supplier_Number
,s.Name
,'t'
 from MMX_Posted_Ledger_Transactions t

INNER JOIN MMX_Suppliers s ON t.Customer_Supplier_Number = s.supplier

WHERE ((Customer_Supplier_Number = @supplier) or @supplier is null)

AND ((s.Name like '%' + @supplierName + '%') or @supplierName is null)

AND t.Period_Number between @periodStart and @periodEnd

AND Ledger_Account = 2020500

AND Debit_Credit_Indicator = 2

)

SELECT distinct

Period_Number
,Journal_Number
,batch
,Invoice
,Payment_date Document_Date
,[Debit Amount]
,[Credit Amount]
,Supplier
,Name

FROM s1

ORDER BY Period_Number</CommandText>
        <rd:UseGenericDesigner>true</rd:UseGenericDesigner>
      </Query>
      <Fields>
        <Field Name="Period_Number">
          <DataField>Period_Number</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
        <Field Name="Journal_Number">
          <DataField>Journal_Number</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
        <Field Name="batch">
          <DataField>batch</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
        <Field Name="Invoice">
          <DataField>Invoice</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
        <Field Name="Document_Date">
          <DataField>Document_Date</DataField>
          <rd:TypeName>System.DateTime</rd:TypeName>
        </Field>
        <Field Name="Debit_Amount">
          <DataField>Debit Amount</DataField>
          <rd:TypeName>System.Decimal</rd:TypeName>
        </Field>
        <Field Name="Credit_Amount">
          <DataField>Credit Amount</DataField>
          <rd:TypeName>System.Decimal</rd:TypeName>
        </Field>
        <Field Name="Supplier">
          <DataField>Supplier</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Name">
          <DataField>Name</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
  </DataSets>
