<?xml version="1.0" encoding="utf-8"?>
<Report MustUnderstand="df" xmlns="http://schemas.microsoft.com/sqlserver/reporting/2016/01/reportdefinition" xmlns:rd="http://schemas.microsoft.com/SQLServer/reporting/reportdesigner" xmlns:df="http://schemas.microsoft.com/sqlserver/reporting/2016/01/reportdefinition/defaultfontfamily">
  <df:DefaultFontFamily>Segoe UI</df:DefaultFontFamily>
  <AutoRefresh>0</AutoRefresh>
  <DataSources>
    <DataSource Name="AFE">
      <DataSourceReference>AFE</DataSourceReference>
      <rd:SecurityType>None</rd:SecurityType>
      <rd:DataSourceID>79e9c4cc-2493-44ff-b06c-8f9c9b9600f8</rd:DataSourceID>
    </DataSource>
  </DataSources>
  <DataSets>
    <DataSet Name="DataSet1">
      <Query>
        <DataSourceName>AFE</DataSourceName>
        <QueryParameters>
          <QueryParameter Name="@supplier">
            <Value>=Parameters!supplier.Value</Value>
            <rd:UserDefined>true</rd:UserDefined>
          </QueryParameter>
        </QueryParameters>
        <CommandText>WITH s1 AS
(
select

p.Period_Number
,p.Journal_Number
,p.Batch
,p.Invoice
,p.Payment_Document
,p.Posting_Date
,p.AMT [Debit Amount]
,0 [Credit Amount]
,s.SUPPLIER
,s.NAME

from  MMX_AP_Purchase_Invoices i

LEFT JOIN MMX_Payments_On_Purch_Invoices p

ON i.supplier = p.supplier and i.invoice = p.invoice

LEFT JOIN MMX_SUPPLIERS s ON i.Supplier = s.SUPPLIER

WHERE p.Supplier = @supplier

--AND p.Payment_Document = 1

UNION ALL

select

p.Period_Number
,p.Journal_Number
,p.Batch_number
,p.Invoice_Number
,p.Document_Type
,p.Document_Date
,0 [Debit Amount]
,p.[Amount] [Credit Amount]
,s.SUPPLIER
,s.NAME

from  MMX_Posted_Ledger_transactions p

LEFT JOIN MMX_SUPPLIERS s ON p.Customer_Supplier_Number = s.SUPPLIER

WHERE p.Customer_Supplier_Number = @supplier

AND Debit_Credit_Indicator = 2
)

select distinct * from s1


ORDER BY PERIOD_Number</CommandText>
        <rd:UseGenericDesigner>true</rd:UseGenericDesigner>
      </Query>
      <Fields>
        <Field Name="Period_Number">
          <DataField>Period_Number</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
        <Field Name="Journal_Number">
          <DataField>Journal_Number</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
        <Field Name="Batch">
          <DataField>Batch</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
        <Field Name="Invoice">
          <DataField>Invoice</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
        <Field Name="Payment_Document">
          <DataField>Payment_Document</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
        <Field Name="Posting_Date">
          <DataField>Posting_Date</DataField>
          <rd:TypeName>System.DateTime</rd:TypeName>
        </Field>
        <Field Name="Debit_Amount">
          <DataField>Debit Amount</DataField>
          <rd:TypeName>System.Decimal</rd:TypeName>
        </Field>
        <Field Name="Credit_Amount">
          <DataField>Credit Amount</DataField>
          <rd:TypeName>System.Decimal</rd:TypeName>
        </Field>
        <Field Name="SUPPLIER">
          <DataField>SUPPLIER</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="NAME">
          <DataField>NAME</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
    <DataSet Name="Suppliers">
      <Query>
        <DataSourceName>AFE</DataSourceName>
        <CommandText>select 

DISTINCT Supplier 

from MMX_Purchase_order_Lines

order by supplier</CommandText>
      </Query>
      <Fields>
        <Field Name="Supplier">
          <DataField>Supplier</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
    <DataSet Name="Period_Numbers">
      <SharedDataSet>
        <SharedDataSetReference>PeriodNumbers</SharedDataSetReference>
      </SharedDataSet>
      <Fields>
        <Field Name="PERIOD_NUMBER">
          <DataField>PERIOD_NUMBER</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
