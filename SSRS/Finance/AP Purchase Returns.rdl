<?xml version="1.0" encoding="utf-8"?>
<Report MustUnderstand="df" xmlns="http://schemas.microsoft.com/sqlserver/reporting/2016/01/reportdefinition" xmlns:rd="http://schemas.microsoft.com/SQLServer/reporting/reportdesigner" xmlns:df="http://schemas.microsoft.com/sqlserver/reporting/2016/01/reportdefinition/defaultfontfamily">
  <df:DefaultFontFamily>Segoe UI</df:DefaultFontFamily>
  <AutoRefresh>0</AutoRefresh>
  <DataSources>
    <DataSource Name="DataSource1">
      <ConnectionProperties>
        <DataProvider>SQL</DataProvider>
        <ConnectString>Data Source=pa-hor-as408;Initial Catalog=ZYGO-NAV-PROD</ConnectString>
      </ConnectionProperties>
      <rd:SecurityType>DataBase</rd:SecurityType>
      <rd:DataSourceID>f64a7fd3-877d-4c5d-a526-fc8d27865c01</rd:DataSourceID>
    </DataSource>
  </DataSources>
  <DataSets>
    <DataSet Name="DataSet1">
      <Query>
        <DataSourceName>DataSource1</DataSourceName>
        <CommandText>select DISTINCT

rsl.[Buy-from Vendor No_] [Vendor No.]
,v.Name [Vendor Name]
,[RMA No_]
,pl.[Order Date]
,rsl.[Return Order No_]
--,rsl.[Return Order Line No_]
,rsl.[Document No_] [Return Shipment Number]

from [ZYGO$Return Shipment Line] rsl

INNER JOIN ZYGO$Vendor v on rsl.[Buy-from Vendor No_] = v.No_

LEFT JOIN [ZYGO$Purchase Line] pl ON pl.[Document No_] = rsl.[Return Order No_]

WHERE 1=1

AND rsl.[Return Qty_ Shipped Not Invd_] &gt;=1

AND rsl.[Quantity Invoiced] = 0

ORDER BY [Return Shipment Number]</CommandText>
        <rd:UseGenericDesigner>true</rd:UseGenericDesigner>
      </Query>
      <Fields>
        <Field Name="Vendor_No_">
          <DataField>Vendor No.</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Vendor_Name">
          <DataField>Vendor Name</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="RMA_No_">
          <DataField>RMA No_</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Order_Date">
          <DataField>Order Date</DataField>
          <rd:TypeName>System.DateTime</rd:TypeName>
        </Field>
        <Field Name="Return_Order_No_">
          <DataField>Return Order No_</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Return_Shipment_Number">
          <DataField>Return Shipment Number</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
  </DataSets>
