<?xml version="1.0" encoding="utf-8"?>
<Report MustUnderstand="df" xmlns="http://schemas.microsoft.com/sqlserver/reporting/2016/01/reportdefinition" xmlns:rd="http://schemas.microsoft.com/SQLServer/reporting/reportdesigner" xmlns:df="http://schemas.microsoft.com/sqlserver/reporting/2016/01/reportdefinition/defaultfontfamily">
  <df:DefaultFontFamily>Segoe UI</df:DefaultFontFamily>
  <AutoRefresh>0</AutoRefresh>
  <DataSources>
    <DataSource Name="DataSource1">
      <ConnectionProperties>
        <DataProvider>SQL</DataProvider>
        <ConnectString>Data Source=PA-HOR-AS408;Initial Catalog=ZYGO-NAV-PROD</ConnectString>
      </ConnectionProperties>
      <rd:SecurityType>DataBase</rd:SecurityType>
      <rd:DataSourceID>cac821ff-9038-4f40-b095-8c8277ead561</rd:DataSourceID>
    </DataSource>
  </DataSources>
  <DataSets>
    <DataSet Name="DataSet1">
      <Query>
        <DataSourceName>DataSource1</DataSourceName>
        <QueryParameters>
          <QueryParameter Name="@StartDate">
            <Value>=Parameters!StartDate.Value</Value>
          </QueryParameter>
          <QueryParameter Name="@EndDate">
            <Value>=Parameters!EndDate.Value</Value>
          </QueryParameter>
        </QueryParameters>
        <CommandText>SELECT

gle.[Posting Date]
,CASE [Document Type]
	WHEN 0 THEN ''
	WHEN 1 THEN ''
	WHEN 2 THEN 'Invoice'
	WHEN 3 THEN 'Credit Memo'
	ELSE ''
END [Document Type]
,[Document No_] [Document No.]
,CASE 
	WHEN COALESCE(sih.[Order No_],'') != '' THEN sih.[Order No_]
	WHEN COALESCE(vih.[Order No_], '') != '' THEN vih.[Order No_]
	WHEN COALESCE(sch.[Posting Description],'') != '' THEN sch.[Posting Description]
	WHEN COALESCE(vch.[Posting Description], '') != '' THEN vch.[Posting Description]
	ELSE ''
END [Order No.]
,CASE 
	WHEN COALESCE(sih.[Sell-to Customer No_],'') != '' THEN sih.[Sell-to Customer No_]
	WHEN COALESCE(vih.[Bill-to Customer No_], '') != '' THEN vih.[Bill-to Customer No_]
	WHEN COALESCE(sch.[Sell-to Customer No_],'') != '' THEN sch.[Sell-to Customer No_]
	WHEN COALESCE(vch.[Bill-to Customer No_], '') != '' THEN vch.[Bill-to Customer No_]
	ELSE ''
END [Customer No.]
,CASE 
	WHEN COALESCE(sih.[Sell-to Customer Name],'') != '' THEN sih.[Sell-to Customer Name]
	WHEN COALESCE(vih.[Bill-to Name], '') != '' THEN vih.[Bill-to Name]
	WHEN COALESCE(sch.[Sell-to Customer Name],'') != '' THEN sch.[Sell-to Customer Name]
	WHEN COALESCE(vch.[Bill-to Name], '') != '' THEN vch.[Bill-to Name]
	ELSE ''
END [Customer Name]

,[G_L Account No_]
,gle.Amount
,COALESCE(dseg.[Dimension Value Code],'') Segment
,COALESCE(dicp.[Dimension Value Code],'') ICP
,CASE
	WHEN COALESCE(sih.[External Document No_],'') != '' THEN sih.[External Document No_]
	WHEN COALESCE(vih.[Your Reference], '') != '' THEN vih.[Your Reference]
	WHEN COALESCE(sch.[External Document No_],'') != '' THEN sch.[External Document No_]
	WHEN COALESCE(vch.[Pre-Assigned No_], '') != '' THEN vch.[Pre-Assigned No_]
	ELSE ''
END [External Doc No.]
,CASE 
	WHEN COALESCE(sih.[Ship-to Country_Region Code],'') != '' THEN sih.[Ship-to Country_Region Code]
	WHEN COALESCE(vih.[Ship-to Country_Region Code],'') != '' THEN vih.[Ship-to Country_Region Code]
	WHEN COALESCE(sch.[Ship-to Country_Region Code],'') != '' THEN sch.[Ship-to Country_Region Code]
	WHEN COALESCE(vch.[Ship-to Country_Region Code],'') != '' THEN vch.[Ship-to Country_Region Code]
	ELSE ''
END Country


FROM [ZYGO$G_L Entry] gle

LEFT JOIN [ZYGO$Sales Invoice Header] sih ON sih.No_ = gle.[Document No_]

LEFT JOIN [ZYGO$Sales Cr_Memo Header] sch ON sch.No_ = gle.[Document No_]

LEFT JOIN [ZYGO$Service Invoice Header] vih ON vih.No_ = gle.[Document No_]

LEFT JOIN [ZYGO$Service Cr_Memo Header] vch ON vch.No_ = gle.[Document No_]

left join	[ZYGO$Dimension Set Entry] dseg on gle.[Dimension Set ID] = dseg.[Dimension Set ID] and dseg.[Dimension Code] = 'SEGMENT'

left join	[ZYGO$Dimension Set Entry] dicp on gle.[Dimension Set ID] = dicp.[Dimension Set ID] and dicp.[Dimension Code] = 'ICP'


WHERE

[G_L Account No_] IN
(
'41010.001'
,'41010.002'
,'41010.003'
,'41010.004'
,'41045'
,'41016'
,'41020.001'
,'41020.002'
,'41020.003'
,'41020.004'
)

AND gle.[Posting Date] &gt;= @StartDate

AND gle.[Posting Date] &lt;= @EndDate

ORDER BY gle.[Posting Date], [Document No_]</CommandText>
        <rd:UseGenericDesigner>true</rd:UseGenericDesigner>
      </Query>
      <Fields>
        <Field Name="Posting_Date">
          <DataField>Posting Date</DataField>
          <rd:TypeName>System.DateTime</rd:TypeName>
        </Field>
        <Field Name="Document_Type">
          <DataField>Document Type</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Document_No_">
          <DataField>Document No.</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Order_No_">
          <DataField>Order No.</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Customer_No_">
          <DataField>Customer No.</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Customer_Name">
          <DataField>Customer Name</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="G_L_Account_No_">
          <DataField>G_L Account No_</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Amount">
          <DataField>Amount</DataField>
          <rd:TypeName>System.Decimal</rd:TypeName>
        </Field>
        <Field Name="Segment">
          <DataField>Segment</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="ICP">
          <DataField>ICP</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="External_Doc_No_">
          <DataField>External Doc No.</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Country">
          <DataField>Country</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
  </DataSets>
