<?xml version="1.0" encoding="utf-8"?>
<Report MustUnderstand="df" xmlns="http://schemas.microsoft.com/sqlserver/reporting/2016/01/reportdefinition" xmlns:rd="http://schemas.microsoft.com/SQLServer/reporting/reportdesigner" xmlns:df="http://schemas.microsoft.com/sqlserver/reporting/2016/01/reportdefinition/defaultfontfamily">
  <df:DefaultFontFamily>Segoe UI</df:DefaultFontFamily>
  <AutoRefresh>0</AutoRefresh>
  <DataSources>
    <DataSource Name="NAV">
      <DataSourceReference>NAV</DataSourceReference>
      <rd:SecurityType>None</rd:SecurityType>
      <rd:DataSourceID>409c25c3-c076-4d99-8f5e-80bb15b11c2e</rd:DataSourceID>
    </DataSource>
  </DataSources>
  <DataSets>
    <DataSet Name="DataSet1">
      <Query>
        <DataSourceName>NAV</DataSourceName>
        <CommandText>select 

 sil.No_
 ,i.Description
,SUM(sil.Amount) Revenue
--,sil.Quantity
--,sl.[Document No_]
--,sil.[SO Line No_]
--,sh.[Order Date]
,CAST(YEAR(sil.[Posting Date]) as nchar(4)) +
CASE MONTH(sil.[Posting Date]) 
	WHEN 1 THEN '01'
	WHEN 2 THEN '02'
	WHEN 3 THEN '03'
	WHEN 4 THEN '04'
	WHEN 5 THEN '05'
	WHEN 6 THEN '06'
	WHEN 7 THEN '07'
	WHEN 8 THEN '08'
	WHEN 9 THEN '09'
	WHEN 10 THEN '10'
	WHEN 11 THEN '11'
	WHEN 12 THEN '12'
	ELSE ''
END [Shipment Date]
--,sl.[Orig_ Promised Delivery Date]

,CASE sil.[Shortcut Dimension 2 Code]
	WHEN 'LASER INTERF PROD' THEN 'LAS'
	WHEN 'LASER INTERF SVCS' THEN 'LAS'
	WHEN 'LASER INTERFEROMETER' THEN 'LAS'
	WHEN 'OPT PROFILER PROD' THEN 'OPT'
	WHEN 'OPT PROFILER SVCS' THEN 'OPT'
	WHEN 'OPT PROFILER' THEN 'OPT'
	ELSE ''
END [Product Segment]
,dreg.[Dimension Value Code]
,dv.Name


from [ZYGO$Sales Invoice Line] sil

INNER JOIN [ZYGO$Sales Invoice Header] sih ON sil.[Document No_] = sih.No_

LEFT JOIN [ZYGO$Sales Line] sl ON sih.[Order No_] = sl.[Document No_] AND sil.[SO Line No_] = sl.[SO Line No_]

INNER JOIN ZYGO$Item i ON sil.No_ = i.No_

LEFT JOIN [ZYGO$Dimension Set Entry] dreg on sil.[Dimension Set ID] = dreg.[Dimension Set ID] and dreg.[Dimension Code] = 'REGION'

LEFT JOIN [ZYGO$Dimension Value] dv ON dreg.[Dimension Value Code] = dv.Code

--INNER JOIN [ZYGO$Sales Header] sh ON sh.No_ = sl.[Document No_]

WHERE sil.[Posting Date] BETWEEN '2023-01-01' AND '2024-08-13'

AND sil.Quantity &lt;&gt; 0
--AND [Shipment Date] &lt;&gt; [Posting Date]

AND sil.No_ IN

(
 '6024-0161-01'
,'6024-0283-01'
,'6024-0302-01'
,'6024-0304-01'
,'6024-0309-11'
,'6024-0311-11'
,'6024-0312-01'
,'6024-0314-11'
,'6024-0317-11'
,'6024-0322-01'
,'6024-0323-01'
,'6024-0356-01'
,'6024-0371-02'
,'6024-0385-11'
,'6024-0399-11'
,'6024-0399-13'
,'6024-0399-14'
,'6024-0419-11'
,'6024-0420-01'
,'6024-0429-01'
,'6024-0430-11'
,'6024-0430-13'
,'6024-0456-11'
,'6068-0444-01'
,'6300-0194-02'
,'6300-0307-01'
