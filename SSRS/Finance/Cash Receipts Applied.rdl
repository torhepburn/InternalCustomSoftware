<?xml version="1.0" encoding="utf-8"?>
<Report MustUnderstand="df" xmlns="http://schemas.microsoft.com/sqlserver/reporting/2016/01/reportdefinition" xmlns:rd="http://schemas.microsoft.com/SQLServer/reporting/reportdesigner" xmlns:df="http://schemas.microsoft.com/sqlserver/reporting/2016/01/reportdefinition/defaultfontfamily">
  <df:DefaultFontFamily>Segoe UI</df:DefaultFontFamily>
  <AutoRefresh>0</AutoRefresh>
  <DataSources>
    <DataSource Name="NAV">
      <DataSourceReference>NAV</DataSourceReference>
      <rd:SecurityType>None</rd:SecurityType>
      <rd:DataSourceID>81e1ab57-579c-48d3-93ac-afee4fca9dd7</rd:DataSourceID>
    </DataSource>
  </DataSources>
  <DataSets>
    <DataSet Name="DataSet1">
      <Query>
        <DataSourceName>NAV</DataSourceName>
        <CommandText>SELECT 


c.[Entry No_]
,c.[Customer No_]
,u.Name [Customer]
,c.Description
,c.[Document No_]

,CASE c.[Document Type]
	WHEN 2 THEN 'Sales Invoice'
	ELSE 'Look Up'
END [Document Type]
,g.[Document No_] [Payment Number]
,g.[Posting Date] [Payment Posting Date]
,c.[Due Date] [Invoice Due Date]
,c.[Pmt_ Discount Date]
,g.[Credit Amount] [Payment Amount]
,c.[Pmt_ Disc_ Given (LCY)]
,c.[Closed by Amount]
,c.[Closed at Date]


FROM [ZYGO$Cust_ Ledger Entry] c

INNER JOIN [ZYGO$Customer ] u on c.[Customer No_] = u.No_

INNER JOIN [ZYGO$G_L Entry] g ON c.[Closed by Entry No_] = g.[Entry No_]


WHERE c.[Closed at Date] BETWEEN '07-01-2023' and '09-30-2023'

AND [Customer No_] = 'AM1147'


ORDER BY [Due Date]</CommandText>
        <rd:UseGenericDesigner>true</rd:UseGenericDesigner>
      </Query>
      <Fields>
        <Field Name="Entry_No_">
          <DataField>Entry No_</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
        <Field Name="Customer_No_">
