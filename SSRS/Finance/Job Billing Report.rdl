<?xml version="1.0" encoding="utf-8"?>
<Report MustUnderstand="df" xmlns="http://schemas.microsoft.com/sqlserver/reporting/2016/01/reportdefinition" xmlns:rd="http://schemas.microsoft.com/SQLServer/reporting/reportdesigner" xmlns:df="http://schemas.microsoft.com/sqlserver/reporting/2016/01/reportdefinition/defaultfontfamily">
  <df:DefaultFontFamily>Segoe UI</df:DefaultFontFamily>
  <AutoRefresh>0</AutoRefresh>
  <DataSources>
    <DataSource Name="NAV">
      <DataSourceReference>NAV</DataSourceReference>
      <rd:SecurityType>None</rd:SecurityType>
      <rd:DataSourceID>e5672115-e81e-4ff9-bb03-ebe5cc41bdf7</rd:DataSourceID>
    </DataSource>
  </DataSources>
  <DataSets>
    <DataSet Name="DataSet1">
      <Query>
        <DataSourceName>NAV</DataSourceName>
        <QueryParameters>
          <QueryParameter Name="@StartDate">
            <Value>=Parameters!StartingDate.Value</Value>
            <rd:UserDefined>true</rd:UserDefined>
          </QueryParameter>
          <QueryParameter Name="@EndDate">
            <Value>=Parameters!EndingDate.Value</Value>
            <rd:UserDefined>true</rd:UserDefined>
          </QueryParameter>
        </QueryParameters>
        <CommandText>SELECT

[Shortcut Dimension 2 Code] 'Bus Segment Job'
,[Posting Group]
,[Posting Date]
,[Gen_ Prod_ Posting Group] 
,[Shortcut Dimension 2 Code] [Business Segment]
,dreg.[Dimension Value Code] Region
,[Job No_] Job
,s.No_ Part
,[Inv_ Discount Amount]
,s.Description
,s.[Sell-to Customer No_] Customer
,c.Name [Customer Name]
,[Document No_]
,Quantity
,[Unit Price]
,Quantity *[Unit Price] 'Ext Gross'
--,s.Amount
,[Line Discount Amount]
,[Line Amount] 'Net Amount'
,j.[Sales Order No_] 'Order'
,s.[Location Code] 'Location'
,s.[Bin Code] Bin
,dind.[Dimension Value Code] Industry
,s.WBS



FROM [ZYGO$Sales Invoice Line] s

LEFT JOIN ZYGO$Job j ON s.[Job No_] = j.No_
LEFT JOIN ZYGO$Customer c ON s.[Sell-to Customer No_] = c.No_
left join	[ZYGO$Dimension Set Entry] dind on s.[Dimension Set ID] = dind.[Dimension Set ID] and dind.[Dimension Code] = 'INDUSTRY'
left join	[ZYGO$Dimension Set Entry] dreg on s.[Dimension Set ID] = dreg.[Dimension Set ID] and dreg.[Dimension Code] = 'REGION'

WHERE

[Posting Date] between @StartDate and @EndDate

--AND [Gen_ Prod_ Posting Group] =  

AND Quantity &lt;&gt; 0

AND [Job No_] &gt; '0'

--AND [Product Group Code] =

--AND [Sell-to Customer No_] =</CommandText>
        <rd:UseGenericDesigner>true</rd:UseGenericDesigner>
      </Query>
