<?xml version="1.0" encoding="utf-8"?>
<Report xmlns="http://schemas.microsoft.com/sqlserver/reporting/2016/01/reportdefinition" xmlns:rd="http://schemas.microsoft.com/SQLServer/reporting/reportdesigner" xmlns:df="http://schemas.microsoft.com/sqlserver/reporting/2016/01/reportdefinition/defaultfontfamily" MustUnderstand="df">
  <df:DefaultFontFamily>Segoe UI</df:DefaultFontFamily>
  <AutoRefresh>0</AutoRefresh>
  <DataSources>
    <DataSource Name="NAV">
      <DataSourceReference>NAV</DataSourceReference>
      <rd:SecurityType>None</rd:SecurityType>
      <rd:DataSourceID>671d63a4-58cf-4245-8e3f-5492ff44d9bb</rd:DataSourceID>
    </DataSource>
  </DataSources>
  <DataSets>
    <DataSet Name="DataSet1">
      <Query>
        <DataSourceName>NAV</DataSourceName>
        <CommandText>WITH s1 as
(	--On Hand
	SELECT 
	[Item No_]
	,SUM(Quantity) OnHand
	FROM [ZYGO$Item Ledger Entry]
	--WHERE [Non-Nettable] = 0
	GROUP BY [Item No_]

)


SELECT 

No_
,[Phys Invt Counting Period Code]
,COALESCE(OnHand,0) OnHand
,Description
,CASE [Replenishment System]
	WHEN 0 THEN 'Buy'
	WHEN 1 THEN 'Make'
END 'Make/Buy'
,[Standard Cost]
,P6
,F6
,EAU

,[Description 5]
,CASE Vetted
	WHEN 0 THEN 'Vetted'
	WHEN 1 THEN 'Non-vetted'
END Vetted
,[Base Unit of Measure]

,[Inventory Posting Group]
,[Gen_ Prod_ Posting Group]
,[Item Category Code]
,[Global Dimension 1 Code] [CostCenter]
,[Global Dimension 2 Code] Segment
,[Signal Code]




FROM ZYGO$Item i

LEFT JOIN s1 on i.No_ = s1.[Item No_]</CommandText>
        <rd:UseGenericDesigner>true</rd:UseGenericDesigner>
      </Query>
      <Fields>
        <Field Name="No_">
          <DataField>No_</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Phys_Invt_Counting_Period_Code">
          <DataField>Phys Invt Counting Period Code</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
