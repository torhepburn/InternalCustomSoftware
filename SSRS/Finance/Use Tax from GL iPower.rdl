<?xml version="1.0" encoding="utf-8"?>
<Report MustUnderstand="df" xmlns="http://schemas.microsoft.com/sqlserver/reporting/2016/01/reportdefinition" xmlns:rd="http://schemas.microsoft.com/SQLServer/reporting/reportdesigner" xmlns:df="http://schemas.microsoft.com/sqlserver/reporting/2016/01/reportdefinition/defaultfontfamily">
  <df:DefaultFontFamily>Segoe UI</df:DefaultFontFamily>
  <AutoRefresh>0</AutoRefresh>
  <DataSources>
    <DataSource Name="DataSource1">
      <ConnectionProperties>
        <DataProvider>SQL</DataProvider>
        <ConnectString>Data Source=pa-hor-as408.ametek.com</ConnectString>
      </ConnectionProperties>
      <rd:SecurityType>DataBase</rd:SecurityType>
      <rd:DataSourceID>f26a86ff-9a8a-4985-88f1-5ff9fe20fb13</rd:DataSourceID>
    </DataSource>
  </DataSources>
  <DataSets>
    <DataSet Name="DataSet1">
      <Query>
        <DataSourceName>DataSource1</DataSourceName>
        <QueryParameters>
          <QueryParameter Name="@StartingDate">
            <Value>=Parameters!StartingDate.Value</Value>
          </QueryParameter>
          <QueryParameter Name="@EndingDate">
            <Value>=Parameters!EndingDate.Value</Value>
          </QueryParameter>
        </QueryParameters>
        <CommandText>/* Use Tax iPower from GL 

GLE Document Type 2 = invoice	*/
	select

	 gle.[Posting Date]
	 ,gle.[Entry No_]
	,pih.[Pay-to Vendor No_]
	,pih.[Buy-from Vendor Name]
	,pih.[Buy-from City]
	,COALESCE(ph.[Ship-to City],'') [PO Ship-to City]
	,pih.[Buy-from County]
	,pih.[Buy-from Post Code] 
	,gle.[Document No_]
	,gle.[External Document No_]
	,gle.Amount GLAmount
	,gle.[G_L Account No_]
	,gle.[Global Dimension 1 Code] [Cost Center]
	,COALESCE(ph.[No_],'') [PO Document No_]
	,COALESCE(gle.[Job No_],'') [Job No_]
	

	from [ZYGO$G_L Entry] gle

	INNER JOIN [ZYGO$Purch_ Inv_ Header] pih ON gle.[Document No_] = pih.[No_]
		
	LEFT JOIN [ZYGO$Purchase Header] ph on pih.[Order No_] = ph.[No_]

	where [G_L Account No_] IN (
	
	 '62011'
	,'62012'
	,'62013'
	,'62014'
	,'62015')

	AND gle.[Posting Date] &gt;= @StartingDate	

                    AND gle.[Posting Date] &lt;= @EndingDate

	AND gle.[Document Type] = 2

	AND pih.[Pay-to Vendor No_] = '4822'

ORDER BY [Posting Date],[G_L Account No_], pih.[No_]</CommandText>
        <rd:UseGenericDesigner>true</rd:UseGenericDesigner>
      </Query>
      <Fields>
        <Field Name="Posting_Date">
          <DataField>Posting Date</DataField>
          <rd:TypeName>System.DateTime</rd:TypeName>
        </Field>
        <Field Name="Entry_No_">
          <DataField>Entry No_</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
        <Field Name="Pay_to_Vendor_No_">
          <DataField>Pay-to Vendor No_</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Buy_from_Vendor_Name">
          <DataField>Buy-from Vendor Name</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Buy_from_City">
          <DataField>Buy-from City</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="PO_Ship_to_City">
          <DataField>PO Ship-to City</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Buy_from_County">
          <DataField>Buy-from County</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Buy_from_Post_Code">
          <DataField>Buy-from Post Code</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Document_No_">
          <DataField>Document No_</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="External_Document_No_">
          <DataField>External Document No_</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="GLAmount">
          <DataField>GLAmount</DataField>
          <rd:TypeName>System.Decimal</rd:TypeName>
        </Field>
        <Field Name="G_L_Account_No_">
          <DataField>G_L Account No_</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Cost_Center">
          <DataField>Cost Center</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="PO_Document_No_">
          <DataField>PO Document No_</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Job_No_">
          <DataField>Job No_</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
