<?xml version="1.0" encoding="utf-8"?>
<Report MustUnderstand="df" xmlns="http://schemas.microsoft.com/sqlserver/reporting/2016/01/reportdefinition" xmlns:rd="http://schemas.microsoft.com/SQLServer/reporting/reportdesigner" xmlns:df="http://schemas.microsoft.com/sqlserver/reporting/2016/01/reportdefinition/defaultfontfamily">
  <df:DefaultFontFamily>Segoe UI</df:DefaultFontFamily>
  <AutoRefresh>0</AutoRefresh>
  <DataSources>
    <DataSource Name="AFE">
      <DataSourceReference>AFE</DataSourceReference>
      <rd:SecurityType>None</rd:SecurityType>
      <rd:DataSourceID>9ab202ea-f1b6-4623-b02a-50414e77bf37</rd:DataSourceID>
    </DataSource>
  </DataSources>
  <DataSets>
    <DataSet Name="DataSet1">
      <Query>
        <DataSourceName>AFE</DataSourceName>
        <QueryParameters>
          <QueryParameter Name="@supplier">
            <Value>=Parameters!supplier.Value</Value>
            <rd:UserDefined>true</rd:UserDefined>
          </QueryParameter>
          <QueryParameter Name="@name">
            <Value>=Parameters!supplierName.Value</Value>
            <rd:UserDefined>true</rd:UserDefined>
          </QueryParameter>
        </QueryParameters>
        <CommandText>select

i.Supplier
,i.Invoice
,Supplier_Invoice [Reference/Document]
,Invoice_Date
,Due_Date
,i.Invoice_Amount
,i.Invoice_Currency
,p.Payment_Date
,p.AMT [Amount]
,p.payment_currency
,s.NAME
,s.NAME_2
,s.ADDRESS
,s.CITY
,s.STATE
,s.ZIPCODE
,s.EMAIL
,s.TERMS_OF_PAYMENT


from  MMX_AP_Purchase_Invoices i

LEFT JOIN MMX_Payments_On_Purch_Invoices p

ON i.supplier = p.supplier and i.invoice = p.invoice

LEFT JOIN MMX_SUPPLIERS s ON i.Supplier = s.SUPPLIER

 where 1=1

AND ((i.supplier like  '%' +@supplier+ '%') or @supplier is null)

AND ((s.Name like '%' +@name + '%') or @name is null)



 ORDER BY i.Invoice_Date</CommandText>
        <rd:UseGenericDesigner>true</rd:UseGenericDesigner>
      </Query>
      <Fields>
        <Field Name="Supplier">
          <DataField>Supplier</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Invoice">
          <DataField>Invoice</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
