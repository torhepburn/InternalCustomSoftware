<?xml version="1.0" encoding="utf-8"?>
<Report MustUnderstand="df" xmlns="http://schemas.microsoft.com/sqlserver/reporting/2016/01/reportdefinition" xmlns:rd="http://schemas.microsoft.com/SQLServer/reporting/reportdesigner" xmlns:df="http://schemas.microsoft.com/sqlserver/reporting/2016/01/reportdefinition/defaultfontfamily">
  <df:DefaultFontFamily>Segoe UI</df:DefaultFontFamily>
  <AutoRefresh>0</AutoRefresh>
  <DataSources>
    <DataSource Name="NAV">
      <DataSourceReference>NAV</DataSourceReference>
      <rd:SecurityType>None</rd:SecurityType>
      <rd:DataSourceID>9f34d93e-d841-4e1d-9f42-ff9a8bb6e7db</rd:DataSourceID>
    </DataSource>
  </DataSources>
  <DataSets>
    <DataSet Name="DataSet1">
      <Query>
        <DataSourceName>NAV</DataSourceName>
        <CommandText>select

CASE p.[Document Type]
	WHEN 5 THEN 'Return Order'
	ELSE ''
END [Document Type]
,[Document No_]
,''[Shipped Date]
,p.[Buy-from Vendor No_]
, [PO Line No_]
, CASE p.[Type]
	WHEN 2 THEN 'Item'
	ELSE ''
END [Type]
,p.No_
,p.Description
,p.[Location Code]
, [Unit of Measure]
,[Direct Unit Cost]
,i.[Standard Cost]
, [Line Amount] [Line Amount Excl. Tax]
,i.[Gen_ Prod_ Posting Group]
, v.Name Vendor
,CASE h.Status
	WHEN 0 THEN 'Open'
	WHEN 1 THEN 'Released'
	ELSE ''
END [Status]
,i.[Buyer Planner Code]




from [ZYGO$Purchase Line] p

LEFT JOIN ZYGO$Item i ON p.No_ = i.No_
LEFT JOIN ZYGO$Vendor v ON p.[Buy-from Vendor No_] = v.No_
INNER JOIN [ZYGO$Purchase Header] h ON h.No_ = p.[Document No_]

WHERE p.[Document Type] = 5 --return PO

AND LEN(p.No_)&gt;0

AND [Outstanding Quantity] &gt; 0</CommandText>
        <rd:UseGenericDesigner>true</rd:UseGenericDesigner>
      </Query>
      <Fields>
