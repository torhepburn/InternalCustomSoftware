<Report MustUnderstand="df" xmlns="http://schemas.microsoft.com/sqlserver/reporting/2016/01/reportdefinition" xmlns:rd="http://schemas.microsoft.com/SQLServer/reporting/reportdesigner" xmlns:df="http://schemas.microsoft.com/sqlserver/reporting/2016/01/reportdefinition/defaultfontfamily">
  <df:DefaultFontFamily>Segoe UI</df:DefaultFontFamily>
  <AutoRefresh>0</AutoRefresh>
  <DataSources>
    <DataSource Name="NAVTEST">
      <DataSourceReference>NAVTEST</DataSourceReference>
      <rd:SecurityType>None</rd:SecurityType>
      <rd:DataSourceID>6d710c46-090d-47e8-a737-c26d90a34bcc</rd:DataSourceID>
    </DataSource>
  </DataSources>
  <DataSets>
    <DataSet Name="DataSet1">
      <Query>
        <DataSourceName>NAVTEST</DataSourceName>
        <CommandText>select 

b.[Journal Batch Name] as [NAV Journal], 
left(j.[Description],3) as [MK Journal], 
j.[Description] as [NAV Journal Description],
count(*) as [No. Transactions]
 
from [ZYGO_TEST3$Gen_ Journal Line] b 

inner join [ZYGO_TEST3$Gen_ Journal Batch] j on b.[Journal Batch Name] = j.[Name]

group by b.[Journal Batch Name], j.[Description]

order by j.[Description]</CommandText>
        <rd:UseGenericDesigner>true</rd:UseGenericDesigner>
      </Query>
      <Fields>
        <Field Name="NAV_Journal">
          <DataField>NAV Journal</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="MK_Journal">
          <DataField>MK Journal</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="NAV_Journal_Description">
          <DataField>NAV Journal Description</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="No__Transactions">
          <DataField>No. Transactions</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
  </DataSets>
