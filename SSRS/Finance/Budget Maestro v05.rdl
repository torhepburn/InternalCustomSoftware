<?xml version="1.0" encoding="utf-8"?>
<Report MustUnderstand="df" xmlns="http://schemas.microsoft.com/sqlserver/reporting/2016/01/reportdefinition" xmlns:rd="http://schemas.microsoft.com/SQLServer/reporting/reportdesigner" xmlns:df="http://schemas.microsoft.com/sqlserver/reporting/2016/01/reportdefinition/defaultfontfamily">
  <df:DefaultFontFamily>Segoe UI</df:DefaultFontFamily>
  <AutoRefresh>0</AutoRefresh>
  <DataSources>
    <DataSource Name="DataSource1">
      <ConnectionProperties>
        <DataProvider>SQL</DataProvider>
        <ConnectString>Data Source=pa-hor-as408;Initial Catalog=ZYGO-NAV-PROD</ConnectString>
      </ConnectionProperties>
      <rd:SecurityType>DataBase</rd:SecurityType>
      <rd:DataSourceID>0a52f89a-db82-415b-881d-c373615ace22</rd:DataSourceID>
    </DataSource>
  </DataSources>
  <DataSets>
    <DataSet Name="DataSet1">
      <Query>
        <DataSourceName>DataSource1</DataSourceName>
        <QueryParameters>
          <QueryParameter Name="@StartingDate">
            <Value>=Parameters!StartingDate.Value</Value>
          </QueryParameter>
          <QueryParameter Name="@EndingDate">
            <Value>=Parameters!EndingDate.Value</Value>
          </QueryParameter>
        </QueryParameters>
        <CommandText>SELECT 

gle.[Posting Date]
,COALESCE(dcat.[Dimension Value Code],'') [Original ProdCat]
,COALESCE(dseg.[Dimension Value Code],'') [Original Segment]
,COALESCE(dcos.[Dimension Value Code],'') [Original CostCenter]
,CASE 
	WHEN LEFT(gle.[G_L Account No_],1) = '6' AND LEN(COALESCE(dcos.[Dimension Value Code],'')) &gt; 0
		THEN gle.[G_L Account No_] + '-' + dcos.[Dimension Value Code]
	ELSE gle.[G_L Account No_]
 END [Account Number]
,'ZYGO - Import - Budget'[GLSource]
,'ZYGO_US' [Company]
, CASE 
		WHEN LEFT(c.Name, 4) = 'ASML' THEN 'ASML'
		WHEN LEFT(c.Name, 3) = 'KLA' THEN 'KLA'
		WHEN LEFT(c.Name, 5) = 'CANON' THEN 'Canon'
		WHEN LEFT(c.Name, 5) = 'NIKON' THEN 'Nikon'
		WHEN LEFT(c.Name, 8) = 'LASERTEC' THEN 'Lasertec'
		ELSE 'Default (Customer)'
	END [Customer]
,'FY' + FORMAT([Posting Date], 'yy') + '-P' + FORMAT([Posting Date],'MM') [Fiscal Period &amp; Elimination Period]

,COALESCE(
	CASE 
		WHEN LEFT(gle.[G_L Account No_], 1) IN ('6', '7') THEN 'Default (Product)'
	ELSE
		CASE 
			WHEN LEFT(gle.[G_L Account No_], 1) != '4' AND (LEFT(gle.[G_L Account No_], 1) = '5'
					AND gle.[G_L Account No_] NOT IN ('50110.001' 
								 ,'50110.002'
								 ,'50110.003'
								 ,'50110.004'
								 ,'50110.998'
								 ,'50110.999'
								 ,'50210.001'
								 ,'50210.002'
								 ,'50210.003'
								 ,'50210.004'
								 ,'50310.001'
								 ,'50310.002'
								 ,'50310.003'
								 ,'50310.004')) 
								 
				THEN
    				CASE 
						WHEN COALESCE(dseg.[Dimension Value Code],'') in ('LASER INTERF PROD','LASER INTERF SVCS', 'FACILITIES','ADMIN') 
							THEN 'OCOS_LI'
						WHEN COALESCE(dseg.[Dimension Value Code],'') in ('PO VALUE STREAM')
							THEN 'OCOS_PO'
						WHEN COALESCE(dseg.[Dimension Value Code],'') in ('OPT PROFILER PROD','OPT PROFILER SVCS') 
							THEN 'OCOS_OP'
						WHEN COALESCE(dseg.[Dimension Value Code],'') in ('LFO VALUE STREAM')
							THEN 'OCOS_LFO'
						WHEN COALESCE(dseg.[Dimension Value Code],'') in ('EUV','CRYSTALLINE OPTICS','GLASS OPTICS','MACHINED STRUCTURES', 'EPO GENERAL') 
							THEN 'OCOS_EPO'
						WHEN COALESCE(dseg.[Dimension Value Code],'') in ('ELECTRO-OPTICS OTHER') 
							THEN 'OCOS_Irvine'
						WHEN COALESCE(dseg.[Dimension Value Code],'') in ('PPS','PPS SYSTEMS','PPS COMPONENTS','PPS SERVICES') 
							THEN 'OCOS_PPS'
						WHEN COALESCE(dseg.[Dimension Value Code],'') in ('PO VALUE STREAM') 
							THEN 'OCOS_PO'
						WHEN COALESCE(dseg.[Dimension Value Code],'') in ('LFO VALUE STREAM') 
							THEN 'OCOS_LFO'
					END 
				ELSE
					CASE(dcat.[Dimension Value Code])
						WHEN 'VERIFIRE_4' THEN '4_Verifire'
						WHEN 'VERIFIRE_HD_4' THEN '4_Verifire_HD'
						WHEN 'VERIFIRE_HDX_4' THEN '4_Verifire_HDX'
						WHEN 'VERIFIRE_6' THEN '6_Verifire'
						WHEN 'VERIFIRE_HD_6' THEN '6_Verifire_HD'
						WHEN 'VERIFIRE_HDX_6' THEN '6_Verifire_HDX'
						WHEN '12_BX' THEN '12_BX'
						WHEN '77X4 LASER SOURCES' THEN 'PPS_Other'
						WHEN 'AFFY_RHM_PROD_CM' THEN 'Affy_RHM_Production_CM'
						WHEN 'AFFY_RHM_SPARES' THEN 'Affy_RHM_Spares'
						WHEN 'ALCON_LENSX_EXISTING' THEN 'Alcon_LenSx_Existing'
						WHEN 'CM_PLANETLABSPS3NRE' THEN 'Planet_Labs_PS3_NRE'
						WHEN 'COMPASS' THEN 'COMPASS'
						WHEN 'CORRECTOR_PLATES' THEN 'Corrector_Plates'
						WHEN 'CRYSTALLINE OPTICS' THEN 'EPO_Other_Optics'
						WHEN 'DYNAFIZ_4' THEN '4_DynaFiZ'
						WHEN 'EPO_CORDIERITEENCDRH' THEN 'EPO_CORDIERITEENCDRH'
						WHEN 'EPO_FIDUCIAL_H' THEN 'EPO_ASML_Fiducial_H'
						WHEN 'EPO_GAMMA_H' THEN 'EPO_ASML_Gamma_H'
						WHEN 'EPO_KLA_TENCOR_H' THEN 'EPO_KLA_Tencor_H'
						WHEN 'EPO_L3_SONOMA' THEN 'EPO_L3_Sonoma'
						WHEN 'EPO_LEVEL_SENSOR_H' THEN 'EPO_ASML_Level_Sensor_H'
						WHEN 'EPO_METROFRAME_H' THEN 'EPO_ASML_Metroframe_H'
						WHEN 'EPO_NXERETICLECHUCKH' THEN 'EPO_ASML_NXE_Reticle_Chuck_H'
						WHEN 'EPO_OTHER_OPTICS' THEN 'EPO_Other_Optics'
						WHEN 'EPO_RETICLE_CHUCK_H' THEN 'EPO_ASML_Reticle_Chuck_H'
						WHEN 'EPO_SIGMA_H' THEN 'EPO_ASML_Sigma_H'
						WHEN 'EPO_WELLE_H' THEN 'EPO_ASML_Welle_H'
						WHEN 'FACT_SPARE_PARTS_PPS' THEN 'PPS_Service_Parts'
						WHEN 'FIBER_OPTIC_PICKUPS' THEN 'PPS_Other'
						WHEN 'GLASS OPTICS' THEN 'EPO_Other_Optics'
						WHEN 'INSTRUMENTS' THEN 'Z_LI_UNASSIGNED'
						WHEN 'KLA_7XX_EUV' THEN 'KLA_7XX_EUV'
						WHEN 'KLA_GANY_CM' THEN 'KLA_GANY_CM'
						WHEN 'L3SSG_WHSTLR_ PRODCM' THEN 'Z_LI_UNASSIGNED'
						WHEN 'LASER INTERF PROD' THEN 'Z_LI_UNASSIGNED'
						WHEN 'LASER INTERFEROMETER' THEN 'Z_LI_UNASSIGNED'
						WHEN 'LFO_MIRRORS_H' THEN 'LFO_Mirrors_H'
						WHEN 'LFO_OTHER' THEN 'LFO_Other'
						WHEN 'LFO_OTHER_H' THEN 'LFO_Other_H'
						WHEN 'LI_ACCESSORIES' THEN 'LAS_Accessories'
						WHEN 'LI_CMS' THEN 'Custom_LAS'
						WHEN 'LI_INSTALLATION' THEN 'Instruments Installation'
						WHEN 'LI_SPARE_PARTS' THEN 'LAS_Service_Parts'
						WHEN 'LI_UPGRADES' THEN 'LAS_Upgrades'
						WHEN 'MACHINED STRUCTURES' THEN 'EPO_Other_Optics'
						WHEN 'NEXVIEW' THEN 'NexView'
						WHEN 'NEXVIEW_2' THEN 'Nexview2'
						WHEN 'NOMAD' THEN 'Nomad'
						WHEN 'NV_9000' THEN 'NV_9000'
						WHEN 'NV9000_TWN_KIT' THEN 'NV9000_TWN_KIT'
						WHEN 'OP_ACCESSORIES' THEN 'OP_Accessories'
						WHEN 'OP_CMS' THEN 'Custom_Profiler'
						WHEN 'OP_OEM' THEN 'OP_OEM_OLED'
						WHEN 'OP_SPARE_PARTS' THEN 'OP_Service_Parts'
						WHEN 'OP_TRAINING' THEN 'Training'
						WHEN 'OP_UPGRADES' THEN 'OP_Upgrades'
						WHEN 'OPT PROFILER PROD' THEN 'Z_OP_UNASSIGNED'
						WHEN 'OPTICAL PROFILER' THEN 'Z_OP_UNASSIGNED'
						WHEN 'OPTICS' THEN 'Other_Optics'
						WHEN 'OPTICS_BM_STRG_ACCY' THEN 'PPS_Other'
						WHEN 'OTHER_MIRRORS' THEN 'Other_Mirrors'
						WHEN 'OTHER_OPTICS' THEN 'Other_Optics'
						WHEN 'OTHER_OPTICS_H' THEN 'Other_Optics_H'
						WHEN 'OTHER_WINDOWS' THEN 'Other_Windows'
						WHEN 'PPS COMPONENTS' THEN 'PPS_Other'
						WHEN 'PPS_X_HEAD' THEN 'PPS_X_Head'
						WHEN 'Z_EO_UNASSIGNED' THEN 'Engineering_Services_Production'
						WHEN 'Z_EPO_UNASSIGNED' THEN 'EPO_Other_Optics'
						WHEN 'Z_LFO_UNASSIGNED' THEN 'LFO_Other'
						WHEN 'Z_LI_UNASSIGNED' THEN 'Z_LI_UNASSIGNED'
						WHEN 'Z_OP_UNASSIGNED' THEN 'Z_OP_UNASSIGNED'
						WHEN 'Z_PO_UNASSIGNED' THEN 'Other_Optics'
						WHEN 'Z_PPS_UNASSIGNED' THEN 'PPS_Other'
						WHEN 'ZEGAGE' THEN 'ZeGage'
						WHEN 'ZEGAGE_PRO' THEN 'ZeGage_PRO'
						WHEN 'ZEGAGE_PRO_HR' THEN 'ZEGAGE_PRO_HR'
						WHEN 'ZMI_4000_ELECTRONICS' THEN 'PPS_Other'
						WHEN 'ZPS_ENCLOSURE' THEN 'PPS_ZPS'
						WHEN 'ZPS_SYSTEMS' THEN 'PPS_ZPS'
						ELSE COALESCE(dcat.[Dimension Value Code],
							CASE 
								WHEN COALESCE(dseg.[Dimension Value Code],'') IN ('EUV', 'GLASS OPTICS', 'CRYSTALLINE OPTICS', 'MACHINED STRUCTURES') 
									THEN 'EPO_Other_Optics'
								WHEN COALESCE(dseg.[Dimension Value Code],'') IN ('LASER INTERF SVCS') 
									THEN 'LAS_Service_Parts'
								WHEN COALESCE(dseg.[Dimension Value Code],'') IN ('OPT PROFILER SVCS') 
									THEN 'OP_Service_Parts'
								WHEN COALESCE(dseg.[Dimension Value Code],'') IN ('ADMIN') 
									THEN 'OCOS_LI'
								WHEN COALESCE(dseg.[Dimension Value Code],'') IN ('LASER INTERF PROD') 
									THEN 'Z_LI_UNASSIGNED'
								WHEN COALESCE(dseg.[Dimension Value Code],'') IN ('OPT PROFILER PROD') 
									THEN 'Z_OP_UNASSIGNED'
								WHEN COALESCE(dseg.[Dimension Value Code],'') IN ('ELECTRO-OPTICS OTHER', 'COMMERCIAL SPACE')
									THEN 'Engineering_Services_Production'
								WHEN COALESCE(dseg.[Dimension Value Code],'') IN ('PPS COMPONENTS') 
									THEN 'PPS_Other'
								WHEN COALESCE(dseg.[Dimension Value Code],'') IN ('PPS SERVICES') 
									THEN 'PPS_Service_Parts'
								WHEN COALESCE(dseg.[Dimension Value Code],'') IN ('LFO VALUE STREAM') 
									THEN 'LFO_Other'
								when COALESCE(dseg.[Dimension Value Code],'') = 'PO VALUE STREAM' 
									THEN 'Other_Optics'
							END)
					END
				END
END
,'') [Product]


,COALESCE(CASE
	WHEN LEFT(gle.[G_L Account No_], 1) IN ('4', '5', '7') THEN 'Default (Cost Center)' 
	ELSE COALESCE(dcos.[Dimension Value Code], 'Default (Cost Center)')						/*else covers 6###  - cost center or default if null */
	END, '') [Cost Center]

,COALESCE(dind.[Dimension Value Code], 'Default (Industry)') Industry
,'Actuals' [Version]
, 'USD' Currency

,COALESCE(
CASE 
	WHEN LEFT(gle.[G_L Account No_], 1) IN ('4', '5', '7') 
		THEN
			COALESCE(dseg.[Dimension Value Code],'Other') 
		ELSE --gl starts with 6
			CASE 
				WHEN COALESCE(dcos.[Dimension Value Code], '') in (
						'1000',
						'1050',
						'1100',
						'1210',
						'1211',
						'1213',
						'5014',
						'5015',
						'5020',
						'5025',
						'5030',
						'5045',
						'6001',
						'6005',
						'6007',
						'6015',
						'6016',
						'6020',
						'6030',
						'7001',
						'7020',
						'7021',
						'7040',
						'7045',
						'7055',
						'7120',
						'7125',
						'7130',
						'7135',
						'7320',
						'7325',
						'7330',
						'7340',
						'7420',
						'7430',
						'7440',
						'7445',
						'7470',
						'8010',
						'8011',
						'8170',
						'8175',
						'ZZZZ')
				THEN 'Other'

				WHEN COALESCE(dcos.[Dimension Value Code], '') in (
				'5200',
				'5210',
				'5215',
				'5225',
				'5230')
				THEN 'LFO'
				
				WHEN COALESCE(dcos.[Dimension Value Code], '') in (
				'5062',
				'5065',
				'7006',
				'8035',
				'8150')
				THEN 'PPS'

				WHEN COALESCE(dcos.[Dimension Value Code], '') in (
				'5110',
				'5125',
				'5135',
				'5145',
				'5150',
				'5160',
				'5177',
				'5185',
				'5310',
				'6050',
				'8074',
				'8077',
				'8177',
				'8190')
				THEN 'PO'

				WHEN COALESCE(dcos.[Dimension Value Code], '') in (
				'1140',
				'5017',
				'5024',
				'7222',
				'8200',
				'8210',
				'8211',
				'8215',
				'8220')
				THEN 'EO'

				WHEN COALESCE(dcos.[Dimension Value Code], '') in (
				'1151',
				'5620',
				'5640',
				'5641',
				'5642',
				'5643',
				'5644',
				'5645',
				'5646',
				'5647',
				'5648',
				'5649',
				'5680',
				'5685',
				'5690',
				'6011',
				'7007',
				'8191')
				THEN 'EPO'

				WHEN COALESCE(dcos.[Dimension Value Code], '') in (
				'5010',
				'5012',
				'5013',
				'5050',
				'5070',
				'5072',
				'5074',
				'7010',
				'7011',
				'7012',
				'7017',
				'7028',
				'7050',
				'8015',
				'8017',
				'8049',
				'8050',
				'8070',
				'8080',
				'8090',
				'8110',
				'8117',
				'8118',
				'8119',
				'8120',
				'8180')
				THEN 'Instruments'
			END
		END
		, 'Other') [Business Group]  --SEGMENT

,'Default (Employee Type)' [Employee Type] 
,COALESCE(dicp.[Dimension Value Code], 'Default (ICP)') ICP
,COALESCE(dreg.[Dimension Value Code], 'Default (Region)') Region
,CASE 
	WHEN COALESCE(c.[Country_Region Code], 'USA')  = 'TWN' THEN 'TPKM'
	ELSE COALESCE(c.[Country_Region Code], 'USA')
 END Country
,YEAR(gle.[Posting Date]) [FiscalYear]
,MONTH(gle.[Posting Date]) [PeriodID]
,'P' [PeriodType]
,gle.[Debit Amount] Debit
,gle.[Credit Amount] Credit
,gle.Amount

FROM [ZYGO$G_L Entry] gle

LEFT JOIN [ZYGO$Customer] c ON gle.[Source No_] = c.No_ 

left join	[ZYGO$Dimension Set Entry] dcos on gle.[Dimension Set ID] = dcos.[Dimension Set ID] and dcos.[Dimension Code] = 'COSTCENTER'
left join	[ZYGO$Dimension Set Entry] dseg on gle.[Dimension Set ID] = dseg.[Dimension Set ID] and dseg.[Dimension Code] = 'SEGMENT'
left join	[ZYGO$Dimension Set Entry] dind on gle.[Dimension Set ID] = dind.[Dimension Set ID] and dind.[Dimension Code] = 'INDUSTRY'
left join	[ZYGO$Dimension Set Entry] dreg on gle.[Dimension Set ID] = dreg.[Dimension Set ID] and dreg.[Dimension Code] = 'REGION'
left join	[ZYGO$Dimension Set Entry] dsit on gle.[Dimension Set ID] = dsit.[Dimension Set ID] and dreg.[Dimension Code] = 'SITE'
left join	[ZYGO$Dimension Set Entry] dicp on gle.[Dimension Set ID] = dicp.[Dimension Set ID] and dicp.[Dimension Code] = 'ICP'
left join	[ZYGO$Dimension Set Entry] dcat on gle.[Dimension Set ID] = dcat.[Dimension Set ID] and dcat.[Dimension Code] = 'PRODCAT'

WHERE (gle.[Posting Date] between @StartingDate and @EndingDate

AND LEFT(gle.[G_L Account No_], 1) in ('4', '5', '6', '7'))</CommandText>
        <rd:UseGenericDesigner>true</rd:UseGenericDesigner>
      </Query>
      <Fields>
        <Field Name="Posting_Date">
          <DataField>Posting Date</DataField>
          <rd:TypeName>System.DateTime</rd:TypeName>
        </Field>
        <Field Name="Original_ProdCat">
          <DataField>Original ProdCat</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Original_Segment">
          <DataField>Original Segment</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Original_CostCenter">
          <DataField>Original CostCenter</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Account_Number">
          <DataField>Account Number</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="GLSource">
          <DataField>GLSource</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Company">
          <DataField>Company</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Customer">
          <DataField>Customer</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Fiscal_Period___Elimination_Period">
          <DataField>Fiscal Period &amp; Elimination Period</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Product">
          <DataField>Product</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Cost_Center">
          <DataField>Cost Center</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Industry">
          <DataField>Industry</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Version">
          <DataField>Version</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Currency">
          <DataField>Currency</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Business_Group">
          <DataField>Business Group</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Employee_Type">
          <DataField>Employee Type</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="ICP">
          <DataField>ICP</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Region">
          <DataField>Region</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Country">
          <DataField>Country</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="FiscalYear">
          <DataField>FiscalYear</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
        <Field Name="PeriodID">
          <DataField>PeriodID</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
        <Field Name="PeriodType">
          <DataField>PeriodType</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Debit">
          <DataField>Debit</DataField>
          <rd:TypeName>System.Decimal</rd:TypeName>
        </Field>
        <Field Name="Credit">
          <DataField>Credit</DataField>
          <rd:TypeName>System.Decimal</rd:TypeName>
        </Field>
        <Field Name="Amount">
          <DataField>Amount</DataField>
          <rd:TypeName>System.Decimal</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
  </DataSets>
