<?xml version="1.0" encoding="utf-8"?>
<Report MustUnderstand="df" xmlns="http://schemas.microsoft.com/sqlserver/reporting/2016/01/reportdefinition" xmlns:rd="http://schemas.microsoft.com/SQLServer/reporting/reportdesigner" xmlns:df="http://schemas.microsoft.com/sqlserver/reporting/2016/01/reportdefinition/defaultfontfamily">
  <df:DefaultFontFamily>Segoe UI</df:DefaultFontFamily>
  <AutoRefresh>0</AutoRefresh>
  <DataSources>
    <DataSource Name="DataSource1">
      <ConnectionProperties>
        <DataProvider>SQL</DataProvider>
        <ConnectString>Data Source=PA-HOR-AS408.ametek.com;Initial Catalog=ZYGO-NAV-PROD</ConnectString>
      </ConnectionProperties>
      <rd:SecurityType>DataBase</rd:SecurityType>
      <rd:DataSourceID>393c8b3d-e713-4862-b612-40def996d407</rd:DataSourceID>
    </DataSource>
  </DataSources>
  <DataSets>
    <DataSet Name="DataSet1">
      <Query>
        <DataSourceName>DataSource1</DataSourceName>
        <QueryParameters>
          <QueryParameter Name="@start">
            <Value>=Parameters!start.Value</Value>
            <rd:UserDefined>true</rd:UserDefined>
          </QueryParameter>
          <QueryParameter Name="@end">
            <Value>=Parameters!end.Value</Value>
            <rd:UserDefined>true</rd:UserDefined>
          </QueryParameter>
        </QueryParameters>
        <CommandText>
WITH s1 AS
(
select 

  [Posting Date]
,CASE gl.[Document Type]
	WHEN 1 THEN 'Payment'
	WHEN 2 THEN 'Invoice'
	WHEN 3 THEN 'Credit Memo'
	WHEN 4 THEN 'Finance Charge Memo'
	WHEN 5 THEN 'Reminder'
	WHEN 6 THEN 'Refund'
	ELSE ''
END [Document Type]
, [Document No_]
, [Invoice Order No_]
,trim(substring(Description,13,charindex(' ',substring(Description,13,10)))) as [VendorNo]
, v.Name
, [G_L Account No_]
, Amount
, [Debit Amount]
, [Credit Amount]
, gl.[Global Dimension 2 Code] [Segment]
, [External Document No_]
, [Vendor Posting Group]
, [Entry No_]

from   [ZYGO$G_L Entry] gl

INNER JOIN ZYGO$Vendor v

on trim(substring(gl.Description,13,charindex(' ',substring(gl.Description,13,10))))  = v.No_

where  [G_L Account No_] = '21411'

AND gl.[Posting Date] &gt;= @start and gl.[Posting Date] &lt;= @end


UNION ALL


SELECT

gle.[Posting Date]
,CASE gle.[Document Type]
	WHEN 1 THEN 'Payment'
	WHEN 2 THEN 'Invoice'
	WHEN 3 THEN 'Credit Memo'
	WHEN 4 THEN 'Finance Charge Memo'
	WHEN 5 THEN 'Reminder'
	WHEN 6 THEN 'Refund'
	ELSE ''
END [Document Type]
,gle.[Document No_]
,gle.[Invoice Order No_]
,'' [Vendor Number]
,'' [Vendor Name]
,[G_L Account No_]
,gle.Amount
, [Debit Amount]
, [Credit Amount]
,gle.[Global Dimension 2 Code] [Segment]
,gle.[External Document No_]
,'' [Vendor Posting Group]
, [Entry No_]

FROM [ZYGO$G_L Entry] gle

WHERE gle.[G_L Account No_] = '21411'

AND gle.[Posting Date] &gt;= @start and gle.[Posting Date] &lt;= @end

AND SUBSTRING(Description, 0, 12) != 'Direct Cost '

AND SUBSTRING(Description, 0, 12) != 'Revaluation '
)
, s2 AS

(
SELECT 

[Posting Date]
,CASE [Document Type]
	WHEN 1 THEN 'Payment'
	WHEN 2 THEN 'Invoice'
	WHEN 3 THEN 'Credit Memo'
	WHEN 4 THEN 'Finance Charge Memo'
	WHEN 5 THEN 'Reminder'
	WHEN 6 THEN 'Refund'
	ELSE ''
END [Document Type]
, [Document No_]
, [Invoice Order No_]
,'' [Vendor Number]
,'' [Vendor Name]
, [G_L Account No_]
, Amount
, [Debit Amount]
, [Credit Amount]
, [Global Dimension 2 Code] [Segment]
, [External Document No_]
,'' [Vendor Posting Group]
, [Entry No_]

FROM [ZYGO$G_L Entry] 

WHERE [G_L Account No_] = '21411'

AND [Posting Date] &gt;= @start and [Posting Date] &lt;= @end

AND [Entry No_] not in (Select [Entry No_] from s1)
)

SELECT * FROM s1 

UNION ALL

SELECT * FROM s2

--WHERE [Posting Date] &gt;= @start and [Posting Date] &lt;= @end</CommandText>
        <rd:UseGenericDesigner>true</rd:UseGenericDesigner>
      </Query>
      <Fields>
        <Field Name="Posting_Date">
          <DataField>Posting Date</DataField>
          <rd:TypeName>System.DateTime</rd:TypeName>
        </Field>
        <Field Name="Document_Type">
          <DataField>Document Type</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Document_No_">
          <DataField>Document No_</DataField>
