<?xml version="1.0" encoding="utf-8"?>
<Report MustUnderstand="df" xmlns="http://schemas.microsoft.com/sqlserver/reporting/2016/01/reportdefinition" xmlns:rd="http://schemas.microsoft.com/SQLServer/reporting/reportdesigner" xmlns:df="http://schemas.microsoft.com/sqlserver/reporting/2016/01/reportdefinition/defaultfontfamily">
  <df:DefaultFontFamily>Segoe UI</df:DefaultFontFamily>
  <AutoRefresh>0</AutoRefresh>
  <DataSources>
    <DataSource Name="NAVPROD">
      <DataSourceReference>NAVPROD</DataSourceReference>
      <rd:SecurityType>None</rd:SecurityType>
      <rd:DataSourceID>8d99eaf5-6a86-4cb0-a246-0787f9fea9ad</rd:DataSourceID>
    </DataSource>
  </DataSources>
  <DataSets>
    <DataSet Name="DataSet1">
      <Query>
        <DataSourceName>NAVPROD</DataSourceName>
        <QueryParameters>
          <QueryParameter Name="@Status">
            <Value>=Parameters!Status.Value</Value>
          </QueryParameter>
          <QueryParameter Name="@ItemNo">
            <Value>=Parameters!ItemNo.Value</Value>
          </QueryParameter>
          <QueryParameter Name="@ProdOrdNo">
            <Value>=Parameters!ProdOrdNo.Value</Value>
          </QueryParameter>
          <QueryParameter Name="@WorkCenter">
            <Value>=Parameters!WorkCenter.Value</Value>
          </QueryParameter>
        </QueryParameters>
        <CommandText>with s1 as
(
select 

[Document No_] AS [Order No_], 
[Operation No_], 
[Work Center No_], 
sum(Quantity) as [Quantity]

from [ZYGO$Capacity Ledger Entry]

group by 

[Document No_], 
[Operation No_], 
[Work Center No_]
)


select	i.[Global Dimension 2 Code] as [Business Segment Code],

	case p.Status
		when 0 then 'Simulated'
		when 1 then 'Planned'
		when 2 then 'Firm Planned'
		when 3 then 'Released'
		when 4 then 'Finished'
		else 'UNKNOWN' 
	end as [Status],
	
	p.[Prod_ Order No_], 
	l.[Item No_], 
	l.Description [Item Description],
	l.[Starting Date-Time], 
	l.[Ending Date-Time],
	
	p.[Operation No_], 
	p.[Work Center No_], 
	p.Description, 
	
	case p.[Operation Complete] when 0 then 'Yes' else 'No' end as [Operation Complete],
	
	case p.[Routing Status]
		when 0 then 'Blank'
		when 1 then 'Planned'
		when 2 then 'In Progress'
		when 3 then 'Finished'
		else 'UNKNOWN' 
	end as [Routing Step Status]

	,FORMAT(p.[Setup Time], '0.00') [Setup Time] 
	,FORMAT(p.[Run Time], '0.00') [Run Time]
	,FORMAT((p.[Setup Time] + p.[Run Time]), '0.00') as [ExpectedQty] 
	,FORMAT(isnull(a.Quantity,0), '0.00') as [ActualQty],

		case 
			when isnull(a.Quantity,0) = 0 then 'NO ACTIVITY'
			when isnull(a.Quantity,0) = 0.01 then 'NO ACTIVITY (DB)'
			when isnull(a.Quantity,0) &lt;  p.[Setup Time] + p.[Run Time] then 'UNDER'
			when isnull(a.Quantity,0) =  p.[Setup Time] + p.[Run Time] then 'EXACT'
			when isnull(a.Quantity,0) &gt;  p.[Setup Time] + p.[Run Time] then 'OVER'
			else 'UNKNOWN'
		end as [StepStatus],
		FORMAT((p.[Setup Time] + p.[Run Time]) - isnull(a.Quantity,0), '0.00')  as [Difference]

from [ZYGO$Prod_ Order Routing Line] p
inner join [ZYGO$Prod_ Order Line] l on p.[Prod_ Order No_] = l.[Prod_ Order No_] 
inner join ZYGO$Item i on l.[Item No_] = i.No_
left join s1 a on p.[Prod_ Order No_] = a.[Order No_] and p.[Operation No_] = a.[Operation No_] and p.[Work Center No_] = p.[Work Center No_]

where i.[Global Dimension 2 Code]  IN ( 'CRYSTALLINE OPTICS', 'GLASS OPTICS', 'MACHINED STRUCTURES')

AND (p.Status in (@Status) OR @Status is Null)

AND (i.No_ in (@ItemNo) OR @ItemNo is Null)

AND (p.[Prod_ Order No_] in (@ProdOrdNo) OR @ProdOrdNo is Null)

AND (p.[Work Center No_] in (@WorkCenter) OR @WorkCenter is Null)

ORDER BY [Starting Date-Time]

-- filters
-- status
-- item no
-- prod order no
-- work center no</CommandText>
        <rd:UseGenericDesigner>true</rd:UseGenericDesigner>
      </Query>
      <Fields>
        <Field Name="Business_Segment_Code">
          <DataField>Business Segment Code</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Status">
          <DataField>Status</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Prod__Order_No_">
          <DataField>Prod_ Order No_</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Item_No_">
          <DataField>Item No_</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Item_Description">
          <DataField>Item Description</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Starting_Date_Time">
