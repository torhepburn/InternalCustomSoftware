          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Work_Center_No_">
          <DataField>Work Center No_</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Description">
          <DataField>Description</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Operation_Complete">
          <DataField>Operation Complete</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Routing_Step_Status">
          <DataField>Routing Step Status</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Setup_Time">
          <DataField>Setup Time</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Run_Time">
          <DataField>Run Time</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="ExpectedQty">
          <DataField>ExpectedQty</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="ActualQty">
          <DataField>ActualQty</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="StepStatus">
          <DataField>StepStatus</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Difference">
          <DataField>Difference</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
  </DataSets>
