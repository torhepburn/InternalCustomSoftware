<?xml version="1.0" encoding="utf-8"?>
<Report MustUnderstand="df" xmlns="http://schemas.microsoft.com/sqlserver/reporting/2016/01/reportdefinition" xmlns:rd="http://schemas.microsoft.com/SQLServer/reporting/reportdesigner" xmlns:df="http://schemas.microsoft.com/sqlserver/reporting/2016/01/reportdefinition/defaultfontfamily">
  <df:DefaultFontFamily>Segoe UI</df:DefaultFontFamily>
  <AutoRefresh>0</AutoRefresh>
  <DataSources>
    <DataSource Name="DataSource1">
      <ConnectionProperties>
        <DataProvider>SQL</DataProvider>
        <ConnectString>Data Source=CT-MID-SQL11;Initial Catalog=Maintenance</ConnectString>
      </ConnectionProperties>
      <rd:SecurityType>DataBase</rd:SecurityType>
      <rd:DataSourceID>5642fc11-d562-49cd-800a-be8e3e7fab89</rd:DataSourceID>
    </DataSource>
  </DataSources>
  <DataSets>
    <DataSet Name="DataSet1">
      <Query>
        <DataSourceName>DataSource1</DataSourceName>
        <CommandText>select

CASE F1
	WHEN 1 THEN 'RED'
	ELSE ''
END Priority
,COALESCE(EquipmentID,'') EquipmentID
,COALESCE(Description,'') Description
,COALESCE(Manufacturer,'') Manufacturer
,COALESCE(Model,'') Model
,COALESCE([Operational Status],'') [Operational Status]
,k.[Owner ]
,Location
,COALESCE(Task,'') Task
,COALESCE(TaskGroup,'') TaskGroup
,COALESCE(LASTPM,'') LASTPM
,COALESCE(NEXTPM,'') NEXTPM
,COALESCE(Frequency,'') Frequency
,COALESCE(t.MATERIAL,'') Material
,CASE OpenWorkRequest
	WHEN 1 THEN 'Currently Open'
	ELSE ''
END OpenWorkRequest
,COALESCE(EstimatedHours,'') EstimatedHours
,COALESCE(EstimatedCost,'') EstimatedCost
,COALESCE(m.Material,'') [Material Detail]

from KatyPM k

left join tasks t on k.[Equipment ID] = t.EquipmentID

left join material m on t.MaterialID = m.ID

--where f1 = 1

order by f1 desc, [Equipment ID], TaskGroup

--delete from KatyPM where [Equipment ID] is null

--select * from tasks

--select * from Material</CommandText>
        <rd:UseGenericDesigner>true</rd:UseGenericDesigner>
      </Query>
