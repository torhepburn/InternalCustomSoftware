<?xml version="1.0" encoding="utf-8"?>
<Report MustUnderstand="df" xmlns="http://schemas.microsoft.com/sqlserver/reporting/2016/01/reportdefinition" xmlns:rd="http://schemas.microsoft.com/SQLServer/reporting/reportdesigner" xmlns:df="http://schemas.microsoft.com/sqlserver/reporting/2016/01/reportdefinition/defaultfontfamily">
  <df:DefaultFontFamily>Segoe UI</df:DefaultFontFamily>
  <AutoRefresh>0</AutoRefresh>
  <DataSources>
    <DataSource Name="DataSource1">
      <ConnectionProperties>
        <DataProvider>SQL</DataProvider>
        <ConnectString>Data Source=PA-HOR-AS408.ametek.com;Initial Catalog=ZYGO-NAV-PROD</ConnectString>
      </ConnectionProperties>
      <rd:SecurityType>DataBase</rd:SecurityType>
      <rd:DataSourceID>47b4a313-5e52-4a3a-b366-a93960a4cb00</rd:DataSourceID>
    </DataSource>
  </DataSources>
  <DataSets>
    <DataSet Name="DataSet1">
      <Query>
        <DataSourceName>DataSource1</DataSourceName>
        <CommandText>with S1 as
(

SELECT 

[Item No_]
,[Bin Code]
,[Location Code]
,SUM(Quantity) InBin

FROM [ZYGO$Warehouse Entry]

GROUP BY 

[Item No_]
,[Bin Code]
,[Location Code]
 
)


select 

c.[Prod_ Order No_]
,c.[Item No_]
,FORMAT(c.[Remaining Quantity], 'N0') [Remaining Quantity]
,S1.[Bin Code]
,FORMAT(S1.InBin, 'N0') InBin
,CASE i.[Replenishment System]
	WHEN 0 then 'Purch'
	WHEN 1 THEN 'MFG'
END [Purch or Mfg]
,o.[Buyer Planner Code]


--,* 

FROM [ZYGO$Prod_ Order Component] c

INNER JOIN ZYGO$Item i ON i.No_ = c.[Item No_]

LEFT JOIN [ZYGO$Prod_ Order Line] L ON L.[Prod_ Order No_] = c.[Prod_ Order No_]

INNER JOIN [ZYGO$Production Order] o ON o.No_ = L.[Prod_ Order No_]

LEFT JOIN S1 on S1.[Item No_] = c.[Item No_]AND c.[Bin Code] = S1.[Bin Code] and c.[Location Code] = S1.[Location Code]

where 

c.Status = 3

AND c.[Remaining Quantity] &gt; 0

AND S1.InBin &gt; 0

AND [Global Dimension 2 Code] in ('OPT PROFILER PROD','OPT PROFILER SVCS', 'PPS COMPONENTS', 'PPS SERVICES', 'PPS SYSTEMS', 'LAS INTERF PROD', 'LAS INTERF SVCS', 'ELECTRO-OPTICS OTHER' )

ORDER BY i.[Replenishment System], L.[Prod_ Order No_], i.No_</CommandText>
        <rd:UseGenericDesigner>true</rd:UseGenericDesigner>
      </Query>
      <Fields>
        <Field Name="Prod__Order_No_">
          <DataField>Prod_ Order No_</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Item_No_">
          <DataField>Item No_</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Remaining_Quantity">
          <DataField>Remaining Quantity</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Bin_Code">
          <DataField>Bin Code</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="InBin">
          <DataField>InBin</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Purch_or_Mfg">
          <DataField>Purch or Mfg</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Buyer_Planner_Code">
          <DataField>Buyer Planner Code</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
  </DataSets>
