      <rd:DataSourceID>8cbc98d9-6381-42b0-810e-2b0ac4b71c21</rd:DataSourceID>
    </DataSource>
  </DataSources>
  <DataSets>
    <DataSet Name="DataSet1">
      <Query>
        <DataSourceName>DataSource1</DataSourceName>
        <CommandText>SELECT

COUNT(Frequency) [Number of Tasks]
,Frequency

FROM tasks t INNER JOIN equipment e on t.equipmentuid = e.id

WHERE e.status = 'active'

GROUP BY Frequency

ORDER BY Frequency</CommandText>
      </Query>
      <Fields>
        <Field Name="Number_of_Tasks">
          <DataField>Number of Tasks</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
        <Field Name="Frequency">
          <DataField>Frequency</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
  </DataSets>
