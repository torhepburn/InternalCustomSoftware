  <DataSets>
    <DataSet Name="DataSet1">
      <Query>
        <DataSourceName>DataSource1</DataSourceName>
        <CommandText>select

No_
,Description
,[Item Group Code]
,[Selection Code]
,[Reference Component]

from ZYGO$Item where 

[Selection Code] = 'MMX'

AND CHARINDEX('X',No_,1)&lt;&gt;1</CommandText>
        <rd:UseGenericDesigner>true</rd:UseGenericDesigner>
      </Query>
      <Fields>
        <Field Name="No_">
          <DataField>No_</DataField>
          <rd:TypeName>System.String</rd:TypeName>
