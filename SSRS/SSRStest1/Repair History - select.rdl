<?xml version="1.0" encoding="utf-8"?>
<Report MustUnderstand="df" xmlns="http://schemas.microsoft.com/sqlserver/reporting/2016/01/reportdefinition" xmlns:rd="http://schemas.microsoft.com/SQLServer/reporting/reportdesigner" xmlns:df="http://schemas.microsoft.com/sqlserver/reporting/2016/01/reportdefinition/defaultfontfamily">
  <df:DefaultFontFamily>Segoe UI</df:DefaultFontFamily>
  <AutoRefresh>0</AutoRefresh>
  <DataSources>
    <DataSource Name="Maintenance">
      <DataSourceReference>Maintenance</DataSourceReference>
      <rd:SecurityType>None</rd:SecurityType>
      <rd:DataSourceID>91f86378-d04f-45f6-a0e7-3704bce2d4e1</rd:DataSourceID>
    </DataSource>
  </DataSources>
  <DataSets>
    <DataSet Name="DataSet1">
      <Query>
        <DataSourceName>Maintenance</DataSourceName>
        <QueryParameters>
          <QueryParameter Name="@StartingReportdDate">
            <Value>=Parameters!StartingReportdDate.Value</Value>
          </QueryParameter>
          <QueryParameter Name="@EndingReportdDate">
            <Value>=Parameters!EndingReportdDate.Value</Value>
            <rd:UserDefined>true</rd:UserDefined>
          </QueryParameter>
          <QueryParameter Name="@RepairCategory">
            <Value>=Parameters!RepairCategory.Value</Value>
          </QueryParameter>
          <QueryParameter Name="@Status">
            <Value>=Parameters!Status.Value</Value>
            <rd:UserDefined>true</rd:UserDefined>
          </QueryParameter>
        </QueryParameters>
        <CommandText>SELECT

h.EquipmentID
,COALESCE(e.DESCRIPTION,'') [Description]
,h.ID WorkRequestNumber
,h.RepairCategory
,h.severity
,h.issue
,h.ReportedDate
,h.RepairDate
,h.REPAIR_TIME
,h.TimeOpen
,h.CompletedDate
,h.Status
,ReportedByName
,AssignedToName

FROM REPAIR_HISTORY h

INNER JOIN Equipment e ON h.EquipmentUID = e.ID

WHERE (ReportedDate &gt; @StartingReportdDate OR @StartingReportdDate is null)

AND (ReportedDate &lt; @EndingReportdDate OR @EndingReportdDate is null)

AND RepairCategory in (@RepairCategory)

AND h.Status in (@Status)</CommandText>
        <rd:UseGenericDesigner>true</rd:UseGenericDesigner>
      </Query>
      <Fields>
        <Field Name="EquipmentID">
          <DataField>EquipmentID</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Description">
          <DataField>Description</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="WorkRequestNumber">
          <DataField>WorkRequestNumber</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
        <Field Name="RepairCategory">
          <DataField>RepairCategory</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="severity">
          <DataField>severity</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="issue">
          <DataField>issue</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="ReportedDate">
          <DataField>ReportedDate</DataField>
          <rd:TypeName>System.DateTime</rd:TypeName>
        </Field>
        <Field Name="RepairDate">
          <DataField>RepairDate</DataField>
          <rd:TypeName>System.DateTime</rd:TypeName>
        </Field>
        <Field Name="REPAIR_TIME">
          <DataField>REPAIR_TIME</DataField>
          <rd:TypeName>System.Double</rd:TypeName>
        </Field>
        <Field Name="TimeOpen">
          <DataField>TimeOpen</DataField>
          <rd:TypeName>System.Decimal</rd:TypeName>
        </Field>
        <Field Name="CompletedDate">
          <DataField>CompletedDate</DataField>
          <rd:TypeName>System.DateTime</rd:TypeName>
        </Field>
        <Field Name="Status">
          <DataField>Status</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="ReportedByName">
          <DataField>ReportedByName</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="AssignedToName">
          <DataField>AssignedToName</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
