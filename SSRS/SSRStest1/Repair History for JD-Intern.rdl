<?xml version="1.0" encoding="utf-8"?>
<Report xmlns="http://schemas.microsoft.com/sqlserver/reporting/2016/01/reportdefinition" xmlns:rd="http://schemas.microsoft.com/SQLServer/reporting/reportdesigner" xmlns:df="http://schemas.microsoft.com/sqlserver/reporting/2016/01/reportdefinition/defaultfontfamily" MustUnderstand="df">
  <df:DefaultFontFamily>Segoe UI</df:DefaultFontFamily>
  <AutoRefresh>0</AutoRefresh>
  <DataSources>
    <DataSource Name="Maintenance">
      <DataSourceReference>Maintenance</DataSourceReference>
      <rd:SecurityType>None</rd:SecurityType>
      <rd:DataSourceID>333a9924-b135-4122-b316-9aa551e74f10</rd:DataSourceID>
    </DataSource>
  </DataSources>
  <DataSets>
    <DataSet Name="DataSet1">
      <Query>
        <DataSourceName>Maintenance</DataSourceName>
        <CommandText>SELECT
       
	   COALESCE(reporteddate,'1900-01-01')[Repair Request Date]    
      ,repairdate [Repair Date]    
      ,r.EquipmentID
	  ,COALESCE(q.description,'') Description
	  ,q.STARTDATE
	  ,COALESCE(repaircategory,'') repaircategory
	  ,e.NAME [AssignedTo]
	  ,COALESCE(issue,'') issue    
      ,COALESCE(repairdescription,'') repairdescription
      ,COALESCE(root_cause,'') rootcause
      ,COALESCE(supervisorcomments,'') supervisorcomments
      ,repair_time    
      ,timeopen
	  ,location
	  ,CASE l.SiteID
		WHEN 1 THEN 'Middlefield'
		WHEN 11 THEN 'Richmond'
		WHEN 5 THEN 'Irvine'
		ELSE 'Tucson'
	  END Site
	  ,OperationalStatus
	  ,q.Status
	  ,OWNER
	  ,COALESCE(EstimatedHours,'') EstimatedHours
	  ,COALESCE(COMMENT,'') Comment
	  ,COALESCE(SEVERITY,'') Severity

      FROM Repair_History r
	  LEFT JOIN view_employees_all_local e on r.AssignedTo = e.ID

	  LEFT JOIN Equipment q on r.EquipmentUID = q.ID

	  LEFT JOIN Locations l ON q.LocationID = l.ID

	  LEFT JOIN Owners o ON q.OwnerID = o.ID
	  	  
	  WHERE 1=1 --r.AssignedTo in( 546,1500,1698,1699,549,1501,1476,551,552)
	  
	  --and ReportedDate &gt; DateADD(mm, -12, GETDATE())
      --ReportedDate &gt; '2000-01-01'

	  AND RepairDate is not null

      ORDER BY reporteddate</CommandText>
        <rd:UseGenericDesigner>true</rd:UseGenericDesigner>
      </Query>
      <Fields>
        <Field Name="Repair_Request_Date">
          <DataField>Repair Request Date</DataField>
          <rd:TypeName>System.DateTime</rd:TypeName>
        </Field>
        <Field Name="Repair_Date">
          <DataField>Repair Date</DataField>
          <rd:TypeName>System.DateTime</rd:TypeName>
        </Field>
