<?xml version="1.0" encoding="utf-8"?>
<Report xmlns="http://schemas.microsoft.com/sqlserver/reporting/2016/01/reportdefinition" xmlns:rd="http://schemas.microsoft.com/SQLServer/reporting/reportdesigner" xmlns:df="http://schemas.microsoft.com/sqlserver/reporting/2016/01/reportdefinition/defaultfontfamily" MustUnderstand="df">
  <df:DefaultFontFamily>Segoe UI</df:DefaultFontFamily>
  <AutoRefresh>0</AutoRefresh>
  <DataSources>
    <DataSource Name="Maintenance">
      <DataSourceReference>Maintenance</DataSourceReference>
      <rd:SecurityType>None</rd:SecurityType>
      <rd:DataSourceID>7e045b90-16bf-4291-9944-c5cc4d62c7e4</rd:DataSourceID>
    </DataSource>
  </DataSources>
  <DataSets>
    <DataSet Name="DataSet1">
      <Query>
        <DataSourceName>Maintenance</DataSourceName>
        <CommandText>WITH s1 AS
(
select

id
,AMETEK_ID
,Name
,[Status]


from [MIDDB01.zygo.com].Dashboard.dbo.requisitioner
)

SELECT

h.ID WRNumber
,EquipmentID
,Severity
,ReportedDate
,Issue
,COALESCE(RepairDescription,'') RepairDescription
,COALESCE(RepairDate,'') RepairDate
,s1.Name ReportedBy
,s1A.Name AssignedTo

from maintenance.dbo.REPAIR_HISTORY h

LEFT JOIN s1 ON h.ReportedBy = s1.ID

LEFT JOIN s1 s1A ON h.AssignedTo = s1A.ID

where RepairCategory = 'Machine down - production stopped'  and h.status != 'closed'</CommandText>
        <rd:UseGenericDesigner>true</rd:UseGenericDesigner>
      </Query>
      <Fields>
        <Field Name="WRNumber">
          <DataField>WRNumber</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
        <Field Name="EquipmentID">
          <DataField>EquipmentID</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Severity">
          <DataField>Severity</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="ReportedDate">
