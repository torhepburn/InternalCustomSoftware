<?xml version="1.0" encoding="utf-8"?>
<Project ToolsVersion="Current" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup Condition=" '$(Configuration)' == 'Debug' ">
    <FullPath>Debug</FullPath>
    <OutputPath>bin\Debug</OutputPath>
    <ErrorLevel>2</ErrorLevel>
    <OverwriteDatasets>False</OverwriteDatasets>
    <OverwriteDataSources>False</OverwriteDataSources>
    <TargetServerVersion>SSRS2016</TargetServerVersion>
    <Platform>Win32</Platform>
    <TargetReportFolder>PM Reports</TargetReportFolder>
    <TargetDatasetFolder>Datasets</TargetDatasetFolder>
    <TargetDatasourceFolder>Data Sources</TargetDatasourceFolder>
    <TargetReportPartFolder>Report Parts</TargetReportPartFolder>
    <TargetServerURL>http://ct-mid-sql11/reportserver</TargetServerURL>
  </PropertyGroup>
  <PropertyGroup Condition=" '$(Configuration)' == 'DebugLocal' ">
    <FullPath>DebugLocal</FullPath>
    <OutputPath>bin\DebugLocal</OutputPath>
    <ErrorLevel>2</ErrorLevel>
    <OverwriteDatasets>False</OverwriteDatasets>
    <OverwriteDataSources>False</OverwriteDataSources>
    <TargetServerVersion>SSRS2016</TargetServerVersion>
    <Platform>Win32</Platform>
    <TargetReportFolder>PM Reports</TargetReportFolder>
    <TargetDatasetFolder>Datasets</TargetDatasetFolder>
    <TargetDatasourceFolder>Data Sources</TargetDatasourceFolder>
    <TargetReportPartFolder>Report Parts</TargetReportPartFolder>
    <TargetServerURL>http://ct-mid-sql11/reportserver</TargetServerURL>
  </PropertyGroup>
  <PropertyGroup Condition=" '$(Configuration)' == 'Release' ">
    <FullPath>Release</FullPath>
    <OutputPath>bin\Release</OutputPath>
    <ErrorLevel>2</ErrorLevel>
    <OverwriteDatasets>False</OverwriteDatasets>
    <OverwriteDataSources>False</OverwriteDataSources>
    <TargetServerVersion>SSRS2016</TargetServerVersion>
    <Platform>Win32</Platform>
    <TargetReportFolder>PM Reports</TargetReportFolder>
    <TargetDatasetFolder>Datasets</TargetDatasetFolder>
    <TargetDatasourceFolder>Data Sources</TargetDatasourceFolder>
    <TargetReportPartFolder>Report Parts</TargetReportPartFolder>
    <TargetServerURL>http://ct-mid-sql11/reportserver</TargetServerURL>
  </PropertyGroup>
  <PropertyGroup>
    <State>$base64$</State>
    <DataSources>@(DataSource)</DataSources>
    <DataSets>@(DataSet)</DataSets>
    <Reports>@(Report)</Reports>
  </PropertyGroup>
  <ItemGroup>
    <DataSource Include="AccessFrontEnds.rds" />
    <DataSource Include="AFE.rds" />
    <DataSource Include="Maintenance.rds" />
    <DataSource Include="NAVPROD.rds" />
    <DataSource Include="OracleTestOne.rds" />
  </ItemGroup>
  <ItemGroup>
    <Report Include="Active Equipment Details.rdl" />
    <Report Include="All Production Kanban Bins.rdl" />
    <Report Include="Blocked Shipments.rdl" />
    <Report Include="Cycle Count.rdl" />
    <Report Include="Dashboard NAV_EAU.rdl" />
    <Report Include="DFT History.rdl" />
    <Report Include="Equipment Task History since 2000.rdl" />
    <Report Include="Equipment w Asset Tag.rdl" />
    <Report Include="Floor Stock.rdl" />
    <Report Include="Inactive Employees with permissions in Maintenance.rdl" />
    <Report Include="INST Shortages.rdl" />
    <Report Include="Late Sales Never Shipped.rdl" />
    <Report Include="Maintenance Reported Production Stopped.rdl" />
    <Report Include="Middlefield nonPM Maintenance.rdl" />
    <Report Include="MINMAX Parts.rdl" />
    <Report Include="Missing Shipments for Week.rdl" />
    <Report Include="MRP Messages.rdl" />
    <Report Include="MRP MMX.rdl" />
    <Report Include="NAV EAU plus.rdl" />
    <Report Include="nonPM27MID.rdl" />
    <Report Include="NonPM30CM.rdl" />
    <Report Include="NonPM30MID.rdl" />
    <Report Include="NonPM30RIC.rdl" />
    <Report Include="PDLineEvaluation.rdl" />
    <Report Include="PM Forecast RIC.rdl" />
    <Report Include="PM Forecast.rdl" />
    <Report Include="PM21CM.rdl" />
    <Report Include="PM21MID.rdl" />
    <Report Include="PM21RIC.rdl" />
    <Report Include="PM27MID.rdl" />
    <Report Include="PM30CM.rdl" />
    <Report Include="PM30MID.rdl" />
    <Report Include="PM30RIC.rdl" />
    <Report Include="PMfrequency.rdl" />
    <Report Include="PMRIC-F30.rdl" />
    <Report Include="PMtaskFrequencyCount.rdl" />
    <Report Include="PO SFO Disconnect Report.rdl" />
    <Report Include="PoPastDue.rdl" />
    <Report Include="Production Kanban Bin Report.rdl" />
    <Report Include="Received Subcontract PO Open SFO.rdl" />
    <Report Include="Released Production Order Components.rdl" />
    <Report Include="RepairsReport.rdl" />
    <Report Include="Richmond PM.rdl" />
    <Report Include="Richmond Shipment Forecast.rdl" />
    <Report Include="RichmondShipments.rdl" />
    <Report Include="Salesperson Sync Report.rdl" />
    <Report Include="Scheduled Maintenance.rdl" />
    <Report Include="Shipped Serial Numbers.rdl" />
    <Report Include="sInstrumentShortages.rdl" />
    <Report Include="TEST on time.rdl" />
    <Report Include="TEST.rdl" />
    <Report Include="Weekly Quote Report.rdl" />
    <Report Include="Work Request Assigned to Inactive User.rdl" />
  </ItemGroup>
  <Import Project="$(MSBuildExtensionsPath)\Reporting Services\Microsoft.ReportingServices.MSBuilder.targets" />
</Project>