<?xml version="1.0" encoding="utf-8"?>
<Report MustUnderstand="df" xmlns="http://schemas.microsoft.com/sqlserver/reporting/2016/01/reportdefinition" xmlns:rd="http://schemas.microsoft.com/SQLServer/reporting/reportdesigner" xmlns:df="http://schemas.microsoft.com/sqlserver/reporting/2016/01/reportdefinition/defaultfontfamily">
  <df:DefaultFontFamily>Segoe UI</df:DefaultFontFamily>
  <AutoRefresh>0</AutoRefresh>
  <DataSources>
    <DataSource Name="DataSource1">
      <ConnectionProperties>
        <DataProvider>SQL</DataProvider>
        <ConnectString>Data Source=pa-hor-as408.ametek.com;Initial Catalog=ZYGO-NAV-PROD</ConnectString>
      </ConnectionProperties>
      <rd:SecurityType>DataBase</rd:SecurityType>
      <rd:DataSourceID>1f4c5816-dff3-4a9e-8eda-61fb70582032</rd:DataSourceID>
    </DataSource>
  </DataSources>
  <DataSets>
    <DataSet Name="DataSet1">
      <Query>
        <DataSourceName>DataSource1</DataSourceName>
        <CommandText>with s1 as
(
select 

sl.[Document No_]
,sl.[Line No_]
,MAX(csdre.[Last Date Modified]) LastChange

from [ZYGO$Sales Line] sl

inner join [ZYGO$Change Sales Date Reason Entry] csdre on sl.[Document No_] = csdre.[Document No_] and sl.[Line No_] = csdre.[Line No_]

GROUP BY sl.[Document No_], sl.[Line No_]
)
,
s2 as
(

select 

s1.[Document No_]
,s1.[Line No_]
,[Change Date Reason Code]
,Description

from s1

left join [ZYGO$Change Sales Date Reason Entry] csdre on s1.[Document No_] = csdre.[Document No_] 
		and s1.[Line No_] = csdre.[Line No_] AND s1.LastChange = csdre.[Last Date Modified]

inner join [ZYGO$Change Date Reasons] cdr on csdre.[Change Date Reason Code] = cdr.Code

GROUP BY s1.[Document No_], s1.[Line No_], [Change Date Reason Code], Description
)

select 

ssl.[Document No_]
,ssl.[Line No_]
,(ssl.[Order No_] + '-' + CAST(ssl.[SO Line No_] as nvarchar)) 'SO+Line'
,ssl.[Order No_]
,ssl.[Posting Date]
,sl.[Orig_ Promised Delivery Date]
,ssl.[Location Code]
,ssl.No_ [Item No]
,ssl.Description [Item Description]
,ssl.[Quantity]
,ssh.[Ship-to Country_Region Code]
,c.Name Customer
,s2.[Change Date Reason Code]
, s2.Description 'Change Date Reason'
,sl.[Line Amount]
,sl.[Shortcut Dimension 2 Code] 

from [ZYGO$Sales Shipment Line] ssl

inner join [ZYGO$Sales Line] sl on ssl.[Order No_] = sl.[Document No_] and ssl.[Line No_] = sl.[Line No_]

inner join [ZYGO$Sales Shipment Header] ssh on ssh.No_ = ssl.[Document No_]

inner join ZYGO$Customer c on ssl.[Sell-to Customer No_] = c.No_

left join s2 on sl.[Document No_] = s2.[Document No_] and sl.[Line No_] = s2.[Line No_]

where ssl.Quantity &gt; 0  AND ssl.No_ != 'FREIGHT'

order by ssl.[Posting Date] desc</CommandText>
        <rd:UseGenericDesigner>true</rd:UseGenericDesigner>
      </Query>
      <Fields>
        <Field Name="Document_No_">
          <DataField>Document No_</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Line_No_">
          <DataField>Line No_</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
        <Field Name="SO_Line">
          <DataField>SO+Line</DataField>
