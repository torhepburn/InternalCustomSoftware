  <AutoRefresh>0</AutoRefresh>
  <DataSources>
    <DataSource Name="Maintenance">
      <DataSourceReference>Maintenance</DataSourceReference>
      <rd:SecurityType>None</rd:SecurityType>
      <rd:DataSourceID>518b98ed-d302-490a-b1ac-bd954351f1ad</rd:DataSourceID>
    </DataSource>
  </DataSources>
  <DataSets>
    <DataSet Name="DataSet1">
      <Query>
        <DataSourceName>Maintenance</DataSourceName>
        <CommandText>select

h.EquipmentID
,COALESCE(e.DESCRIPTION,'') Description
,ReportedDate [Date Requested]
,repairdate [Date Repaired]
,REPAIR_TIME
,TimeOpen [Down Time]
,Severity
,Issue



from REPAIR_HISTORY h

Inner Join Equipment e on h.EquipmentId = e.EquipmentID

where RepairCategory like 'Machine Down%'</CommandText>
        <rd:UseGenericDesigner>true</rd:UseGenericDesigner>
      </Query>
      <Fields>
        <Field Name="EquipmentID">
          <DataField>EquipmentID</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Description">
          <DataField>Description</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Date_Requested">
          <DataField>Date Requested</DataField>
          <rd:TypeName>System.DateTime</rd:TypeName>
        </Field>
        <Field Name="Date_Repaired">
          <DataField>Date Repaired</DataField>
          <rd:TypeName>System.DateTime</rd:TypeName>
        </Field>
        <Field Name="REPAIR_TIME">
          <DataField>REPAIR_TIME</DataField>
          <rd:TypeName>System.Double</rd:TypeName>
        </Field>
        <Field Name="Down_Time">
          <DataField>Down Time</DataField>
          <rd:TypeName>System.Decimal</rd:TypeName>
        </Field>
        <Field Name="Severity">
          <DataField>Severity</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Issue">
          <DataField>Issue</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
