<?xml version="1.0" encoding="utf-8"?>
<Report MustUnderstand="df" xmlns="http://schemas.microsoft.com/sqlserver/reporting/2016/01/reportdefinition" xmlns:rd="http://schemas.microsoft.com/SQLServer/reporting/reportdesigner" xmlns:df="http://schemas.microsoft.com/sqlserver/reporting/2016/01/reportdefinition/defaultfontfamily">
  <df:DefaultFontFamily>Segoe UI</df:DefaultFontFamily>
  <AutoRefresh>0</AutoRefresh>
  <DataSources>
    <DataSource Name="DataSource1">
      <ConnectionProperties>
        <DataProvider>SQL</DataProvider>
        <ConnectString>Data Source=pa-hor-as408.ametek.com;Initial Catalog=ZYGO-NAV-PROD</ConnectString>
      </ConnectionProperties>
      <rd:SecurityType>DataBase</rd:SecurityType>
      <rd:DataSourceID>10ce45db-edde-4acd-b56a-68dd891a4a67</rd:DataSourceID>
    </DataSource>
  </DataSources>
  <DataSets>
    <DataSet Name="DataSet1">
      <Query>
        <DataSourceName>DataSource1</DataSourceName>
        <QueryParameters>
          <QueryParameter Name="@start">
            <Value>=Parameters!start.Value</Value>
          </QueryParameter>
          <QueryParameter Name="@end">
            <Value>=Parameters!end.Value</Value>
          </QueryParameter>
        </QueryParameters>
        <CommandText>SELECT 

sl.Description
,i.[Buyer Planner Code]
,sl.Quantity
,sl.[Outstanding Quantity]
,sl.[Unit Price]
,sl.[Amount Including VAT]
,sl.[Shipment Date]
,sl.[Orig_ Promised Delivery Date]
,sh.[External Document No_]
,sh.No_
,sl.[SO Line No_]


FROM [ZYGO$Sales Line] sl

INNER JOIN [ZYGO$Sales Header] sh ON sh.No_ = sl.[Document No_]

LEFT JOIN [ZYGO$Item] i on sl.No_ = i.No_

WHERE 1=1

AND sl.[Shipment Date] &gt;= @start AND sl.[Shipment Date] &lt;= @end

AND sl.[Location Code] = 'RIC'

AND sl.Type = 2 --Item

ORDER BY sl.[Shipment Date]</CommandText>
        <rd:UseGenericDesigner>true</rd:UseGenericDesigner>
      </Query>
      <Fields>
        <Field Name="Description">
          <DataField>Description</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Buyer_Planner_Code">
          <DataField>Buyer Planner Code</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Quantity">
          <DataField>Quantity</DataField>
          <rd:TypeName>System.Decimal</rd:TypeName>
        </Field>
        <Field Name="Outstanding_Quantity">
          <DataField>Outstanding Quantity</DataField>
          <rd:TypeName>System.Decimal</rd:TypeName>
        </Field>
        <Field Name="Unit_Price">
          <DataField>Unit Price</DataField>
          <rd:TypeName>System.Decimal</rd:TypeName>
        </Field>
        <Field Name="Amount_Including_VAT">
          <DataField>Amount Including VAT</DataField>
          <rd:TypeName>System.Decimal</rd:TypeName>
        </Field>
        <Field Name="Shipment_Date">
          <DataField>Shipment Date</DataField>
          <rd:TypeName>System.DateTime</rd:TypeName>
        </Field>
        <Field Name="Orig__Promised_Delivery_Date">
          <DataField>Orig_ Promised Delivery Date</DataField>
          <rd:TypeName>System.DateTime</rd:TypeName>
        </Field>
        <Field Name="External_Document_No_">
          <DataField>External Document No_</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="No_">
          <DataField>No_</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="SO_Line_No_">
          <DataField>SO Line No_</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
