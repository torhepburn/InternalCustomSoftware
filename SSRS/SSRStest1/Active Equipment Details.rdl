  <DataSources>
    <DataSource Name="Maintenance">
      <DataSourceReference>Maintenance</DataSourceReference>
      <rd:SecurityType>None</rd:SecurityType>
      <rd:DataSourceID>e9a3d0fb-bd20-4704-b607-f5aeef28c3b1</rd:DataSourceID>
    </DataSource>
  </DataSources>
  <DataSets>
    <DataSet Name="DataSet1">
      <Query>
        <DataSourceName>Maintenance</DataSourceName>
        <CommandText>SELECT
[EquipmentID]
,DESCRIPTION
,MANUFACTURER
,COALESCE(MODEL,'') MODEL
,COST_CENTER
,StartDate
,COALESCE([ASSETTAG],'') ASSETTAG
     
  FROM [Maintenance].[dbo].[Equipment]

  WHERE 
  
  Status = 'Active'

  ORDER BY EquipmentID</CommandText>
        <rd:UseGenericDesigner>true</rd:UseGenericDesigner>
      </Query>
      <Fields>
        <Field Name="EquipmentID">
          <DataField>EquipmentID</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
