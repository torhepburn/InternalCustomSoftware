<?xml version="1.0" encoding="utf-8"?>
<Report MustUnderstand="df" xmlns="http://schemas.microsoft.com/sqlserver/reporting/2016/01/reportdefinition" xmlns:rd="http://schemas.microsoft.com/SQLServer/reporting/reportdesigner" xmlns:df="http://schemas.microsoft.com/sqlserver/reporting/2016/01/reportdefinition/defaultfontfamily">
  <df:DefaultFontFamily>Segoe UI</df:DefaultFontFamily>
  <AutoRefresh>0</AutoRefresh>
  <DataSources>
    <DataSource Name="Maintenance">
      <DataSourceReference>Maintenance</DataSourceReference>
      <rd:SecurityType>None</rd:SecurityType>
      <rd:DataSourceID>72b2dcbb-e27a-4552-9617-20624ecab03b</rd:DataSourceID>
    </DataSource>
  </DataSources>
  <DataSets>
    <DataSet Name="DataSet1">
      <Query>
        <DataSourceName>Maintenance</DataSourceName>
        <CommandText>select

h.id
,ReportedDate
,h.EquipmentID
,NAME [Assigned To]
,issue
,DATEDIFF(dd,ReportedDate, GETDATE()) DaysOpen


from REPAIR_HISTORY h

left join view_employees_all_local e on h.AssignedTo = e.ID

left join equipment q on h.Equipmentid = q.EquipmentID


WHERE taskgroup IN ('0.1A', '0.1B','0.1C', '0.1D')

AND ReportedDate &lt; GETDATE()-7

AND h.Status != 'Closed'

AND q.status = 'ACTIVE'

and h.equipmentid not like 'RI-%'

and h.equipmentid not like '%richmond%'

and h.equipmentid not like 'CM-%'

</CommandText>
        <rd:UseGenericDesigner>true</rd:UseGenericDesigner>
      </Query>
      <Fields>
        <Field Name="id">
          <DataField>id</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
        <Field Name="ReportedDate">
          <DataField>ReportedDate</DataField>
          <rd:TypeName>System.DateTime</rd:TypeName>
        </Field>
        <Field Name="EquipmentID">
          <DataField>EquipmentID</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Assigned_To">
          <DataField>Assigned To</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="issue">
          <DataField>issue</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="DaysOpen">
          <DataField>DaysOpen</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
  </DataSets>
