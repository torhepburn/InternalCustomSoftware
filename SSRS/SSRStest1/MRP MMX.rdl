<?xml version="1.0" encoding="utf-8"?>
<Report MustUnderstand="df" xmlns="http://schemas.microsoft.com/sqlserver/reporting/2016/01/reportdefinition" xmlns:rd="http://schemas.microsoft.com/SQLServer/reporting/reportdesigner" xmlns:df="http://schemas.microsoft.com/sqlserver/reporting/2016/01/reportdefinition/defaultfontfamily">
  <df:DefaultFontFamily>Segoe UI</df:DefaultFontFamily>
  <AutoRefresh>0</AutoRefresh>
  <DataSources>
    <DataSource Name="DataSource1">
      <ConnectionProperties>
        <DataProvider>SQL</DataProvider>
        <ConnectString>Data Source=pa-hor-as408.ametek.com;Initial Catalog=ZYGO-NAV-PROD</ConnectString>
      </ConnectionProperties>
      <rd:SecurityType>DataBase</rd:SecurityType>
      <rd:DataSourceID>baa35133-42a5-4445-8562-b16548403ce3</rd:DataSourceID>
    </DataSource>
  </DataSources>
  <DataSets>
    <DataSet Name="DataSet1">
      <Query>
        <DataSourceName>DataSource1</DataSourceName>
        <CommandText>WITH s1 AS		/*    MIN/MAX    */
(
	SELECT
	[Item No_]
    ,COALESCE(SUM([Quantity]), '0.00') Nettable
    FROM [ZYGO$Item Ledger Entry]
    --WHERE [Non-Nettable] = 0 
	GROUP BY [Item No_]
),s2 as

(
	SELECT
I.No_
,COALESCE(SUM(L.[Outstanding Quantity]),'0.00') onorder
FROM [ZYGO$Purchase Line] L
INNER JOIN [ZYGO$Item] I ON L.No_ = I.No_
WHERE ([Replenishment System] = 0 and [Document Type] = 1
and [Outstanding Quantity] &gt; 0)
GROUP BY I.No_
)

select 

distinct 

r.No_
,r.[Buyer Planner Code]
,i.[Selection Code]
--,s2.No_

,CASE [Action Message]
	WHEN 1 THEN 'New'
	WHEN 2 THEN 'Change Quantity'
	WHEN 4 THEN 'Reschedule and Change Quantity'
END Action
, r.[Quantity] 'MRP Request Qty'
--,r.[Original Quantity]

,[Starting Date]
,Nettable + COALESCE(onorder,0) 'Nettable + On Order'
,[Reorder Point]

 

from [ZYGO$Requisition Line] r

left join ZYGO$Item i on r.No_ = i.No_ 

LEFT JOIN s1 ON r.No_ = s1.[Item No_]

LEFT JOIN s2 on r.No_ = s2.No_

WHERE 

0=0

AND (r.[Ref_ Order Type] = 1

AND r.Type = 2

AND r.[Worksheet Template Name] = 'PLANNING'

AND r.[Journal Batch Name] = 'DEFAULT'

AND r.Quantity &gt; r.[Original Quantity]	/**/

AND i.[Selection Code] not like 'K%'

AND i.[Selection Code] not like 'CFM%'

AND [Action Message] NOT IN (3,5)

AND i.No_ &lt;&gt; 'SERVICE ITEM'

AND CHARINDEX('%', r.Description, 1) &lt;&gt; 1

--AND r.[Starting Date] &lt; (GETDATE() + 7)

/*		MinMax specifics	*/

AND i.[Selection Code] = 'MMX'

AND i.Vetted &lt;&gt; '1'

AND i.[Reference Component] = 0

--AND s1.Nettable &lt; i.[Reorder Point]

AND CHARINDEX('X', r.No_, 1) &lt;&gt; 1)

--OR

--(i.[Reference Component] = 1 AND [Item Group Code] = 'CNT' AND [Reordering Policy] = 1 )


/*
nettable 
 ("SELECT " +
                        "COALESCE(FORMAT(SUM([Quantity]),'N', 'en-us'), '0.00') " +
                        "FROM [" + NAVprefix + "Item Ledger Entry] " +
                        "WHERE [Non-Nettable] = 0 " +
                        "and [Item No_] = '" + ItemNo + "' "

*/








ORDER BY

 r.[Starting Date]
,r.No_</CommandText>
        <rd:UseGenericDesigner>true</rd:UseGenericDesigner>
      </Query>
      <Fields>
        <Field Name="No_">
          <DataField>No_</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Buyer_Planner_Code">
          <DataField>Buyer Planner Code</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Selection_Code">
          <DataField>Selection Code</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Action">
          <DataField>Action</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="MRP_Request_Qty">
          <DataField>MRP Request Qty</DataField>
          <rd:TypeName>System.Decimal</rd:TypeName>
        </Field>
        <Field Name="Starting_Date">
          <DataField>Starting Date</DataField>
          <rd:TypeName>System.DateTime</rd:TypeName>
        </Field>
        <Field Name="Nettable___On_Order">
          <DataField>Nettable + On Order</DataField>
          <rd:TypeName>System.Decimal</rd:TypeName>
        </Field>
        <Field Name="Reorder_Point">
          <DataField>Reorder Point</DataField>
          <rd:TypeName>System.Decimal</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
  </DataSets>
