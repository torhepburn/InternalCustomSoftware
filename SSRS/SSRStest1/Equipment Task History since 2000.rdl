<?xml version="1.0" encoding="utf-8"?>
<Report MustUnderstand="df" xmlns="http://schemas.microsoft.com/sqlserver/reporting/2016/01/reportdefinition" xmlns:rd="http://schemas.microsoft.com/SQLServer/reporting/reportdesigner" xmlns:df="http://schemas.microsoft.com/sqlserver/reporting/2016/01/reportdefinition/defaultfontfamily">
  <df:DefaultFontFamily>Segoe UI</df:DefaultFontFamily>
  <AutoRefresh>0</AutoRefresh>
  <DataSources>
    <DataSource Name="Maintenance">
      <DataSourceReference>Maintenance</DataSourceReference>
      <rd:SecurityType>None</rd:SecurityType>
      <rd:DataSourceID>6bf6cd00-3612-434a-944e-2e3767ef1ed3</rd:DataSourceID>
    </DataSource>
  </DataSources>
  <DataSets>
    <DataSet Name="DataSet1">
      <Query>
        <DataSourceName>Maintenance</DataSourceName>
        <CommandText>SELECT
       
	   reporteddate    
      ,repairdate    
      ,EquipmentID
	  ,COALESCE(repaircategory,'') repaircategory
	  ,e.NAME [AssignedTo]
	  ,COALESCE(issue,'') issue    
      ,COALESCE(repairdescription,'') repairdescription
      ,COALESCE(root_cause,'') rootcause
      ,COALESCE(supervisorcomments,'') supervisorcomments
      ,repair_time    
      ,timeopen
	  
	  
      FROM Repair_History r
	  LEFT JOIN view_employees_all_local e
	  on r.AssignedTo = e.ID
      
	  WHERE --r.AssignedTo in( 546,1500,1698,1699,549,1501,1476,551,552)
	  
	  --and ReportedDate &gt; DateADD(mm, -12, GETDATE())
      ReportedDate &gt; '2000-01-01'

	  AND RepairDate is not null

      ORDER BY reporteddate</CommandText>
        <rd:UseGenericDesigner>true</rd:UseGenericDesigner>
      </Query>
      <Fields>
        <Field Name="reporteddate">
          <DataField>reporteddate</DataField>
          <rd:TypeName>System.DateTime</rd:TypeName>
        </Field>
        <Field Name="repairdate">
          <DataField>repairdate</DataField>
          <rd:TypeName>System.DateTime</rd:TypeName>
        </Field>
        <Field Name="EquipmentID">
          <DataField>EquipmentID</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="repaircategory">
          <DataField>repaircategory</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="AssignedTo">
          <DataField>AssignedTo</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="issue">
          <DataField>issue</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="repairdescription">
          <DataField>repairdescription</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="rootcause">
          <DataField>rootcause</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="supervisorcomments">
          <DataField>supervisorcomments</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="repair_time">
          <DataField>repair_time</DataField>
          <rd:TypeName>System.Double</rd:TypeName>
        </Field>
        <Field Name="timeopen">
          <DataField>timeopen</DataField>
          <rd:TypeName>System.Decimal</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
  </DataSets>
