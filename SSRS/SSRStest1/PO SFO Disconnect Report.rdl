  <AutoRefresh>0</AutoRefresh>
  <DataSources>
    <DataSource Name="DataSource1">
      <ConnectionProperties>
        <DataProvider>SQL</DataProvider>
        <ConnectString>Data Source=pa-hor-as408.ametek.com;Initial Catalog=ZYGO-NAV-PROD</ConnectString>
      </ConnectionProperties>
      <rd:SecurityType>DataBase</rd:SecurityType>
      <rd:DataSourceID>9eb161fe-2c5e-4146-881f-2cb761d32cf7</rd:DataSourceID>
    </DataSource>
  </DataSources>
  <DataSets>
    <DataSet Name="DataSet1">
      <Query>
        <DataSourceName>DataSource1</DataSourceName>
        <CommandText>select DISTINCT
'Open PO Closed SFO' [Category]
, pd.[Buyer Planner Code]
, pd.No_ as [Production Order No]
, ph.[Due Date]
, dl.[Item No_]
, pd.Description
, dl.Quantity [SFO Quantity]
, dl.[Remaining Quantity]
, CASE pd.Status
	WHEN 2 THEN 'Firm Planned'
	WHEN 3 THEN 'Released'
	WHEN 4 THEN 'Finished'
END as Status

, ph.[Purchaser Code]
, pl.[Document No_] as [PO No]
, pl.[PO Line No_]
, ph.[Buy-from Vendor No_] as [Vendor No]
, [Buy-from Vendor Name] as [Vendor Name]
, pl.No_ as [Subcontract Item No]
, pl.Description as [Subcontract Description]
, pd.Description as [Item Description]
, pl.[Location Code]
, pl.[Bin Code]
, pl.[Planned Receipt Date]
, pl.Quantity [PO Quantity]
, pl.[Outstanding Quantity]
, pl.[Unit of Measure Code]

from [ZYGO$Purchase Line] pl
inner join [ZYGO$Purchase Header] ph on pl.[Document No_] = ph.No_
inner join [ZYGO$Production Order] pd on pl.[Prod_ Order No_] = pd.[No_]
INNER JOIN  [ZYGO$Prod_ Order Line] dl on dl.[Prod_ Order No_] = pd.[No_]

where pl.[Prod_ Order No_] &lt;&gt; ''
and pl.[Outstanding Quantity] &lt;&gt; 0
and pd.Status = 4 -- closed


UNION

select DISTINCT

'PO received Open SFO' [Category]
, pd.[Buyer Planner Code]
, pd.No_ as [Production Order No]
, ph.[Due Date]
, dl.[Item No_]
, pd.Description
, dl.Quantity [SFO Quantity]
, dl.[Remaining Quantity]
, CASE pd.Status
	WHEN 2 THEN 'Firm Planned'
	WHEN 3 THEN 'Released'
	WHEN 4 THEN 'Finished'
END as Status

, ph.[Purchaser Code]
, pl.[Document No_] as [PO No]
, pl.[PO Line No_]
, ph.[Buy-from Vendor No_] as [Vendor No]
, [Buy-from Vendor Name] as [Vendor Name]
, pl.No_ as [Subcontract Item No]
, pl.Description as [Subcontract Description]
, pd.Description as [Item Description]
, pl.[Location Code]
, pl.[Bin Code]
, pl.[Planned Receipt Date]
, pl.Quantity [PO Quantity]
, pl.[Outstanding Quantity]
, pl.[Unit of Measure Code]

from [ZYGO$Purchase Line] pl
inner join [ZYGO$Purchase Header] ph on pl.[Document No_] = ph.No_
inner join [ZYGO$Production Order] pd on pl.[Prod_ Order No_] = pd.[No_]
INNER JOIN  [ZYGO$Prod_ Order Line] dl on dl.[Prod_ Order No_] = pd.[No_]

where pl.[Prod_ Order No_] &lt;&gt; ''
and pl.[Outstanding Quantity] = 0
and pd.Status &lt;&gt; 4 -- closed

ORDER BY Category,  [Buyer Planner Code], [Vendor Name], [Item No_]</CommandText>
        <rd:UseGenericDesigner>true</rd:UseGenericDesigner>
      </Query>
