<?xml version="1.0" encoding="utf-8"?>
<Report MustUnderstand="df" xmlns="http://schemas.microsoft.com/sqlserver/reporting/2016/01/reportdefinition" xmlns:rd="http://schemas.microsoft.com/SQLServer/reporting/reportdesigner" xmlns:df="http://schemas.microsoft.com/sqlserver/reporting/2016/01/reportdefinition/defaultfontfamily">
  <df:DefaultFontFamily>Segoe UI</df:DefaultFontFamily>
  <AutoRefresh>0</AutoRefresh>
  <DataSources>
    <DataSource Name="DataSource1">
      <ConnectionProperties>
        <DataProvider>SQL</DataProvider>
        <ConnectString>Data Source=CT-MID-SQL01;Initial Catalog=AccessFrontEnds</ConnectString>
      </ConnectionProperties>
      <rd:SecurityType>DataBase</rd:SecurityType>
      <rd:DataSourceID>c331a351-c923-4883-833d-8c0711603755</rd:DataSourceID>
    </DataSource>
  </DataSources>
  <DataSets>
    <DataSet Name="DataSet1">
      <Query>
        <DataSourceName>DataSource1</DataSourceName>
        <CommandText>with S1 as

(
	SELECT 
	[Item No_] PartNumber
	,SUM(Quantity) OnHand
	FROM NAV_ILE1
	WHERE [Non-Nettable] = 0
	GROUP BY [Item No_]
),
S2 as
(
	SELECT
	[Item No_] PartNumber
	,SUM([Remaining Quantity]) OnOrder
	FROM NAV_ProdOrdLine p 
	INNER JOIN NAV_Item i ON p.[Item No_] = i.Partnumber
	WHERE [Status] = 3
	AND [Remaining Quantity] &gt; 0
	
	GROUP BY [Item No_]
)

SELECT 

 [Buyer Planner Code]
,n.PartNumber
,NoOfBins
,FORMAT([Reorder Quantity],'N0') BinSize
,FORMAT([Reorder Quantity]*(NoOfBins),'N0') DesiredLevel
,FORMAT(OnHand, 'N0') OnHand
,FORMAT(OnOrder, 'N0') OnOrder
,FORMAT((OnHand+OnOrder),'N0') TotalAvailable
,FORMAT(([Reorder Quantity]*NoOfBins)-(OnHand+OnOrder),'N0') QtyLacking
,CASE
	WHEN ([Reorder Quantity]*NoOfBins)-(OnHand+OnOrder) &gt; [Reorder Quantity] THEN 'RED'
END Red

FROM DASH_kanbanBins n 

LEFT JOIN S1 on n.partnumber = S1.PartNumber
LEFT JOIN S2 on n.partnumber = S2.PartNumber
LEFT JOIN NAV_Item k on n.partnumber = k.partnumber

WHERE (OnHand+OnOrder) &lt; ([Reorder Quantity]*(NoOfBins-1))

ORDER BY [Buyer Planner Code]
</CommandText>
        <rd:UseGenericDesigner>true</rd:UseGenericDesigner>
      </Query>
      <Fields>
        <Field Name="Buyer_Planner_Code">
          <DataField>Buyer Planner Code</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="PartNumber">
          <DataField>PartNumber</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="NoOfBins">
          <DataField>NoOfBins</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
        <Field Name="BinSize">
          <DataField>BinSize</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="DesiredLevel">
          <DataField>DesiredLevel</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="OnHand">
          <DataField>OnHand</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="OnOrder">
          <DataField>OnOrder</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="TotalAvailable">
          <DataField>TotalAvailable</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="QtyLacking">
          <DataField>QtyLacking</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Red">
          <DataField>Red</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
  </DataSets>
