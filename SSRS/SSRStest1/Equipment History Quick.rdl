  <AutoRefresh>0</AutoRefresh>
  <DataSources>
    <DataSource Name="Maintenance">
      <DataSourceReference>Maintenance</DataSourceReference>
      <rd:SecurityType>None</rd:SecurityType>
      <rd:DataSourceID>87d1fadb-f1d7-47d5-84de-3a301f13890d</rd:DataSourceID>
    </DataSource>
  </DataSources>
  <DataSets>
    <DataSet Name="DataSet1">
      <Query>
        <DataSourceName>Maintenance</DataSourceName>
        <QueryParameters>
          <QueryParameter Name="@EquipmentID">
            <Value>=Parameters!EquipmentID.Value</Value>
          </QueryParameter>
        </QueryParameters>
        <CommandText>select

h.EquipmentID IDe
,e.[DESCRIPTION]
,h.*



FROM Repair_History h

INNER JOIN Equipment e ON h.EquipmentUID = e.ID

WHERE e.EquipmentID = @EquipmentID</CommandText>
        <rd:UseGenericDesigner>true</rd:UseGenericDesigner>
      </Query>
      <Fields>
        <Field Name="IDe">
          <DataField>IDe</DataField>
          <rd:TypeName>System.String</rd:TypeName>
