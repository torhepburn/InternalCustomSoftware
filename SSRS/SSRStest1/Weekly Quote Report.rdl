<?xml version="1.0" encoding="utf-8"?>
<Report MustUnderstand="df" xmlns="http://schemas.microsoft.com/sqlserver/reporting/2016/01/reportdefinition" xmlns:rd="http://schemas.microsoft.com/SQLServer/reporting/reportdesigner" xmlns:df="http://schemas.microsoft.com/sqlserver/reporting/2016/01/reportdefinition/defaultfontfamily">
  <df:DefaultFontFamily>Segoe UI</df:DefaultFontFamily>
  <AutoRefresh>0</AutoRefresh>
  <DataSources>
    <DataSource Name="QuoteWerks">
      <ConnectionProperties>
        <DataProvider>SQL</DataProvider>
        <ConnectString>Data Source=CT-MID-AS37\SQLEXPRESS;Initial Catalog=quotewerks</ConnectString>
      </ConnectionProperties>
      <rd:SecurityType>DataBase</rd:SecurityType>
      <rd:DataSourceID>1844b81c-5e03-47c4-9ea8-01d209cd8216</rd:DataSourceID>
    </DataSource>
  </DataSources>
  <DataSets>
    <DataSet Name="DataSet1">
      <Query>
        <DataSourceName>QuoteWerks</DataSourceName>
        <CommandText>DECLARE @StartDate datetime
Declare @EndDate datetime


set @StartDate = (SELECT 

CASE DATEPART(dw, GETDATE())
	WHEN 1 THEN DATEADD(day, -7, GETDATE())
	WHEN 2 THEN DATEADD(day, -8, GETDATE())
	WHEN 3 THEN DATEADD(day, -9, GETDATE())
	WHEN 4 THEN DATEADD(day, -10, GETDATE())
	WHEN 5 THEN DATEADD(day, -11, GETDATE())
END)


set @EndDate = (select (dateadd(day, 7, @StartDate)))

select 

'Optics' "Type",
count(i.id) "Number of Quotes",
sum(unitprice * qtytotal) "Total Dollars"

from documentheaders h
 
left join documentitems i
 
on h.id = i.docid
 
where left(docno, 2) = 'OC'
 and
 lastmodified &gt;= @StartDate
  and
 lastmodified &lt; @EndDate
 
union

select 

'Profilers' "Type",
count(i.id) "Number of Quotes",
sum(unitprice * qtytotal) "Total Dollars"

from documentheaders h
 
left join documentitems i
 
on h.id = i.docid
 
where 

(left(manufacturerpartnumber, 3) ='08s'
 or
left(manufacturerpartnumber, 3) ='06s'
 or
left(manufacturerpartnumber, 2) ='63'
or
left(manufacturerpartnumber, 2) ='64')

and
lastmodified &gt;= @StartDate
and
lastmodified &lt; @EndDate
 
union

select 

'Large Aperature' "Type",
count(i.id) "Number of Quotes",
sum(unitprice * qtytotal) "Total Dollars"

from documentheaders h
 
left join documentitems i
 
on h.id = i.docid
 
where 

(left(manufacturerpartnumber, 4) ='6068'
 or
left(manufacturerpartnumber, 4) ='6024'
 or
left(manufacturerpartnumber, 2) ='65')

 and
lastmodified &gt;= @StartDate
  and
 lastmodified &lt; @EndDate
  
 union
 
 select 

'SER' "Type",
count(i.id) "Number of Quotes",
sum(unitprice * qtytotal) "Total Dollars"

from documentheaders h
 
left join documentitems i
 
on h.id = i.docid
 
where 

left(manufacturerpartnumber, 4) ='SER '

 and
lastmodified &gt;= @StartDate
  and
 lastmodified &lt; @EndDate
 
union

select 

'Other' "Type",
count(i.id) "Number of Quotes",
sum(unitprice * qtytotal) "Total Dollars"

from documentheaders h
 
left join documentitems i
 
on h.id = i.docid
 
where 

(left(manufacturerpartnumber, 4) !='6068'
 and
left(manufacturerpartnumber, 4) !='6024'
 and
left(manufacturerpartnumber, 2) !='65'
 and
left(manufacturerpartnumber, 3) !='08s'
 and
left(manufacturerpartnumber, 3) !='06s'
 and
left(manufacturerpartnumber, 2) !='63'
 and
left(manufacturerpartnumber, 2) !='64'
 and
left(docno, 2) != 'OC'
and
left(manufacturerpartnumber, 4) !='SER '
)

 and
 
lastmodified &gt;= @StartDate
  and
 lastmodified &lt; @EndDate
  
 and linetype = 1
 
 union

select 

'Total' "Type",
count(i.id) "Number of Quotes",
sum(unitprice * qtytotal) "Total Dollars"

from documentheaders h
 
left join documentitems i
 
on h.id = i.docid
 
where 

linetype = 1 and

lastmodified &gt;= @StartDate
  and
 lastmodified &lt; @EndDate</CommandText>
        <rd:UseGenericDesigner>true</rd:UseGenericDesigner>
      </Query>
