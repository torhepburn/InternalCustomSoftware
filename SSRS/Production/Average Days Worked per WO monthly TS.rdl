<?xml version="1.0" encoding="utf-8"?>
<Report xmlns="http://schemas.microsoft.com/sqlserver/reporting/2016/01/reportdefinition" xmlns:rd="http://schemas.microsoft.com/SQLServer/reporting/reportdesigner" xmlns:df="http://schemas.microsoft.com/sqlserver/reporting/2016/01/reportdefinition/defaultfontfamily" MustUnderstand="df">
  <df:DefaultFontFamily>Segoe UI</df:DefaultFontFamily>
  <AutoRefresh>0</AutoRefresh>
  <DataSources>
    <DataSource Name="NAV">
      <DataSourceReference>NAV</DataSourceReference>
      <rd:SecurityType>None</rd:SecurityType>
      <rd:DataSourceID>6d54727f-582c-4663-a6e4-9e27bb2124bf</rd:DataSourceID>
    </DataSource>
  </DataSources>
  <DataSets>
    <DataSet Name="DataSet1">
      <Query>
        <DataSourceName>NAV</DataSourceName>
        <CommandText>SELECT

[Item No_]
,AVG(DATEDIFF(dd,[Starting Date],[Ending Date])) mAvgDaysWorked
,COUNT([Item No_]) NumberOfWOs
,MONTH([Ending Date]) mm
,YEAR([Ending Date]) yy


FROM [ZYGO$Prod_ Order Line] WHERE [Item No_] like '6024-02%'
AND Status = 4 --finished

AND Quantity = [Finished Quantity]

GROUP BY [Item No_]
,YEAR([Ending Date])
,MONTH([Ending Date])

UNION ALL

SELECT

[Item No_]
,AVG(DATEDIFF(dd,[Starting Date],[Ending Date])) mAvg
,COUNT([Item No_]) mcount
,MONTH([Ending Date]) mm
,YEAR([Ending Date]) yy


FROM [ZYGO$Prod_ Order Line] WHERE [Item No_] like '6024-03%'
AND Status = 4 --finished

AND Quantity = [Finished Quantity]

GROUP BY [Item No_]
,YEAR([Ending Date])
,MONTH([Ending Date])

UNION ALL

SELECT

[Item No_]
,AVG(DATEDIFF(dd,[Starting Date],[Ending Date])) mAvg
,COUNT([Item No_]) mcount
,MONTH([Ending Date]) mm
,YEAR([Ending Date]) yy


FROM [ZYGO$Prod_ Order Line] WHERE [Item No_] like '6024-04%'
AND Status = 4 --finished

AND Quantity = [Finished Quantity]

GROUP BY [Item No_]
,YEAR([Ending Date])
,MONTH([Ending Date])

UNION ALL

SELECT

[Item No_]
,AVG(DATEDIFF(dd,[Starting Date],[Ending Date])) mAvg
,COUNT([Item No_]) mcount
,MONTH([Ending Date]) mm
,YEAR([Ending Date]) yy


FROM [ZYGO$Prod_ Order Line] WHERE [Item No_] like '6024-05%'
AND Status = 4 --finished

AND Quantity = [Finished Quantity]

GROUP BY [Item No_]
,YEAR([Ending Date])
,MONTH([Ending Date])

UNION ALL

SELECT

[Item No_]
,AVG(DATEDIFF(dd,[Starting Date],[Ending Date])) mAvg
,COUNT([Item No_]) mcount
,MONTH([Ending Date]) mm
,YEAR([Ending Date]) yy


FROM [ZYGO$Prod_ Order Line] WHERE [Item No_] like '6500-0112%'

AND Quantity = [Finished Quantity]

GROUP BY [Item No_]
,YEAR([Ending Date])
,MONTH([Ending Date])

UNION ALL

SELECT

[Item No_]
,AVG(DATEDIFF(dd,[Starting Date],[Ending Date])) mAvg
,COUNT([Item No_]) mcount
,MONTH([Ending Date]) mm
,YEAR([Ending Date]) yy


FROM [ZYGO$Prod_ Order Line] WHERE [Item No_] like '6500-0148%'

AND Quantity = [Finished Quantity]

GROUP BY [Item No_]
,YEAR([Ending Date])
,MONTH([Ending Date])

UNION ALL

SELECT

[Item No_]
,AVG(DATEDIFF(dd,[Starting Date],[Ending Date])) mAvg
,COUNT([Item No_]) mcount
,MONTH([Ending Date]) mm
,YEAR([Ending Date]) yy


FROM [ZYGO$Prod_ Order Line] WHERE [Item No_] like '6500-0164%'

AND Quantity = [Finished Quantity]

GROUP BY [Item No_]
,YEAR([Ending Date])
,MONTH([Ending Date])

UNION ALL

SELECT

[Item No_]
,AVG(DATEDIFF(dd,[Starting Date],[Ending Date])) mAvg
,COUNT([Item No_]) mcount
,MONTH([Ending Date]) mm
,YEAR([Ending Date]) yy


FROM [ZYGO$Prod_ Order Line] WHERE [Item No_] like '6500-0324%'

AND Quantity = [Finished Quantity]

GROUP BY [Item No_]
,YEAR([Ending Date])
,MONTH([Ending Date])

ORDER BY [Item No_]
,YEAR([Ending Date])
,MONTH([Ending Date])</CommandText>
        <rd:UseGenericDesigner>true</rd:UseGenericDesigner>
      </Query>
