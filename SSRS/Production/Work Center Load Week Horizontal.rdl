    <DataSet Name="DataSet2">
      <Query>
        <DataSourceName>NAV_TEST</DataSourceName>
        <CommandText>select No_ from [ZYGO$Machine Center]

UNION ALL

SELECT No_ FROM [ZYGO$Work Center]

ORDER BY No_</CommandText>
      </Query>
      <Fields>
        <Field Name="No_">
          <DataField>No_</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
