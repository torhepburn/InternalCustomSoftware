      <Query>
        <DataSourceName>NAV</DataSourceName>
        <CommandText>select

[Routing No_]
,[Work Center No_]
,[Operation No_]
,[Description]

FROM [ZYGO$Routing Line]

WHERE [Work Center No_] = '314'</CommandText>
