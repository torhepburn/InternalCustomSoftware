  <DataSets>
    <DataSet Name="DataSet1">
      <Query>
        <DataSourceName>DataSource1</DataSourceName>
        <QueryParameters>
          <QueryParameter Name="@DocumentNumber">
            <Value>=Parameters!DocumentNumber.Value</Value>
            <rd:UserDefined>true</rd:UserDefined>
          </QueryParameter>
          <QueryParameter Name="@Revision">
            <Value>=Parameters!Revision.Value</Value>
            <rd:UserDefined>true</rd:UserDefined>
          </QueryParameter>
        </QueryParameters>
        <CommandText>SELECT

documentnumber
,pldescription
,revision
,item_code
,description
,quantity
,boxes
,installon
,kitwith

FROM labels_packinglists

WHERE DocumentNumber = @DocumentNumber

AND Revision = @Revision</CommandText>
        <rd:UseGenericDesigner>true</rd:UseGenericDesigner>
      </Query>
