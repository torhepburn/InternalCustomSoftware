<Report MustUnderstand="df" xmlns="http://schemas.microsoft.com/sqlserver/reporting/2016/01/reportdefinition" xmlns:rd="http://schemas.microsoft.com/SQLServer/reporting/reportdesigner" xmlns:df="http://schemas.microsoft.com/sqlserver/reporting/2016/01/reportdefinition/defaultfontfamily">
  <df:DefaultFontFamily>Segoe UI</df:DefaultFontFamily>
  <AutoRefresh>0</AutoRefresh>
  <DataSources>
    <DataSource Name="NAV">
      <DataSourceReference>NAV</DataSourceReference>
      <rd:SecurityType>None</rd:SecurityType>
      <rd:DataSourceID>dfc4d0a5-c0e2-49ff-9f28-ef60db39fdfd</rd:DataSourceID>
    </DataSource>
  </DataSources>
  <DataSets>
    <DataSet Name="DataSet1">
      <Query>
        <DataSourceName>NAV</DataSourceName>
        <CommandText>select 

 No_
 ,[Source No_]
 ,Description
,[Due Date]
,[Last Date Modified]
,CASE	Status
	WHEN 2 THEN 'Firm Planned'
	WHEN 3 THEN 'Released'
	WHEN 4 THEn 'Finished'
END [Status]


from [ZYGO$Production Order]

WHERE [Source No_] IN

(
	select distinct [Source No_]

	FROM [ZYGO$Production Order]

	WHERE [Assigned User ID] IN ('AMETEK-AD\DWOOLLEY','AMETEK-AD\LPEREZ')

	AND [Location Code] = 'MID'

	AND [Source No_] IN (SELECT No_ FROM ZYGO$Item where [Standard Cost]&gt; 0)
)

AND [Source No_] IN (select [Item No_] from [ZYGO$Planning Component])

AND Status = 4

ORDER BY [Last Date Modified] DESC</CommandText>
        <rd:UseGenericDesigner>true</rd:UseGenericDesigner>
      </Query>
      <Fields>
        <Field Name="No_">
          <DataField>No_</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Source_No_">
          <DataField>Source No_</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Description">
          <DataField>Description</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Due_Date">
          <DataField>Due Date</DataField>
          <rd:TypeName>System.DateTime</rd:TypeName>
        </Field>
        <Field Name="Last_Date_Modified">
          <DataField>Last Date Modified</DataField>
          <rd:TypeName>System.DateTime</rd:TypeName>
        </Field>
        <Field Name="Status">
          <DataField>Status</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
  </DataSets>
