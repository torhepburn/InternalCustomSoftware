<?xml version="1.0" encoding="utf-8"?>
<Report MustUnderstand="df" xmlns="http://schemas.microsoft.com/sqlserver/reporting/2016/01/reportdefinition" xmlns:rd="http://schemas.microsoft.com/SQLServer/reporting/reportdesigner" xmlns:df="http://schemas.microsoft.com/sqlserver/reporting/2016/01/reportdefinition/defaultfontfamily">
  <df:DefaultFontFamily>Segoe UI</df:DefaultFontFamily>
  <AutoRefresh>0</AutoRefresh>
  <DataSources>
    <DataSource Name="DataSource1">
      <DataSourceReference>DataSource1</DataSourceReference>
      <rd:SecurityType>DataBase</rd:SecurityType>
      <rd:DataSourceID>748026b2-8c96-48fe-b3f8-ee6660cecb35</rd:DataSourceID>
    </DataSource>
    <DataSource Name="NAV">
      <DataSourceReference>NAV</DataSourceReference>
      <rd:SecurityType>DataBase</rd:SecurityType>
      <rd:DataSourceID>9dd431e6-0eb8-4f18-9d63-91d3cc784dc0</rd:DataSourceID>
    </DataSource>
  </DataSources>
  <DataSets>
    <DataSet Name="DataSet1">
      <Query>
        <DataSourceName>NAV</DataSourceName>
        <CommandText>SELECT

l.[Item No_]
,SUM(l.Quantity) Qty
,COUNT(l.[Document No_]) WorkOrderCount
,DATEPART(YEAR, [Posting Date]) Year
,DATEPART(WEEK, [Posting Date]) WeekNumber

FROM 

[ZYGO$Item Ledger Entry] l INNER JOIN 

[ZYGO$Item] i ON l.[Item No_] = i.No_

where [Product Types] like '%SPH%'

AND [Entry Type] = 6

--AND [Posting Date] &gt; GETDATE()-7

GROUP BY [Item No_],DATEPART(YEAR, [Posting Date]) ,DATEPART(WEEK, [Posting Date])

ORDER BY [Item No_]</CommandText>
        <rd:UseGenericDesigner>true</rd:UseGenericDesigner>
      </Query>
      <Fields>
        <Field Name="Item_No_">
          <DataField>Item No_</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Qty">
          <DataField>Qty</DataField>
          <rd:TypeName>System.Decimal</rd:TypeName>
        </Field>
        <Field Name="WorkOrderCount">
          <DataField>WorkOrderCount</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
        <Field Name="Year">
          <DataField>Year</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
        <Field Name="WeekNumber">
          <DataField>WeekNumber</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
  </DataSets>
