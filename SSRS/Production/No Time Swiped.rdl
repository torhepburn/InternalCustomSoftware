        <DataProvider>SQL</DataProvider>
        <ConnectString>Data Source=CT-MID-SQL11;Initial Catalog=AccessFrontEnds</ConnectString>
      </ConnectionProperties>
      <rd:SecurityType>DataBase</rd:SecurityType>
      <rd:DataSourceID>7a2c39c5-7956-42c9-aa6f-34f99c17b0b0</rd:DataSourceID>
    </DataSource>
  </DataSources>
  <DataSets>
    <DataSet Name="DataSet1">
      <Query>
        <DataSourceName>AFE</DataSourceName>
        <CommandText>SELECT

OrderNo
,Operation
,workcenter
,workcenterdescription
,item
,itemdescription
,starttime
,p.name


FROM [MIDDB01.ZYGO.COM].dashboard.dbo.timecardnavprodhours t

INNER JOIN [MIDDB01.ZYGO.COM].dashboard.dbo.person p on t.userID = p.userid

WHERE CAST(StartTime as date) = CAST(GETDATE()as date)


--AND StartTime &lt; '2023-11-09'

AND Starttime = endtime

AND Workcenter not like 'R%'

order by name</CommandText>
        <rd:UseGenericDesigner>true</rd:UseGenericDesigner>
      </Query>
      <Fields>
        <Field Name="OrderNo">
          <DataField>OrderNo</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Operation">
          <DataField>Operation</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="workcenter">
