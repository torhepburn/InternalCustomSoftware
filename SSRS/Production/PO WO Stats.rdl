<?xml version="1.0" encoding="utf-8"?>
<Report MustUnderstand="df" xmlns="http://schemas.microsoft.com/sqlserver/reporting/2016/01/reportdefinition" xmlns:rd="http://schemas.microsoft.com/SQLServer/reporting/reportdesigner" xmlns:df="http://schemas.microsoft.com/sqlserver/reporting/2016/01/reportdefinition/defaultfontfamily">
  <df:DefaultFontFamily>Segoe UI</df:DefaultFontFamily>
  <AutoRefresh>0</AutoRefresh>
  <DataSources>
    <DataSource Name="NAV">
      <DataSourceReference>NAV</DataSourceReference>
      <rd:SecurityType>None</rd:SecurityType>
      <rd:DataSourceID>e3d136f5-cfd3-4f29-b036-a80132e61a67</rd:DataSourceID>
    </DataSource>
  </DataSources>
  <DataSets>
    <DataSet Name="DataSet1">
      <Query>
        <DataSourceName>NAV</DataSourceName>
        <CommandText>WITH s1a AS  /*	get one line production orders	*/
(
select

[Prod_ Order No_]
,[Routing No_]
,[Operation No_]
, No_
,Description
,[Run Time]

from [ZYGO$Prod_ Order Routing Line] 

WHERE [Prod_ Order No_] IN

	(
	SELECT [No_] from [ZYGO$Production Order] 

	WHERE 

	[Status] = 3	/*	released	*/

	AND [Shortcut Dimension 2 Code] IN ('PO VALUE STREAM')
	)

	AND [Routing Reference No_] = 10000
)
,s1b AS		/*	two line production orders use dummy number for production steps - need to show this number		*/
(
select

[Prod_ Order No_]
,[Routing No_]
,[Operation No_]
, No_
,Description
,[Run Time]

from [ZYGO$Prod_ Order Routing Line] 

WHERE [Prod_ Order No_] IN

	(
	SELECT [No_] from [ZYGO$Production Order] 

	WHERE 

	[Status] = 3	/*	released	*/

	AND [Shortcut Dimension 2 Code] IN ('PO VALUE STREAM')
	)

	AND [Routing Reference No_] = 20000
)

,s1 AS
(
	SELECT * from s1a

	UNION ALL

	SELECT * from s1b
)
,s2 AS		/*	total time charged and last date posted per operation	*/
(
	SELECT

	SUM(Quantity) Timecharged
	,MAX([Posting Date]) LastDatePosted
	,[Document No_]
	,[Operation No_]

	FROM [ZYGO$Capacity Ledger Entry]

	WHERE [Document No_] IN

	(
	SELECT [No_] from [ZYGO$Production Order] 

	WHERE 

	[Status] = 3	/*	released	*/

	AND [Shortcut Dimension 2 Code] IN ('PO VALUE STREAM')
	)

	GROUP BY [Document No_],[Operation No_]
)
, s3 AS
(
select		/*	last date posted per WO to be able to get last operation worked on	*/

[Document No_]
,Max(LastDatePosted) LastDatePosted

from s2

GROUP BY [Document No_]
)
,s4 AS		/*	match last date posted to last operation per document	*/
(
select

s2.*

FROM s2

INNER JOIN s3 ON s2.LastDatePosted = s3.LastDatePosted

AND s2.[Document No_] = s3.[Document No_]
)
, s5 AS		/*	as some operations complete on the same day need to get top operation	*/
(
select

MAX([Operation No_]) OperationNo
,[Document No_]

FROM s4

GROUP By [Document No_]
)
,s6 AS
(
select 

s1.[Run Time]
,s4.*

,s1.No_
,s1.Description
,d.[Due Date]
,DATEDIFF(DAY,s4.LastDatePosted, CAST(GETDATE() as date)) DaysSinceLastPosting
,s1.[Routing No_] ItemNo
,d.Description ItemDescription

FROM s4

INNER JOIN s5 ON s5.OperationNo = s4.[Operation No_] and s5.[Document No_] = s4.[Document No_]

INNER JOIN s1 ON s1.[Operation No_] = s4.[Operation No_] and s1.[Prod_ Order No_] = s4.[Document No_]

INNER JOIN [ZYGO$Production Order] d ON s4.[Document No_] = d.No_
)
, s7 AS
(
select

COUNT([Document No_]) Qty
,[Operation No_]
,Description
,No_


FROM s6

GROUP BY 

[Operation No_]
,Description
,No_
)
,s8 AS
(
select

MAX(DaysSinceLastPosting) maxDays 
,[Operation No_]
, Description
,No_

FROM s6

GROUP BY

[Operation No_]
,Description
,No_

)

SELECT

s7.*
,s8.maxDays

FROM s7

LEFT JOIN s8 ON s7.[Operation No_] = s8.[Operation No_] and s7.No_ = s8.No_

ORDER BY

No_
,[Operation No_]


--select * from s1</CommandText>
        <rd:UseGenericDesigner>true</rd:UseGenericDesigner>
      </Query>
      <Fields>
        <Field Name="Qty">
          <DataField>Qty</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
        <Field Name="Operation_No_">
          <DataField>Operation No_</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Description">
          <DataField>Description</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="No_">
          <DataField>No_</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="maxDays">
          <DataField>maxDays</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
  </DataSets>
