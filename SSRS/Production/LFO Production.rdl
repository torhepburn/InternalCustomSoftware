    <DataSet Name="DataSet1">
      <Query>
        <DataSourceName>NAV</DataSourceName>
        <CommandText>--DECLARE @c1 nchar(20)

--Select top 1 @c1 =  [Operation No_] FROM [ZYGO$Prod_ Order Routing Line] 

--where [Prod_ Order No_] = 'PD512072'

WITH s1 AS
(

select 

[Prod_ Order No_]
,'Due' [Status]
,max(COALESCE(case WHEN [Operation No_]='1000' THEN CONVERT(nchar(10),[Ending Date-Time] ,1) end,'')) '1000'
,max(COALESCE(case WHEN [Operation No_]='1050' THEN CONVERT(nchar(10),[Ending Date-Time] ,1) end,'')) '1050'
,max(COALESCE(case WHEN [Operation No_]='1052' THEN CONVERT(nchar(10),[Ending Date-Time] ,1) end,'')) '1052'
,max(COALESCE(case WHEN [Operation No_]='1053' THEN CONVERT(nchar(10),[Ending Date-Time] ,1) end,'')) '1054'
,max(COALESCE(case WHEN [Operation No_]='1054' THEN CONVERT(nchar(10),[Ending Date-Time] ,1) end,'')) '1055'
,max(COALESCE(case WHEN [Operation No_]='1060' THEN CONVERT(nchar(10),[Ending Date-Time] ,1) end,'')) '1060'
,max(COALESCE(case WHEN [Operation No_]='1065' THEN CONVERT(nchar(10),[Ending Date-Time] ,1) end,'')) '1065'
,max(COALESCE(case WHEN [Operation No_]='1067' THEN CONVERT(nchar(10),[Ending Date-Time] ,1) end,'')) '1067'
,max(COALESCE(case WHEN [Operation No_]='1080' THEN CONVERT(nchar(10),[Ending Date-Time] ,1) end,'')) '1080'
,max(COALESCE(case WHEN [Operation No_]='1085' THEN CONVERT(nchar(10),[Ending Date-Time] ,1) end,'')) '1085'
,max(COALESCE(case WHEN [Operation No_]='1087' THEN CONVERT(nchar(10),[Ending Date-Time] ,1) end,'')) '1087'
,max(COALESCE(case WHEN [Operation No_]='1090' THEN CONVERT(nchar(10),[Ending Date-Time] ,1) end,'')) '1090'
,max(COALESCE(case WHEN [Operation No_]='1095' THEN CONVERT(nchar(10),[Ending Date-Time] ,1) end,'')) '1095'
,max(COALESCE(case WHEN [Operation No_]='1097' THEN CONVERT(nchar(10),[Ending Date-Time] ,1) end,'')) '1097'
,max(COALESCE(case WHEN [Operation No_]='1100' THEN CONVERT(nchar(10),[Ending Date-Time] ,1) end,'')) '1100'
,max(COALESCE(case WHEN [Operation No_]='1105' THEN CONVERT(nchar(10),[Ending Date-Time] ,1) end,'')) '1105'
,max(COALESCE(case WHEN [Operation No_]='1120' THEN CONVERT(nchar(10),[Ending Date-Time] ,1) end,'')) '1120'

,max(COALESCE(case WHEN [Operation No_]='1130' THEN CONVERT(nchar(10),[Ending Date-Time] ,1) end,'')) '1130'

,max(COALESCE(case WHEN [Operation No_]='1140' THEN CONVERT(nchar(10),[Ending Date-Time] ,1) end,'')) '1140'
,max(COALESCE(case WHEN [Operation No_]='1143' THEN CONVERT(nchar(10),[Ending Date-Time] ,1) end,'')) '1143'
,max(COALESCE(case WHEN [Operation No_]='1144' THEN CONVERT(nchar(10),[Ending Date-Time] ,1) end,'')) '1144'
,max(COALESCE(case WHEN [Operation No_]='1145' THEN CONVERT(nchar(10),[Ending Date-Time] ,1) end,'')) '1145'
,max(COALESCE(case WHEN [Operation No_]='1150' THEN CONVERT(nchar(10),[Ending Date-Time] ,1) end,'')) '1150'
,max(COALESCE(case WHEN [Operation No_]='1165' THEN CONVERT(nchar(10),[Ending Date-Time] ,1) end,'')) '1165'
,max(COALESCE(case WHEN [Operation No_]='1166' THEN CONVERT(nchar(10),[Ending Date-Time] ,1) end,'')) '1166'
,max(COALESCE(case WHEN [Operation No_]='1167' THEN CONVERT(nchar(10),[Ending Date-Time] ,1) end,'')) '1167'
,max(COALESCE(case WHEN [Operation No_]='1168' THEN CONVERT(nchar(10),[Ending Date-Time] ,1) end,'')) '1168'
,max(COALESCE(case WHEN [Operation No_]='1169' THEN CONVERT(nchar(10),[Ending Date-Time] ,1) end,'')) '1169'

,max(COALESCE(case WHEN [Operation No_]='1170' THEN CONVERT(nchar(10),[Ending Date-Time] ,1) end,'')) '1170'
,max(COALESCE(case WHEN [Operation No_]='1172' THEN CONVERT(nchar(10),[Ending Date-Time] ,1) end,'')) '1172'
,max(COALESCE(case WHEN [Operation No_]='1174' THEN CONVERT(nchar(10),[Ending Date-Time] ,1) end,'')) '1174'
,max(COALESCE(case WHEN [Operation No_]='1176' THEN CONVERT(nchar(10),[Ending Date-Time] ,1) end,'')) '1176'
,max(COALESCE(case WHEN [Operation No_]='1200' THEN CONVERT(nchar(10),[Ending Date-Time] ,1) end,'')) '1200'
,max(COALESCE(case WHEN [Operation No_]='1205' THEN CONVERT(nchar(10),[Ending Date-Time] ,1) end,'')) '1205'
,max(COALESCE(case WHEN [Operation No_]='1210' THEN CONVERT(nchar(10),[Ending Date-Time] ,1) end,'')) '1210'
,max(COALESCE(case WHEN [Operation No_]='1215' THEN CONVERT(nchar(10),[Ending Date-Time] ,1) end,'')) '1215'
,max(COALESCE(case WHEN [Operation No_]='1218' THEN CONVERT(nchar(10),[Ending Date-Time] ,1) end,'')) '1218'
,max(COALESCE(case WHEN [Operation No_]='1220' THEN CONVERT(nchar(10),[Ending Date-Time] ,1) end,'')) '1220'

,max(COALESCE(case WHEN [Operation No_]='1246' THEN CONVERT(nchar(10),[Ending Date-Time] ,1) end,'')) '1246'
,max(COALESCE(case WHEN [Operation No_]='1248' THEN CONVERT(nchar(10),[Ending Date-Time] ,1) end,'')) '1248'
,max(COALESCE(case WHEN [Operation No_]='1250' THEN CONVERT(nchar(10),[Ending Date-Time] ,1) end,'')) '1250'


--,[Operation No_]
--,1 RRw

FROM [ZYGO$Prod_ Order Routing Line] 

where Status = 3

AND [Routing No_] = 'LL-AAA08-105746'

--[Prod_ Order No_] = 'PD512072'

GROUP BY [Prod_ Order No_]
)
, s2 AS
(
	SELECT 

	--MAX(CAST([Posting Date] as date)) ActualDate
	/*"CONVERT(nvarchar(10), DueDate, 101) DueDate, " +*/
	[Document No_]
	,'Actual' [Status]
	,max(COALESCE(case WHEN [Operation No_]='1000' THEN CONVERT(nchar(10),[Posting Date] ,1) end,'')) '1000'
	,max(COALESCE(case WHEN [Operation No_]='1050' THEN CONVERT(nchar(10),[Posting Date] ,1) end,'')) '1050'
	,max(COALESCE(case WHEN [Operation No_]='1052' THEN CONVERT(nchar(10),[Posting Date] ,1) end,'')) '1052'
	,max(COALESCE(case WHEN [Operation No_]='1053' THEN CONVERT(nchar(10),[Posting Date] ,1) end,'')) '1054'
	,max(COALESCE(case WHEN [Operation No_]='1054' THEN CONVERT(nchar(10),[Posting Date] ,1) end,'')) '1055'
	,max(COALESCE(case WHEN [Operation No_]='1060' THEN CONVERT(nchar(10),[Posting Date] ,1) end,'')) '1060'
	,max(COALESCE(case WHEN [Operation No_]='1065' THEN CONVERT(nchar(10),[Posting Date] ,1) end,'')) '1065'
	,max(COALESCE(case WHEN [Operation No_]='1067' THEN CONVERT(nchar(10),[Posting Date] ,1) end,'')) '1067'
	,max(COALESCE(case WHEN [Operation No_]='1080' THEN CONVERT(nchar(10),[Posting Date] ,1) end,'')) '1080'
	,max(COALESCE(case WHEN [Operation No_]='1085' THEN CONVERT(nchar(10),[Posting Date] ,1) end,'')) '1085'
	,max(COALESCE(case WHEN [Operation No_]='1087' THEN CONVERT(nchar(10),[Posting Date] ,1) end,'')) '1087'
	,max(COALESCE(case WHEN [Operation No_]='1090' THEN CONVERT(nchar(10),[Posting Date] ,1) end,'')) '1090'
	,max(COALESCE(case WHEN [Operation No_]='1095' THEN CONVERT(nchar(10),[Posting Date] ,1) end,'')) '1095'
	,max(COALESCE(case WHEN [Operation No_]='1097' THEN CONVERT(nchar(10),[Posting Date] ,1) end,'')) '1097'
	,max(COALESCE(case WHEN [Operation No_]='1100' THEN CONVERT(nchar(10),[Posting Date] ,1) end,'')) '1100'
	,max(COALESCE(case WHEN [Operation No_]='1105' THEN CONVERT(nchar(10),[Posting Date] ,1) end,'')) '1105'
	,max(COALESCE(case WHEN [Operation No_]='1120' THEN CONVERT(nchar(10),[Posting Date] ,1) end,'')) '1120'

	,max(COALESCE(case WHEN [Operation No_]='1130' THEN CONVERT(nchar(10),[Posting Date] ,1) end,'')) '1130'

	,max(COALESCE(case WHEN [Operation No_]='1140' THEN CONVERT(nchar(10),[Posting Date] ,1) end,'')) '1140'
	,max(COALESCE(case WHEN [Operation No_]='1143' THEN CONVERT(nchar(10),[Posting Date] ,1) end,'')) '1143'
	,max(COALESCE(case WHEN [Operation No_]='1144' THEN CONVERT(nchar(10),[Posting Date] ,1) end,'')) '1144'
	,max(COALESCE(case WHEN [Operation No_]='1145' THEN CONVERT(nchar(10),[Posting Date] ,1) end,'')) '1145'
	,max(COALESCE(case WHEN [Operation No_]='1150' THEN CONVERT(nchar(10),[Posting Date] ,1) end,'')) '1150'
	,max(COALESCE(case WHEN [Operation No_]='1165' THEN CONVERT(nchar(10),[Posting Date] ,1) end,'')) '1165'
	,max(COALESCE(case WHEN [Operation No_]='1166' THEN CONVERT(nchar(10),[Posting Date] ,1) end,'')) '1166'
	,max(COALESCE(case WHEN [Operation No_]='1167' THEN CONVERT(nchar(10),[Posting Date] ,1) end,'')) '1167'
	,max(COALESCE(case WHEN [Operation No_]='1168' THEN CONVERT(nchar(10),[Posting Date] ,1) end,'')) '1168'
	,max(COALESCE(case WHEN [Operation No_]='1169' THEN CONVERT(nchar(10),[Posting Date] ,1) end,'')) '1169'

	,max(COALESCE(case WHEN [Operation No_]='1170' THEN CONVERT(nchar(10),[Posting Date] ,1) end,'')) '1170'
	,max(COALESCE(case WHEN [Operation No_]='1172' THEN CONVERT(nchar(10),[Posting Date] ,1) end,'')) '1172'
	,max(COALESCE(case WHEN [Operation No_]='1174' THEN CONVERT(nchar(10),[Posting Date] ,1) end,'')) '1174'
	,max(COALESCE(case WHEN [Operation No_]='1176' THEN CONVERT(nchar(10),[Posting Date] ,1) end,'')) '1176'
	,max(COALESCE(case WHEN [Operation No_]='1200' THEN CONVERT(nchar(10),[Posting Date] ,1) end,'')) '1200'
	,max(COALESCE(case WHEN [Operation No_]='1205' THEN CONVERT(nchar(10),[Posting Date] ,1) end,'')) '1205'
	,max(COALESCE(case WHEN [Operation No_]='1210' THEN CONVERT(nchar(10),[Posting Date] ,1) end,'')) '1210'
	,max(COALESCE(case WHEN [Operation No_]='1215' THEN CONVERT(nchar(10),[Posting Date] ,1) end,'')) '1215'
	,max(COALESCE(case WHEN [Operation No_]='1218' THEN CONVERT(nchar(10),[Posting Date] ,1) end,'')) '1218'
	,max(COALESCE(case WHEN [Operation No_]='1220' THEN CONVERT(nchar(10),[Posting Date] ,1) end,'')) '1220'

	,max(COALESCE(case WHEN [Operation No_]='1246' THEN CONVERT(nchar(10),[Posting Date] ,1) end,'')) '1246'
	,max(COALESCE(case WHEN [Operation No_]='1248' THEN CONVERT(nchar(10),[Posting Date] ,1) end,'')) '1248'
	,max(COALESCE(case WHEN [Operation No_]='1250' THEN CONVERT(nchar(10),[Posting Date] ,1) end,'')) '1250'


	FROM [ZYGO$Capacity Ledger Entry]  c

	INNER JOIN [ZYGO$Production Order] o ON c.[Document No_] = o.[No_]

	WHERE

	c.[Item No_] = 'LL-AAA08-105746'

	AND o.Status = 3

	GROUP BY 
	
	[Document No_]
	--,[Operation No_]
)
, s3 AS
(
	SELECT 

	MAX([Operation No_]) MaxOp
	,[Document No_]
	

	FROM [ZYGO$Capacity Ledger Entry]  c

	INNER JOIN [ZYGO$Production Order] o ON c.[Document No_] = o.[No_]

	WHERE

	c.[Item No_] = 'LL-AAA08-105746'

	AND o.Status = 3
	
	GROUP BY 
	
	[Document No_]
	

)

select * from s1

--WHERE [Prod_ Order No_] = 'PD512072'

UNION ALL

select * from s2

order by [Prod_ Order No_], [Status] desc

--WHERE [Document No_] = 'PD512072'



--select * from s3 WHERE [Document No_] = 'PD512072'</CommandText>
