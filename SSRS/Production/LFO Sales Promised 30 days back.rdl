<?xml version="1.0" encoding="utf-8"?>
<Report MustUnderstand="df" xmlns="http://schemas.microsoft.com/sqlserver/reporting/2016/01/reportdefinition" xmlns:rd="http://schemas.microsoft.com/SQLServer/reporting/reportdesigner" xmlns:df="http://schemas.microsoft.com/sqlserver/reporting/2016/01/reportdefinition/defaultfontfamily">
  <df:DefaultFontFamily>Segoe UI</df:DefaultFontFamily>
  <AutoRefresh>0</AutoRefresh>
  <DataSources>
    <DataSource Name="NAV">
      <DataSourceReference>NAV</DataSourceReference>
      <rd:SecurityType>None</rd:SecurityType>
      <rd:DataSourceID>1d81e086-ebe7-4a98-b959-f8c1c99db519</rd:DataSourceID>
    </DataSource>
  </DataSources>
  <DataSets>
    <DataSet Name="DataSet1">
      <Query>
        <DataSourceName>NAV</DataSourceName>
        <CommandText>select


No_
,[Document No_]
,[SO Line No_]
,[Promised Delivery Date]
,[Orig_ Promised Delivery Date]


from [ZYGO$Sales Line]


WHERE 1=1  --[Document No_] = '8724'

AND [No_] IN

(
		 'CEA-F710483-3-IMP-B'
		,'CEA-F712PD17TO0483-3'
		,'CEA-F712PD17TO0482-3'
		,'CEA-F712PD17TO0476-3'
		,'LL-AAA08-105746'
)

AND [Orig_ Promised Delivery Date] &gt;= CAST(DATEADD(dd,-30,GETDATE()) AS date)

ORDER BY [Promised Delivery Date]</CommandText>
        <rd:UseGenericDesigner>true</rd:UseGenericDesigner>
      </Query>
      <Fields>
        <Field Name="No_">
          <DataField>No_</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Document_No_">
          <DataField>Document No_</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="SO_Line_No_">
          <DataField>SO Line No_</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
        <Field Name="Promised_Delivery_Date">
          <DataField>Promised Delivery Date</DataField>
          <rd:TypeName>System.DateTime</rd:TypeName>
        </Field>
        <Field Name="Orig__Promised_Delivery_Date">
          <DataField>Orig_ Promised Delivery Date</DataField>
          <rd:TypeName>System.DateTime</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
