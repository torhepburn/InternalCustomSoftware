  <DataSets>
    <DataSet Name="DataSet1">
      <Query>
        <DataSourceName>AFE</DataSourceName>
        <CommandText>SELECT [Utilization]
      ,[sumHoursWorked]
      ,[sumDashHoursCharged]
      ,[AMETEK_ID]
      ,[Name]
      ,[SortDate]
      ,[nYear]
      ,[nMonth]
      ,[MonthName]
      ,[department]
      ,[BusinessSegment]
      ,[cn]
  FROM [AccessFrontEnds].[dbo].[DirectLaborUtilizationZygoIndividual]

  WHERE BusinessSegment = 'MFO'</CommandText>
        <rd:UseGenericDesigner>true</rd:UseGenericDesigner>
      </Query>
      <Fields>
        <Field Name="Utilization">
          <DataField>Utilization</DataField>
          <rd:TypeName>System.Double</rd:TypeName>
