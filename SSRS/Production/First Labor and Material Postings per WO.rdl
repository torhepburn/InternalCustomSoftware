<?xml version="1.0" encoding="utf-8"?>
<Report MustUnderstand="df" xmlns="http://schemas.microsoft.com/sqlserver/reporting/2016/01/reportdefinition" xmlns:rd="http://schemas.microsoft.com/SQLServer/reporting/reportdesigner" xmlns:df="http://schemas.microsoft.com/sqlserver/reporting/2016/01/reportdefinition/defaultfontfamily">
  <df:DefaultFontFamily>Segoe UI</df:DefaultFontFamily>
  <AutoRefresh>0</AutoRefresh>
  <DataSources>
    <DataSource Name="NAV">
      <DataSourceReference>NAV</DataSourceReference>
      <rd:SecurityType>None</rd:SecurityType>
      <rd:DataSourceID>ee406245-5182-4917-a87e-7dc28251847b</rd:DataSourceID>
    </DataSource>
  </DataSources>
  <DataSets>
    <DataSet Name="DataSet1">
      <Query>
        <DataSourceName>NAV</DataSourceName>
        <QueryParameters>
          <QueryParameter Name="@planner">
            <Value>=Parameters!planner.Value</Value>
          </QueryParameter>
          <QueryParameter Name="@start">
            <Value>=Parameters!StartingDate.Value</Value>
            <rd:UserDefined>true</rd:UserDefined>
          </QueryParameter>
          <QueryParameter Name="@end">
            <Value>=Parameters!EndingDate.Value</Value>
            <rd:UserDefined>true</rd:UserDefined>
          </QueryParameter>
          <QueryParameter Name="@workorder">
            <Value>=Parameters!WO.Value</Value>
            <rd:UserDefined>true</rd:UserDefined>
          </QueryParameter>
        </QueryParameters>
        <CommandText>WITH s1 AS	/*first labor posting		*/
(
select 

[Document No_]
,MIN([Posting Date]) FirstLaborPosting

FROM [ZYGO$Capacity Ledger Entry]

WHERE [Setup Time] &gt; 0

--AND [Global Dimension 2 Code] IN ('PO VALUE STREAM','LFO VALUE STREAM')

GROUP BY [Document No_]
)
,s2 AS
(
select 

[Document No_]
,MIN([Posting Date]) FirstMaterialIssue


FROM [ZYGO$Item Ledger Entry]

where [Entry Type] = 5   /*	consumption	*/

AND [Order Type] = 1	/*	production	*/

--AND [Global Dimension 2 Code] IN ('PO VALUE STREAM','LFO VALUE STREAM')

GROUP BY [Document No_]
)
,s3 AS
(
select 

s1.*
,COALESCE(s2.FirstMaterialIssue,'') FirstMaterialIssue

from s1 left join s2 on s1.[Document No_] = s2.[Document No_]
)

select 

s3.*
, p.[Source No_] 
,CASE p.[Status]
	WHEN 4 THEN 'Released'
	WHEN 3 THEN 'Firm Planned'
END Status
,p.[Quantity]
,p.[Buyer Planner Code]

from s3

INNER JOIN [ZYGO$Production Order] p ON s3.[Document No_] = p.No_

WHERE p.Status = 4

AND ([Buyer Planner Code] in (UPPER(@planner)) or @planner is null)

AND ([Document No_] in (@workorder) or @workorder is null)

AND( (FirstLaborPosting &gt; @start and FirstLaborPosting &lt; @end)

AND (FirstMaterialIssue &gt; @start and FirstMaterialIssue &lt; @end))</CommandText>
        <rd:UseGenericDesigner>true</rd:UseGenericDesigner>
      </Query>
      <Fields>
        <Field Name="Document_No_">
          <DataField>Document No_</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="FirstLaborPosting">
          <DataField>FirstLaborPosting</DataField>
          <rd:TypeName>System.DateTime</rd:TypeName>
        </Field>
        <Field Name="FirstMaterialIssue">
          <DataField>FirstMaterialIssue</DataField>
          <rd:TypeName>System.DateTime</rd:TypeName>
        </Field>
        <Field Name="Source_No_">
          <DataField>Source No_</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Status">
          <DataField>Status</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Quantity">
          <DataField>Quantity</DataField>
          <rd:TypeName>System.Decimal</rd:TypeName>
        </Field>
        <Field Name="Buyer_Planner_Code">
          <DataField>Buyer Planner Code</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
  </DataSets>
