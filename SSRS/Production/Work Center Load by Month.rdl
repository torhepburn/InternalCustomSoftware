<?xml version="1.0" encoding="utf-8"?>
<Report MustUnderstand="df" xmlns="http://schemas.microsoft.com/sqlserver/reporting/2016/01/reportdefinition" xmlns:rd="http://schemas.microsoft.com/SQLServer/reporting/reportdesigner" xmlns:df="http://schemas.microsoft.com/sqlserver/reporting/2016/01/reportdefinition/defaultfontfamily">
  <df:DefaultFontFamily>Segoe UI</df:DefaultFontFamily>
  <AutoRefresh>0</AutoRefresh>
  <DataSources>
    <DataSource Name="NAV">
      <DataSourceReference>NAV</DataSourceReference>
      <rd:SecurityType>None</rd:SecurityType>
      <rd:DataSourceID>89e8bada-66b7-425f-8840-df2a5b3d9352</rd:DataSourceID>
    </DataSource>
    <DataSource Name="NAV_TEST">
      <DataSourceReference>NAV_TEST</DataSourceReference>
      <rd:SecurityType>DataBase</rd:SecurityType>
      <rd:DataSourceID>4332216c-3d21-4180-9736-2794b526abce</rd:DataSourceID>
    </DataSource>
  </DataSources>
  <DataSets>
    <DataSet Name="DataSet1">
      <Query>
        <DataSourceName>NAV_TEST</DataSourceName>
        <QueryParameters>
          <QueryParameter Name="@start">
            <Value>=Parameters!start.Value</Value>
            <rd:UserDefined>true</rd:UserDefined>
          </QueryParameter>
          <QueryParameter Name="@end">
            <Value>=Parameters!end.Value</Value>
            <rd:UserDefined>true</rd:UserDefined>
          </QueryParameter>
          <QueryParameter Name="@workCenter">
            <Value>=Parameters!workCenter.Value</Value>
            <rd:UserDefined>true</rd:UserDefined>
          </QueryParameter>
        </QueryParameters>
        <CommandText>
WITH s1 AS
(
select

No_
, CASE 
	WHEN CHARINDEX('-',No_) = 0 THEN SUM([Capacity (Total)])
	WHEN CHARINDEX('-',No_) &gt; 0 THEN SUM([Capacity (Effective)])
END Capacity
,YEAR([Date]) [Year]
,MONTH([Date]) [Month]


from [ZYGO$Calendar Entry] 

WHERE

[Date] &gt;= @start

AND [Date] &lt;= @end

AND   LEFT(No_,3) = @workCenter

GROUP BY No_ ,YEAR([Date]),MONTH([Date])
)
,s2 AS
(
SELECT 

No_
,SUM([Allocated Time]) Allocated
,YEAR([Date]) [Year]
,MONTH([Date]) [Month]

FROM [ZYGO$Prod_ Order Capacity Need]

WHERE

Date &gt;= @start

AND Date &lt;= @end

AND   LEFT(No_,3) = @workCenter

GROUP BY No_ ,YEAR([Date]),MONTH([Date])
)
,s3 AS
(
	SELECT

	No_
	,Name

	FROM [ZYGO$Machine Center]
)
,s4 AS
(
	SELECT
	
	No_
	,Name

	FROM [ZYGO$Work Center]
)
SELECT

s2.No_
,CASE 
	WHEN s3.Name is null THEN s4.Name
	WHEN s3.Name is not null THEN s3.Name
END Name
,s1.Capacity
,s2.Allocated
,FORMAT(s2.Allocated/s1.Capacity,'P') Load
, s1.[Month]
, s1.[Year]


FROM s1 Right JOIN s2 ON s1.No_ = s2.No_ AND s1.[Year] = s2.[Year] and s1.[Month] = s2.[Month]

LEFT JOIN s3 ON s2.No_ = s3.No_

LEFT JOIN s4 ON s4.No_ = s2.No_

ORDER BY s1.No_,s1.[Month], s1.[Year]</CommandText>
        <rd:UseGenericDesigner>true</rd:UseGenericDesigner>
      </Query>
      <Fields>
        <Field Name="No_">
          <DataField>No_</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Name">
          <DataField>Name</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Capacity">
          <DataField>Capacity</DataField>
          <rd:TypeName>System.Decimal</rd:TypeName>
        </Field>
        <Field Name="Allocated">
          <DataField>Allocated</DataField>
          <rd:TypeName>System.Decimal</rd:TypeName>
        </Field>
        <Field Name="Load">
          <DataField>Load</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Month">
          <DataField>Month</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
        <Field Name="Year">
          <DataField>Year</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
    <DataSet Name="WorkCenters">
      <SharedDataSet>
        <SharedDataSetReference>WorkCenters</SharedDataSetReference>
      </SharedDataSet>
      <Fields>
        <Field Name="No_">
          <DataField>No_</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
