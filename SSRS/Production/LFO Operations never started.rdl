<?xml version="1.0" encoding="utf-8"?>
<Report MustUnderstand="df" xmlns="http://schemas.microsoft.com/sqlserver/reporting/2016/01/reportdefinition" xmlns:rd="http://schemas.microsoft.com/SQLServer/reporting/reportdesigner" xmlns:df="http://schemas.microsoft.com/sqlserver/reporting/2016/01/reportdefinition/defaultfontfamily">
  <df:DefaultFontFamily>Segoe UI</df:DefaultFontFamily>
  <AutoRefresh>0</AutoRefresh>
  <DataSources>
    <DataSource Name="AFE">
      <DataSourceReference>AFE</DataSourceReference>
      <rd:SecurityType>None</rd:SecurityType>
      <rd:DataSourceID>f66c0921-64d8-4774-809d-71d0653eac3c</rd:DataSourceID>
    </DataSource>
  </DataSources>
  <DataSets>
    <DataSet Name="DataSet1">
      <Query>
        <DataSourceName>AFE</DataSourceName>
        <CommandText>/*	 work orders	*/

with s1 AS /*	released production from NAV	*/
(
	SELECT
	
	[Prod_ Order No_] OrderNo
	,[Operation No_] Operation
	,Description
	,[Prod_ Order No_] + [Operation No_] oLink
	,[Run Time]
	,[Ending Date-Time] NAVplannedEndDate
	,CASE Status
		WHEN 3 THEN 'Released'
		WHEN 4 THEN 'Completed'
		ELSE ''
	END NAVstatus
	,[Routing No_]
	

	FROM NAVprodOrdRoutingLine l 

	WHERE 1=1 --LEFT(Description, 4) = '5074'

	AND (Status = 4 AND [Starting Date-Time] &gt; DATEADD(YY, -2,GETDATE())

	OR Status = 3 and [Starting Date-Time] &lt; DATEADD(mm,6,GETDATE()))
	
)
, s2 AS  /*	Dashboard first scan of released production	*/
(
	SELECT 
	   Item
	  ,[OrderNo]
      ,[Operation]
      ,COALESCE(MIN([StartTime]) ,'')firstScan
	  ,[OrderNo] + [Operation] oLink
	  ,MAX(Complete) DashboardStatus

  FROM [MIDDB01.zygo.com].Dashboard.[dbo].[TimecardNAVProdHours]

  where ([OrderNo] + [Operation]) IN (select oLink from s1)

  GROUP BY 

       [OrderNo]
      ,[Operation]
      ,[Item]
      


)
, s3 AS	/*	orders EstimatedEnd based on start plus routing run time	*/
(
	SELECT

	s2.*
	,s1.Description
	,COALESCE(DATEADD(hh, [Run Time], firstScan),'') EstimatedEnd
	,s1.[Run Time]
	,s1.NAVplannedEndDate
	,s1.NAVstatus

	FROM s2 INNER JOIN s1 ON s2.oLink = s1.oLink
)/*
,s4 AS	/*	Orders marked in Dashboard as complete	*/
(
	SELECT 
	   
      MAX([EndTime]) DashboardCompletionDate
	  ,orderno + operation oLink

	FROM [MIDDB01.zygo.com].Dashboard.[dbo].[TimecardNAVProdHours]

	where orderno + operation IN (SELECT oLink from s1)
  
	AND Complete = 1

	GROUP BY 

       [OrderNo]
      ,[Operation]
)
,s5 AS	/*	Dashboard not marked as complete - could be running	*/
(
	select 

	orderno + operation oLink
	,MAX(endtime) lastScan

	FROM [MIDDB01.zygo.com].Dashboard.[dbo].[TimecardNAVProdHours]
		
	WHERE ([OrderNo] + [Operation]) IN (select oLink from s1)

	AND starttime is not null

	--AND WorkcenterDescription like '5074%'

	GROUP BY orderno + operation

	HAVING MAX(Complete) = 0

	AND MAX(endtime) &gt; DATEADD(YY,-2,GETDATE())
)
,s6 AS
(
select

 Item
,OrderNo
,Operation
,Description
,FirstScan
,[Run Time]
,EstimatedEnd
,DashboardCompletionDate DashboardLastScanDate
,'Complete' DashboardStatus
,s3.oLink

from s3 

LEFT JOIN s4 ON s3.oLink = s4.oLink

WHERE CAST(s4.DashboardCompletionDate as date) &gt;= CAST(DATEADD(dd, -7,(GETDATE()-1)) as date)

--order by orderno, operation
UNION ALL

select

 s3.Item
,s3.OrderNo
,s3.Operation
,s3.Description
,s3.FirstScan
,s3.[Run Time]
,s3.EstimatedEnd
,s5.lastScan
,'Incomplete'
,s5.oLink

from s5

left join s3 on s5.oLink = s3.oLink
)
	SELECT 

	COALESCE(s6.Item,'') Item
	,COALESCE(s6.OrderNo,'') OrderNo
	,COALESCE(s6.Operation,'') Operation
	,COALESCE(s6.Description,'Description not on Routing') Description
	--,CASE CAST(COALESCE(s6.FirstScan,'') as varchar(20))
	--	WHEN 'Jan  1 1900 12:00AM' THEN ''
	--	ELSE CAST(COALESCE(s6.FirstScan,'') as varchar(20))
	--END FirstScan

	----,CAST(COALESCE(s6.[Run Time],'') as varchar(4)) RunTime
	--,CASE CAST(COALESCE(s6.EstimatedEnd,'') as varchar(20))
	--	WHEN 'Jan  1 1900 12:00AM' THEN ''
	--	ELSE CAST(COALESCE(s6.EstimatedEnd,'') as varchar(20))
	,firstScan
	,[Run Time]
	,EstimatedEnd
	--END EstimatedEnd
	,DashboardLastScanDate
	,DashboardStatus

	,DATEDIFF(dd, EstimatedEnd, DashboardLastScanDate) DayOffset
	,--CASE DashboardStatus
		--WHEN 'Complete' THEN
	
		COALESCE(CASE
			WHEN DATEDIFF(dd, EstimatedEnd, DashboardLastScanDate) &lt;= 3 THEN 'Green'
			WHEN DATEDIFF(dd, EstimatedEnd, DashboardLastScanDate) &gt;  3 AND DATEDIFF(dd, EstimatedEnd, DashboardLastScanDate)  &lt;= 5 THEN 'Yellow'
			WHEN DATEDIFF(dd, EstimatedEnd, DashboardLastScanDate) &gt; 5 THEN 'Red'
		END,'NA')
	--ELSE CASE WHEN DATEDIFF(dd, EstimatedEnd, CAST(GETDATE() as date)) &gt; 5 THEN 'Red'
	--	ELSE 'Purple'
	--	END
	--END 
	[Status]

	FROM s6

	WHERE EstimatedEnd &gt; DATEADD(mm,-2,GETDATE())

	AND

	Item in

	(
			 'CEA-F710483-3-IMP-B'
			,'CEA-F712PD17TO0483-3'
			,'CEA-F712PD17TO0482-3'
			,'CEA-F712PD17TO0476-3'
			,'LL-AAA08-105746'
	)

	Order by
	
	OrderNo
	,Operation
	--DashboardLastScanDate 
	--EstimatedEnd
	desc

	*/

	select * from s1

	where oLink not in (SELECT oLink from s2)

	AND [Routing No_] IN 

	(
			 'CEA-F710483-3-IMP-B'
			,'CEA-F712PD17TO0483-3'
			,'CEA-F712PD17TO0482-3'
			,'CEA-F712PD17TO0476-3'
			,'LL-AAA08-105746'
	)

	AND NAVplannedEndDate &lt; (GETDATE() + 7)

	AND Operation &lt;&gt; '1000'

	AND NAVstatus &lt;&gt; 'Completed'

	ORDER BY OrderNo, Operation desc</CommandText>
        <rd:UseGenericDesigner>true</rd:UseGenericDesigner>
      </Query>
      <Fields>
        <Field Name="OrderNo">
          <DataField>OrderNo</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Operation">
          <DataField>Operation</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Description">
          <DataField>Description</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="oLink">
          <DataField>oLink</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Run_Time">
          <DataField>Run Time</DataField>
          <rd:TypeName>System.Decimal</rd:TypeName>
        </Field>
        <Field Name="NAVplannedEndDate">
          <DataField>NAVplannedEndDate</DataField>
          <rd:TypeName>System.DateTime</rd:TypeName>
        </Field>
        <Field Name="NAVstatus">
          <DataField>NAVstatus</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Routing_No_">
          <DataField>Routing No_</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
  </DataSets>
