  <DataSets>
    <DataSet Name="DataSet1">
      <Query>
        <DataSourceName>NAV</DataSourceName>
        <CommandText>--DECLARE @c1 nchar(20)

--Select top 1 @c1 =  [Operation No_] FROM [ZYGO$Prod_ Order Routing Line] 

--where [Prod_ Order No_] = 'PD512072'

WITH s1 AS
(

select 

[Prod_ Order No_]
,'Due' [Status]
,max(COALESCE(case WHEN [Operation No_]='1000' THEN [Ending Date-Time]  end,'')) '1000'
,max(COALESCE(case WHEN [Operation No_]='1050' THEN [Ending Date-Time]  end,'')) '1050'
,max(COALESCE(case WHEN [Operation No_]='1052' THEN [Ending Date-Time]  end,'')) '1052'
,max(COALESCE(case WHEN [Operation No_]='1053' THEN [Ending Date-Time]  end,'')) '1054'
,max(COALESCE(case WHEN [Operation No_]='1054' THEN [Ending Date-Time]  end,'')) '1055'
,max(COALESCE(case WHEN [Operation No_]='1060' THEN [Ending Date-Time]  end,'')) '1060'
,max(COALESCE(case WHEN [Operation No_]='1065' THEN [Ending Date-Time]  end,'')) '1065'
,max(COALESCE(case WHEN [Operation No_]='1067' THEN [Ending Date-Time]  end,'')) '1067'
,max(COALESCE(case WHEN [Operation No_]='1080' THEN [Ending Date-Time]  end,'')) '1080'
,max(COALESCE(case WHEN [Operation No_]='1085' THEN [Ending Date-Time]  end,'')) '1085'
,max(COALESCE(case WHEN [Operation No_]='1087' THEN [Ending Date-Time]  end,'')) '1087'
,max(COALESCE(case WHEN [Operation No_]='1090' THEN [Ending Date-Time]  end,'')) '1090'
,max(COALESCE(case WHEN [Operation No_]='1095' THEN [Ending Date-Time]  end,'')) '1095'
,max(COALESCE(case WHEN [Operation No_]='1097' THEN [Ending Date-Time]  end,'')) '1097'
,max(COALESCE(case WHEN [Operation No_]='1100' THEN [Ending Date-Time]  end,'')) '1100'
,max(COALESCE(case WHEN [Operation No_]='1105' THEN [Ending Date-Time]  end,'')) '1105'
,max(COALESCE(case WHEN [Operation No_]='1120' THEN [Ending Date-Time]  end,'')) '1120'

,max(COALESCE(case WHEN [Operation No_]='1130' THEN [Ending Date-Time]  end,'')) '1130'

,max(COALESCE(case WHEN [Operation No_]='1140' THEN [Ending Date-Time]  end,'')) '1140'
,max(COALESCE(case WHEN [Operation No_]='1143' THEN [Ending Date-Time]  end,'')) '1143'
,max(COALESCE(case WHEN [Operation No_]='1144' THEN [Ending Date-Time]  end,'')) '1144'
,max(COALESCE(case WHEN [Operation No_]='1145' THEN [Ending Date-Time]  end,'')) '1145'
,max(COALESCE(case WHEN [Operation No_]='1150' THEN [Ending Date-Time]  end,'')) '1150'
,max(COALESCE(case WHEN [Operation No_]='1165' THEN [Ending Date-Time]  end,'')) '1165'
,max(COALESCE(case WHEN [Operation No_]='1166' THEN [Ending Date-Time]  end,'')) '1166'
,max(COALESCE(case WHEN [Operation No_]='1167' THEN [Ending Date-Time]  end,'')) '1167'
,max(COALESCE(case WHEN [Operation No_]='1168' THEN [Ending Date-Time]  end,'')) '1168'
,max(COALESCE(case WHEN [Operation No_]='1169' THEN [Ending Date-Time]  end,'')) '1169'

,max(COALESCE(case WHEN [Operation No_]='1170' THEN [Ending Date-Time]  end,'')) '1170'
,max(COALESCE(case WHEN [Operation No_]='1172' THEN [Ending Date-Time]  end,'')) '1172'
,max(COALESCE(case WHEN [Operation No_]='1174' THEN [Ending Date-Time]  end,'')) '1174'
,max(COALESCE(case WHEN [Operation No_]='1176' THEN [Ending Date-Time]  end,'')) '1176'
,max(COALESCE(case WHEN [Operation No_]='1200' THEN [Ending Date-Time]  end,'')) '1200'
,max(COALESCE(case WHEN [Operation No_]='1205' THEN [Ending Date-Time]  end,'')) '1205'
,max(COALESCE(case WHEN [Operation No_]='1210' THEN [Ending Date-Time]  end,'')) '1210'
,max(COALESCE(case WHEN [Operation No_]='1215' THEN [Ending Date-Time]  end,'')) '1215'
,max(COALESCE(case WHEN [Operation No_]='1218' THEN [Ending Date-Time]  end,'')) '1218'
,max(COALESCE(case WHEN [Operation No_]='1220' THEN [Ending Date-Time]  end,'')) '1220'

,max(COALESCE(case WHEN [Operation No_]='1246' THEN [Ending Date-Time]  end,'')) '1246'
,max(COALESCE(case WHEN [Operation No_]='1248' THEN [Ending Date-Time]  end,'')) '1248'
,max(COALESCE(case WHEN [Operation No_]='1250' THEN [Ending Date-Time]  end,'')) '1250'


--,[Operation No_]
--,1 RRw

FROM [ZYGO$Prod_ Order Routing Line] 

where Status = 3

AND [Routing No_] = 'LL-AAA08-105746'

--[Prod_ Order No_] = 'PD512072'

GROUP BY [Prod_ Order No_]
)
, s2 AS
(
	SELECT 

	--MAX(CAST([Posting Date] as date)) ActualDate
	/*"CONVERT(nvarchar(10), DueDate, 101) DueDate, " +*/
	[Document No_]
	,'Actual' [Status]
	,max(COALESCE(case WHEN [Operation No_]='1000' THEN [Posting Date]  end,'')) '1000'
	,max(COALESCE(case WHEN [Operation No_]='1050' THEN [Posting Date]  end,'')) '1050'
	,max(COALESCE(case WHEN [Operation No_]='1052' THEN [Posting Date]  end,'')) '1052'
	,max(COALESCE(case WHEN [Operation No_]='1053' THEN [Posting Date]  end,'')) '1054'
	,max(COALESCE(case WHEN [Operation No_]='1054' THEN [Posting Date]  end,'')) '1055'
	,max(COALESCE(case WHEN [Operation No_]='1060' THEN [Posting Date]  end,'')) '1060'
	,max(COALESCE(case WHEN [Operation No_]='1065' THEN [Posting Date]  end,'')) '1065'
	,max(COALESCE(case WHEN [Operation No_]='1067' THEN [Posting Date]  end,'')) '1067'
	,max(COALESCE(case WHEN [Operation No_]='1080' THEN [Posting Date]  end,'')) '1080'
	,max(COALESCE(case WHEN [Operation No_]='1085' THEN [Posting Date]  end,'')) '1085'
	,max(COALESCE(case WHEN [Operation No_]='1087' THEN [Posting Date]  end,'')) '1087'
	,max(COALESCE(case WHEN [Operation No_]='1090' THEN [Posting Date]  end,'')) '1090'
	,max(COALESCE(case WHEN [Operation No_]='1095' THEN [Posting Date]  end,'')) '1095'
	,max(COALESCE(case WHEN [Operation No_]='1097' THEN [Posting Date]  end,'')) '1097'
	,max(COALESCE(case WHEN [Operation No_]='1100' THEN [Posting Date]  end,'')) '1100'
	,max(COALESCE(case WHEN [Operation No_]='1105' THEN [Posting Date]  end,'')) '1105'
	,max(COALESCE(case WHEN [Operation No_]='1120' THEN [Posting Date]  end,'')) '1120'

	,max(COALESCE(case WHEN [Operation No_]='1130' THEN [Posting Date]  end,'')) '1130'

	,max(COALESCE(case WHEN [Operation No_]='1140' THEN [Posting Date]  end,'')) '1140'
	,max(COALESCE(case WHEN [Operation No_]='1143' THEN [Posting Date]  end,'')) '1143'
	,max(COALESCE(case WHEN [Operation No_]='1144' THEN [Posting Date]  end,'')) '1144'
	,max(COALESCE(case WHEN [Operation No_]='1145' THEN [Posting Date]  end,'')) '1145'
	,max(COALESCE(case WHEN [Operation No_]='1150' THEN [Posting Date]  end,'')) '1150'
	,max(COALESCE(case WHEN [Operation No_]='1165' THEN [Posting Date]  end,'')) '1165'
	,max(COALESCE(case WHEN [Operation No_]='1166' THEN [Posting Date]  end,'')) '1166'
	,max(COALESCE(case WHEN [Operation No_]='1167' THEN [Posting Date]  end,'')) '1167'
	,max(COALESCE(case WHEN [Operation No_]='1168' THEN [Posting Date]  end,'')) '1168'
	,max(COALESCE(case WHEN [Operation No_]='1169' THEN [Posting Date]  end,'')) '1169'

	,max(COALESCE(case WHEN [Operation No_]='1170' THEN [Posting Date]  end,'')) '1170'
	,max(COALESCE(case WHEN [Operation No_]='1172' THEN [Posting Date]  end,'')) '1172'
	,max(COALESCE(case WHEN [Operation No_]='1174' THEN [Posting Date]  end,'')) '1174'
	,max(COALESCE(case WHEN [Operation No_]='1176' THEN [Posting Date]  end,'')) '1176'
	,max(COALESCE(case WHEN [Operation No_]='1200' THEN [Posting Date]  end,'')) '1200'
	,max(COALESCE(case WHEN [Operation No_]='1205' THEN [Posting Date]  end,'')) '1205'
	,max(COALESCE(case WHEN [Operation No_]='1210' THEN [Posting Date]  end,'')) '1210'
	,max(COALESCE(case WHEN [Operation No_]='1215' THEN [Posting Date]  end,'')) '1215'
	,max(COALESCE(case WHEN [Operation No_]='1218' THEN [Posting Date]  end,'')) '1218'
	,max(COALESCE(case WHEN [Operation No_]='1220' THEN [Posting Date]  end,'')) '1220'

	,max(COALESCE(case WHEN [Operation No_]='1246' THEN [Posting Date]  end,'')) '1246'
	,max(COALESCE(case WHEN [Operation No_]='1248' THEN [Posting Date]  end,'')) '1248'
	,max(COALESCE(case WHEN [Operation No_]='1250' THEN [Posting Date]  end,'')) '1250'


	FROM [ZYGO$Capacity Ledger Entry]  c

	INNER JOIN [ZYGO$Production Order] o ON c.[Document No_] = o.[No_]

	WHERE

	c.[Item No_] = 'LL-AAA08-105746'

	AND o.Status = 3

	GROUP BY 
	
	[Document No_]
	--,[Operation No_]
)
, s3 AS
(
	SELECT 

	MAX([Operation No_]) MaxOp
	,[Document No_]
	

	FROM [ZYGO$Capacity Ledger Entry]  c

	INNER JOIN [ZYGO$Production Order] o ON c.[Document No_] = o.[No_]

	WHERE

	c.[Item No_] = 'LL-AAA08-105746'

	AND o.Status = 3
	
	GROUP BY 
	
	[Document No_]
	

)
,s4 AS
(

select * from s1

--WHERE [Prod_ Order No_] = 'PD512072'

UNION ALL

select * from s2
)
select

--ROW_NUMBER() OVER(ORDER BY [Prod_ Order No_] ASC) as RowNum
--,

[Prod_ Order No_]
,[Status]
,[1000]
,[1050]
--,CASE
--	WHEN LEAD([1050],1,0) OVER (PARTITION BY [Prod_ Order No_] ORDER BY [1050]) &gt; '1900-01-01'
--		THEN LEAD([1050],1,0) OVER (PARTITION BY [Prod_ Order No_] ORDER BY [1050])
--	ELSE '2000-01-01'
--END
,CASE
	WHEN [1050] &gt; '1900-01-01'
		THEN
			CASE
				WHEN LEAD([1050],1,0) OVER (PARTITION BY [Prod_ Order No_] ORDER BY [1050]) &gt; '1900-01-01'
					THEN DATEDIFF(dd,LEAD([1050],1,0) OVER (PARTITION BY [Prod_ Order No_] ORDER BY [1050]),[1050])
				ELSE 0
			END 
		ELSE 0
	END [1050S]
,[1060]
,CASE
	WHEN [1060] &gt; '1900-01-01'
		THEN
			CASE
				WHEN LEAD([1060],1,0) OVER (PARTITION BY [Prod_ Order No_] ORDER BY [1060]) &gt; '1900-01-01'
					THEN DATEDIFF(dd,LEAD([1060],1,0) OVER (PARTITION BY [Prod_ Order No_] ORDER BY [1060]),[1060])
				ELSE 0
			END 
		ELSE 0
	END [1060S]
,[1067]
,CASE
	WHEN [1067] &gt; '1900-01-01'
		THEN
			CASE
				WHEN LEAD([1067],1,0) OVER (PARTITION BY [Prod_ Order No_] ORDER BY [1067]) &gt; '1900-01-01'
					THEN DATEDIFF(dd,LEAD([1067],1,0) OVER (PARTITION BY [Prod_ Order No_] ORDER BY [1067]),[1067])
				ELSE 0
			END 
		ELSE 0
	END [1067S]
,[1080]
,CASE
	WHEN [1080] &gt; '1900-01-01'
		THEN
			CASE
				WHEN LEAD([1080],1,0) OVER (PARTITION BY [Prod_ Order No_] ORDER BY [1080]) &gt; '1900-01-01'
					THEN DATEDIFF(dd,LEAD([1080],1,0) OVER (PARTITION BY [Prod_ Order No_] ORDER BY [1080]),[1080])
				ELSE 0
			END 
		ELSE 0
	END [1080S]


from s4 

--GROUP BY [Prod_ Order No_]

order by [Prod_ Order No_], [Status] desc</CommandText>
        <rd:UseGenericDesigner>true</rd:UseGenericDesigner>
      </Query>
