        </Field>
        <Field Name="maxDateCompleted">
          <DataField>maxDateCompleted</DataField>
          <rd:TypeName>System.DateTime</rd:TypeName>
        </Field>
        <Field Name="OrderNo">
          <DataField>OrderNo</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="OpCompleted">
          <DataField>OpCompleted</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="DaysSinceLastCompletedOP">
          <DataField>DaysSinceLastCompletedOP</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
