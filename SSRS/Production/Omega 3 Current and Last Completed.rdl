<?xml version="1.0" encoding="utf-8"?>
<Report xmlns="http://schemas.microsoft.com/sqlserver/reporting/2016/01/reportdefinition" xmlns:rd="http://schemas.microsoft.com/SQLServer/reporting/reportdesigner" xmlns:df="http://schemas.microsoft.com/sqlserver/reporting/2016/01/reportdefinition/defaultfontfamily" MustUnderstand="df">
  <df:DefaultFontFamily>Segoe UI</df:DefaultFontFamily>
  <AutoRefresh>0</AutoRefresh>
  <DataSources>
    <DataSource Name="AFE">
      <DataSourceReference>AFE</DataSourceReference>
      <rd:SecurityType>None</rd:SecurityType>
      <rd:DataSourceID>4857269a-f075-45cf-abf5-6eae85341e44</rd:DataSourceID>
    </DataSource>
  </DataSources>
  <DataSets>
    <DataSet Name="DataSet1">
      <Query>
        <DataSourceName>AFE</DataSourceName>
        <CommandText>WITH s1 AS
(
select 

MAX(Operation) MaxOp
,OrderNo


from [CT-MID-DB01.ametek.com].Dashboard.dbo.TimecardNAVProdHours

WHERE OrderNo in

(Select [Document No_] FROM Omega3CurrentProd)

AND Complete = 1

GROUP BY OrderNo
)
, s2 AS
(
	select

	MAX(EndTime) maxDateCompleted
	,OrderNo
	,Operation OpCompleted

	from [CT-MID-DB01.ametek.com].Dashboard.dbo.TimecardNAVProdHours

	WHERE OrderNo in

	(Select [Document No_] FROM Omega3CurrentProd)

	AND Complete = 1

	GROUP BY 

	OrderNo
	,Operation
)
, s3 AS
(
select

s2.*
,DATEDIFF(DAY,maxDateCompleted, GETDATE()) DaysSinceLastCompletedOP

from s1

INNER JOIN s2 ON s2.OrderNo = s1.orderNo and s2.opCompleted = s1.MaxOp
)

select

o.*
,s3.*

FROM Omega3CurrentProd o

LEFT JOIN s3 ON o.[Document No_] = s3.OrderNo</CommandText>
        <rd:UseGenericDesigner>true</rd:UseGenericDesigner>
      </Query>
      <Fields>
        <Field Name="Document_No_">
          <DataField>Document No_</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="LastScan">
          <DataField>LastScan</DataField>
          <rd:TypeName>System.DateTime</rd:TypeName>
        </Field>
        <Field Name="DaysSinceLastScan">
          <DataField>DaysSinceLastScan</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
        <Field Name="Operation_No_">
          <DataField>Operation No_</DataField>
