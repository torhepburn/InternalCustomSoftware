<?xml version="1.0" encoding="utf-8"?>
<Report xmlns="http://schemas.microsoft.com/sqlserver/reporting/2016/01/reportdefinition" xmlns:rd="http://schemas.microsoft.com/SQLServer/reporting/reportdesigner" xmlns:df="http://schemas.microsoft.com/sqlserver/reporting/2016/01/reportdefinition/defaultfontfamily" MustUnderstand="df">
  <df:DefaultFontFamily>Segoe UI</df:DefaultFontFamily>
  <AutoRefresh>0</AutoRefresh>
  <DataSources>
    <DataSource Name="NAV">
      <DataSourceReference>NAV</DataSourceReference>
      <rd:SecurityType>None</rd:SecurityType>
      <rd:DataSourceID>fe4384ca-6136-4949-84fe-0717a95ae00d</rd:DataSourceID>
    </DataSource>
  </DataSources>
  <DataSets>
    <DataSet Name="DataSet1">
      <Query>
        <DataSourceName>NAV</DataSourceName>
        <CommandText>WITH s1 AS
(
select

SUM(Quantity) TimeCharged
,[Document No_]
,[Operation No_]
,[Work Center No_]
,[Lot Size]


from [ZYGO$Capacity Ledger Entry]

WHERE [Posting Date] &gt; CAST(DATEADD(MM,-6,GETDATE()) AS date)

GROUP BY 

[Document No_]
,[Operation No_]
,[Work Center No_]
,[Lot Size]

)
,s2 as
(
SELECT

r.[Prod_ Order No_]
,o.Description
,o.[Source No_]
,r.[Operation No_]
,r.[Run Time] RoutingRunTime
,s1.TimeCharged
,s1.TimeCharged - r.[Run Time] [Difference]
,CASE 
	WHEN s1.TimeCharged - r.[Run Time]  &lt; 0 THEN 'Under'
	WHEN s1.TimeCharged - r.[Run Time]  &gt; 0 THEN 'Over'
	ELSE 'No Variance'
END Variance
,CASE 
	WHEN r.[Run Time] &gt; 0 THEN ((s1.TimeCharged - r.[Run Time])/r.[Run Time])*100
	ELSE 0
END VariancePercent
,s1.[Work Center No_]
,w.Name
,s1.[Lot Size]
,[Global Dimension 1 Code]
,CASE
	WHEN [Global Dimension 1 Code] IN (
				'5200',
				'5210',
				'5215',
				'5225',
				'5230',
				'5110',
				'5125',
				'5135',
				'5145',
				'5150',
				'5160',
				'5177',
				'5185',
				'5310',
				'6050',
				'8074',
				'8077',
				'8177',
				'8190')
				THEN 'MFO'
				

	WHEN [Global Dimension 1 Code]   in (
				'5062',
				'5065',
				'7006',
				'8035',
				'8150')
				THEN 'PPS'

				WHEN [Global Dimension 1 Code]   in (
				'1140',
				'5017',
				'5024',
				'7222',
				'8200',
				'8210',
				'8211',
				'8215',
				'8220')
				THEN 'EO'

				WHEN [Global Dimension 1 Code]   in (
				'1151',
				'5620',
				'5640',
				'5641',
				'5642',
				'5643',
				'5644',
				'5645',
				'5646',
				'5647',
				'5648',
				'5649',
				'5680',
				'5685',
				'5690',
				'6011',
				'7007',
				'8191')
				THEN 'EPO'

				WHEN [Global Dimension 1 Code]   in (
				'5010',
				'5012',
				'5013',
				'5050',
				'5070',
				'5072',
				'5074',
				'7010',
				'7011',
				'7012',
				'7017',
				'7028',
				'7050',
				'8015',
				'8017',
				'8049',
				'8050',
				'8070',
				'8080',
				'8090',
				'8110',
				'8117',
				'8118',
				'8119',
				'8120',
				'8180')
				THEN 'Instruments'

				WHEN [Global Dimension 1 Code]   in (
						'1000',
						'1050',
						'1100',
						'1210',
						'1211',
						'1213',
						'5014',
						'5015',
						'5020',
						'5025',
						'5030',
						'5045',
						'6001',
						'6005',
						'6007',
						'6015',
						'6016',
						'6020',
						'6030',
						'7001',
						'7020',
						'7021',
						'7040',
						'7045',
						'7055',
						'7120',
						'7125',
						'7130',
						'7135',
						'7320',
						'7325',
						'7330',
						'7340',
						'7420',
						'7430',
						'7440',
						'7445',
						'7470',
						'8010',
						'8011',
						'8170',
						'8175',
						'ZZZZ')
				THEN 'Other'

END [Business Segment]
,o.[Finished Date] [Prod_ Order No_ Finished Date]
,o.[Starting Date]
,o.[Starting Date-Time]

FROM s1 LEFT JOIN [ZYGO$Prod_ Order Routing Line] r ON s1.[Document No_] = r.[Prod_ Order No_]

AND s1.[Operation No_] = r.[Operation No_]

LEFT JOIN [ZYGO$Work Center] w ON s1.[Work Center No_] = w.No_

LEFT JOIN [ZYGO$Production Order] o ON s1.[Document No_] = o.No_

WHERE r.Status IN (3, 4)  --finished

--AND [Global Dimension 1 Code] IN ('5215', '5135','5225','5177')  --DAN
--AND [Global Dimension 1 Code] IN ('5013')  --SER Mike
--AND [Global Dimension 1 Code] IN ('5074')  --MATT
--AND [Global Dimension 1 Code] IN ('5642', '5643','5644','5645','5641')  --ROCCO
--AND [Global Dimension 1 Code] IN ('5185', '5145','5200')  --JIM F
--AND [Global Dimension 1 Code] IN ('5210', '5230')  --TOM
--AND [Global Dimension 1 Code] IN ('5017')  --DANNY
--AND s1.[Work Center No_] IN ('081','104','107','122','710','711','712','713','714','715','716','717','718','730','740','750','755','757')  --RYAN
--AND s1.[Work Center No_] IN ('080','171','756','760','760A','760B','760C','760D','760E','765','784') --BRANDON

--and LEN([Global Dimension 1 Code]) = 0
)

select

*

from s2 

WHERE Name like '5074%'

AND  ABS([Difference]) &gt; 0


ORDER BY ABS([Difference]) desc

--select * from s2 where ABS([Difference]) &gt; 0</CommandText>
        <rd:UseGenericDesigner>true</rd:UseGenericDesigner>
      </Query>
