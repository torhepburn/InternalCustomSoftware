<?xml version="1.0" encoding="utf-8"?>
<Report MustUnderstand="df" xmlns="http://schemas.microsoft.com/sqlserver/reporting/2016/01/reportdefinition" xmlns:rd="http://schemas.microsoft.com/SQLServer/reporting/reportdesigner" xmlns:df="http://schemas.microsoft.com/sqlserver/reporting/2016/01/reportdefinition/defaultfontfamily">
  <df:DefaultFontFamily>Segoe UI</df:DefaultFontFamily>
  <AutoRefresh>0</AutoRefresh>
  <DataSources>
    <DataSource Name="DataSource1">
      <ConnectionProperties>
        <DataProvider>SQL</DataProvider>
        <ConnectString>Data Source=ct-mid-sql11;Initial Catalog=AccessFrontEnds</ConnectString>
      </ConnectionProperties>
      <rd:SecurityType>DataBase</rd:SecurityType>
      <rd:DataSourceID>3dc29b02-4e08-47ec-b251-654f688fc9c6</rd:DataSourceID>
    </DataSource>
  </DataSources>
  <DataSets>
    <DataSet Name="DataSet1">
      <Query>
        <DataSourceName>DataSource1</DataSourceName>
        <CommandText>with s01 AS
(
SELECT

UserID
,CAST(CreatedOn as date) cDate
,COUNT(
	CASE 
	WHEN WorkCenterComponentType = 'PERSON' THEN 'PERSON'
END	) PersonCount
,COUNT(
	CASE 
	WHEN WorkCenterComponentType != 'PERSON' THEN 'NOT PERSON'
END	) NotPersonCount

from [MIDDB01.zygo.com].Dashboard.dbo.timecardNAVProdHours

WHERE CreatedOn &gt; '2023-05-31'

GROUP BY 

UserID
,CAST(CreatedOn as date)
)
,s02 AS
(
SELECT

UserId 

FROM s01

GROUP BY userID

HAVING

SUM(NotPersonCount) = 0
)
,s1 AS
(
select

userID
,ApportionTime
,createdon
,costcenter
--,CAST(orderno as varchar(10))
,'PROD' Type


from [MIDDB01.zygo.com].Dashboard.dbo.timecardNAVProdHours

where WorkCenterComponentType = 'PERSON'

UNION ALL

select

userID
,hours
,createdon
,costcenter
--,IndirecttimeID
,Description


from [MIDDB01.zygo.com].Dashboard.dbo.timecardindirectTimeHours

--where userID = 1330


UNION ALL

select

ID
,hours
,dateentered
,costcenter
--,IndirecttimeID
,ProjectDescription


from [MIDDB01.zygo.com].Dashboard.dbo.timecard_MK_projects

--where ID = 1330
UNION ALL

select

userID
,hours
,createdon
,costcenter
--,CAST(orderno as varchar(10))
,'SALES' Type


from [MIDDB01.zygo.com].Dashboard.dbo.[TimecardNAVSalesHours]

UNION ALL

select

userID
,hours
,createdon
,costcenter
--,CAST(orderno as varchar(10))
,'SERVICE' Type


from [MIDDB01.zygo.com].Dashboard.dbo.[TimecardNAVServiceHours]


)
,s2 AS
(
select

s1.userID
,SUM(ApportionTime) hoursWorked
,MONTH(CreatedOn) nMonth
,YEAR(CreatedOn) nYear

from s1 INNER JOIN s02 ON s1.userID = s02.userID

where 

CreatedOn &gt;= '2023-07-01'

--AND MONTH(CreatedOn) &gt; 6

and YEAR(CreatedOn) = YEAR(GetDate())

GROUP BY 

s1.userID
,MONTH(CreatedOn) 
,YEAR(CreatedOn) 
)
/*
,s3 AS
(
select

s2.* 
,AMETEK_ID
,[Total Hours Worked]
,((hoursWorked-1.25)/[Total Hours Worked])*100 Utilization
,[BusinessSegment]

from s2

INNER JOIN [MIDDB01.zygo.com].Dashboard.dbo.Person p ON s2.userId = p.userID

RIGHT JOIN ADP ON p.AMETEK_ID = adp.[Empl ID]

AND s2.nMonth = adp.[Month] AND s2.nYear = adp.[Year]

WHERE nMonth &lt; MONTH(GETDATE())
)

SELECT

AVG(Utilization) Utilization
,nYear
,nMonth
,CASE nMonth
	WHEN 1 THEN 'JAN'
	WHEN 2 THEN 'FEB'
	WHEN 3 THEN 'MAR'
	WHEN 4 THEN 'APR'
	WHEN 5 THEN 'MAY'
	WHEN 6 THEN 'JUN'
	WHEN 7 THEN 'JUL'
	WHEN 8 THEN 'AUG'
	WHEN 9 THEN 'SEP'
	WHEN 10 THEN 'OCT'
	WHEN 11 THEN 'NOV'
	WHEN 12 THEN 'DEC'
END MonthName
,[BusinessSegment]

FROM s3 

GROUP BY nYear, nMonth,[BusinessSegment]

order by nYear, nMonth

*/
/*
select

[hoursWorked] - [Total Hours Worked] DifferenceError
,hoursWorked DashboardHoursWorked
,[Total Hours Worked] ADPHoursWorked
,s2.nMonth
,s2.nYear
,p.Name
,e.manager
,cost
--,e.employeeID
--,s2.userID

from s2

INNER JOIN [MIDDB01.zygo.com].Dashboard.dbo.Person p ON s2.userId = p.userID

INNER JOIN ADP ON p.AMETEK_ID = adp.[Empl ID] AND s2.nMonth = adp.[Month] AND s2.nYear = adp.[Year]

LEFT JOIN EmployeesAmetekAD e ON e.employeeID = p.Ametek_ID

WHERE 

--hoursWorked &gt; [Total Hours Worked]

nMonth = 11

/*
select * from s1 where userID = 1999

AND Month(createdon) = 8
*/
*/
/*
,sT as
(
select

SUM(ApportionTime) t
,UserID


from s1

WHERE costcenter in

('5110',
				'5125',
				'5135',
				'5145',
				'5150',
				'5160',
				'5177',
				'5185',
				'5310',
				'6050',
				'8074',
				'8077',
				'8177',
				'8190')

				AND Createdon &gt; '2023-11-01'

				AND MONTH(Createdon) = 11

GROUP BY UserID

	)
	
	
SELECT SUM(t) from sT

*/

select

s1.userID
,Name
,s1.Type
,SUM(ApportionTime) HoursReported
,DAY(Createdon) DayDate
,MONTH(CreatedOn) MonthDate
,YEAR(CreatedOn) YearDate

from s1 INNER JOIN s02 ON s1.userID = s02.userID

INNER JOIN [MIDDB01.zygo.com].Dashboard.dbo.Person p ON s1.userId = p.userID

WHERE costcenter in ('5065', '5070')

AND Createdon &gt; '2023-12-01'

GROUP BY

s1.userID
,Name
,Type
,DAY(Createdon)
,MONTH(CreatedOn) 
,YEAR(CreatedOn) 
--where userid = 1973

ORDER BY

s1.userID
,DAY(Createdon)
,MONTH(CreatedOn) 
,YEAR(CreatedOn)</CommandText>
        <rd:UseGenericDesigner>true</rd:UseGenericDesigner>
      </Query>
