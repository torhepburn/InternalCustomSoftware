<?xml version="1.0" encoding="utf-8"?>
<Report MustUnderstand="df" xmlns="http://schemas.microsoft.com/sqlserver/reporting/2016/01/reportdefinition" xmlns:rd="http://schemas.microsoft.com/SQLServer/reporting/reportdesigner" xmlns:df="http://schemas.microsoft.com/sqlserver/reporting/2016/01/reportdefinition/defaultfontfamily">
  <df:DefaultFontFamily>Segoe UI</df:DefaultFontFamily>
  <AutoRefresh>0</AutoRefresh>
  <DataSources>
    <DataSource Name="NAV">
      <DataSourceReference>NAV</DataSourceReference>
      <rd:SecurityType>None</rd:SecurityType>
      <rd:DataSourceID>7fe706e0-76bb-4d6e-8bb6-318e4cdf828a</rd:DataSourceID>
    </DataSource>
  </DataSources>
  <DataSets>
    <DataSet Name="DataSet1">
      <Query>
        <DataSourceName>NAV</DataSourceName>
        <QueryParameters>
          <QueryParameter Name="@start">
            <Value>=Parameters!start.Value</Value>
          </QueryParameter>
          <QueryParameter Name="@end">
            <Value>=Parameters!end.Value</Value>
          </QueryParameter>
        </QueryParameters>
        <CommandText>--DECLARE @wo varchar(8)
--DECLARE @start date
--DECLARE @end date

--SET @wo = 'PD602439'


SELECT

CASE o.Status
	WHEN 1 THEN 'Planned'
	WHEN 2 THEN 'Firm Planned'
	When 3 THEN 'Released'
	WHEN 4 THEN 'Finished'
END [Status]
,[Prod_ Order No_]
--,[Line No_]
,CASE [Change Type]
	WHEN 0 THEN 'Released Date'
	WHEN 1 THEN 'Creation Date'
	WHEN 1 THEN 'Starting Date'
	WHEN 3 THEN 'Ending Date'
	WHEN 4 THEN 'Due Date'
	WHEN 5 THEN 'Starting Time'
	WHEN 6 THEN 'Ending Time'
	WHEN 7 THEN 'Starting Date-Time'
	WHEN 8 THEN 'Ending Date-Time'
	ELSE CAST([Change Type] as varchar(2))
END [Change Type]
--,[Old Value]
,[New Value]
,l.[Last Date Modified]
,[Modified by User]
,o.[Finished Date]
,o.[Assigned User ID]
,CASE
	WHEN [Change Type] = 0 THEN DATEDIFF(dd,[New Value], [Finished Date])
	ELSE ''
END DaysElapsedReleasedToFinished

FROM [ZYGO$Change Prod_ Date Log] l

INNER JOIN [ZYGO$Production Order] o  ON l.[Prod_ Order No_] = o.[No_]

WHERE 1=1

AND [Change Type] = 0

AND [Finished Date] &gt;= @start

AND [Finished Date] &lt;= @end</CommandText>
        <rd:UseGenericDesigner>true</rd:UseGenericDesigner>
      </Query>
      <Fields>
        <Field Name="Status">
          <DataField>Status</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Prod__Order_No_">
          <DataField>Prod_ Order No_</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Change_Type">
          <DataField>Change Type</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="New_Value">
          <DataField>New Value</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Last_Date_Modified">
          <DataField>Last Date Modified</DataField>
          <rd:TypeName>System.DateTime</rd:TypeName>
        </Field>
        <Field Name="Modified_by_User">
          <DataField>Modified by User</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Finished_Date">
          <DataField>Finished Date</DataField>
          <rd:TypeName>System.DateTime</rd:TypeName>
        </Field>
        <Field Name="Assigned_User_ID">
          <DataField>Assigned User ID</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="DaysElapsedReleasedToFinished">
          <DataField>DaysElapsedReleasedToFinished</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
  </DataSets>
