<?xml version="1.0" encoding="utf-8"?>
<Report MustUnderstand="df" xmlns="http://schemas.microsoft.com/sqlserver/reporting/2016/01/reportdefinition" xmlns:rd="http://schemas.microsoft.com/SQLServer/reporting/reportdesigner" xmlns:df="http://schemas.microsoft.com/sqlserver/reporting/2016/01/reportdefinition/defaultfontfamily">
  <df:DefaultFontFamily>Segoe UI</df:DefaultFontFamily>
  <AutoRefresh>0</AutoRefresh>
  <DataSources>
    <DataSource Name="NAV">
      <DataSourceReference>NAV</DataSourceReference>
      <rd:SecurityType>None</rd:SecurityType>
      <rd:DataSourceID>98241431-b903-4efd-8e98-87c16ec2e727</rd:DataSourceID>
    </DataSource>
  </DataSources>
  <DataSets>
    <DataSet Name="DataSet1">
      <Query>
        <DataSourceName>NAV</DataSourceName>
        <CommandText>select

[Document No_]
,l.[Routing No_] [Item No]
,l.[Operation No_]
,l.Description
, CASE 
	WHEN r.[Input Quantity] = 1 THEN l.[Setup Time]
	WHEN r.[Input Quantity] &gt; 1 THEN l.[Setup Time]/r.[Input Quantity]
 END TimeCharged
,r.[Run Time] RoutingTime
,r.[Input Quantity]
,l.[Posting Date]
,r.[Starting Date-Time] [Planned Start]
,r.[Ending Date-Time] [Planned End]

from [ZYGO$Capacity Ledger Entry] l

LEFT JOIN [ZYGO$Prod_ Order Routing Line] r ON l.[Document No_] = r.[Prod_ Order No_] and l.[Operation No_] = r.[Operation No_]


where  [Global Dimension 1 Code] = '5074'

AND CAST([Posting Date] as date) = CAST((GETDATE()-1) as date)

AND  CASE 
	WHEN r.[Input Quantity] = 1 THEN l.[Setup Time]
	WHEN r.[Input Quantity] &gt; 1 THEN l.[Setup Time]/r.[Input Quantity]
 END &gt; r.[Run Time]
</CommandText>
        <rd:UseGenericDesigner>true</rd:UseGenericDesigner>
      </Query>
      <Fields>
        <Field Name="Document_No_">
          <DataField>Document No_</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Item_No">
          <DataField>Item No</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Operation_No_">
          <DataField>Operation No_</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Description">
