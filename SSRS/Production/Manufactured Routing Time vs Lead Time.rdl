<?xml version="1.0" encoding="utf-8"?>
<Report MustUnderstand="df" xmlns="http://schemas.microsoft.com/sqlserver/reporting/2016/01/reportdefinition" xmlns:rd="http://schemas.microsoft.com/SQLServer/reporting/reportdesigner" xmlns:df="http://schemas.microsoft.com/sqlserver/reporting/2016/01/reportdefinition/defaultfontfamily">
  <df:DefaultFontFamily>Segoe UI</df:DefaultFontFamily>
  <AutoRefresh>0</AutoRefresh>
  <DataSources>
    <DataSource Name="NAV">
      <DataSourceReference>NAV</DataSourceReference>
      <rd:SecurityType>None</rd:SecurityType>
      <rd:DataSourceID>8d5b5544-e5fa-490a-a5dc-5de36d5aef84</rd:DataSourceID>
    </DataSource>
  </DataSources>
  <DataSets>
    <DataSet Name="DataSet1">
      <Query>
        <DataSourceName>NAV</DataSourceName>
        <CommandText>WITH s1 AS
(
select

[Routing No_]
,[Version Code]
,SUM([Setup Time] + [Run Time] + [Wait Time] + [Move Time]) RoutingTime

from [ZYGO$Routing Line]

GROUP BY [Routing No_], [Version Code]
)
,s2 AS
(
SELECT

[Routing No_]
, MAX(RoutingTime) RoutingTime

FROM s1

GROUP BY [Routing No_]
)
,s3 AS
(
select 

No_
,[Lead Time Calculation]
,[Replenishment System]


FROM ZYGO$Item

WHERE [Replenishment System] = 1
)

select

*

FROM s2 INNER JOIN s3

ON s2.[Routing No_] = s3.No_</CommandText>
        <rd:UseGenericDesigner>true</rd:UseGenericDesigner>
      </Query>
      <Fields>
        <Field Name="Routing_No_">
          <DataField>Routing No_</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="RoutingTime">
          <DataField>RoutingTime</DataField>
          <rd:TypeName>System.Decimal</rd:TypeName>
        </Field>
        <Field Name="No_">
          <DataField>No_</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Lead_Time_Calculation">
          <DataField>Lead Time Calculation</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Replenishment_System">
          <DataField>Replenishment System</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
  </DataSets>
