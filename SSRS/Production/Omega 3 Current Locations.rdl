<?xml version="1.0" encoding="utf-8"?>
<Report MustUnderstand="df" xmlns="http://schemas.microsoft.com/sqlserver/reporting/2016/01/reportdefinition" xmlns:rd="http://schemas.microsoft.com/SQLServer/reporting/reportdesigner" xmlns:df="http://schemas.microsoft.com/sqlserver/reporting/2016/01/reportdefinition/defaultfontfamily">
  <df:DefaultFontFamily>Segoe UI</df:DefaultFontFamily>
  <AutoRefresh>0</AutoRefresh>
  <DataSources>
    <DataSource Name="NAV">
      <DataSourceReference>NAV</DataSourceReference>
      <rd:SecurityType>None</rd:SecurityType>
      <rd:DataSourceID>fcfa2edb-ed50-4d4d-abf1-74d670e56112</rd:DataSourceID>
    </DataSource>
  </DataSources>
  <DataSets>
    <DataSet Name="DataSet1">
      <Query>
        <DataSourceName>NAV</DataSourceName>
        <CommandText>WITH s1 AS
(
SELECT 

cle.*

FROM [ZYGO$Capacity Ledger Entry] cle

INNER JOIN [ZYGO$Prod_ Order Line] dl ON cle.[Document No_] = dl.[Prod_ Order No_]

WHERE 

cle.[Item No_] IN 
		(
			 'CEA-F710483-3-IMP-B'
			,'CEA-F712PD17TO0483-3'
			,'CEA-F712PD17TO0482-3'
			,'CEA-F712PD17TO0476-3'
			,'LL-AAA08-105746'
		)

AND dl.Status = 3
)
,s2 AS
(
SELECT

[Document No_]
,MAX([Operation No_]) CurrentOperation

FROM s1

GROUP BY [Document No_]
)
,s3 AS
(
select s2.* 
,r.[Previous Operation No_]

from s2 

INNER JOIN [ZYGO$Prod_ Order Routing Line] r

ON s2.[Document No_] = r.[Prod_ Order No_]

AND s2.CurrentOperation = r.[Operation No_]
)
/*
SELECT 

s1.[Document No_]
,MAX([Posting Date]) LastOpFinished

FROM s1 INNER JOIN s3 ON s1.[Document No_] = s3.[Document No_] and s1.[Operation No_] = s3.[Previous Operation No_]

GROUP BY s1.[Document No_]
*/
,s4 AS
(
SELECT 

s1.[Document No_]
,MAX([Posting Date]) LastScan

FROM s1 INNER JOIN s2 ON s1.[Document No_] = s2.[Document No_] and s1.[Operation No_] = s2.[CurrentOperation]

GROUP BY s1.[Document No_]
)
,s5 AS
(
select 

s4.*
,DATEDIFF(DAY, LastScan, GETDATE()) DaysSinceLastScan

FROM s4
)
,s6 AS
(
select

s5.*
,s1.[Operation No_]
,[Work Center No_]
,Description
,s1.[Item No_]

from s5

INNER JOIN s1 ON s5.[Document No_] = s1.[Document No_] and s5.LastScan = s1.[Posting Date]

INNER JOIN s2 ON s2.[Document No_] = s1.[Document No_] and s2.CurrentOperation = s1.[Operation No_]
)

select distinct

s6.* 
, p.Description ItemDescription
,p.Reference SerialNo

from s6

LEFT JOIN [ZYGO$Production Order] p ON s6.[Document No_] = p.No_

--order by s1.[Document No_]</CommandText>
        <rd:UseGenericDesigner>true</rd:UseGenericDesigner>
      </Query>
      <Fields>
        <Field Name="Document_No_">
          <DataField>Document No_</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="LastScan">
          <DataField>LastScan</DataField>
          <rd:TypeName>System.DateTime</rd:TypeName>
        </Field>
        <Field Name="DaysSinceLastScan">
          <DataField>DaysSinceLastScan</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
        <Field Name="Operation_No_">
          <DataField>Operation No_</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Work_Center_No_">
          <DataField>Work Center No_</DataField>
