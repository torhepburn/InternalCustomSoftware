<?xml version="1.0" encoding="utf-8"?>
<Report MustUnderstand="df" xmlns="http://schemas.microsoft.com/sqlserver/reporting/2016/01/reportdefinition" xmlns:rd="http://schemas.microsoft.com/SQLServer/reporting/reportdesigner" xmlns:df="http://schemas.microsoft.com/sqlserver/reporting/2016/01/reportdefinition/defaultfontfamily">
  <df:DefaultFontFamily>Segoe UI</df:DefaultFontFamily>
  <AutoRefresh>0</AutoRefresh>
  <DataSources>
    <DataSource Name="Maintenance">
      <ConnectionProperties>
        <DataProvider>SQL</DataProvider>
        <ConnectString>Data Source=ct-mid-sql11;Initial Catalog=Maintenance</ConnectString>
      </ConnectionProperties>
      <rd:SecurityType>DataBase</rd:SecurityType>
      <rd:DataSourceID>8e8ae155-4223-45b3-91b9-50ccea2e28e2</rd:DataSourceID>
    </DataSource>
  </DataSources>
  <DataSets>
    <DataSet Name="DataSet1">
      <Query>
        <DataSourceName>Maintenance</DataSourceName>
        <CommandText>With s1 As 
 ( 
  Select  
  equipmentID 
  ,TaskGroup 
  ,RTrim(taskgroup) + '-' + CAST(COUNT(taskgroup) AS VARCHAR) TaskGroupCount 
  FROM Tasks 
  GROUP BY EquipmentID, TaskGroup 
  ) 
  SELECT h.id work_request_number 
  ,h.severity Priority 
  ,h.repaircategory category 
  ,h.reporteddate 
  ,h.equipmentID 
  ,o.owner 
  ,s1.taskgroupcount 
  ,h.issue task 
  ,h.status 
  ,v.name AssignedTo 
  ,IIF(ReportedBy = 4, 'Preventive Maintenance', vv.name) ReportedBy
,Repairdate
  FROM repair_history h 
  INNER JOIN equipment q ON 
  h.EquipmentID = q.EquipmentID 
  INNER JOIN locations l on q.locationid = l.id 
  LEFT JOIN view_employees_all_local v 
  ON h.AssignedTo = v.id 
  LEFT JOIN view_employees_all_local vV 
  ON h.ReportedBy = vv.id 
  LEFT JOIN s1 ON h.equipmentID = s1.equipmentID and h.taskgroup = s1.taskgroup 
  INNER JOIN owners o on q.ownerid = o.id 
  WHERE 1=1 
--  AND o.Owner = @Owner
--AND repaircategory = @Category
--  AND h.status   
AND l.SiteID = 1 
  ORDER BY h.id DESC</CommandText>
        <rd:UseGenericDesigner>true</rd:UseGenericDesigner>
      </Query>
      <Fields>
        <Field Name="work_request_number">
          <DataField>work_request_number</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
        <Field Name="Priority">
          <DataField>Priority</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="category">
