<?xml version="1.0" encoding="utf-8"?>
<Report MustUnderstand="df" xmlns="http://schemas.microsoft.com/sqlserver/reporting/2016/01/reportdefinition" xmlns:rd="http://schemas.microsoft.com/SQLServer/reporting/reportdesigner" xmlns:df="http://schemas.microsoft.com/sqlserver/reporting/2016/01/reportdefinition/defaultfontfamily">
  <df:DefaultFontFamily>Segoe UI</df:DefaultFontFamily>
  <AutoRefresh>0</AutoRefresh>
  <DataSources>
    <DataSource Name="NAV">
      <DataSourceReference>NAV</DataSourceReference>
      <rd:SecurityType>None</rd:SecurityType>
      <rd:DataSourceID>3ab11984-ae4b-4f2d-931d-6889ef9a1612</rd:DataSourceID>
    </DataSource>
  </DataSources>
  <DataSets>
    <DataSet Name="DataSet1">
      <Query>
        <DataSourceName>NAV</DataSourceName>
        <CommandText>WITH s1 AS
(
select

[Due Date]
,[Item No_]
,[Prod_ Order No_]
,[Quantity]

from [ZYGO$Prod_ Order Line]

WHERE [Item No_] IN

(
		 'CEA-F710483-3-IMP-B'
		,'CEA-F712PD17TO0483-3'
		,'CEA-F712PD17TO0482-3'
		,'CEA-F712PD17TO0476-3'
		,'LL-AAA08-105746'
)

AND Status = 3
)
,s2 AS
(
SELECT 

s1.[Item No_]
,MAX(l.[Operation No_]) Operation
,s1.[Prod_ Order No_]

FROM [ZYGO$Capacity Ledger Entry] l

INNER JOIN s1 ON s1.[Prod_ Order No_] = l.[Document No_]

GROUP BY s1.[Item No_], s1.[Prod_ Order No_]
)
,s3 AS
(
select 

s2.*
,r.Description
,r.[Lot Size]


from s2

INNER JOIN [ZYGO$Prod_ Order Routing Line] r ON s2.[Prod_ Order No_] = r.[Prod_ Order No_] AND s2.Operation = r.[Operation No_]
)
,s4 AS
(
SELECT

Description
,[Item No_]

,COUNT([Lot Size]) Number

FROM s3

GROUP BY [Item No_], Description
)
, s5a AS
(
SELECT 

*

FROM s4 WHERE Description = '5125 QA CMM Inspect'
)
, s5b AS
(
SELECT 

*

FROM s4 WHERE Description = '5135 Clean/Inspect/Contact'
)
, s5c AS
(
SELECT 

*

FROM s4 WHERE Description = '5145 Generate 60" G001 (LRM)'
)
, s5d AS
(
SELECT 

*

FROM s4 WHERE Description = '5177 Polish - 96" RP002 [LRM]'
)
, s5e AS
(
SELECT 

*

FROM s4 WHERE Description = '5185 CNC - MAHO DMU80 NC021 (LRM)'
)
, s5f AS
(
SELECT 

*

FROM s4 WHERE Description = '5185 CNC - MAHO NC021 (LRM)'
)
, s5g AS
(
SELECT 

*

FROM s4 WHERE Description = '5210 Edge Polish-Lovati'
)
, s5h AS
(
SELECT 

*

FROM s4 WHERE Description = '5210 Etch M010'
)
, s5j AS
(
SELECT 

*

FROM s4 WHERE Description = '5210 Fused Silica Inspection'
)
,s5k AS
(
SELECT 

*

FROM s4 WHERE Description = '5210 Grind - Trizact 50" LP001'
)
,s5m AS
(
SELECT 

*

FROM s4 WHERE Description = '5210 Lapping SLG 50 LP001'
)
,s5n AS
(
SELECT 

*

FROM s4 WHERE Description = '5210 Polish Double sided FineLP001'
)
,s5p AS
(
SELECT 

*

FROM s4 WHERE Description = '5215 Serialize - Laser Mark'
)
,s5q AS
(
SELECT 

*

FROM s4 WHERE Description = '5230 Edge Polish EP001'
)
,s5r AS
(
SELECT 

*

FROM s4 WHERE Description = '5230 MRF - Q22-750P MRF003 [LRM]'
)
,s5s AS
(
SELECT 

*

FROM s4 WHERE Description = '5230 MRF Q22-750P MRF 003[LRM]'
)
,s5t AS
(
SELECT 

*

FROM s4 WHERE Description = '5230 New View MRF'
)
,s6 AS
(
	select * FROM s5a
	UNION ALL
	select * FROM s5b
	UNION ALL
	select * FROM s5c
	UNION ALL
	select * FROM s5d
	UNION ALL
	select * FROM s5e
	UNION ALL
	select * FROM s5f
	UNION ALL
	select * FROM s5g
	UNION ALL
	select * FROM s5h
	UNION ALL
	select * FROM s5j
	UNION ALL
	select * FROM s5k
	UNION ALL
	select * FROM s5m
	UNION ALL
	select * FROM s5n
	UNION ALL
	select * FROM s5p
	UNION ALL
	select * FROM s5q
	UNION ALL
	select * FROM s5r
	UNION ALL
	select * FROM s5s
	UNION ALL
	select * FROM s5t


)
, s7 AS
(
select

Description
,COALESCE(CASE [Item No_]
	WHEN 'CEA-F710483-3-IMP-B' THEN Number
END,0) 'CEA-F710483-3-IMP-B'
,COALESCE(CASE [Item No_]
	WHEN 'CEA-F712PD17TO0483-3' THEN Number
END,0) 'CEA-F712PD17TO0483-3'
,COALESCE(CASE [Item No_]
	WHEN 'CEA-F712PD17TO0482-3' THEN Number
END,0) 'CEA-F712PD17TO0482-3'
,COALESCE(CASE [Item No_]
	WHEN 'CEA-F712PD17TO0476-3' THEN Number
END,0) 'CEA-F712PD17TO0476-3'
,COALESCE(CASE [Item No_]
	WHEN 'LL-AAA08-105746' THEN Number
END,0) 'LL-AAA08-105746'

from s6
)

SELECT

Description
,SUM([CEA-F710483-3-IMP-B]) [IMP-B]
,SUM([CEA-F712PD17TO0482-3]) [Vacuum]
,SUM([CEA-F712PD17TO0476-3]) [Grating]
,SUM([LL-AAA08-105746]) [Debris]
,SUM([CEA-F710483-3-IMP-B]) +
SUM([CEA-F712PD17TO0483-3]) +
SUM([CEA-F712PD17TO0482-3]) +
SUM([CEA-F712PD17TO0476-3]) +
SUM([LL-AAA08-105746]) [sum]

FROM s7

GROUP BY Description

ORDER BY Description</CommandText>
        <rd:UseGenericDesigner>true</rd:UseGenericDesigner>
      </Query>
      <Fields>
        <Field Name="Description">
          <DataField>Description</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="IMP_B">
          <DataField>IMP-B</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
        <Field Name="Vacuum">
          <DataField>Vacuum</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
        <Field Name="Grating">
          <DataField>Grating</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
        <Field Name="Debris">
          <DataField>Debris</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
        <Field Name="sum">
          <DataField>sum</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
  </DataSets>
