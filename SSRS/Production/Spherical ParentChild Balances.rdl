<?xml version="1.0" encoding="utf-8"?>
<Report xmlns="http://schemas.microsoft.com/sqlserver/reporting/2016/01/reportdefinition" xmlns:rd="http://schemas.microsoft.com/SQLServer/reporting/reportdesigner" xmlns:df="http://schemas.microsoft.com/sqlserver/reporting/2016/01/reportdefinition/defaultfontfamily" MustUnderstand="df">
  <df:DefaultFontFamily>Segoe UI</df:DefaultFontFamily>
  <AutoRefresh>0</AutoRefresh>
  <DataSources>
    <DataSource Name="NAV">
      <DataSourceReference>NAV</DataSourceReference>
      <rd:SecurityType>None</rd:SecurityType>
      <rd:DataSourceID>6ff004c7-2b22-40f3-aeb6-9c0d684aea83</rd:DataSourceID>
    </DataSource>
  </DataSources>
  <DataSets>
    <DataSet Name="DataSet1">
      <Query>
        <DataSourceName>NAV</DataSourceName>
        <CommandText>/*
SELECT * FROM [ZYGO$Production BOM Line]  WHERE [Production BOM No_] = '08A0010'

AND No_ IN (select No_ from [ZYGO$Production BOM Header] where [Status] = 3)

order by No_
*/

WITH s1 AS
(
SELECT 

[Item No_]
,SUM(Quantity) OnHand

FROM [ZYGO$Item Ledger Entry] WHERE [Item No_] IN


(
SELECT DISTINCT l.No_ FROM [ZYGO$Production BOM Line] l

INNER JOIN ZYGO$Item i ON l.[Production BOM No_] = i.No_

WHERE 

[Product Types] IN ('SPH', 'SPO', 'SPR')

AND [Signal Code] &lt;&gt; 'OBS'

AND i.No_ Not Like '%FAI'
)

GROUP BY [Item No_]

UNION ALL

SELECT

[Item No_]
,SUM(Quantity) FROM [ZYGO$Item Ledger Entry] WHERE [Item No_] IN
(
SELECT No_ FROM ZYGO$Item

WHERE 

[Product Types] IN ('SPH', 'SPO', 'SPR')

AND [Signal Code] &lt;&gt; 'OBS'

AND No_ Not Like '%FAI'
)

GROUP BY [Item No_]
)

SELECT

i.No_
,OnHand
,i.[Inventory Posting Group]

FROM s1 INNER JOIN ZYGO$Item i on s1.[Item No_] = i.No_

ORDER BY No_</CommandText>
        <rd:UseGenericDesigner>true</rd:UseGenericDesigner>
      </Query>
      <Fields>
        <Field Name="No_">
          <DataField>No_</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="OnHand">
          <DataField>OnHand</DataField>
          <rd:TypeName>System.Decimal</rd:TypeName>
        </Field>
        <Field Name="Inventory_Posting_Group">
          <DataField>Inventory Posting Group</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
  </DataSets>
