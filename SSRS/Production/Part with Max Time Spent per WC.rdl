  <df:DefaultFontFamily>Segoe UI</df:DefaultFontFamily>
  <AutoRefresh>0</AutoRefresh>
  <DataSources>
    <DataSource Name="NAV">
      <DataSourceReference>NAV</DataSourceReference>
      <rd:SecurityType>None</rd:SecurityType>
      <rd:DataSourceID>d6dc52eb-3bb5-4741-bb71-3cb9efa0424d</rd:DataSourceID>
    </DataSource>
  </DataSources>
  <DataSets>
    <DataSet Name="DataSet1">
      <Query>
        <DataSourceName>NAV</DataSourceName>
        <CommandText>WITH s1 AS
(
SELECT

No_
,[Document No_]
,[Operation No_]
,Description
,[Routing No_]
,SUM(Quantity) TimeSpent

FROM [ZYGO$Capacity Ledger Entry]

WHERE [Global Dimension 2 Code] in ('LFO VALUE STREAM','PO VALUE STREAM')

--No_ = '525'

AND [Posting Date] &gt; DATEADD(yy, -1, GETDATE())

GROUP BY 

No_
,[Document No_]
,[Operation No_]
,Description
,[Routing No_]
)
,s2 AS
(
	SELECT

	MAX(TimeSpent) MaxTimeSpent
	,No_
	,[Routing No_]
	,[Operation No_]
	,Description

	FROM s1

	GROUP BY 

	No_
	,[Operation No_]
	,Description
	,[Routing No_]

	HAVING MAX(TimeSpent) &gt; .1
)
,s3 AS
(
	select 

	No_
	,MAX(MaxTimeSpent) LinkTime

	FROM s2

	GROUP BY No_
)

SELECT distinct

s2.*

FROM s3

LEFT JOIN s2 ON s3.LinkTime = s2.MaxTimeSpent

AND s3.No_ = s2.No_

ORDER BY s2.No_--MAX(TimeSpent) DESC</CommandText>
        <rd:UseGenericDesigner>true</rd:UseGenericDesigner>
      </Query>
      <Fields>
        <Field Name="MaxTimeSpent">
          <DataField>MaxTimeSpent</DataField>
          <rd:TypeName>System.Decimal</rd:TypeName>
        </Field>
        <Field Name="No_">
          <DataField>No_</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Routing_No_">
          <DataField>Routing No_</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Operation_No_">
          <DataField>Operation No_</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Description">
          <DataField>Description</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
  </DataSets>
