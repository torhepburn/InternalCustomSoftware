<?xml version="1.0" encoding="utf-8"?>
<Report MustUnderstand="df" xmlns="http://schemas.microsoft.com/sqlserver/reporting/2016/01/reportdefinition" xmlns:rd="http://schemas.microsoft.com/SQLServer/reporting/reportdesigner" xmlns:df="http://schemas.microsoft.com/sqlserver/reporting/2016/01/reportdefinition/defaultfontfamily">
  <df:DefaultFontFamily>Segoe UI</df:DefaultFontFamily>
  <AutoRefresh>0</AutoRefresh>
  <DataSources>
    <DataSource Name="NAV">
      <DataSourceReference>NAV</DataSourceReference>
      <rd:SecurityType>None</rd:SecurityType>
      <rd:DataSourceID>604fd8b8-2f65-427a-aa53-97f3889aa269</rd:DataSourceID>
    </DataSource>
  </DataSources>
  <DataSets>
    <DataSet Name="DataSet1">
      <Query>
        <DataSourceName>NAV</DataSourceName>
        <CommandText>WITH s1 AS
(
select

MIN([Posting Date]) FirstPosting
,MAX([Posting Date]) LastPosting
,DATEDIFF(DAY,MIN([Posting Date]),MAX([Posting Date])) DaysOnStep
,cle.[Document No_]
,cle.No_
,cle.Description

FROM [ZYGO$Capacity Ledger Entry] cle

INNER JOIN [ZYGO$Prod_ Order Line] dl ON cle.[Document No_] = dl.[Prod_ Order No_]

WHERE [Global Dimension 2 Code] in ('LFO VALUE STREAM','PO VALUE STREAM')

AND dl.Status = 3

GROUP By  cle.No_, cle.Description, cle.[Document No_]
)
,s2 AS
(
SELECT 

MAX(DaysOnStep) maxDaysOnStep
,No_

FROM s1

GROUP BY No_
)

select

s1.No_ WorkCenter
,s1.Description
,s1.DaysOnStep
,s1.[Document No_] WorkOrder

FROM s1 INNER JOIN s2 ON s1.DaysOnStep = s2.maxDaysOnStep and s1.No_ = s2.No_

WHERE maxDaysOnStep &gt; 0

ORDER BY s1.No_
</CommandText>
        <rd:UseGenericDesigner>true</rd:UseGenericDesigner>
      </Query>
      <Fields>
        <Field Name="WorkCenter">
          <DataField>WorkCenter</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Description">
          <DataField>Description</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="DaysOnStep">
          <DataField>DaysOnStep</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
        <Field Name="WorkOrder">
          <DataField>WorkOrder</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
  </DataSets>
