  <DataSources>
    <DataSource Name="NAV">
      <DataSourceReference>NAV</DataSourceReference>
      <rd:SecurityType>None</rd:SecurityType>
      <rd:DataSourceID>d16ae3c5-1027-4bdd-9e29-fec435fef5d4</rd:DataSourceID>
    </DataSource>
  </DataSources>
  <DataSets>
    <DataSet Name="DataSet1">
      <Query>
        <DataSourceName>NAV</DataSourceName>
        <CommandText>WITH s1 AS
(
	SELECT

	MAX([Entry No_]) maxEntryNo
	,[Primary Key Field 2 Value] OrderNo
	,[Primary Key Field 3 Value]

	FROM [ZYGO$Change Log Entry] e

	where [Table No_] = 37

	AND [Field No_] IN (5791) 

	AND CAST([Date and Time] AS date) = DATEADD(dd,-1,CAST(GETDATE() AS date))

	AND [Old Value] != '2050-12-30'

	AND LEN([Old Value]) &gt; 0

	AND LEN([New Value]) != 0

	GROUP BY 

	 [Primary Key Field 2 Value] 
	,[Primary Key Field 3 Value]
)
, s2 AS
(
SELECT

[User ID]
,[Old Value] [Old Promised Delivery Date]
,[New Value] [New Promised Delivery Date]
,[Primary Key Field 2 Value] OrderNo
,e.[Primary Key Field 3 Value]

FROM [ZYGO$Change Log Entry] e

INNER JOIN s1 ON s1.maxEntryNo = e.[Entry No_]


)
,s3 AS
(
select 

MAX([Entry No_]) mEntryNo
,[Document No_]
,[SO Line No_]
,CAST([Last Date Modified] AS date) lmd

FROM [ZYGO$Change Sales Date Reason Entry]

WHERE CAST([Last Date Modified] AS date) = DATEADD(dd,-1,CAST(GETDATE() AS date))

GROUP BY

[Document No_]
,[SO Line No_]
,CAST([Last Date Modified] AS date) 
)
,s4 AS
(
SELECT

e.[Document No_]
,e.[SO Line No_]
,e.[Change Date Reason Code]

FROM [ZYGO$Change Sales Date Reason Entry] e

INNER JOIN s3 ON mEntryNo = [Entry No_]
)

select 

s2.* 
,sl.[SO Line No_]
,sl.No_
,sl.Description
,sl.[Outstanding Quantity]
,sl.[Line Amount]
,sl.[Shortcut Dimension 2 Code]
,s4.[Change Date Reason Code] + ' : ' + r.Description Reason
,sh.[Sell-to Customer Name]

from s2

LEFT JOIN [ZYGO$Sales Line] sl ON s2.OrderNo = sl.[Document No_]

	AND s2.[Primary Key Field 3 Value] = sl.[Line No_]

INNER JOIN [ZYGO$Sales Header] sh ON sh.No_ = sl.[Document No_]

LEFT JOIN s4 ON s4.[Document No_] = s2.OrderNo AND s4.[SO Line No_] = sl.[SO Line No_]

LEFT JOIN [ZYGO$Change Date Reasons] r ON s4.[Change Date Reason Code] = r.Code

WHERE sl.[SO Line No_] &lt; 500

AND sl.No_ NOT IN ('FREIGHT', 'FREIGHT INT''L')

ORDER BY [New Promised Delivery Date]</CommandText>
        <rd:UseGenericDesigner>true</rd:UseGenericDesigner>
      </Query>
      <Fields>
        <Field Name="User_ID">
          <DataField>User ID</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Old_Promised_Delivery_Date">
          <DataField>Old Promised Delivery Date</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="New_Promised_Delivery_Date">
