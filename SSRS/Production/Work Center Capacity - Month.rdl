<?xml version="1.0" encoding="utf-8"?>
<Report MustUnderstand="df" xmlns="http://schemas.microsoft.com/sqlserver/reporting/2016/01/reportdefinition" xmlns:rd="http://schemas.microsoft.com/SQLServer/reporting/reportdesigner" xmlns:df="http://schemas.microsoft.com/sqlserver/reporting/2016/01/reportdefinition/defaultfontfamily">
  <df:DefaultFontFamily>Segoe UI</df:DefaultFontFamily>
  <AutoRefresh>0</AutoRefresh>
  <DataSources>
    <DataSource Name="NAV_TEST">
      <DataSourceReference>NAV_TEST</DataSourceReference>
      <rd:SecurityType>None</rd:SecurityType>
      <rd:DataSourceID>aacebd95-e187-4b9f-b20f-bd02c69a7d2f</rd:DataSourceID>
    </DataSource>
  </DataSources>
  <DataSets>
    <DataSet Name="DataSet1">
      <Query>
        <DataSourceName>NAV_TEST</DataSourceName>
        <QueryParameters>
          <QueryParameter Name="@start">
            <Value>=Parameters!start.Value</Value>
          </QueryParameter>
          <QueryParameter Name="@end">
            <Value>=Parameters!end.Value</Value>
          </QueryParameter>
        </QueryParameters>
        <CommandText>WITH s1 AS
(
select

No_
, CASE 
	WHEN CHARINDEX('-',No_) = 0 THEN SUM([Capacity (Total)])
	WHEN CHARINDEX('-',No_) &gt; 0 THEN SUM([Capacity (Effective)])
END Capacity
,YEAR(Date) [Year]
,MONTH(Date) [Month]

from [ZYGO$Calendar Entry] --LEFT(No_,3) = '161'

WHERE Date &gt;= @start and Date &lt;= @end

GROUP BY No_,YEAR(Date),MONTH(Date)

)
,s2 AS
(
SELECT 

No_
,SUM([Allocated Time]) Allocated
,YEAR(Date) [Year]
,MONTH(Date) [Month]

FROM [ZYGO$Prod_ Order Capacity Need]

WHERE Date &gt;= @start and Date &lt;= @end
--and MONTH(Date) = @month

--AND YEAR(Date) = @year

GROUP BY No_,YEAR(Date),MONTH(Date)

)
,s3 AS
(
	SELECT

	No_
	,Name

	FROM [ZYGO$Machine Center]

	--WHERE [Work Center No_] IN ('161')
)
,s4 AS
(
	SELECT
	
	No_
	,Name

	FROM [ZYGO$Work Center]
)
,s5 AS
(
SELECT

s2.No_
,CASE 
	WHEN s3.Name is null THEN s4.Name
	WHEN s3.Name is not null THEN s3.Name
END Name
,s1.Capacity
,s2.Allocated
,FORMAT(s2.Allocated/s1.Capacity,'P') Load
,s1.[Month]
,s1.[Year]


FROM s1 Right JOIN s2 ON s1.No_ = s2.No_ AND s1.[Year] = s2.[Year] and s1.[Month] = s2.[Month]

LEFT JOIN s3 ON s2.No_ = s3.No_

LEFT JOIN s4 ON s4.No_ = s2.No_

WHERE LEFT(s2.No_,3) = '161'
)
,s6 as
(
SELECT

[Month]
, [Year]
,CAST([Month] as varchar(2)) + '-' + CAST([Year] as varchar(4)) Heading
,ROW_NUMBER() OVER (ORDER BY [Year],[Month]) as row

from s5

GROUP BY [Year], [Month]

)
,sC1 AS
(
select 

No_
,Capacity
,Allocated
,Load
,Heading


from s5

INNER JOIN s6 ON s6.[Year] = s5.[Year] AND s6.Month = s5.Month

WHERE s6.row = 1
)
,sC2 AS
(
select 

No_
,Capacity
,Allocated
,Load
,Heading
from s5

INNER JOIN s6 ON s6.[Year] = s5.[Year] AND s6.Month = s5.Month

WHERE s6.row = 2
)
,sC3 AS
(
select 

No_
,Capacity
,Allocated
,Load
,Heading
from s5

INNER JOIN s6 ON s6.[Year] = s5.[Year] AND s6.Month = s5.Month

WHERE s6.row = 3
)
,sC4 AS
(
select 

No_
,Capacity
,Allocated
,Load
,Heading
from s5

INNER JOIN s6 ON s6.[Year] = s5.[Year] AND s6.Month = s5.Month

WHERE s6.row = 4
)
,sC5 AS
(
select 

No_
,Capacity
,Allocated
,Load
,Heading
from s5

INNER JOIN s6 ON s6.[Year] = s5.[Year] AND s6.Month = s5.Month

WHERE s6.row = 5
)
,sC6 AS
(
select 

No_
,Capacity
,Allocated
,Load
,Heading
from s5

INNER JOIN s6 ON s6.[Year] = s5.[Year] AND s6.Month = s5.Month

WHERE s6.row = 6
)


select DISTINCT

s5.No_
,s5.[Name]
,COALESCE(sC1.Heading,'') c1
,COALESCE(sC1.Capacity,0) c1capacity
,COALESCE(sC1.Allocated,0) c1allocated
,COALESCE(sC1.[Load],'')	 c1load
,COALESCE(sC2.Heading,'') c2
,COALESCE(sC2.Capacity,0) c2capacity
,COALESCE(sC2.Allocated,0)c2allocated
,COALESCE(sC2.[Load],'0')	c2load
,COALESCE(sC3.Heading,'') c3
,COALESCE(sC3.Capacity,0) c3capacity
,COALESCE(sC3.Allocated,0) c3allocated
,COALESCE(sC3.[Load],'0') c3load
,COALESCE(sC4.Heading,'') c4
,COALESCE(sC4.Capacity,0) c4capacity
,COALESCE(sC4.Allocated,0) c4allocated
,COALESCE(sC4.[Load],'0')	c4load
,COALESCE(sC5.Heading,'') c5
,COALESCE(sC5.Capacity,0) c5capacity
,COALESCE(sC5.Allocated,0) c5allocated
,COALESCE(sC5.[Load],'0') c5load
,COALESCE(sC6.Heading,'') c6
,COALESCE(sC6.Capacity,0) c6capacity
,COALESCE(sC6.Allocated,0) c6allocated
,COALESCE(sC6.[Load],'0')	c6load



from s5 LEFT JOIN sC1 ON s5.No_ = sC1.No_

LEFT JOIN sC2 ON s5.No_ = sC2.No_
LEFT JOIN sC3 ON s5.No_ = sC3.No_
LEFT JOIN sC4 ON s5.No_ = sC4.No_
LEFT JOIN sC5 ON s5.No_ = sC5.No_
LEFT JOIN sC6 ON s5.No_ = sC6.No_
 
 ORDER BY No_</CommandText>
        <rd:UseGenericDesigner>true</rd:UseGenericDesigner>
      </Query>
