<?xml version="1.0" encoding="utf-8"?>
<Report MustUnderstand="df" xmlns="http://schemas.microsoft.com/sqlserver/reporting/2016/01/reportdefinition" xmlns:rd="http://schemas.microsoft.com/SQLServer/reporting/reportdesigner" xmlns:df="http://schemas.microsoft.com/sqlserver/reporting/2016/01/reportdefinition/defaultfontfamily">
  <df:DefaultFontFamily>Segoe UI</df:DefaultFontFamily>
  <AutoRefresh>0</AutoRefresh>
  <DataSources>
    <DataSource Name="NAV">
      <DataSourceReference>NAV</DataSourceReference>
      <rd:SecurityType>None</rd:SecurityType>
      <rd:DataSourceID>60cc35d5-a125-4ef6-8c4d-f2985785fe20</rd:DataSourceID>
    </DataSource>
  </DataSources>
  <DataSets>
    <DataSet Name="DataSet1">
      <Query>
        <DataSourceName>NAV</DataSourceName>
        <QueryParameters>
          <QueryParameter Name="@start">
            <Value>=Parameters!start.Value</Value>
          </QueryParameter>
          <QueryParameter Name="@workCenter">
            <Value>=Parameters!workCenter.Value</Value>
          </QueryParameter>
          <QueryParameter Name="@end">
            <Value>=Parameters!end.Value</Value>
          </QueryParameter>
          <QueryParameter Name="@status">
            <Value>=Parameters!status.Value</Value>
            <rd:UserDefined>true</rd:UserDefined>
          </QueryParameter>
        </QueryParameters>
        <CommandText>/*	v04-29-24   */

WITH s1 AS
(
select

No_
,SUM([Capacity (Effective)]) Capacity
,YEAR(Date) [Year]
,MONTH(Date) [Month]

from [ZYGO$Calendar Entry] 

WHERE Date &gt;= @start and Date &lt;= DATEADD(MONTH,17,@start)

GROUP BY No_,YEAR(Date),MONTH(Date)

)
,s11 AS
(
	select

	 No_
	,Capacity
	,CAST([Month] as varchar(2)) + '-' + CAST([Year] as varchar(4)) Heading
	,[Year]
	,[Month]
	,ROW_NUMBER() OVER (ORDER BY [Year],[Month]) as row

	from s1

	WHERE No_ IN (@workCenter)

)
,s2 AS
(
SELECT 

No_
,SUM([Allocated Time]) Allocated
,YEAR(Date) [Year]
,MONTH(Date) [Month]

FROM [ZYGO$Prod_ Order Capacity Need]

WHERE Date &gt;= @start and Date &lt;= @end

AND Status IN (@status)

GROUP BY No_,YEAR(Date),MONTH(Date)

)
,s3 AS
(
	SELECT

	No_
	,Name
	,Capacity
	,Efficiency

	FROM [ZYGO$Machine Center]
)
,s4 AS
(
	SELECT
	
	No_
	,Name
	,Capacity
	,Efficiency
	,[Shop Calendar Code]

	FROM [ZYGO$Work Center]
)
,s5 AS
(
SELECT

s2.No_
,CASE 
	WHEN s3.Name is null THEN s4.Name
	WHEN s3.Name is not null THEN s3.Name
END Name
,CASE 
	WHEN s3.Name is null THEN s4.Capacity
	WHEN s3.Name is not null THEN s3.Capacity
END cCapacity
,CASE 
	WHEN s3.Name is null THEN s4.Efficiency
	WHEN s3.Name is not null THEN s3.Efficiency
END cEfficiency
,CASE 
	WHEN s3.Name is null THEN s4.[Shop Calendar Code]
	WHEN s3.Name is not null THEN ''
END [Shop Calendar Code]
,s11.Capacity
,s2.Allocated
,FORMAT(s2.Allocated/s11.Capacity,'P') Load
,s11.[Month]
,s11.[Year]


FROM s11 LEFT JOIN s2 ON s11.No_ = s2.No_ AND s11.[Year] = s2.[Year] and s11.[Month] = s2.[Month]

LEFT JOIN s3 ON s2.No_ = s3.No_

LEFT JOIN s4 ON s4.No_ = s2.No_

WHERE s2.No_ IN (@workCenter)
)
,s12 AS
(
select

s11.No_
,s5.Name
,s5.cCapacity
,s5.cEfficiency
,s5.[Shop Calendar Code]
--,s5.Capacity
,s11.Capacity Capacitym
,s5.Allocated
,s5.Load
,s11.Heading
--,s11.Month
--,s11.Year
,s11.row


from s11

LEFT JOIN s5 on s11.No_ = s5.No_ and s11.[Year] = s5.[Year] AND s11.[Month] = s5.[Month]
)
,sCH AS
(
	SELECT DISTINCT

	s12.No_
	,s12.Name
	,s12.cCapacity WorkCenterCapacity
	,s12.cEfficiency WorkCenterEfficiency
	,s12.[Shop Calendar Code]

	FROM s12
)
,sC1 AS
(
select 

Heading
,Capacitym
,COALESCE(Allocated,0) Allocated
,COALESCE(Load,'0') Load
,No_

from s12

WHERE s12.row = 1
)
,sC2 AS
(
select 

Heading
,Capacitym
,COALESCE(Allocated,0) Allocated
,COALESCE(Load,'0') Load
,No_

from s12

WHERE s12.row = 2
)
,sC3 AS
(
select 

Heading
,Capacitym Capacity
,COALESCE(Allocated,0) Allocated
,COALESCE(Load,'0') Load
,No_

from s12

WHERE s12.row = 3
)
,sC4 AS
(
select 

Heading
,Capacitym Capacity
,COALESCE(Allocated,0) Allocated
,COALESCE(Load,'0') Load
,No_

from s12

WHERE s12.row = 4
)
,sC5 AS
(
select 

Heading
,Capacitym Capacity
,COALESCE(Allocated,0) Allocated
,COALESCE(Load,'0') Load
,No_

from s12

WHERE s12.row = 5
)
,sC6 AS
(
select 

Heading
,Capacitym Capacity
,COALESCE(Allocated,0) Allocated
,COALESCE(Load,'0') Load
,No_

from s12

WHERE s12.row = 6
)
,sC7 AS
(
select 

Heading
,Capacitym
,COALESCE(Allocated,0) Allocated
,COALESCE(Load,'0') Load
,No_

from s12

WHERE s12.row = 7
)
,sC8 AS
(
select 

Heading
,Capacitym
,COALESCE(Allocated,0) Allocated
,COALESCE(Load,'0') Load
,No_

from s12

WHERE s12.row = 8
)
,sC9 AS
(
select 

Heading
,Capacitym Capacity
,COALESCE(Allocated,0) Allocated
,COALESCE(Load,'0') Load
,No_

from s12

WHERE s12.row = 9
)
,sC10 AS
(
select 

Heading
,Capacitym Capacity
,COALESCE(Allocated,0) Allocated
,COALESCE(Load,'0') Load
,No_

from s12

WHERE s12.row = 10
)
,sC11 AS
(
select 

Heading
,Capacitym Capacity
,COALESCE(Allocated,0) Allocated
,COALESCE(Load,'0') Load
,No_

from s12

WHERE s12.row = 11
)
,sC12 AS
(
select 

Heading
,Capacitym Capacity
,COALESCE(Allocated,0) Allocated
,COALESCE(Load,'0') Load
,No_

