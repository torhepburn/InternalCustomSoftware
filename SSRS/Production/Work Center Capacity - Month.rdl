select DISTINCT

s5.No_
,s5.[Name]
,s5.cCapacity WorkCenterCapacity
,s5.cEfficiency WorkCenterEfficiency
,s5.[Shop Calendar Code]
,COALESCE(sC1.Heading,'') c1
,COALESCE(sC1.Capacity,0) c1capacity
,COALESCE(sC1.Allocated,0) c1allocated
,COALESCE(sC1.[Load],'')	 c1load
,COALESCE(sC2.Heading,'') c2
,COALESCE(sC2.Capacity,0) c2capacity
,COALESCE(sC2.Allocated,0)c2allocated
,COALESCE(sC2.[Load],'0')	c2load
,COALESCE(sC3.Heading,'') c3
