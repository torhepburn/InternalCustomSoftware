select

sCH.No_
,sCH.Name
,sCH.WorkCenterCapacity
,sCH.WorkCenterEfficiency
,sCH.[Shop Calendar Code]
,sC1.Heading [M1 Date]
,sC1.Capacitym [M1 Capacity]
,sC1.Allocated [M1 Allocated]
,sC1.Load [M1 Load]
,sC2.Heading [M2 Date]
,sC2.Capacitym [M2 Capacity]
,sC2.Allocated [M2 Allocated]
,sC2.Load [M2 Load]
,sC3.Heading [M3 Date]
,sC3.Capacity [M3 Capacity]
,sC3.Allocated [M3 Allocated]
,sC3.Load [M3 Load]
,sC4.Heading [M4 Date]
,sC4.Capacity [M4 Capacity]
,sC4.Allocated [M4	Allocated]
,sC4.Load [M4 Load]
,sC5.Heading [M5 Date]
,sC5.Capacity [M5 Capacity]
,sC5.Allocated [M5 Allocated]
,sC5.Load [M5 Load]
,sC6.Heading [M6 Date]
,sC6.Capacity [M6 Capacity]
,sC6.Allocated [M6 Allocated]
,sC6.Load [M6 Load]
,sC7.Heading [M7 Date]
,sC7.Capacitym [M7 Capacity]
,sC7.Allocated [M7 Allocated]
,sC7.Load [M7 Load]
,sC8.Heading [M8 Date]
,sC8.Capacitym [M8 Capacity]
,sC8.Allocated [M8 Allocated]
,sC8.Load [M8 Load]
,sC9.Heading [M9 Date]
,sC9.Capacity [M9 Capacity]
,sC9.Allocated [M9 Allocated]
,sC9.Load [M9 Load]
,sC10.Heading [M10 Date]
,sC10.Capacity [M10 Capacity]
,sC10.Allocated [M10 Allocated]
,sC10.Load [M10 Load]
,sC11.Heading [M11 Date]
,sC11.Capacity [M11 Capacity]
,sC11.Allocated [M11 Allocated]
,sC11.Load [M11 Load]
,sC12.Heading [M12 Date]
,sC12.Capacity [M12 Capacity]
,sC12.Allocated [M12 Allocated]
,sC12.Load [M12 Load]
,sC13.Heading [M13 Date]
,sC13.Capacity [M13 Capacity]
,sC13.Allocated [M13 Allocated]
,sC13.Load [M13 Load]
,sC14.Heading [M14 Date]
,sC14.Capacity [M14 Capacity]
,sC14.Allocated [M14 Allocated]
,sC14.Load [M14 Load]
,sC15.Heading [M15 Date]
,sC15.Capacity [M15 Capacity]
,sC15.Allocated [M15 Allocated]
,sC15.Load [M15 Load]
,sC16.Heading [M16 Date]
,sC16.Capacity [M16 Capacity]
,sC16.Allocated [M16 Allocated]
,sC16.Load [M16 Load]
,sC17.Heading [M17 Date]
,sC17.Capacity [M17 Capacity]
,sC17.Allocated [M17 Allocated]
,sC17.Load [M17 Load]
,sC18.Heading [M18 Date]
,sC18.Capacity [M18 Capacity]
,sC18.Allocated [M18 Allocated]
,sC18.Load [M18 Load]

from sCH

LEFT JOIN sC1 ON sCH.No_ = sC1.No_
LEFT JOIN sC2 ON sC1.No_ = sC2.No_
LEFT JOIN sC3 ON sC1.No_ = sC3.No_
LEFT JOIN sC4 ON sCH.No_ = sC4.No_
LEFT JOIN sC5 ON sC1.No_ = sC5.No_
LEFT JOIN sC6 ON sC1.No_ = sC6.No_
LEFT JOIN sC7 ON sCH.No_ = sC7.No_
LEFT JOIN sC8 ON sC1.No_ = sC8.No_
LEFT JOIN sC9 ON sC1.No_ = sC9.No_
LEFT JOIN sC10 ON sCH.No_ = sC10.No_
LEFT JOIN sC11 ON sC1.No_ = sC11.No_
LEFT JOIN sC12 ON sC1.No_ = sC12.No_
LEFT JOIN sC13 ON sCH.No_ = sC13.No_
LEFT JOIN sC14 ON sC1.No_ = sC14.No_
LEFT JOIN sC15 ON sC1.No_ = sC15.No_
LEFT JOIN sC16 ON sCH.No_ = sC16.No_
LEFT JOIN sC17 ON sC1.No_ = sC17.No_
LEFT JOIN sC18 ON sC1.No_ = sC18.No_


WHERE Name is not null

ORDER BY sCH.No_</CommandText>
        <rd:UseGenericDesigner>true</rd:UseGenericDesigner>
      </Query>
