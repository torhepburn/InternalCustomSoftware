,COALESCE(sC8.Heading,'') c8
,COALESCE(sC8.Capacity,0) c8capacity
,COALESCE(sC8.Allocated,0) c8allocated
,COALESCE(sC8.[Load],'0')	c8load
,COALESCE(sC9.Heading,'') c9
,COALESCE(sC9.Capacity,0) c9capacity
,COALESCE(sC9.Allocated,0) c9allocated
,COALESCE(sC9.[Load],'0') c9load
,COALESCE(sC10.Heading,'') c10
,COALESCE(sC10.Capacity,0) c10capacity
,COALESCE(sC10.Allocated,0) c10allocated
,COALESCE(sC10.[Load],'0')	c10load
,COALESCE(sC11.Heading,'') c11
,COALESCE(sC11.Capacity,0) c11capacity
,COALESCE(sC11.Allocated,0) c11allocated
,COALESCE(sC11.[Load],'')	 c11load
,COALESCE(sC12.Heading,'') c12
,COALESCE(sC12.Capacity,0) c12capacity
,COALESCE(sC12.Allocated,0)c12allocated
,COALESCE(sC12.[Load],'0')	c12load
,COALESCE(sC13.Heading,'') c13
,COALESCE(sC13.Capacity,0) c13capacity
,COALESCE(sC13.Allocated,0) c13allocated
,COALESCE(sC13.[Load],'0') c13load
,COALESCE(sC14.Heading,'') c14
,COALESCE(sC14.Capacity,0) c14capacity
,COALESCE(sC14.Allocated,0) c14allocated
,COALESCE(sC14.[Load],'0')	c14load
,COALESCE(sC15.Heading,'') c15
,COALESCE(sC15.Capacity,0) c15capacity
,COALESCE(sC15.Allocated,0) c15allocated
,COALESCE(sC15.[Load],'0') c15load
,COALESCE(sC16.Heading,'') c16
,COALESCE(sC16.Capacity,0) c16capacity
,COALESCE(sC16.Allocated,0) c16allocated
,COALESCE(sC16.[Load],'0')	c16load
,COALESCE(sC17.Heading,'') c17
,COALESCE(sC17.Capacity,0) c17capacity
,COALESCE(sC17.Allocated,0) c17allocated
,COALESCE(sC17.[Load],'0') c17load
,COALESCE(sC18.Heading,'') c18
,COALESCE(sC18.Capacity,0) c18capacity
,COALESCE(sC18.Allocated,0) c18allocated
,COALESCE(sC18.[Load],'0')	c18load



from s5 LEFT JOIN sC1 ON s5.No_ = sC1.No_

LEFT JOIN sC2 ON s5.No_ = sC2.No_
LEFT JOIN sC3 ON s5.No_ = sC3.No_
LEFT JOIN sC4 ON s5.No_ = sC4.No_
LEFT JOIN sC5 ON s5.No_ = sC5.No_
LEFT JOIN sC6 ON s5.No_ = sC6.No_
LEFT JOIN sC7 ON s5.No_ = sC7.No_
LEFT JOIN sC8 ON s5.No_ = sC8.No_
LEFT JOIN sC9 ON s5.No_ = sC9.No_
LEFT JOIN sC10 ON s5.No_ = sC10.No_
LEFT JOIN sC11 ON s5.No_ = sC11.No_
LEFT JOIN sC12 ON s5.No_ = sC12.No_
LEFT JOIN sC13 ON s5.No_ = sC13.No_
LEFT JOIN sC14 ON s5.No_ = sC14.No_
LEFT JOIN sC15 ON s5.No_ = sC15.No_
LEFT JOIN sC16 ON s5.No_ = sC16.No_
LEFT JOIN sC17 ON s5.No_ = sC17.No_
LEFT JOIN sC18 ON s5.No_ = sC18.No_


 ORDER BY No_</CommandText>
