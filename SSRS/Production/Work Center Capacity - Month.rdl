<?xml version="1.0" encoding="utf-8"?>
<Report MustUnderstand="df" xmlns="http://schemas.microsoft.com/sqlserver/reporting/2016/01/reportdefinition" xmlns:rd="http://schemas.microsoft.com/SQLServer/reporting/reportdesigner" xmlns:df="http://schemas.microsoft.com/sqlserver/reporting/2016/01/reportdefinition/defaultfontfamily">
  <df:DefaultFontFamily>Segoe UI</df:DefaultFontFamily>
  <AutoRefresh>0</AutoRefresh>
  <DataSources>
    <DataSource Name="DataSource1">
      <DataSourceReference>NAV</DataSourceReference>
      <rd:SecurityType>None</rd:SecurityType>
      <rd:DataSourceID>8db72374-f845-44c6-b048-b2d8c5d46e0a</rd:DataSourceID>
    </DataSource>
  </DataSources>
  <DataSets>
    <DataSet Name="DataSet1">
      <Query>
        <DataSourceName>DataSource1</DataSourceName>
        <QueryParameters>
          <QueryParameter Name="@start">
            <Value>=Parameters!start.Value</Value>
          </QueryParameter>
          <QueryParameter Name="@end">
            <Value>=Parameters!end.Value</Value>
          </QueryParameter>
          <QueryParameter Name="@workCenter">
            <Value>=Parameters!workCenter.Value</Value>
          </QueryParameter>
          <QueryParameter Name="@status">
            <Value>=Parameters!Status.Value</Value>
            <rd:UserDefined>true</rd:UserDefined>
          </QueryParameter>
        </QueryParameters>
        <CommandText>WITH s1 AS
(
select

No_
,SUM([Capacity (Effective)]) Capacity
,YEAR(Date) [Year]
,MONTH(Date) [Month]

from [ZYGO$Calendar Entry] 

WHERE Date &gt;= @start and Date &lt;= @end

GROUP BY No_,YEAR(Date),MONTH(Date)

)
,s2 AS
(
SELECT 

No_
,SUM([Allocated Time]) Allocated
,YEAR(Date) [Year]
,MONTH(Date) [Month]

FROM [ZYGO$Prod_ Order Capacity Need]

WHERE Date &gt;= @start and Date &lt;= @end

AND Status IN (@status)

GROUP BY No_,YEAR(Date),MONTH(Date)

)
,s3 AS
(
	SELECT

	No_
	,Name
	,Capacity
	,Efficiency

	FROM [ZYGO$Machine Center]
)
,s4 AS
(
	SELECT
	
	No_
	,Name
	,Capacity
	,Efficiency
	,[Shop Calendar Code]

	FROM [ZYGO$Work Center]
)
,s5 AS
(
SELECT

s2.No_
,CASE 
	WHEN s3.Name is null THEN s4.Name
	WHEN s3.Name is not null THEN s3.Name
END Name
,CASE 
	WHEN s3.Name is null THEN s4.Capacity
	WHEN s3.Name is not null THEN s3.Capacity
END cCapacity
,CASE 
	WHEN s3.Name is null THEN s4.Efficiency
	WHEN s3.Name is not null THEN s3.Efficiency
END cEfficiency
,CASE 
	WHEN s3.Name is null THEN s4.[Shop Calendar Code]
	WHEN s3.Name is not null THEN ''
END [Shop Calendar Code]
,s1.Capacity
,s2.Allocated
,FORMAT(s2.Allocated/s1.Capacity,'P') Load
,s1.[Month]
,s1.[Year]


FROM s1 Right JOIN s2 ON s1.No_ = s2.No_ AND s1.[Year] = s2.[Year] and s1.[Month] = s2.[Month]

LEFT JOIN s3 ON s2.No_ = s3.No_

LEFT JOIN s4 ON s4.No_ = s2.No_

WHERE s2.No_ IN (@workCenter)
)
,s6 as
(
SELECT

[Month]
, [Year]
,CAST([Month] as varchar(2)) + '-' + CAST([Year] as varchar(4)) Heading
,ROW_NUMBER() OVER (ORDER BY [Year],[Month]) as row

from s5

GROUP BY [Year], [Month]

)
,sC1 AS
(
select 

No_
,Capacity
,Allocated
,Load
,Heading


from s5

INNER JOIN s6 ON s6.[Year] = s5.[Year] AND s6.Month = s5.Month

WHERE s6.row = 1
)
,sC2 AS
(
select 

No_
,Capacity
,Allocated
,Load
,Heading
from s5

INNER JOIN s6 ON s6.[Year] = s5.[Year] AND s6.Month = s5.Month

WHERE s6.row = 2
)
,sC3 AS
(
select 

No_
,Capacity
,Allocated
,Load
,Heading
from s5

INNER JOIN s6 ON s6.[Year] = s5.[Year] AND s6.Month = s5.Month

WHERE s6.row = 3
)
,sC4 AS
(
select 

No_
,Capacity
,Allocated
,Load
,Heading
from s5

INNER JOIN s6 ON s6.[Year] = s5.[Year] AND s6.Month = s5.Month

WHERE s6.row = 4
)
,sC5 AS
(
select 

No_
,Capacity
,Allocated
,Load
,Heading
from s5

INNER JOIN s6 ON s6.[Year] = s5.[Year] AND s6.Month = s5.Month

WHERE s6.row = 5
)
,sC6 AS
