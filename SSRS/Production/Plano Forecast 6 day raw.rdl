<?xml version="1.0" encoding="utf-8"?>
<Report MustUnderstand="df" xmlns="http://schemas.microsoft.com/sqlserver/reporting/2016/01/reportdefinition" xmlns:rd="http://schemas.microsoft.com/SQLServer/reporting/reportdesigner" xmlns:df="http://schemas.microsoft.com/sqlserver/reporting/2016/01/reportdefinition/defaultfontfamily">
  <df:DefaultFontFamily>Segoe UI</df:DefaultFontFamily>
  <AutoRefresh>0</AutoRefresh>
  <DataSources>
    <DataSource Name="NAV">
      <DataSourceReference>NAV</DataSourceReference>
      <rd:SecurityType>None</rd:SecurityType>
      <rd:DataSourceID>2b477980-ff17-4a8b-80be-261bdcbf3071</rd:DataSourceID>
    </DataSource>
  </DataSources>
  <DataSets>
    <DataSet Name="DataSet1">
      <Query>
        <DataSourceName>NAV</DataSourceName>
        <CommandText>with s1 AS
(
select

[Starting Date-Time]
,CAST([Ending Date-Time] as date) [Expected Coompletion Date]
,[Prod_ Order No_]
,[Operation No_]
,CASE [Routing Status]
	WHEN 1 THEN 'Planned'
	WHEN 2 THEN 'In Progress'
	WHEN 3 THEN 'Finished'
	ELSE ''
END [Routing Status]
,[Expected Operation Cost Amt_]
,[Operation Complete]
,[Input Quantity]

,[Routing No_]
,[Work Center No_]
,[Description]


 from [ZYGO$Prod_ Order Routing Line]

where [Work Center No_] IN ('278','281','282','283','430','432','433','434','435','440','445','460','461','462','465','472')

AND [Status] = 3  --Released

AND CAST([Ending Date-Time] as date) &gt; CAST((GETDATE()-1) as date)

AND CAST([Ending Date-Time] as date) &lt;= CAST((GETDATE()+6) as date)

)

select

*

from s1


ORDER BY [Expected Coompletion Date],[Work Center No_]</CommandText>
        <rd:UseGenericDesigner>true</rd:UseGenericDesigner>
      </Query>
      <Fields>
        <Field Name="Starting_Date_Time">
          <DataField>Starting Date-Time</DataField>
          <rd:TypeName>System.DateTime</rd:TypeName>
        </Field>
        <Field Name="Expected_Coompletion_Date">
          <DataField>Expected Coompletion Date</DataField>
          <rd:TypeName>System.DateTime</rd:TypeName>
        </Field>
        <Field Name="Prod__Order_No_">
          <DataField>Prod_ Order No_</DataField>
