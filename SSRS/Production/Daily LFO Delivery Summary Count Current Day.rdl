<?xml version="1.0" encoding="utf-8"?>
<Report MustUnderstand="df" xmlns="http://schemas.microsoft.com/sqlserver/reporting/2016/01/reportdefinition" xmlns:rd="http://schemas.microsoft.com/SQLServer/reporting/reportdesigner" xmlns:df="http://schemas.microsoft.com/sqlserver/reporting/2016/01/reportdefinition/defaultfontfamily">
  <df:DefaultFontFamily>Segoe UI</df:DefaultFontFamily>
  <AutoRefresh>0</AutoRefresh>
  <DataSources>
    <DataSource Name="AFE">
      <DataSourceReference>AFE</DataSourceReference>
      <rd:SecurityType>None</rd:SecurityType>
      <rd:DataSourceID>874b6aa6-fdef-4e76-bb3a-cb069658171d</rd:DataSourceID>
    </DataSource>
  </DataSources>
  <DataSets>
    <DataSet Name="DataSet1">
      <Query>
        <DataSourceName>AFE</DataSourceName>
        <CommandText>WITH s1 AS	/*	start date	*/
(
	SELECT 
	   [OrderNo]
      ,[Operation]
      ,[Item]
      ,[ItemDescription]
      ,MIN([StartTime]) firstScan

  FROM [CT-MID-DB01.AMETEK.com].Dashboard.[dbo].[TimecardNAVProdHours]

  where [Item] IN 
		(
			 'CEA-F710483-3-IMP-B'
			,'CEA-F712PD17TO0483-3'
			,'CEA-F712PD17TO0482-3'
			,'CEA-F712PD17TO0476-3'
			,'LL-AAA08-105746'
		)

AND [WorkCenter] IN ( 
   '224'
  ,'226'
  ,'227'
  ,'228'
  ,'229'
  ,'230'
  ,'231'
  ,'232'
  ,'234'
  ,'236'
  ,'238'
  ,'239'
  ,'240'
  ,'245'
  ,'246'
  ,'247'
  ,'269'
  ,'276'
  )


  GROUP BY 

       [OrderNo]
      ,[Operation]
      ,[Item]
      ,[ItemDescription]
)
,s2 AS		/*	end based on start plus routing run time	*/
(
select 

s1.Item
,s1.ItemDescription
,s1.OrderNo
,s1.Operation
,s1.firstScan
,l.[Run Time]
,DATEADD(hh, [Run Time], firstScan) PlannedEnd

FROM s1

LEFT JOIN NAVprodOrdRoutingLine l ON s1.OrderNo = l.[Prod_ Order No_] AND s1.operation = l.[Operation No_]
)
,s3 AS	/*	completed operations  */
(
	SELECT 
	   [OrderNo]
      ,[Operation]
      ,[Item]
      ,[ItemDescription]
      ,MAX([EndTime]) CompletionDate


  FROM [CT-MID-DB01.AMETEK.com].Dashboard.[dbo].[TimecardNAVProdHours]


  where [item] IN 
		(
			 'CEA-F710483-3-IMP-B'
			,'CEA-F712PD17TO0483-3'
			,'CEA-F712PD17TO0482-3'
			,'CEA-F712PD17TO0476-3'
			,'LL-AAA08-105746'
		)

AND [WorkCenter] IN ( 
   '224'
  ,'226'
  ,'227'
  ,'228'
  ,'229'
  ,'230'
  ,'231'
  ,'232'
  ,'234'
  ,'236'
  ,'238'
  ,'239'
  ,'240'
  ,'245'
  ,'246'
  ,'247'
  ,'269'
  ,'276'
  )

  AND Complete = 1

  GROUP BY 

       [OrderNo]
      ,[Operation]
      ,[Item]
      ,[ItemDescription]
)

SELECT 

COUNT(Operation) [Planned End Today]
,CAST(GETDATE() as date) [Planned End Date]

FROM s2 WHERE CAST(PlannedEnd as date) = CAST(GETDATE() as date)</CommandText>
        <rd:UseGenericDesigner>true</rd:UseGenericDesigner>
      </Query>
      <Fields>
        <Field Name="Planned_End_Today">
          <DataField>Planned End Today</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
        <Field Name="Planned_End_Date">
          <DataField>Planned End Date</DataField>
          <rd:TypeName>System.DateTime</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
  </DataSets>
