<?xml version="1.0" encoding="utf-8"?>
<Report MustUnderstand="df" xmlns="http://schemas.microsoft.com/sqlserver/reporting/2016/01/reportdefinition" xmlns:rd="http://schemas.microsoft.com/SQLServer/reporting/reportdesigner" xmlns:df="http://schemas.microsoft.com/sqlserver/reporting/2016/01/reportdefinition/defaultfontfamily">
  <df:DefaultFontFamily>Segoe UI</df:DefaultFontFamily>
  <AutoRefresh>0</AutoRefresh>
  <DataSources>
    <DataSource Name="AFE">
      <DataSourceReference>AFE</DataSourceReference>
      <rd:SecurityType>None</rd:SecurityType>
      <rd:DataSourceID>a76bb32b-28b0-4acd-9952-583d56ab4665</rd:DataSourceID>
    </DataSource>
  </DataSources>
  <DataSets>
    <DataSet Name="DataSet1">
      <Query>
        <DataSourceName>AFE</DataSourceName>
        <CommandText>WITH s1 AS	/*	start date	*/
(
	SELECT 
	   [OrderNo]
      ,[Operation]
      ,[Item]
      ,[ItemDescription]
      ,MIN([StartTime]) firstScan

  FROM [MIDDB01.zygo.com].Dashboard.[dbo].[TimecardNAVProdHours]

  where [item] IN 
		(
			 'CEA-F710483-3-IMP-B'
			,'CEA-F712PD17TO0483-3'
			,'CEA-F712PD17TO0482-3'
			,'CEA-F712PD17TO0476-3'
			,'LL-AAA08-105746'
		)

AND [WorkCenter] IN ( 
   '224'
  ,'226'
  ,'227'
  ,'228'
  ,'229'
  ,'230'
  ,'231'
  ,'232'
  ,'234'
  ,'236'
  ,'238'
  ,'239'
  ,'240'
  ,'245'
  ,'246'
  ,'247'
  ,'269'
  ,'276'
  )


  GROUP BY 

       [OrderNo]
      ,[Operation]
      ,[Item]
      ,[ItemDescription]
)
,s2 AS		/*	end based on start plus routing run time	*/
(
select 

s1.Item
,s1.ItemDescription
,s1.OrderNo
,s1.Operation
,s1.firstScan
,l.[Run Time]
,DATEADD(hh, [Run Time], firstScan) PlannedEnd

FROM s1

LEFT JOIN NAVprodOrdRoutingLine l ON s1.OrderNo = l.[Prod_ Order No_] AND s1.operation = l.[Operation No_]
)
,s3 AS	/*	completed operations  */
(
	SELECT 
	   [OrderNo]
      ,[Operation]
      ,[Item]
      ,[ItemDescription]
      ,MAX([EndTime]) CompletionDate


  FROM [MIDDB01.zygo.com].Dashboard.[dbo].[TimecardNAVProdHours]


  where [Item] IN 
		(
			 'CEA-F710483-3-IMP-B'
			,'CEA-F712PD17TO0483-3'
			,'CEA-F712PD17TO0482-3'
			,'CEA-F712PD17TO0476-3'
			,'LL-AAA08-105746'
		)

AND [WorkCenter] IN ( 
   '224'
  ,'226'
  ,'227'
  ,'228'
  ,'229'
  ,'230'
  ,'231'
  ,'232'
  ,'234'
  ,'236'
  ,'238'
  ,'239'
  ,'240'
  ,'245'
  ,'246'
  ,'247'
  ,'269'
  ,'276'
  )

  AND Complete = 1

  GROUP BY 

       [OrderNo]
      ,[Operation]
      ,[Item]
      ,[ItemDescription]

)

/*
select 

Item
,ItemDescription
,OrderNo
,Operation
,firstScan
,[Run Time]
,PlannedEnd
,'' CompletionDate

from s2 WHERE CAST(PlannedEnd as date) = '2024-04-17'

UNION ALL

SELECT 

Item
,ItemDescription
,OrderNo
,Operation
,''
,0
,''
,CompletionDate

FROM s3 

WHERE CAST(CompletionDate as date) = '2024-04-17'

ORDER BY 

OrderNo
,Operation

*/
,s4 AS
(
SELECT 

COUNT(Operation) PlannedEnd
,0 [Actual]
,CAST(DATEADD(dd, -1, GETDATE()) as date)DataDate


FROM s2 WHERE CAST(PlannedEnd as date) = CAST(DATEADD(dd, -1, GETDATE()) as date)

UNION

SELECT

0
,COUNT(Operation) Completed
,CAST(DATEADD(dd, -1, GETDATE()) as date) DataDate

FROM s3 

WHERE CAST(CompletionDate as date) =  CAST(DATEADD(dd, -1, GETDATE()) as date)
)

SELECT

MAX(PLannedEnd) PlannedEnd
,MAX(Actual) Actual
,DataDate

FROM s4 GROUP BY DataDate</CommandText>
        <rd:UseGenericDesigner>true</rd:UseGenericDesigner>
      </Query>
      <Fields>
        <Field Name="PlannedEnd">
          <DataField>PlannedEnd</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
        <Field Name="Actual">
          <DataField>Actual</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
        <Field Name="DataDate">
          <DataField>DataDate</DataField>
          <rd:TypeName>System.DateTime</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
  </DataSets>
