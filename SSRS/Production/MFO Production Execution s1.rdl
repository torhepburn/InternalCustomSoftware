<?xml version="1.0" encoding="utf-8"?>
<Report MustUnderstand="df" xmlns="http://schemas.microsoft.com/sqlserver/reporting/2016/01/reportdefinition" xmlns:rd="http://schemas.microsoft.com/SQLServer/reporting/reportdesigner" xmlns:df="http://schemas.microsoft.com/sqlserver/reporting/2016/01/reportdefinition/defaultfontfamily">
  <df:DefaultFontFamily>Segoe UI</df:DefaultFontFamily>
  <AutoRefresh>0</AutoRefresh>
  <DataSources>
    <DataSource Name="NAV">
      <DataSourceReference>NAV</DataSourceReference>
      <rd:SecurityType>None</rd:SecurityType>
      <rd:DataSourceID>460eb947-45a8-43bc-8ba0-8c1286326a13</rd:DataSourceID>
    </DataSource>
  </DataSources>
  <DataSets>
    <DataSet Name="DataSet1">
      <Query>
        <DataSourceName>NAV</DataSourceName>
        <CommandText>WITH s1 AS	/*	open work orders SO extracted if possible	*/
(
select 

o.[Shortcut Dimension 2 Code]
,o.No_ [WO Number]
,l.[Remaining Quantity]
,CASE 
	WHEN LEFT(o.[Source No_],5) = 'ASML-' THEN REPLACE(o.[Source No_],'ASML-','')
	WHEN LEFT(o.[Source No_],6) = 'L3HAR-' THEN REPLACE(o.[Source No_],'L3HAR-','')
	ELSE o.[Source No_]
 END [Source No_]
 ,o.Description
,o.[Due Date]
,CASE 
	WHEN o.Status = 2 THEN 'Planned - Not Started'
	ELSE
		CASE	
			WHEN o.[Due Date] &lt; GETDATE() THEN 'Behind'
			WHEN o.[Due Date] &gt; GETDATE() THEN 'On Target'
			ELSE 'Unknown'
			END
		END [WO Status]
,Reference r1
,CASE
	WHEN LEN(Reference) &gt; 0 THEN
		CASE
			WHEN [Assigned User ID] = 'AMETEK-AD\DWOOLLEY' THEN 
				CASE
					WHEN LEFT(Reference, 1) IN ('1','9') THEN TRIM(LEFT(Reference,5))
					ELSE ''
				END
			WHEN [Assigned User ID] = 'AMETEK-AD\LPEREZ' THEN
				CASE 
					WHEN LEFT(Reference, 3) = 'SO ' THEN  SUBSTRING(Reference,4,5)
					WHEN LEFT(Reference, 4) = 'SO #' THEN  SUBSTRING(Reference,6,5)
					WHEN LEFT(Reference, 3) = 'SO#' THEN  SUBSTRING(Reference,5,5)
					ELSE ''
				END
				ELSE ''
			END
		ELSE ''
	END SO
	,CASE l.[Overtime Applicable]
	WHEN 0 THEN ''
	WHEN 1 THEN 'Yes'
	WHEN 2 THEN 'No'
	WHEN 3 THEN 'Silent'
	ELSE 'na'
END [Overtime Applicable]
,l.[Job No_]
,o.[Inventory Posting Group] ipg

from [ZYGO$Production Order] o

INNER JOIN [ZYGO$Prod_ Order Line] l ON o.No_ = l.[Prod_ Order No_]

WHERE [Assigned User ID] IN ('AMETEK-AD\DWOOLLEY','AMETEK-AD\LPEREZ')

AND o.Status IN (2,3)	--3 = Released  2 = Firm Planned

AND o.Quantity &gt; 0

OR o.[Source No_] IN 

	(select DISTINCT [Item No_] from [ZYGO$Planning Component]

	WHERE [Item No_] IN

		(
		select distinct [Source No_]

		FROM [ZYGO$Production Order]

		WHERE [Assigned User ID] IN ('AMETEK-AD\DWOOLLEY','AMETEK-AD\LPEREZ')

		AND [Location Code] = 'MID'

		AND Status IN (2,3)	--3 = Released  2 = Firm Planned
		)
	)
	
	AND o.Status IN (2,3)	--3 = Released  2 = Firm Planned

	AND o.[Location Code] = 'MID'

AND o.[Due Date] &lt;&gt; '2050-12-30'
)
,s1d as		/*	s1 distinct removing duplicates	*/
(
	select distinct * from s1
)
,s2a AS		/*	WO part number matches sales order line part number - add sales price	*/
(
	select

	 [Document No_] SalesOrder 
	,sl. No_
	,h.[Sell-to Customer Name]
	,[Unit Price]
	,s1d.*

	from [ZYGO$Sales Line] sl

	INNER JOIN [ZYGO$Sales Header] h ON sl.[Document No_] = h.No_

	INNER JOIN s1d ON s1d.SO = h.No_ and s1d.[Source No_] = sl.No_

	where  [Outstanding Quantity] &gt; 0

	AND [Unit Price] &gt; 0

	AND sl.[Location Code] = 'MID'
)
--select distinct * from s2a	/*	WO part number matches sales order line part number	*/

,s21 AS		/*	there is a sales order number and the part is FG and part does not match WO-SO	*/
(
	SELECT * FROM s1d

	WHERE [WO Number] NOT IN

	(select distinct [WO Number] from s2a)

	AND ipg = 'FG'

	AND LEN(SO) &gt; 0
)
,s2b AS		/*	ASML	*/
(
	select

	TRIM(SUBSTRING(Description,5,13)) ItemNo
	,AVG([Unit Price]) uPrice
	,[Sell-to Customer No_]

	from [ZYGO$Sales Line] 

	WHERE 

	[Sell-to Customer No_] = 'C00049' 

	AND SUBSTRING(Description,5, 1) = '4'

	AND [Outstanding Quantity] &gt; 0

	GROUP BY 

	TRIM(SUBSTRING(Description,5,13))
	,[Sell-to Customer No_]
)
,s2c AS		/*	LL	*/
(
	select

	 No_ ItemNo
	,AVG([Unit Price]) uPrice
	,[Sell-to Customer No_]
	from [ZYGO$Sales Line] 

	WHERE 

	[Sell-to Customer No_] = 'C00150' 

	AND LEFT(No_,2) = 'LL'

	AND [Outstanding Quantity] &gt; 0

	GROUP BY 

	No_
	,[Sell-to Customer No_]
)
,s2d AS		/*	CEA	*/
(
	select

	 No_ ItemNo
	,AVG([Unit Price]) uPrice
	,[Sell-to Customer No_]

	from [ZYGO$Sales Line] 

	WHERE 

	[Sell-to Customer No_] = 'C00151' 

	AND LEFT(No_,3) = 'CEA'

	AND [Outstanding Quantity] &gt; 0

	GROUP BY 

	No_
	,[Sell-to Customer No_]
)
,s2e AS		/*	HIWIN	*/
(
	select

	 No_ ItemNo
	,AVG([Unit Price]) uPrice
	,[Sell-to Customer No_]

	from [ZYGO$Sales Line] 

	WHERE 

	[Sell-to Customer No_] = 'C00279' 

	AND LEFT(No_,2) = 'HI'

	AND [Outstanding Quantity] &gt; 0

	GROUP BY 

	No_
	,[Sell-to Customer No_]
)
,s2f AS		/*	PB&amp;J	*/
(
	select

	 'PBJ-ZNS-150X3' ItemNo
	,AVG([Unit Price]) uPrice
	,[Sell-to Customer No_]

	from [ZYGO$Sales Line] 

	WHERE 

	[Sell-to Customer No_] = 'C00237'

	AND LEFT(No_,2) != 'FR'

	AND [Outstanding Quantity] &gt; 0

	GROUP BY 

	No_
	,[Sell-to Customer No_]
)
,s2g AS		/*	Northrup Grumman	*/
(
	select

	 No_ ItemNo
	,AVG([Unit Price]) uPrice
	,[Sell-to Customer No_]

	from [ZYGO$Sales Line] 

	WHERE 

	[Sell-to Customer No_] = 'C00090'

	AND LEFT(No_,2) != 'FR'

	AND LEFT(No_,2) != 'PR'

	AND [Outstanding Quantity] &gt; 0

	GROUP BY 

	No_
	,[Sell-to Customer No_]
)
,s2h AS		/*	L3 Harris	*/
(
	select

	 TRIM(SUBSTRING(Description,5,7)) ItemNo
	,AVG([Unit Price]) uPrice
	,[Sell-to Customer No_]

	from [ZYGO$Sales Line] 

	WHERE 

	[Sell-to Customer No_] = 'C00044'

	--AND LEFT(No_,2) != 'FR'

	--AND LEFT(No_,2) != 'PR'

	AND SUBSTRING(Description,5, 3) = '103'

	AND [Outstanding Quantity] &gt; 0

	GROUP BY 

	TRIM(SUBSTRING(Description,5,7))
	,[Sell-to Customer No_]
)
,s2i AS		/*	Goodrich	*/
(
	select

	 No_ ItemNo
	,AVG([Unit Price]) uPrice
	,[Sell-to Customer No_]

	from [ZYGO$Sales Line] 

	WHERE 

	[Sell-to Customer No_] = 'C00053'

	AND LEFT(No_,2) NOT IN ('FR','PR','CE','SE','CO','EP','TR')

	AND LEFT(No_,2) != 'PR'

	--AND SUBSTRING(Description,5, 3) = '103'

	--AND [Outstanding Quantity] &gt; 0

	GROUP BY 

	No_
	,[Sell-to Customer No_]
)
,s2j AS		/*	AMETEK Germany	*/
(
	select

	 No_ ItemNo
	,AVG([Unit Price]) uPrice
	,[Sell-to Customer No_]

	from [ZYGO$Sales Line] 

	WHERE 

	[Sell-to Customer No_] = 'C00027'

	AND LEFT(No_,2) NOT IN ('FR','PR','CE','SE','CO','EP','TR')

	AND LEFT(No_, 2) = 'B7'

	--AND SUBSTRING(Description,5, 3) = '103'

	--AND [Outstanding Quantity] &gt; 0

	GROUP BY 

	No_
	,[Sell-to Customer No_]
)


,s3 AS	/*	combines parts with customer and price with internal items		*/
(
	select distinct *

	FROM s2a

	UNION ALL

	SELECT 

	'' SalesOrder 
	,'' No_
	,'INTERNAL' [Sell-to Customer Name]
	,0 [Unit Price]
	,s1d.*

	FROM s1d 

	WHERE ipg != 'FG'


)


/*

--order by r1
--WHERE

--[Source No_]  like 'AS%'

AND [Source No_] NOT like 'CEA%' 
AND [Source No_] NOT like 'LL%'
AND [Source No_] NOT like 'TH%'
AND [Source No_] NOT like 'SH%'
AND [Source No_] NOT like 'V47%'
AND [Source No_] NOT like 'HI%'
AND [Source No_] NOT like 'AWE%'
AND [Source No_] NOT like 'T4%'
AND [Source No_] NOT like 'B7%'
AND [Source No_] NOT like 'L3%'
AND [Source No_] NOT like 'PBJ%'
AND [Source No_] NOT like '4022%'
AND [Source No_] NOT like 'AV%'
AND [Source No_] NOT like 'UR%'
AND [Source No_] NOT like 'AMAT%'
AND [Source No_] NOT like 'ONTO%'

AND ipg = 'FG'

*
*/

-- * from s2h

,s22 AS		/*	combine s2letters with s1d - unit price		*/
(
select * from s1d

INNER JOIN s2b ON s1d.[Source No_] = s2b.ItemNo

UNION ALL

select * from s1d

INNER JOIN s2c ON s1d.[Source No_] = s2c.ItemNo

UNION ALL

select * from s1d

INNER JOIN s2d ON s1d.[Source No_] = s2d.ItemNo

UNION ALL

select * from s1d

INNER JOIN s2e ON s1d.[Source No_] = s2e.ItemNo

UNION ALL

select * from s1d

INNER JOIN s2f ON s1d.[Source No_] = s2f.ItemNo

UNION ALL

select * from s1d

INNER JOIN s2g ON s1d.[Source No_] = s2g.ItemNo

UNION ALL

select * from s1d

INNER JOIN s2h ON s1d.[Source No_] = s2h.ItemNo

UNION ALL

select * from s1d

INNER JOIN s2i ON s1d.[Source No_] = s2i.ItemNo

UNION ALL

select * from s1d

INNER JOIN s2j ON s1d.[Source No_] = s2j.ItemNo

)
,s4 as 
(
select distinct


[Shortcut Dimension 2 Code] [Value Stream]
,c.Name Customer
,[Job No_] [Job Number]
,SO [Sales Order Number]
,[Source No_] [Part Number]
,Description [Item Description]
,[WO Number]
,[Remaining Quantity] [WO Quantity]
,uPrice [Unit Price]
,r1 [S/N]
,[WO Status]
,[Due Date] [WO Due Date]
,[Overtime Applicable]

from s22

INNER JOIN ZYGO$Customer c ON s22.[Sell-to Customer No_] = c.No_

UNION ALL

SELECT

[Shortcut Dimension 2 Code]
,[Sell-to Customer Name]
,[Job No_]
,SO
,[Source No_] 
,Description
,[WO Number]
,[Remaining Quantity]
,[Unit Price]
,r1
,[WO Status]
,[Due Date]
,[Overtime Applicable]

FROM s3
)
, s5 AS
(
select distinct * FROM s4

UNION ALL

SELECT DISTINCT

[Shortcut Dimension 2 Code]
,''[Sell-to Customer Name]
,[Job No_]
,SO
,[Source No_] 
,Description
,[WO Number]
,[Remaining Quantity]
,0[Unit Price]
,r1
,[WO Status]
,[Due Date]
,[Overtime Applicable]

FROM s1d

WHERE [WO Number] NOT IN

(select distinct [WO Number] from s4)
)

select s5.* 

,COALESCE(h.[Govt_ Priority Rating Code],'') [Govt Rating Code]

from s5

LEFT JOIN [ZYGO$Sales Header] h on s5.[Sales Order Number] = h.No_
--
--order by 

--[Due Date]
--[WO Number]
--[Source No_]</CommandText>
        <rd:UseGenericDesigner>true</rd:UseGenericDesigner>
      </Query>
      <Fields>
        <Field Name="Value_Stream">
          <DataField>Value Stream</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Customer">
          <DataField>Customer</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Job_Number">
          <DataField>Job Number</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Sales_Order_Number">
          <DataField>Sales Order Number</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Part_Number">
          <DataField>Part Number</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Item_Description">
          <DataField>Item Description</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="WO_Number">
          <DataField>WO Number</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="WO_Quantity">
          <DataField>WO Quantity</DataField>
          <rd:TypeName>System.Decimal</rd:TypeName>
        </Field>
        <Field Name="Unit_Price">
          <DataField>Unit Price</DataField>
          <rd:TypeName>System.Decimal</rd:TypeName>
        </Field>
        <Field Name="S_N">
          <DataField>S/N</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="WO_Status">
          <DataField>WO Status</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="WO_Due_Date">
          <DataField>WO Due Date</DataField>
          <rd:TypeName>System.DateTime</rd:TypeName>
        </Field>
        <Field Name="Overtime_Applicable">
          <DataField>Overtime Applicable</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Govt_Rating_Code">
          <DataField>Govt Rating Code</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
