  <df:DefaultFontFamily>Segoe UI</df:DefaultFontFamily>
  <AutoRefresh>0</AutoRefresh>
  <DataSources>
    <DataSource Name="NAV">
      <DataSourceReference>NAV</DataSourceReference>
      <rd:SecurityType>None</rd:SecurityType>
      <rd:DataSourceID>b6a6c85a-605e-4cad-9b6b-f3ace37fb3aa</rd:DataSourceID>
    </DataSource>
  </DataSources>
  <DataSets>
    <DataSet Name="DataSet1">
      <Query>
        <DataSourceName>NAV</DataSourceName>
        <CommandText>WITH s1 AS
(
select

MIN([Posting Date]) FirstPosting
,MAX([Posting Date]) LastPosting
,DATEDIFF(DAY,MIN([Posting Date]),MAX([Posting Date])) DaysOnStep
,cle.[Document No_]
,cle.No_
,cle.Description

FROM [ZYGO$Capacity Ledger Entry] cle

INNER JOIN [ZYGO$Prod_ Order Line] dl ON cle.[Document No_] = dl.[Prod_ Order No_]

WHERE [Global Dimension 2 Code] in ('LFO VALUE STREAM','PO VALUE STREAM')

AND dl.Status = 3

GROUP By  cle.No_, cle.Description, cle.[Document No_]
)
,s2 AS
(
SELECT 

MAX(DaysOnStep) maxDaysOnStep
,No_

FROM s1

GROUP BY No_
)
,s3 AS
(
select

s1.No_ WorkCenter
,s1.Description
,s1.LastPosting
,s1.DaysOnStep
,s1.[Document No_] WorkOrder
,o.[Source No_] PartNumber
,o.Description PartDescription
,o.[Due Date]

FROM s1 INNER JOIN s2 ON s1.DaysOnStep = s2.maxDaysOnStep and s1.No_ = s2.No_

LEFT JOIN [ZYGO$Production Order] o ON s1.[Document No_] = o.No_

WHERE maxDaysOnStep &gt; 0
)

select distinct

s3.*
,l.[Cost Amount]

from s3

LEFT JOIN [ZYGO$Prod_ Order Line] l ON s3.WorkOrder = l.[Prod_ Order No_]


--ORDER BY WorkCenter



--select * from [ZYGO$Production Order] --where [Document No_] = 'PD512755'</CommandText>
        <rd:UseGenericDesigner>true</rd:UseGenericDesigner>
      </Query>
