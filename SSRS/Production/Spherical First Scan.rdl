  <AutoRefresh>0</AutoRefresh>
  <DataSources>
    <DataSource Name="AFE">
      <DataSourceReference>AFE</DataSourceReference>
      <rd:SecurityType>None</rd:SecurityType>
      <rd:DataSourceID>1ef60d3c-17c9-4e31-a9ed-6e982ba1d9d7</rd:DataSourceID>
    </DataSource>
  </DataSources>
  <DataSets>
    <DataSet Name="DataSet1">
      <Query>
        <DataSourceName>AFE</DataSourceName>
        <CommandText>SELECT 
	   [OrderNo]
      ,[Operation]
      ,[Item]
      ,[ItemDescription]
      --,[Job]
      --,[JobDescription]
      --,[WorkCenter]
      --,[WorkCenterDescription]
      --,[WorkCenterComponentType]
      --,[StepWorkCenter]
      --,[CostCenter]
      --,[CostCenterDescription]
      --,[TimecardNumber]
      --,[Qty]
      ,MIN([StartTime]) firstScan
      --,[EndTime]
      --,[Complete]
      --,[ApportionTime]
      --,[Apportioned]
      --,[ApportionTimeStamp]
      --,[SwipedOffUserID]
      --,[IsSwiped]
      --,[IsBackFlushOperation]
      --,[NAVUploadBatchID]
      --,[NAVUploadBatchID_Backflush]
      --,[Complete_WebserviceTransactionID]
      --,[Complete_WebserviceTransactionDateTime]
      --,[Complete_WebserviceTransactionUserID]
      --,[WebServiceTransactionID]
      --,[WebserviceTransactionDateTime]
      --,[WebserviceTransactionError]
      --,[CreatedOn]
      --,[CreatedBy]
      --,[LastUpdatedOn]
      --,[LastUpdatedBy]
  FROM [CT-MID-DB01.AMETEK.com].Dashboard.[dbo].[TimecardNAVProdHours]

  where costcenter = '5074'

  GROUP BY 

       [OrderNo]
      ,[Operation]
      ,[Item]
      ,[ItemDescription]

  order by OrderNo</CommandText>
        <rd:UseGenericDesigner>true</rd:UseGenericDesigner>
      </Query>
      <Fields>
        <Field Name="OrderNo">
          <DataField>OrderNo</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Operation">
          <DataField>Operation</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Item">
          <DataField>Item</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="ItemDescription">
          <DataField>ItemDescription</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="firstScan">
          <DataField>firstScan</DataField>
          <rd:TypeName>System.DateTime</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
  </DataSets>
