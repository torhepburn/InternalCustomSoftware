<?xml version="1.0" encoding="utf-8"?>
<Report xmlns="http://schemas.microsoft.com/sqlserver/reporting/2016/01/reportdefinition" xmlns:rd="http://schemas.microsoft.com/SQLServer/reporting/reportdesigner" xmlns:df="http://schemas.microsoft.com/sqlserver/reporting/2016/01/reportdefinition/defaultfontfamily" MustUnderstand="df">
  <df:DefaultFontFamily>Segoe UI</df:DefaultFontFamily>
  <AutoRefresh>0</AutoRefresh>
  <DataSources>
    <DataSource Name="NAV">
      <DataSourceReference>NAV</DataSourceReference>
      <rd:SecurityType>None</rd:SecurityType>
      <rd:DataSourceID>104c107f-a245-47e4-90b7-6a3baa582045</rd:DataSourceID>
    </DataSource>
  </DataSources>
  <DataSets>
    <DataSet Name="DataSet1">
      <Query>
        <DataSourceName>NAV</DataSourceName>
        <CommandText>/*	Current production status	*/

WITH s1 AS
(
select


o.[Shortcut Dimension 2 Code] [Value Stream]
,'' Customer
,l.[Job No_]
,o.No_ [WO Number]
,l.[Remaining Quantity] [WO Quantity]
,CASE
	WHEN TRY_CAST(LEFT(TRIM(REPLACE(Reference,'SO','')),1) AS DECIMAL) IS NOT NULL THEN
		CASE 
			WHEN CHARINDEX('SN',REPLACE(Reference,'SO','')) &gt; 0 THEN TRIM(LEFT(REPLACE(Reference,'SO',''), (CHARINDEX('SN',REPLACE(Reference,'SO',''))-2)))
		ELSE
			TRIM(LEFT(REPLACE(Reference,'SO',''),10))
		END
	ELSE ''
END SO
,Reference
,CASE
	WHEN CHARINDEX('SN',Reference) &gt; 0 THEN TRIM(SUBSTRING(Reference, (CHARINDEX('SN',Reference)+3), 10))
	
	ELSE ''
END SN
,o.[Source No_] [WO Part Number]
,[Assigned User ID]
,CASE l.[Overtime Applicable]
	WHEN 0 THEN ''
	WHEN 1 THEN 'Yes'
	WHEN 2 THEN 'No'
	WHEN 3 THEN 'Silent'
	ELSE 'na'
END [Overtime Applicable]
,o.[Due Date] [WO Due Date]
,o.[Inventory Posting Group] ipg
,o.[Creation Date] [WO Release Date]
 
FROM [ZYGO$Production Order] o

INNER JOIN [ZYGO$Prod_ Order Line] l ON o.No_ = l.[Prod_ Order No_]

WHERE 1=1

AND o.Status IN (3)	--3 = Released  2 = Firm Planned

AND [Assigned User ID] IN ('AMETEK-AD\DWOOLLEY','AMETEK-AD\LPEREZ')

AND o.Quantity &gt; 0

)
,s2 AS
(

SELECT

 s1.[Value Stream]
,h.[Sell-to Customer Name] [Customer]
,h.[Govt_ Priority Rating Code] [Gov Rating Code]
,s1.[Job No_] [Job Number]
,[Document No_] [Sales Order No]
,l.No_ [SO Part Number]
, s1.[WO Part Number]
,l.Description [Item Description]
,[WO Number]
,[WO Quantity]
,l.[Unit Price]
,l.[Requested Delivery Date]
,l.[Orig_ Promised Delivery Date]
,l.[Promised Delivery Date]
,[WO Release Date]
,[WO Due Date]
,CASE l.[Overtime Applicable]
	WHEN 0 THEN ''
	WHEN 1 THEN 'Yes'
	WHEN 2 THEN 'No'
	WHEN 3 THEN 'Silent'
	ELSE 'na'
END [Overtime Applicable]
,SN [S/N]


FROM s1

LEFT JOIN [ZYGO$Sales Line] l

 ON s1.SO = l.[Document No_] + '-' + CAST([SO Line No_] as varchar(3))

INNER JOIN [ZYGO$Sales Header] h ON l.[Document No_] = h.No_
)
, s3 AS
(
	SELECT

	 s1.[Value Stream]
	,'' [Customer]
	,'' [Gov Rating Code]
	,s1.[Job No_] [Job Number]
	,'' [Sales Order No]
	,'' [SO Part Number]
	, s1.[WO Part Number]
	,'' [Item Description]
	,[WO Number]
	,[WO Quantity]
	,0.00 [Unit Price]
	,'' [Requested Delivery Date]
	,'' [Orig_ Promised Delivery Date]
	,'' [Promised Delivery Date]
	,[WO Release Date]
	,[WO Due Date]
	,'' [Overtime Applicable]
	,SN [S/N]

	FROM s1
)
, s4 AS
(
select distinct

	 s3.[Value Stream]
	,s2.[Customer]
	,s2.[Gov Rating Code]
	,s3.[Job Number]
	,s2.[Sales Order No]
	,s2.[SO Part Number]
	,s3.[WO Part Number]
	,s2.[Item Description]
	,s3.[WO Number]
	,s3.[WO Quantity]
	,s2.[Unit Price]
	,s2.[Requested Delivery Date]
	,s2.[Orig_ Promised Delivery Date]
	,s2.[Promised Delivery Date]
	,s3.[WO Release Date]
	,s3.[WO Due Date]
	,s2.[Overtime Applicable]
	,s3.[S/N]

from s3

LEFT JOIN s2 ON s3.[WO Number] = s3.[WO Number] and s3.[WO Release Date] = s2.[WO Release Date]

AND s3.[WO Due Date] = s2.[WO Due Date]  AND s3.[WO Part Number] = s2.[WO Part Number] AND s3.[WO Quantity] = s2.[WO Quantity]
)

select

s4.* from s4

INNER JOIN [ZYGO$Production Order] o ON s4.[WO Number] = o.No_

WHERE o.Status = 3

AND [Creation Date] &gt; GETDATE()-7</CommandText>
        <rd:UseGenericDesigner>true</rd:UseGenericDesigner>
      </Query>
