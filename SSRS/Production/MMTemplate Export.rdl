  <df:DefaultFontFamily>Segoe UI</df:DefaultFontFamily>
  <AutoRefresh>0</AutoRefresh>
  <DataSources>
    <DataSource Name="NAV">
      <DataSourceReference>NAV</DataSourceReference>
      <rd:SecurityType>None</rd:SecurityType>
      <rd:DataSourceID>6d1f4b24-7bfc-4d2e-ab1e-3755085bfc5e</rd:DataSourceID>
    </DataSource>
  </DataSources>
  <DataSets>
    <DataSet Name="DataSet1">
      <Query>
        <DataSourceName>NAV</DataSourceName>
        <CommandText>WITH s1 AS
(
    select

    [Document No_]
    ,[Operation No_]
    ,SUM(e.Quantity) TimeSpent
    ,MIN([Posting Date]) op_start_date
    ,MAX([Posting Date]) op_finish_date

    from [ZYGO$Capacity Ledger Entry] e

    INNER JOIN [ZYGO$Production Order] o ON o.No_ = e.[Document No_]

    WHERE o.[Status] = 3

    GROUP BY [Document No_], [Operation No_]
)
select

    [Prod_ Order No_] work_order_id
,rl.[Routing No_] part_number
,i.[Revision Level] part_revision
,rl.[Operation No_] sequence_number
,rl.[Work Center No_] resource_id
,REPLACE(rl.Description,',','') operation_description
,REPLACE(i.Description,',','')  order_description
,rl.[Run Time] * 360 * 1000 cycle_time_ms
,rl.[Setup Time] * 360 * 1000 setup_time_ms
,rl.[Input Quantity] quantity_per_part
,CASE rl.[Status]
    WHEN 2 THEN 'NOT RELEASED'
    WHEN 3 THEN 'RELEASED'
    WHEN 4 THEN 'COMPLETED'
 END order_status
,COALESCE(CASE rl.[Operation Complete]
    WHEN 0 THEN
      CASE rl.[Routing Status]
        WHEN 0 THEN 'NOT RELEASED'
        WHEN 1 THEN 'NOT RELEASED'
        WHEN 2 THEN 'ACTIVE'
END  
    WHEN 1 THEN 'COMPLETED'
END,'RELEASED') op_status

,rl.[Starting Date] scheduled_start_date
,rl.[Ending Date] scheduled_end_date
,d.[Due Date]
,0 start_quantity
,COALESCE(d.Quantity,0) finish_quantity
,COALESCE(CASE
    WHEN rl.[Operation Complete] = 1 THEN CONVERT(VARCHAR,op_start_date,120)
    WHEN rl.[Operation Complete] = 0 THEN
        CASE
            WHEN rl.[Routing Status] = 2 THEN CONVERT(VARCHAR,op_start_date,120)
            ELSE ''
        END
    END,'') op_start_date
,COALESCE(CASE
    WHEN rl.[Operation Complete] = 0 THEN ''
    ELSE CONVERT(VARCHAR,op_finish_date,120)
  END,'') op_finish_date

from 

[ZYGO$Prod_ Order Routing Line] rl

LEFT JOIN ZYGO$Item i ON rl.[Routing No_] = i.No_

LEFT JOIN [ZYGO$Production Order] d ON rl.[Prod_ Order No_] = d.No_

LEFT JOIN s1 ON rl.[Prod_ Order No_] = s1.[Document No_] AND rl.[Operation No_] = s1.[Operation No_]

WHERE rl.Status = 3

AND rl.[Routing No_] != 'REWORK'

AND rl.Description NOT LIKE 'Subc%'

AND rl.Description NOT LIKE 'Backflush%'
</CommandText>
        <rd:UseGenericDesigner>true</rd:UseGenericDesigner>
      </Query>
