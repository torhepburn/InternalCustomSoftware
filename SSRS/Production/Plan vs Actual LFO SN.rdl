<?xml version="1.0" encoding="utf-8"?>
<Report MustUnderstand="df" xmlns="http://schemas.microsoft.com/sqlserver/reporting/2016/01/reportdefinition" xmlns:rd="http://schemas.microsoft.com/SQLServer/reporting/reportdesigner" xmlns:df="http://schemas.microsoft.com/sqlserver/reporting/2016/01/reportdefinition/defaultfontfamily">
  <df:DefaultFontFamily>Segoe UI</df:DefaultFontFamily>
  <AutoRefresh>0</AutoRefresh>
  <DataSources>
    <DataSource Name="NAV">
      <DataSourceReference>NAV</DataSourceReference>
      <rd:SecurityType>None</rd:SecurityType>
      <rd:DataSourceID>8b648d4c-1f8b-4d12-b197-e8d28c5283e2</rd:DataSourceID>
    </DataSource>
  </DataSources>
  <DataSets>
    <DataSet Name="DataSet1">
      <Query>
        <DataSourceName>NAV</DataSourceName>
        <CommandText>WITH s1 AS
(
	SELECT

	[Posting Date]
	,[Item No_]
	,[Document No_]
	,[Quantity]
	--,[Entry Type]

	FROM [ZYGO$Item Ledger Entry]

	WHERE [Item No_] IN
	(
			 'CEA-F710483-3-IMP-B'
			,'CEA-F712PD17TO0483-3'
			,'CEA-F712PD17TO0482-3'
			,'CEA-F712PD17TO0476-3'
			,'LL-AAA08-105746'
	)

	AND [Posting Date] &gt;= CAST(DATEADD(dd,-30,GETDATE()) AS date)

	AND [Entry Type] = 6

)
,s2 AS
(
select

[Due Date]
,[Item No_]
,[Prod_ Order No_]
,[Finished Quantity]

from [ZYGO$Prod_ Order Line]

WHERE [Item No_] IN

(
		 'CEA-F710483-3-IMP-B'
		,'CEA-F712PD17TO0483-3'
		,'CEA-F712PD17TO0482-3'
		,'CEA-F712PD17TO0476-3'
		,'LL-AAA08-105746'
)

AND Status = 4

AND [Due Date] &gt;= CAST(DATEADD(dd,-30,GETDATE()) AS date)
)

select 

s2.*
--,COALESCE(s1.[Posting Date],'')[Posting Date]
,[Posting Date]
--,COALESCe(s1.Quantity,0) Quantity
,s1.Quantity
,o.Reference

FROM s2 LEFT JOIN s1 ON s2.[Item No_] = s1.[Item No_] and s2.[Prod_ Order No_] = s1.[Document No_]

LEFT JOIN [ZYGO$Production Order] o ON s2.[Prod_ Order No_] = o.No_

ORDER BY [Due Date]</CommandText>
        <rd:UseGenericDesigner>true</rd:UseGenericDesigner>
      </Query>
      <Fields>
        <Field Name="Due_Date">
          <DataField>Due Date</DataField>
          <rd:TypeName>System.DateTime</rd:TypeName>
        </Field>
        <Field Name="Item_No_">
          <DataField>Item No_</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Prod__Order_No_">
          <DataField>Prod_ Order No_</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Finished_Quantity">
          <DataField>Finished Quantity</DataField>
          <rd:TypeName>System.Decimal</rd:TypeName>
        </Field>
        <Field Name="Posting_Date">
          <DataField>Posting Date</DataField>
          <rd:TypeName>System.DateTime</rd:TypeName>
        </Field>
        <Field Name="Quantity">
          <DataField>Quantity</DataField>
          <rd:TypeName>System.Decimal</rd:TypeName>
        </Field>
        <Field Name="Reference">
          <DataField>Reference</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
  </DataSets>
