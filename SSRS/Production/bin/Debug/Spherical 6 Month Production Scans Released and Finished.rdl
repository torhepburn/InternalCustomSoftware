  <DataSources>
    <DataSource Name="AFE">
      <DataSourceReference>AFE</DataSourceReference>
      <rd:SecurityType>None</rd:SecurityType>
      <rd:DataSourceID>d3be0e3c-b1a2-4e5b-957e-aaf5bfae9657</rd:DataSourceID>
    </DataSource>
  </DataSources>
  <DataSets>
    <DataSet Name="DataSet1">
      <Query>
        <DataSourceName>AFE</DataSourceName>
        <CommandText>with s1 AS
(
select

OrderNo
,Operation
,Item
,ItemDescription
,WorkCenter
,WorkCenterDescription
,StartTime DashStartTime
,EndTime DashEndTime
,Complete

from  [CT-MID-DB01.ametek.com].Dashboard.[dbo].[TimecardNAVProdHours]

where Item IN

  (
	 '6024-2300-03'
	,'6024-2302-03'
	,'6024-2330-03'
	,'6024-2332-03'
	,'6024-2334-03'
	,'6024-2336-03'
	,'6024-2347-03'
	,'6174-1258-01'
	,'6174-1259-01'
	,'6550-1119-01'
	,'6550-1120-01'
	,'6550-1121-01'
	,'6580-1074-01'
	,'6580-1075-01'
	,'6580-1076-01'
	,'6580-1077-01'
	,'6580-1078-01'
	,'OPTG-6500-1633-01'
	,'OPTG-6500-1634-01'
)

AND StartTime &gt; '2026-04-01'
)


select

n.*
,s1.DashStartTime
,s1.DashEndTime
,s1.Complete
,DATEDIFF(MINUTE, DashStartTime, COALESCE(DashEndTime, '01-01-1900'))  ScannedTime



from NAVprodOrdRoutingLine n

INNER JOIN s1 on n.[Prod_ Order No_] = s1.OrderNo AND n.[Operation No_] = s1.Operation and n.[Routing No_] = s1.Item



order by 

 [Routing No_]
,Operation
,DashStartTime desc</CommandText>
        <rd:UseGenericDesigner>true</rd:UseGenericDesigner>
      </Query>
      <Fields>
        <Field Name="Status">
          <DataField>Status</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
        <Field Name="Prod__Order_No_">
          <DataField>Prod_ Order No_</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Routing_Reference_No_">
          <DataField>Routing Reference No_</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
        <Field Name="Routing_No_">
