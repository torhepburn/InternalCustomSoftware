      <Query>
        <DataSourceName>AFE</DataSourceName>
        <CommandText>SELECT  [Reason Code]
      ,[Description]
      ,[Direction]
      ,[Category]
      ,[NewDescription]
      ,[Exclusion]
      ,[Bucket]
  FROM [AccessFrontEnds].[dbo].[ReasonCodes]

