<?xml version="1.0" encoding="utf-8"?>
<Report MustUnderstand="df" xmlns="http://schemas.microsoft.com/sqlserver/reporting/2016/01/reportdefinition" xmlns:rd="http://schemas.microsoft.com/SQLServer/reporting/reportdesigner" xmlns:df="http://schemas.microsoft.com/sqlserver/reporting/2016/01/reportdefinition/defaultfontfamily">
  <df:DefaultFontFamily>Segoe UI</df:DefaultFontFamily>
  <AutoRefresh>0</AutoRefresh>
  <DataSources>
    <DataSource Name="AFE">
      <DataSourceReference>AFE</DataSourceReference>
      <rd:SecurityType>None</rd:SecurityType>
      <rd:DataSourceID>04d5d5e3-4674-4b18-b882-ad6b195b0c8f</rd:DataSourceID>
    </DataSource>
  </DataSources>
  <DataSets>
    <DataSet Name="DataSet1">
      <Query>
        <DataSourceName>AFE</DataSourceName>
        <CommandText>
select

MIN([Starting Date-Time]) s
,MAX([Ending Date-Time]) e
,[Prod_ Order No_]
,[Routing No_]
,CASE [Routing No_]
	WHEN 'CEA-F712PD17TO0483-3' THEN '3 Omega Main Debris Shield'
	WHEN 'CEA-F712PD17TO0476-3'	THEN '3 Omega Grating Substrate'
	WHEN 'CEA-F710483-3-IMP-B' THEN '3 Omega Main Debris Shield Imprint Type B'
	WHEN 'CEA-F712PD17TO0482-3' THEN '3 Omega Vacuum Window'
	WHEN 'LL-AAA08-105746' THEN 'Main Debris Shield - 3 Omega'

END Description

,DATEDIFF(dd,MIN([Starting Date-Time]),MAX([Ending Date-Time]) ) DaysOpen


FROM NAVprodOrdRoutingLine l 

	where [Routing No_] IN 
		(
			 'CEA-F710483-3-IMP-B'
			,'CEA-F712PD17TO0483-3'
			,'CEA-F712PD17TO0482-3'
			,'CEA-F712PD17TO0476-3'
			,'LL-AAA08-105746'
		)

		GROUP BY [Prod_ Order No_], [Routing No_]
		



		order by 
		
		MIN([Starting Date-Time]) desc
--		DATEDIFF(dd,MIN([Starting Date-Time]),MAX([Ending Date-Time]) ) desc

</CommandText>
        <rd:UseGenericDesigner>true</rd:UseGenericDesigner>
      </Query>
      <Fields>
        <Field Name="s">
          <DataField>s</DataField>
          <rd:TypeName>System.DateTime</rd:TypeName>
        </Field>
        <Field Name="e">
          <DataField>e</DataField>
          <rd:TypeName>System.DateTime</rd:TypeName>
        </Field>
        <Field Name="Prod__Order_No_">
          <DataField>Prod_ Order No_</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Routing_No_">
          <DataField>Routing No_</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="DaysOpen">
          <DataField>DaysOpen</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
        <Field Name="Description">
          <DataField>Description</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
  </DataSets>
