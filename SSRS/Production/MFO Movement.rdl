  <AutoRefresh>0</AutoRefresh>
  <DataSources>
    <DataSource Name="AFE">
      <DataSourceReference>AFE</DataSourceReference>
      <rd:SecurityType>None</rd:SecurityType>
      <rd:DataSourceID>7f63c19e-1791-434e-83c7-032ee9fc1a9c</rd:DataSourceID>
    </DataSource>
  </DataSources>
  <DataSets>
    <DataSet Name="DataSet1">
      <Query>
        <DataSourceName>AFE</DataSourceName>
        <CommandText>/*	 work orders	*/

with s1 AS /*	released production from NAV	*/
(
	SELECT
	
	[Prod_ Order No_] OrderNo
	,[Operation No_] Operation
	,Description
	,[Prod_ Order No_] + [Operation No_] oLink
	,[Ending Date-Time] NAVplannedEndDate
	,CASE l.Status
		WHEN 3 THEN 'Released'
		WHEN 4 THEN 'Completed'
		ELSE ''
	END NAVstatus
	,[Routing No_]

	FROM NAVprodOrdRoutingLine l 

	INNER JOIN [NAV MFO WO Status] m ON l.[Prod_ Order No_] = m .No_

	WHERE m.Status = 'Released'  --released

	
)
,s2 AS	/*	Orders marked in Dashboard as complete	*/
(
	SELECT 
	   
      MAX([EndTime]) DashboardCompletionDate
	  ,MAX(Operation) LastOpCompleted
	  ,orderno
	  

	FROM [CT-MID-DB01.ametek.com].Dashboard.[dbo].[TimecardNAVProdHours]

	where orderno + operation IN (SELECT oLink from s1)
  
	GROUP BY 

       [OrderNo]
      

	  HAVING MAX(Complete) = 1
)
,s3 AS
(
	SELECT

	ProductionOrder
	,Operation
	,No_ PartNumber
	,Description
	,[Buyer Planner Code]
	,DateCreated
	,FastID
	,DATEDIFF(DAY, DateCreated, GETDATE()) DaysInMRB


	  FROM [AccessFrontEnds].[dbo].[FAST Dispositions] f

	  LEFT JOIN NAV_Item i ON f.PartNumber = i.No_

	  WHERE DateDispositioned is null

	  and Site = 'Zygo Middlefield'

	  AND LEN(Productionorder) &gt; 0

	  AND [Business Segment] IN ('PO Value Stream','LFO Value Stream')
)
,s4 AS
(
select

s2.OrderNo
,s2.LastOpCompleted
,s2.DashboardCompletionDate LastOpCompletionDate
,DATEDIFF(DAY,s2.DashboardCompletionDate, CAST(GETDATE() as date)) DaysSinceLastCompletedOp
,COALESCE(s3.FastID,'') FASTid
,COALESCE(s3.DaysInMRB,0) DaysInMRB

from s2

LEFT JOIN s3 ON  s2.orderno = s3.ProductionOrder
)
,s5 AS
(
	SELECT DISTINCT

	[Prod_ Order No_]
	,[Routing No_]

	FROM NavProdOrdRoutingLine
)

select

s4.* 
,s5.[Routing No_]

from s4

INNER JOIN  s5 ON s4.orderno = s5.[Prod_ Order No_]

order by DaysSinceLastCompletedOp DESC
--order by olink</CommandText>
        <rd:UseGenericDesigner>true</rd:UseGenericDesigner>
      </Query>
      <Fields>
        <Field Name="OrderNo">
          <DataField>OrderNo</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="LastOpCompleted">
          <DataField>LastOpCompleted</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="LastOpCompletionDate">
          <DataField>LastOpCompletionDate</DataField>
          <rd:TypeName>System.DateTime</rd:TypeName>
        </Field>
        <Field Name="DaysSinceLastCompletedOp">
          <DataField>DaysSinceLastCompletedOp</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
        <Field Name="FASTid">
          <DataField>FASTid</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
        <Field Name="DaysInMRB">
          <DataField>DaysInMRB</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
        <Field Name="Routing_No_">
          <DataField>Routing No_</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
  </DataSets>
