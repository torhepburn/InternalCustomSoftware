  <DataSets>
    <DataSet Name="DataSet1">
      <Query>
        <DataSourceName>NAV</DataSourceName>
        <CommandText>WITH s1 AS	/*	WO for LFO	*/
(
select

 [Item No_]
,[Prod_ Order No_]
,[Quantity]

from [ZYGO$Prod_ Order Line]

WHERE [Item No_] IN

(
		 'CEA-F710483-3-IMP-B'
		,'CEA-F712PD17TO0482-3'
		,'CEA-F712PD17TO0476-3'
		,'LL-AAA08-105746'
)

AND Status = 3
)
,s2 AS	/*	Actual Max Op	*/
(
SELECT 

s1.[Item No_]
,s1.[Prod_ Order No_]
,MAX(l.[Operation No_]) Operation


FROM [ZYGO$Capacity Ledger Entry] l

INNER JOIN s1 ON s1.[Prod_ Order No_] = l.[Document No_]

GROUP BY s1.[Item No_], s1.[Prod_ Order No_]
)
,s3 AS  /*	Actual Max Date	*/
(
	SELECT 

	s2.[Item No_]
	,s2.[Prod_ Order No_]
	,s2.Operation
	,MAX(l.[Posting Date]) ActualDate


	FROM s2

	INNER JOIN 	[ZYGO$Capacity Ledger Entry] l 
	
	ON s2.[Prod_ Order No_] = l.[Document No_] AND s2.Operation = l.[Operation No_]

	GROUP BY s2.[Item No_], s2.[Prod_ Order No_], Operation

)
,s3a AS
(
	SELECT
	
	s3.*  
	,l.[Work Center No_]
	,l.[Lot Size]
	
	FROM s3

	INNER JOIN [ZYGO$Prod_ Order Routing Line] l ON s3.[Prod_ Order No_] = l.[Prod_ Order No_]

	AND s3.Operation = l.[Operation No_]
)
, s4 AS		/*	Planned End Date  */
(
	select 

	r.[Routing No_]
	,r.[Prod_ Order No_]
	,r.[Operation No_]
	,r.Description
	,r.[Lot Size]
	,r.[Work Center No_]
	,[Ending Date] PlannedEndDate

	from [ZYGO$Prod_ Order Routing Line] r 

	INNER JOIN s1 ON r.[Prod_ Order No_] = s1.[Prod_ Order No_]
)
,s5 AS
(
select

COUNT([Lot Size]) PlannedQty
,PlannedEndDate
,[Work Center No_]

from s4

GROUP BY [Work Center No_], PlannedEndDate
)
,s6 AS
(
select

COUNT([Lot Size]) ActualQty
,ActualDate
,[Work Center No_]

from s3a

GROUP BY [Work Center No_], ActualDate
)
,s5a AS
(
SELECT 

*

FROM s5 WHERE [Work Center No_] = '166'
)
,s5b AS
(
SELECT 

*

FROM s5 WHERE [Work Center No_] = '209'
)

,s5c AS
(
SELECT 

*

FROM s5 WHERE [Work Center No_] = '226'
)
,s5d AS
