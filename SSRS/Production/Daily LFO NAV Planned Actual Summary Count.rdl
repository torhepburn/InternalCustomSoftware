  <DataSources>
    <DataSource Name="NAV">
      <DataSourceReference>NAV</DataSourceReference>
      <rd:SecurityType>None</rd:SecurityType>
      <rd:DataSourceID>93d9cf93-4e38-42fc-afce-5b4513d62728</rd:DataSourceID>
