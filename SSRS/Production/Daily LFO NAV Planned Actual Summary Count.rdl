,s77 AS
(
select 

No_
,Name
,CAST(DATEADD(dd,-1,GETDATE()) AS date) PlannedEndDate
,CAST(DATEADD(dd,-1,GETDATE()) AS date) ActualDate
--,CAST(GETDATE() AS date) PlannedEndDate

FROM [ZYGO$Work Center] WHERE No_ IN

(
'161'
,'166'
,'167'
,'209'
,'220'
,'224'
,'226'
,'227'
,'229'
,'230'
,'231'
,'232'
,'234'
,'236'
,'238'
,'240'
,'245'
,'246'
,'247'
,'270'
,'276'
,'278'
,'281'
,'385'
,'386'
,'460'
,'592'
,'596'
,'700'

)


)

select

s77.No_ WorkCenterNo
,s77.Name Description
,COALESCE(s51.PlannedQty,0) 'Y-Plan'
,COALESCE(s61.ActualQty,0) 'Y-Actual'
,COALESCE(t.PlannedQty,0) 'T-Planned'
,t.PlannedEndDate

from s77

LEFT JOIN s51 ON s77.No_ = s51.[Work Center No_] 

AND s51.PlannedEndDate = s77.PlannedEndDate

LEFT JOIN s61 ON s77.No_ = s61.[Work Center No_]

AND s61.ActualDate = s77.ActualDate

LEFT JOIN s51 t ON s77.No_ = t.[Work Center No_] 

AND t.PlannedEndDate = DATEADD(dd,1,s77.PlannedEndDate)

/*


SELECT * FROM s3

WHERE [Prod_ Order No_] IN (

'PD511814'
,'PD511871'
,'PD511872'
,'PD512000'

)

--where [Work Center No_] = '231'

--ORDER BY PlannedEndDate*/</CommandText>
