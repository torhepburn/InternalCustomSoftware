  <DataSets>
    <DataSet Name="DataSet1">
      <Query>
        <DataSourceName>NAV</DataSourceName>
        <CommandText>SELECT

 No_
 , Name
 
 
 FROM [ZYGO$Work Center] WHERE
 
 
 [Name] = '5145 Edge - Chinese OD Grind - no longer used' 
or [Name] = '5145 Generate - Large Yosh G002 (LRM) No Longer Us' 
or [Name] = '5145 Grind - Draper G009 - no longer used' 
or [Name] = '5145 Grind - Nord G004 - no longer used' 
or [Name] = '5145 Grind - Strasbaugh G006 - no longer used' 
or [Name] = '5145 Grind - Strasbaugh G007 - no longer used' 
or [Name] = '5177 Metrology - 12'' Old NO LONGER USED' 
or [Name] = '5177 Metrology - 18'', 24'', 32 NO Longer Used' 
or [Name] = '5177 Metrology - 4'', 6'', 12'' No Longer used' 
or [Name] = '5185 CNC  Haas VF7 NC013 NO LONGER USED' 
or [Name] = '5185 CNC - MAHO NC019 (LRM) no longer used' 
or [Name] = '5185 CNC - MORI NC006 (LRM) - no longer used' 
or [Name] = '5185 CNC - MORI NC007 (LRM) - no longer used' 
or [Name] = '5210 Fused Silica Beveling - no longer used' 
or [Name] = '5230 MRF - Haas I MRF 001 [LRM] - no longer used' 
or [Name] = '5620 EPOC QA No longer used' 
or [Name] = '5640 EPOC Assembl No Long Use' 
or [Name] = '5640 EPOC High Speed NoLongUse' 
or [Name] = '5640 EPOC Lapping no long use' 
or [Name] = '5640 EPOC Opt Rough Metrol NLU' 
or [Name] = '5640 EPOC Optical Metrol NLuse' 
or [Name] = '5640 EPOC Pattern No Long use' 
or [Name] = '5640 EPOC Precision Shap Nouse' 
or [Name] = '5640 EPOC Shaping No Lnger use' 
or [Name] = '5680 available for reuse' 
or [Name] = 'Avaailable for reuse' 
or [Name] = 'Available for reuse' 
or [Name] = 'available for reuse' 
or [Name] = 'Available to reuse' 
or [Name] = 'DO NOT USE' 
or [Name] = 'Midfld Intransit FROM Richmond' 
or [Name] = 'Midfld Intransit TO Richmond' 
or [Name] = 'Midfld IntransitfromRichmond' 
or [Name] = 'NO LONGER USED' and [Name] = 'NO LONGER USED 5074 Edge LOH LZ80 M007' 
or [Name] = 'NO LONGER USED 5074 Spindl Polish Nord G32 No Long' 
or [Name] = 'NO LONGER USED 5074 Spindle Grind LOH G035 No Long' 
or [Name] = 'No longer used 5135 Bevel' and [Name] = 'No longer used 5185 Blocking' 
or [Name] = 'No longer used 5185 CNC Machining Setup' 
or [Name] = 'NO LONGER USED 5200 CNC -Ceda II NC011 No Longer' 
or [Name] = 'NO LONGER USED 5200 CNC Ceda I NC010 No Longer Use' 
or [Name] = 'NO LONGER USED 5200 CNC Haas VF6 NC012  No longer'
or [Name] = 'NO LONGER USED 5210 Moved Ceda III NC014 No longer' 
or [Name] = 'No longer used 5215 NIF Receiving/Incoming In' 
or [Name] = 'No longer used 5225 NIF Interferometry' 
or [Name] = 'No longer used 5230 Comp Cont Pol CCP001 LR' 
or [Name] = 'NO LONGER USED 5310 Coating man based no longer u' 
or [Name] = 'NO LONGER USED 5310 Coating Preperation' 
or [Name] = 'NO LONGER USED MODEL SHOP FAB.NO LONGER USE' 
or [Name] = 'NOT USED 5074 Generate Schneider NC015 (LRM)' 
or [Name] = 'NOT USED 5074 Spindle Grind Nord G036' 
or [Name] = 'Richmond Intransit TO Midfld' 
or [Name] = 'Spherical Grind inactive' 
or [Name] = 'Subcontr Johnson Gage Co'</CommandText>
        <rd:UseGenericDesigner>true</rd:UseGenericDesigner>
      </Query>
      <Fields>
        <Field Name="No_">
          <DataField>No_</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Name">
          <DataField>Name</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
