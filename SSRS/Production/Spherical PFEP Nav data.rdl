<?xml version="1.0" encoding="utf-8"?>
<Report xmlns="http://schemas.microsoft.com/sqlserver/reporting/2016/01/reportdefinition" xmlns:rd="http://schemas.microsoft.com/SQLServer/reporting/reportdesigner" xmlns:df="http://schemas.microsoft.com/sqlserver/reporting/2016/01/reportdefinition/defaultfontfamily" MustUnderstand="df">
  <df:DefaultFontFamily>Segoe UI</df:DefaultFontFamily>
  <AutoRefresh>0</AutoRefresh>
  <DataSources>
    <DataSource Name="NAV">
      <DataSourceReference>NAV</DataSourceReference>
      <rd:SecurityType>None</rd:SecurityType>
      <rd:DataSourceID>bf52d890-8969-43f8-8e6d-f921e42308f3</rd:DataSourceID>
    </DataSource>
  </DataSources>
  <DataSets>
    <DataSet Name="DataSet1">
      <Query>
        <DataSourceName>NAV</DataSourceName>
        <CommandText>WITH s1 AS
(
select

No_

from ZYGO$Item i

where [Product Types] IN ('SPH', 'SPO', 'SPR')

AND [Signal Code] &lt;&gt; 'OBS'

AND No_ Not Like '%FAI'
)

,s2 as
(	--On Hand
	SELECT 
	[Item No_]
	,SUM(Quantity) OnHand
	FROM [ZYGO$Item Ledger Entry] ile
	INNER JOIN s1 ON s1.No_ = ile.[Item No_]
	GROUP BY [Item No_]

)

--SELECT 

--* 

--FROM [ZYGO$Purchase Line] pl

--INNER JOIN s1 ON pl.No_ = s1.No_

--WHERE [Outstanding Quantity] = 0



select

No_
,[Standard Cost]
,i.[Lead Time Calculation] ItemLeadTime
,i.[Vendor No_] ItemVendor
,COALESCE(iv.[Lead Time Calculation],'') ItemVendorLeadTime
,COALESCE(iv.[Vendor No_],'') ItemVendorVendor
,i.Vetted
,COALESCE(OnHand,0) OnHand
,[Minimum Order Quantity]

from ZYGO$Item i

LEFT JOIN [ZYGO$Item Vendor] iv ON i.No_ = iv.[Item No_]

LEFT JOIN s2 ON i.No_ = s2.[Item No_]

where [Product Types] IN ('SPH', 'SPO', 'SPR')

AND [Signal Code] &lt;&gt; 'OBS'

AND No_ Not Like '%FAI'

--AND Vetted = 1

--ORDER BY No_</CommandText>
        <rd:UseGenericDesigner>true</rd:UseGenericDesigner>
      </Query>
      <Fields>
        <Field Name="No_">
          <DataField>No_</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Standard_Cost">
          <DataField>Standard Cost</DataField>
          <rd:TypeName>System.Decimal</rd:TypeName>
        </Field>
        <Field Name="ItemLeadTime">
          <DataField>ItemLeadTime</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="ItemVendor">
          <DataField>ItemVendor</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="ItemVendorLeadTime">
          <DataField>ItemVendorLeadTime</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="ItemVendorVendor">
          <DataField>ItemVendorVendor</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Vetted">
          <DataField>Vetted</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
        <Field Name="OnHand">
          <DataField>OnHand</DataField>
          <rd:TypeName>System.Decimal</rd:TypeName>
        </Field>
        <Field Name="Minimum_Order_Quantity">
          <DataField>Minimum Order Quantity</DataField>
          <rd:TypeName>System.Decimal</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
  </DataSets>
