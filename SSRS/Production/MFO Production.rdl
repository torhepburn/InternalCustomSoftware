<?xml version="1.0" encoding="utf-8"?>
<Report MustUnderstand="df" xmlns="http://schemas.microsoft.com/sqlserver/reporting/2016/01/reportdefinition" xmlns:rd="http://schemas.microsoft.com/SQLServer/reporting/reportdesigner" xmlns:df="http://schemas.microsoft.com/sqlserver/reporting/2016/01/reportdefinition/defaultfontfamily">
  <df:DefaultFontFamily>Segoe UI</df:DefaultFontFamily>
  <AutoRefresh>0</AutoRefresh>
  <DataSources>
    <DataSource Name="NAV">
      <DataSourceReference>NAV</DataSourceReference>
      <rd:SecurityType>None</rd:SecurityType>
      <rd:DataSourceID>06ba3002-c5d7-49b7-9a4b-3f903a4d9c55</rd:DataSourceID>
    </DataSource>
  </DataSources>
  <DataSets>
    <DataSet Name="DataSet1">
      <Query>
        <DataSourceName>NAV</DataSourceName>
        <CommandText>WITH s1 AS
(
select


o.[Shortcut Dimension 2 Code] [Value Stream]
,'' Customer
,l.[Job No_]
,o.No_ [WO Number]
,l.[Remaining Quantity] [WO Quantity]
--[Reference] r
--,CHARINDEX('SN',Reference) rr
,CASE
	WHEN TRY_CAST(LEFT(TRIM(REPLACE(Reference,'SO','')),1) AS DECIMAL) IS NOT NULL THEN
		CASE 
			WHEN CHARINDEX('SN',REPLACE(Reference,'SO','')) &gt; 0 THEN TRIM(LEFT(REPLACE(Reference,'SO',''), (CHARINDEX('SN',REPLACE(Reference,'SO',''))-2)))
		--CHARINDEX('SN', Reference)
		ELSE
		--CASE
			--WHEN SUBSTRING(Reference, 6, 1) = '-' THEN 
			TRIM(LEFT(REPLACE(Reference,'SO',''),10))
		--END
		--ELSE ''
		END
	ELSE ''
END SO
--,TRY_CAST(LEFT(TRIM(Reference),1) AS DECIMAL) num
--,CASE
--	WHEN CHARINDEX('SN',Reference) &gt; 0 THEN SUBSTRING(Reference, (CHARINDEX('-',Reference)+1),3)
		
			
	
	
--	--CHARINDEX('SN', Reference)
--	ELSE '99'
--END SOLine
,Reference
,CASE
	WHEN CHARINDEX('SN',Reference) &gt; 0 THEN TRIM(SUBSTRING(Reference, (CHARINDEX('SN',Reference)+3), 10))
	
	ELSE ''
END SN
,o.[Source No_] [WO Part Number]


--,SUBSTRING(Reference, 0, CHARINDEX('SN',Reference))
,[Assigned User ID]
--,CASE 
--	WHEN o.Status = 2 THEN 'Planned - Not Started'
--	ELSE
--		CASE	
--			WHEN o.[Due Date] &lt; GETDATE() THEN 'Behind'
--			WHEN o.[Due Date] &gt; GETDATE() THEN 'On Target'
--			ELSE 'Unknown'
--			END
--		END [WO Status]
,CASE l.[Overtime Applicable]
	WHEN 0 THEN ''
	WHEN 1 THEN 'Yes'
	WHEN 2 THEN 'No'
	WHEN 3 THEN 'Silent'
	ELSE 'na'
END [Overtime Applicable]
,o.[Due Date] [WO Due Date]
,o.[Inventory Posting Group] ipg
 

FROM [ZYGO$Production Order] o

INNER JOIN [ZYGO$Prod_ Order Line] l ON o.No_ = l.[Prod_ Order No_]


WHERE 1=1

--AND LEN([Reference]) &gt; 0

AND o.Status IN (2,3)	--3 = Released  2 = Firm Planned



--AND SUBSTRING(Reference, 3, 1) != '-'

--AND LEFT(Reference, 1) != 'S'

AND [Assigned User ID] IN ('AMETEK-AD\DWOOLLEY','AMETEK-AD\LPEREZ')

AND o.Quantity &gt; 0

)

SELECT

 s1.[Value Stream]
,h.[Sell-to Customer Name] [Customer]
,h.[Govt_ Priority Rating Code] [Gov Rating Code]
,s1.[Job No_] [Job Number]
,[Document No_] [Sales Order No]
,l.No_ [SO Part Number]
, s1.[WO Part Number]
,l.Description [Item Description]
,[WO Number]
,[WO Quantity]
,l.[Unit Price]
,SN [S/N]
--,[WO Status]
--,[SO Line No_]
,l.[Requested Delivery Date]
,l.[Orig_ Promised Delivery Date]
,l.[Promised Delivery Date]
,[WO Due Date]
,CASE l.[Overtime Applicable]
	WHEN 0 THEN ''
	WHEN 1 THEN 'Yes'
	WHEN 2 THEN 'No'
	WHEN 3 THEN 'Silent'
	ELSE 'na'
END [Overtime Applicable]


FROM s1

LEFT JOIN [ZYGO$Sales Line] l

 ON s1.SO = l.[Document No_] + '-' + CAST([SO Line No_] as varchar(3))

INNER JOIN [ZYGO$Sales Header] h ON l.[Document No_] = h.No_


--select * from s1

--WHERE [WO Status] != 'Planned - Not Started'</CommandText>
        <rd:UseGenericDesigner>true</rd:UseGenericDesigner>
      </Query>
