<?xml version="1.0" encoding="utf-8"?>
<Report xmlns="http://schemas.microsoft.com/sqlserver/reporting/2016/01/reportdefinition" xmlns:rd="http://schemas.microsoft.com/SQLServer/reporting/reportdesigner" xmlns:df="http://schemas.microsoft.com/sqlserver/reporting/2016/01/reportdefinition/defaultfontfamily" MustUnderstand="df">
  <df:DefaultFontFamily>Segoe UI</df:DefaultFontFamily>
  <AutoRefresh>0</AutoRefresh>
  <DataSources>
    <DataSource Name="NAV">
      <DataSourceReference>NAV</DataSourceReference>
      <rd:SecurityType>None</rd:SecurityType>
      <rd:DataSourceID>1c3c8aec-f9bb-40c3-93b5-b99583f75ad4</rd:DataSourceID>
    </DataSource>
  </DataSources>
  <DataSets>
    <DataSet Name="DataSet1">
      <Query>
        <DataSourceName>NAV</DataSourceName>
        <CommandText>WITH s1 AS
(
select

o.[Shortcut Dimension 2 Code] [Value Stream]
--,'' Customer
,l.[Job No_]
,o.No_ [WO Number]
,l.[Remaining Quantity] [WO Quantity]
,CASE
	WHEN TRY_CAST(LEFT(TRIM(REPLACE(Reference,'SO','')),1) AS DECIMAL) IS NOT NULL THEN
		CASE 
			WHEN CHARINDEX('SN',REPLACE(Reference,'SO','')) &gt; 0 THEN TRIM(LEFT(REPLACE(Reference,'SO',''), (CHARINDEX('SN',REPLACE(Reference,'SO',''))-2)))
		ELSE
			TRIM(LEFT(REPLACE(Reference,'SO',''),10))
		END
	ELSE ''
END SO
,Reference
,CASE
	WHEN CHARINDEX('SN',Reference) &gt; 0 THEN TRIM(SUBSTRING(Reference, (CHARINDEX('SN',Reference)+3), 10))
	WHEN CHARINDEX('S/N',Reference) &gt; 0 THEN TRIM(SUBSTRING(Reference, (CHARINDEX('SN',Reference)+3), 10))
	ELSE ''
END SN
,o.[Source No_] [WO Part Number]
,o.Description
,[Assigned User ID]
,CASE l.[Overtime Applicable]
	WHEN 0 THEN ''
	WHEN 1 THEN 'Yes'
	WHEN 2 THEN 'No'
	WHEN 3 THEN 'Silent'
	ELSE 'na'
END [Overtime Applicable]
,o.[Due Date] [WO Due Date]
,o.[Inventory Posting Group] ipg
,o.[Creation Date] [WO Release Date]
 
FROM [ZYGO$Production Order] o

INNER JOIN [ZYGO$Prod_ Order Line] l ON o.No_ = l.[Prod_ Order No_]

WHERE 1=1

AND o.Status IN (3)	--3 = Released  2 = Firm Planned

--AND ([Assigned User ID] IN ('AMETEK-AD\DWOOLLEY','AMETEK-AD\LPEREZ')

--OR [Buyer Planner Code] IN ('LEYDE P', 'DIANE W'))

--AND o.Quantity &gt; 0

AND o.[Shortcut Dimension 2 Code] in ('LFO VALUE STREAM','PO VALUE STREAM')
)
,s2 AS
(
select 

CASE 
	WHEN s.[Sell-to Customer Name] IS NOT NULL THEN s.[Sell-to Customer Name]
		ELSE
			CASE
				WHEN LEFT([WO Part Number],5) = 'ASML-' THEN 'ASML US LP'
				WHEN LEFT([WO Part Number],5) = '4022.' THEN 'ASML US LP'
				WHEN LEFT([WO Part Number],4) = 'CEA-' THEN 'COMMISSARIAT A L ENERGIE ATOMIQUE'
				WHEN LEFT([WO Part Number],3) = 'LL-' THEN 'LAWRENCE LIVERMORE NATIONAL SECURITY'
				WHEN [WO Part Number] = 'T4444' THEN 'NORTHROP GRUMMAN SYSTEMS CORPORATION'
				WHEN LEFT([WO Part Number],6) = 'THALES' THEN 'THALES UK LIMITED'
				WHEN [WO Part Number] = 'B727032' THEN 'AMETEK GERMANY GMBH'
				WHEN LEFT([WO Part Number],5) = 'AMGER' THEN 'AMETEK GERMANY GMBH'
				WHEN LEFT([WO Part Number],5) = '05945' THEN 'AMETEK GERMANY GMBH'
				WHEN LEFT([WO Part Number],5) = '02724' THEN 'AMETEK GERMANY GMBH'
				WHEN LEFT([WO Part Number],5) = 'HIWIN' THEN 'HIWIN MIKROSYSTEM CORP'
				WHEN LEFT([WO Part Number],3) = 'V47' THEN 'GOODRICH CORPORATION'
				WHEN LEFT([WO Part Number],5) = '4100-' THEN 'COLLINS AEROSPACE'
				WHEN LEFT([WO Part Number],5) = '0265-' THEN 'COLLINS AEROSPACE'
				WHEN LEFT([WO Part Number],5) = 'GOOD-' THEN 'COLLINS AEROSPACE'
				WHEN LEFT([WO Part Number],3) = 'AV-' THEN 'ALTICAM VISION INC'
				WHEN LEFT([WO Part Number],4) = 'MIT-' THEN 'MIT Lincoln Laboratory'
				WHEN LEFT([WO Part Number],4) = 'BATC' THEN 'BAE SYSTEMS SPACE &amp; MISSION SYSTEMS INC'
				WHEN LEFT([WO Part Number],4) = 'NGC-' THEN 'NORTHROP GRUMMAN SYSTEMS CORPORATION'
				WHEN LEFT([WO Part Number],4) = 'AMAT' THEN 'APPLIED MATERIALS INC'
				WHEN [WO Part Number] = '1541-801-455' THEN 'SHEMER MOTION'
				WHEN LEFT([WO Part Number],9) = '4000-1071' THEN 'COLORADO STATE UNIVERSITY'
				WHEN LEFT([WO Part Number],5) = 'NUT-5' THEN 'nLIGHT DEFENSE Systems Inc'
				WHEN LEFT([WO Part Number],3) = 'LM-' THEN 'Lockheed Martin'
				WHEN [WO Part Number] = '4000-1072-01' THEN 'RAYTHEON TECHNOLOGIES CORPORATION'
			END
END Customer
,s1.*

FROM s1 LEFT JOIN 

[ZYGO$Sales Header] s ON s1.SO = s.No_
)

select * from s2</CommandText>
        <rd:UseGenericDesigner>true</rd:UseGenericDesigner>
      </Query>
