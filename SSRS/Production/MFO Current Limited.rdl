          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Description">
          <DataField>Description</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Assigned_User_ID">
          <DataField>Assigned User ID</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Overtime_Applicable">
          <DataField>Overtime Applicable</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="WO_Due_Date">
          <DataField>WO Due Date</DataField>
          <rd:TypeName>System.DateTime</rd:TypeName>
        </Field>
        <Field Name="ipg">
          <DataField>ipg</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="WO_Release_Date">
          <DataField>WO Release Date</DataField>
          <rd:TypeName>System.DateTime</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
