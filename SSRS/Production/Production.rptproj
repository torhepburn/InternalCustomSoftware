<?xml version="1.0" encoding="utf-8"?>
<Project ToolsVersion="Current" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup Condition=" '$(Configuration)' == 'Debug' ">
    <FullPath>Debug</FullPath>
    <OutputPath>bin\Debug</OutputPath>
    <ErrorLevel>2</ErrorLevel>
    <OverwriteDatasets>False</OverwriteDatasets>
    <OverwriteDataSources>False</OverwriteDataSources>
    <TargetServerVersion>SSRS2016</TargetServerVersion>
    <Platform>Win32</Platform>
    <TargetReportFolder>Production</TargetReportFolder>
    <TargetDatasetFolder>Datasets</TargetDatasetFolder>
    <TargetDatasourceFolder>Data Sources</TargetDatasourceFolder>
    <TargetReportPartFolder>Report Parts</TargetReportPartFolder>
    <TargetServerURL>http://ct-mid-sql11/reportserver</TargetServerURL>
  </PropertyGroup>
  <PropertyGroup Condition=" '$(Configuration)' == 'DebugLocal' ">
    <FullPath>DebugLocal</FullPath>
    <OutputPath>bin\DebugLocal</OutputPath>
    <ErrorLevel>2</ErrorLevel>
    <OverwriteDatasets>False</OverwriteDatasets>
    <OverwriteDataSources>False</OverwriteDataSources>
    <TargetServerVersion>SSRS2016</TargetServerVersion>
    <Platform>Win32</Platform>
    <TargetReportFolder>Production</TargetReportFolder>
    <TargetDatasetFolder>Datasets</TargetDatasetFolder>
    <TargetDatasourceFolder>Data Sources</TargetDatasourceFolder>
    <TargetReportPartFolder>Report Parts</TargetReportPartFolder>
    <TargetServerURL>http://localhost/reportserver</TargetServerURL>
  </PropertyGroup>
  <PropertyGroup Condition=" '$(Configuration)' == 'Release' ">
    <FullPath>Release</FullPath>
    <OutputPath>bin\Release</OutputPath>
    <ErrorLevel>2</ErrorLevel>
    <OverwriteDatasets>False</OverwriteDatasets>
    <OverwriteDataSources>False</OverwriteDataSources>
    <TargetServerVersion>SSRS2016</TargetServerVersion>
    <Platform>Win32</Platform>
    <TargetReportFolder>Production</TargetReportFolder>
    <TargetDatasetFolder>Datasets</TargetDatasetFolder>
    <TargetDatasourceFolder>Data Sources</TargetDatasourceFolder>
    <TargetReportPartFolder>Report Parts</TargetReportPartFolder>
    <TargetServerURL>http://ct-mid-sql11/ReportServer</TargetServerURL>
    <StartItem>Tool Room Report.rdl</StartItem>
  </PropertyGroup>
  <PropertyGroup>
    <State>$base64$</State>
    <DataSources>@(DataSource)</DataSources>
    <DataSets>@(DataSet)</DataSets>
    <Reports>@(Report)</Reports>
  </PropertyGroup>
  <ItemGroup>
    <DataSet Include="WorkCenters.rsd" />
  </ItemGroup>
  <ItemGroup>
    <DataSource Include="AFE.rds" />
    <DataSource Include="DataSource1.rds" />
    <DataSource Include="NAV.rds" />
    <DataSource Include="NAV_TEST.rds" />
  </ItemGroup>
  <ItemGroup>
    <Report Include="BOMS with Closed BOMs as Components.rdl" />
    <Report Include="Copy of Work Center Load Month Horizontal.rdl" />
    <Report Include="Middlefield Maintenance History.rdl" />
    <Report Include="Open Maintenance Tickets.rdl" />
    <Report Include="Packing List.rdl" />
    <Report Include="Routing Evaluation Data.rdl" />
    <Report Include="Shipped Serial Numbers.rdl" />
    <Report Include="Spherical based on Product Types.rdl" />
    <Report Include="Spherical Output - History Detail.rdl" />
    <Report Include="Spherical Output.rdl" />
    <Report Include="Spherical PFEP Nav data.rdl" />
    <Report Include="Spherical Weekly Output Report.rdl" />
    <Report Include="Subcontract WO Last Step.rdl" />
    <Report Include="TEST MultiSelection.rdl" />
    <Report Include="Tool Room 1.rdl" />
    <Report Include="Tool Room Results.rdl" />
    <Report Include="TR 2.rdl" />
    <Report Include="TR3.rdl" />
    <Report Include="TR4.rdl" />
    <Report Include="Work Center Capacity - Month.rdl" />
    <Report Include="Work Center Load by Month.rdl" />
    <Report Include="Work Center Load by Week.rdl" />
    <Report Include="Work Center Load Month Horizontal.rdl" />
    <Report Include="Work Center Load Week Horizontal.rdl" />
  </ItemGroup>
  <Import Project="$(MSBuildExtensionsPath)\Reporting Services\Microsoft.ReportingServices.MSBuilder.targets" />
</Project>