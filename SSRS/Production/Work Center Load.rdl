<?xml version="1.0" encoding="utf-8"?>
<Report MustUnderstand="df" xmlns="http://schemas.microsoft.com/sqlserver/reporting/2016/01/reportdefinition" xmlns:rd="http://schemas.microsoft.com/SQLServer/reporting/reportdesigner" xmlns:df="http://schemas.microsoft.com/sqlserver/reporting/2016/01/reportdefinition/defaultfontfamily">
  <df:DefaultFontFamily>Segoe UI</df:DefaultFontFamily>
  <AutoRefresh>0</AutoRefresh>
  <DataSources>
    <DataSource Name="NAV">
      <DataSourceReference>NAV</DataSourceReference>
      <rd:SecurityType>None</rd:SecurityType>
      <rd:DataSourceID>89e8bada-66b7-425f-8840-df2a5b3d9352</rd:DataSourceID>
    </DataSource>
    <DataSource Name="NAV_TEST">
      <ConnectionProperties>
        <DataProvider>SQL</DataProvider>
        <ConnectString>Data Source=PA-HOR-AS406;Initial Catalog=ZYGO-NAV-TEST</ConnectString>
      </ConnectionProperties>
      <rd:SecurityType>DataBase</rd:SecurityType>
      <rd:DataSourceID>4332216c-3d21-4180-9736-2794b526abce</rd:DataSourceID>
    </DataSource>
  </DataSources>
  <DataSets>
    <DataSet Name="DataSet1">
      <Query>
        <DataSourceName>NAV_TEST</DataSourceName>
        <QueryParameters>
          <QueryParameter Name="@month">
            <Value>=Parameters!month.Value</Value>
            <rd:UserDefined>true</rd:UserDefined>
          </QueryParameter>
          <QueryParameter Name="@year">
            <Value>=Parameters!year.Value</Value>
            <rd:UserDefined>true</rd:UserDefined>
          </QueryParameter>
        </QueryParameters>
        <CommandText>--DECLARE @month int
--,@year int

--SET @month = 10
--Set @year = 2023;


WITH s1 AS
(
select

No_
, CASE 
	WHEN CHARINDEX('-',No_) = 0 THEN SUM([Capacity (Total)])
	WHEN CHARINDEX('-',No_) &gt; 0 THEN SUM([Capacity (Effective)])
END Capacity


from [ZYGO$Calendar Entry] where 1=1 --LEFT(No_,3) = '161'

and MONTH(Date) = @month

AND YEAR(Date) = @year

GROUP BY No_
)
,s2 AS
(
SELECT 

No_
,SUM([Allocated Time]) Allocated

FROM [ZYGO$Prod_ Order Capacity Need]

WHERE 1=1 --LEFT(No_,3) = '161'

and MONTH(Date) = @month

AND YEAR(Date) = @year

GROUP BY No_
)
,s3 AS
(
	SELECT

	No_
	,Name

	FROM [ZYGO$Machine Center]

	--WHERE [Work Center No_] IN ('161')
)
,s4 AS
(
	SELECT
	
	No_
	,Name

	FROM [ZYGO$Work Center]
)
SELECT

s2.No_
,CASE 
	WHEN s3.Name is null THEN s4.Name
	WHEN s3.Name is not null THEN s3.Name
END Name
,s1.Capacity
,s2.Allocated
,FORMAT(s2.Allocated/s1.Capacity,'P') Load
,@month [Month]
,@year [Year]


FROM s1 Right JOIN s2 ON s1.No_ = s2.No_

LEFT JOIN s3 ON s2.No_ = s3.No_

LEFT JOIN s4 ON s4.No_ = s2.No_

ORDER BY s2.No_</CommandText>
        <rd:UseGenericDesigner>true</rd:UseGenericDesigner>
      </Query>
      <Fields>
        <Field Name="No_">
          <DataField>No_</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Name">
          <DataField>Name</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Capacity">
          <DataField>Capacity</DataField>
          <rd:TypeName>System.Decimal</rd:TypeName>
        </Field>
        <Field Name="Allocated">
          <DataField>Allocated</DataField>
          <rd:TypeName>System.Decimal</rd:TypeName>
        </Field>
        <Field Name="Load">
          <DataField>Load</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Month">
          <DataField>Month</DataField>
          <rd:TypeName>System.Object</rd:TypeName>
        </Field>
        <Field Name="Year">
          <DataField>Year</DataField>
          <rd:TypeName>System.Object</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
  </DataSets>
