<?xml version="1.0" encoding="utf-8"?>
<Report xmlns="http://schemas.microsoft.com/sqlserver/reporting/2016/01/reportdefinition" xmlns:rd="http://schemas.microsoft.com/SQLServer/reporting/reportdesigner" xmlns:df="http://schemas.microsoft.com/sqlserver/reporting/2016/01/reportdefinition/defaultfontfamily" MustUnderstand="df">
  <df:DefaultFontFamily>Segoe UI</df:DefaultFontFamily>
  <AutoRefresh>0</AutoRefresh>
  <DataSources>
    <DataSource Name="NAV">
      <DataSourceReference>NAV</DataSourceReference>
      <rd:SecurityType>None</rd:SecurityType>
      <rd:DataSourceID>ea04a777-70e2-4a6d-bc7c-8e4a0ead14c8</rd:DataSourceID>
    </DataSource>
  </DataSources>
  <DataSets>
    <DataSet Name="DataSet1">
      <Query>
        <DataSourceName>NAV</DataSourceName>
        <CommandText>WITH s1 AS
(
	SELECT 
	
	l.[Production BOM No_]
	,l.No_ 
	,l.[Version Code]
	
	FROM [ZYGO$Production BOM Line] l
	
	INNER JOIN ZYGO$Item i ON l.[Production BOM No_] = i.No_
	
	WHERE 

	[Product Types] IN ('SPH', 'SPO', 'SPR')

	AND [Signal Code] &lt;&gt; 'OBS'

	AND i.No_ Not Like '%FAI'
)
,s2RAW AS
(
	SELECT 

	[Item No_]
	,SUM(Quantity) OnHandRAW

	FROM [ZYGO$Item Ledger Entry] WHERE [Item No_] IN

	(SELECT No_ FROM s1)

	GROUP BY [Item No_]

)
,s3FG AS
(
	SELECT 

	[Item No_]
	,SUM(Quantity) OnHandFG

	FROM [ZYGO$Item Ledger Entry] WHERE [Item No_] IN

	(SELECT [Production BOM No_] FROM s1)

	GROUP BY [Item No_]
)
,s4WIP AS
(
	SELECT

	[Item No_]
	,SUM([Remaining Quantity]) WIP

	FROM [ZYGO$Prod_ Order Line] l

	INNER JOIN ZYGO$Item i ON l.[Item No_] = i.No_
	
	WHERE 

	[Product Types] IN ('SPH', 'SPO', 'SPR')

	AND [Signal Code] &lt;&gt; 'OBS'

	AND i.No_ Not Like '%FAI'

	AND l.Status IN (2,3)

	GROUP BY [Item No_]
)


select s1.* 
,COALESCE(s3FG.[Item No_],'') [Top Item No_]
,COALESCE(s3FG.OnHandFG,0) OnHandFG
,COALESCE(s4WIP.WIP,0) WIP
,COALESCE(s2RAW.[Item No_],'') [Component Item No_]
,COALESCE(s2RAW.OnHandRAW,0) OnHandRAW


from s1 LEFT JOIN s3FG ON s1.[Production BOM No_] = s3FG.[Item No_]

LEFT JOIN s2RAW ON s1.[No_] = s2RAW.[Item No_]

LEFT JOIN s4WIP ON s1.[Production BOM No_] = s4WIP.[Item No_]</CommandText>
        <rd:UseGenericDesigner>true</rd:UseGenericDesigner>
      </Query>
      <Fields>
        <Field Name="Production_BOM_No_">
          <DataField>Production BOM No_</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="No_">
          <DataField>No_</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Version_Code">
          <DataField>Version Code</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Top_Item_No_">
          <DataField>Top Item No_</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="OnHandFG">
          <DataField>OnHandFG</DataField>
          <rd:TypeName>System.Decimal</rd:TypeName>
        </Field>
        <Field Name="WIP">
          <DataField>WIP</DataField>
          <rd:TypeName>System.Decimal</rd:TypeName>
        </Field>
        <Field Name="Component_Item_No_">
          <DataField>Component Item No_</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="OnHandRAW">
          <DataField>OnHandRAW</DataField>
          <rd:TypeName>System.Decimal</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
  </DataSets>
