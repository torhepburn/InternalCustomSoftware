<?xml version="1.0" encoding="utf-8"?>
<Report MustUnderstand="df" xmlns="http://schemas.microsoft.com/sqlserver/reporting/2016/01/reportdefinition" xmlns:rd="http://schemas.microsoft.com/SQLServer/reporting/reportdesigner" xmlns:df="http://schemas.microsoft.com/sqlserver/reporting/2016/01/reportdefinition/defaultfontfamily">
  <df:DefaultFontFamily>Segoe UI</df:DefaultFontFamily>
  <AutoRefresh>0</AutoRefresh>
  <DataSources>
    <DataSource Name="NAV">
      <DataSourceReference>NAV</DataSourceReference>
      <rd:SecurityType>None</rd:SecurityType>
      <rd:DataSourceID>93e9bf6a-aa3a-40f9-95a4-65583d92c3c9</rd:DataSourceID>
    </DataSource>
  </DataSources>
  <DataSets>
    <DataSet Name="DataSet1">
      <Query>
        <DataSourceName>NAV</DataSourceName>
        <CommandText>WITH s1 AS	/*	WO for LFO	*/
(
select

 [Item No_]
,[Prod_ Order No_]
,[Quantity]

from [ZYGO$Prod_ Order Line]

WHERE [Item No_] IN

(
		 'CEA-F710483-3-IMP-B'
		,'CEA-F712PD17TO0482-3'
		,'CEA-F712PD17TO0476-3'
		,'LL-AAA08-105746'
)

AND Status IN (4)  /*	3=released 4=finished	*/
)
,s2 AS	/* max date per operation per work order		*/
(
SELECT 

s1.[Prod_ Order No_]
,l.[Work Center No_]
,MAX(l.[Posting Date]) CompletionDate

FROM [ZYGO$Capacity Ledger Entry] l

INNER JOIN s1 ON s1.[Prod_ Order No_] = l.[Document No_]

WHERE [Posting Date] &gt; DATEADD(Month, -6,GETDATE())

GROUP BY s1.[Prod_ Order No_], l.[Work Center No_]
)
,s3 AS
(
select 


COUNT([Work Center No_]) [Qty]
,CompletionDate
,[Work Center No_]

from s2

--WHERE [Work Center No_] = '166'

GROUP BY CompletionDate, [Work Center No_]
)
,s4 as
(
	select

	[Work Center No_]
,	[09-25-2024]
,[09-26-2024]
,[09-27-2024]
,[09-30-2024]
,[10-02-2024]
,[10-04-2024]
,[10-07-2024]
,[10-08-2024]
,[10-09-2024]
,[10-10-2024]
,[10-21-2024]
,[10-23-2024]
,[10-28-2024]
,[10-30-2024]
,[10-31-2024]
,[11-04-2024]
,[11-06-2024]
,[11-14-2024]
,[11-18-2024]
,[11-20-2024]
,[11-22-2024]
,[11-23-2024]
,[11-25-2024]
,[11-26-2024]
,[12-05-2024]
,[12-06-2024]
,[12-09-2024]
,[12-11-2024]
,[12-12-2024]
,[12-17-2024]
,[12-19-2024]
,[12-20-2024]
,[12-30-2024]
,[12-31-2024]
,[01-03-2025]
,[01-06-2025]
,[01-07-2025]
,[01-09-2025]
,[01-10-2025]
,[01-13-2025]
,[01-15-2025]
,[01-16-2025]
,[01-21-2025]
,[01-22-2025]
,[01-23-2025]
,[01-24-2025]
,[01-27-2025]
,[01-28-2025]
,[01-29-2025]
,[01-30-2025]
,[01-31-2025]
,[02-05-2025]
,[02-06-2025]
,[02-07-2025]
,[02-13-2025]
,[02-17-2025]
,[02-18-2025]
,[02-24-2025]
,[02-25-2025]
,[02-26-2025]
,[02-27-2025]
,[02-28-2025]
,[03-17-2025]
,[03-18-2025]
,[03-20-2025]


	from s3

	Pivot

	(
		SUM(Qty)
		for CompletionDate in (
		
		[09-25-2024]
,[09-26-2024]
,[09-27-2024]
,[09-30-2024]
,[10-02-2024]
,[10-04-2024]
,[10-07-2024]
,[10-08-2024]
,[10-09-2024]
,[10-10-2024]
,[10-21-2024]
,[10-23-2024]
,[10-28-2024]
,[10-30-2024]
,[10-31-2024]
,[11-04-2024]
,[11-06-2024]
,[11-14-2024]
,[11-18-2024]
,[11-20-2024]
,[11-22-2024]
,[11-23-2024]
,[11-25-2024]
,[11-26-2024]
,[12-05-2024]
,[12-06-2024]
,[12-09-2024]
,[12-11-2024]
,[12-12-2024]
,[12-17-2024]
,[12-19-2024]
,[12-20-2024]
,[12-30-2024]
,[12-31-2024]
,[01-03-2025]
,[01-06-2025]
,[01-07-2025]
,[01-09-2025]
,[01-10-2025]
,[01-13-2025]
,[01-15-2025]
,[01-16-2025]
,[01-21-2025]
,[01-22-2025]
,[01-23-2025]
,[01-24-2025]
,[01-27-2025]
,[01-28-2025]
,[01-29-2025]
,[01-30-2025]
,[01-31-2025]
,[02-05-2025]
,[02-06-2025]
,[02-07-2025]
,[02-13-2025]
,[02-17-2025]
,[02-18-2025]
,[02-24-2025]
,[02-25-2025]
,[02-26-2025]
,[02-27-2025]
,[02-28-2025]
,[03-17-2025]
,[03-18-2025]
,[03-20-2025]
)
	) as p
)


select w.Name [Work Center] , s4.* from s4

left join [ZYGO$Work Center] w ON s4.[Work Center No_] = w.[No_]



/*

select DISTINCT

',[' + CONVERT(char(10),CAST([CompletionDate] as Date), 110) + ']'

from s3


order by 

',[' + CONVERT(char(10),CAST([CompletionDate] as Date), 110) + ']'
*/</CommandText>
        <rd:UseGenericDesigner>true</rd:UseGenericDesigner>
      </Query>
