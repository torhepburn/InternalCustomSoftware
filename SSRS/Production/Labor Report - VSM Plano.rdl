<?xml version="1.0" encoding="utf-8"?>
<Report MustUnderstand="df" xmlns="http://schemas.microsoft.com/sqlserver/reporting/2016/01/reportdefinition" xmlns:rd="http://schemas.microsoft.com/SQLServer/reporting/reportdesigner" xmlns:df="http://schemas.microsoft.com/sqlserver/reporting/2016/01/reportdefinition/defaultfontfamily">
  <df:DefaultFontFamily>Segoe UI</df:DefaultFontFamily>
  <AutoRefresh>0</AutoRefresh>
  <DataSources>
    <DataSource Name="AFE">
      <ConnectionProperties>
        <DataProvider>SQL</DataProvider>
        <ConnectString>Data Source=CT-MID-SQL11;Initial Catalog=AccessFrontEnds</ConnectString>
      </ConnectionProperties>
      <rd:SecurityType>DataBase</rd:SecurityType>
      <rd:DataSourceID>16aa099c-3bc0-404d-9339-db63f4718759</rd:DataSourceID>
    </DataSource>
  </DataSources>
  <DataSets>
    <DataSet Name="DataSet1">
      <Query>
        <DataSourceName>AFE</DataSourceName>
        <CommandText>WITH s1 AS
(
	SELECT p.USERID

	FROM EmployeesAmetekAD a

	INNER JOIN [MIDDB01.zygo.com].Dashboard.dbo.person p ON a.employeeID = p.AMETEK_ID

	WHERE Manager = 'Dan Milardo'
)
,s2 AS
(
SELECT
	
	MIN(StartTime) minStart
	,MAX(EndTime) maxEnd
	,CASE MAX(Complete) 
		WHEN 0 then 'No'
		WHEN 1 THEN 'Yes'
	END	maxComplete
	,OrderNo
	,Operation
	,MAX(Item) maxItem
	,MAx(ItemDescription) maxiDescription
	,MAX(Qty) maxQty

	FROM [MIDDB01.zygo.com].Dashboard.dbo.TimecardNavProdHours h

	INNER JOIN s1 ON s1.userID = h.userId

	LEFT JOIN NAVprodOrdRoutingLine l ON h.orderNo = l.[Prod_ Order No_] and h.operation = l.[Operation No_]	--AND h.workcenter = l.[Work Center No_]
	
	--WHERE MIN(StartTime) is not null

	--AND [Run Time] is null

	GROUP BY 
	
	OrderNo
	,Operation
	--,WorkCenter

	HAVING MIN(StartTime) is not null 

	AND MAX(Endtime) is not null
)
,s3 as
(
select

minStart [Start Time]
,maxEnd [End Time]
,[Work Center No_] [Work Center]
,Description [Work Center Description]
,maxItem [Item]
,maxiDescription [Item Description]
,orderNo [Order No]
,Operation
,maxComplete [Complete]
,maxQty [Qty]
,[Run Time] [Standard Run Time]
,DATEDIFF(minute, minStart, maxend)/(CAST(60 as decimal)) [Reported Hours]
,DATEDIFF(minute, minStart, maxend)/(CAST(60 as decimal)) - n.[Run Time] [Difference]

from s2

INNER JOIN NAVprodOrdRoutingLine n ON s2.orderNo = n.[Prod_ Order No_] and s2.operation = n.[Operation No_]
)

select

s3.*
,([Standard Run Time] - [Reported Hours])/(([Standard Run Time] + [Reported Hours])/(CAST(60 as decimal))/2) [Percent Difference Tim]
,CAST(([Difference]/[Standard Run Time]) as int) [Percent Difference Tor]


from s3

WHERE DATEDIFF(minute, [Start Time], [End Time]) &gt; 0

AND CAST([End Time] as date) = CAST(GETDATE() as date)  

ORDER BY [Work Center] desc
</CommandText>
        <rd:UseGenericDesigner>true</rd:UseGenericDesigner>
      </Query>
      <Fields>
        <Field Name="Start_Time">
          <DataField>Start Time</DataField>
          <rd:TypeName>System.DateTime</rd:TypeName>
        </Field>
        <Field Name="End_Time">
          <DataField>End Time</DataField>
          <rd:TypeName>System.DateTime</rd:TypeName>
        </Field>
        <Field Name="Work_Center">
          <DataField>Work Center</DataField>
