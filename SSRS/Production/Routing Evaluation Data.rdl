<?xml version="1.0" encoding="utf-8"?>
<Report MustUnderstand="df" xmlns="http://schemas.microsoft.com/sqlserver/reporting/2016/01/reportdefinition" xmlns:rd="http://schemas.microsoft.com/SQLServer/reporting/reportdesigner" xmlns:df="http://schemas.microsoft.com/sqlserver/reporting/2016/01/reportdefinition/defaultfontfamily">
  <df:DefaultFontFamily>Segoe UI</df:DefaultFontFamily>
  <AutoRefresh>0</AutoRefresh>
  <DataSources>
    <DataSource Name="AFE">
      <DataSourceReference>AFE</DataSourceReference>
      <rd:SecurityType>None</rd:SecurityType>
      <rd:DataSourceID>e59c8e90-4c53-46c8-b6b6-53a2b54a2fc8</rd:DataSourceID>
    </DataSource>
  </DataSources>
  <DataSets>
    <DataSet Name="DataSet1">
      <Query>
        <DataSourceName>AFE</DataSourceName>
        <QueryParameters>
          <QueryParameter Name="@item">
            <Value>=Parameters!Item.Value</Value>
            <rd:UserDefined>true</rd:UserDefined>
          </QueryParameter>
        </QueryParameters>
        <CommandText>SELECT

rl.[Routing No_]
,rl.[Operation No_]
,[Setup Time]
,[Run Time]
,[Wait Time]
,[Move Time]
,[Scrap Factor _]
,[Concurrent Capacities]
,d.OrderNo
,Item
,ItemDescription
,WorkCenter
,WorkCenterDescription
,StepWorkCenter
,CostCenter
,Qty
,COALESCE(StartTime,'') StartTime
,COALESCE(EndTime,'') EndTime
,Complete

FROM [ZYGO$Routing Line] rl

LEFT JOIN Local_Dash_TimecardNAVProdHours d ON rl.[Routing No_] = d.Item and rl.[Operation No_] = d.Operation

WHERE [Routing No_] = @item   --'10000067512'

order by orderno, Operation</CommandText>
        <rd:UseGenericDesigner>true</rd:UseGenericDesigner>
      </Query>
