<?xml version="1.0" encoding="utf-8"?>
<Report MustUnderstand="df" xmlns="http://schemas.microsoft.com/sqlserver/reporting/2016/01/reportdefinition" xmlns:rd="http://schemas.microsoft.com/SQLServer/reporting/reportdesigner" xmlns:df="http://schemas.microsoft.com/sqlserver/reporting/2016/01/reportdefinition/defaultfontfamily">
  <df:DefaultFontFamily>Segoe UI</df:DefaultFontFamily>
  <AutoRefresh>0</AutoRefresh>
  <DataSources>
    <DataSource Name="NAV">
      <DataSourceReference>NAV</DataSourceReference>
      <rd:SecurityType>None</rd:SecurityType>
      <rd:DataSourceID>e3d66b43-10c8-4593-9843-3b1136e5bf21</rd:DataSourceID>
    </DataSource>
  </DataSources>
  <DataSets>
    <DataSet Name="DataSet1">
      <Query>
        <DataSourceName>NAV</DataSourceName>
        <CommandText>WITH s1 AS
(
select

SUM(Quantity) TimeCharged
,[Document No_]
,[Operation No_]
,[Work Center No_]
,[Lot Size]


from [ZYGO$Capacity Ledger Entry]

WHERE [Posting Date] &gt; CAST(DATEADD(yy,-1,GETDATE()) AS date)

GROUP BY 

[Document No_]
,[Operation No_]
,[Work Center No_]
,[Lot Size]

)
,s2 as
(
SELECT

r.[Prod_ Order No_]
,o.Description
,o.[Source No_]
,r.[Operation No_]
,r.[Run Time] RoutingRunTime
,s1.TimeCharged
,s1.[Work Center No_]
,w.Name
,s1.[Lot Size]
,[Global Dimension 1 Code]
,o.[Finished Date] [Prod_ Order No_ Finished Date]

FROM s1 LEFT JOIN [ZYGO$Prod_ Order Routing Line] r ON s1.[Document No_] = r.[Prod_ Order No_]

AND s1.[Operation No_] = r.[Operation No_]

LEFT JOIN [ZYGO$Work Center] w ON s1.[Work Center No_] = w.No_

LEFT JOIN [ZYGO$Production Order] o ON s1.[Document No_] = o.No_

WHERE r.Status = 4  --finished

-- AND [Global Dimension 1 Code] IN ('5215', '5135','5225','5177')  --DAN
AND [Global Dimension 1 Code] IN ('5013')

--and LEN([Global Dimension 1 Code]) = 0
)

select *

from s2 

ORDER BY [Prod_ Order No_ Finished Date], [Prod_ Order No_], [Operation No_]</CommandText>
        <rd:UseGenericDesigner>true</rd:UseGenericDesigner>
      </Query>
