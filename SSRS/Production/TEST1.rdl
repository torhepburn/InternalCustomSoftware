<?xml version="1.0" encoding="utf-8"?>
<Report xmlns="http://schemas.microsoft.com/sqlserver/reporting/2016/01/reportdefinition" xmlns:rd="http://schemas.microsoft.com/SQLServer/reporting/reportdesigner" xmlns:df="http://schemas.microsoft.com/sqlserver/reporting/2016/01/reportdefinition/defaultfontfamily" MustUnderstand="df">
  <df:DefaultFontFamily>Segoe UI</df:DefaultFontFamily>
  <AutoRefresh>0</AutoRefresh>
  <DataSources>
    <DataSource Name="DataSource1">
      <ConnectionProperties>
        <DataProvider>SQL</DataProvider>
        <ConnectString>Data Source=CT-MID-SQL11;Initial Catalog=Optics</ConnectString>
        <IntegratedSecurity>true</IntegratedSecurity>
      </ConnectionProperties>
      <rd:SecurityType>None</rd:SecurityType>
      <rd:DataSourceID>44b5ec40-40bb-4548-909a-6128df011831</rd:DataSourceID>
    </DataSource>
  </DataSources>
  <DataSets>
    <DataSet Name="DataSet1">
      <Query>
        <DataSourceName>DataSource1</DataSourceName>
        <CommandText>WITH s1 AS
(
SELECT

[OrderNo]
,[Operation]
,MIN([StartTime]) MINStartTime
, MAX(EndTime) MaxEndTime
      
  FROM [AccessFrontEnds].[dbo].[Local_Dash_TimecardNAVProdHours]

  GROUP BY 

  [OrderNo]
 ,[Operation]
 )
 , s2 AS
 (

 SELECT 

 Order_No
 ,Item_Code
 ,'' Serial#
 , Order_Quantity
 ,Customer_Name
 , Item_description
 ,'' Material
 ,s1p.MaxEndTime DateReceived_PreviousOpClosedScan
 ,d.Operation
 ,s1.MINStartTime starttimeScan
 ,d.spent_Production_time
 ,d.Earliest_Finish_date
 ,d.delivery_date
 ,d.workcenterdescription

 FROM AccessFrontEnds.dbo.NAV_AirportDisplayDataModified d

 LEFT JOIN s1 ON d.Order_No = s1.OrderNo and d.Operation = s1.Operation
 LEFT JOIN s1 s1p ON d.Order_No = s1p.OrderNo and s1p.Operation = d.[Previous Operation No_]

 WHERE LEFT(WorkCenterDescription,4) in ('5177','5225')

 AND WorkcenterDescription like '%Polish%'

 AND s1.OrderNo is not null
 )

 SELECT [WO#]
      ,[PART NUMBER]
      ,i.[Serial#]
      ,[QTY]
      ,[Customer ]
      ,[Description]
      ,i.[Material]
      ,[Date received] [Date Received Floor Entry]
	  ,s2.DateReceived_PreviousOpClosedScan
	  ,s2.starttimeScan
	  ,s2.Earliest_Finish_Date [Dashboard Calculated Finish Date]
      ,[Expected finished date ] [Expected Finish Date Floor Entry]
      ,[Date finished ] [Date Finished Floor Entry]
      ,[Machine 1]
      --,[Machine 2]
      --,[Machine 3 ]
      ,[COMMENTS/NOTES]
      ,[Area]
      --,[ID]
      ,s2.[Operation]
	  ,s2.WorkcenterDescription
  FROM [Optics].[dbo].[Optics_InOut] i

  INNER JOIN s2 ON i.WO# = s2.Order_No

  WHERE Area = 'Polishing Room'

 -- WHERE WO# IN
 -- (
 --SELECT Order_No from s2
 --)</CommandText>
        <rd:UseGenericDesigner>true</rd:UseGenericDesigner>
      </Query>
