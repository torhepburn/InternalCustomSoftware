        </Field>
        <Field Name="P_M">
          <DataField>P/M</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Source">
          <DataField>Source</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="SubcontractPO">
          <DataField>SubcontractPO</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Product_Types">
          <DataField>Product Types</DataField>
