<?xml version="1.0" encoding="utf-8"?>
<Report MustUnderstand="df" xmlns="http://schemas.microsoft.com/sqlserver/reporting/2016/01/reportdefinition" xmlns:rd="http://schemas.microsoft.com/SQLServer/reporting/reportdesigner" xmlns:df="http://schemas.microsoft.com/sqlserver/reporting/2016/01/reportdefinition/defaultfontfamily">
  <df:DefaultFontFamily>Segoe UI</df:DefaultFontFamily>
  <AutoRefresh>0</AutoRefresh>
  <DataSources>
    <DataSource Name="NAV">
      <DataSourceReference>NAV</DataSourceReference>
      <rd:SecurityType>None</rd:SecurityType>
      <rd:DataSourceID>c10fce9c-2fbc-4a9a-bd4d-dd835709834a</rd:DataSourceID>
    </DataSource>
  </DataSources>
  <DataSets>
    <DataSet Name="DataSet1">
      <Query>
        <DataSourceName>NAV</DataSourceName>
        <CommandText>WITH s1 AS
(
	SELECT [Document No_],[Prod_ Order No_],No_ FROM [ZYGO$Purchase Line] WHERE 

	No_ in

	(SELECT

	No_

	FROM ZYGO$Item 

	where [Product Types] LIKE 'SP%'

	AND [Signal Code] &lt;&gt; 'OBS')
)
SELECT

l.[Item No_]
,l.Quantity
,l.[Document No_]
,[Posting Date]
,l.[Location Code]
,l.[User ID]
,CASE l.[Entry Type]
	WHEN 0 then 'Purchase'
	WHen 1 THEN 'Sale'
	WHEN 2 THEN 'Positive Adjustment'
	WHEN 3 THEN 'Negative Adjustment'
	WHEN 4 THEN 'Transfer'
	WHEN 5 THEN 'Consumption'
	WHEN 6 THEN 'Output'
	WHEN 7 THEN 'Assembly Consumption'
	WHEN 8 THEN 'Assembly Output'

END [Entry Type]
--, [Source Type]
,CASE [Source Type]
	WHEN 1 THEN 'Customer'
	WHEN 2 THEN 'Vendor'
	WHEN 3 THEN 'Item Document Type'
	WHEN 0 THEN ''
END [Source Type]
, CASE [Replenishment System]
	WHEN 0 THEN 'Purchased'
	WHEN 1 THEN 'Manufactured'

END 'P/M'
,COALESCE(CASE 
	WHEN [Order No_] LIKE 'PD%' THEN 'INTERNAL'
	WHEN [Order No_] Like 'SO%' THEN 'Outsourced'
END,'') 'Source'
,COALESCE(s1.[Document No_],'') SubcontractPO
,[Product Types]
,t.Description

FROM 

[ZYGO$Item Ledger Entry] l INNER JOIN 

[ZYGO$Item] i ON l.[Item No_] = i.No_

LEFT JOIN s1 ON l.[Item No_] = s1.No_ AND l.[Document No_] = s1.[Prod_ Order No_]

LEFT JOIN [ZYGO$Product Types] t ON i.[Product Types] = t.Code

where [Product Types] like 'SP%'

--AND [Item No_] LIKE '6024-2218-01%'

AND [Entry Type] IN (0,6)

ORDER BY

--l.[Document No_]

--l.[Location Code] desc
[Item No_], [Posting Date]

</CommandText>
        <rd:UseGenericDesigner>true</rd:UseGenericDesigner>
      </Query>
      <Fields>
        <Field Name="Item_No_">
          <DataField>Item No_</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Quantity">
          <DataField>Quantity</DataField>
          <rd:TypeName>System.Decimal</rd:TypeName>
        </Field>
        <Field Name="Document_No_">
