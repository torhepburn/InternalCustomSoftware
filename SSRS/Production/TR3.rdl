<?xml version="1.0" encoding="utf-8"?>
<Report MustUnderstand="df" xmlns="http://schemas.microsoft.com/sqlserver/reporting/2016/01/reportdefinition" xmlns:rd="http://schemas.microsoft.com/SQLServer/reporting/reportdesigner" xmlns:df="http://schemas.microsoft.com/sqlserver/reporting/2016/01/reportdefinition/defaultfontfamily">
  <df:DefaultFontFamily>Segoe UI</df:DefaultFontFamily>
  <AutoRefresh>0</AutoRefresh>
  <DataSources>
    <DataSource Name="DataSource1">
      <ConnectionProperties>
        <DataProvider>SQL</DataProvider>
        <ConnectString>Data Source=ct-mid-sql11;Initial Catalog=AccessFrontEnds</ConnectString>
      </ConnectionProperties>
      <rd:SecurityType>DataBase</rd:SecurityType>
      <rd:DataSourceID>ea2a8b4d-86ac-4a70-8186-d92d8ef69b74</rd:DataSourceID>
    </DataSource>
  </DataSources>
  <DataSets>
    <DataSet Name="DataSet1">
      <Query>
        <DataSourceName>DataSource1</DataSourceName>
        <CommandText>select 

YEAR(Request_Date) RequestYear
,DATEPART(Quarter, Request_Date) RequestQuarter
,MONTH(Request_Date) SortMonth
,CASE MONTH(Request_Date)
	WHEN 1 THEN 'JAN'
	WHEN 2 THEN 'FEB'
	WHEN 3 THEN 'MAR'
	WHEN 4 THEN 'APR'
	WHEN 5 THEN 'MAY'
	WHEN 6 THEN 'JUN'
	WHEN 7 THEN 'JUL'
	WHEN 8 THEN 'AUG'
	WHEN 9 THEN 'SEP'
	WHEN 10 THEN 'OCT'
	WHEN 11 THEN 'NOV'
	WHEN 12 THEN 'DEC'
END RequestMonth
,CAST(CostSavingsEstimate AS int) CostSavingsEstimate
,CAST(RevenueSavingsEstimate AS int) RevenueSavingsEstimate
,Cost_Center

from TOOL_REQUESTS 

WHERE REQUEST_DATE &gt; GETDATE() - 365

order by id desc</CommandText>
        <rd:UseGenericDesigner>true</rd:UseGenericDesigner>
      </Query>
      <Fields>
        <Field Name="RequestYear">
          <DataField>RequestYear</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
        <Field Name="RequestQuarter">
          <DataField>RequestQuarter</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
        <Field Name="SortMonth">
          <DataField>SortMonth</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
        <Field Name="RequestMonth">
          <DataField>RequestMonth</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="CostSavingsEstimate">
          <DataField>CostSavingsEstimate</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
        <Field Name="RevenueSavingsEstimate">
          <DataField>RevenueSavingsEstimate</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
        <Field Name="Cost_Center">
          <DataField>Cost_Center</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
  </DataSets>
