<?xml version="1.0" encoding="utf-8"?>
<Report MustUnderstand="df" xmlns="http://schemas.microsoft.com/sqlserver/reporting/2016/01/reportdefinition" xmlns:rd="http://schemas.microsoft.com/SQLServer/reporting/reportdesigner" xmlns:df="http://schemas.microsoft.com/sqlserver/reporting/2016/01/reportdefinition/defaultfontfamily">
  <df:DefaultFontFamily>Segoe UI</df:DefaultFontFamily>
  <AutoRefresh>0</AutoRefresh>
  <DataSources>
    <DataSource Name="AFE">
      <DataSourceReference>AFE</DataSourceReference>
      <rd:SecurityType>None</rd:SecurityType>
      <rd:DataSourceID>787efd4d-92a0-4661-95a8-80db6b21b440</rd:DataSourceID>
    </DataSource>
  </DataSources>
  <DataSets>
    <DataSet Name="DataSet1">
      <Query>
        <DataSourceName>AFE</DataSourceName>
        <CommandText>WITH s1 AS	/*	start date	*/
(
	SELECT 
	   [OrderNo]
      ,[Operation]
      ,[Item]
      ,[ItemDescription]
      ,MIN([StartTime]) firstScan

  FROM [MIDDB01.zygo.com].Dashboard.[dbo].[TimecardNAVProdHours]

  where costcenter = '5074'

  GROUP BY 

       [OrderNo]
      ,[Operation]
      ,[Item]
      ,[ItemDescription]
)
,s2 AS		/*	end based on start plus routing run time	*/
(
select 

s1.Item
,s1.ItemDescription
,s1.OrderNo
,s1.Operation
,l.Description
,s1.firstScan
,l.[Run Time]
,DATEADD(hh, [Run Time], firstScan) EstimatedEnd
,l.[Ending Date-Time]

FROM s1

LEFT JOIN NAVprodOrdRoutingLine l ON s1.OrderNo = l.[Prod_ Order No_] AND s1.operation = l.[Operation No_]
)
,s3 AS	/*	completed operations  */
(
	SELECT 
	   [OrderNo]
      ,[Operation]
      ,[Item]
      ,[ItemDescription]
      ,MAX([EndTime]) CompletionDate


  FROM [MIDDB01.zygo.com].Dashboard.[dbo].[TimecardNAVProdHours]


  where costcenter = '5074'  AND Complete = 1

  GROUP BY 

       [OrderNo]
      ,[Operation]
      ,[Item]
      ,[ItemDescription]



)
,s4 AS
(
select 

Item
,ItemDescription
,OrderNo
,Operation
,Description
,firstScan
,[Run Time]
,EstimatedEnd
,'' CompletionDate
,s2.[Ending Date-Time]

from s2 WHERE CAST(EstimatedEnd as date) = CAST(DATEADD(dd, -1, GETDATE()) as date)

UNION ALL

SELECT 

Item
,ItemDescription
,OrderNo
,Operation
,''
,''
,0
,''
,CompletionDate
,''

FROM s3 

WHERE CAST(CompletionDate as date) = CAST(DATEADD(dd, -1, GETDATE()) as date)
)
,s5 AS
(
SELECT

Item
,ItemDescription
,OrderNo
,Operation
,MAX(Description) Description
,MAX(firstScan) FirstScan
,MAX([Run Time]) [Run Time]
,MAX(EstimatedEnd) EstimatedEndDate
,MAX(CompletionDate) CompletionDate


FROM s4

GROUP BY 

 Item
,ItemDescription
,OrderNo
,Operation
)
,s6 AS
(
select

s5.*
,CASE
	WHEN DATEDIFF(dd, EstimatedEndDate,CompletionDate) = 0 THEN CAST(0 as nchar(2))
	WHEN CAST(EstimatedEndDate as date) = CAST('1900-01-01' as date) THEN 'NA'
	WHEN CAST(CompletionDate as date) = CAST('1900-01-01' as date) THEN 'NA'
	ELSE CAST(DATEDIFF(dd, EstimatedEndDate,CompletionDate) as nchar(3))
END [status]

from s5
)


SELECT

Item
,[ItemDescription]
,OrderNo
,Operation
,Description
,CASE CAST(firstScan as nchar(24)) 
	WHEN 'Jan  1 1900 12:00AM     ' THEN ''
	ELSE CAST(firstScan as nchar(24)) 
END FirstScan
,[Run Time]
,CASE CAST(EstimatedEndDate as nchar(24)) 
	WHEN 'Jan  1 1900 12:00AM     ' THEN ''
	ELSE CAST(EstimatedEndDate as nchar(24)) 
END EstimatedEndDate
,CASE CAST(CompletionDate as nchar(24)) 
	WHEN 'Jan  1 1900 12:00AM     ' THEN ''
	ELSE CAST(CompletionDate as nchar(24)) 
END CompletionDate
,CASE 
	WHEN Status != 'NA'
		THEN CASE
			WHEN  ABS(CAST(Status as int)) &lt;=1 THEN 'Green'
			WHEN  ABS(CAST(Status as int)) &lt;=3 THEN 'Yellow'
			WHEN  ABS(CAST(Status as int)) &gt; 4 THEN 'Red'
		END
	ELSE Status
END Status
			

FROM s6</CommandText>
        <rd:UseGenericDesigner>true</rd:UseGenericDesigner>
      </Query>
      <Fields>
        <Field Name="Item">
          <DataField>Item</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="ItemDescription">
          <DataField>ItemDescription</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="OrderNo">
          <DataField>OrderNo</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Operation">
          <DataField>Operation</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Description">
          <DataField>Description</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="firstScan">
          <DataField>FirstScan</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Run_Time">
          <DataField>Run Time</DataField>
          <rd:TypeName>System.Decimal</rd:TypeName>
        </Field>
        <Field Name="EstimatedEndDate">
          <DataField>EstimatedEndDate</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="CompletionDate">
          <DataField>CompletionDate</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Status">
          <DataField>Status</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
  </DataSets>
