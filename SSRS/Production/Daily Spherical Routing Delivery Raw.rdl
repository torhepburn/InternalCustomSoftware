          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="firstScan">
          <DataField>firstScan</DataField>
          <rd:TypeName>System.DateTime</rd:TypeName>
        </Field>
        <Field Name="Run_Time">
          <DataField>Run Time</DataField>
          <rd:TypeName>System.Decimal</rd:TypeName>
        </Field>
        <Field Name="EstimatedEnd">
          <DataField>EstimatedEnd</DataField>
          <rd:TypeName>System.DateTime</rd:TypeName>
        </Field>
        <Field Name="DashboardStatus">
          <DataField>DashboardStatus</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="DashboardLastScanDate">
          <DataField>DashboardLastScanDate</DataField>
          <rd:TypeName>System.DateTime</rd:TypeName>
        </Field>
        <Field Name="DayOffset">
          <DataField>DayOffset</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
        <Field Name="Status">
          <DataField>Status</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
  </DataSets>
