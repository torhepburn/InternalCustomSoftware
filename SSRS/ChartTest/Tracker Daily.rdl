<?xml version="1.0" encoding="utf-8"?>
<Report MustUnderstand="df" xmlns="http://schemas.microsoft.com/sqlserver/reporting/2016/01/reportdefinition" xmlns:rd="http://schemas.microsoft.com/SQLServer/reporting/reportdesigner" xmlns:df="http://schemas.microsoft.com/sqlserver/reporting/2016/01/reportdefinition/defaultfontfamily">
  <df:DefaultFontFamily>Segoe UI</df:DefaultFontFamily>
  <AutoRefresh>0</AutoRefresh>
  <DataSources>
    <DataSource Name="DataSource1">
      <ConnectionProperties>
        <DataProvider>SQL</DataProvider>
        <ConnectString>Data Source=MIDDB01.zygo.com;Initial Catalog=Dashboard</ConnectString>
      </ConnectionProperties>
      <rd:SecurityType>DataBase</rd:SecurityType>
      <rd:DataSourceID>2aca61a1-196d-4cc8-9d33-aaabd34c3ea3</rd:DataSourceID>
    </DataSource>
  </DataSources>
  <DataSets>
    <DataSet Name="DataSet1">
      <Query>
        <DataSourceName>DataSource1</DataSourceName>
        <CommandText>SELECT 
 
 YEAR(SnapShotDate) AS Year
 , DATEPART(dy, SnapShotDate) AS Day
 , CONVERT(VARCHAR(8), SnapShotDate, 1) as DateString
 
 , 
 ISNULL((SELECT count(*) AS Counter 
 FROM MK_PurchaseReceipt_TransactionLog  
 WHERE InspectionRequired=1 And CONVERT(VARCHAR(8), ReceivedDate, 1) = CONVERT(VARCHAR(8), p.SnapShotDate, 1)  AND SiteID = 1
 GROUP BY YEAR(ReceivedDate), DATEPART(dy, ReceivedDate), CONVERT(VARCHAR(8), ReceivedDate, 1)),0) AS 'Received'
 
 , ISNULL((Select count(*) As Counter 
 FROM MK_PurchaseReceipt_Approvals AS MK LEFT OUTER JOIN MK_PurchaseReceipt_TransactionLog AS [Log] ON MK.MKReceiptTransactionID = [Log].MKReceiptTransactionID 
 WHERE CONVERT(VARCHAR(8), MK.TransactionDate, 1) = CONVERT(VARCHAR(8), p.SnapShotDate, 1)  AND SiteID = 1),0) AS 'Approved'
 
 , SUM(P.BacklogCount) AS 'Backlog' 
 
 
 FROM SnapShot_TrackerInspectionBacklog P 
 
 WHERE SnapShotDate &gt;= '2021-03-01' --' l_StartDate &amp; "' 
 
 and SnapShotDate&lt;=  '2021-03-31' --' l_EndDate &amp; "'  FilterSite &amp;

 AND SiteID = 1
 
 GROUP BY SnapshotDate 
 
 ORDER BY YEAR(SnapShotDate), DATEPART(dy, SnapShotDate)</CommandText>
        <rd:UseGenericDesigner>true</rd:UseGenericDesigner>
      </Query>
      <Fields>
        <Field Name="Year">
          <DataField>Year</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
        <Field Name="Day">
          <DataField>Day</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
        <Field Name="DateString">
          <DataField>DateString</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Received">
          <DataField>Received</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
        <Field Name="Approved">
          <DataField>Approved</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
        <Field Name="Backlog">
          <DataField>Backlog</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
  </DataSets>
