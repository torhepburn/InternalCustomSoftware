<?xml version="1.0" encoding="utf-8"?>
<Report MustUnderstand="df" xmlns="http://schemas.microsoft.com/sqlserver/reporting/2016/01/reportdefinition" xmlns:rd="http://schemas.microsoft.com/SQLServer/reporting/reportdesigner" xmlns:df="http://schemas.microsoft.com/sqlserver/reporting/2016/01/reportdefinition/defaultfontfamily">
  <df:DefaultFontFamily>Segoe UI</df:DefaultFontFamily>
  <AutoRefresh>0</AutoRefresh>
  <DataSources>
    <DataSource Name="DataSource1">
      <ConnectionProperties>
        <DataProvider>SQL</DataProvider>
        <ConnectString>Data Source=CT-MID-SQL11;Initial Catalog=AccessFrontEnds</ConnectString>
      </ConnectionProperties>
      <rd:SecurityType>DataBase</rd:SecurityType>
      <rd:DataSourceID>c9020dce-42f9-46b4-83f0-c61b87561947</rd:DataSourceID>
    </DataSource>
  </DataSources>
  <DataSets>
    <DataSet Name="DataSet1">
      <Query>
        <DataSourceName>DataSource1</DataSourceName>
        <CommandText>WITH s1 AS
(
	 SELECT ItemCode FROM Shortage_List WHERE DateArchived is Null
)


SELECT 

[Change Date Reason Code]
,[Buy-from Vendor Name]
,[Document No_]
,[PO Line No]
,[Job No_]
,No_
,Description
,[Old Promised Receipt Date]
,[New Promised Receipt Date]
,REPLACE([Modified by User],'AMETEK-AD\','') [Modified by User]
,[Last Date Modified]
,CASE
	WHEN ItemCode is Null THEN 'N'
	ELSE 'Y'
END Shortage


FROM [NAV Purch Date Change Daily] c

LEFT JOIN s1 ON c.No_ = s1.ItemCode

ORDER BY 

[Change Date Reason Code]
,[Buy-from Vendor Name]
,[Document No_]
,[PO Line No]</CommandText>
        <rd:UseGenericDesigner>true</rd:UseGenericDesigner>
      </Query>
      <Fields>
        <Field Name="Change_Date_Reason_Code">
          <DataField>Change Date Reason Code</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Buy_from_Vendor_Name">
          <DataField>Buy-from Vendor Name</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Document_No_">
          <DataField>Document No_</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="PO_Line_No">
          <DataField>PO Line No</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
        <Field Name="Job_No_">
          <DataField>Job No_</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="No_">
          <DataField>No_</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Description">
          <DataField>Description</DataField>
