          <rd:TypeName>System.DateTime</rd:TypeName>
        </Field>
        <Field Name="New_Promised_Receipt_Date">
          <DataField>New Promised Receipt Date</DataField>
          <rd:TypeName>System.DateTime</rd:TypeName>
        </Field>
        <Field Name="Modified_by_User">
          <DataField>Modified by User</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Last_Date_Modified">
          <DataField>Last Date Modified</DataField>
          <rd:TypeName>System.DateTime</rd:TypeName>
        </Field>
        <Field Name="Shortage">
          <DataField>Shortage</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
  </DataSets>
