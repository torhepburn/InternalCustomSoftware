          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="CUST_PO">
          <DataField>CUST PO</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Customer">
