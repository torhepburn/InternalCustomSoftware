<?xml version="1.0" encoding="utf-8"?>
<Report MustUnderstand="df" xmlns="http://schemas.microsoft.com/sqlserver/reporting/2016/01/reportdefinition" xmlns:rd="http://schemas.microsoft.com/SQLServer/reporting/reportdesigner" xmlns:df="http://schemas.microsoft.com/sqlserver/reporting/2016/01/reportdefinition/defaultfontfamily">
  <df:DefaultFontFamily>Segoe UI</df:DefaultFontFamily>
  <AutoRefresh>0</AutoRefresh>
  <DataSources>
    <DataSource Name="NAV">
      <DataSourceReference>NAV</DataSourceReference>
      <rd:SecurityType>None</rd:SecurityType>
      <rd:DataSourceID>3db7bfb1-eb34-4939-805b-7365b68cd77d</rd:DataSourceID>
    </DataSource>
  </DataSources>
  <DataSets>
    <DataSet Name="DataSet1">
      <Query>
        <DataSourceName>NAV</DataSourceName>
        <CommandText>DECLARE @region varchar(10)
SET @region = 'CHN';

WITH s1 AS
(
	SELECT 

	[Item No_]
	,[Unit Price]

	FROM [ZYGO$Sales Price]

	WHERE [Sales Code] = 'ZAF'

	AND [Ending Date] &gt; GETDATE()
)





select

COALESCE(dreg.[Dimension Value Code],'') REGION
,COALESCE(l.[Shortcut Dimension 2 Code],'') [Business Segment]
,h.[External Document No_] [CUST PO]
,h.[Sell-to Customer Name] [Customer]
,h.[End User Customer Name] [End Customer]
,[Document No_] ORD
,[SO Line No_] POS
,l.[Job No_] [PROJ #]
,l.No_ AS [ITEM NO]
,l.Description [ITEM DESCRIPTION]
,COALESCE(l.[Shortcut Dimension 2 Code],'') [BUSINESS SEGMENT]
,[Bin Code] WHS
,COALESCE(dind.[Dimension Value Code],'') LOB
,CASE 
	WHEN CAST(FORMAT(h.[Order Date], 'MM-dd-yy') as varchar(8)) = '01-01-53' THEN ''
	ELSE CAST(FORMAT(h.[Order Date], 'MM-dd-yy') as varchar(8)) 
END [ORD DATE]
,CASE 
	WHEN CAST(FORMAT(l.[Requested Delivery Date], 'MM-dd-yy') as varchar(8)) = '01-01-53' THEN ''
	ELSE CAST(FORMAT(l.[Requested Delivery Date], 'MM-dd-yy') as varchar(8)) 
END [REQ DATE]
,CASE 
	WHEN CAST(FORMAT(l.[Promised Delivery Date], 'MM-dd-yy') as varchar(8)) = '01-01-53' THEN ''
	ELSE CAST(FORMAT(l.[Promised Delivery Date], 'MM-dd-yy') as varchar(8)) 
END [DEL DATE]
,Quantity [QTY ORD]
,[Quantity Shipped] [QTY DLV]
,[Outstanding Quantity] [QTY TO DLV]
,l.[Unit Price] [PRICE]
,[Line Discount _] [% DISC]
,[Outstanding Quantity] * l.[Unit Price] [SHIP BL]
, CASE
	WHEN l.[Unit Price] &gt; 0 THEN CAST(CAST(ROUND((COALESCE(p.[Unit Price]/l.[Unit Price],0)*100),0) as int) AS Varchar(2)) + ' %'
	ELSE '0 %'
END [Reg Mrg]
,COALESCE(p.[Unit Price],0) [Reg Tp]
,CASE
	WHEN l.[Unit Price] &gt; 0 THEN CAST(CAST(ROUND((COALESCE(i.[Standard Cost]/l.[Unit Price],0)*100),0) AS int) AS varchar(2)) + ' %'
	ELSE '0 %'
END[Fact Mrg]
,COALESCE(i.[Standard Cost],0) [Fact COS]


from [ZYGO$Sales Header] h

INNER JOIN [ZYGO$Sales Line] l ON h.No_ = l.[Document No_] and h.[Document Type] = l.[Document Type]

left join	[ZYGO$Dimension Set Entry] dind on l.[Dimension Set ID] = dind.[Dimension Set ID] and dind.[Dimension Code] = 'INDUSTRY'
left join	[ZYGO$Dimension Set Entry] dreg on l.[Dimension Set ID] = dreg.[Dimension Set ID] and dreg.[Dimension Code] = 'REGION'

LEFT JOIN s1 p ON l.No_ = p.[Item No_]

LEFT JOIN ZYGO$Item i ON l.No_ = i.No_

WHERE [Outstanding Quantity] &lt;&gt; 0

AND l.[SO Line No_] &lt; 500

AND COALESCE(dreg.[Dimension Value Code],'') = @region

UNION ALL

select

COALESCE(dreg.[Dimension Value Code],'') REGION
,COALESCE(l.[Shortcut Dimension 2 Code],'') [Business Segment]
,h.[Your Reference] [CUST PO]
,h.[Name] [Customer]
,h.[End User Customer Name] [End Customer]
,[Document No_] ORD
,[Srv Line No_] POS
,l.[Job No_] [PROJ #]
,l.No_ AS [ITEM NO]
,l.Description [ITEM DESCRIPTION]
,COALESCE(l.[Shortcut Dimension 2 Code],'') [BUSINESS SEGMENT]
,[Bin Code] WHS
,COALESCE(dind.[Dimension Value Code],'') LOB
,CASE 
	WHEN CAST(FORMAT(h.[Order Date], 'MM-dd-yy') as varchar(8)) = '01-01-53' THEN ''
	ELSE CAST(FORMAT(h.[Order Date], 'MM-dd-yy') as varchar(8)) 
END [ORD DATE]
,CASE 
	WHEN CAST(FORMAT(l.[Requested Delivery Date], 'MM-dd-yy') as varchar(8)) = '01-01-53' THEN ''
	ELSE CAST(FORMAT(l.[Requested Delivery Date], 'MM-dd-yy') as varchar(8)) 
END [REQ DATE]
,CASE 
	WHEN CAST(FORMAT(l.[Promised Delivery Date], 'MM-dd-yy') as varchar(8)) = '01-01-53' THEN ''
	ELSE CAST(FORMAT(l.[Promised Delivery Date], 'MM-dd-yy') as varchar(8)) 
END [DEL DATE]
,Quantity [QTY ORD]
,[Quantity Shipped] [QTY DLV]
,[Outstanding Quantity] [QTY TO DLV]
,l.[Unit Price] [PRICE]
,[Line Discount _] [% DISC]
,[Outstanding Quantity] * l.[Unit Price] [SHIP BL]
, CASE
	WHEN l.[Unit Price] &gt; 0 THEN CAST(CAST(ROUND((COALESCE(p.[Unit Price]/l.[Unit Price],0)*100),0) as int) AS Varchar(2)) + ' %'
	ELSE '0'
END [Reg Mrg]
,COALESCE(p.[Unit Price],0) [Reg Tp]
,CASE
	WHEN l.[Unit Price] &gt; 0 THEN CAST(CAST(ROUND((COALESCE(i.[Standard Cost]/l.[Unit Price],0)*100),0) AS int) AS varchar(2)) + ' %'
	ELSE '0 %'
END[Fact Mrg]
,COALESCE(i.[Standard Cost],0) [Fact COS]


from [ZYGO$Service Header] h

INNER JOIN [ZYGO$Service Line] l ON h.No_ = l.[Document No_] and h.[Document Type] = l.[Document Type]

left join	[ZYGO$Dimension Set Entry] dind on l.[Dimension Set ID] = dind.[Dimension Set ID] and dind.[Dimension Code] = 'INDUSTRY'
left join	[ZYGO$Dimension Set Entry] dreg on l.[Dimension Set ID] = dreg.[Dimension Set ID] and dreg.[Dimension Code] = 'REGION'

LEFT JOIN s1 p ON l.No_ = p.[Item No_]

LEFT JOIN ZYGO$Item i ON l.No_ = i.No_

WHERE [Outstanding Quantity] &lt;&gt; 0

AND l.[Srv Line No_] &lt; 500

AND COALESCE(dreg.[Dimension Value Code],'')  = @region




/*
UNION ALL



select

h.[Document Type]
,h.No_ Order_No
,[Line No_]
,[Line No_] [SO Line No_]
,CASE 
	WHEN CAST(FORMAT(h.[Order Date], 'MM-dd-yy') as varchar(8)) = '01-01-53' THEN ''
	ELSE CAST(FORMAT(h.[Order Date], 'MM-dd-yy') as varchar(8)) 
END [Order Date]
,h.[Customer No_] [Sell-to Customer No_]
,h.[Bill-to Customer No_]
,h.[Bill-to Name]
,h.[Ship-to Name]
,h.[Ship-to County]
,h.[Ship-to Country_Region Code]
,h.Name [Sell-to Customer Name]
,l.Type
,l.No_ AS Item_No
,l.[Job No_]
,l.[Location Code]
,l.[Posting Group]
,CASE 
	WHEN CAST(FORMAT(l.[Planned Delivery Date], 'MM-dd-yy') as varchar(8)) = '01-01-53' THEN ''
	ELSE CAST(FORMAT(l.[Planned Delivery Date], 'MM-dd-yy') as varchar(8)) 
END [Shipment Date]
,l.Description
,Quantity
,[Outstanding Quantity]
,[Unit Price]
,[Line Discount _]
,[Line Discount Amount]
,Amount
,CASE
	WHEN Quantity = 0 THEN 0
	WHEN Quantity &lt;&gt; 0 THEN 
		CASE
			WHEN Quantity = [Outstanding Quantity] THEN Amount
			ELSE [Outstanding Quantity] * ([Unit Price] - [Line Discount Amount])/Quantity
		END
END [Backlog Amount]
,[Outstanding Amount]
,l.[Shortcut Dimension 1 Code]
,l.[Shortcut Dimension 2 Code]
,l.[Gen_ Bus_ Posting Group]
,l.[Gen_ Prod_ Posting Group]
,l.[Item Category Code]
,l.[Shipment No_]
,l.[Completely Shipped]
,CASE 
	WHEN CAST(FORMAT(h.[Posting Date], 'MM-dd-yy') as varchar(8)) = '01-01-53' THEN ''
	ELSE CAST(FORMAT(h.[Posting Date], 'MM-dd-yy') as varchar(8)) 
END [Posting Date]
,l.[Qty_ Invoiced (Base)]
,l.[Dimension Set ID]
,COALESCE(dcos.[Dimension Value Code] ,'') COSTCENTER
,COALESCE(dind.[Dimension Value Code],'') INDUSTRY
,COALESCE(djob.[Dimension Value Code],'') JOB
,COALESCE(dreg.[Dimension Value Code],'') REGION
,COALESCE(dsit.[Dimension Value Code],'') SITE
,COALESCE(dseg.[Dimension Value Code],'') SEGMENT
,COALESCE(dcat.[Dimension Value Code],'') PRODCAT
,COALESCE(dicp	.[Dimension Value Code],'') ICP
,'Sevice Order' Order_Source
,CASE
	WHEN l.No_ LIKE 'FREIGHT%' THEN 'FREIGHT'
	WHEN l.No_ LIKE 'SVC CNTRCT YR%' THEN 'PRIORITY SUPPORT'
	WHEN l.No_ LIKE 'ADVANCE DEPOSIT%' THEN 'ADVANCE DEPOSIT'
	ELSE 'FIN GOODS'
END line_group
,h.[Customer No_]
,h.[Your Reference] [External Document No_]
,h.[End User Customer Name]
,CAST('' as varchar(8)) [Contract Date]
,CASE 
	WHEN CAST(FORMAT(l.[Orig_ Requested Delivery Date], 'MM-dd-yy') as varchar(8)) = '01-01-53' THEN ''
	ELSE CAST(FORMAT(l.[Orig_ Requested Delivery Date], 'MM-dd-yy') as varchar(8)) 
END [Orig_ Requested Delivery Date]
,CASE 
	WHEN CAST(FORMAT(l.[Requested Delivery Date], 'MM-dd-yy') as varchar(8)) = '01-01-53' THEN ''
	ELSE CAST(FORMAT(l.[Requested Delivery Date], 'MM-dd-yy') as varchar(8)) 
END [Requested Delivery Date]
,CASE 
	WHEN CAST(FORMAT(l.[Orig_ Promised Delivery Date], 'MM-dd-yy') as varchar(8)) = '01-01-53' THEN ''
	ELSE CAST(FORMAT(l.[Orig_ Promised Delivery Date], 'MM-dd-yy') as varchar(8)) 
END [Orig_ Promised Delivery Date]
,CASE 
	WHEN CAST(FORMAT(l.[Promised Delivery Date], 'MM-dd-yy') as varchar(8)) = '01-01-53' THEN ''
	ELSE CAST(FORMAT(l.[Promised Delivery Date], 'MM-dd-yy') as varchar(8)) 
END [Promised Delivery Date]
,CASE 
	WHEN CAST(FORMAT(l.[Planned Delivery Date], 'MM-dd-yy') as varchar(8)) = '01-01-53' THEN ''
	ELSE CAST(FORMAT(l.[Planned Delivery Date], 'MM-dd-yy') as varchar(8)) 
END [Planned Delivery Date]
,CAST(GETDATE() as date) Backlog_Date

from [ZYGO$Service Header] h

INNER JOIN [ZYGO$Service Line] l ON h.No_ = l.[Document No_] and h.[Document Type] = l.[Document Type]

left join	[ZYGO$Dimension Set Entry] dcos on l.[Dimension Set ID] = dcos.[Dimension Set ID] and dcos.[Dimension Code] = 'COSTCENTER'
left join	[ZYGO$Dimension Set Entry] dseg on l.[Dimension Set ID] = dseg.[Dimension Set ID] and dseg.[Dimension Code] = 'SEGMENT'
left join	[ZYGO$Dimension Set Entry] dind on l.[Dimension Set ID] = dind.[Dimension Set ID] and dind.[Dimension Code] = 'INDUSTRY'
left join	[ZYGO$Dimension Set Entry] dreg on l.[Dimension Set ID] = dreg.[Dimension Set ID] and dreg.[Dimension Code] = 'REGION'
left join	[ZYGO$Dimension Set Entry] dsit on l.[Dimension Set ID] = dsit.[Dimension Set ID] and dreg.[Dimension Code] = 'SITE'
left join	[ZYGO$Dimension Set Entry] dicp on l.[Dimension Set ID] = dicp.[Dimension Set ID] and dicp.[Dimension Code] = 'ICP'
left join	[ZYGO$Dimension Set Entry] dcat on l.[Dimension Set ID] = dcat.[Dimension Set ID] and dcat.[Dimension Code] = 'PRODCAT'
left join	[ZYGO$Dimension Set Entry] djob on l.[Dimension Set ID] = djob.[Dimension Set ID] and djob.[Dimension Code] = 'JOB'

WHERE [Outstanding Quantity] &lt;&gt; 0

AND COALESCE(dreg.[Dimension Value Code],'')  = 'CHN'
*/

ORDER BY 


[Business Segment]
,ORD
,POS</CommandText>
        <rd:UseGenericDesigner>true</rd:UseGenericDesigner>
      </Query>
      <Fields>
        <Field Name="REGION">
          <DataField>REGION</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Business_Segment">
