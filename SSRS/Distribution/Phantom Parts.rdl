<Report xmlns="http://schemas.microsoft.com/sqlserver/reporting/2016/01/reportdefinition" xmlns:rd="http://schemas.microsoft.com/SQLServer/reporting/reportdesigner" xmlns:df="http://schemas.microsoft.com/sqlserver/reporting/2016/01/reportdefinition/defaultfontfamily" MustUnderstand="df">
  <df:DefaultFontFamily>Segoe UI</df:DefaultFontFamily>
  <AutoRefresh>0</AutoRefresh>
  <DataSources>
    <DataSource Name="NAV">
      <DataSourceReference>NAV</DataSourceReference>
      <rd:SecurityType>None</rd:SecurityType>
      <rd:DataSourceID>30a0c4de-3361-48d6-994a-48a10d81030e</rd:DataSourceID>
    </DataSource>
  </DataSources>
  <DataSets>
    <DataSet Name="DataSet1">
      <Query>
        <DataSourceName>NAV</DataSourceName>
        <CommandText>select 

No_
,Description
,[Inventory Posting Group]
,COALESCE([Sales Code], 'not on any price list') Sales_Code
,COALESCE(s.[Unit Price],0) Unit_Price


From ZYGO$Item i

LEFT JOIN [ZYGO$Sales Price] s ON s.[Item No_] = i.No_

where [Selection Code] = 'PHT'

AND s.[Starting Date] &lt;= GETDATE()

AND s.[Ending Date] &gt;= GETDATE()

UNION ALL

select 

No_
,Description
,[Inventory Posting Group]
,'not on any price list'
,0

From ZYGO$Item i

where [Selection Code] = 'PHT'

AND No_ NOT IN

(SELECT [Item No_]  FROM [ZYGO$Sales Price])</CommandText>
        <rd:UseGenericDesigner>true</rd:UseGenericDesigner>
      </Query>
      <Fields>
        <Field Name="No_">
          <DataField>No_</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Description">
          <DataField>Description</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Inventory_Posting_Group">
          <DataField>Inventory Posting Group</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Sales_Code">
          <DataField>Sales_Code</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Unit_Price">
          <DataField>Unit_Price</DataField>
          <rd:TypeName>System.Decimal</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
  </DataSets>
