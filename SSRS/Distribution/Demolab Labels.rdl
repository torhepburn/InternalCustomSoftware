  <DataSets>
    <DataSet Name="DataSet1">
      <Query>
        <DataSourceName>DemoLab</DataSourceName>
        <CommandText>SELECT DISTINCT
      [ItemLabel]
      
  FROM [DemoLab].[dbo].[ItemLog]

  WHERE LEN(ItemLabel) &gt; 6

  ORDER BY ITEMLABEL</CommandText>
        <rd:UseGenericDesigner>true</rd:UseGenericDesigner>
      </Query>
      <Fields>
        <Field Name="ItemLabel">
          <DataField>ItemLabel</DataField>
          <rd:TypeName>System.String</rd:TypeName>
