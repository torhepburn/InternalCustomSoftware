<?xml version="1.0" encoding="utf-8"?>
<Report MustUnderstand="df" xmlns="http://schemas.microsoft.com/sqlserver/reporting/2016/01/reportdefinition" xmlns:rd="http://schemas.microsoft.com/SQLServer/reporting/reportdesigner" xmlns:df="http://schemas.microsoft.com/sqlserver/reporting/2016/01/reportdefinition/defaultfontfamily">
  <df:DefaultFontFamily>Segoe UI</df:DefaultFontFamily>
  <AutoRefresh>0</AutoRefresh>
  <DataSources>
    <DataSource Name="NAV">
      <DataSourceReference>NAV</DataSourceReference>
      <rd:SecurityType>None</rd:SecurityType>
      <rd:DataSourceID>8e74460b-6b9c-49cb-bb05-de51ae3eb691</rd:DataSourceID>
    </DataSource>
  </DataSources>
  <DataSets>
    <DataSet Name="DataSet1">
      <Query>
        <DataSourceName>NAV</DataSourceName>
        <CommandText>
WITH s1 AS
/* item vendors for purchased glass	*/
(
	SELECT
	
	i.No_
	,iv.[Vendor No_]
	,v.Name [Vendor Name]
	,[Old Inspection Code]
	,[New Inspection Code]

	FROM [ZYGO$Item Vendor] iv

	INNER JOIN ZYGO$Item i ON iv.[Item No_] = i.No_

	INNER JOIN ZYGO$Vendor v on iv.[Vendor No_] = v.No_

	WHERE (i.Commodity like 'O%'

	OR i.Commodity IN ('RGL','SGM','SOC', 'SOP'))

	and [Replenishment System] = 0 --purchased

	--AND iv.[Item No_] = '6300-0763-01'
)

,s3 AS
(
	select 

	[Item No_]
	,[Buy-from Vendor No_] [Vendor No_]
	,s1.[Vendor Name]
	,Count(we.Quantity) ReceiptTimes
	,[Old Inspection Code]
	,[New Inspection Code]

	from [ZYGO$Warehouse Entry] we

	LEFT JOIN [ZYGO$Purchase Line] pl ON we.[Source No_] = pl.[Document No_] and we.[Source Line No_] = pl.[Line No_]

	INNER JOIN s1 ON s1.No_ = we.[Item No_] AND pl.[Buy-from Vendor No_] = s1.[Vendor No_]

	WHERE [Registering Date] &gt;= GETDATE()-730

	and [Source Document] = 5

	GROUP BY [Item No_], [Buy-from Vendor No_], [Vendor Name], [Old Inspection Code], [New Inspection Code]
)

SELECT

[Item No_]
,Description
,Commodity
,[Global Dimension 2 Code] [Business Segment]
,[Vendor Name]
,s3.[Vendor No_]
,s3.[Old Inspection Code]
,s3.[New Inspection Code]
,ReceiptTimes

FROM s3

INNER JOIN ZYGO$Item i ON s3.[Item No_] = i.No_

ORDER BY [Item No_]
</CommandText>
        <rd:UseGenericDesigner>true</rd:UseGenericDesigner>
      </Query>
      <Fields>
        <Field Name="Item_No_">
          <DataField>Item No_</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Description">
          <DataField>Description</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Commodity">
          <DataField>Commodity</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Business_Segment">
