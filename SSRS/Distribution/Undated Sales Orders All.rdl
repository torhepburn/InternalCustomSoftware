<?xml version="1.0" encoding="utf-8"?>
<Report MustUnderstand="df" xmlns="http://schemas.microsoft.com/sqlserver/reporting/2016/01/reportdefinition" xmlns:rd="http://schemas.microsoft.com/SQLServer/reporting/reportdesigner" xmlns:df="http://schemas.microsoft.com/sqlserver/reporting/2016/01/reportdefinition/defaultfontfamily">
  <df:DefaultFontFamily>Segoe UI</df:DefaultFontFamily>
  <AutoRefresh>0</AutoRefresh>
  <DataSources>
    <DataSource Name="DataSource1">
      <ConnectionProperties>
        <DataProvider>SQL</DataProvider>
        <ConnectString>Data Source=pa-hor-as408.ametek.com;Initial Catalog=ZYGO-NAV-PROD</ConnectString>
      </ConnectionProperties>
      <rd:SecurityType>DataBase</rd:SecurityType>
      <rd:DataSourceID>61433081-089f-49fd-9d02-7aa6ff8c125f</rd:DataSourceID>
    </DataSource>
  </DataSources>
  <DataSets>
    <DataSet Name="DataSet1">
      <Query>
        <DataSourceName>DataSource1</DataSourceName>
        <CommandText>WITH s1 AS
(
	SELECT 
	
	[Document No_]
	,SUM(Amount) [ORD AMT]
	FROM
	[ZYGO$Sales Line]
	GROUP BY [Document No_]
)
,s2 AS
(
SELECT

/* easier to group in sql than in ssrs  */

CASE 
	WHEN (SH.[Order Date]) &gt;= Convert(DateTime, DATEDIFF(DAY, 1, GETDATE())) THEN 'G1'
	WHEN (SH.[Order Date]) &lt; Convert(DateTime, DATEDIFF(DAY, 1, GETDATE())) AND (SH.[Order Date]) &gt;= Convert(DateTime, DATEDIFF(DAY, 21, GETDATE())) THEN 'G2'
	ELSE 'G3'
END [OrderAge]
,CASE 
	WHEN (SH.[Order Date]) &gt;= Convert(DateTime, DATEDIFF(DAY, 1, GETDATE())) THEN 'Orders Entered Yesterday or Today'
	WHEN (SH.[Order Date]) &lt; Convert(DateTime, DATEDIFF(DAY, 1, GETDATE())) AND (SH.[Order Date]) &gt;= Convert(DateTime, DATEDIFF(DAY, 21, GETDATE())) THEN 'Orders Entered Within The Last 3 Weeks'
	ELSE 'Orders More Than 3 Weeks Old'
END [OrderAgeDescription]

,SH.[Order Date]

,Name
,SL.[Document No_]
,SH.[End User Customer Name] [End User]
,SL.[Document No_] [Order]
,SL.[SO Line No_] [POS]
,SL.No_ [ITEM CODE]
,SL.Description [DESCRIPTION]
,SL.[Job No_] [Job]
,COALESCE(J.[Description],'') [JOB DESC]
,SL.[Shortcut Dimension 2 Code] [BUS SEGMENT]
,CASE 
						WHEN COALESCE(SL.[Shortcut Dimension 2 Code],'') in ('LASER INTERF PROD','LASER INTERF SVCS', 'FACILITIES','ADMIN','OPT PROFILER PROD','OPT PROFILER SVCS') 
							THEN 'INSTRUMENTS'
						WHEN COALESCE(SL.[Shortcut Dimension 2 Code],'') in ('PO VALUE STREAM','LFO VALUE STREAM')
							THEN 'MIDDLEFIELD OPTICS'
						WHEN COALESCE(SL.[Shortcut Dimension 2 Code],'') in ('EUV','CRYSTALLINE OPTICS','GLASS OPTICS','MACHINED STRUCTURES', 'EPO GENERAL') 
							THEN 'EPO'
						WHEN COALESCE(SL.[Shortcut Dimension 2 Code],'') in ('ELECTRO-OPTICS OTHER') 
							THEN 'EO'
						WHEN COALESCE(SL.[Shortcut Dimension 2 Code],'') in ('PPS','PPS SYSTEMS','PPS COMPONENTS','PPS SERVICES') 
							THEN 'PPS'
					END [Business Group]
,SL.[Location Code] [LOC]
,SL.[Bin Code] [BIN]
,CONVERT(NUMERIC(10,2),SL.[Outstanding Quantity]) [QTY]
,CASE COALESCE(SH.[On Hold Reason Code],'')
	WHEN '' THEN 'NO'
	ELSE 'YES'
END [HOLD]

,SL.[Planned Delivery Date] [PL DEL]
,CASE SL.[Requested Delivery Date]
	WHEN '1753-01-01 00:00:00.000' THEN '1900-01-01'
	ELSE SL.[Requested Delivery Date]
END [RQST DEL]
,CONVERT(NUMERIC(10,2),SL.[Outstanding Amount]) [LINE AMT]
,CONVERT(NUMERIC(10,2),[ORD AMT]) [ORD AMT]
,CASE (SH.[Shipping Advice])
	WHEN 0 THEN 'P'
	ELSE 'C'
END [SHIP]
,CASE (COALESCE(SH.[Govt_ Priority Rating Code],''))
	WHEN '' THEN 'NO'
	ELSE SH.[Govt_ Priority Rating Code]
END [GVT RATED]



FROM [ZYGO$Sales Line] SL

INNER JOIN [ZYGO$Sales Header] SH ON SL.[Document No_] = SH.No_ 

LEFT JOIN ZYGO$Customer C ON SL.[Sell-to Customer No_] = C.No_

LEFT JOIN ZYGO$Job J ON SL.[Job No_] = J.No_

LEFT JOIN s1 ON SL.[Document No_] = s1.[Document No_]


where 1=1

AND SL.[No_] NOT LIKE  'FREIGH%' 

AND [Outstanding Quantity] &gt; 0

AND SH.[Document Type] = 1

AND SL.[Planned Delivery Date] = '2050-12-30'


)


,s3 AS
(
	SELECT 
	
	[Document No_]
	,SUM([Amount Including VAT]) [ORD AMT]
	FROM
	[ZYGO$Service Line]
	GROUP BY [Document No_]
)
, s4 AS
(
	SELECT

	CASE 
		WHEN (svh.[Order Date]) &gt;= Convert(DateTime, DATEDIFF(DAY, 1, GETDATE())) THEN 'G1'
		WHEN (svh.[Order Date]) &lt; Convert(DateTime, DATEDIFF(DAY, 1, GETDATE())) AND (svh.[Order Date]) &gt;= Convert(DateTime, DATEDIFF(DAY, 21, GETDATE())) THEN 'G2'
		ELSE 'G3'
	END [OrderAge]
	,CASE 
		WHEN (svh.[Order Date]) &gt;= Convert(DateTime, DATEDIFF(DAY, 1, GETDATE())) THEN 'Orders Entered Yesterday or Today'
		WHEN (svh.[Order Date]) &lt; Convert(DateTime, DATEDIFF(DAY, 1, GETDATE())) AND (svh.[Order Date]) &gt;= Convert(DateTime, DATEDIFF(DAY, 21, GETDATE())) THEN 'Orders Entered Within The Last 3 Weeks'
		ELSE 'Orders More Than 3 Weeks Old'
	END [OrderAgeDescription]

	,svh.[Order Date]
	,c.Name

	,svl.[Document No_]
	,svh.[End User Customer Name] [End User]
	,svl.[Document No_] [Order]
	,svl.[Srv Line No_] [POS]
	,svl.No_ [ITEM CODE]
	,svl.Description [DESCRIPTION]
	,svl.[Job No_] [Job]
	,COALESCE(j.[Description],'') [JOB DESC]
	,svl.[Shortcut Dimension 2 Code] [BUS SEGMENT]
	,CASE 
						WHEN COALESCE(svl.[Shortcut Dimension 2 Code],'') in ('LASER INTERF PROD','LASER INTERF SVCS', 'FACILITIES','ADMIN','OPT PROFILER PROD','OPT PROFILER SVCS') 
							THEN 'INSTRUMENTS'
						WHEN COALESCE(svl.[Shortcut Dimension 2 Code],'') in ('PO VALUE STREAM','LFO VALUE STREAM')
							THEN 'MIDDLEFIELD OPTICS'
						WHEN COALESCE(svl.[Shortcut Dimension 2 Code],'') in ('EUV','CRYSTALLINE OPTICS','GLASS OPTICS','MACHINED STRUCTURES', 'EPO GENERAL') 
							THEN 'EPO'
						WHEN COALESCE(svl.[Shortcut Dimension 2 Code],'') in ('ELECTRO-OPTICS OTHER') 
							THEN 'EO'
						WHEN COALESCE(svl.[Shortcut Dimension 2 Code],'') in ('PPS','PPS SYSTEMS','PPS COMPONENTS','PPS SERVICES') 
							THEN 'PPS'
					END [Business Group]
	,svl.[Location Code] [LOC]
	,svl.[Bin Code] [BIN]
	,CONVERT(NUMERIC(10,2),svl.[Outstanding Quantity]) [QTY]
	,CASE COALESCE(svh.[On Hold Reason Code],'')
		WHEN '' THEN 'NO'
		ELSE 'YES'
	END [HOLD]

	,svl.[Planned Delivery Date] [PL DEL]
	,CASE svl.[Requested Delivery Date]
		WHEN '1753-01-01 00:00:00.000' THEN '1900-01-01'
		ELSE svl.[Requested Delivery Date]
	END [RQST DEL]
	,CONVERT(NUMERIC(10,2),svl.[Outstanding Amount]) [LINE AMT]
	,CONVERT(NUMERIC(10,2),[ORD AMT]) [ORD AMT]
	,CASE (svh.[Shipping Advice])
		WHEN 0 THEN 'P'
		ELSE 'C'
	END [SHIP]
	,'' [GVT RATED]

	FROM [ZYGO$Service Header] svh

	INNER JOIN [ZYGO$Service Line] svl ON svh.No_ = svl.[Document No_]

	LEFT JOIN ZYGO$Customer c ON svl.[Bill-to Customer No_] = c.No_

	LEFT JOIN s3 ON svl.[Document No_] = s3.[Document No_]

	LEFT JOIN ZYGO$Job j ON svl.[Job No_] = j.No_

	WHERE svl.[Planned Delivery Date] = '2050-12-30'  /*	2030 sales admins don't want planners to date  2050 planners can date 	*/

	AND [Outstanding Quantity] &gt; 0

	AND svh.[Document Type] = 1

	AND svl.No_ NOT LIKE 'FREIGHT%'
)

SELECT * FROM s2

UNION ALL

SELECT * FROM s4

ORDER BY 

OrderAge
,[Order Date]
,Name
,POS
--CASE 
--	WHEN (SH.[Order Date]) &gt;= Convert(DateTime, DATEDIFF(DAY, 1, GETDATE())) THEN 'G1'
--	WHEN (SH.[Order Date]) &lt; Convert(DateTime, DATEDIFF(DAY, 1, GETDATE())) AND (SH.[Order Date]) &gt;= Convert(DateTime, DATEDIFF(DAY, 21, GETDATE())) THEN 'G2'
--	ELSE 'G3'
--END
--,SH.[Order Date]
--,SH.[Sell-to Customer No_] 
--,SL.[SO Line No_]</CommandText>
        <rd:UseGenericDesigner>true</rd:UseGenericDesigner>
      </Query>
