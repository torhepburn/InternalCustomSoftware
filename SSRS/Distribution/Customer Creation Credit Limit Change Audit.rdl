<?xml version="1.0" encoding="utf-8"?>
<Report MustUnderstand="df" xmlns="http://schemas.microsoft.com/sqlserver/reporting/2016/01/reportdefinition" xmlns:rd="http://schemas.microsoft.com/SQLServer/reporting/reportdesigner" xmlns:df="http://schemas.microsoft.com/sqlserver/reporting/2016/01/reportdefinition/defaultfontfamily">
  <df:DefaultFontFamily>Segoe UI</df:DefaultFontFamily>
  <AutoRefresh>0</AutoRefresh>
  <DataSources>
    <DataSource Name="DataSource1">
      <ConnectionProperties>
        <DataProvider>SQL</DataProvider>
        <ConnectString>Data Source=pa-hor-as408;Initial Catalog=ZYGO-NAV-PROD</ConnectString>
      </ConnectionProperties>
      <rd:SecurityType>DataBase</rd:SecurityType>
      <rd:DataSourceID>fc40843b-0552-4ed1-a059-f8797a748472</rd:DataSourceID>
    </DataSource>
  </DataSources>
  <DataSets>
    <DataSet Name="DataSet1">
      <Query>
        <DataSourceName>DataSource1</DataSourceName>
        <CommandText>select	
	[Date and Time] as [Change Date Time],
	[User ID] as [Changed by],
	'Customerr' as [Table Name],
	[Primary Key Field 1 Value] as [Customer No],
	v.[Name] as [Vendor Name],
	case [Field No_] 
		when 1		then 'No.'
		when 2		then 'Name'
		when 20		then 'Credit Limit (LCY)'
		when 50005	then 'Date Created'
		when 50004	then 'Created by User'
	end as [Field Name],
	case [Type of Change]
		when 0 then 'New'
		when 1 then 'Modification'
	end as [Change],
	[Old Value],
	[New Value]

from 
	[ZYGO$Change Log Entry] l
	inner join ZYGO$Customer v on l.[Primary Key Field 1 Value] = v.No_

where 
	[Table No_] = 18 -- Customer
--and cast([Date and Time] as date) = cast(getdate()-1 as date) -- yesterday
and [Field No_] in (
	1, --no
	2, -- name
	20, --blocked
	50005, -- date created
	50004 -- created by user
	)

AND [User ID] = 'AMETEK-AD\CSOM'

AND [Date and Time] &gt;= '2021-01-01'</CommandText>
        <rd:UseGenericDesigner>true</rd:UseGenericDesigner>
      </Query>
      <Fields>
        <Field Name="Change_Date_Time">
          <DataField>Change Date Time</DataField>
          <rd:TypeName>System.DateTime</rd:TypeName>
        </Field>
        <Field Name="Changed_by">
          <DataField>Changed by</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Table_Name">
          <DataField>Table Name</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Customer_No">
          <DataField>Customer No</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Vendor_Name">
          <DataField>Vendor Name</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Field_Name">
          <DataField>Field Name</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Change">
          <DataField>Change</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Old_Value">
          <DataField>Old Value</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="New_Value">
          <DataField>New Value</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
  </DataSets>
