<?xml version="1.0" encoding="utf-8"?>
<Report MustUnderstand="df" xmlns="http://schemas.microsoft.com/sqlserver/reporting/2016/01/reportdefinition" xmlns:rd="http://schemas.microsoft.com/SQLServer/reporting/reportdesigner" xmlns:df="http://schemas.microsoft.com/sqlserver/reporting/2016/01/reportdefinition/defaultfontfamily">
  <df:DefaultFontFamily>Segoe UI</df:DefaultFontFamily>
  <AutoRefresh>0</AutoRefresh>
  <DataSources>
    <DataSource Name="NAV">
      <DataSourceReference>NAV</DataSourceReference>
      <rd:SecurityType>None</rd:SecurityType>
      <rd:DataSourceID>9337d03b-87db-4820-a6c5-a0f09d600990</rd:DataSourceID>
    </DataSource>
  </DataSources>
  <DataSets>
    <DataSet Name="DataSet1">
      <Query>
        <DataSourceName>NAV</DataSourceName>
        <QueryParameters>
          <QueryParameter Name="@PriceListCode">
            <Value>=Parameters!PriceListCode.Value</Value>
          </QueryParameter>
          <QueryParameter Name="@orderNo">
            <Value>=Parameters!OrderNumber.Value</Value>
            <rd:UserDefined>true</rd:UserDefined>
          </QueryParameter>
        </QueryParameters>
        <CommandText>--Declare @orderNo varchar(20)
--SET @orderNo = '6350';
--SET @orderNo = 'SO001399';


WITH s1 AS
(
	SELECT 

	[Item No_]
	,[Unit Price]

	FROM [ZYGO$Sales Price]

	WHERE [Sales Code] = @PriceListCode

	AND [Ending Date] &gt; GETDATE()
),
s2 AS
(
	select 

	[Job No_]
	,SUM([Total Cost]) Cost

	from [ZYGO$Job Journal Line]

	WHERE [Job No_] in (SELECT [Job No_] FROM [ZYGO$Sales Line] WHERE [Document No_] = @orderNo

	AND LEN([Job No_]) &gt; 0)

	GROUP BY [Job No_]
)





SELECT

 h.[External Document No_] [CUST PO]
,h.[Sell-to Customer Name] [Customer]
,h.[End User Customer Name] [End Customer]
,[Document No_] ORD
,[SO Line No_] POS
,l.[Job No_] [PROJ #]
,l.No_ AS [ITEM NO]
,l.Description [ITEM DESCRIPTION]
,CASE 
	WHEN CAST(FORMAT(h.[Order Date], 'MM/dd/yy') as varchar(8)) = '01/01/53' THEN ''
	ELSE CAST(FORMAT(h.[Order Date], 'MM/dd/yy') as varchar(8)) 
END [ORD DATE]
,CASE 
	WHEN CAST(FORMAT(l.[Requested Delivery Date], 'MM/dd/yy') as varchar(8)) = '01/01/53' THEN ''
	ELSE CAST(FORMAT(l.[Requested Delivery Date], 'MM/dd/yy') as varchar(8)) 
END [REQ DATE]
,CASE 
	WHEN CAST(FORMAT(l.[Promised Delivery Date], 'MM/dd/yy') as varchar(8)) = '01/01/53' THEN ''
	ELSE CAST(FORMAT(l.[Promised Delivery Date], 'MM/dd/yy') as varchar(8)) 
END [DEL DATE]
,CAST(Quantity AS int) [QTY ORD]
,CAST([Quantity Shipped] AS int) [QTY DLV]
,CAST([Outstanding Quantity] AS int) [QTY TO DLV]
,l.[Unit Price] [Line PRICE]
,[Line Discount _] [Line DISC]
,[Outstanding Quantity] * l.[Unit Price] [SHIP BL]
,CASE
	WHEN LEN(l.[Job No_]) = 0 THEN
		CASE
			WHEN l.[Unit Price] &gt; 0 THEN (COALESCE((l.[Unit Price] - i.[Standard Cost])/l.[Unit Price],0))
			ELSE 0
		END
	WHEN LEN(l.[Job No_]) &gt; 0 THEN (COALESCE((l.[Unit Price] - s2.Cost)/l.[Unit Price],0))
	
END [(Line Price - Std Cost)/Line Price]
,[Outstanding Quantity] * COALESCE(p.[Unit Price],0) [BL ZCV]
,COALESCE(CASE
	WHEN LEN(l.[Job No_]) = 0 THEN [Outstanding Quantity] * i.[Standard Cost] 
	WHEN LEN(l.[Job No_]) &gt; 0 THEN [Outstanding Quantity] * s2.Cost 
END,0) [BL std cost]

from [ZYGO$Sales Header] h

INNER JOIN [ZYGO$Sales Line] l ON h.No_ = l.[Document No_] and h.[Document Type] = l.[Document Type]

LEFT JOIN s1 p ON l.No_ = p.[Item No_]

LEFT JOIN s2 ON l.[Job No_] = s2.[Job No_]

LEFT JOIN ZYGO$Item i ON l.No_ = i.No_

WHERE h.No_ = @orderNo

AND l.[SO Line No_] &lt; 500


UNION ALL


select

 h.[Your Reference] [CUST PO]
,h.[Bill-to Name] [Customer]
,h.[End User Customer Name] [End Customer]
,[Document No_] ORD
,[Srv Line No_] POS
,l.[Job No_] [PROJ #]
,l.No_ AS [ITEM NO]
,l.Description [ITEM DESCRIPTION]
,CASE 
	WHEN CAST(FORMAT(h.[Order Date], 'MM/dd/yy') as varchar(8)) = '01/01/53' THEN ''
	ELSE CAST(FORMAT(h.[Order Date], 'MM/dd/yy') as varchar(8)) 
END [ORD DATE]
,CASE 
	WHEN CAST(FORMAT(l.[Requested Delivery Date], 'MM/dd/yy') as varchar(8)) = '01/01/53' THEN ''
	ELSE CAST(FORMAT(l.[Requested Delivery Date], 'MM/dd/yy') as varchar(8)) 
END [REQ DATE]
,CASE 
	WHEN CAST(FORMAT(l.[Promised Delivery Date], 'MM/dd/yy') as varchar(8)) = '01/01/53' THEN ''
	ELSE CAST(FORMAT(l.[Promised Delivery Date], 'MM/dd/yy') as varchar(8)) 
END [DEL DATE]
,CAST(Quantity AS int) [QTY ORD]
,CAST([Quantity Shipped] AS int) [QTY DLV]
,CAST([Outstanding Quantity] AS int) [QTY TO DLV]
,l.[Unit Price] [Line PRICE]
,[Line Discount _] [Line DISC]
,[Outstanding Quantity] * l.[Unit Price] [SHIP BL]
,CASE
	WHEN LEN(l.[Job No_]) = 0 THEN
		CASE
			WHEN l.[Unit Price] &gt; 0 THEN (COALESCE((l.[Unit Price] - i.[Standard Cost])/l.[Unit Price],0))
			ELSE 0
		END
	WHEN LEN(l.[Job No_]) &gt; 0 THEN (COALESCE((l.[Unit Price] - s2.Cost)/l.[Unit Price],0))
	
END [(Line Price - Std Cost)/Line Price]
,[Outstanding Quantity] * COALESCE(p.[Unit Price],0) [BL ZCV]
,COALESCE(CASE
	WHEN LEN(l.[Job No_]) = 0 THEN [Outstanding Quantity] * i.[Standard Cost] 
	WHEN LEN(l.[Job No_]) &gt; 0 THEN [Outstanding Quantity] * s2.Cost 
END,0) [BL std cost]

from [ZYGO$Service Header] h

INNER JOIN [ZYGO$Service Line] l ON h.No_ = l.[Document No_] and h.[Document Type] = l.[Document Type]

LEFT JOIN s1 p ON l.No_ = p.[Item No_]

LEFT JOIN s2 ON l.No_ = s2.[Job No_]

LEFT JOIN ZYGO$Item i ON l.No_ = i.No_

WHERE 

h.No_ = @orderNo

AND l.[Srv Line No_] &lt; 500


ORDER BY 

--[Business Segment]
--,
ORD
,POS</CommandText>
        <rd:UseGenericDesigner>true</rd:UseGenericDesigner>
      </Query>
      <Fields>
        <Field Name="CUST_PO">
          <DataField>CUST PO</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Customer">
          <DataField>Customer</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="End_Customer">
          <DataField>End Customer</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="ORD">
          <DataField>ORD</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="POS">
          <DataField>POS</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
        <Field Name="PROJ__">
          <DataField>PROJ #</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="ITEM_NO">
          <DataField>ITEM NO</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="ITEM_DESCRIPTION">
          <DataField>ITEM DESCRIPTION</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="ORD_DATE">
          <DataField>ORD DATE</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="REQ_DATE">
          <DataField>REQ DATE</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="DEL_DATE">
          <DataField>DEL DATE</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="QTY_ORD">
          <DataField>QTY ORD</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
        <Field Name="QTY_DLV">
          <DataField>QTY DLV</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
        <Field Name="QTY_TO_DLV">
          <DataField>QTY TO DLV</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
        <Field Name="Line_PRICE">
          <DataField>Line PRICE</DataField>
          <rd:TypeName>System.Decimal</rd:TypeName>
        </Field>
        <Field Name="Line_DISC">
          <DataField>Line DISC</DataField>
          <rd:TypeName>System.Decimal</rd:TypeName>
        </Field>
        <Field Name="SHIP_BL">
          <DataField>SHIP BL</DataField>
          <rd:TypeName>System.Decimal</rd:TypeName>
        </Field>
        <Field Name="ID_Line_Price___Std_Cost__Line_Price">
          <DataField>(Line Price - Std Cost)/Line Price</DataField>
          <rd:TypeName>System.Decimal</rd:TypeName>
        </Field>
        <Field Name="BL_ZCV">
          <DataField>BL ZCV</DataField>
          <rd:TypeName>System.Decimal</rd:TypeName>
        </Field>
        <Field Name="BL_std_cost">
          <DataField>BL std cost</DataField>
          <rd:TypeName>System.Decimal</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
    <DataSet Name="DataSet2">
      <Query>
        <DataSourceName>NAV</DataSourceName>
        <CommandText>select 

Code + '  ' + Description Display
,Code

from [ZYGO$Customer Price Group]

Where Code NOT IN ('1','2')</CommandText>
      </Query>
      <Fields>
        <Field Name="Display">
          <DataField>Display</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Code">
          <DataField>Code</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
  </DataSets>
