<?xml version="1.0" encoding="utf-8"?>
<Report MustUnderstand="df" xmlns="http://schemas.microsoft.com/sqlserver/reporting/2016/01/reportdefinition" xmlns:rd="http://schemas.microsoft.com/SQLServer/reporting/reportdesigner" xmlns:df="http://schemas.microsoft.com/sqlserver/reporting/2016/01/reportdefinition/defaultfontfamily">
  <df:DefaultFontFamily>Segoe UI</df:DefaultFontFamily>
  <AutoRefresh>0</AutoRefresh>
  <DataSources>
    <DataSource Name="NAV">
      <DataSourceReference>NAV</DataSourceReference>
      <rd:SecurityType>None</rd:SecurityType>
      <rd:DataSourceID>9e0e9da7-f417-4608-9d7e-c98bd1c5a322</rd:DataSourceID>
    </DataSource>
  </DataSources>
  <DataSets>
    <DataSet Name="DataSet1">
      <Query>
        <DataSourceName>NAV</DataSourceName>
        <CommandText>SELECT

c.[Prod_ Order No_]
,c.[Prod_ Order Line No_]
,c.[Due Date] [Component Due Date]
,c.[Item No_] [Component Item Number]
,l.[Due Date] [Prod Order Line Item Due Date]
,l.[Item No_] [Prod Order Line Item]
,c.[Remaining Quantity] 'remaining Q'

--,* 

FROM

[ZYGO$Prod_ Order Component] c

INNER JOIN [ZYGO$Prod_ Order Line] l 

ON c.[Prod_ Order No_] = l.[Prod_ Order No_]

AND c.[Prod_ Order Line No_] = l.[Line No_]

WHERE l.[Prod_ Order No_] = 'PD104172'

AND c.[Remaining Quantity] &gt; 0

ORDER BY [Prod_ Order Line No_], [Component Item Number]</CommandText>
        <rd:UseGenericDesigner>true</rd:UseGenericDesigner>
      </Query>
      <Fields>
        <Field Name="Prod__Order_No_">
          <DataField>Prod_ Order No_</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Prod__Order_Line_No_">
          <DataField>Prod_ Order Line No_</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
        <Field Name="Component_Due_Date">
          <DataField>Component Due Date</DataField>
          <rd:TypeName>System.DateTime</rd:TypeName>
        </Field>
        <Field Name="Component_Item_Number">
          <DataField>Component Item Number</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Prod_Order_Line_Item_Due_Date">
          <DataField>Prod Order Line Item Due Date</DataField>
          <rd:TypeName>System.DateTime</rd:TypeName>
        </Field>
        <Field Name="Prod_Order_Line_Item">
          <DataField>Prod Order Line Item</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="remaining_Q">
          <DataField>remaining Q</DataField>
          <rd:TypeName>System.Decimal</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
  </DataSets>
