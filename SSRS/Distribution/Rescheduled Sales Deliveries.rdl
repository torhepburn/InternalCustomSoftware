<Report xmlns="http://schemas.microsoft.com/sqlserver/reporting/2016/01/reportdefinition" xmlns:rd="http://schemas.microsoft.com/SQLServer/reporting/reportdesigner" xmlns:df="http://schemas.microsoft.com/sqlserver/reporting/2016/01/reportdefinition/defaultfontfamily" MustUnderstand="df">
  <df:DefaultFontFamily>Segoe UI</df:DefaultFontFamily>
  <AutoRefresh>0</AutoRefresh>
  <DataSources>
    <DataSource Name="NAV">
      <DataSourceReference>NAV</DataSourceReference>
      <rd:SecurityType>None</rd:SecurityType>
      <rd:DataSourceID>2e2e44ea-3507-4a76-aaa1-0aa896200562</rd:DataSourceID>
    </DataSource>
  </DataSources>
  <DataSets>
    <DataSet Name="DataSet1">
      <Query>
        <DataSourceName>NAV</DataSourceName>
        <CommandText>select

COUNT([Entry No_]) no
,[Change Date Reason Code]
,[Description]
--,[Document No_]
--,[Line No_]
,YEAR([Last Date Modified]) yy
,MONTH([Last Date Modified]) mm


From [ZYGO$Change Sales Date Reason Entry] e

LEFT JOIN [ZYGO$Change Date Reasons] r ON e.[Change Date Reason Code] = r.Code

WHERE [Last Date Modified] &gt;= '2022-01-01'

AND [Change Date Reason Code] NOT IN  ('ZDP', 'CDE', 'ZDE', 'NSO')

GROUP BY

YEAR([Last Date Modified]) 
,MONTH([Last Date Modified])
,[Change Date Reason Code]
,Description
--,[Document No_]
--,[Line No_]

ORDER BY 
yy,mm, [Change Date Reason Code]

--[Document No_], [Line No_]</CommandText>
        <rd:UseGenericDesigner>true</rd:UseGenericDesigner>
      </Query>
      <Fields>
        <Field Name="no">
          <DataField>no</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
        <Field Name="Change_Date_Reason_Code">
          <DataField>Change Date Reason Code</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Description">
          <DataField>Description</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="yy">
          <DataField>yy</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
        <Field Name="mm">
          <DataField>mm</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
  </DataSets>
