<?xml version="1.0" encoding="utf-8"?>
<Report MustUnderstand="df" xmlns="http://schemas.microsoft.com/sqlserver/reporting/2016/01/reportdefinition" xmlns:rd="http://schemas.microsoft.com/SQLServer/reporting/reportdesigner" xmlns:df="http://schemas.microsoft.com/sqlserver/reporting/2016/01/reportdefinition/defaultfontfamily">
  <df:DefaultFontFamily>Segoe UI</df:DefaultFontFamily>
  <AutoRefresh>0</AutoRefresh>
  <DataSources>
    <DataSource Name="NAV">
      <DataSourceReference>NAV</DataSourceReference>
      <rd:SecurityType>None</rd:SecurityType>
      <rd:DataSourceID>94fb38da-af7d-43d4-b671-cf87d23b10b9</rd:DataSourceID>
    </DataSource>
  </DataSources>
  <DataSets>
    <DataSet Name="DataSet1">
      <Query>
        <DataSourceName>NAV</DataSourceName>
        <CommandText>select

'Sales Order Header' NAV_tbl
,No_
,COALESCE([Order Date],'01-01-1753') OrderDate
,CASE
	WHEN [Order Date] &lt; '1754-01-01' THEN 'Missing Order Date'
	ELSE ''
End Error_Text
,[Sell-to Customer No_]
,[Sell-to Customer Name]
,[Bill-to Customer No_]
,[Bill-to Name]
,[Ship-to Code]
,[Ship-to Name]

 from [ZYGO$Sales Header] h

WHERE 

([Order Date] is null OR [Order Date] &lt; '1754-01-01')

AND [Document Type] = 1

UNION ALL

select

'Service Order Header' NAV_tbl
,No_
,COALESCE([Order Date],'01-01-1753') OrderDate
,CASE
	WHEN [Order Date] &lt; '1754-01-01' THEN 'Missing Order Date'
	ELSE ''
End Error_Text
,[Customer No_]
,[Name]
,[Bill-to Customer No_]
,[Bill-to Name]
,[Ship-to Code]
,[Ship-to Name]

 from [ZYGO$Service Header] h

WHERE 

([Order Date] is null OR [Order Date] &lt; '1754-01-01')

AND [Document Type] = 1</CommandText>
        <rd:UseGenericDesigner>true</rd:UseGenericDesigner>
      </Query>
