  <DataSets>
    <DataSet Name="DataSet1">
      <Query>
        <DataSourceName>DataSource1</DataSourceName>
        <CommandText>SET DATEFIRST 1;

SELECT 

[Planned Delivery Date]
,sl.[Promised Delivery Date]
,sl.[Requested Delivery Date]
,sh.[Sell-to Customer No_]
,c.Name
,sh.[End User Customer Name]
,[Document No_]
,[SO Line No_]
,sl.[Job No_]
,sl. No_
,[Description]
,[Bin Code]
, Quantity
,CONVERT(Numeric(10,2),[Qty_ Shipped (Base)]) [Qty_ Shipped (Base)]
,[Outstanding Quantity]
,CONVERT(Numeric(10,2),sl.[Amount]) [Amount]
,CONVERT(Numeric(10,2),sl.[Outstanding Amount]) [Outstanding Amount]
,COALESCE(sl.[Shortcut Dimension 2 Code],'') [Business Segment]

FROM [ZYGO$Sales Line] sl

INNER JOIN ZYGO$Customer c on sl.[Sell-to Customer No_] = c.No_

LEFT JOIN [ZYGO$Sales Header] sh on sl.[Document No_] = sh.No_

WHERE 1=1

AND [Outstanding Quantity] &gt; 0

AND [Planned Delivery Date] &gt;= (GETDATE() - (DATEPART(DW, GETDATE())))

AND [Planned Delivery Date] &lt;= (GETDATE() - (DATEPART(DW, GETDATE()))) + 12

ORDER BY 

[Planned Delivery Date]
,c.Name
,[Document No_]
,[SO Line No_]</CommandText>
        <rd:UseGenericDesigner>true</rd:UseGenericDesigner>
      </Query>
      <Fields>
        <Field Name="Document_No_">
          <DataField>Document No_</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Sell_to_Customer_No_">
          <DataField>Sell-to Customer No_</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
