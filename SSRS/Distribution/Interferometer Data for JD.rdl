  <DataSets>
    <DataSet Name="DataSet1">
      <Query>
        <DataSourceName>NAV</DataSourceName>
        <CommandText>with s1 AS
(
	SELECT 
	
	[Item No_]
	,SUM(Quantity) [Quantity on hand]

	FROM [ZYGO$Item Ledger Entry]

	GROUP BY [Item No_]
)
select

No_ [PartNum.]
,COALESCE(CASE SIM 
    WHEN 1 THEN 'A1' 
    WHEN 2 THEN 'A2' 
    WHEN 3 THEN 'A3' 
    WHEN 4 THEN 'B1' 
    WHEN 5 THEN 'B2' 
    WHEN 6 THEN 'B3' 
    WHEN 7 THEN 'C1' 
    WHEN 8 THEN 'C2' 
    WHEN 9 THEN 'C3' 
END,'') [ABC Common]
,Description
,CASE [Replenishment System]
	WHEN 0 THEN 'BUY'--0 = purchased 
	ELSE 'MAKE'
END [Make vs Buy]
, COALESCE(s1.[Quantity on hand],0) [Quantity on hand]
,[Standard Cost] [Standard Unit Cost]
,''[Daily Run Rate]
,''[Total Plant Usage]
,''[Qty Overflow]
,''[Max Monthly Cost]
,''[Kanban Mgmt DOS]
,''[$ Overflow]
,''[Calculated Kanban Qty]
,''[Bin Size (Daily Usage/# Cards)]
,''[Trigger Quantity]
,''[Supplier Kanban Qty]
,''[Supplier Trigger quantity]
,''[On Kanban]
,''[QTY for Bin (how much consumed in one day)]

FROM [ZYGO$Item] i

LEFT JOIN s1 ON i.No_ = s1.[Item No_]

where i.No_ IN

(
'0350-1046-01',
'1000-1000-01',
'1000-1020-02',
'1000-1020-04',
'1000-1020-05',
