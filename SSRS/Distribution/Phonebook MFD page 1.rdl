<?xml version="1.0" encoding="utf-8"?>
<Report MustUnderstand="df" xmlns="http://schemas.microsoft.com/sqlserver/reporting/2016/01/reportdefinition" xmlns:rd="http://schemas.microsoft.com/SQLServer/reporting/reportdesigner" xmlns:df="http://schemas.microsoft.com/sqlserver/reporting/2016/01/reportdefinition/defaultfontfamily">
  <df:DefaultFontFamily>Segoe UI</df:DefaultFontFamily>
  <AutoRefresh>0</AutoRefresh>
  <DataSources>
    <DataSource Name="DataSource1">
      <ConnectionProperties>
        <DataProvider>SQL</DataProvider>
        <ConnectString>Data Source=ct-mid-sql11;Initial Catalog=AccessFrontEnds</ConnectString>
      </ConnectionProperties>
      <rd:SecurityType>DataBase</rd:SecurityType>
      <rd:DataSourceID>68c9679f-1772-4ea4-9ee4-63b9830a99d0</rd:DataSourceID>
    </DataSource>
  </DataSources>
  <DataSets>
    <DataSet Name="DataSet1">
      <Query>
        <DataSourceName>DataSource1</DataSourceName>
        <CommandText>WITH s1 AS

(
select 

sn + ', ' + SUBSTRING(cn,0,CHARINDEX(' ', cn)) Name
,COALESCE(
	CASE
		WHEN LEFT(telephonenumber, 17) = '+1 860 347 8506 x'
			THEN SUBSTRING(telephonenumber, 18, 4)
		WHEN LEFT(telephonenumber, 13) = '+1 860 343 89'
			THEN SUBSTRING(telephonenumber, 12, 4)
		WHEN LEFT(telephonenumber, 10) = '+1 860 704'
			THEN SUBSTRING(telephonenumber, 12, 4)
		ELSE telephonenumber
END
,'') Ext

from EmployeesAmetekAD

WHERE BU = 'CT-MID'

UNION All

SELECT

LEFT(sn, 1) 
,''

FROM EmployeesAmetekAD

GROUP By LEFT(sn, 1)

--ORDER BY Name
)

,c1 AS (select * from s1 order by name OFFSET 0 ROWS FETCH FIRST 50 ROWS ONLY)
,c1A AS (select ROW_NUMBER() OVER(order by Name) Row, * from c1) 
,c2 AS (select  Name, Ext from s1 order by name OFFSET 50 ROWS FETCH FIRST 50 ROWS ONLY)
,c2A AS (select ROW_NUMBER() OVER(order by Name) Row, * from c2) 
,c3 AS (select * from s1 order by name OFFSET 100 ROWS FETCH FIRST 50 ROWS ONLY)
,c3A AS (select ROW_NUMBER() OVER(order by Name) Row, * from c3) 
,c4 AS (select  Name, Ext from s1 order by name OFFSET 150 ROWS FETCH FIRST 50 ROWS ONLY)
,c4A AS (select ROW_NUMBER() OVER(order by Name) Row, * from c4) 
,c5 AS (select * from s1 order by name OFFSET 200 ROWS FETCH FIRST 50 ROWS ONLY)
,c5A AS (select ROW_NUMBER() OVER(order by Name) Row, * from c5) 


select 

c1A.Name n1
,c1A.ext e1
,c2A.Name n2
,c2A.ext e2
,c3A.Name n3
,c3A.ext e3
,c4A.Name n4
,c4A.ext e4
,c5A.Name n5
,c5A.ext e5



from c1A 

INNER JOIN c2A ON c1A.Row = c2A.Row
INNER JOIN c3A ON c1A.Row = c3A.Row
INNER JOIN c4A ON c1A.Row = c4A.Row
INNER JOIN c5A ON c1A.Row = c5A.Row</CommandText>
        <rd:UseGenericDesigner>true</rd:UseGenericDesigner>
      </Query>
      <Fields>
        <Field Name="n1">
          <DataField>n1</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="e1">
          <DataField>e1</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="n2">
          <DataField>n2</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="e2">
          <DataField>e2</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="n3">
          <DataField>n3</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="e3">
          <DataField>e3</DataField>
