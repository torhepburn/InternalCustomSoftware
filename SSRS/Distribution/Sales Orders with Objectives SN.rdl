<?xml version="1.0" encoding="utf-8"?>
<Report MustUnderstand="df" xmlns="http://schemas.microsoft.com/sqlserver/reporting/2016/01/reportdefinition" xmlns:rd="http://schemas.microsoft.com/SQLServer/reporting/reportdesigner" xmlns:df="http://schemas.microsoft.com/sqlserver/reporting/2016/01/reportdefinition/defaultfontfamily">
  <df:DefaultFontFamily>Segoe UI</df:DefaultFontFamily>
  <AutoRefresh>0</AutoRefresh>
  <DataSources>
    <DataSource Name="NAV">
      <DataSourceReference>NAV</DataSourceReference>
      <rd:SecurityType>None</rd:SecurityType>
      <rd:DataSourceID>4c2b0daf-1d2f-40c2-bf46-5740ae916d9f</rd:DataSourceID>
    </DataSource>
  </DataSources>
  <DataSets>
    <DataSet Name="DataSet1">
      <Query>
        <DataSourceName>NAV</DataSourceName>
        <CommandText> WITH s1 AS
 (
 SELECT 
 
 TS.[Source ID] AS 'OrderNumber'
 , TS.[Serial No_] AS 'SerialNumber'
 , TS.[Item No_] AS 'PartNumber'
 ,CASE 
	WHEN LEN(h.[End User Customer Name]) &gt; 0 THEN h.[End User Customer Name]
	WHEN LEN(h.[End User Customer Name]) = 0 THEN h.[Sell-to Customer Name]
END 
 Customer
 ,CASE h.Status
	WHEN 0 THEN 'Open'
	WHEN 1 THEN 'Released'
	WHEN 2 THEN 'Pending Approval'
	WHEN 2 THEN 'Pending Prepayment'
	ELSE ''
END [Status]
,[Order Date]
,COALESCE(h.[End User Customer Name],'') [End User]
,h.[External Document No_]
                                                      
FROM [ZYGO$Tracking Specification] TS

INNER JOIN [ZYGO$Sales Header] h ON TS.[Source ID] = h.No_

Where [Item No_] IN                                                         --WHERE TS.[Source ID]='" &amp; _SO.OrderNumber &amp; "' AND TS.[Source Type]='37' 
    
(	
'6300-0194-01'
,'6300-0194-02'
,'6300-0595-01'
,'6300-0596-01'
,'6300-0597-01'
,'6401-0100-03'
,'6401-0101-02'
,'6401-0124-01'
,'6401-0135-02'
,'6401-0203-01'
,'6300-0318-01'
,'6401-0106-01'
,'6401-0112-01'
,'6401-0115-01'
,'6401-0126-02'
,'6401-0127-02'
,'6401-0128-02'
,'6300-0307-01'
,'6401-0131-02'
,'6401-0179-01'
)

AND [Order Date] &gt;= GETDATE()-730
)


SELECT 

[Document No_]
,[SO Line No_]
,Status
,Customer
,l.[Shortcut Dimension 2 Code] Segment
,r.[Dimension Value Code] Region
,ind.[Dimension Value Code] Industry
,l.[Job No_] [Job]
,l.No_
,l.Description
,l.[Unit of Measure]
,l.Quantity
,l.[Unit Price]
,l.Amount
,l.[Outstanding Quantity]
,l.[Quantity Shipped] [Shipped Quantity]
,[Order Date]
,l.[Requested Delivery Date]
,l.[Planned Delivery Date]
,l.[Promised Delivery Date]
,l.[Planned Shipment Date]
,l.[Shipment Date]
,l.[Location Code]
,l.[Bin Code]
,[External Document No_] [Ext. Doc]
, SerialNumber

FROM [ZYGO$Sales Line] l

INNER JOIN s1 ON l.[Document No_] = s1.OrderNumber and l.No_ = s1.PartNumber

LEFT JOIN [ZYGO$Dimension Set Entry] ind ON l.[Dimension Set ID] = ind.[Dimension Set ID] AND ind.[Dimension Code] = 'INDUSTRY'

LEFT JOIN [ZYGO$Dimension Set Entry] r ON l.[Dimension Set ID] = r.[Dimension Set ID] AND r.[Dimension Code] = 'REGION'
</CommandText>
        <rd:UseGenericDesigner>true</rd:UseGenericDesigner>
      </Query>
      <Fields>
        <Field Name="Document_No_">
          <DataField>Document No_</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
