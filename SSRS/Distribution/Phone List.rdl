<?xml version="1.0" encoding="utf-8"?>
<Report MustUnderstand="df" xmlns="http://schemas.microsoft.com/sqlserver/reporting/2016/01/reportdefinition" xmlns:rd="http://schemas.microsoft.com/SQLServer/reporting/reportdesigner" xmlns:df="http://schemas.microsoft.com/sqlserver/reporting/2016/01/reportdefinition/defaultfontfamily">
  <df:DefaultFontFamily>Segoe UI</df:DefaultFontFamily>
  <AutoRefresh>0</AutoRefresh>
  <DataSources>
    <DataSource Name="DataSource1">
      <ConnectionProperties>
        <DataProvider>SQL</DataProvider>
        <ConnectString>Data Source=CT-MID-SQL11;Initial Catalog=AccessFrontEnds</ConnectString>
      </ConnectionProperties>
      <rd:SecurityType>DataBase</rd:SecurityType>
      <rd:DataSourceID>adc271de-0da2-495e-b539-f898f1921be4</rd:DataSourceID>
    </DataSource>
  </DataSources>
  <DataSets>
    <DataSet Name="DataSet1">
      <Query>
        <DataSourceName>DataSource1</DataSourceName>
        <QueryParameters>
          <QueryParameter Name="@Location">
            <Value>=Parameters!Location.Value</Value>
            <rd:UserDefined>true</rd:UserDefined>
          </QueryParameter>
        </QueryParameters>
        <CommandText>select 

sn + ', ' + SUBSTRING(cn,0,CHARINDEX(' ', cn)) Name
,COALESCE(
	CASE
		WHEN LEFT(telephonenumber, 17) = '+1 860 347 8506 x'
			THEN SUBSTRING(telephonenumber, 18, 4)
		WHEN LEFT(telephonenumber, 13) = '+1 860 343 89'
			THEN SUBSTRING(telephonenumber, 12, 4)
		WHEN LEFT(telephonenumber, 10) = '+1 860 704'
			THEN SUBSTRING(telephonenumber, 12, 4)
                                     WHEN LEFT(telephonenumber, 10) = '+1 510 243'
			THEN SUBSTRING(telephonenumber, 12, 4)
		WHEN LEFT(telephonenumber, 10) = '+1 714 918'
			THEN SUBSTRING(telephonenumber, 12, 4)
		ELSE telephonenumber
END
,'') Ext
--,telephonenumber

from EmployeesAmetekAD

WHERE BU = @Location

UNION All

SELECT

LEFT(sn, 1) 
,''

FROM EmployeesAmetekAD

GROUP By LEFT(sn, 1)

ORDER BY Name</CommandText>
        <rd:UseGenericDesigner>true</rd:UseGenericDesigner>
      </Query>
      <Fields>
        <Field Name="Name">
          <DataField>Name</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Ext">
          <DataField>Ext</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
