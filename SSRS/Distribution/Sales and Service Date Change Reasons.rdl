<?xml version="1.0" encoding="utf-8"?>
<Report MustUnderstand="df" xmlns="http://schemas.microsoft.com/sqlserver/reporting/2016/01/reportdefinition" xmlns:rd="http://schemas.microsoft.com/SQLServer/reporting/reportdesigner" xmlns:df="http://schemas.microsoft.com/sqlserver/reporting/2016/01/reportdefinition/defaultfontfamily">
  <df:DefaultFontFamily>Segoe UI</df:DefaultFontFamily>
  <AutoRefresh>0</AutoRefresh>
  <DataSources>
    <DataSource Name="NAV">
      <DataSourceReference>NAV</DataSourceReference>
      <rd:SecurityType>None</rd:SecurityType>
      <rd:DataSourceID>0ba9fe99-9ea3-4c46-a50f-b0e58cdab328</rd:DataSourceID>
    </DataSource>
  </DataSources>
  <DataSets>
    <DataSet Name="DataSet1">
      <Query>
        <DataSourceName>NAV</DataSourceName>
        <CommandText>WITH s1 AS
(
	SELECT 

	MAX([Entry No_]) MaxEntry
	,[Document No_]
	,[Line No_]

	FROM[ZYGO$Change Sales Date Reason Entry]

	GROUP BY 

	[Document No_]
	,[Line No_]
)
,s2 AS
(
SELECT

l.[Document No_]
,l.[Line No_]
,COALESCE(e.[Change Date Reason Code],'') [Change Date Reason Code]
,COALESCE(r.Description,'') Reason
,e.[Entry No_]

FROM [ZYGO$Sales Line] l

INNER JOIN [ZYGO$Change Sales Date Reason Entry] e ON l.[Document No_] = e.[Document No_] and l.[Line No_] = e.[Line No_]

INNER JOIN [ZYGO$Change Date Reasons] r ON e.[Change Date Reason Code] = r.Code
)
,s3 AS
(
	SELECT 

	MAX([Entry No_]) MaxEntry
	,[Document No_]
	,[Line No_]

	FROM[ZYGO$Change Serv_ Date Reason Entry]

	GROUP BY 

	[Document No_]
	,[Line No_]
)
, s4 AS
(
	SELECT

	l.[Document No_]
	,l.[Line No_]
	,COALESCE(e.[Change Date Reason Code],'') [Change Date Reason Code]
	,COALESCE(r.Description,'') Reason
	,e.[Entry No_]

	FROM [ZYGO$Service Line] l

	INNER JOIN [ZYGO$Change Serv_ Date Reason Entry] e ON l.[Document No_] = e.[Document No_] and l.[Line No_] = e.[Line No_]

	INNER JOIN [ZYGO$Change Date Reasons] r ON e.[Change Date Reason Code] = r.Code
)

SELECT

s2.[Document No_]
,s2.[Line No_]
,s2.[Change Date Reason Code]
,s2.Reason

FROM s1 INNER JOIN s2 ON s1.MaxEntry = s2.[Entry No_]

UNION ALL

SELECT

s4.[Document No_]
,s4.[Line No_]
,s4.[Change Date Reason Code]
,s4.Reason

FROM s3 INNER JOIN s4 ON s3.MaxEntry = s4.[Entry No_]

ORDER BY [Document No_], [Line No_]</CommandText>
        <rd:UseGenericDesigner>true</rd:UseGenericDesigner>
      </Query>
      <Fields>
        <Field Name="Document_No_">
          <DataField>Document No_</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Line_No_">
          <DataField>Line No_</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
        <Field Name="Change_Date_Reason_Code">
          <DataField>Change Date Reason Code</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Reason">
          <DataField>Reason</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
  </DataSets>
