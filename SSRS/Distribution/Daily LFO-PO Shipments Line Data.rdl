<?xml version="1.0" encoding="utf-8"?>
<Report MustUnderstand="df" xmlns="http://schemas.microsoft.com/sqlserver/reporting/2016/01/reportdefinition" xmlns:rd="http://schemas.microsoft.com/SQLServer/reporting/reportdesigner" xmlns:df="http://schemas.microsoft.com/sqlserver/reporting/2016/01/reportdefinition/defaultfontfamily">
  <df:DefaultFontFamily>Segoe UI</df:DefaultFontFamily>
  <AutoRefresh>0</AutoRefresh>
  <DataSources>
    <DataSource Name="NAV">
      <DataSourceReference>NAV</DataSourceReference>
      <rd:SecurityType>None</rd:SecurityType>
      <rd:DataSourceID>27e62bf8-3b82-4624-b105-607baea17491</rd:DataSourceID>
    </DataSource>
  </DataSources>
  <DataSets>
    <DataSet Name="DataSet1">
      <Query>
        <DataSourceName>NAV</DataSourceName>
        <CommandText>WITH s1 AS
(
select

sil.[Shortcut Dimension 2 Code] BusinessSegment 
,sih.[Bill-to Name]
,sil.No_
,sil.Description
,sil.Quantity
--,MONTH(sil.[Posting Date])
--,CAST(YEAR(sil.[Posting Date]) as nchar(4)) +
--CASE MONTH(sil.[Posting Date]) 
--	WHEN 1 THEN '01'
--	WHEN 2 THEN '02'
--	WHEN 3 THEN '03'
--	WHEN 4 THEN '04'
--	WHEN 5 THEN '05'
--	WHEN 6 THEN '06'
--	WHEN 7 THEN '07'
--	WHEN 8 THEN '08'
--	WHEN 9 THEN '09'
--	WHEN 10 THEN '10'
--	WHEN 11 THEN '11'
--	WHEN 12 THEN '12'
--	ELSE ''
--END [Shipment Date]
,sil.[Posting Date] [Shipment Date]
,sil.[Orig_ Promised Delivery Date]
,sil.Amount
,sih.[Order No_]
,[SO Line No_]



--,COUNT(sil.Quantity) QtyShipped

from [ZYGO$Sales Invoice Line] sil

INNER JOIN [ZYGO$Sales Invoice Header] sih ON sil.[Document No_] = sih.No_

WHERE Quantity &gt; 0  AND sil.No_ NOT IN ('FREIGHT', 'FREIGHT EXPORT', 'FREIGHT INT''L')

AND MONTH(sil.[Posting Date]) &gt; MONTH(DATEADD(mm,-1,GETDATE()))

AND YEAR(sil.[Posting Date]) &gt; YEAR(DATEADD(yy,-1,GETDATE()))

AND sil.[Shortcut Dimension 2 Code] IN ('LFO VALUE STREAM','PO VALUE STREAM')
)

/*
SELECT

BusinessSegment 
,[Bill-to Name]
,No_
,Description
,SUM(Quantity) QtyShipped
,[Shipment Date]

FROM s1

GROUP BY


BusinessSegment
,[Bill-to Name]
,No_
,Description
,[Shipment Date]

ORDER BY [Shipment Date]
*/
select * from s1

ORDER BY [Shipment Date]</CommandText>
        <rd:UseGenericDesigner>true</rd:UseGenericDesigner>
      </Query>
