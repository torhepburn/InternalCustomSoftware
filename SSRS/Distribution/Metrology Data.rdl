<?xml version="1.0" encoding="utf-8"?>
<Report MustUnderstand="df" xmlns="http://schemas.microsoft.com/sqlserver/reporting/2016/01/reportdefinition" xmlns:rd="http://schemas.microsoft.com/SQLServer/reporting/reportdesigner" xmlns:df="http://schemas.microsoft.com/sqlserver/reporting/2016/01/reportdefinition/defaultfontfamily">
  <df:DefaultFontFamily>Segoe UI</df:DefaultFontFamily>
  <AutoRefresh>0</AutoRefresh>
  <DataSources>
    <DataSource Name="DataSource1">
      <ConnectionProperties>
        <DataProvider>SQL</DataProvider>
        <ConnectString>Data Source=MIDDB01.zygo.com;Initial Catalog=Dashboard</ConnectString>
      </ConnectionProperties>
      <rd:SecurityType>DataBase</rd:SecurityType>
      <rd:DataSourceID>c9d06ed7-efda-4da1-8d71-d9f7931fe64b</rd:DataSourceID>
    </DataSource>
  </DataSources>
  <DataSets>
    <DataSet Name="DataSet1">
      <Query>
        <DataSourceName>DataSource1</DataSourceName>
        <CommandText>WITH s1 AS
(
SELECT [MetrologyDataID]
      ,[SerialNumber]
      
  FROM [Dashboard].[dbo].[MetrologyData] MD

  where 

  MetrologyID in 
  (
     3622
	,5364
	,6114
	,6115
  )
  )
  ,s2 AS
  (
	SELECT 

[MetrologyDataID]
,[Data]

  FROM [Dashboard].[dbo].[MetrologyDataDetails]

  where metrologypassfailid 

  IN 

  (
	SELECT [MetrologyPassFailID]

	FROM [Dashboard].[dbo].[MetrologyPassFail]

	  where 

	  ItemNumber in ('2.00','70.00')

	  AND

	  Name like 'Beamsplitter%'

	  AND

	 MetrologyID in 
	  (
		 3622
		,5364
		,6114
		,6115
	  )

  )

  )

  SELECT 

  s1.SerialNumber ObjectiveSerialNumber
  ,s2.Data BeamSplitterCubeSerialNumber

  FROM s1 LEFT JOIN s2 ON s1.MetrologyDataID = s2.MetrologyDataID</CommandText>
        <rd:UseGenericDesigner>true</rd:UseGenericDesigner>
      </Query>
      <Fields>
        <Field Name="ObjectiveSerialNumber">
          <DataField>ObjectiveSerialNumber</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="BeamSplitterCubeSerialNumber">
          <DataField>BeamSplitterCubeSerialNumber</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
  </DataSets>
