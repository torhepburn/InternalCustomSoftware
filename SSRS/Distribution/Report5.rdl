  <DataSets>
    <DataSet Name="DataSet1">
      <Query>
        <DataSourceName>DataSource1</DataSourceName>
        <CommandText>/*	11-30-2021	*/

CREATE TABLE #ItemText
(
 [ItemNo] nvarchar(20)
,[Text] nvarchar(300)
)


CREATE TABLE #Temp
(
 [ItemNo] nvarchar(20)
,[LineNo] int
,[Text] nvarchar(100)
)


INSERT INTO #Temp

( 
  [ItemNo]
 ,[LineNo]
 ,[Text]
 )

SELECT
[Code 1] as [itemNo]
,[Line No_] as [LineNo]
,[Text] [SalesText]
from [ZYGO$Text Module Line]
where [Print Mgt_ Code] = 'S-ORDERS' 
and [Table ID] = 27
and [Code 1] in 

(Select [Item No_]
FROM [ZYGO$Sales Price] s
INNER JOIN ZYGO$Item i on 
s.[Item No_] = i.[No_] 
where 
[Signal Code] NOT LIKE 'OBS%' and 
[Starting Date] &gt; '02-06-1995' and 
[Starting Date] &lt;= GETDATE() and 
([Ending Date] &gt;=  GETDATE() OR 
 [Ending Date] is null))


declare @item varchar(30)
declare @line int
declare @text varchar(100)
declare @salesText varchar(300)
declare @tt varchar(4000)
SET @salesText = ''

declare itemCursor Cursor for 

select distinct [itemNo] FROM #Temp

order by [itemNo]

open itemCursor

fetch next from itemCursor into @item

while @@FETCH_STATUS = 0
begin

--PRINT @item

--declare textCursor Cursor for 

--SELECT [Text] FROM #Temp WHERE itemNo = @item

--ORDER BY [LineNo]

--OPEN textCursor

--fetch next from textCursor into @text

--while @@FETCH_STATUS = 0
--begin

	
--	SET @salesText = @salesText + @text

	--PRINT @item + @salesText

	
--fetch next from textCursor into @text	
--end

--close textCursor
--deallocate textCursor

SET @salesText = @item + 'test' 
SET @tt = 'Select ''' + @item + ''',''' +  @salesText + ''''

print @item
print @salesText
print @tt

Insert into #ItemText (ItemNo, [Text]) 
EXEC(@tt)


SET @salesText = ''

	
fetch next from itemCursor into  @item


end
close itemCursor
deallocate itemCursor;



DROP TABLE #Temp;

SELECT * from #ItemText</CommandText>
        <rd:UseGenericDesigner>true</rd:UseGenericDesigner>
      </Query>
