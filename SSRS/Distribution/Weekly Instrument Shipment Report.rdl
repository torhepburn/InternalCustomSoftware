<?xml version="1.0" encoding="utf-8"?>
<Report MustUnderstand="df" xmlns="http://schemas.microsoft.com/sqlserver/reporting/2016/01/reportdefinition" xmlns:rd="http://schemas.microsoft.com/SQLServer/reporting/reportdesigner" xmlns:df="http://schemas.microsoft.com/sqlserver/reporting/2016/01/reportdefinition/defaultfontfamily">
  <df:DefaultFontFamily>Segoe UI</df:DefaultFontFamily>
  <AutoRefresh>0</AutoRefresh>
  <DataSources>
    <DataSource Name="DataSource1">
      <ConnectionProperties>
        <DataProvider>SQL</DataProvider>
        <ConnectString>Data Source=pa-hor-as408.ametek.com;Initial Catalog=ZYGO-NAV-PROD</ConnectString>
      </ConnectionProperties>
      <rd:SecurityType>DataBase</rd:SecurityType>
      <rd:DataSourceID>ddbaf107-e50f-473d-8337-230eaee0682d</rd:DataSourceID>
    </DataSource>
  </DataSources>
  <DataSets>
    <DataSet Name="DataSet1">
      <Query>
        <DataSourceName>DataSource1</DataSourceName>
        <CommandText>SELECT

 [Order No_]
,sih.[Sell-to Customer Name]
,COALESCE(sh.[Ship-to Contact],'') [Ship-to Contact]
,sil.[Posting Date]
,sih.[External Document No_]
,[Dimension Value Code] [Region]
,[SO Line No_]
,sil.No_
,sil.Description
,sil.Quantity
,sil.Amount
,sih.[Ship-to County]
--,sil.[Shortcut Dimension 2 Code]


FROM [ZYGO$Sales Invoice Line] sil

INNER JOIN [ZYGO$Sales Invoice Header] sih on sih.No_ = sil.[Document No_]

LEFT JOIN [ZYGO$Sales Header] sh ON sih.[Order No_] = sh.No_

LEFT JOIN ZYGO$Customer c ON sil.[Sell-to Customer No_] = c.No_

LEFT JOIN [ZYGO$Dimension Set Entry] dse ON sil.[Dimension Set ID] = dse.[Dimension Set ID]

WHERE 1=1

AND [Dimension Code] = 'REGION'

AND [SO Line No_] &lt; 500

AND [SO Line No_] &gt; 0

AND Quantity &gt; 0

AND sil.No_ NOT IN ('DISCOUNT')

AND [Dimension Value Code] IN ('USE', 'USW')

AND sil.[Shortcut Dimension 2 Code] IN 

('LASER INTERF PROD'
,'LASER INTERF SVCS'
,'OPT PROFILER PROD'
,'OPT PROFILER SVCS' )

AND sil.[Posting Date] &gt; GETDATE()-7</CommandText>
        <rd:UseGenericDesigner>true</rd:UseGenericDesigner>
      </Query>
