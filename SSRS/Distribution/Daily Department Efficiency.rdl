 SELECT

	COALESCE(CASE Department
		WHEN 'Block Bevel' THEN 'Jim Fecteau'
		WHEN 'CCOS' THEN 'Rocco Biasca'
		WHEN 'CMS' THEN 'Milton Ives'
		WHEN 'CNC' THEN 'Jim Fecteau'
		WHEN 'Coating' THEN 'Sandeep Kohli'
		WHEN 'EPO CNC' THEN 'Rocco Biasca'
		WHEN 'EPO IBF' THEN 'Rocco Biasca'
		WHEN 'EPO Metrology' THEN 'Rocco Biasca'
		WHEN 'EPO Polish' THEN 'Rocco Biasca'
		WHEN 'EPO QC' THEN 'Rocco Biasca'
		WHEN 'EPO Shape' THEN 'Rocco Biasca'
		WHEN 'EPO Workcell' THEN 'Rocco Biasca'
		WHEN 'EPO-ASM' THEN 'Rocco Biasca'
		WHEN 'Generate' THEN 'Jim Fecteau'
		WHEN 'GPI' THEN 'Matt Didato'
		WHEN 'Grind' THEN 'Jim Fecteau'
		WHEN 'Inspection' THEN 'Dan Milardo'
		WHEN 'LFO Inspect' THEN 'Dan Milardo'
		WHEN 'LFO Metrology' THEN 'Dan Milardo'
		WHEN 'LFO Polish/Bevel' THEN 'Dan Milardo'
		WHEN 'MRF' THEN 'Jim Fecteau'
		WHEN 'OMAC' THEN 'Ryan Ahlquist'
		WHEN 'PO Metrology' THEN 'Dan Milardo'
		WHEN 'Polishing' THEN 'Dan Milardo'
		WHEN 'PPS' THEN 'Ryan Ahlquist'
		WHEN 'Profiler' THEN 'Ryan Ahlquist'
		WHEN 'Spherical' THEN 'Matt Didato'
	END,'') VSManager
	,s4.Department
	,s4.Efficiency
	,s4.[Date]
FROM s4

order by vsmanager</CommandText>
        <rd:UseGenericDesigner>true</rd:UseGenericDesigner>
      </Query>
      <Fields>
        <Field Name="VSManager">
          <DataField>VSManager</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Department">
          <DataField>Department</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Efficiency">
          <DataField>Efficiency</DataField>
          <rd:TypeName>System.Double</rd:TypeName>
        </Field>
        <Field Name="Date">
          <DataField>Date</DataField>
          <rd:TypeName>System.DateTime</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
  </DataSets>
