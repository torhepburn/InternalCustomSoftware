  <AutoRefresh>0</AutoRefresh>
  <DataSources>
    <DataSource Name="DataSource1">
      <ConnectionProperties>
        <DataProvider>SQL</DataProvider>
        <ConnectString>Data Source=pa-hor-as408.ametek.com;Initial Catalog=ZYGO-NAV-PROD</ConnectString>
      </ConnectionProperties>
      <rd:SecurityType>DataBase</rd:SecurityType>
      <rd:DataSourceID>e4981341-0843-4eac-8178-b798de6f6f07</rd:DataSourceID>
    </DataSource>
  </DataSources>
  <DataSets>
    <DataSet Name="DataSet1">
      <Query>
        <DataSourceName>DataSource1</DataSourceName>
        <CommandText>SET DATEFIRST 1;

SELECT 

[Planned Delivery Date]
,CASE sl.[Promised Delivery Date]
    WHEN '01-01-1753' THEN '01-01-2050'
    ELSE sl.[Promised Delivery Date]
END [Promised Delivery Date]
,CASE sl.[Requested Delivery Date]
    WHEN '01-01-1753' THEN '01-01-2050'
    ELSE sl.[Requested Delivery Date]
END [Requested Delivery Date]
,sh.[Sell-to Customer No_]
,c.Name
,sh.[End User Customer Name]
,[Document No_]
,[SO Line No_]
,sl.[Job No_]
,sl. No_
,[Description]
,sl.[Location Code]
,[Bin Code]
,CONVERT(NUMERIC(10,2), Quantity) Quantity
,CONVERT(NUMERIC(10,2), [Qty_ Shipped (Base)]) [Qty_ Shipped (Base)]
,CONVERT(NUMERIC(10,2), [Outstanding Quantity]) [Outstanding Quantity]
,CONVERT(NUMERIC(10,2), sl.Amount) [Amount]
,CONVERT(NUMERIC(10,2), sl.[Outstanding Amount]) [Outstanding Amount]
,COALESCE(sl.[Shortcut Dimension 2 Code],'') [Business Segment]
,CASE 
	WHEN LEN(sh.[On Hold]) &gt; 0 THEN 'Yes'
	ELSE ''
End [On Hold]
,COALESCE(CASE [On Hold Reason Code]
	WHEN '1' THEN 'Customer Requested Hold'
	WHEN '2' THEN 'Lack of PO'
	WHEN '3' THEN 'Lack of L/C or License'
	WHEN '4' THEN 'Change Order Required'
	WHEN '5' THEN 'No Back Orders Allowed'
	WHEN '6' THEN 'Sales Administration'
	WHEN '7' THEN 'Required Bar Code'
	WHEN '8' THEN 'Required Special Invoice'
	WHEN '9' THEN 'Customer Material Required'
	WHEN '10' THEN 'Advance Payment Owed'
	WHEN '11' THEN 'Customer Visit Required'
	WHEN 'F01' THEN 'Finance Hold - Credit'
	WHEN 'PHR' THEN 'Photos Required'
END,'') [On Hold Reason]

FROM [ZYGO$Sales Line] sl

INNER JOIN ZYGO$Customer c on sl.[Sell-to Customer No_] = c.No_

LEFT JOIN [ZYGO$Sales Header] sh on sl.[Document No_] = sh.No_

WHERE 1=1

AND [Outstanding Quantity] &gt; 0

AND [Planned Delivery Date] &gt;= (GETDATE() - (DATEPART(DW, GETDATE())))

AND [Planned Delivery Date] &lt;= (GETDATE() - (DATEPART(DW, GETDATE()))) + 12

UNION ALL

SELECT
		
	svl.[Planned Delivery Date]
	,svl.[Planned Delivery Date] [Promised Delivery Date]
	,CASE svl.[Requested Delivery Date]
		WHEN '01-01-1753' THEN '01-01-2050'
		ELSE svl.[Requested Delivery Date]
		END [Requested Delivery Date]
	,svl.[Bill-to Customer No_] [Sell-to Customer No_]
	,c.Name
	,svh.[End User Customer Name] 
	,svl.[Document No_]
	,svl.[Srv Line No_]
	,svl.[Job No_] 
	,svl.No_ 
	,svl.Description [DESCRIPTION]
	,svl.[Location Code]
	,svl.[Bin Code]
	,CONVERT(NUMERIC(10,2), svl.Quantity) Quantity
	,CONVERT(NUMERIC(10,2), svl.[Qty_ Shipped (Base)]) [Qty_ Shipped (Base)]
	,CONVERT(NUMERIC(10,2), svl.[Outstanding Quantity]) [Outstanding Quantity]
	,CONVERT(NUMERIC(10,2), svl.Amount) [Amount]
	,CONVERT(NUMERIC(10,2), svl.[Outstanding Amount]) [Outstanding Amount]
	,svl.[Shortcut Dimension 2 Code] [Business Segment]
	,CASE COALESCE(svh.[On Hold Reason Code],'')
		WHEN '' THEN 'NO'
		ELSE 'YES'
	END [On Hold]
	,COALESCE(CASE svh.[On Hold Reason Code]
	WHEN '1' THEN 'Customer Requested Hold'
	WHEN '2' THEN 'Lack of PO'
	WHEN '3' THEN 'Lack of L/C or License'
	WHEN '4' THEN 'Change Order Required'
	WHEN '5' THEN 'No Back Orders Allowed'
	WHEN '6' THEN 'Sales Administration'
	WHEN '7' THEN 'Required Bar Code'
	WHEN '8' THEN 'Required Special Invoice'
	WHEN '9' THEN 'Customer Material Required'
	WHEN '10' THEN 'Advance Payment Owed'
	WHEN '11' THEN 'Customer Visit Required'
	WHEN 'F01' THEN 'Finance Hold - Credit'
	WHEN 'PHR' THEN 'Photos Required'
END,'') [On Hold Reason]


	FROM [ZYGO$Service Header] svh

	INNER JOIN [ZYGO$Service Line] svl ON svh.No_ = svl.[Document No_]

	LEFT JOIN ZYGO$Customer c ON svl.[Bill-to Customer No_] = c.No_

	WHERE svl.[Planned Delivery Date] &gt;= (GETDATE() - (DATEPART(DW, GETDATE())))

	AND svl.[Planned Delivery Date] &lt;= (GETDATE() - (DATEPART(DW, GETDATE()))) + 12

	AND svl.[Outstanding Quantity] &gt; 0





ORDER BY [Planned Delivery Date]

,c.Name
,[Document No_]
,[SO Line No_]</CommandText>
        <rd:UseGenericDesigner>true</rd:UseGenericDesigner>
      </Query>
      <Fields>
        <Field Name="Planned_Delivery_Date">
          <DataField>Planned Delivery Date</DataField>
          <rd:TypeName>System.DateTime</rd:TypeName>
        </Field>
        <Field Name="Promised_Delivery_Date">
          <DataField>Promised Delivery Date</DataField>
          <rd:TypeName>System.DateTime</rd:TypeName>
        </Field>
        <Field Name="Requested_Delivery_Date">
          <DataField>Requested Delivery Date</DataField>
          <rd:TypeName>System.DateTime</rd:TypeName>
        </Field>
        <Field Name="Sell_to_Customer_No_">
          <DataField>Sell-to Customer No_</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Name">
          <DataField>Name</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="End_User_Customer_Name">
          <DataField>End User Customer Name</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Document_No_">
          <DataField>Document No_</DataField>
