End [On Hold]
,COALESCE(CASE [On Hold Reason Code]
	WHEN '1' THEN 'Customer Requested Hold'
	WHEN '2' THEN 'Lack of PO'
	WHEN '3' THEN 'Lack of L/C or License'
	WHEN '4' THEN 'Change Order Required'
	WHEN '5' THEN 'No Back Orders Allowed'
