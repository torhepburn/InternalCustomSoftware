<?xml version="1.0" encoding="utf-8"?>
<Report MustUnderstand="df" xmlns="http://schemas.microsoft.com/sqlserver/reporting/2016/01/reportdefinition" xmlns:rd="http://schemas.microsoft.com/SQLServer/reporting/reportdesigner" xmlns:df="http://schemas.microsoft.com/sqlserver/reporting/2016/01/reportdefinition/defaultfontfamily">
  <df:DefaultFontFamily>Segoe UI</df:DefaultFontFamily>
  <AutoRefresh>0</AutoRefresh>
  <DataSources>
    <DataSource Name="NAV">
      <DataSourceReference>NAV</DataSourceReference>
      <rd:SecurityType>None</rd:SecurityType>
      <rd:DataSourceID>071df5a6-335f-4921-a687-4a98dd2ffe4e</rd:DataSourceID>
    </DataSource>
  </DataSources>
  <DataSets>
    <DataSet Name="DataSet1">
      <Query>
        <DataSourceName>NAV</DataSourceName>
        <CommandText>WITH s1 AS
(
select

l.No_
,l.Description
,l.Quantity
,l.[Sell-to Customer No_]
,DATEPART(ww,l.[Shipment Date]) WeekNo
,Month(l.[Shipment Date]) mm
,YEAR(l.[Shipment Date]) yy
,c.[Country_Region Code]

from [ZYGO$Sales Invoice Line] l

INNER JOIN [ZYGO$Sales Invoice Header] h on l.[Document No_] = h.No_

LEFT JOIN [ZYGO$Customer] c ON l.[Sell-to Customer No_] = c.No_

where 1=1

--AND [Posting Group] = 'FG'

AND l.[Shortcut Dimension 2 Code] in ('LASER INTERF PROD', 'OPT PROFILER PROD')

and [Item Category Code] IN

(
'VERIFIRE_339'
,'VERIFIRE_4'
,'VERIFIRE_4_CHN'
,'VERIFIRE_4_CHN_KIT'
,'VERIFIRE_6'
,'VERIFIRE_6_CHN'
,'VERIFIRE_6_CHN_KIT'
,'VERIFIRE_HD_4'
,'VERIFIRE_HD_6'
,'VERIFIRE_HDX_4'
,'VERIFIRE_HDX_6'
,'VERIFIRE_KIT_4'
,'VERIFIRE_KIT_6'
,'VERIFIRE_XL'
,'NEXVIEW'
,'NEXVIEW_2'
,'NOMAD'
,'NV_9000'
,'NV9000_TWN'
,'NV9000_TWN_KIT'
,'DYNAFIZ_4'
,'DYNAFIZ_6'
,'COMPASS'
,'COMPASS_RT'


)

AND l.[Shipment Date] &gt;='2022-01-01'

AND Quantity &gt; 0

UNION ALL

select

l.No_
,l.Description
,l.Quantity
,l.[Sell-to Customer No_]
,DATEPART(ww,l.[Shipment Date]) WeekNo
,Month(l.[Shipment Date])
,YEAR(l.[Shipment Date])
,c.[Country_Region Code]

from [ZYGO$Sales Invoice Line] l

LEFT JOIN [ZYGO$Customer] c ON l.[Sell-to Customer No_] = c.No_


WHERE l.No_ = 'SER'

AND [Shipment Date] &gt;= '2022-01-01'

AND Quantity &gt; 0

AND [Shortcut Dimension 2 Code] IN

(
	'LASER INTERF PROD','OPT PROFILER PROD'
)
)

SELECT

[Name]
,WeekNo
,SUM(Quantity)


FROM s1

LEFT JOIN [ZYGO$Country_Region] c ON s1.[Country_Region Code] = c.Code

GROUP BY [Name], WeekNo

ORDER BY [Name], WeekNo</CommandText>
        <rd:UseGenericDesigner>true</rd:UseGenericDesigner>
      </Query>
      <Fields>
        <Field Name="Name">
          <DataField>Name</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="WeekNo">
          <DataField>WeekNo</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
        <Field Name="ID">
          <DataField />
          <rd:TypeName>System.Decimal</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
  </DataSets>
