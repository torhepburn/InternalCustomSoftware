<?xml version="1.0" encoding="utf-8"?>
<Report xmlns="http://schemas.microsoft.com/sqlserver/reporting/2016/01/reportdefinition" xmlns:rd="http://schemas.microsoft.com/SQLServer/reporting/reportdesigner" xmlns:df="http://schemas.microsoft.com/sqlserver/reporting/2016/01/reportdefinition/defaultfontfamily" MustUnderstand="df">
  <df:DefaultFontFamily>Segoe UI</df:DefaultFontFamily>
  <AutoRefresh>0</AutoRefresh>
  <DataSources>
    <DataSource Name="NAV">
      <DataSourceReference>NAV</DataSourceReference>
      <rd:SecurityType>None</rd:SecurityType>
      <rd:DataSourceID>499a7a6f-a76b-42fa-a323-e49efea0bb96</rd:DataSourceID>
    </DataSource>
  </DataSources>
  <DataSets>
    <DataSet Name="DataSet1">
      <Query>
        <DataSourceName>NAV</DataSourceName>
        <CommandText>select

COALESCE(dreg.[Dimension Value Code],'') REGION
,SUM(Amount) Amount
,COALESCE(h.[Shortcut Dimension 2 Code],'') [Business Segment]
--,h.[External Document No_] [CUST PO]
--,h.[Sell-to Customer Name] [Customer]
--,h.[End User Customer Name] [End Customer]
,COUNT([Document No_]) ORDERS
--,[SO Line No_] POS
--,l.[Job No_] [PROJ #]
--,l.No_ AS [ITEM NO]
--,l.Description [ITEM DESCRIPTION]
,h.[Assigned User ID]
,YEAR(h.[Order Date]) [Year]

,MONTH(h.[Order Date]) [Month]--,[Bin Code] WHS
--,COALESCE(dind.[Dimension Value Code],'') LOB
--,CASE 
--	WHEN CAST(FORMAT(h.[Order Date], 'MM/dd/yy') as varchar(8)) = '01/01/53' THEN ''
--	ELSE CAST(FORMAT(h.[Order Date], 'MM/dd/yy') as varchar(8)) 
--END [ORD DATE]
--,CASE 
--	WHEN CAST(FORMAT(l.[Requested Delivery Date], 'MM/dd/yy') as varchar(8)) = '01/01/53' THEN ''
--	ELSE CAST(FORMAT(l.[Requested Delivery Date], 'MM/dd/yy') as varchar(8)) 
--END [REQ DATE]
--,CASE 
--	WHEN CAST(FORMAT(l.[Promised Delivery Date], 'MM/dd/yy') as varchar(8)) = '01/01/53' THEN ''
--	ELSE CAST(FORMAT(l.[Promised Delivery Date], 'MM/dd/yy') as varchar(8)) 
--END [DEL DATE]
--,CAST(Quantity AS int) [QTY ORD]
--,CAST([Quantity Shipped] AS int) [QTY DLV]
--,CAST([Outstanding Quantity] AS int) [QTY TO DLV]
--,l.[Unit Price] [Line PRICE]
--,[Line Discount _] [Line DISC]
--,[Outstanding Quantity] * l.[Unit Price] [SHIP BL]
--, CASE
--	WHEN l.[Unit Price] &gt; 0 THEN CAST(CAST(ROUND((COALESCE(p.[Unit Price]/l.[Unit Price],0)*100),0) as int) AS Varchar(2)) + ' %'
--	ELSE '0 %'
--END [ZCV Price/Line Price]
----,COALESCE(p.[Unit Price],0) [ZCV Price]
--,CASE
--	WHEN l.[Unit Price] &gt; 0 THEN CAST(CAST(ROUND((COALESCE(i.[Standard Cost]/l.[Unit Price],0)*100),0) AS int) AS varchar(2)) + ' %'
--	ELSE '0 %'
--END [Std Cost/Line Price]
--,COALESCE(i.[Standard Cost],0) [Std Cost]
--,CASE
--	WHEN l.[Unit Price] &gt; 0 THEN CAST(CAST(ROUND((COALESCE((l.[Unit Price] - i.[Standard Cost])/l.[Unit Price],0)*100),0) AS int) AS varchar(2)) + ' %'
--	ELSE '0 %'
--END [(Line Price - Std Cost)/Line Price]
--,CASE
--	WHEN l.[Unit Price] &gt; 0 THEN (COALESCE((l.[Unit Price] - i.[Standard Cost])/l.[Unit Price],0))
--	ELSE 0
--END [(Line Price - Std Cost)/Line Price]
--,[Outstanding Quantity] * COALESCE(p.[Unit Price],0) [BL ZCV]
--,[Outstanding Quantity] * i.[Standard Cost] [BL std cost]

from [ZYGO$Sales Header] h

INNER JOIN [ZYGO$Sales Line] l ON h.No_ = l.[Document No_] and h.[Document Type] = l.[Document Type]

left join	[ZYGO$Dimension Set Entry] dreg on l.[Dimension Set ID] = dreg.[Dimension Set ID] and dreg.[Dimension Code] = 'REGION'

--LEFT JOIN s1 p ON l.No_ = p.[Item No_]

LEFT JOIN ZYGO$Item i ON l.No_ = i.No_

WHERE YEAR([Order Date]) &gt;= '2021'

GROUP BY YEAR(h.[Order Date]),MONTH(h.[Order Date]) ,[Assigned User ID], COALESCE(dreg.[Dimension Value Code],''), h.[Shortcut Dimension 2 Code]  


ORDER BY 

[Assigned User ID], REGION, h.[Shortcut Dimension 2 Code], Year, Month</CommandText>
        <rd:UseGenericDesigner>true</rd:UseGenericDesigner>
      </Query>
      <Fields>
        <Field Name="REGION">
          <DataField>REGION</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Amount">
          <DataField>Amount</DataField>
          <rd:TypeName>System.Decimal</rd:TypeName>
        </Field>
        <Field Name="Business_Segment">
          <DataField>Business Segment</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="ORDERS">
          <DataField>ORDERS</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
        <Field Name="Assigned_User_ID">
          <DataField>Assigned User ID</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Year">
          <DataField>Year</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
        <Field Name="Month">
          <DataField>Month</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
  </DataSets>
