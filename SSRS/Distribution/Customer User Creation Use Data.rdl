<?xml version="1.0" encoding="utf-8"?>
<Report MustUnderstand="df" xmlns="http://schemas.microsoft.com/sqlserver/reporting/2016/01/reportdefinition" xmlns:rd="http://schemas.microsoft.com/SQLServer/reporting/reportdesigner" xmlns:df="http://schemas.microsoft.com/sqlserver/reporting/2016/01/reportdefinition/defaultfontfamily">
  <df:DefaultFontFamily>Segoe UI</df:DefaultFontFamily>
  <AutoRefresh>0</AutoRefresh>
  <DataSources>
    <DataSource Name="DataSource1">
      <ConnectionProperties>
        <DataProvider>SQL</DataProvider>
        <ConnectString>Data Source=pa-hor-as408;Initial Catalog=ZYGO-NAV-PROD</ConnectString>
      </ConnectionProperties>
      <rd:SecurityType>DataBase</rd:SecurityType>
      <rd:DataSourceID>e2efa9d0-456a-4d4b-b511-e4fda0f63df9</rd:DataSourceID>
    </DataSource>
  </DataSources>
  <DataSets>
    <DataSet Name="DataSet1">
      <Query>
        <DataSourceName>DataSource1</DataSourceName>
        <QueryParameters>
          <QueryParameter Name="@CustomerCreator">
            <Value>=Parameters!CustomerCreator.Value</Value>
            <rd:UserDefined>true</rd:UserDefined>
          </QueryParameter>
          <QueryParameter Name="@StartDate">
            <Value>=Parameters!StartDate.Value</Value>
            <rd:UserDefined>true</rd:UserDefined>
          </QueryParameter>
          <QueryParameter Name="@EndDate">
            <Value>=Parameters!EndDate.Value</Value>
            <rd:UserDefined>true</rd:UserDefined>
          </QueryParameter>
        </QueryParameters>
        <CommandText>WITH s1 AS
(
	SELECT

	v.No_
	,v.Name
	,case [Type of Change]
		when 0 then 'New'
		when 1 then 'Modification'
	end as [Type of Change]
	,l.[New Value]
	,l.[Date and Time]
	,l.[User ID]

	FROM [ZYGO$Change Log Entry] l

	INNER JOIN ZYGO$Customer v on l.[Primary Key Field 1 Value] = v.No_

	WHERE 

	[Table No_] = 18

	AND [Type of Change] = 0

	AND [Field No_] = 1

	AND [Date and Time] &gt;= @StartDate
	AND [Date and Time] &lt;= @EndDate
	AND [User ID] = @CustomerCreator
)
, s2 AS
(
SELECT

s1.No_ [Customer Number]
,s1.Name [Customer Name]
,REPLACE(sh.[Assigned User ID], 'AMETEK-AD\','') [Sales Order Creator]
,REPLACE(ssh.[User ID],'AMETEK-AD\','') [Sales Shipment Creator],ssh.[Order No_] [Sales Order Number]
,ssl.[SO Line No_]
,ssh.[Order Date]
,REPLACE(sih.[User ID],'AMETEK-AD\','') [Invoice Creator]
,sih.No_ [Invoice Number]
,sih.[Document Date] [Invoice Date]
,sil.Amount [Invoice Amount]
,COALESCe(sch.[User ID],'') [Creadit Memo Creator]
,COALESCE(sch.No_,'')[Credit Memo Number]
,COALESCE(scl.Amount, 0.00) [Creadit Memo Amount]

FROM s1

INNER JOIN [ZYGO$Sales Shipment Header] ssh ON s1.No_ = ssh.[Sell-to Customer No_] --AND s1.[User ID] = ssh.[User ID]

INNER JOIN [ZYGO$Sales Shipment Line] ssl ON ssh.No_ = ssl.[Document No_]

LEFT JOIN [ZYGO$Sales Header] sh ON ssh.[Order No_] = sh.No_

LEFT JOIN [ZYGO$Sales Invoice Header] sih ON ssh.[Order No_] = sih.[Order No_]

INNER JOIN [ZYGO$Sales Invoice Line] sil ON sih.No_ = sil.[Document No_] AND sil.[SO Line No_] = ssl.[SO Line No_]

LEFT JOIN [ZYGO$Sales Cr_Memo Header] sch ON sch.[Applies-to Doc_ No_] = sih.No_

LEFT JOIN [ZYGO$Sales Cr_Memo Line] scl ON sch.No_ = scl.[Document No_]




)


select

*

 from s2

ORDER BY [Sales Order Number], [SO Line No_]</CommandText>
        <rd:UseGenericDesigner>true</rd:UseGenericDesigner>
      </Query>
      <Fields>
        <Field Name="Customer_Number">
          <DataField>Customer Number</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Customer_Name">
          <DataField>Customer Name</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Sales_Order_Creator">
          <DataField>Sales Order Creator</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Sales_Shipment_Creator">
          <DataField>Sales Shipment Creator</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Sales_Order_Number">
          <DataField>Sales Order Number</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="SO_Line_No_">
          <DataField>SO Line No_</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
        <Field Name="Order_Date">
          <DataField>Order Date</DataField>
          <rd:TypeName>System.DateTime</rd:TypeName>
        </Field>
        <Field Name="Invoice_Creator">
          <DataField>Invoice Creator</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Invoice_Number">
          <DataField>Invoice Number</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Invoice_Date">
          <DataField>Invoice Date</DataField>
          <rd:TypeName>System.DateTime</rd:TypeName>
        </Field>
        <Field Name="Invoice_Amount">
          <DataField>Invoice Amount</DataField>
          <rd:TypeName>System.Decimal</rd:TypeName>
        </Field>
        <Field Name="Creadit_Memo_Creator">
          <DataField>Creadit Memo Creator</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Credit_Memo_Number">
          <DataField>Credit Memo Number</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Creadit_Memo_Amount">
          <DataField>Creadit Memo Amount</DataField>
          <rd:TypeName>System.Decimal</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
    <DataSet Name="DataSet2">
      <Query>
        <DataSourceName>DataSource1</DataSourceName>
        <CommandText>SELECT DISTINCT [Created By User] FROM [ZYGO$Customer]
</CommandText>
      </Query>
      <Fields>
        <Field Name="Created_By_User">
          <DataField>Created By User</DataField>
          <rd:TypeName>System.String</rd:TypeName>
