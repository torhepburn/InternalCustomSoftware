<?xml version="1.0" encoding="utf-8"?>
<Report MustUnderstand="df" xmlns="http://schemas.microsoft.com/sqlserver/reporting/2016/01/reportdefinition" xmlns:rd="http://schemas.microsoft.com/SQLServer/reporting/reportdesigner" xmlns:df="http://schemas.microsoft.com/sqlserver/reporting/2016/01/reportdefinition/defaultfontfamily">
  <df:DefaultFontFamily>Segoe UI</df:DefaultFontFamily>
  <AutoRefresh>0</AutoRefresh>
  <DataSources>
    <DataSource Name="DataSource1">
      <ConnectionProperties>
        <DataProvider>SQL</DataProvider>
        <ConnectString>Data Source=CT-MID-SQL01;Initial Catalog=PM_2015_A</ConnectString>
      </ConnectionProperties>
      <rd:SecurityType>DataBase</rd:SecurityType>
      <rd:DataSourceID>8e206acb-4e2a-483c-8646-2deb42764bcd</rd:DataSourceID>
    </DataSource>
  </DataSources>
  <DataSets>
    <DataSet Name="DataSet1">
      <Query>
        <DataSourceName>DataSource1</DataSourceName>
        <CommandText>--DECLARE @start date
--DECLARE @end date

--SET @start = '2020-02-01'
--SET @end = '2020-02-29'

WITH s1 AS
(
	SELECT 
	ID
	,task_id
	FROM Repair_History
	WHERE Task_ID IN
	(SELECT t.ID 

	FROM TASKS t

	INNER JOIN Equipment e on t.EquipmentUID = e.ID

	INNER JOIN Locations l on e.LocationID = l.ID

	WHERE NEXTPM &gt;= GETDATE() AND NEXTPM &lt;= GETDATE() + 30

	AND e.STATUS = 'Active'

	AND repairDate is null

	AND SiteID = 11)
)


SELECT

t.EquipmentID
, COALESCE(e.DESCRIPTION,'') Description
,ITEM
,TASK
,COALESCE(CONVERT(varchar(10),LASTPM),'') LASTPM
,COALESCE(CONVERT(varchar(10),NEXTPM),'') NEXTPM
,Frequency
,COALESCE(Material,'') Material
,CASE OpenWorkRequest
	WHEN 1 THEN 'Yes'
	WHEN 0 THEN 'No'
END [Open Work Request]
,COALESCE(CAST(s1.ID as varchar(6)),'')  [Work Request Number]

FROM TASKS t

INNER JOIN Equipment e on t.EquipmentUID = e.ID

INNER JOIN Locations l on e.LocationID = l.ID

LEFT JOIN s1 on t.ID = s1.task_id

WHERE NEXTPM &gt;= GETDATE() AND NEXTPM &lt;= GETDATE() + 30

AND e.STATUS = 'Active'

AND SiteID = 11

ORDER BY NEXTPM</CommandText>
        <rd:UseGenericDesigner>true</rd:UseGenericDesigner>
      </Query>
