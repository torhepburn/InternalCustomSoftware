  <DataSets>
    <DataSet Name="DataSet1">
      <Query>
        <DataSourceName>NAV</DataSourceName>
        <CommandText>--use calibration

select 


--',[' + 
--'" ,' +
/*
CASE
	WHEN DATA_TYPE = 'INT' THEN 'to_char('
	WHEN DATA_TYPE = 'float' THEN 'to_char('
	ELSE ''
END
*/
 --+ 
-- ''
--column_name  + ']  '-- + ' 
 
 --' = @t' + column_name + ' " &amp; ' 
 /*
 CASE
	WHEN DATA_TYPE = 'INT' THEN ') as ' + COLUMN_NAME
	WHEN DATA_TYPE = 'float' THEN ') as ' + COLUMN_NAME
	ELSE ''
END
*/
ROW_NUMBER() OVER
(ORDER BY COLUMN_NAME)
,TABLE_NAME
,COLUMN_NAME
--,*
--, DATA_TYPE



from INFORMATION_SCHEMA.COLUMNS  


where 1=1

--DATA_TYPE = 'nchar'

--table_name = 'local_dash_view_tracking' --and DATA_TYPE = 'int'

--AND TABLE_NAME like 'ZYGO$Purch%'

--AND TABLE_NAME = 'ZYGO$Sales Line'

--AND COLUMN_NAME Like '%Date%'

AND TABLE_NAME = 'ZYGO$Item'

--AND TABLE_NAME = 'ZYGO$Sales Line'

--AND TABLE_NAME like  'ZYGO$%'

--AND TABLE_NAME like  'ZYGO$BOM%'

--and  COLUMN_NAME like '%Mach%'

--AND TABLE_NAME Like 'ZYGO$%'

order by 

TABLE_NAME

--COLUMN_NAME
--ORDINAL_POSITION

/*

Second colukn for comparison

*/
/*
select 


--',' + 
--'" ,' +
/*
CASE
	WHEN DATA_TYPE = 'INT' THEN 'to_char('
	WHEN DATA_TYPE = 'float' THEN 'to_char('
	ELSE ''
END
*/
 --+ 
 
 column_name -- + ' " + ' 
 
 --' = @t' + column_name + ' " &amp; ' 
 /*
 CASE
	WHEN DATA_TYPE = 'INT' THEN ') as ' + COLUMN_NAME
	WHEN DATA_TYPE = 'float' THEN ') as ' + COLUMN_NAME
	ELSE ''
END
*/
--, TABLE_NAME
--, DATA_TYPE
from INFORMATION_SCHEMA.COLUMNS  


where 

--DATA_TYPE = 'nchar'

--table_name = 'local_dash_view_tracking' --and DATA_TYPE = 'int'

--TABLE_NAME = 'ZYGO_UAT3$Purchase Line'

TABLE_NAME = 'ZYGO_TEST$Warehouse Entry'

--TABLE_NAME = 'ZYGO$Purchase Line'

--TABLE_NAME like  'ZYGO_UAT3$%'

--and COLUMN_NAME like '%ef%'

order by 

TABLE_NAME

--COLUMN_NAME

*/</CommandText>
        <rd:UseGenericDesigner>true</rd:UseGenericDesigner>
      </Query>
