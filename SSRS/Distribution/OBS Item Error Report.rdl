<?xml version="1.0" encoding="utf-8"?>
<Report MustUnderstand="df" xmlns="http://schemas.microsoft.com/sqlserver/reporting/2016/01/reportdefinition" xmlns:rd="http://schemas.microsoft.com/SQLServer/reporting/reportdesigner" xmlns:df="http://schemas.microsoft.com/sqlserver/reporting/2016/01/reportdefinition/defaultfontfamily">
  <df:DefaultFontFamily>Segoe UI</df:DefaultFontFamily>
  <AutoRefresh>0</AutoRefresh>
  <DataSources>
    <DataSource Name="NAV">
      <DataSourceReference>NAV</DataSourceReference>
      <rd:SecurityType>None</rd:SecurityType>
      <rd:DataSourceID>a0522cbc-446c-42e0-9387-1c9b61518286</rd:DataSourceID>
    </DataSource>
  </DataSources>
  <DataSets>
    <DataSet Name="DataSet1">
      <Query>
        <DataSourceName>NAV</DataSourceName>
        <CommandText>WITH s2 as
(	--Stock on Purchase Order
	SELECT
	I.No_
    ,COALESCE(SUM(L.[Outstanding Quantity]), '0.00') [Qty on PO ]
	FROM [ZYGO$Purchase Line] L 
    INNER JOIN [ZYGO$Item] I ON L.No_ = I.No_
    WHERE ([Replenishment System] = 0 and [Document Type] = 1
    and [Outstanding Quantity] &gt; 0)
	GROUP BY I.No_
)
, s3 as
(	--Qty on Sales Orders -- Type 2 = Item	Type 3 = Resource
	SELECT
	No_
    ,COALESCE(SUM([Outstanding Quantity]), 0) [Qty on SO]
    FROM [ZYGO$Sales Line]
    WHERE Type = 2 AND [Completely Shipped] = 0
	GROUP BY No_
)
, s4 as
(	--Qty on Service Orders  Type 1 = Item Type 2 = Resource
	SELECT
	No_
    ,COALESCE(SUM([Quantity]), 0) [Qty on Service Order]
    FROM [ZYGO$Service Line] WHERE [Type] = 1
    GROUP BY No_
)
, s5 as
(	--Qty on Inventory Request - Jobs
	SELECT
	No_
    ,COALESCE(SUM([Quantity]), 0) [Qty on Inventory Request]
    FROM [ZYGO$Job Journal Line]
    WHERE [Journal Template Name] = 'INVREQ'
	GROUP BY No_
)
, s6 as
(	--Qty on Production Order  --Status 2 = Firm Planned Status 3 = Released
	SELECT
	[Item No_]
    ,COALESCE(SUM([Remaining Quantity]), 0) [Qty on Production Order]
    FROM [ZYGO$Prod_ Order Line]
    WHERE [Remaining Quantity] &gt; 0 and [Status] in (2,3)
	GROUP BY [Item No_]
)
,s1 AS
(
	SELECT

	No_
	,[Qty on PO] [Qty On Order]
	
	FROM s2

	UNION ALL

	SELECT

	No_
	,[Qty on SO] [Qty On Order]
	
	FROM s3

	UNION ALL

	SELECT

	No_
	,[Qty on Service Order] [Qty On Order]
	
	FROM s4

	UNION ALL

	SELECT

	No_
	,[Qty on Inventory Request] [Qty On Order]
	
	FROM s5

	UNION ALL

	SELECT

	[Item No_]
	,[Qty on Production Order] [Qty On Order]
	
	FROM s6
)
, s7 AS
(
	select

	No_
	,SUM([Qty On Order]) OpenOrd

	from s1

	GROUP BY No_
)
,s8 AS
(
	select

	[Item No_]
	,SUM([Remaining Quantity]) [Component Remaining Quantity]

	from [ZYGO$Prod_ Order Component]

	WHERE Status IN (3,4)

	GROUP BY [Item No_]
)
,s9 AS
(
	Select

	 i.No_
	 ,i.Description
	,[Signal Code]
	,CASE [Blocked]
		WHEN 1 THEN ''
		ELSE 'Not Blocked;'
	END [OBS ERR1]
	,CASE [Safety Stock Quantity]
		WHEN 0 THEN ''
		ELSE 'Safety Stock &lt;&gt; 0;'
	END [OBS ERR2]
	,CASE [Reorder Quantity]
		WHEN 0 THEN ''
		ELSE 'Reorder Qty &lt;&gt; 0;'
	END [OBS ERR3]
	,CASE [Reorder Point]
		WHEN 0 THEN ''
		ELSE 'Reorder Point &lt;&gt; 0;'
	END [OBS ERR4]
	,CASE COALESCE(OpenOrd,0)
		WHEN 0 THEN ''
		ELSE 'Open Ord Qty &lt;&gt; 0;'
	END [OBS ERR5]
	,CASE COALESCE([Component Remaining Quantity],0)
		WHEN 0 THEN ''
		ELSE 'Prod Ord Comp Qty Remaining'
	END [OBS ERR6]
	
	
	FROM ZYGO$Item i

	LEFT JOIN s7 ON i.No_ = s7.No_

	LEFT JOIN s8 ON i.No_ = s8.[Item No_]

	WHERE 

	[Signal Code] = 'OBS'
)
,s10 AS
(
SELECT

[Signal Code]
,No_
,Description
, [OBS ERR1] + [OBS ERR2] + [OBS ERR3] + [OBS ERR4] + [OBS ERR5] + [OBS ERR6] [OBS Errors]

FROM s9
)

SELECT

* 

FROM s10

WHERE LEN([OBS Errors]) &gt; 0

AND LEFT(No_,1) != 'X'</CommandText>
        <rd:UseGenericDesigner>true</rd:UseGenericDesigner>
      </Query>
      <Fields>
        <Field Name="Signal_Code">
          <DataField>Signal Code</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="No_">
          <DataField>No_</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Description">
          <DataField>Description</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="OBS_Errors">
          <DataField>OBS Errors</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
  </DataSets>
