  <DataSets>
    <DataSet Name="DataSet1">
      <Query>
        <DataSourceName>QW</DataSourceName>
        <CommandText>select Created, LastModified l, LastModifiedBy, DocNo,DocName from DocumentHeaders  

where LastModified &gt;= '2023-01-01'


order by LastModified desc</CommandText>
        <rd:UseGenericDesigner>true</rd:UseGenericDesigner>
      </Query>
