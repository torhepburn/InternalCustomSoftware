        <Field Name="LINE_AMT">
          <DataField>LINE AMT</DataField>
          <rd:TypeName>System.Decimal</rd:TypeName>
        </Field>
        <Field Name="ORD_AMT">
          <DataField>ORD AMT</DataField>
          <rd:TypeName>System.Decimal</rd:TypeName>
        </Field>
        <Field Name="SHIP">
          <DataField>SHIP</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="GVT_RATED">
          <DataField>GVT RATED</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
      </Fields>
