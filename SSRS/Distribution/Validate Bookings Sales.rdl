<?xml version="1.0" encoding="utf-8"?>
<Report MustUnderstand="df" xmlns="http://schemas.microsoft.com/sqlserver/reporting/2016/01/reportdefinition" xmlns:rd="http://schemas.microsoft.com/SQLServer/reporting/reportdesigner" xmlns:df="http://schemas.microsoft.com/sqlserver/reporting/2016/01/reportdefinition/defaultfontfamily">
  <df:DefaultFontFamily>Segoe UI</df:DefaultFontFamily>
  <AutoRefresh>0</AutoRefresh>
  <DataSources>
    <DataSource Name="NAV">
      <DataSourceReference>NAV</DataSourceReference>
      <rd:SecurityType>None</rd:SecurityType>
      <rd:DataSourceID>a8b4344e-059d-4c82-99e0-829fc3ccfce3</rd:DataSourceID>
    </DataSource>
  </DataSources>
  <DataSets>
    <DataSet Name="DataSet1">
      <Query>
        <DataSourceName>NAV</DataSourceName>
        <QueryParameters>
          <QueryParameter Name="@days">
            <Value>=Parameters!days.Value</Value>
          </QueryParameter>
        </QueryParameters>
        <CommandText>--DECLARE @days int
--SET @days = 14;

WITH s1 AS	/*	all line amount entries in time frame	*/
(
select 

DATEADD(hh, -5, [Date and Time]) TransactionDate

,[Old Value]
,[New Value]
,[Primary Key Field 2 Value] pk2
,[Primary Key Field 3 Value] pk3
,[Primary Key Field 2 Value] + [Primary Key Field 3 Value] FreightLineTest

from 

[ZYGO$Change Log Entry]

WHERE [Table No_] = 37  --Sales Line

AND CAST(DATEADD(hh, -5, [Date and Time]) AS date) = CAST((GETDATE()-@days) as date)

AND [Field No_] IN (103) --Line Amount

AND [Primary Key Field 1 Value] = 1  --Document Type Sales Order

)
,s2 AS	/*	get all lines where SO Line Number &gt;= 500 [FREIGHT entries]	*/

(	
	SELECT 

   [Primary Key Field 2 Value] + [Primary Key Field 3 Value] FreightLines
	
	from 

	[ZYGO$Change Log Entry]

	WHERE [Table No_] = 37  --Sales Line

	AND CAST(DATEADD(hh, -5, [Date and Time]) AS date) = CAST((GETDATE()-@days) as date)

	AND [Primary Key Field 2 Value] IN (Select pk2 from s1)
	
	AND [Field No_] = 50000  --SO Line Number

	AND [New Value] &gt;= 500
)
,s3 AS  /* net amount changes	*/
(
select

 COALESCE(SUM(TRY_CAST([Old Value] as decimal(10,2))),0) old
,SUM(TRY_CAST([New Value] as decimal(10,2))) new
,SUM(TRY_CAST([New Value] as decimal(10,2))) - COALESCE(SUM(TRY_CAST([Old Value] as decimal(10,2))),0) Net_Amount
,s1.pk2

FROM s1

WHERE s1.FreightLineTest NOT IN (Select FreightLines from s2)

GROUP BY s1.pk2
)
, s3A AS	/*	quantity changes	*/
(
	select 

	DATEADD(hh, -5, [Date and Time]) TransactionDate

	,[Old Value]
	,[New Value]
	,[Primary Key Field 2 Value] pk2
	,[Primary Key Field 3 Value] pk3
	
	from 

	[ZYGO$Change Log Entry]

	WHERE [Table No_] = 37  --Sales Line

	AND CAST(DATEADD(hh, -5, [Date and Time]) AS date) = CAST((GETDATE()-@days) as date)

	AND [Field No_] IN (15) --Quantity

	AND [Primary Key Field 1 Value] = 1  --Document Type Sales Order

	AND [Primary Key Field 2 Value] + [Primary Key Field 3 Value] NOT IN

	(Select FreightLines from s2)
)
, s3B AS	/*	item changes	*/
(
	select 

	DATEADD(hh, -5, [Date and Time]) TransactionDate

	,[Old Value]
	,[New Value]
	,[Primary Key Field 2 Value] pk2
	,[Primary Key Field 3 Value] pk3
	
	from 

	[ZYGO$Change Log Entry]

	WHERE [Table No_] = 37  --Sales Line

	AND CAST(DATEADD(hh, -5, [Date and Time]) AS date) = CAST((GETDATE()-@days) as date)

	AND [Field No_] IN (6) --Number

	AND [Primary Key Field 1 Value] = 1  --Document Type Sales Order

	AND [Primary Key Field 2 Value] + [Primary Key Field 3 Value] NOT IN

	(Select FreightLines from s2)
)
,s4 AS  /*  part descriptions with line numbers and dates to be able to figure last change on line when item number changes  */
(	
	SELECT

	 [New Value] + ' - ' + COALESCE(i.Description,'') Item
	,[Primary Key Field 2 Value] pk2
	,[Primary Key Field 3 Value] pk3
	,[Date and Time]

	FROM [ZYGO$Change Log Entry] cle

	/*Need to get the description from the sales Line due to SERs.  */

	INNER JOIN s3 ON s3.pk2 = cle.[Primary Key Field 2 Value]

	INNER JOIN [ZYGO$Sales Line] i on s3.pk2 = i.[Document No_] and cle.[Primary Key Field 3 Value] = i.[Line No_]

	WHERE 

	[Table No_] = 37	--sales line

	AND [Primary Key Field 1 Value] = 1  --Document Type Sales Order

	AND [Field No_] = 6	--No_

	AND LEFT([New Value],5)&lt;&gt; '50160'  /*	filtering out freight account numbers	*/
	
	AND CAST([Date and Time] as date) = CAST((GETDATE()- @days) as date)
	
	AND (COALESCE([Primary Key Field 2 Value],'') + COALESCE([Primary Key Field 3 Value],''))

	NOT IN (Select FreightLines from s2)
)
,s41 AS	/*	find the line with the latest date to be able to link back to get the item number when there has been an item change  */
(
	select

	pk2
	,pk3
	,MAX([Date and Time]) slink

	from s4

	group by pk2, pk3

)
,s42 AS	/*	get the latest data from the change log	per line */
(
	SELECT s4.*

	FROM s4 INNER JOIN s41 ON s4.[Date and Time] = s41.slink
)
,s5 AS	/*  finding the first item line as it will be the most significant for Linda Z	*/
(
	SELECT
	
	 pk2
	,MIN(pk3) linkLine

	FROM s42

	GROUP BY pk2
)
, s6 AS
(
	SELECT

	s42.pk2
	,Item

	FROM s42 INNER JOIN s5 ON s5.pk2 = s42.pk2 and s5.linkLine = s42.pk3
)


SELECT 

--CAST((GETDATE() - @days) as date) TransactionDate
--,
CAST(FORMAT(CAST((GETDATE() - @days) as date), 'dd-MMM-yy') as varchar(9)) Transaction_Date
,s3.pk2 Order_No
--,Net_Amount
,h.[Sell-to Customer Name] Customer
,h.[Sell-to County] [Sell-to_State]
,h.[Sell-to Country_Region Code] [Sell-to Country_Region Code] 
,c.[Customer Group Code]
,h.[Ship-to County] [Ship-to_State]
,h.[Ship-to Country_Region Code] [Ship-to Country_Region Code]
,h.[External Document No_] [Customer PO]
,Net_Amount
,vreg.Name'Region'
,dreg.[Dimension Value Code] 'Region_Code'
,COALESCE(h.[Salesperson Code],'') Sales_Agent
,vind.Name 'Industry'
,dind.[Dimension Value Code]'Industry_Code'
,COALESCE(Item,'') Item
,dseg.[Dimension Value Code]'Segment'


FROM s3

INNER JOIN [ZYGO$Sales Header] h ON s3.pk2 = h.[No_]

left join	[ZYGO$Dimension Set Entry] dseg on h.[Dimension Set ID] = dseg.[Dimension Set ID] and dseg.[Dimension Code] = 'SEGMENT'
left join	[ZYGO$Dimension Set Entry] dind on h.[Dimension Set ID] = dind.[Dimension Set ID] and dind.[Dimension Code] = 'INDUSTRY'
left join	[ZYGO$Dimension Set Entry] dreg on h.[Dimension Set ID] = dreg.[Dimension Set ID] and dreg.[Dimension Code] = 'REGION'

left join [ZYGO$Dimension Value] vreg ON dreg.[Dimension Value ID] = vreg.[Dimension Value ID] and dreg.[Dimension Code] = 'REGION'
left join [ZYGO$Dimension Value] vind on dind.[Dimension Value ID] = vind.[Dimension Value ID] and dind.[Dimension Code] = 'INDUSTRY'

lEFT JOIN ZYGO$Customer c ON h.[Sell-to Customer No_] = c.No_

LEFT JOIN s6 ON s3.pk2 = s6.pk2

WHERE h.[Document Type] = 1

ORDER BY s3.pk2


/*

select

MIN(pk3) pk3
,s3A.pk2

from s3

INNER JOIN s3A ON s3.pk2 = s3A.pk2

WHERE s3.pk2 NOT IN (SELECT pk2 from s4)

GROUP BY s3A.pk2

--order by pk2, pk3

--group by pk2, pk3



--WHERE pk2 = 'Z3867'
*/

--select * from s3B</CommandText>
        <rd:UseGenericDesigner>true</rd:UseGenericDesigner>
      </Query>
