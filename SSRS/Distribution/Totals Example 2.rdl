<?xml version="1.0" encoding="utf-8"?>
<Report MustUnderstand="df" xmlns="http://schemas.microsoft.com/sqlserver/reporting/2016/01/reportdefinition" xmlns:rd="http://schemas.microsoft.com/SQLServer/reporting/reportdesigner" xmlns:df="http://schemas.microsoft.com/sqlserver/reporting/2016/01/reportdefinition/defaultfontfamily">
  <df:DefaultFontFamily>Segoe UI</df:DefaultFontFamily>
  <AutoRefresh>0</AutoRefresh>
  <DataSources>
    <DataSource Name="NAV">
      <DataSourceReference>NAV</DataSourceReference>
      <rd:SecurityType>None</rd:SecurityType>
      <rd:DataSourceID>2a7415fa-9b0f-44b3-9076-7917fabbccb0</rd:DataSourceID>
    </DataSource>
  </DataSources>
  <DataSets>
    <DataSet Name="DataSet1">
      <Query>
        <DataSourceName>NAV</DataSourceName>
        <CommandText>WITH s1 AS
(
select

CASE
	WHEN l.No_ LIKE 'FREIGHT%' THEN 'FREIGHT'
	WHEN l.No_ LIKE 'SVC CNTRCT YR%' THEN 'PRIORITY SUPPORT'
	WHEN l.No_ LIKE 'ADVANCE DEPOSIT%' THEN 'ADVANCE DEPOSIT'
	ELSE 'FIN GOODS'
END Order_Line_Group
,COALESCE(dreg.[Dimension Value Code],'') REGION
,'Sales Order' Order_Source

,[Document No_] Order_No
,[SO Line No_]
,h.[Sell-to Customer Name]
,h.[End User Customer Name]
,h.[External Document No_]
,COALESCE(dseg.[Dimension Value Code],'') SEGMENT
,COALESCE(dind.[Dimension Value Code],'') INDUSTRY
,l.No_ AS Item_No
,l.[Job No_]
,l.Description
,CASE 
	WHEN CAST(FORMAT(l.[Planned Delivery Date], 'MM/dd/yy') as varchar(8)) = '01/01/53' THEN ''
	ELSE CAST(FORMAT(l.[Planned Delivery Date], 'MM/dd/yy') as varchar(8))
END [Planned Delivery Date]

,CASE 
	WHEN CAST(FORMAT(l.[Promised Delivery Date], 'MM/dd/yy') as varchar(8)) = '01/01/53' THEN ''
	ELSE CAST(FORMAT(l.[Promised Delivery Date], 'MM/dd/yy') as varchar(8))
END [Promised Delivery Date]
,[Outstanding Quantity]
,CASE
	WHEN Quantity = 0 THEN 0
	WHEN Quantity &lt;&gt; 0 THEN 
		CASE
			WHEN Quantity = [Outstanding Quantity] THEN l.Amount
			ELSE [Outstanding Quantity] * ([Unit Price] - [Line Discount Amount])/Quantity
		END
END [Backlog Amount]

,GETDATE() Backlog_Date


from [ZYGO$Sales Header] h

INNER JOIN [ZYGO$Sales Line] l ON h.No_ = l.[Document No_] and h.[Document Type] = l.[Document Type]

left join	[ZYGO$Dimension Set Entry] dseg on l.[Dimension Set ID] = dseg.[Dimension Set ID] and dseg.[Dimension Code] = 'SEGMENT'
left join	[ZYGO$Dimension Set Entry] dind on l.[Dimension Set ID] = dind.[Dimension Set ID] and dind.[Dimension Code] = 'INDUSTRY'
left join	[ZYGO$Dimension Set Entry] dreg on l.[Dimension Set ID] = dreg.[Dimension Set ID] and dreg.[Dimension Code] = 'REGION'
left join [ZYGO$Shipment Method] sm ON sm.Code = h.[Shipment Method Code]

LEFT JOIN ZYGO$Customer c ON h.[Sell-to Customer No_] = c.No_

WHERE [Outstanding Quantity] &lt;&gt; 0

AND h.[Document Type] = 1

UNION ALL

select

CASE
	WHEN l.No_ LIKE 'FREIGHT%' THEN 'FREIGHT'
	WHEN l.No_ LIKE 'SVC CNTRCT YR%' THEN 'PRIORITY SUPPORT'
	WHEN l.No_ LIKE 'ADVANCE DEPOSIT%' THEN 'ADVANCE DEPOSIT'
	ELSE 'FIN GOODS'
END line_group
,COALESCE(dreg.[Dimension Value Code],'') REGION
,'Sevice Order' Order_Source
,h.No_ Order_No
,[Srv Line No_]
,h.Name [Sell-to Customer Name]
,h.[End User Customer Name]
,h.[Your Reference] [External Document No_]
,COALESCE(dseg.[Dimension Value Code],'') SEGMENT
,COALESCE(dind.[Dimension Value Code],'') INDUSTRY
,l.No_ AS Item_No
,l.[Job No_]
,l.Description
,CASE 
	WHEN CAST(FORMAT(l.[Planned Delivery Date], 'MM/dd/yy') as varchar(8)) = '01/01/53' THEN ''
	ELSE CAST(FORMAT(l.[Planned Delivery Date], 'MM/dd/yy') as varchar(8))
END [Planned Delivery Date]
,CASE 
	WHEN CAST(FORMAT(l.[Promised Delivery Date], 'MM/dd/yy') as varchar(8)) = '01/01/53' THEN ''
	ELSE CAST(FORMAT(l.[Promised Delivery Date], 'MM/dd/yy') as varchar(8))
END [Promised Delivery Date]
,[Outstanding Quantity]
,CASE
	WHEN Quantity = 0 THEN 0
	WHEN Quantity &lt;&gt; 0 THEN 
		CASE
			WHEN Quantity = [Outstanding Quantity] THEN l.Amount
			ELSE [Outstanding Quantity] * ([Unit Price] - [Line Discount Amount])/Quantity
		END
END [Backlog Amount]

,GETDATE() Backlog_Date

from [ZYGO$Service Header] h

INNER JOIN [ZYGO$Service Line] l ON h.No_ = l.[Document No_] and h.[Document Type] = l.[Document Type]

left join	[ZYGO$Dimension Set Entry] dseg on l.[Dimension Set ID] = dseg.[Dimension Set ID] and dseg.[Dimension Code] = 'SEGMENT'
left join	[ZYGO$Dimension Set Entry] dind on l.[Dimension Set ID] = dind.[Dimension Set ID] and dind.[Dimension Code] = 'INDUSTRY'
left join	[ZYGO$Dimension Set Entry] dreg on l.[Dimension Set ID] = dreg.[Dimension Set ID] and dreg.[Dimension Code] = 'REGION'
left join [ZYGO$Shipment Method] sm ON sm.Code = h.[Shipment Method Code]

LEFT JOIN ZYGO$Customer c ON h.[Customer No_] = c.No_

WHERE [Outstanding Quantity] &lt;&gt; 0

AND h.[Document Type] = 1
)

select * from s1 where REGION = 'USW'



ORDER BY 

Order_Line_Group
,Order_Source
,[Order_No]
,[SO Line No_]</CommandText>
        <rd:UseGenericDesigner>true</rd:UseGenericDesigner>
      </Query>
