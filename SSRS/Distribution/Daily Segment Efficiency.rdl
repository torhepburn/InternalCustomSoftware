<?xml version="1.0" encoding="utf-8"?>
<Report MustUnderstand="df" xmlns="http://schemas.microsoft.com/sqlserver/reporting/2016/01/reportdefinition" xmlns:rd="http://schemas.microsoft.com/SQLServer/reporting/reportdesigner" xmlns:df="http://schemas.microsoft.com/sqlserver/reporting/2016/01/reportdefinition/defaultfontfamily">
  <df:DefaultFontFamily>Segoe UI</df:DefaultFontFamily>
  <AutoRefresh>0</AutoRefresh>
  <DataSources>
    <DataSource Name="AFE">
      <DataSourceReference>AFE</DataSourceReference>
      <rd:SecurityType>None</rd:SecurityType>
      <rd:DataSourceID>4aa16690-0e70-4095-b235-737685263332</rd:DataSourceID>
    </DataSource>
  </DataSources>
  <DataSets>
    <DataSet Name="DataSet1">
      <Query>
        <DataSourceName>AFE</DataSourceName>
        <CommandText>/*	start with released and completed work orders started two years ago	*/

with s1 AS /*	released production from NAV	*/
(
	SELECT
	
	[Prod_ Order No_] OrderNo
	,[Operation No_] Operation
	,l.Description
	,[Prod_ Order No_] + [Operation No_] oLink
	,l.[Work Center No_]
	,m.CostCenter
	,[Run Time]
	,[Ending Date-Time] NAVplannedEndDate
	,CASE Status
		WHEN 3 THEN 'Released'
		WHEN 4 THEN 'Completed'
		ELSE ''
	END NAVstatus

	FROM NAVprodOrdRoutingLine l LEFT JOIN

	NAV_WorkCenterCostCenterMapping m ON l.[Work Center No_] = m.WorkCenter

	WHERE 1=1  --LEFT(Description, 4) = '5074'

	AND (Status = 4 AND [Starting Date-Time] &gt; DATEADD(yy, -2,GETDATE())

	OR (Status = 3 and 
	
	([Starting Date-Time] &lt; DATEADD(mm,2,GETDATE())
	
	AND [Starting Date-Time] &gt; DATEADD(yy, -2,GETDATE()))
	
	)
))	

, s2A AS  /*	Dashboard start scans of released production operations	*/
(
	SELECT
	
	   Item
	  ,[OrderNo]
      ,[Operation]
      ,COALESCE(MIN([StartTime]) ,'') DashboardStartDate
	  ,[OrderNo] + [Operation] oLink
	  
  FROM [MIDDB01.zygo.com].Dashboard.[dbo].[TimecardNAVProdHours]

  where EndTime &gt; DATEADD(mm, -12,GETDATE())

  GROUP BY 

       [OrderNo]
      ,[Operation]
      ,[Item]
)
, s2complete AS  /*	Dashboard start and end scans of released production operation complete	*/
(
	SELECT 
	   Item
	  ,[OrderNo]
      ,[Operation]
      ,COALESCE(MAX([EndTime]) ,'') DashboardCompletionDate
	  ,[OrderNo] + [Operation] oLink
	  ,MAX(Complete) DashboardStatus
	  
  FROM [MIDDB01.zygo.com].Dashboard.[dbo].[TimecardNAVProdHours]

  where EndTime &gt; DATEADD(mm, -12,GETDATE())

  AND Complete = 1

  GROUP BY 

       [OrderNo]
      ,[Operation]
      ,[Item]
)
,s2D AS
(
	SELECT 
	   Item
	  ,[OrderNo]
      ,[Operation]
      ,SUM(ApportionTime) DashboardTime
	  ,[OrderNo] + [Operation] oLink
	  
  FROM [MIDDB01.zygo.com].Dashboard.[dbo].[TimecardNAVProdHours]

  where EndTime &gt; DATEADD(mm, -12,GETDATE())

  GROUP BY 

       [OrderNo]
      ,[Operation]
      ,[Item]
)
,s2 AS
(
	select
	
	c.Item
	,c.OrderNo
	,c.Operation
	,s2D.DashboardTime
	,c.DashboardCompletionDate
	,c.oLink
	
	from s2D

	INNER JOIN s2complete c ON s2D.oLink = c.oLink

)

,s3 AS	/*	efficiency base	  */
(
	select

	 s1.OrderNo
	,s1.Operation
	,s1.[Work Center No_]
	,s1.CostCenter
	,CASE
		WHEN s2.[DashboardTime] &gt; 0 THEN (s1.[Run Time]/s2.DashboardTime) 
	ELSE 0
	END Efficiency
	,CAST(s2.DashboardCompletionDate as date) [Date]
	
	from s2

	INNER JOIN s1 ON s2.oLink = s1.oLink


)
,s3details AS
(
	select

	s1.OrderNo
	,s1.Operation
	,s1.[Work Center No_]
	,CASE
		WHEN s2.[DashboardTime] &gt; 0 THEN (s1.[Run Time]/s2.DashboardTime)
	ELSE 0
	END Efficiency
	,s1.[Run Time]
	,s2.DashboardTime
	,CAST(s2.DashboardCompletionDate as date) [Date]
	
	from s2

	INNER JOIN s1 ON s2.oLink = s1.oLink
)


	/*	routing by Segment completed yesterday	*/

	SELECT 

	[Business Segment]
	,AVg(Efficiency) Efficiency
	,[Date]

	FROM s3

	LEFT JOIN NAV_mapWoBusinessSegment m ON s3.OrderNo = m.No_

	WHERE [Date] = CAST(DATEADD(dd, -1,GETDATE()) as Date)

	GROUP BY

	[Business Segment]
	,[Date]</CommandText>
        <rd:UseGenericDesigner>true</rd:UseGenericDesigner>
      </Query>
      <Fields>
        <Field Name="Business_Segment">
          <DataField>Business Segment</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Efficiency">
          <DataField>Efficiency</DataField>
          <rd:TypeName>System.Double</rd:TypeName>
        </Field>
        <Field Name="Date">
          <DataField>Date</DataField>
          <rd:TypeName>System.DateTime</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
  </DataSets>
