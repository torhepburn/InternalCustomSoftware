<?xml version="1.0" encoding="utf-8"?>
<Report xmlns="http://schemas.microsoft.com/sqlserver/reporting/2016/01/reportdefinition" xmlns:rd="http://schemas.microsoft.com/SQLServer/reporting/reportdesigner" xmlns:df="http://schemas.microsoft.com/sqlserver/reporting/2016/01/reportdefinition/defaultfontfamily" MustUnderstand="df">
  <df:DefaultFontFamily>Segoe UI</df:DefaultFontFamily>
  <AutoRefresh>0</AutoRefresh>
  <DataSources>
    <DataSource Name="AFE">
      <DataSourceReference>AFE</DataSourceReference>
      <rd:SecurityType>None</rd:SecurityType>
      <rd:DataSourceID>e373a1b8-d30d-4efd-962f-e37a5e4849e0</rd:DataSourceID>
    </DataSource>
  </DataSources>
  <DataSets>
    <DataSet Name="DataSet1">
      <Query>
        <DataSourceName>AFE</DataSourceName>
        <CommandText>select

	r.[Document No_]
	,r.[SO Line No_]
	,c.Bucket
	,c.[Reason Code]
	,c.Description
	,c.NewDescription
	,o.[Business Segment]
	,o.Amount Amount
	,o.[Orig_ Promised Delivery Date]
	,o.OTstatus
	,o.DayCount
	,o.SortDate SortDate
	
	from PBI_SO_CDSR_s1 r

	LEFT JOIN PBI_OTD_s1 o ON o.[Document No_] = r.[Document No_] and o.[SO Line No_] = r.[SO Line No_]

	LEFT JOIN ReasonCodes c ON r.[Change Date Reason Code] = c.[Reason Code]

	WHERE r.[SO Line No_] &lt; 500

	and [Business Segment] is not null

	AND o.OTstatus &lt;&gt; 'On Time'

	AND SortDate = 202503</CommandText>
        <rd:UseGenericDesigner>true</rd:UseGenericDesigner>
      </Query>
      <Fields>
        <Field Name="Document_No_">
          <DataField>Document No_</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="SO_Line_No_">
          <DataField>SO Line No_</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
        <Field Name="Bucket">
          <DataField>Bucket</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Reason_Code">
          <DataField>Reason Code</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Description">
          <DataField>Description</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="NewDescription">
          <DataField>NewDescription</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Business_Segment">
          <DataField>Business Segment</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Amount">
          <DataField>Amount</DataField>
          <rd:TypeName>System.Decimal</rd:TypeName>
        </Field>
        <Field Name="Orig__Promised_Delivery_Date">
          <DataField>Orig_ Promised Delivery Date</DataField>
          <rd:TypeName>System.DateTime</rd:TypeName>
        </Field>
        <Field Name="OTstatus">
          <DataField>OTstatus</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="DayCount">
          <DataField>DayCount</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
        <Field Name="SortDate">
          <DataField>SortDate</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
  </DataSets>
