        </Field>
        <Field Name="Planned_Delivery_Date">
          <DataField>Planned Delivery Date</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Promised_Delivery_Date">
          <DataField>Promised Delivery Date</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Outstanding_Quantity">
          <DataField>Outstanding Quantity</DataField>
          <rd:TypeName>System.Decimal</rd:TypeName>
        </Field>
        <Field Name="Backlog_Amount">
          <DataField>Backlog Amount</DataField>
          <rd:TypeName>System.Decimal</rd:TypeName>
        </Field>
        <Field Name="Backlog_Date">
          <DataField>Backlog_Date</DataField>
          <rd:TypeName>System.DateTime</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
  </DataSets>
