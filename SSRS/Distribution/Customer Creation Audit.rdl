      <rd:DataSourceID>937fc5c7-b61d-44bc-986d-938ee0c7987d</rd:DataSourceID>
    </DataSource>
  </DataSources>
  <DataSets>
    <DataSet Name="DataSet1">
      <Query>
        <DataSourceName>DataSource1</DataSourceName>
        <CommandText>SELECT

[Created By User]
,[Date Created]
,No_
,[Name]
,[Credit Limit (LCY)]
,[Last Modified By]
,[Last Date Modified]

FROM ZYGO$Customer

Where [Created By User] = [Last Modified By]

AND [Credit Limit (LCY)] &gt; .01</CommandText>
        <rd:UseGenericDesigner>true</rd:UseGenericDesigner>
      </Query>
      <Fields>
        <Field Name="Created_By_User">
          <DataField>Created By User</DataField>
          <rd:TypeName>System.String</rd:TypeName>
