  <DataSets>
    <DataSet Name="DataSet1">
      <Query>
        <DataSourceName>NAV</DataSourceName>
        <CommandText>declare @order varchar(30)
declare @customer varchar(60)
declare @segment varchar(60)
declare @line varchar(30)
declare @shipdate date
declare @amount decimal(10,2)
declare @totalamount decimal(10,2)
declare @htext varchar(max)
declare @ltext varchar(max)
declare @orderp int
declare @l int
declare @sdates int

SET @line = ''
SET @htext = ''
SET @ltext = ''
set @orderp = 0
set @l = 0

CREATE TABLE #Temp
(
[A] varchar(1)
, [Order #] varchar(20)
, Customer varchar(60)
,Segment varchar(60)
,[Total Order Value] varchar(20)
,[Shipment1] varchar(20)
,[Shipment2] varchar(20)
,[Shipment3] varchar(20)
,[Shipment4] varchar(20)
,[Shipment5] varchar(20)
,[Shipment6] varchar(20)
,[Shipment7] varchar(20)
,[Shipment8] varchar(20)
,[Shipment9] varchar(20)
,[Shipment10] varchar(20)
,[Shipment11] varchar(20)
,[Shipment12] varchar(20)
,[Shipment13] varchar(20)
,[Shipment14] varchar(20)
,[Shipment15] varchar(20)
,[Shipment16] varchar(20)
,[Shipment17] varchar(20)
,[Shipment18] varchar(20)
,[Shipment19] varchar(20)
,[Shipment20] varchar(20)
,[Shipment21] varchar(20)
,[Shipment22] varchar(20)

)

declare orderCursor Cursor for

WITH s1 AS
(
select

 SUM([Line Amount]) Amount
,[Document No_]
,[Bill-to Name] Customer
,l.[Shortcut Dimension 2 Code] Segment
,l.[Shipment Date]

from [ZYGO$Sales Line] l

INNER JOIN [ZYGO$Sales Header] h on l.[Document No_] = h.No_ 

WHERE 1=1

	AND [Document No_] &lt; '8745'
	AND [Outstanding Quantity] &gt; 0

	AND l.No_ NOT LIKE 'FREIGHT%'

	GROUP BY [Document No_], l.[Shipment Date], [Bill-to Name], l.[Shortcut Dimension 2 Code]
)
,s2 AS
(
	SELECT

	[Document No_]
	,COUNT([Shipment Date]) sDates

	FROM s1

	GROUP BY [Document No_]
)
,s3 AS
(
	SELECT 

	SUM([Amount]) TotalAmount
	,[Document No_]

	FROM s1

	GROUP BY [Document No_]

)

	select 
	
	 CAST(s1.Amount as varchar) Amount
	,s1.[Document No_]
	,s1.Customer
	,s1.Segment
	,s1.[Shipment Date]
	,s2.sDates
	,CAST(s3.TotalAmount as varchar) TotalAmount
	
	from s1

	INNER JOIN s2 ON s1.[Document No_] = s2.[Document No_]
	INNER JOIN s3 ON s1.[Document No_] = s3.[Document No_]

	ORDER BY [Document No_], [Shipment Date]

open orderCursor
fetch next from orderCursor into @amount,@order,@customer,@segment, @shipdate, @sdates,@totalamount
while @@FETCH_STATUS = 0
begin

	IF @order != @line
		BEGIN
		SET @line = @order
		SET @l = 0
		SET @htext = @order + ',' + @customer + ',' + @segment + ',' + CAST(@totalamount as varchar)
		SET @ltext = @order + ','  + @customer + ',' + @segment + ','   + CAST(@totalamount as varchar)
			Insert into #Temp ([A],[Order #],[Customer],[Segment], [Total Order Value]) SELECT 'A',@order,@customer,@segment, @totalamount
			Insert into #Temp ([A],[Order #],[Customer],[Segment], [Total Order Value]) SELECT 'B',@order,'','', @totalamount
		END
	
	IF @order = @line
		BEGIN
			SET @l = @l + 1
			SET @htext = @htext + ',' + CAST( @shipdate as varchar)
			SET @ltext = @ltext + ',' + CAST( @amount as varchar)
			
			IF @l = 1
			BEGIN
			UPDATE #Temp SET Shipment1 = @shipdate where A = 'A' AND [Order #] = @order
			UPDATE #Temp SET Shipment1 = @amount where A = 'B' AND [Order #] = @order
			END
			
			IF @l = 2
			BEGIN
			UPDATE #Temp SET Shipment2 = @shipdate where A = 'A' AND [Order #] = @order
			UPDATE #Temp SET Shipment2 = @amount where A = 'B' AND [Order #] = @order
			END

			IF @l = 3
			BEGIN
			UPDATE #Temp SET Shipment3 = @shipdate where A = 'A' AND [Order #] = @order
			UPDATE #Temp SET Shipment3 = @amount where A = 'B' AND [Order #] = @order
			END

			IF @l = 4
			BEGIN
			UPDATE #Temp SET Shipment4 = @shipdate where A = 'A' AND [Order #] = @order
			UPDATE #Temp SET Shipment4 = @amount where A = 'B' AND [Order #] = @order
			END

			IF @l = 5
			BEGIN
			UPDATE #Temp SET Shipment5 = @shipdate where A = 'A' AND [Order #] = @order
			UPDATE #Temp SET Shipment5 = @amount where A = 'B' AND [Order #] = @order
			END

			IF @l = 6
			BEGIN
			UPDATE #Temp SET Shipment6 = @shipdate where A = 'A' AND [Order #] = @order
			UPDATE #Temp SET Shipment6 = @amount where A = 'B' AND [Order #] = @order
			END
			
			IF @l = 7
			BEGIN
			UPDATE #Temp SET Shipment7 = @shipdate where A = 'A' AND [Order #] = @order
			UPDATE #Temp SET Shipment7 = @amount where A = 'B' AND [Order #] = @order
			END

			IF @l = 8
			BEGIN
			UPDATE #Temp SET Shipment8 = @shipdate where A = 'A' AND [Order #] = @order
			UPDATE #Temp SET Shipment8 = @amount where A = 'B' AND [Order #] = @order
			END

			IF @l = 9
			BEGIN
			UPDATE #Temp SET Shipment9 = @shipdate where A = 'A' AND [Order #] = @order
			UPDATE #Temp SET Shipment9 = @amount where A = 'B' AND [Order #] = @order
			END

			IF @l = 10
			BEGIN
			UPDATE #Temp SET Shipment10 = @shipdate where A = 'A' AND [Order #] = @order
			UPDATE #Temp SET Shipment10 = @amount where A = 'B' AND [Order #] = @order
			END

			IF @l = 11
			BEGIN
			UPDATE #Temp SET Shipment11 = @shipdate where A = 'A' AND [Order #] = @order
			UPDATE #Temp SET Shipment11 = @amount where A = 'B' AND [Order #] = @order
			END
			
			IF @l = 12
			BEGIN
			UPDATE #Temp SET Shipment12 = @shipdate where A = 'A' AND [Order #] = @order
			UPDATE #Temp SET Shipment12 = @amount where A = 'B' AND [Order #] = @order
			END

			IF @l = 13
			BEGIN
			UPDATE #Temp SET Shipment13 = @shipdate where A = 'A' AND [Order #] = @order
			UPDATE #Temp SET Shipment13 = @amount where A = 'B' AND [Order #] = @order
			END

			IF @l = 14
			BEGIN
			UPDATE #Temp SET Shipment14 = @shipdate where A = 'A' AND [Order #] = @order
			UPDATE #Temp SET Shipment14 = @amount where A = 'B' AND [Order #] = @order
			END

			IF @l = 15
			BEGIN
			UPDATE #Temp SET Shipment15 = @shipdate where A = 'A' AND [Order #] = @order
			UPDATE #Temp SET Shipment15 = @amount where A = 'B' AND [Order #] = @order
			END

			IF @l = 16
			BEGIN
			UPDATE #Temp SET Shipment16 = @shipdate where A = 'A' AND [Order #] = @order
			UPDATE #Temp SET Shipment16 = @amount where A = 'B' AND [Order #] = @order
			END
			
			IF @l = 17
			BEGIN
			UPDATE #Temp SET Shipment17 = @shipdate where A = 'A' AND [Order #] = @order
			UPDATE #Temp SET Shipment17 = @amount where A = 'B' AND [Order #] = @order
			END

			IF @l = 18
			BEGIN
			UPDATE #Temp SET Shipment18 = @shipdate where A = 'A' AND [Order #] = @order
			UPDATE #Temp SET Shipment18 = @amount where A = 'B' AND [Order #] = @order
			END

			IF @l = 19
			BEGIN
			UPDATE #Temp SET Shipment19 = @shipdate where A = 'A' AND [Order #] = @order
			UPDATE #Temp SET Shipment19 = @amount where A = 'B' AND [Order #] = @order
			END

			IF @l = 20
			BEGIN
			UPDATE #Temp SET Shipment20 = @shipdate where A = 'A' AND [Order #] = @order
			UPDATE #Temp SET Shipment20 = @amount where A = 'B' AND [Order #] = @order
			END

			IF @l = 21
			BEGIN
			UPDATE #Temp SET Shipment21 = @shipdate where A = 'A' AND [Order #] = @order
			UPDATE #Temp SET Shipment21 = @amount where A = 'B' AND [Order #] = @order
			END
			
			IF @l = 22
			BEGIN
			UPDATE #Temp SET Shipment22 = @shipdate where A = 'A' AND [Order #] = @order
			UPDATE #Temp SET Shipment22 = @amount where A = 'B' AND [Order #] = @order
			END


		END
		
	fetch next from orderCursor into  @amount,@order,@customer,@segment, @shipdate,@sdates,@totalamount
end
close orderCursor
deallocate orderCursor


select * from #Temp



--DROP TABLE #Temp</CommandText>
        <rd:UseGenericDesigner>true</rd:UseGenericDesigner>
      </Query>
