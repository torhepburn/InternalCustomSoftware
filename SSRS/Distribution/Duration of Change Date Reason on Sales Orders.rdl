<?xml version="1.0" encoding="utf-8"?>
<Report MustUnderstand="df" xmlns="http://schemas.microsoft.com/sqlserver/reporting/2016/01/reportdefinition" xmlns:rd="http://schemas.microsoft.com/SQLServer/reporting/reportdesigner" xmlns:df="http://schemas.microsoft.com/sqlserver/reporting/2016/01/reportdefinition/defaultfontfamily">
  <df:DefaultFontFamily>Segoe UI</df:DefaultFontFamily>
  <AutoRefresh>0</AutoRefresh>
  <DataSources>
    <DataSource Name="NAV">
      <DataSourceReference>NAV</DataSourceReference>
      <rd:SecurityType>None</rd:SecurityType>
      <rd:DataSourceID>4e3d7e81-fec3-4658-a6fd-a722de39d134</rd:DataSourceID>
    </DataSource>
  </DataSources>
  <DataSets>
    <DataSet Name="DataSet1">
      <Query>
        <DataSourceName>NAV</DataSourceName>
        <CommandText>with s1 as
(
select

MIN([Last Date Modified]) [start]
,MAX([Last Date Modified]) [end]
,[Document No_]
,[Line No_]
,[Change Date Reason Code]


from [ZYGO$Change Sales Date Reason Entry]

GROUP BY

[Document No_]
,[Line No_]
,[Change Date Reason Code]

)

select

[start]
,[end]
,[Document No_]
,[Line No_]
,[Change Date Reason Code]
,r.Description
,DATEDIFF(dd,[start],[end]) DaysPerCode

FROM s1

LEFT JOIN [ZYGO$Change Date Reasons] r ON s1.[Change Date Reason Code] = r.Code

WHERE Sales = 1

ORDER BY

[Document No_]
,[Line No_]</CommandText>
        <rd:UseGenericDesigner>true</rd:UseGenericDesigner>
      </Query>
      <Fields>
        <Field Name="start">
          <DataField>start</DataField>
          <rd:TypeName>System.DateTime</rd:TypeName>
        </Field>
        <Field Name="end">
          <DataField>end</DataField>
          <rd:TypeName>System.DateTime</rd:TypeName>
        </Field>
        <Field Name="Document_No_">
          <DataField>Document No_</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Line_No_">
          <DataField>Line No_</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
        <Field Name="Change_Date_Reason_Code">
          <DataField>Change Date Reason Code</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Description">
          <DataField>Description</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="DaysPerCode">
          <DataField>DaysPerCode</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
  </DataSets>
