<?xml version="1.0" encoding="utf-8"?>
<Report MustUnderstand="df" xmlns="http://schemas.microsoft.com/sqlserver/reporting/2016/01/reportdefinition" xmlns:rd="http://schemas.microsoft.com/SQLServer/reporting/reportdesigner" xmlns:df="http://schemas.microsoft.com/sqlserver/reporting/2016/01/reportdefinition/defaultfontfamily">
  <df:DefaultFontFamily>Segoe UI</df:DefaultFontFamily>
  <AutoRefresh>0</AutoRefresh>
  <DataSources>
    <DataSource Name="NAV">
      <DataSourceReference>NAV</DataSourceReference>
      <rd:SecurityType>None</rd:SecurityType>
      <rd:DataSourceID>728ce667-4c7b-4754-95e2-9a56129646fc</rd:DataSourceID>
    </DataSource>
  </DataSources>
  <DataSets>
    <DataSet Name="DataSet1">
      <Query>
        <DataSourceName>NAV</DataSourceName>
        <CommandText>WITH s1 AS
(
select

Distinct

h.No_ [Sales Order No.]
,l.[Shortcut Dimension 2 Code] [Business Segment]
,REPLACE(h.[Assigned User ID], 'AMETEK-AD\','') [Sales Admin]
,h.[Sell-to Customer No_]
,c.Name SellToCustomer
,COALESCE(CASE c.Blocked
	WHEN 1 THEN 'Ship'
	WHEN 3 THEN 'All'
END,'') SellToBlocked
,FORMAT(c.[Credit Limit (LCY)], '#0.##') [SellTo Credit Limit]
,h.[Bill-to Customer No_]
,c1.Name BillToCustomer
,COALESCE(CASE c1.Blocked
	WHEN 1 THEN 'Ship'
	WHEN 3 THEN 'All'
END,'') BillToBlocked
,FORMAT(c1.[Credit Limit (LCY)], '#0.##') [BillTo Credit Limit]
,FORMAT(l.[Planned Shipment Date], 'MM-dd-yyyy') [Planned Shipment Date]
,CASE 
	WHEN LEN(h.[On Hold]) &gt; 0 THEN 'Yes'
	ELSE ''
End [On Hold]
,COALESCE(CASE [On Hold Reason Code]
	WHEN '1' THEN 'Customer Requested Hold'
	WHEN '2' THEN 'Lack of PO'
	WHEN '3' THEN 'Lack of L/C or License'
	WHEN '4' THEN 'Change Order Required'
	WHEN '5' THEN 'No Back Orders Allowed'
	WHEN '6' THEN 'Sales Administration'
	WHEN '7' THEN 'Required Bar Code'
	WHEN '8' THEN 'Required Special Invoice'
	WHEN '9' THEN 'Customer Material Required'
	WHEN '10' THEN 'Advance Payment Owed'
	WHEN '11' THEN 'Customer Visit Required'
	WHEN 'F01' THEN 'Finance Hold - Credit'
	WHEN 'PHR' THEN 'Photos Required'
END,'') [On Hold Reason]
,l.[SO Line No_]
,l.No_
,l.Description
,l.[Outstanding Quantity]
,l.[Line Amount]

from [ZYGO$Sales Header] h

INNER JOIN [ZYGO$Sales Line] l on h.No_ = l.[Document No_]

INNER JOIN [ZYGO$Customer] c on h.[Bill-to Customer No_] = c.No_

INNER JOIN [ZYGO$Customer] c1 on h.[Sell-to Customer No_] = c1.No_

INNER JOIN [ZYGO$Item] i on i.No_ = l.No_

where ((c.[Credit Limit (LCY)] = .01 or c1.[Credit Limit (LCY)] = .01

or COALESCE(c.Blocked,0) IN (1,2, 3)

or COALESCE(c1.Blocked,0) IN (1,2, 3))

OR LEN(h.[On Hold]) &gt; 0)

--and l.[Planned Shipment Date] &gt; GETDATE()

--and l.[Planned Shipment Date] &lt; (GETDATE() + 21)

AND [Outstanding Quantity] &gt; 0
)

SELECT

SellToCustomer
,SellToBlocked
,BillToBlocked
,[SellTo Credit Limit]
,COUNT([SO Line No_]) NumberOfSOLines
,[Sales Order No.]
, [On Hold Reason]
,SUM([Line Amount]) BlockedOutstandingSales


FROM s1 

GROUP BY 

SellToCustomer
,SellToBlocked
,BillToBlocked
,[SellTo Credit Limit]
,[Sales Order No.]
,[On Hold Reason]


Order BY 

SellToCustomer
,[Sales Order No.]
,[On Hold Reason]</CommandText>
        <rd:UseGenericDesigner>true</rd:UseGenericDesigner>
      </Query>
      <Fields>
        <Field Name="SellToCustomer">
          <DataField>SellToCustomer</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="SellToBlocked">
          <DataField>SellToBlocked</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="BillToBlocked">
          <DataField>BillToBlocked</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="SellTo_Credit_Limit">
          <DataField>SellTo Credit Limit</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="NumberOfSOLines">
          <DataField>NumberOfSOLines</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
        <Field Name="Sales_Order_No_">
          <DataField>Sales Order No.</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="On_Hold_Reason">
          <DataField>On Hold Reason</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="BlockedOutstandingSales">
          <DataField>BlockedOutstandingSales</DataField>
          <rd:TypeName>System.Decimal</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
  </DataSets>
