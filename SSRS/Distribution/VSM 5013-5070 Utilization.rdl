<?xml version="1.0" encoding="utf-8"?>
<Report MustUnderstand="df" xmlns="http://schemas.microsoft.com/sqlserver/reporting/2016/01/reportdefinition" xmlns:rd="http://schemas.microsoft.com/SQLServer/reporting/reportdesigner" xmlns:df="http://schemas.microsoft.com/sqlserver/reporting/2016/01/reportdefinition/defaultfontfamily">
  <df:DefaultFontFamily>Segoe UI</df:DefaultFontFamily>
  <AutoRefresh>0</AutoRefresh>
  <DataSources>
    <DataSource Name="AFE">
      <DataSourceReference>AFE</DataSourceReference>
      <rd:SecurityType>None</rd:SecurityType>
      <rd:DataSourceID>4ba10e06-47df-4bd6-bc44-3e139322d6f4</rd:DataSourceID>
    </DataSource>
  </DataSources>
  <DataSets>
    <DataSet Name="DataSet1">
      <Query>
        <DataSourceName>AFE</DataSourceName>
        <QueryParameters>
          <QueryParameter Name="@year">
            <Value>=Parameters!Year.Value</Value>
            <rd:UserDefined>true</rd:UserDefined>
          </QueryParameter>
          <QueryParameter Name="@month">
            <Value>=Parameters!Month.Value</Value>
            <rd:UserDefined>true</rd:UserDefined>
          </QueryParameter>
        </QueryParameters>
        <CommandText>with s01 AS
(
SELECT

UserID
,CAST(CreatedOn as date) cDate
,COUNT(
	CASE 
	WHEN WorkCenterComponentType = 'PERSON' THEN 'PERSON'
END	) PersonCount
,COUNT(
	CASE 
	WHEN WorkCenterComponentType != 'PERSON' THEN 'NOT PERSON'
END	) NotPersonCount

from [MIDDB01.zygo.com].Dashboard.dbo.timecardNAVProdHours

WHERE CreatedOn &gt; '2023-05-31'

GROUP BY 

UserID
,CAST(CreatedOn as date)
)
,s02 AS
(
SELECT

UserId 

FROM s01

GROUP BY userID

HAVING

SUM(NotPersonCount) = 0
)
,s1 AS
(
select

userID
,ApportionTime
,createdon
,costcenter
--,CAST(orderno as varchar(10))
,'PROD' Type


from [MIDDB01.zygo.com].Dashboard.dbo.timecardNAVProdHours

where WorkCenterComponentType = 'PERSON'

UNION ALL

select

userID
,hours
,createdon
,costcenter
--,IndirecttimeID
,Description


from [MIDDB01.zygo.com].Dashboard.dbo.timecardindirectTimeHours

--where userID = 1330


UNION ALL

select

ID
,hours
,dateentered
,costcenter
--,IndirecttimeID
,ProjectDescription


from [MIDDB01.zygo.com].Dashboard.dbo.timecard_MK_projects

--where ID = 1330
UNION ALL

select

userID
,hours
,createdon
,costcenter
--,CAST(orderno as varchar(10))
,'SALES' Type


from [MIDDB01.zygo.com].Dashboard.dbo.[TimecardNAVSalesHours]

UNION ALL

select

userID
,hours
,createdon
,costcenter
--,CAST(orderno as varchar(10))
,'SERVICE' Type


from [MIDDB01.zygo.com].Dashboard.dbo.[TimecardNAVServiceHours]

)
,s2 AS
(
select

s1.userID
,SUM(ApportionTime) HoursCharged
,MONTH(CreatedOn) nMonth
,YEAR(CreatedOn) nYear

from s1 INNER JOIN s02 ON s1.userID = s02.userID

where 

CreatedOn &gt; '2023-05-31'


GROUP BY 

s1.userID
,YEAR(CreatedOn) 
,MONTH(CreatedOn) 

)
,s3 AS
(
select

s2.* 
,AMETEK_ID
,p.Name
,s2.HoursCharged DashHoursCharged
,[Total Hours Worked]
,(HoursCharged/[Total Hours Worked])*100 Utilization


from s2

INNER JOIN [MIDDB01.zygo.com].Dashboard.dbo.Person p ON s2.userId = p.userID

RIGHT JOIN ADP ON p.AMETEK_ID = adp.[Empl ID]

AND s2.nMonth = adp.[Month] AND s2.nYear = adp.[Year]

WHERE nMonth = @month

AND nYear = @year
)
,s4 AS
(
	select

	[Empl ID]
	,MAX([Payroll Department])CostCenter

	FROM ADP 

	WHERE [Payroll Department] IN ('5013','5070')

	GROUP BY [Empl ID]
)
, s5 as
(

select * from s3  

INNER JOIN s4 ON s3.AMETEK_ID = s4.[Empl ID]
)

select

nYear Year
,nMonth Month
,CostCenter
,Name 
,DashHoursCharged
,[Total Hours Worked] [ADP Total Hours Worked]
,Utilization

from s5</CommandText>
        <rd:UseGenericDesigner>true</rd:UseGenericDesigner>
      </Query>
      <Fields>
        <Field Name="Year">
          <DataField>Year</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
        <Field Name="Month">
          <DataField>Month</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
        <Field Name="CostCenter">
          <DataField>CostCenter</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Name">
          <DataField>Name</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="DashHoursCharged">
          <DataField>DashHoursCharged</DataField>
          <rd:TypeName>System.Double</rd:TypeName>
        </Field>
        <Field Name="ADP_Total_Hours_Worked">
          <DataField>ADP Total Hours Worked</DataField>
          <rd:TypeName>System.Double</rd:TypeName>
        </Field>
        <Field Name="Utilization">
          <DataField>Utilization</DataField>
          <rd:TypeName>System.Double</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
  </DataSets>
