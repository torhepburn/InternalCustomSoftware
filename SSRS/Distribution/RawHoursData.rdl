  <DataSets>
    <DataSet Name="DataSet1">
      <Query>
        <DataSourceName>AFE</DataSourceName>
        <CommandText>--USE [AccessFrontEnds]
--GO

--/****** Object:  View [dbo].[DirectLaborNoMachineUtilizationRaw]    Script Date: 3/18/2024 10:45:52 AM ******/
--SET ANSI_NULLS ON
--GO

--SET QUOTED_IDENTIFIER ON
--GO

--ALTER view [dbo].[DirectLaborNoMachineUtilizationRaw] as

with s01 AS  /*	find work type per day per user	*/
(
SELECT

UserID
,CAST(CreatedOn as date) cDate
,COUNT(
	CASE 
	WHEN WorkCenterComponentType = 'PERSON' THEN 'PERSON'
END	) PersonCount
,COUNT(
	CASE 
	WHEN WorkCenterComponentType != 'PERSON' THEN 'NOT PERSON'
END	) NotPersonCount

from [MIDDB01.zygo.com].Dashboard.dbo.timecardNAVProdHours

WHERE CreatedOn &gt; '2023-05-31'

GROUP BY 

UserID
,CAST(CreatedOn as date)
)
,s02 AS   /*	finduser with person only work	*/
(
SELECT

UserId 

FROM s01

GROUP BY userID

HAVING

SUM(NotPersonCount) = 0
)
,sProd AS
(
select

userID
,ApportionTime
,createdon
,costcenter

from [MIDDB01.zygo.com].Dashboard.dbo.timecardNAVProdHours

where WorkCenterComponentType = 'PERSON'

AND CreatedOn &gt; '2023-01-01'
)
,sIndirect AS
(
select

userID
,hours
,createdon
,costcenter


from [MIDDB01.zygo.com].Dashboard.dbo.timecardindirectTimeHours
)
,sProject AS
(

select

ID
,hours
,dateentered
,costcenter


from [MIDDB01.zygo.com].Dashboard.dbo.timecard_MK_projects
)
,sSales AS

(
select

userID
,hours
,createdon
,costcenter


from [MIDDB01.zygo.com].Dashboard.dbo.[TimecardNAVSalesHours]
)
,sService AS
(

select

userID
,hours
,createdon
,costcenter


from [MIDDB01.zygo.com].Dashboard.dbo.[TimecardNAVServiceHours]
)
,s2Prod AS
(
select

s02.userID
,SUM(sProd.ApportionTime) ProdHours
,MONTH(sProd.CreatedOn) nMonth
,YEAR(sProd.CreatedOn) nYear

from sProd LEFT JOIN s02 ON sProd.userID = s02.userID

where 

CreatedOn &gt; '2023-05-31'

--AND MONTH(CreatedOn) &gt; 5

and YEAR(CreatedOn) = YEAR(GetDate()) 

GROUP BY 

s02.userID
,MONTH(CreatedOn) 
,YEAR(CreatedOn) 
)
,s2Indirect AS
(
	select

	s02.userID
	,SUM(sIndirect.Hours) IndirectHours
	,MONTH(sIndirect.CreatedOn) nMonth
	,YEAR(sIndirect.CreatedOn) nYear

	from sIndirect LEFT JOIN s02 ON sIndirect.userID = s02.userID

	where 

	CreatedOn &gt; '2023-05-31'

	--AND MONTH(CreatedOn) &gt; 5

	and YEAR(CreatedOn) = YEAR(GetDate()) 

	GROUP BY 

	s02.userID
	,MONTH(CreatedOn) 
	,YEAR(CreatedOn) 
)
,s2Project AS
(
	select

	s02.userID
	,SUM(sProject.Hours) ProjectHours
	,MONTH(sProject.DateEntered) nMonth
	,YEAR(sProject.DateEntered) nYear

	from sProject LEFT JOIN s02 ON sProject.ID = s02.userID

	where 

	DateEntered &gt; '2023-05-31'

	--AND MONTH(DateEntered) &gt; 5

	and YEAR(DateEntered) = YEAR(GetDate()) 

	GROUP BY 

	s02.userID
	,MONTH(DateEntered) 
	,YEAR(DateEntered) 
)

,s2Sales AS
(
	select

	s02.userID
	,SUM(sSales.Hours) SalesHours
	,MONTH(sSales.CreatedOn) nMonth
	,YEAR(sSales.CreatedOn) nYear

	from sSales LEFT JOIN s02 ON sSales.userID = s02.userID

	where 

	CreatedOn &gt; '2023-05-31'

	--AND MONTH(CreatedOn) &gt; 0

	and YEAR(CreatedOn) = YEAR(GetDate())

	GROUP BY 

	s02.userID
	,MONTH(CreatedOn) 
	,YEAR(CreatedOn) 
)

,s2Service AS
(
	select

	s02.userID
	,SUM(sService.Hours) ServiceHours
	,MONTH(sService.CreatedOn) nMonth
	,YEAR(sService.CreatedOn) nYear

	from sService LEFT JOIN s02 ON sService.userID = s02.userID

	where 

	CreatedOn &gt; '2023-05-31'

	--AND MONTH(CreatedOn) &gt; 0

	and YEAR(CreatedOn) = YEAR(GetDate()) 

	GROUP BY 

	s02.userID
	,MONTH(CreatedOn) 
	,YEAR(CreatedOn) 
)

--,s3 AS
--(
--select

--s2.* 
--,AMETEK_ID
--,[Total Hours Worked]
--,(hoursWorked/[Total Hours Worked])*100 Utilization


--from s2

--INNER JOIN [MIDDB01.zygo.com].Dashboard.dbo.Person p ON s2.userId = p.userID

--RIGHT JOIN ADP ON p.AMETEK_ID = adp.[Empl ID]

--AND s2.nMonth = adp.[Month] AND s2.nYear = adp.[Year]

--WHERE nMonth &lt; MONTH(GETDATE())
--)

--SELECT

--AVG(Utilization) Utilization
--,nYear
--,nMonth

--FROM s3 

--GROUP BY nYear, nMonth

--order by nYear, nMonth



select

--s2Prod.userID
--,
p.name
,s2Prod.ProdHours
,COALESCE(s2Indirect.IndirectHours,0) IndirectHours
,COALESCE(s2Project.ProjectHours,0) ProjectHours
,COALESCE(s2Sales.SalesHours,0) SalesHours
,COALESCE(s2Service.ServiceHours,0) ServiceHours
,s2Prod.ProdHours + COALESCE(s2Indirect.IndirectHours,0) + COALESCE(s2Project.ProjectHours,0) + COALESCE(s2Sales.SalesHours,0) + COALESCE(s2Service.ServiceHours,0) TotalDashboardHours
,[Total Hours Worked] [ADP Total Hours Worked]
,([Total Hours Worked]-.75) [ADP - .75 : Normalized Hours]
,(s2Prod.ProdHours + COALESCE(s2Indirect.IndirectHours,0) + COALESCE(s2Project.ProjectHours,0) + COALESCE(s2Sales.SalesHours,0) + COALESCE(s2Service.ServiceHours,0) )/([Total Hours Worked]-.75) [Utilization DashboardHours/ADPNormalized]
,s2Prod.nMonth
,s2Prod.nYear
,([Total Hours Worked]-.75)-(s2Prod.ProdHours + COALESCE(s2Indirect.IndirectHours,0) + COALESCE(s2Project.ProjectHours,0) + COALESCE(s2Sales.SalesHours,0) + COALESCE(s2Service.ServiceHours,0)) UndefinedTime

from s2Prod

LEFT JOIN s2Indirect on s2Prod.userID = s2Indirect.userID AND s2Prod.nMonth = s2Indirect.nMonth and s2Prod.nYear = s2Indirect.nYear
LEFT JOIN s2Project on s2Prod.userID = s2Project.userID AND s2Prod.nMonth = s2Project.nMonth and s2Prod.nYear = s2Project.nYear
LEFT JOIN s2Sales on s2Prod.userID = s2Sales.userID AND s2Prod.nMonth = s2Sales.nMonth and s2Prod.nYear = s2Sales.nYear
LEFT JOIN s2Service on s2Prod.userID = s2Service.userID AND s2Prod.nMonth = s2Service.nMonth and s2Prod.nYear = s2Service.nYear
INNER JOIN [MIDDB01.zygo.com].Dashboard.dbo.Person p ON s2Prod.userId = p.userID

RIGHT JOIN ADP ON p.AMETEK_ID = adp.[Empl ID] AND s2Prod.nMonth = adp.[Month] AND s2Prod.nYear = adp.[Year]


where s2Prod.nMonth = 2
--select * from s2Project</CommandText>
        <rd:UseGenericDesigner>true</rd:UseGenericDesigner>
      </Query>
      <Fields>
        <Field Name="name">
          <DataField>name</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="ProdHours">
          <DataField>ProdHours</DataField>
          <rd:TypeName>System.Double</rd:TypeName>
        </Field>
        <Field Name="IndirectHours">
          <DataField>IndirectHours</DataField>
          <rd:TypeName>System.Double</rd:TypeName>
        </Field>
        <Field Name="ProjectHours">
          <DataField>ProjectHours</DataField>
          <rd:TypeName>System.Double</rd:TypeName>
        </Field>
        <Field Name="SalesHours">
          <DataField>SalesHours</DataField>
          <rd:TypeName>System.Double</rd:TypeName>
        </Field>
        <Field Name="ServiceHours">
          <DataField>ServiceHours</DataField>
          <rd:TypeName>System.Double</rd:TypeName>
        </Field>
        <Field Name="TotalDashboardHours">
          <DataField>TotalDashboardHours</DataField>
          <rd:TypeName>System.Double</rd:TypeName>
        </Field>
        <Field Name="ADP_Total_Hours_Worked">
          <DataField>ADP Total Hours Worked</DataField>
          <rd:TypeName>System.Double</rd:TypeName>
        </Field>
        <Field Name="ADP____75___Normalized_Hours">
          <DataField>ADP - .75 : Normalized Hours</DataField>
          <rd:TypeName>System.Double</rd:TypeName>
        </Field>
        <Field Name="Utilization_DashboardHours_ADPNormalized">
          <DataField>Utilization DashboardHours/ADPNormalized</DataField>
          <rd:TypeName>System.Double</rd:TypeName>
        </Field>
        <Field Name="nMonth">
          <DataField>nMonth</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
        <Field Name="nYear">
          <DataField>nYear</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
        <Field Name="UndefinedTime">
          <DataField>UndefinedTime</DataField>
          <rd:TypeName>System.Double</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
  </DataSets>
