  <AutoRefresh>0</AutoRefresh>
  <DataSources>
    <DataSource Name="NAV">
      <DataSourceReference>NAV</DataSourceReference>
      <rd:SecurityType>None</rd:SecurityType>
      <rd:DataSourceID>715b5609-1a21-4a8f-acdc-5d79c3851e35</rd:DataSourceID>
    </DataSource>
  </DataSources>
  <DataSets>
    <DataSet Name="DataSet1">
      <Query>
        <DataSourceName>NAV</DataSourceName>
        <CommandText>WITH s1 AS
(
select

sil.[Shortcut Dimension 2 Code] BusinessSegment 
,sih.[Bill-to Name]
,sil.No_
,sil.Description
,sil.Quantity
,sil.[Posting Date] [Shipment Date]

from [ZYGO$Sales Invoice Line] sil

INNER JOIN [ZYGO$Sales Invoice Header] sih ON sil.[Document No_] = sih.No_

WHERE Quantity &gt; 0  AND sil.No_ NOT IN ('FREIGHT', 'FREIGHT EXPORT', 'FREIGHT INT''L')

AND MONTH(sil.[Posting Date]) &gt; CASE 
									WHEN MONTH(DATEADD(mm,-1,GETDATE())) = 12 THEN 0
									ELSE MONTH(DATEADD(mm,-1,GETDATE()))
								END

AND YEAR(sil.[Posting Date]) &gt; YEAR(DATEADD(yy,-1,GETDATE()))

AND sil.[Shortcut Dimension 2 Code] IN ('LFO VALUE STREAM','PO VALUE STREAM')
)
,s2 AS
(
select

BusinessSegment 
,[Bill-to Name]
,No_
,Description
,Quantity QtyShipped
,[Shipment Date]

FROM s1
)

SELECT

BusinessSegment 
,[Bill-to Name]
,No_
,Description
,SUM(QtyShipped) QtyShipped
,[Shipment Date]

FROM s2

GROUP BY


BusinessSegment
,[Bill-to Name]
,No_
,Description
,[Shipment Date]


ORDER BY [Shipment Date]</CommandText>
        <rd:UseGenericDesigner>true</rd:UseGenericDesigner>
      </Query>
      <Fields>
        <Field Name="BusinessSegment">
          <DataField>BusinessSegment</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Bill_to_Name">
          <DataField>Bill-to Name</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="No_">
          <DataField>No_</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Description">
          <DataField>Description</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="QtyShipped">
          <DataField>QtyShipped</DataField>
          <rd:TypeName>System.Decimal</rd:TypeName>
        </Field>
        <Field Name="Shipment_Date">
          <DataField>Shipment Date</DataField>
          <rd:TypeName>System.DateTime</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
  </DataSets>
