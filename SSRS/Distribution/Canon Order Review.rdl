<?xml version="1.0" encoding="utf-8"?>
<Report MustUnderstand="df" xmlns="http://schemas.microsoft.com/sqlserver/reporting/2016/01/reportdefinition" xmlns:rd="http://schemas.microsoft.com/SQLServer/reporting/reportdesigner" xmlns:df="http://schemas.microsoft.com/sqlserver/reporting/2016/01/reportdefinition/defaultfontfamily">
  <df:DefaultFontFamily>Segoe UI</df:DefaultFontFamily>
  <AutoRefresh>0</AutoRefresh>
  <DataSources>
    <DataSource Name="DataSource1">
      <ConnectionProperties>
        <DataProvider>SQL</DataProvider>
        <ConnectString>Data Source=pa-hor-as408;Initial Catalog=ZYGO-NAV-PROD</ConnectString>
      </ConnectionProperties>
      <rd:SecurityType>DataBase</rd:SecurityType>
      <rd:DataSourceID>d810a305-2f6d-4c87-a2da-84e4c49fe05a</rd:DataSourceID>
    </DataSource>
  </DataSources>
  <DataSets>
    <DataSet Name="DataSet1">
      <Query>
        <DataSourceName>DataSource1</DataSourceName>
        <CommandText>select 

[End User Customer Name]
,[Planned Shipment Date]
,sh.No_ [Sales Order]
, [Special Labelling] 
, sl.[SO Line No_]
,sl.No_ [Item Number]
,FORMAT(sl.[Outstanding Quantity], 'N0') [Outstanding Quantity]
,COALESCE([External Document No_],'') [External Document No_]
,[Assigned User ID]

from [ZYGO$Sales Header] sh

LEFT JOIN [ZYGO$Sales Line] sl ON sh.No_ = sl.[Document No_]

where 

([End User Customer Name] like 'Canon %' 

or [End User Customer Name] like 'CANON %' )

AND [End User Customer Name] NOT like 'CANON INC%'

AND [End User Customer Name] NOT like 'CANON PED%'

AND sh.[Sell-to Customer No_] = 'C00026'

--AND [Special Labelling] is null

AND LEN([Special Labelling]) = 0

AND [Outstanding Quantity] &gt; 0

AND [SO Line No_] &lt; 500

AND sl.[Shortcut Dimension 2 Code] = 'PPS COMPONENTS'

AND CHARINDEX('X',sl.No_) = 0

AND 

([Assigned User ID] LIKE '%DESANTI'

OR [Assigned User ID] LIKE '%SWROBEL'

OR [Assigned User ID] LIKE '%KHUGHES')


order by sh.No_ </CommandText>
        <rd:UseGenericDesigner>true</rd:UseGenericDesigner>
      </Query>
      <Fields>
        <Field Name="End_User_Customer_Name">
          <DataField>End User Customer Name</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Planned_Shipment_Date">
          <DataField>Planned Shipment Date</DataField>
          <rd:TypeName>System.DateTime</rd:TypeName>
        </Field>
        <Field Name="Sales_Order">
          <DataField>Sales Order</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Special_Labelling">
          <DataField>Special Labelling</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="SO_Line_No_">
          <DataField>SO Line No_</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
        <Field Name="Item_Number">
          <DataField>Item Number</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Outstanding_Quantity">
          <DataField>Outstanding Quantity</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="External_Document_No_">
          <DataField>External Document No_</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Assigned_User_ID">
          <DataField>Assigned User ID</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
  </DataSets>
