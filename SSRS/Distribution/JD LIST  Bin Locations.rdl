)
,s2 AS
(
	SELECT

	[Item No_]
	,[Bin Code]
	,SUM(Quantity) OH
	
	FROM [ZYGO$Warehouse Entry]

	WHERE [Item No_] IN (Select [Item No_] FROM s1)

	GROUP BY [Item No_], [Bin Code]
)




select

s1.*
,s2.OH

from  s1 LEFT JOIN s2 ON s1.[Item No_] = s2.[Item No_]

AND s1.[Bin Code] = s2.[Bin Code]


ORDER BY s1.[Item No_]</CommandText>
