<?xml version="1.0" encoding="utf-8"?>
<Report MustUnderstand="df" xmlns="http://schemas.microsoft.com/sqlserver/reporting/2016/01/reportdefinition" xmlns:rd="http://schemas.microsoft.com/SQLServer/reporting/reportdesigner" xmlns:df="http://schemas.microsoft.com/sqlserver/reporting/2016/01/reportdefinition/defaultfontfamily">
  <df:DefaultFontFamily>Segoe UI</df:DefaultFontFamily>
  <AutoRefresh>0</AutoRefresh>
  <DataSources>
    <DataSource Name="NAV">
      <DataSourceReference>NAV</DataSourceReference>
      <rd:SecurityType>None</rd:SecurityType>
      <rd:DataSourceID>0f0279c4-30ba-4a63-abef-5baf9d5705a9</rd:DataSourceID>
    </DataSource>
  </DataSources>
  <DataSets>
    <DataSet Name="DataSet1">
      <Query>
        <DataSourceName>NAV</DataSourceName>
        <CommandText>WITH sTotal AS
(
SELECT

h.[Purchaser Code]
,COUNT([Purchaser Code]) Total


FROM [ZYGO$Purchase Line] l

INNER JOIN [ZYGO$Purchase Header] h ON h.No_ = l.[Document No_]

WHERE h.[Purchaser Code] IN

(
select distinct

h.[Purchaser Code]

FROM [ZYGO$Purchase Line] l

INNER JOIN [ZYGO$Purchase Header] h on h.No_ = l.[Document No_]

WHERE l.[Promised Receipt Date] &gt; '01-01-2000' 

AND l.[Outstanding Quantity] &gt; 0
)

AND l.[Promised Receipt Date] = '1753-01-01'

AND h.[Document Type] = 1

AND l.[Outstanding Quantity] &lt;&gt; 0

GROUP BY h.[Purchaser Code]
)
,s1W AS
(
SELECT

h.[Purchaser Code]
,COALESCE(COUNT([Purchaser Code]),0) Total


FROM [ZYGO$Purchase Line] l

INNER JOIN [ZYGO$Purchase Header] h ON h.No_ = l.[Document No_]

WHERE h.[Purchaser Code] IN

(
select distinct

h.[Purchaser Code]

FROM [ZYGO$Purchase Line] l

INNER JOIN [ZYGO$Purchase Header] h on h.No_ = l.[Document No_]

WHERE l.[Promised Receipt Date] &gt; '01-01-2000' 

AND l.[Outstanding Quantity] &gt; 0
)

AND l.[Promised Receipt Date] = '1753-01-01'

AND h.[Document Type] = 1

AND l.[Outstanding Quantity] &lt;&gt; 0

AND CAST(h.[Order Date] as date) between CAST(DATEADD(ww,-1, GETDATE()) AS date) and CAST(GETDATE() as date)

GROUP BY h.[Purchaser Code]
)
,s1M AS
(
SELECT

h.[Purchaser Code]
,COALESCE(COUNT([Purchaser Code]),0) Total


FROM [ZYGO$Purchase Line] l

INNER JOIN [ZYGO$Purchase Header] h ON h.No_ = l.[Document No_]

WHERE h.[Purchaser Code] IN

(
select distinct

h.[Purchaser Code]

FROM [ZYGO$Purchase Line] l

INNER JOIN [ZYGO$Purchase Header] h on h.No_ = l.[Document No_]

WHERE l.[Promised Receipt Date] &gt; '01-01-2000' 

AND l.[Outstanding Quantity] &gt; 0
)

AND l.[Promised Receipt Date] = '1753-01-01'

AND h.[Document Type] = 1

AND l.[Outstanding Quantity] &lt;&gt; 0

AND CAST(h.[Order Date] as date) between CAST(DATEADD(MONTH,-1, GETDATE()) AS date) and CAST(DATEADD(ww,-1, GETDATE()) AS date)

GROUP BY h.[Purchaser Code]
)

,s1O AS
(
SELECT

h.[Purchaser Code]
,COALESCE(COUNT([Purchaser Code]),0) Total


FROM [ZYGO$Purchase Line] l

INNER JOIN [ZYGO$Purchase Header] h ON h.No_ = l.[Document No_]

WHERE h.[Purchaser Code] IN

(
select distinct

h.[Purchaser Code]

FROM [ZYGO$Purchase Line] l

INNER JOIN [ZYGO$Purchase Header] h on h.No_ = l.[Document No_]

WHERE l.[Promised Receipt Date] &gt; '01-01-2000' 

AND l.[Outstanding Quantity] &gt; 0
)

AND l.[Promised Receipt Date] = '1753-01-01'

AND h.[Document Type] = 1

AND l.[Outstanding Quantity] &lt;&gt; 0

AND CAST(h.[Order Date] as date) &lt; CAST(DATEADD(MONTH,-1, GETDATE()) AS date)

GROUP BY h.[Purchaser Code]
)
,s1P AS
(
select distinct

h.[Purchaser Code]

FROM [ZYGO$Purchase Line] l

INNER JOIN [ZYGO$Purchase Header] h on h.No_ = l.[Document No_]

WHERE l.[Promised Receipt Date] &gt; '01-01-2000' 

AND l.[Outstanding Quantity] &gt; 0
)




select 

s1P.*
,t.Total
,COALESCE(w.Total,0) [1 Week]
,COALESCE(m.Total,0) [1 Month]
,COALESCE(o.Total,0) [Older]

from s1P

LEFT JOIN sTotal t ON s1P.[Purchaser Code] = t.[Purchaser Code]
LEFT JOIN s1W w ON s1P.[Purchaser Code] = w.[Purchaser Code]
LEFT JOIN s1M m ON s1P.[Purchaser Code] = m.[Purchaser Code]
LEFT JOIN s1O o ON s1P.[Purchaser Code] = o.[Purchaser Code]


ORDER BY s1P.[Purchaser Code]
</CommandText>
        <rd:UseGenericDesigner>true</rd:UseGenericDesigner>
      </Query>
      <Fields>
        <Field Name="Purchaser_Code">
          <DataField>Purchaser Code</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Total">
          <DataField>Total</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
        <Field Name="ID1_Week">
          <DataField>1 Week</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
        <Field Name="ID1_Month">
          <DataField>1 Month</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
        <Field Name="Older">
          <DataField>Older</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
  </DataSets>
