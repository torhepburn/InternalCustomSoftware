<?xml version="1.0" encoding="utf-8"?>
<Report MustUnderstand="df" xmlns="http://schemas.microsoft.com/sqlserver/reporting/2016/01/reportdefinition" xmlns:rd="http://schemas.microsoft.com/SQLServer/reporting/reportdesigner" xmlns:df="http://schemas.microsoft.com/sqlserver/reporting/2016/01/reportdefinition/defaultfontfamily">
  <df:DefaultFontFamily>Segoe UI</df:DefaultFontFamily>
  <AutoRefresh>0</AutoRefresh>
  <DataSources>
    <DataSource Name="DataSource1">
      <ConnectionProperties>
        <DataProvider>SQL</DataProvider>
        <ConnectString>Data Source=pa-hor-as408.ametek.com;Initial Catalog=ZYGO-NAV-PROD</ConnectString>
      </ConnectionProperties>
      <rd:SecurityType>DataBase</rd:SecurityType>
      <rd:DataSourceID>bca853f9-af83-4110-8ca1-cb25c5bd116e</rd:DataSourceID>
    </DataSource>
  </DataSources>
  <DataSets>
    <DataSet Name="DataSet1">
      <Query>
        <DataSourceName>DataSource1</DataSourceName>
        <CommandText>with s1 as
(select 
sl1.[Document No_]
,sl1.[SO Line No_]
,MAX(csdre.[Last Date Modified]) LastChange
from [ZYGO$Sales Line] sl1
inner join [ZYGO$Change Sales Date Reason Entry] csdre on sl1.[Document No_] = csdre.[Document No_] and sl1.[SO Line No_] = csdre.[SO Line No_]
GROUP BY sl1.[Document No_], sl1.[SO Line No_]
),
s2 as
(
	SELECT
	s1.[Document No_]
	,s1.[SO Line No_]
	,[Old Promised Delivery Date] [From Current Date]
	,[New Promised Delivery Date] [To New Date]
	,LastChange
	,SUBSTRING([Modified by User],11,50) [Changed By]
	,cdr.Description [Change Date Reason]
	,cdr.Code
                   ,Comment

	FROM
	[ZYGO$Change Sales Date Reason Entry] cd 
	INNER JOIN s1 on s1.[Document No_] = cd.[Document No_] and s1.[SO Line No_] = cd.[SO Line No_] and s1.LastChange = cd.[Last Date Modified]
	INNER JOIN [ZYGO$Change Date Reasons] cdr on cd.[Change Date Reason Code] = cdr.Code
)


select 

[Name] Customer
,sl.[Location Code]
,sl.[Document No_] [Order]
,sl.[SO Line No_]
,sl.[Job No_] [Project]
,[Outstanding Quantity] [Backlog Quantity]
,[Outstanding Amount (LCY)] [Backlog Amount]
,sl.No_ [Item No.]
,sl.Description
,[Orig_ Promised Delivery Date]
,s2.[From Current Date]
,s2.[To New Date]
,CASE
	WHEN s2.[To New Date] &gt; DATEADD(d,-1,DATEADD(q,DATEDIFF(q,0,GETDATE())+1,0)) THEN 'Y'
	ELSE 'N'
END 'Next Q'
,s2.[Changed By]
,s2.LastChange [Date Changed]
,s2.[Change Date Reason]
,s2.Code
,sl.[Shortcut Dimension 2 Code]
,s2.Comment

FROM [ZYGO$Sales Line] sl

inner join [ZYGO$Sales Header] sh on sh.No_ = sl.[Document No_]

inner join ZYGO$Customer c on sl.[Sell-to Customer No_] = c.No_

left join s2

on sl.[Document No_] = s2.[Document No_] and sl.[SO Line No_] = s2.[SO Line No_]

WHERE [Outstanding Quantity] &gt; 0

AND sl.[SO Line No_] &lt; 500


and s2.[From Current Date] &gt; GETDATE()-6 

AND s2.[From Current Date] &lt; GETDATE()+1 

ORDER BY [From Current Date]</CommandText>
        <rd:UseGenericDesigner>true</rd:UseGenericDesigner>
      </Query>
      <Fields>
        <Field Name="Customer">
          <DataField>Customer</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Location_Code">
          <DataField>Location Code</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Order">
          <DataField>Order</DataField>
