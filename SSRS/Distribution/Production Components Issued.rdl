    </DataSource>
  </DataSources>
  <DataSets>
    <DataSet Name="DataSet1">
      <Query>
        <DataSourceName>NAV</DataSourceName>
        <CommandText>select 

[User ID]
,[Posting Date] postingdate
,[Document Date]
,[Source No_]
,[Document No_]
,[Order No_]
,[Order Line No_]
,[Item No_] i
,Quantity
,[Remaining Quantity]
--,*

 from [ZYGO$Item Ledger Entry]

Where [Document No_] = 'PD104172'

--and [Order Line No_] = 70000

--AND [Item No_] = '6550-1225-01'

ORDER BY [Item No_], [Posting Date]</CommandText>
        <rd:UseGenericDesigner>true</rd:UseGenericDesigner>
      </Query>
      <Fields>
        <Field Name="User_ID">
          <DataField>User ID</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
