  <AutoRefresh>0</AutoRefresh>
  <DataSources>
    <DataSource Name="NAV">
      <DataSourceReference>NAV</DataSourceReference>
      <rd:SecurityType>None</rd:SecurityType>
      <rd:DataSourceID>15f56761-56da-4730-9605-59182dfa2dd7</rd:DataSourceID>
    </DataSource>
  </DataSources>
  <DataSets>
    <DataSet Name="DataSet1">
      <Query>
        <DataSourceName>NAV</DataSourceName>
        <CommandText>SELECT 


--[No_]
--,[Description]
--,
YEAR([Due Date]) [Year]
,MONTH([Due Date]) [MonthNo]
--,[Order Date]
--,FORMAT(Quantity,'N', 'en-us')
,SUM([Cost Amount]) [Cost Amount]
--,CASE [Location Code]
--	WHEN 'MID' THEN 'Middlefield'
--	WHEN 'RIC' THEN 'Richmond'
--	WHEN 'IRV' THEN 'Irvine'
--END
--,[Action Message]

FROM [ZYGO$Requisition Line] 

WHERE

[Ref_ Order Type] = 1 --purchase

AND Type = 2  --item

AND [Replenishment System] = 0 --purchased

AND [Action Message] = 1 --add new

AND [Worksheet Template Name] = 'PLANNING'

AND [Journal Batch Name] = 'DEFAULT'

GROUP BY MONTH([Due Date]), YEAR([Due Date])

ORDER BY YEAR([Due Date]), MONTH([Due Date])</CommandText>
        <rd:UseGenericDesigner>true</rd:UseGenericDesigner>
      </Query>
      <Fields>
        <Field Name="Year">
          <DataField>Year</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
        <Field Name="MonthNo">
          <DataField>MonthNo</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
        <Field Name="Cost_Amount">
          <DataField>Cost Amount</DataField>
          <rd:TypeName>System.Decimal</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
  </DataSets>
