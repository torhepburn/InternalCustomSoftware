<?xml version="1.0" encoding="utf-8"?>
<Report MustUnderstand="df" xmlns="http://schemas.microsoft.com/sqlserver/reporting/2016/01/reportdefinition" xmlns:rd="http://schemas.microsoft.com/SQLServer/reporting/reportdesigner" xmlns:df="http://schemas.microsoft.com/sqlserver/reporting/2016/01/reportdefinition/defaultfontfamily">
  <df:DefaultFontFamily>Segoe UI</df:DefaultFontFamily>
  <AutoRefresh>0</AutoRefresh>
  <DataSources>
    <DataSource Name="NAV">
      <DataSourceReference>NAV</DataSourceReference>
      <rd:SecurityType>None</rd:SecurityType>
      <rd:DataSourceID>12aceecd-8376-47d9-b76c-e13e3bb7b2ed</rd:DataSourceID>
    </DataSource>
  </DataSources>
  <DataSets>
    <DataSet Name="DataSet1">
      <Query>
        <DataSourceName>NAV</DataSourceName>
        <CommandText>SELECT 
l.[Document No_] [PO #]
,l.[PO Line No_]
,h.[Pay-to Name] [Vendor Name]
,l.No_ [Item]
,l.Description
,l.Quantity [Qty Ordered]
,pr.Quantity [Qty Received]
,pr.[Posting Date] [Actual Receipt Date]
,l.[Outstanding Quantity] [Qty Outstanding]
,l.[Line Amount] [$ Ordered]
,l.[Requested Receipt Date] 
,l.[Promised Receipt Date] 
,[Purchaser Code] [Buyer Name]
,l.[Order Date] [Order Place Date]
,h.[Order Date] [Order Open Date]
,i.Commodity
,COALESCE(c.Description,'') [Commodity Description]
,r.Name [Country]
,CASE MONTH(pr.[Posting Date]) 
	WHEN 1 THEN 'JAN1'
	WHEN 2 THEN 'FEB'
	WHEN 3 THEN 'MAR'
	WHEN 4 THEN 'APR'
	WHEN 5 THEN 'MAY'
	WHEN 6 THEN 'JUN'
	WHEN 7 THEN 'JUL'
	WHEN 8 THEN 'AUG'
	WHEN 9 THEN 'SEP'
	WHEN 10 THEN 'OCT'
	WHEN 11 THEN 'NOV'
	WHEN 12 THEN 'DEC'
	ELSE ''
END [MonthName]
,CAST(YEAR(pr.[Posting Date]) as nchar(4)) +
CASE MONTH(pr.[Posting Date]) 
	WHEN 1 THEN '01'
	WHEN 2 THEN '02'
	WHEN 3 THEN '03'
	WHEN 4 THEN '04'
	WHEN 5 THEN '05'
	WHEN 6 THEN '06'
	WHEN 7 THEN '07'
	WHEN 8 THEN '08'
	WHEN 9 THEN '09'
	WHEN 10 THEN '10'
	WHEN 11 THEN '11'
	WHEN 12 THEN '12'
	ELSE ''
END [SortDate]
,YEAR(pr.[Posting Date]) [Year]
,MONTH(pr.[Posting Date]) [Month]
,CAST(GETDATE() AS date) DataDate

FROM [ZYGO$Purchase Line] l

INNER JOIN [ZYGO$Purchase Header] h ON l.[Document No_] = h.No_

INNER JOIN [ZYGO$Purch_ Rcpt_ Line] pr On pr.[Order No_] = l.[Document No_] AND pr.[PO Line No_] = l.[PO Line No_]

INNER JOIN ZYGO$Item i ON l.No_ = i.No_

LEFT JOIN ZYGO$Commodity c ON i.Commodity = c.Code

LEFT JOIN [ZYGO$Country_Region] r ON h.[Pay-to Country_Region Code] = r.Code

where  pr.[Quantity] &lt;&gt; 0

AND pr.[Posting Date] BETWEEN '2024-01-01' AND '2025-01-31'</CommandText>
        <rd:UseGenericDesigner>true</rd:UseGenericDesigner>
      </Query>
      <Fields>
        <Field Name="PO__">
          <DataField>PO #</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="PO_Line_No_">
          <DataField>PO Line No_</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
