<?xml version="1.0" encoding="utf-8"?>
<Report MustUnderstand="df" xmlns="http://schemas.microsoft.com/sqlserver/reporting/2016/01/reportdefinition" xmlns:rd="http://schemas.microsoft.com/SQLServer/reporting/reportdesigner" xmlns:df="http://schemas.microsoft.com/sqlserver/reporting/2016/01/reportdefinition/defaultfontfamily">
  <df:DefaultFontFamily>Segoe UI</df:DefaultFontFamily>
  <AutoRefresh>0</AutoRefresh>
  <DataSources>
    <DataSource Name="NAV">
      <DataSourceReference>NAV</DataSourceReference>
      <rd:SecurityType>None</rd:SecurityType>
      <rd:DataSourceID>d960fc8a-74a9-4973-bde0-7c9b82044bdf</rd:DataSourceID>
    </DataSource>
  </DataSources>
  <DataSets>
    <DataSet Name="DataSet1">
      <Query>
        <DataSourceName>NAV</DataSourceName>
        <CommandText>SELECT DISTINCT

[Date and Time] 
,[User ID]
,CASE [Field No_]
	WHEN 1 THEN 'No.'
	WHEN 2 THEN 'Name'
	WHEN 20 THEN 'Credit Limit (LCY)'
	WHEN 22 THEN 'Unit Cost'
	WHEN 24 THEN 'Standard Cost'
	WHEN 29 THEN 'Salesperson Code'
	WHEN 39 THEN 'Blocked'
	WHEN 62 THEN 'Last Date Modified date'
	WHEN 63 THEN 'Last Time Modified time'
	WHEN 91 THEN 'General Prod Posting Group'
	WHEN 5400 THEN 'Low-Level Code'
	WHEN 5403 THEN 'Last Unit cost Calc. Date date'
	WHEN 5404 THEN 'Rolled-up Material Cost'
	WHEN 5405 THEN 'Rolled-up Capacity Cost'
	WHEN 5409 THEN 'Inventory Value Zero'
	WHEN 5813 THEN 'Inventory Posting Setup'
	WHEN 7380 THEN 'Phys Invt Counting Period Code'
	WHEN 7381 THEN 'Last Counting Period Update date'
	WHEN 7386 THEN 'Next counting End Date date'
	WHEN 7385 THEN 'Next counting Start Date date'
	WHEN 50027 THEN 'Proposed Purchase Cost'
	WHEN 50041 THEN 'P6'
	WHEN 50042 THEN 'F6'
	WHEN 50043 THEN 'EAU'
	WHEN 50044 THEN 'FAI Class'
	WHEN 50053 THEN 'Last Modified by'
	WHEN 50054 THEN 'Last Modified Date-Time datetime'
	WHEN 99000752 THEN 'Single-Level Material Cost'
	WHEN 99000753 THEN 'Single-Level Capacity Cost'
	WHEN 99000755 THEN 'Single-Level Cap. Ovhd Cost'
	WHEN 99000760 THEN 'Rolled-up Cap. Overhead Cost'
	ELSE 'Not Coded'
END [Field]
,CASE 
	WHEN [Field No_] = 39 THEN
	CASE
		WHEN [Old Value] = 3 THEN 'All'
		ELSE ''
	END
	ELSE [Old Value]
END [Old Value]
,CASE 
	WHEN [New Value] = 0 THEN ''
	ELSE [New Value]
END [New Value]
,[Primary Key Field 1 Value] [Customer No.]
,Name
,h.No_ [Sales Order]
,sl.[Planned Shipment Date]

FROM [ZYGO$Change Log Entry] l

LEFT JOIN ZYGO$Customer c ON l.[Primary Key Field 1 Value] = c.No_

LEFT JOIN [ZYGO$Sales Header] h ON c.No_ = h.[Bill-to Customer No_]

INNER JOIN [ZYGO$Sales Line] sl ON h.No_ = sl.[Document No_]

WHERE [Table No_] = 18

AND [Field No_] IN (20,39)

AND [Date and Time] &gt;= GETDATE() - 1

AND (([Field No_] = 39 AND [New Value] = 0) OR ([Field No_] = 20 AND [New Value] &lt;&gt; '0.01'))

AND [Outstanding Quantity] &gt; 0

AND sl.[Planned Shipment Date] &lt; (GETDATE() + 21)

UNION ALL

SELECT DISTINCT

[Date and Time]
, [User ID]
,CASE [Field No_]
	WHEN 1 THEN 'Document Type'
	WHEN 2 THEN 'Sell-to Customer No.'
	WHEN 3 THEN 'No.'
	WHEN 24 THEN 'Standard Cost'
	WHEN 25 THEN 'Last Direct Cost'
	WHEN 29 THEN 'Cost is Adjusted'
	WHEN 62 THEN 'Last Date Modified date'
	WHEN 73 THEN 'Reason Code'
	WHEN 91 THEN 'General Prod Posting Group'
	WHEN 5400 THEN 'Low-Level Code'
	WHEN 5403 THEN 'Last Unit cost Calc. Date date'
	WHEN 5404 THEN 'Rolled-up Material Cost'
	WHEN 5405 THEN 'Rolled-up Capacity Cost'
	WHEN 5409 THEN 'Inventory Value Zero'
	WHEN 5813 THEN 'Inventory Posting Setup'
	WHEN 7380 THEN 'Phys Invt Counting Period Code'
	WHEN 7381 THEN 'Last Counting Period Update date'
	WHEN 7386 THEN 'Next counting End Date date'
	WHEN 7385 THEN 'Next counting Start Date date'
	WHEN 9000 THEN 'Assigned User ID'
	WHEN 50018 THEN 'On Hold Reason Code'
	WHEN 50041 THEN 'P6'
	WHEN 50042 THEN 'F6'
	WHEN 50043 THEN 'EAU'
	WHEN 50044 THEN 'FAI Class'
	WHEN 50053 THEN 'Last Modified by'
	WHEN 50054 THEN 'Last Modified Date-Time datetime'
	WHEN 99000752 THEN 'Single-Level Material Cost'
	WHEN 99000753 THEN 'Single-Level Capacity Cost'
	WHEN 99000755 THEN 'Single-Level Cap. Ovhd Cost'
	WHEN 99000760 THEN 'Rolled-up Cap. Overhead Cost'
	ELSE 'Not Coded'
END [Field]
--,[Type of Change]
,CASE
	WHEN [Field No_] = 50018 THEN
COALESCE(CASE [Old Value]
	WHEN '1' THEN 'Customer Requested Hold'
	WHEN '2' THEN 'Lack of PO'
	WHEN '3' THEN 'Lack of L/C or License'
	WHEN '4' THEN 'Change Order Required'
	WHEN '5' THEN 'No Back Orders Allowed'
	WHEN '6' THEN 'Sales Administration'
	WHEN '7' THEN 'Required Bar Code'
	WHEN '8' THEN 'Required Special Invoice'
	WHEN '9' THEN 'Customer Material Required'
	WHEN '10' THEN 'Advance Payment Owed'
	WHEN '11' THEN 'Customer Visit Required'
	WHEN 'F01' THEN 'Finance Hold - Credit'
	WHEN 'PHR' THEN 'Photos Required'
END,'')
	ELSE [Old Value]
END [Old Value]
,CASE
	WHEN [Field No_] = 50018 THEN
COALESCE(CASE [New Value]
	WHEN '1' THEN 'Customer Requested Hold'
	WHEN '2' THEN 'Lack of PO'
	WHEN '3' THEN 'Lack of L/C or License'
	WHEN '4' THEN 'Change Order Required'
	WHEN '5' THEN 'No Back Orders Allowed'
	WHEN '6' THEN 'Sales Administration'
	WHEN '7' THEN 'Required Bar Code'
	WHEN '8' THEN 'Required Special Invoice'
	WHEN '9' THEN 'Customer Material Required'
	WHEN '10' THEN 'Advance Payment Owed'
	WHEN '11' THEN 'Customer Visit Required'
	WHEN 'F01' THEN 'Finance Hold - Credit'
	WHEN 'PHR' THEN 'Photos Required'
END,'')
	ELSE [New Value]
END [New Value]
,h.[Sell-to Customer No_] [Customer No.]
,[Sell-to Customer Name] [Name]
,[Primary Key Field 2 Value] [Sales Order]
,sl.[Planned Shipment Date]

FROM [ZYGO$Change Log Entry] l

LEFT JOIN [ZYGO$Sales Header] h ON l.[Primary Key Field 2 Value] = h.No_

INNER JOIN [ZYGO$Sales Line] sl ON h.No_ = sl.[Document No_]

WHERE [Table No_] = 36

AND [Field No_] IN (51,50018,73)

AND LEN([New Value]) = 0

AND [Date and Time] &gt;= GETDATE() - 1

AND [Outstanding Quantity] &gt; 0

AND sl.[Planned Shipment Date] &lt; (GETDATE() + 21)




ORDER BY [Date and Time] DESC</CommandText>
        <rd:UseGenericDesigner>true</rd:UseGenericDesigner>
      </Query>
      <Fields>
        <Field Name="Date_and_Time">
          <DataField>Date and Time</DataField>
          <rd:TypeName>System.DateTime</rd:TypeName>
        </Field>
        <Field Name="User_ID">
          <DataField>User ID</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Field">
          <DataField>Field</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Old_Value">
          <DataField>Old Value</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="New_Value">
          <DataField>New Value</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Customer_No_">
          <DataField>Customer No.</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Name">
          <DataField>Name</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Sales_Order">
          <DataField>Sales Order</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Planned_Shipment_Date">
          <DataField>Planned Shipment Date</DataField>
          <rd:TypeName>System.DateTime</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
  </DataSets>
