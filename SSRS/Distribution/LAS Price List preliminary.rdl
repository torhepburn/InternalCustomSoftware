<?xml version="1.0" encoding="utf-8"?>
<Report MustUnderstand="df" xmlns="http://schemas.microsoft.com/sqlserver/reporting/2016/01/reportdefinition" xmlns:rd="http://schemas.microsoft.com/SQLServer/reporting/reportdesigner" xmlns:df="http://schemas.microsoft.com/sqlserver/reporting/2016/01/reportdefinition/defaultfontfamily">
  <df:DefaultFontFamily>Segoe UI</df:DefaultFontFamily>
  <AutoRefresh>0</AutoRefresh>
  <DataSources>
    <DataSource Name="DataSource1">
      <ConnectionProperties>
        <DataProvider>SQL</DataProvider>
        <ConnectString>Data Source=pa-hor-as408;Initial Catalog=ZYGO-NAV-PROD</ConnectString>
      </ConnectionProperties>
      <rd:SecurityType>DataBase</rd:SecurityType>
      <rd:DataSourceID>c0fa2849-79e0-4580-8a27-484452836a7f</rd:DataSourceID>
    </DataSource>
  </DataSources>
  <DataSets>
    <DataSet Name="DataSet1">
      <Query>
        <DataSourceName>DataSource1</DataSourceName>
        <CommandText>with s1 AS
(
	SELECT
	[Item No_]
	,[Unit Price]
	FROM [ZYGO$Sales Price]
	WHERE
	[Sales Code] IN ('ZAF')
	AND ([Ending Date] &gt;= GETDATE() OR [Ending Date] IS NULL)
	AND [Starting Date] &lt;= GETDATE()
)

select 

sp1.[Sales Code]
,[Price List ID] [Folder]
,i.No_ [Item Number]
,i.[Price List Code]
,[Price List Description]
,COALESCE(CAST(s1.[Unit Price] as int),0) [ZAF Price]  
,CAST(sp1.[Unit Price] as int) [Unit Price]
,CASE LEFT(i.[Global Dimension 2 Code],3) 
	WHEN 'LAS' THEN 'Large Aperture Systems'
	WHEN 'OPT' THEN 'Optical Profilers'
	WHEN 'PPS' THEN 'Motion Measurement Products'
	ELSE i.[Global Dimension 2 Code]
END Segment

FROM [ZYGO$Item] i

INNER JOIN [ZYGO$Sales Price] sp1 on sp1.[Item No_] = i.No_

left JOIN s1 on s1.[Item No_] = i.No_

INNER JOIN [ZYGO$Customer Price Group] p ON sp1.[Sales Code] = p.Code

INNER JOIN [ZYGO$Price List Data] d ON i.[Price List Code] = d.[Price List Code]

where 1=1

AND LEN(i.[Price List Code]) &gt; 0

AND sp1.[Sales Code] IN ('DOM', 'EXP', 'INT')

AND (sp1.[Ending Date] &gt;= GETDATE() OR sp1.[Ending Date] IS NULL)

AND sp1.[Starting Date] &lt;= GETDATE()

AND  LEFT(i.[Global Dimension 2 Code],3)  = 'LAS'





ORDER BY sp1.[Sales Code], i.[Price List Code], No_</CommandText>
        <rd:UseGenericDesigner>true</rd:UseGenericDesigner>
      </Query>
      <Fields>
        <Field Name="Sales_Code">
          <DataField>Sales Code</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Folder">
          <DataField>Folder</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
        <Field Name="Item_Number">
          <DataField>Item Number</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Price_List_Code">
          <DataField>Price List Code</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Price_List_Description">
          <DataField>Price List Description</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="ZAF_Price">
          <DataField>ZAF Price</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
        <Field Name="Unit_Price">
          <DataField>Unit Price</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
        <Field Name="Segment">
          <DataField>Segment</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
  </DataSets>
