<?xml version="1.0" encoding="utf-8"?>
<Report MustUnderstand="df" xmlns="http://schemas.microsoft.com/sqlserver/reporting/2016/01/reportdefinition" xmlns:rd="http://schemas.microsoft.com/SQLServer/reporting/reportdesigner" xmlns:df="http://schemas.microsoft.com/sqlserver/reporting/2016/01/reportdefinition/defaultfontfamily">
  <df:DefaultFontFamily>Segoe UI</df:DefaultFontFamily>
  <AutoRefresh>0</AutoRefresh>
  <DataSources>
    <DataSource Name="DataSource1">
      <ConnectionProperties>
        <DataProvider>SQL</DataProvider>
        <ConnectString>Data Source=MIDDB01.zygo.com;Initial Catalog=Dashboard</ConnectString>
      </ConnectionProperties>
      <rd:SecurityType>DataBase</rd:SecurityType>
      <rd:DataSourceID>906fea81-cdbe-4b99-ab61-f8e7f4cbeb41</rd:DataSourceID>
    </DataSource>
  </DataSources>
  <DataSets>
    <DataSet Name="DataSet1">
      <Query>
        <DataSourceName>DataSource1</DataSourceName>
        <CommandText>SELECT 

r.Name
,COALESCE(c.timein,'2000-01-01') TimeIn
,COALESCE(c.timeout,'2000-01-01') TimeOut
, c.LogicalDay
, h.OrderNo
, h.[LineNo]
, h.Operation
, h.Item
, h.ItemDescription
, COALESCE(h.Job,'') Job
, COALESCE(h.JobDescription,'') JobDescription
, h.WorkCenter
, h.WorkCenterDescription
, h.CostCenter
, h.CostCenterDescription
, COALESCE(h.StartTime,'1900-01-01') StartTime
, COALESCE(h.EndTime,'1900-01-01') EndTime
, h.Complete
, h.ApportionTime

FROM  TimecardNAVProdHours h

LEFT OUTER JOIN TimeCard c ON h.TimecardNumber = c.TimeCardNumber 

LEFT OUTER JOIN Requisitioner r ON h.UserID = r.ID

WHERE (h.ApportionTime &lt;&gt; 0)

AND LogicalDay = CAST((GETDATE()-1) as date)

AND h.CostCenter = 5070

ORDER BY LogicalDay, TimeIn</CommandText>
        <rd:UseGenericDesigner>true</rd:UseGenericDesigner>
      </Query>
      <Fields>
