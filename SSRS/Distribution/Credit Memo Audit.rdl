  <DataSets>
    <DataSet Name="DataSet1">
      <Query>
        <DataSourceName>DataSource1</DataSourceName>
        <CommandText>SELECT

No_
,[Posting Date]
,[Applies-to Doc_ No_]
,[Your Reference]
,[User ID]
,[Posting Description]


FROM [ZYGO$Sales Cr_Memo Header] sch   WHERE  [Posting Date] &gt;= '2021-01-01'

ORDER BY No_, [Posting Date]</CommandText>
        <rd:UseGenericDesigner>true</rd:UseGenericDesigner>
      </Query>
