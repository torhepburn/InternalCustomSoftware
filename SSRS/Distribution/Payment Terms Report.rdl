<?xml version="1.0" encoding="utf-8"?>
<Report MustUnderstand="df" xmlns="http://schemas.microsoft.com/sqlserver/reporting/2016/01/reportdefinition" xmlns:rd="http://schemas.microsoft.com/SQLServer/reporting/reportdesigner" xmlns:df="http://schemas.microsoft.com/sqlserver/reporting/2016/01/reportdefinition/defaultfontfamily">
  <df:DefaultFontFamily>Segoe UI</df:DefaultFontFamily>
  <AutoRefresh>0</AutoRefresh>
  <DataSources>
    <DataSource Name="NAV">
      <DataSourceReference>NAV</DataSourceReference>
      <rd:SecurityType>None</rd:SecurityType>
      <rd:DataSourceID>ff5f0661-2b5e-42ff-82b6-29a95d04318a</rd:DataSourceID>
    </DataSource>
  </DataSources>
  <DataSets>
    <DataSet Name="DataSet1">
      <Query>
        <DataSourceName>NAV</DataSourceName>
        <CommandText>WITH s1 AS
(
select

 [Document No_] Order_No
,[SO Line No_]
,h.[Sell-to Customer Name]
,h.[End User Customer Name]
,h.[External Document No_]
,l.[Shortcut Dimension 2 Code]
,COALESCE(dseg.[Dimension Value Code],'') SEGMENT
,COALESCE(dreg.[Dimension Value Code],'') REGION
,COALESCE(dind.[Dimension Value Code],'') INDUSTRY
,l.No_ AS Item_No
,l.[Job No_]
,l.Description
,CASE 
	WHEN CAST(FORMAT(l.[Planned Delivery Date], 'MM/dd/yy') as varchar(8)) = '01/01/53' THEN ''
	ELSE CAST(FORMAT(l.[Planned Delivery Date], 'MM/dd/yy') as varchar(8))
END [Planned Delivery Date]
,CASE 
	WHEN CAST(FORMAT(l.[Promised Delivery Date], 'MM/dd/yy') as varchar(8)) = '01/01/53' THEN ''
	ELSE CAST(FORMAT(l.[Promised Delivery Date], 'MM/dd/yy') as varchar(8))
END [Promised Delivery Date]
,[Outstanding Quantity]
,COALESCE(CASE l.No_
	WHEN 'DISCOUNT' THEN Amount * -1
	WHEN 'FREIGHT' THEN Amount
	WHEN 'FREIGHT INT''L' THEN Amount
END,0) Costs
,l.[Amount Including VAT] - l.Amount [Tax]
,CASE l.No_
	WHEN 'DISCOUNT' THEN 0
	WHEN 'FREIGHT' THEN 0
	WHEN 'FREIGHT INT''L' THEN 0
	ELSE l.Amount
END Goods
,l.[Amount Including VAT] [Total USD]
,t.Description PaymentTerms


from [ZYGO$Sales Header] h

INNER JOIN [ZYGO$Sales Line] l ON h.No_ = l.[Document No_] and h.[Document Type] = l.[Document Type]

left join	[ZYGO$Dimension Set Entry] dseg on l.[Dimension Set ID] = dseg.[Dimension Set ID] and dseg.[Dimension Code] = 'SEGMENT'
left join	[ZYGO$Dimension Set Entry] dind on l.[Dimension Set ID] = dind.[Dimension Set ID] and dind.[Dimension Code] = 'INDUSTRY'
left join	[ZYGO$Dimension Set Entry] dreg on l.[Dimension Set ID] = dreg.[Dimension Set ID] and dreg.[Dimension Code] = 'REGION'
LEFT JOIN   [ZYGO$Payment Terms] t ON h.[Payment Terms Code] = t.Code

--LEFT JOIN ZYGO$Customer c ON h.[Sell-to Customer No_] = c.No_

WHERE [Outstanding Quantity] &lt;&gt; 0

AND h.[Document Type] = 1

UNION ALL

select

 h.No_ Order_No
,[Line No_] [SO Line No_]
,h.[Name]
,h.[End User Customer Name]
,h.[Your Reference] [External Document No_]
,l.[Shortcut Dimension 2 Code]
,COALESCE(dseg.[Dimension Value Code],'') SEGMENT
,COALESCE(dreg.[Dimension Value Code],'') REGION
,COALESCE(dind.[Dimension Value Code],'') INDUSTRY
,l.No_ AS Item_No
,l.[Job No_]
,l.Description
,CASE 
	WHEN CAST(FORMAT(l.[Planned Delivery Date], 'MM/dd/yy') as varchar(8)) = '01/01/53' THEN ''
	ELSE CAST(FORMAT(l.[Planned Delivery Date], 'MM/dd/yy') as varchar(8))
END [Planned Delivery Date]
,CASE 
	WHEN CAST(FORMAT(l.[Promised Delivery Date], 'MM/dd/yy') as varchar(8)) = '01/01/53' THEN ''
	ELSE CAST(FORMAT(l.[Promised Delivery Date], 'MM/dd/yy') as varchar(8))
END [Promised Delivery Date]
,[Outstanding Quantity]
,COALESCE(CASE l.No_
	WHEN 'DISCOUNT' THEN l.Amount * -1
	WHEN 'FREIGHT' THEN l.Amount
	WHEN 'FREIGHT INT''L' THEN l.Amount
END,0) Costs
,l.[Amount Including VAT] - l.Amount [Tax]
,CASE l.No_
	WHEN 'DISCOUNT' THEN 0
	WHEN 'FREIGHT' THEN 0
	WHEN 'FREIGHT INT''L' THEN 0
	ELSE l.Amount
END Goods
,l.[Amount Including VAT] [Total USD]
,t.Description PaymentTerms

from [ZYGO$Service Header] h

INNER JOIN [ZYGO$Service Line] l ON h.No_ = l.[Document No_] and h.[Document Type] = l.[Document Type]

left join	[ZYGO$Dimension Set Entry] dseg on l.[Dimension Set ID] = dseg.[Dimension Set ID] and dseg.[Dimension Code] = 'SEGMENT'
left join	[ZYGO$Dimension Set Entry] dind on l.[Dimension Set ID] = dind.[Dimension Set ID] and dind.[Dimension Code] = 'INDUSTRY'
left join	[ZYGO$Dimension Set Entry] dreg on l.[Dimension Set ID] = dreg.[Dimension Set ID] and dreg.[Dimension Code] = 'REGION'
LEFT JOIN   [ZYGO$Payment Terms] t ON h.[Payment Terms Code] = t.Code

WHERE [Outstanding Quantity] &lt;&gt; 0

AND h.[Document Type] = 1
)

select 

s1. *

from s1

WHERE

(PaymentTerms like '%ON ORDER%' OR 

PaymentTerms like '%DOWN%' OR

PaymentTerms like '%WITH PO%')

AND REGION IN ('USE', 'USW')

--AND Order_No = '10115'

ORDER BY 

Order_No
,[SO Line No_]</CommandText>
        <rd:UseGenericDesigner>true</rd:UseGenericDesigner>
      </Query>
      <Fields>
        <Field Name="Order_No">
          <DataField>Order_No</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="SO_Line_No_">
          <DataField>SO Line No_</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
        <Field Name="Sell_to_Customer_Name">
          <DataField>Sell-to Customer Name</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="End_User_Customer_Name">
          <DataField>End User Customer Name</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="External_Document_No_">
          <DataField>External Document No_</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Shortcut_Dimension_2_Code">
          <DataField>Shortcut Dimension 2 Code</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="SEGMENT">
          <DataField>SEGMENT</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="REGION">
          <DataField>REGION</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="INDUSTRY">
          <DataField>INDUSTRY</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Item_No">
          <DataField>Item_No</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Job_No_">
          <DataField>Job No_</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Description">
          <DataField>Description</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Planned_Delivery_Date">
          <DataField>Planned Delivery Date</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Promised_Delivery_Date">
          <DataField>Promised Delivery Date</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Outstanding_Quantity">
          <DataField>Outstanding Quantity</DataField>
          <rd:TypeName>System.Decimal</rd:TypeName>
        </Field>
        <Field Name="Costs">
          <DataField>Costs</DataField>
          <rd:TypeName>System.Decimal</rd:TypeName>
        </Field>
        <Field Name="Tax">
          <DataField>Tax</DataField>
          <rd:TypeName>System.Decimal</rd:TypeName>
        </Field>
        <Field Name="Goods">
          <DataField>Goods</DataField>
          <rd:TypeName>System.Decimal</rd:TypeName>
        </Field>
        <Field Name="Total_USD">
          <DataField>Total USD</DataField>
          <rd:TypeName>System.Decimal</rd:TypeName>
        </Field>
        <Field Name="PaymentTerms">
          <DataField>PaymentTerms</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
  </DataSets>
