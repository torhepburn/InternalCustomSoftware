<?xml version="1.0" encoding="utf-8"?>
<Report MustUnderstand="df" xmlns="http://schemas.microsoft.com/sqlserver/reporting/2016/01/reportdefinition" xmlns:rd="http://schemas.microsoft.com/SQLServer/reporting/reportdesigner" xmlns:df="http://schemas.microsoft.com/sqlserver/reporting/2016/01/reportdefinition/defaultfontfamily">
  <df:DefaultFontFamily>Segoe UI</df:DefaultFontFamily>
  <AutoRefresh>0</AutoRefresh>
  <DataSources>
    <DataSource Name="NAV">
      <DataSourceReference>NAV</DataSourceReference>
      <rd:SecurityType>None</rd:SecurityType>
      <rd:DataSourceID>72162f81-3015-4ad5-b858-7a8bac2ae2c0</rd:DataSourceID>
    </DataSource>
  </DataSources>
  <DataSets>
    <DataSet Name="DataSet1">
      <Query>
        <DataSourceName>NAV</DataSourceName>
        <CommandText>/*
select 

[Document No_]
,[Shipment Date]
--,[SO Line No_]
--,No_
--,Quantity
--,[Outstanding Quantity]
,SUM(Amount)

FROM [ZYGO$Sales Line] 

WHERE 1=1

AND [Document No_] = '8738'


GROUP BY [Document No_], [Shipment Date];
*/
WITH s1 AS
(
	SELECT

	[Document No_]

	FROM [ZYGO$Sales Line]

	WHERE No_ NOT LIKE 'FREIGHT%'
	
/*	AND
	
	 [Document No_] IN*
	(SELECT [Document No_] FROM [ZYGO$Sales Line]

		WHERE [Outstanding Quantity] &gt; 0)
	
	*/
	GROUP BY [Document No_]

	HAVING COUNT([Document No_]) &gt; 0

	--AND No_ NOT LIKE 'FREIGHT%'

	--order by [Document No_]
)
SELECT

sl.[Document Type]
,sl.[Document No_]
,c.Name [Sell-to Custmer]
,cc.Name [Bill-to Customer]
,sh.[Order Date]
,sl.[Shipment Date]
,sl.[Requested Delivery Date]
,sh.[External Document No_]
,sh.[Sell-to Country_Region Code] [Region]
,sh.[Job No_]
,t.Description [Payment Terms Description]
,sh.[Shipment Method Code]
,sl.No_ [Item No.]
,sl.Description [Item Description]
,sl.Quantity
,sl.[Outstanding Quantity]
,sl.[Unit of Measure]
,sl.[Line Amount]



FROM [ZYGO$Sales Line] sl

INNER JOIN ZYGO$Customer c ON sl.[Sell-to Customer No_] = c.No_

INNER JOIN [ZYGO$Sales Header] sh ON sh.No_ = sl.[Document No_]

INNER JOIN ZYGO$Customer cc ON sh.[Bill-to Customer No_] = cc.No_

LEFT JOIN [ZYGO$Payment Terms] t ON sh.[Payment Terms Code] = t.Code

INNER JOIN s1 ON sh.No_ = s1.[Document No_]

WHERE 1=1

AND sl.No_ NOT LIKE 'FREIGHT%'

--AND sl.[Document No_] = 'Z3228'
AND [Outstanding Quantity] &gt; 0

ORDER BY [Document No_], [Shipment Date]


</CommandText>
        <rd:UseGenericDesigner>true</rd:UseGenericDesigner>
      </Query>
      <Fields>
