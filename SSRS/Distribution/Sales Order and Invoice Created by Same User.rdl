<?xml version="1.0" encoding="utf-8"?>
<Report MustUnderstand="df" xmlns="http://schemas.microsoft.com/sqlserver/reporting/2016/01/reportdefinition" xmlns:rd="http://schemas.microsoft.com/SQLServer/reporting/reportdesigner" xmlns:df="http://schemas.microsoft.com/sqlserver/reporting/2016/01/reportdefinition/defaultfontfamily">
  <df:DefaultFontFamily>Segoe UI</df:DefaultFontFamily>
  <AutoRefresh>0</AutoRefresh>
  <DataSources>
    <DataSource Name="DataSource1">
      <ConnectionProperties>
        <DataProvider>SQL</DataProvider>
        <ConnectString>Data Source=pa-hor-as408;Initial Catalog=ZYGO-NAV-PROD</ConnectString>
      </ConnectionProperties>
      <rd:SecurityType>DataBase</rd:SecurityType>
      <rd:DataSourceID>a178be7c-3c16-47b4-be03-3b76c8f0f562</rd:DataSourceID>
    </DataSource>
  </DataSources>
  <DataSets>
    <DataSet Name="DataSet1">
      <Query>
        <DataSourceName>DataSource1</DataSourceName>
        <CommandText>WITH s1 AS
(
SELECT

h.No_ [Document No_]
, [SO Line No_]
,h.[Order Date]
,h.[Assigned User ID]
,CASE h.[Document Type]
	WHEN 1 THEN 'Order'
	WHEN 4 THEN 'Blanket Order'
	WHEN 5 THEN 'Return Order'
END [Document Type]
,CASE l.[Type]
	WHEN 1 THEN 'G/L Account'
	WHEN 2 THEN 'Item'
	WHEN 3 THEN 'Resource'
	WHEN 4 THEN 'Fixed Asset'
	WHEN 5 THEN 'Charge(Item)'
END [Line Type]
,l.No_ [Item No]


FROM [ZYGO$Sales Header] h

INNER JOIN [ZYGO$Sales Line] l ON h.No_ = l.[Document No_]

WHERE h.[Order Date] &gt;= '2021-01-01'

AND h.[Document Type] IN (1,4,5)

AND l.[Type] IN (2,5)
)

	SELECT

	sih.No_ [Sales Invoice No]
	,sih.[Posting Date] [Invoice Date]
	,sih.[User ID] [Inovice Creator matching Order Creator]
	,s1.[Order Date] [Sales Order Date]
	,[Order No_] [Sales Order No]
	,[Assigned User ID] [Sales Order Creator]
	,s1.[SO Line No_]
	, s1.[Item No]

	FROM [ZYGO$Sales Invoice Header] sih

	INNER JOIN s1 ON s1.[Document No_] = sih.[Order No_]  AND s1.[Assigned User ID] = sih.[User ID]
</CommandText>
        <rd:UseGenericDesigner>true</rd:UseGenericDesigner>
      </Query>
      <Fields>
        <Field Name="Sales_Invoice_No">
          <DataField>Sales Invoice No</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Invoice_Date">
          <DataField>Invoice Date</DataField>
          <rd:TypeName>System.DateTime</rd:TypeName>
        </Field>
        <Field Name="Inovice_Creator_matching_Order_Creator">
          <DataField>Inovice Creator matching Order Creator</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Sales_Order_No">
          <DataField>Sales Order No</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Sales_Order_Date">
          <DataField>Sales Order Date</DataField>
          <rd:TypeName>System.DateTime</rd:TypeName>
        </Field>
        <Field Name="Sales_Order_Creator">
          <DataField>Sales Order Creator</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="SO_Line_No_">
          <DataField>SO Line No_</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
        <Field Name="Item_No">
          <DataField>Item No</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
  </DataSets>
