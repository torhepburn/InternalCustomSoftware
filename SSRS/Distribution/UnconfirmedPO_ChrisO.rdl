<?xml version="1.0" encoding="utf-8"?>
<Report MustUnderstand="df" xmlns="http://schemas.microsoft.com/sqlserver/reporting/2016/01/reportdefinition" xmlns:rd="http://schemas.microsoft.com/SQLServer/reporting/reportdesigner" xmlns:df="http://schemas.microsoft.com/sqlserver/reporting/2016/01/reportdefinition/defaultfontfamily">
  <df:DefaultFontFamily>Segoe UI</df:DefaultFontFamily>
  <AutoRefresh>0</AutoRefresh>
  <DataSources>
    <DataSource Name="NAV">
      <DataSourceReference>NAV</DataSourceReference>
      <rd:SecurityType>None</rd:SecurityType>
      <rd:DataSourceID>a9a9b0c6-1f39-4399-9a8e-05ef27789ba8</rd:DataSourceID>
    </DataSource>
  </DataSources>
  <DataSets>
    <DataSet Name="DataSet1">
      <Query>
        <DataSourceName>NAV</DataSourceName>
        <CommandText>
select

l.[Buy-from Vendor No_] [Vendor No]
,v.Name [Vendor]
,h.No_ [Order]
,[PO Line No_]
,l.No_ [Item]
,l.Description
,l.Quantity [Order Qty]
,l.[Quantity Received]
,l.[Outstanding Quantity]
,l.Amount
,h.[Order Date] [Document Date]
,l.[Requested Receipt Date]
,l.[Promised Receipt Date]
,l.[Planned Receipt Date]
,CASE
	WHEN [Planned Receipt Date] &lt; GETDATE() THEN 'LATE'
	ELSE ''
END [LATE]
,l.[Location Code]
,h.[Deliver To]
,[FAST No_]
,[RMA No_]



FROM [ZYGO$Purchase Line] l

INNER JOIN [ZYGO$Purchase Header] h on h.No_ = l.[Document No_]

INNER JOIN ZYGO$Vendor v ON h.[Buy-from Vendor No_] = v.No_

WHERE l.[Promised Receipt Date] = '01-01-1753'

AND l.[Outstanding Quantity] != 0

AND h.[Document Type] = 1

AND h.[Purchaser Code] = 'CHRIS O'

ORDER BY 

v.[Name] 
,h.No_
,l.[PO Line No_]</CommandText>
        <rd:UseGenericDesigner>true</rd:UseGenericDesigner>
      </Query>
