<?xml version="1.0" encoding="utf-8"?>
<Report MustUnderstand="df" xmlns="http://schemas.microsoft.com/sqlserver/reporting/2016/01/reportdefinition" xmlns:rd="http://schemas.microsoft.com/SQLServer/reporting/reportdesigner" xmlns:df="http://schemas.microsoft.com/sqlserver/reporting/2016/01/reportdefinition/defaultfontfamily">
  <df:DefaultFontFamily>Segoe UI</df:DefaultFontFamily>
  <AutoRefresh>0</AutoRefresh>
  <DataSources>
    <DataSource Name="DataSource1">
      <ConnectionProperties>
        <DataProvider>SQL</DataProvider>
        <ConnectString>Data Source=CT-MID-SQL11;Initial Catalog=DemoLab</ConnectString>
      </ConnectionProperties>
      <rd:SecurityType>DataBase</rd:SecurityType>
      <rd:DataSourceID>ad41c172-ad42-45cc-919c-65fb8204642c</rd:DataSourceID>
    </DataSource>
  </DataSources>
  <DataSets>
    <DataSet Name="DataSet1">
      <Query>
        <DataSourceName>DataSource1</DataSourceName>
        <CommandText>/****** Script for SelectTopNRows command from SSMS  ******/
With s1 AS
(
	SELECT 

	MAX(uid) mUID
	--,LEFT(ItemLabel, 6) Item

	FROM ItemLog GROUP BY LEFT(ItemLabel, 6)
)

SELECT [uID]
      ,[ItemLabel]
      ,[Employee]
	  ,COALESCE(e.Name,'') Name
      ,[Date]
      ,[Comments]
      ,[InOut]
      ,COALESCE([Location],'') Location
  FROM [DemoLab].[dbo].[ItemLog] l

  INNER JOIN s1 ON l.uid = s1.mUID

  LEFT JOIN s_View_Employees e ON l.Employee = e.BadgeID

  order by LEFT(ItemLabel, 6)</CommandText>
        <rd:UseGenericDesigner>true</rd:UseGenericDesigner>
      </Query>
      <Fields>
        <Field Name="uID">
          <DataField>uID</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
        <Field Name="ItemLabel">
          <DataField>ItemLabel</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Employee">
          <DataField>Employee</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
        <Field Name="Name">
          <DataField>Name</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Date">
          <DataField>Date</DataField>
          <rd:TypeName>System.DateTime</rd:TypeName>
        </Field>
        <Field Name="Comments">
          <DataField>Comments</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="InOut">
          <DataField>InOut</DataField>
