<?xml version="1.0" encoding="utf-8"?>
<Report MustUnderstand="df" xmlns="http://schemas.microsoft.com/sqlserver/reporting/2016/01/reportdefinition" xmlns:rd="http://schemas.microsoft.com/SQLServer/reporting/reportdesigner" xmlns:df="http://schemas.microsoft.com/sqlserver/reporting/2016/01/reportdefinition/defaultfontfamily">
  <df:DefaultFontFamily>Segoe UI</df:DefaultFontFamily>
  <AutoRefresh>0</AutoRefresh>
  <DataSources>
    <DataSource Name="AFE">
      <DataSourceReference>AFE</DataSourceReference>
      <rd:SecurityType>None</rd:SecurityType>
      <rd:DataSourceID>5c9b0ca7-0df5-4a09-bd20-656d5f3201f0</rd:DataSourceID>
    </DataSource>
  </DataSources>
  <DataSets>
    <DataSet Name="DataSet1">
      <Query>
        <DataSourceName>AFE</DataSourceName>
        <CommandText>SELECT [ORDER_NO]
      ,[OPERATION]
      ,[TASK]
      ,o.[WORK_CENTER]
	  ,w.DESCRIPTION WORK_CENTER_DESCRIPTION
      ,[MACHINE]
      ,[PRODUCTION_DATE]
      ,[PRODUCTION_TIME]
      ,[SPENT_PRODUCTION_TIME]
      ,[PLANNED_QUANTITY]
      ,COALESCE(s.Name,'') [SUBSUPPLIER]
      ,[SUBCONTRACTING_RATE_FACTOR]
      ,[ITEM_CODE]
      ,[OPERATION_ROUTE]
      
  FROM [AccessFrontEnds].[dbo].[MMX_PRODUCTION_PLANNING_BY_ORDER] o

  LEFT JOIN MMX_WORK_CENTERS w ON o.WORK_CENTER = w.WORK_CENTER

  LEFT JOIN MMX_SUPPLIERS s ON o.SUBSUPPLIER = s.SUPPLIER

ORDER BY PRODUCTION_DATE</CommandText>
        <rd:UseGenericDesigner>true</rd:UseGenericDesigner>
      </Query>
      <Fields>
        <Field Name="ORDER_NO">
          <DataField>ORDER_NO</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
