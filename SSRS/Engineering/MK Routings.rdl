    </DataSource>
  </DataSources>
  <DataSets>
    <DataSet Name="DataSet1">
      <Query>
        <DataSourceName>AFE</DataSourceName>
        <CommandText>SELECT [MANUFACTURED_ITEM]
      ,[OPERATION_ROUTE]
      ,[OPERATION]
      ,[TASK]
      ,[WORK_CENTER]
      ,[MACHINE]
      ,[SETUP_TIME]
      ,[RUN_TIME]
      ,[MAN_OCCUPATION]
      ,[MACHINE_OCCUPATION]
      
      ,[SUBCONTRACTING_RATE_FACTOR]
      ,COALESCE(t.TEXT,'') TEXT
      
  FROM [AccessFrontEnds].[dbo].[MMX_ROUTING] r

  LEFT JOIN MMX_ITEM_TEXT t ON CAST(r.TEXT as varchar(6)) = t.TEXTKEY

ORDER BY 

 [MANUFACTURED_ITEM]
     
      ,[OPERATION]</CommandText>
        <rd:UseGenericDesigner>true</rd:UseGenericDesigner>
      </Query>
      <Fields>
