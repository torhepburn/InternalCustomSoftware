<?xml version="1.0" encoding="utf-8"?>
<Report MustUnderstand="df" xmlns="http://schemas.microsoft.com/sqlserver/reporting/2016/01/reportdefinition" xmlns:rd="http://schemas.microsoft.com/SQLServer/reporting/reportdesigner" xmlns:df="http://schemas.microsoft.com/sqlserver/reporting/2016/01/reportdefinition/defaultfontfamily">
  <df:DefaultFontFamily>Segoe UI</df:DefaultFontFamily>
  <AutoRefresh>0</AutoRefresh>
  <DataSources>
    <DataSource Name="AFE">
      <DataSourceReference>AFE</DataSourceReference>
      <rd:SecurityType>None</rd:SecurityType>
      <rd:DataSourceID>0eb3656c-0064-43f8-9c3f-6dd98134b8fd</rd:DataSourceID>
    </DataSource>
  </DataSources>
  <DataSets>
    <DataSet Name="DataSet1">
      <Query>
        <DataSourceName>AFE</DataSourceName>
        <CommandText>/****** Script for SelectTopNRows command from SSMS  ******/
SELECT [ORDER_NO]
      ,p.[SUPPLIER]
	  ,s.NAME SUPPLIER_NAME
      ,[ORDER_TYPE]
      ,[ORIGIN]
      ,p.[TERMS_OF_PAYMENT]
      ,[ORDER_DATE]
      ,p.[ORDER_DISCOUNT]
      ,p.[CURRENCY]
      ,[EXCHANGE_RATE]
      ,p.[POSTAL_ADDRESS]
      ,[PURCHASING_CONTACT]
      ,p.[VAT]
      ,p.[LATE_PAYMENT_SURCHARGE]
      ,[FORWARDING_AGENT]
      ,[PRICE_LIST]
      ,p.[COUNTRY]
      ,p.[LANGUAGE]
      ,p.[TERMS_OF_DELIVERY]
      ,[DELIVERY_DATE]
      ,[CONFIRMED_DELIVERY_DATE]
      ,p.[LINE_OF_BUSINESS]
      ,p.[AREA]
      ,[REFERENCE_A]
      ,[REFERENCE_B]
      ,[PROJECT_CONTRACT]
           ,COALESCE(t.[TEXT],'') ORDER_HEADER_TEXT
      ,[VAT_CODE_NUMERIC]
      ,[REMITTANCE_AGREEMENT]
      ,[SCHEDULE_NUMBER]
      ,p.[TOLERANCE_CODE]
      ,[DELIVERY_ADDRESS_ORIGIN]
      ,[DEF_DELIVERY_ADDRESS]
      
  FROM [AccessFrontEnds].[dbo].[MMX_PURCHASE_ORDERS] p

  LEFT JOIN MMX_SUPPLIERS s ON p.SUPPLIER = s.SUPPLIER

  LEFT JOIN MMX_ITEM_TEXT t ON t.TEXTKEY = CAST(p.[ORDER_HEADER_TEXT] as varchar(6))
</CommandText>
        <rd:UseGenericDesigner>true</rd:UseGenericDesigner>
      </Query>
