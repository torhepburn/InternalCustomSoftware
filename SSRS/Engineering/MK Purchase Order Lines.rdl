  <DataSets>
    <DataSet Name="DataSet1">
      <Query>
        <DataSourceName>AFE</DataSourceName>
        <CommandText>SELECT [ORDER_NO]
      ,[POSITION]
      ,p.[SUPPLIER]
	  ,s.NAME SUPPLIER_NAME
      ,[ITEM_CODE]
      ,[ITEM_DESCRIPTION]
      ,[ORDER_POLICY]
      ,[STANDARD_DESCRIPTION]
      ,[PRICE]
      ,[PRICE_UNIT]
      ,[CONV_FCT_PRC_TO_STK_UNT]
      ,[ORDER_DATE]
      ,[DELIVERY_DATE]
      ,[DELIVERY_DATE_2]
      ,[DELIVERY_DATE_CONFIRMED]
      ,[QUANTITY]
      ,[PURCHASE_UNIT]
      ,[CONV_FCT_PURC_TO_STK_UNT]
      ,[LENGTH]
      ,[WIDTH]
      ,[THICKNESS]
      ,[DISCOUNT]
      ,[AMOUNT]
      ,[TOTAL_DELIVERED_QUANTITY]
      ,[TOTAL_BACKORDERED_QUANTITY]
      ,[VAT_CODE]
      ,[WAREHOUSE]
      ,[PROJECT]
      ,[PRODUCTION_ORDER]
      ,[OPERATION]
      ,[STK_POSTING_STATUS_PURC]
      ,p.[INSPECTION]
      ,[TOTAL_REJECTED_QUANTITY]
      ,[TOTAL_APPROVED_QUANTITY]
      ,[ORDER_LINE_TEXT]
      ,[CONTRACT]
      ,[POSITION_1]
      ,[SALES_ORDER]
      ,[SALES_ORDER_POSITION]
      ,[TAXABLE]
      ,[REVISION]
      ,[CHANGED_DELIVERY_DATE]
      ,[STRUCTURE_PART]
      ,[SETTLEMENT_ITEM]
      ,[COST_COMPONENT]
      ,[FINANCIAL_REASON]
      ,[LINE_TYPE]
      ,p.[TOLERANCE_CODE]
      ,[TAX_VAT_5]
      ,[PO_LINE_STATUS]
      ,[INSPECTION_CODE]
      ,[INSPECTION_CODE_DESC]
      ,[DELIVERY_ADDRESS_ORIGIN]
      ,[DELIVERY_ADDRESS]
      
  FROM [AccessFrontEnds].[dbo].[MMX_PURCHASE_ORDER_LINES] p

  LEFT JOIN MMX_SUPPLIERS s ON p.SUPPLIER = s.SUPPLIER</CommandText>
        <rd:UseGenericDesigner>true</rd:UseGenericDesigner>
      </Query>
