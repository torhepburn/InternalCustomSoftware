      <rd:DataSourceID>0c950cd2-4999-44d5-af97-56e417cbedd5</rd:DataSourceID>
    </DataSource>
  </DataSources>
  <DataSets>
    <DataSet Name="DataSet1">
      <Query>
        <DataSourceName>AFE</DataSourceName>
        <CommandText>SELECT [ORDER_NO]
      ,[ITEM_CODE]
      ,[OPERATION_ROUTE]
      ,[WAREHOUSE]
      ,[ORDER_QUANTITY]
      ,[QUANTITY_POSTED]
      ,[COST_PRICE]
      ,[MATERIAL_COSTS]
      ,[OPERATION_COSTS]
      ,[PRODUCTION_YEAR]
      ,[PRODUCTION_WEEK]
      ,[PRODUCTION_DAY]
      ,[DELIVERY_YEAR]
      ,[DELIVERY_WEEK]
      ,[DELIVERY_DAY]
      ,[PROJECT]
      ,[PRODUCTION_DATE]
      ,[DELIVERY_DATE]
      ,[PLANNED_DELIVERY_DATE]
      ,[TOTAL_SCRAPPED]
      ,[REWORK_PRODUCTION_ORDER]
      ,[FINANCIAL_REASON]
      ,[START_DATE]
      ,[ITEM_DESCRIPTION]
      ,COALESCE(e.NAME,'') PLANNER
      ,[ACTUAL_FINISH_DATE]
      ,[ACTUAL_RELEASE_DATE]
  FROM [AccessFrontEnds].[dbo].[MMX_PRODUCTION_ORDER_FILE] p

  LEFT JOIN MMX_EMPLOYEES e ON p.PLANNER_CODE = e.EMPLOYEE</CommandText>
        <rd:UseGenericDesigner>true</rd:UseGenericDesigner>
      </Query>
