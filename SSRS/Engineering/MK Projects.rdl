  <DataSources>
    <DataSource Name="AFE">
      <DataSourceReference>AFE</DataSourceReference>
      <rd:SecurityType>None</rd:SecurityType>
      <rd:DataSourceID>0a534773-d2a0-4e4a-a9ac-e77805a74eb7</rd:DataSourceID>
    </DataSource>
  </DataSources>
  <DataSets>
    <DataSet Name="DataSet1">
      <Query>
        <DataSourceName>AFE</DataSourceName>
        <CommandText>/****** Script for SelectTopNRows command from SSMS  ******/
SELECT [PROJECT]
      ,[DESCRIPTION]
      ,[DESCRIPTION_1]
      ,[DESCRIPTION_2]
      ,[DESCRIPTION_3]
      ,[REFERENCE]
      ,p.[SEARCH_KEY]
     ,e.NAME [PROJECT_MANAGER]
      ,[START_DATE]
      ,[DELIVERY_DATE]
      ,c.[NAME] [CUSTOMER]
      
      
  FROM [AccessFrontEnds].[dbo].[MMX_PROJECTS] p

  LEFT JOIN MMX_EMPLOYEES e ON p.PROJECT_MANAGER = e.EMPLOYEE

LEFT JOIN MMX_CUSTOMERS c ON p.CUSTOMER = c.CUSTOMER

  ORDER BY PROJECT</CommandText>
        <rd:UseGenericDesigner>true</rd:UseGenericDesigner>
      </Query>
      <Fields>
