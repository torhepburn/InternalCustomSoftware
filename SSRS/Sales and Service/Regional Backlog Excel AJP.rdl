          <DataField>Gen_ Prod_ Posting Group</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Item_Category_Code">
          <DataField>Item Category Code</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Shipment_No_">
          <DataField>Shipment No_</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Completely_Shipped">
          <DataField>Completely Shipped</DataField>
          <rd:TypeName>System.Byte</rd:TypeName>
        </Field>
