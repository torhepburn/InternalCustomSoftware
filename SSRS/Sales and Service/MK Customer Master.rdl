  <AutoRefresh>0</AutoRefresh>
  <DataSources>
    <DataSource Name="AFE">
      <DataSourceReference>AFE</DataSourceReference>
      <rd:SecurityType>None</rd:SecurityType>
      <rd:DataSourceID>65b6e676-e72e-4d2d-9092-daca0f106031</rd:DataSourceID>
    </DataSource>
  </DataSources>
  <DataSets>
    <DataSet Name="DataSet1">
      <Query>
        <DataSourceName>AFE</DataSourceName>
        <CommandText>/****** Script for SelectTopNRows command from SSMS  ******/
SELECT [CUSTOMER]
	  ,'' [POSTAL_ADDRESS]
	  ,'' [DELIVERY_ADDRESS]
      ,[NAME]
	  ,[NAME_2]
      ,[ADDRESS]
      ,[ADDRESS_2]
	  ,[CITY]
      ,[STATE]
      ,[ZIPCODE]
      ,[COUNTY]
      ,[POSTCODE]
      ,[AREA]
	  ,[COUNTRY]
	  ,[TELEPHONE]
      ,[TELEFAX]
      
      ,[ACCOUNTING_REFERENCE]
      ,[PURCHASING_REFERENCE]
      ,[SEARCH_KEY]
      ,b.[DESCRIPTION][LINE_OF_BUSINESS]
      ,[FORWARDING_AGENT]
      ,[TERMS_OF_PAYMENT]
      ,[TERMS_OF_DELIVERY]
      ,[CREDIT_LIMIT]
      ,[SELLING_PRICE_LIST]
      ,[FINANCIAL_CUSTOMER_GROUP]
      ,[SALES_AGENT_NUMBER]
      
      
  FROM [AccessFrontEnds].[dbo].[MMX_CUSTOMERS] c

  LEFT JOIN [MMX_LINES_OF_BUSINESS] b ON c.LINE_OF_BUSINESS = b.CODE

  UNION ALL

  SELECT
	   [CUSTOMER]
      ,[POSTAL_ADDRESS]
	  ,'' [DELIVERY_ADDRESS]
      ,[NAME]
      ,[NAME_2]
      ,[ADDRESS]
      ,[ADDRESS_2]
	  ,[CITY]
      ,[STATE]
      ,[ZIPCODE]
      ,[COUNTY]
      ,[POSTCODE]
	  ,'' [AREA]
      ,[COUNTRY]
	  ,'' [TELEPHONE]
	  ,'' [TELEFAX]
      
      ,'' [ACCOUNTING_REFERENCE]
      ,'' [PURCHASING_REFERENCE]
      ,'' [SEARCH_KEY]
      ,'' [LINE_OF_BUSINESS]
      ,'' [FORWARDING_AGENT]
      ,'' [TERMS_OF_PAYMENT]
      ,'' [TERMS_OF_DELIVERY]
      ,'' [CREDIT_LIMIT]
      ,'' [SELLING_PRICE_LIST]
      ,'' [FINANCIAL_CUSTOMER_GROUP]
      ,'' [SALES_AGENT_NUMBER]
  FROM [AccessFrontEnds].[dbo].[MMX_CUSTOMERS_POSTAL_ADDRESSES]

  UNION ALL

  SELECT 
       [CUSTOMER]
      ,''
	  ,[DELIVERY_ADDRESS]
      ,[NAME]
      ,[NAME_2]
      ,[ADDRESS]
      ,[ADDRESS_2]
      ,[CITY]
      ,[STATE]
      ,[ZIPCODE]
      ,[COUNTY]
	  ,[POSTCODE]
      ,''
	  ,[COUNTRY]
      ,''
      ,''
	  
	  ,''
	  ,''
	  ,''
	  ,''
	  ,''
      ,''
	  ,''
	  ,''
	  ,''
	  ,''
	  ,''

  FROM [AccessFrontEnds].[dbo].[MMX_DELIVERY_ADDRESSES]

  ORDER BY CUSTOMER, POSTAL_ADDRESS, DELIVERY_ADDRESS</CommandText>
        <rd:UseGenericDesigner>true</rd:UseGenericDesigner>
      </Query>
