<?xml version="1.0" encoding="utf-8"?>
<Report MustUnderstand="df" xmlns="http://schemas.microsoft.com/sqlserver/reporting/2016/01/reportdefinition" xmlns:rd="http://schemas.microsoft.com/SQLServer/reporting/reportdesigner" xmlns:df="http://schemas.microsoft.com/sqlserver/reporting/2016/01/reportdefinition/defaultfontfamily">
  <df:DefaultFontFamily>Segoe UI</df:DefaultFontFamily>
  <AutoRefresh>0</AutoRefresh>
  <DataSources>
    <DataSource Name="NAV">
      <DataSourceReference>NAV</DataSourceReference>
      <rd:SecurityType>None</rd:SecurityType>
      <rd:DataSourceID>22027227-78ac-4f19-b0bc-acd83679766b</rd:DataSourceID>
    </DataSource>
  </DataSources>
  <DataSets>
    <DataSet Name="DataSet1">
      <Query>
        <DataSourceName>NAV</DataSourceName>
        <QueryParameters>
          <QueryParameter Name="@sn">
            <Value>=Parameters!sn.Value</Value>
          </QueryParameter>
        </QueryParameters>
        <CommandText>--DECLARE @sn varchar(30)

--SET @sn = '17-28-80136'

select

si.No_ [Service Item]
,si.Description
,si.[Serial No_]
,sil.[Document No_]
,sil.[Warranty Starting Date (Parts)]
,sil.[Warranty Ending Date (Parts)]
,sil.[Warranty Starting Date (Labor)]
,sil.[Warranty Ending Date (Labor)]
,si.[Customer No_]
,si.[Ship-to Code]
,c.Name [Customer Name]

from [ZYGO$Service Item] si

LEFT JOIN [ZYGO$Service Item Line] sil ON si.[Serial No_] = sil.[Serial No_]

LEFT JOIN ZYGO$Customer c ON si.[Customer No_] = c.No_

where

sil.[Serial No_] = @sn

--[Service Item No_] = 'SV113043'

--select * from [ZYGO$Service Register] ORDER BY No_ DESC</CommandText>
        <rd:UseGenericDesigner>true</rd:UseGenericDesigner>
      </Query>
      <Fields>
        <Field Name="Service_Item">
          <DataField>Service Item</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Description">
          <DataField>Description</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Serial_No_">
          <DataField>Serial No_</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Document_No_">
          <DataField>Document No_</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Warranty_Starting_Date__Parts_">
          <DataField>Warranty Starting Date (Parts)</DataField>
          <rd:TypeName>System.DateTime</rd:TypeName>
        </Field>
        <Field Name="Warranty_Ending_Date__Parts_">
          <DataField>Warranty Ending Date (Parts)</DataField>
          <rd:TypeName>System.DateTime</rd:TypeName>
        </Field>
        <Field Name="Warranty_Starting_Date__Labor_">
