          <rd:TypeName>System.DateTime</rd:TypeName>
        </Field>
        <Field Name="Warranty_Ending_Date__Labor_">
          <DataField>Warranty Ending Date (Labor)</DataField>
          <rd:TypeName>System.DateTime</rd:TypeName>
        </Field>
        <Field Name="Customer_No_">
          <DataField>Customer No_</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Ship_to_Code">
          <DataField>Ship-to Code</DataField>
