<?xml version="1.0" encoding="utf-8"?>
<Report xmlns="http://schemas.microsoft.com/sqlserver/reporting/2016/01/reportdefinition" xmlns:rd="http://schemas.microsoft.com/SQLServer/reporting/reportdesigner" xmlns:df="http://schemas.microsoft.com/sqlserver/reporting/2016/01/reportdefinition/defaultfontfamily" MustUnderstand="df">
  <df:DefaultFontFamily>Segoe UI</df:DefaultFontFamily>
  <AutoRefresh>0</AutoRefresh>
  <DataSources>
    <DataSource Name="NAV">
      <DataSourceReference>NAV</DataSourceReference>
      <rd:SecurityType>None</rd:SecurityType>
      <rd:DataSourceID>9b78776b-9d00-42f2-9293-4e7668d4c799</rd:DataSourceID>
    </DataSource>
  </DataSources>
  <DataSets>
    <DataSet Name="DataSet1">
      <Query>
        <DataSourceName>NAV</DataSourceName>
        <CommandText>WITH s1 AS
(
	select

	[Item No_]
	,[Source ID]
	,[Source Ref_ No_]
	,[Serial No_]

	from [ZYGO$Tracking Specification]

	WHERE 

	[Source ID] + ' ' + CAST([Source Ref_ No_] as varchar)

	IN

	(

	select 

	[Document No_] + ' ' + CAST([Line No_] as varchar)

	from [ZYGO$Sales Line]

	WHERE 1=1

	-- AND [Document No_] = '11380'

	AND [Document No_] + ' ' + CAST([SO Line No_] as varchar)

	NOT IN

	(
	select

	ih.[Order No_] + ' ' + CAST(cl.[SO Line No_] as varchar)

	from [ZYGO$Sales Cr_Memo Line] cl

	INNER JOIN [ZYGO$Sales Cr_Memo Header] ch ON cl.[Document No_] = ch.No_

	INNER JOIN [ZYGO$Sales Invoice Header] ih ON ch.[Applies-to Doc_ No_] = ih.No_
	)
	)
)
,s2 AS
(
	SELECT 

	si.No_  [Service ID No_]
	,ssll.[Order No_]
	,ssll.[Order Line No_]

	FROM [ZYGO$Service Item] si

	LEFT JOIN [ZYGO$Sales Shipment Line] ssll ON si.[Sales_Serv_ Shpt_ Document No_]  = ssll.[Document No_]

	AND si.[Sales_Serv_ Shpt_ Line No_]  = ssll.[Line No_]

	WHERE si.[Sales_Serv_ Shpt_ Document No_] + ' ' + CAST(si.[Sales_Serv_ Shpt_ Line No_] as varchar) 

	IN

	(
	select 

	ssh.[No_] + ' ' + CAST([Line No_] as varchar)
	--,ssl.[SO Line No_]

	from [ZYGO$Sales Shipment Line] ssl

	INNER JOIN [ZYGO$Sales Shipment Header] ssh ON ssl.[Document No_] = ssh.[No_]

	WHERE ssl.[SO Line No_] &lt; 500

	AND ssl.[Order No_] = '11380'

	AND ssl.[Order No_] + ' ' +CAST([SO Line No_] as varchar)

	NOT IN

	(
	select

	ih.[Order No_] + ' ' + CAST(cl.[SO Line No_] as varchar)

	from [ZYGO$Sales Cr_Memo Line] cl

	INNER JOIN [ZYGO$Sales Cr_Memo Header] ch ON cl.[Document No_] = ch.No_

	INNER JOIN [ZYGO$Sales Invoice Header] ih ON ch.[Applies-to Doc_ No_] = ih.No_
	)
	)

)

select

--sh.[Bill-to Name] Customer
--,sh.[Ship-to Name] 
--,sh.[Ship-to Address]
--,sh.[Ship-to City] + ', ' + sh.[Ship-to County] + ', ' + sh.[Ship-to Country_Region Code] 'City-St-Na'
--,sh.[Shipping Agent Code] [Shipped Via]
--,sh.No_ [Sales Order #]
--,sh.[External Document No_] [Customer PO #]
sl.No_
,sl.Description
,sl.Quantity - sl.[Outstanding Quantity] [Quantity Delivered]
,sl.[Outstanding Quantity] [Quantity to Deliver]
,sl.[Shipment Date]
,sl.[Job No_]
,COALESCE(s1.[Serial No_],'') [Serial No_]
,COALESCE(s2.[Service ID No_],'') [Service ID No_]

--,sl.*

from [ZYGO$Sales Line] sl

LEFT JOIN s1 ON s1.[Item No_] = sl.No_  

AND s1.[Source ID] = sl.[Document No_] 

AND s1.[Source Ref_ No_] = sl.[Line No_]

LEFT JOIN s2 ON s2.[Order No_] = sl.[Document No_] AND s2.[Order Line No_] = sl.[Line No_]

INNER JOIN [ZYGO$Sales Header] sh ON sl.[Document No_] = sh.No_

where [SO Line No_] &lt; 500

AND sh.No_ = '11380'

AND [Document No_] + ' ' +CAST([SO Line No_] as varchar)

NOT IN

(
select

ih.[Order No_] + ' ' + CAST(cl.[SO Line No_] as varchar)

from [ZYGO$Sales Cr_Memo Line] cl

INNER JOIN [ZYGO$Sales Cr_Memo Header] ch ON cl.[Document No_] = ch.No_

INNER JOIN [ZYGO$Sales Invoice Header] ih ON ch.[Applies-to Doc_ No_] = ih.No_
)


--[SO Line No_]</CommandText>
        <rd:UseGenericDesigner>true</rd:UseGenericDesigner>
      </Query>
      <Fields>
        <Field Name="No_">
          <DataField>No_</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Description">
          <DataField>Description</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Quantity_Delivered">
          <DataField>Quantity Delivered</DataField>
          <rd:TypeName>System.Decimal</rd:TypeName>
        </Field>
        <Field Name="Quantity_to_Deliver">
          <DataField>Quantity to Deliver</DataField>
          <rd:TypeName>System.Decimal</rd:TypeName>
        </Field>
        <Field Name="Shipment_Date">
          <DataField>Shipment Date</DataField>
          <rd:TypeName>System.DateTime</rd:TypeName>
        </Field>
        <Field Name="Job_No_">
          <DataField>Job No_</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Serial_No_">
          <DataField>Serial No_</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Service_ID_No_">
          <DataField>Service ID No_</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
  </DataSets>
