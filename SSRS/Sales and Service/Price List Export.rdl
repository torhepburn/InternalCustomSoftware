  </DataSources>
  <DataSets>
    <DataSet Name="DataSet1">
      <Query>
        <DataSourceName>DataSource1</DataSourceName>
        <QueryParameters>
          <QueryParameter Name="@SalesCode">
            <Value>=Parameters!SalesCode.Value</Value>
          </QueryParameter>
        </QueryParameters>
        <CommandText>select 

[Price List Description]
,[Sales Code]
,[Item Number]
,Text
,[Price List Code]
,[Price List Description] itemclass
,Sales_Price_Group
,Price
,EffectiveDate

from FullPriceList

WHERE [Sales Code] = @SalesCode</CommandText>
        <rd:UseGenericDesigner>true</rd:UseGenericDesigner>
      </Query>
