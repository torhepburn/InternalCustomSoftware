          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
        <Field Name="QTY_TO_DLV">
          <DataField>QTY TO DLV</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
        <Field Name="Line_PRICE">
          <DataField>Line PRICE</DataField>
          <rd:TypeName>System.Decimal</rd:TypeName>
        </Field>
        <Field Name="Line_DISC">
          <DataField>Line DISC</DataField>
          <rd:TypeName>System.Decimal</rd:TypeName>
        </Field>
        <Field Name="SHIP_BL">
          <DataField>SHIP BL</DataField>
          <rd:TypeName>System.Decimal</rd:TypeName>
        </Field>
        <Field Name="ID_Line_Price___Std_Cost__Line_Price">
          <DataField>(Line Price - Std Cost)/Line Price</DataField>
          <rd:TypeName>System.Decimal</rd:TypeName>
        </Field>
        <Field Name="BL_ZCV">
          <DataField>BL ZCV</DataField>
          <rd:TypeName>System.Decimal</rd:TypeName>
        </Field>
        <Field Name="BL_std_cost">
          <DataField>BL std cost</DataField>
          <rd:TypeName>System.Decimal</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
