<?xml version="1.0" encoding="utf-8"?>
<Report MustUnderstand="df" xmlns="http://schemas.microsoft.com/sqlserver/reporting/2016/01/reportdefinition" xmlns:rd="http://schemas.microsoft.com/SQLServer/reporting/reportdesigner" xmlns:df="http://schemas.microsoft.com/sqlserver/reporting/2016/01/reportdefinition/defaultfontfamily">
  <df:DefaultFontFamily>Segoe UI</df:DefaultFontFamily>
  <AutoRefresh>0</AutoRefresh>
  <DataSources>
    <DataSource Name="AFE">
      <DataSourceReference>AFE</DataSourceReference>
      <rd:SecurityType>None</rd:SecurityType>
      <rd:DataSourceID>d316dd28-2204-4f14-9091-6de15891b3fd</rd:DataSourceID>
    </DataSource>
  </DataSources>
  <DataSets>
    <DataSet Name="DataSet1">
      <Query>
        <DataSourceName>AFE</DataSourceName>
        <QueryParameters>
          <QueryParameter Name="@CustomerPO">
            <Value>=Parameters!CustomerPO.Value</Value>
          </QueryParameter>
        </QueryParameters>
        <CommandText>SELECT h.[ORDER_NO]
      ,[POSITION]
      ,h.[CUSTOMER]
	  ,c.[NAME] CUSTOMER_NAME 
	  ,s.CUSTOMER_PO
      ,[ITEM_CODE]
      ,[STANDARD_DESCRIPTION]
      ,h.[ORDER_DATE]
      ,[PLANNED_DELIVERY_DATE]
      ,[ACTUAL_DELIVERY_DATE]
      ,[QUANTITY]
      ,[DISCOUNT]
      ,[AMOUNT]
      ,[WAREHOUSE]
      ,[PROJECT]
      ,[INVOICE_DATE]
      ,[INVOICE]
      ,t.[TEXT]
      ,[ITEM_DESCRIPTION]
      ,h.[DELIVERY_ADDRESS]
	  ,d.[NAME]
      ,d.[NAME_2]
      ,d.[ADDRESS]
      ,d.[ADDRESS_2]
	  ,d.[CITY]
      ,d.[STATE]
      ,d.[ZIPCODE]
      ,d.[COUNTY]
      ,d.[POSTCODE]
      ,d.[COUNTRY]
      ,d.[PROVINCE]
      
  FROM [AccessFrontEnds].[dbo].[MMX_SALES_ORDER_LINE_HISTORY] h

  LEFT JOIN MMX_CUSTOMERs c ON h.CUSTOMER = c.CUSTOMER

  LEFT JOIN MMX_DELIVERY_ADDRESSES d ON h.DELIVERY_ADDRESS = d.DELIVERY_ADDRESS AND h.CUSTOMER = d.CUSTOMER

  LEFT JOIN MMX_ITEM_TEXT t ON t.TEXTKEY = CAST(h.ORDER_LINE_TEXT as varchar(40))
    
  LEFT JOIN MMX_SALES_ORDERS s ON s.ORDER_NO = h.ORDER_NO

WHERE CUSTOMER_PO = @CustomerPO
  
  ORDER BY ORDER_NO, POSITION</CommandText>
        <rd:UseGenericDesigner>true</rd:UseGenericDesigner>
      </Query>
      <Fields>
