<?xml version="1.0" encoding="utf-8"?>
<Report MustUnderstand="df" xmlns="http://schemas.microsoft.com/sqlserver/reporting/2016/01/reportdefinition" xmlns:rd="http://schemas.microsoft.com/SQLServer/reporting/reportdesigner" xmlns:df="http://schemas.microsoft.com/sqlserver/reporting/2016/01/reportdefinition/defaultfontfamily">
  <df:DefaultFontFamily>Segoe UI</df:DefaultFontFamily>
  <AutoRefresh>0</AutoRefresh>
  <DataSources>
    <DataSource Name="DataSource1">
      <ConnectionProperties>
        <DataProvider>SQL</DataProvider>
        <ConnectString>Data Source=pa-hor-as408;Initial Catalog=ZYGO-NAV-PROD</ConnectString>
      </ConnectionProperties>
      <rd:SecurityType>DataBase</rd:SecurityType>
      <rd:DataSourceID>ec5d7fad-e6a2-4613-982c-2901ba7a907c</rd:DataSourceID>
    </DataSource>
  </DataSources>
  <DataSets>
    <DataSet Name="DataSet1">
      <Query>
        <DataSourceName>DataSource1</DataSourceName>
        <CommandText>select 

sp1.[Sales Code]
,i.No_ [Item Number]
,'12-31-2021' [Ending Date]

FROM [ZYGO$Item] i

INNER JOIN [ZYGO$Sales Price] sp1 on sp1.[Item No_] = i.No_

INNER JOIN [ZYGO$Customer Price Group] p ON sp1.[Sales Code] = p.Code

INNER JOIN [ZYGO$Price List Data] d ON i.[Price List Code] = d.[Price List Code]

where 1=1

AND LEN(i.[Price List Code]) &gt; 0

AND sp1.[Sales Code] IN ('DOM', 'EXP', 'INT', 'DIS', 'EUR', 'ZCV', 'ZIV','ZKK')

AND (sp1.[Ending Date] &gt;= GETDATE() OR sp1.[Ending Date] IS NULL)

AND sp1.[Starting Date] &lt;= GETDATE()

AND  LEFT(i.[Global Dimension 2 Code],3)  IN ('LAS', 'OPT', 'PPS')

AND [Item No_] IN

(
 '1520-500-128'	--OBS PARTS
,'1115-800-339'
,'1115-800-344'
,'1120-300-116'
,'1186-304-052'
,'1186-304-105'
,'1600-000-179'
,'1709-320-058'
,'6301-0273-01'
,'6450-0107-01'

)</CommandText>
        <rd:UseGenericDesigner>true</rd:UseGenericDesigner>
      </Query>
      <Fields>
        <Field Name="Sales_Code">
          <DataField>Sales Code</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Item_Number">
          <DataField>Item Number</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Ending_Date">
          <DataField>Ending Date</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
  </DataSets>
