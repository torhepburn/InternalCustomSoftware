<?xml version="1.0" encoding="utf-8"?>
<Report MustUnderstand="df" xmlns="http://schemas.microsoft.com/sqlserver/reporting/2016/01/reportdefinition" xmlns:rd="http://schemas.microsoft.com/SQLServer/reporting/reportdesigner" xmlns:df="http://schemas.microsoft.com/sqlserver/reporting/2016/01/reportdefinition/defaultfontfamily">
  <df:DefaultFontFamily>Segoe UI</df:DefaultFontFamily>
  <AutoRefresh>0</AutoRefresh>
  <DataSources>
    <DataSource Name="DataSource1">
      <ConnectionProperties>
        <DataProvider>SQL</DataProvider>
        <ConnectString>Data Source=pa-hor-as408;Initial Catalog=ZYGO-NAV-PROD</ConnectString>
      </ConnectionProperties>
      <rd:SecurityType>DataBase</rd:SecurityType>
      <rd:DataSourceID>43797f31-1d90-4db8-8fd2-0455a4742beb</rd:DataSourceID>
    </DataSource>
  </DataSources>
  <DataSets>
    <DataSet Name="DataSet1">
      <Query>
        <DataSourceName>DataSource1</DataSourceName>
        <CommandText>select 

[Sales Code]
,p.Description
,CASE LEFT(i.[Global Dimension 2 Code],3) 
	WHEN 'LAS' THEN 'Large Aperture Systems'
	WHEN 'OPT' THEN 'Optical Profilers'
	WHEN 'PPS' THEN 'Motion Measurement Products'
	ELSE i.[Global Dimension 2 Code]
END Segment
,i.No_ [Part Number]
,[Text]
,i.[Price List Code] Category
,[Price List Description] CategoryDescription
,[Price List ID]
,FORMAT(CAST(s.[Unit Price] as int),'C0') Price

FROM [ZYGO$Item] i

INNER JOIN [ZYGO$Sales Price] s on s.[Item No_] = i.No_

INNER JOIN [ZYGO$Customer Price Group] p ON s.[Sales Code] = p.Code

INNER JOIN [ZYGO$Price List Data] d ON i.[Price List Code] = d.[Price List Code]

LEFT JOIN [ZYGO$Text Module Line] t ON i.No_ = t.[Code 1]

where LEN(i.[Price List Code]) &gt; 0

AND [Sales Code] = 'DOM'

AND [Ending Date] &gt; GETDATE()

AND [Starting Date] &lt; GETDATE()

ORDER BY [Sales Code], i.[Price List Code], No_, [Line No_]</CommandText>
        <rd:UseGenericDesigner>true</rd:UseGenericDesigner>
      </Query>
      <Fields>
        <Field Name="Sales_Code">
          <DataField>Sales Code</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Description">
          <DataField>Description</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Segment">
          <DataField>Segment</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Part_Number">
          <DataField>Part Number</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Text">
          <DataField>Text</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Category">
          <DataField>Category</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="CategoryDescription">
          <DataField>CategoryDescription</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Price_List_ID">
          <DataField>Price List ID</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
        <Field Name="Price">
          <DataField>Price</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
  </DataSets>
