<?xml version="1.0" encoding="utf-8"?>
<Report MustUnderstand="df" xmlns="http://schemas.microsoft.com/sqlserver/reporting/2016/01/reportdefinition" xmlns:rd="http://schemas.microsoft.com/SQLServer/reporting/reportdesigner" xmlns:df="http://schemas.microsoft.com/sqlserver/reporting/2016/01/reportdefinition/defaultfontfamily">
  <df:DefaultFontFamily>Segoe UI</df:DefaultFontFamily>
  <AutoRefresh>0</AutoRefresh>
  <DataSources>
    <DataSource Name="AFE">
      <DataSourceReference>AFE</DataSourceReference>
      <rd:SecurityType>None</rd:SecurityType>
      <rd:DataSourceID>9a1543bc-9be8-45e8-b00b-48e1bd5ac2a4</rd:DataSourceID>
    </DataSource>
  </DataSources>
  <DataSets>
    <DataSet Name="DataSet1">
      <Query>
        <DataSourceName>AFE</DataSourceName>
        <CommandText>
WITH s1 AS
(
SELECT

SERIAL_NO PARENT_SERIAL_NO
,ITEM_CODE PARENT_ITEM_CODE
,EQUIPMENT_KEY PARENT_EQUIPMENT_KEY
,PARENT_EQUIP_KEY

FROM MMX_EQUIPMENT_MASTER  WHERE EQUIPMENT_KEY IN

(select [PARENT_EQUIP_KEY] from MMX_EQUIPMENT_MASTER

WHERE PARENT_EQUIP_KEY != 0)
)
,s2 AS
(
SELECT

SERIAL_NO PARENT_PARENT_SERIAL_NO
,ITEM_CODE PARENT_PARENT_ITEM_CODE
,EQUIPMENT_KEY PARENT_PARENT_EQUIPMENT_KEY
,PARENT_EQUIP_KEY

FROM MMX_EQUIPMENT_MASTER  WHERE EQUIPMENT_KEY IN
(
SELECT

PARENT_EQUIP_KEY

FROM s1

WHERE PARENT_EQUIP_KEY &gt; 0

))



SELECT 

	   [SERIAL_NO]
      ,m.[ITEM_CODE]
	  ,COALESCE(s1.PARENT_SERIAL_NO,'') PARENT_SERIAL_NO
	  ,COALESCE(s1.PARENT_ITEM_CODE,'') PARENT_ITEM_CODE
	  ,COALESCE(s2.PARENT_PARENT_SERIAL_NO,'') PARENT_PARENT_SERIAL_NO
	  ,COALESCE(s2.PARENT_PARENT_ITEM_CODE,'') PARENT_PARENT_ITEM_CODE
      ,m.[PROJECT]
      ,[PROJECT_ITEM_CODE]
	  ,[DESCRIPTION]
      ,m.[SEARCH_ARGUMENT]
      ,[SEARCH_ARGUMENT_2]
	  ,d.DELIVERY_DATE
	  ,[INSTALLATION_DATE]
      ,[EQUIPMENT_TYPE]
      ,[WARRANTY]
      ,[WARRANTY_START_DATE]
      ,[WARRANTY_EXPIRY_DATE]
      ,[SALES_ORDER]
      ,[EQUIPMENT_STATUS]
      ,m.[ITEM_DESCRIPTION]
	  ,s.[LOCATION] SITE_LOCATION
      ,s.[SEARCH_ARGUMENT] SITE_SEARCH_ARGUMENT
      ,s.[DELIVERY_ADDRESS]
      ,s.[NAME] CUSTOMER
      ,s.[NAME_2]
      ,s.[ADDRESS]
      ,s.[ADDRESS_2]
	  ,s.[CITY]
      ,s.[STATE]
      ,s.[ZIP_CODE]
 	  ,s.[COUNTRY]
      ,s.[TELEPHONE_NUMBER]
      ,s.[POSTAL_ADDRESS] POSTAL_ADDRESS_CODE
      ,s.[REGION]
      ,a.[NAME] POSTAL_NAME
      ,a.[NAME_2] POSTAL_NAME_2
      ,a.[ADDRESS] POSTAL_ADDRESS
      ,a.[ADDRESS_2] POSTAL_ADDRESS_2
	  ,a.[CITY] POSTAL_CITY
      ,a.[STATE] POSTAL_STATE
      ,a.[ZIPCODE] POSTAL_ZIPCODE
 	  ,a.[COUNTRY] POSTAL_COUNTRY
      
      
  FROM [AccessFrontEnds].[dbo].[MMX_EQUIPMENT_MASTER] m

  LEFT JOIN MMX_SALES_DELIVERIES d ON m.SALES_ORDER = d.ORDER_NO

  AND m.SALES_ORDER_POSITION = d.POSITION

  LEFT JOIN s1 ON m.PARENT_EQUIP_KEY = s1.PARENT_EQUIPMENT_KEY

  LEFT JOIN s2 ON s1.PARENT_EQUIP_KEY = s2.PARENT_PARENT_EQUIPMENT_KEY

  --LEFT JOIN MMX_CUSTOMERS c ON m.CUSTOMER = c.CUSTOMER

  LEFT JOIN MMX_SERVICE_SITES s ON m.SITE = s.LOCATION

  LEFT JOIN MMX_CUSTOMERS_POSTAL_ADDRESSES a ON s.POSTAL_ADDRESS = a.POSTAL_ADDRESS
  
  AND a.CUSTOMER = s.CUSTOMER

ORDER BY INSTALLATION_DATE</CommandText>
        <rd:UseGenericDesigner>true</rd:UseGenericDesigner>
      </Query>
