  <DataSources>
    <DataSource Name="AFE">
      <DataSourceReference>AFE</DataSourceReference>
      <rd:SecurityType>None</rd:SecurityType>
      <rd:DataSourceID>aaf8a7d5-0dd1-48e0-b513-9a272d7da55e</rd:DataSourceID>
    </DataSource>
  </DataSources>
  <DataSets>
    <DataSet Name="DataSet1">
      <Query>
        <DataSourceName>AFE</DataSourceName>
        <CommandText>/****** Script for SelectTopNRows command from SSMS  ******/
SELECT [SERVICE_ORDER]
      ,[SERVICE_TYPE]
      ,[SITE]
      ,[CUSTOMER]
      ,[SERIAL_NO]
      ,[ITEM_CODE]
      ,[NAME]
      ,[NAME_2]
      ,[ADDRESS]
      ,[ADDRESS_2]
      ,[TOWN]
      ,[POSTCODE]
      ,[POSTAL_ADDRESS]
      ,[DELIVERY_ADDRESS]
      ,[TELEPHONE]
      ,[REGION]
      ,[ORDER_CATEGORY]
      ,[BILLING_FLAG]
      ,[GENERAL_TEXT]
	  ,COALESCE([TEXT],'') TEXT
      ,[INVOICE_DATE]
      ,[INVOICE_TIME]
      ,[INVOICE_NUMBER]
      ,[PROJECT]
      ,[COUNTRY]
      ,[TERMS_OF_PAYMENT]
      ,[FORWARDING_AGENT]
      ,[TERMS_OF_DELIVERY]
      ,[CARRIER]
      ,[CITY]
      ,[STATE]
      ,[ZIP_CODE]
      ,[COUNTY]
      ,[CITY_LIMITS]
      ,COALESCE([ITEM_DESCRIPTION],'') ITEM_DESCRIPTION
      
  FROM [AccessFrontEnds].[dbo].[MMX_SERVICE_ORDERS] o

  LEFT JOIN MMX_ITEM_TEXT t ON CAST(o.GENERAL_TEXT as varchar(40)) = t.TEXTKEY</CommandText>
        <rd:UseGenericDesigner>true</rd:UseGenericDesigner>
      </Query>
