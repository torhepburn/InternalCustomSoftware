<?xml version="1.0" encoding="utf-8"?>
<Report MustUnderstand="df" xmlns="http://schemas.microsoft.com/sqlserver/reporting/2016/01/reportdefinition" xmlns:rd="http://schemas.microsoft.com/SQLServer/reporting/reportdesigner" xmlns:df="http://schemas.microsoft.com/sqlserver/reporting/2016/01/reportdefinition/defaultfontfamily">
  <df:DefaultFontFamily>Segoe UI</df:DefaultFontFamily>
  <AutoRefresh>0</AutoRefresh>
  <DataSources>
    <DataSource Name="NAV">
      <DataSourceReference>NAV</DataSourceReference>
      <rd:SecurityType>None</rd:SecurityType>
      <rd:DataSourceID>4bd1d918-f232-48cf-8ddc-9ba8646fc692</rd:DataSourceID>
    </DataSource>
  </DataSources>
  <DataSets>
    <DataSet Name="DataSet1">
      <Query>
        <DataSourceName>NAV</DataSourceName>
        <CommandText>


SELECT

vl.Quantity ServiceLineQuantity
,vil.Quantity ServiceInvoiceQuantity
,vil.No_
,vil.Description
,vil.[Service Item No_]
,vl.[Document No_] [Service Order No_]
,vil.[Posting Date]

from [ZYGO$Service Invoice Line] vil

INNER JOIN [ZYGO$Service Invoice Header] vih ON vih.No_ = vil.[Document No_]

INNER JOIN [ZYGO$Service Line] vl ON vl.[Document No_] = vih.[Order No_]

AND vl.No_ = vil.No_

WHERE vil.Quantity &lt;&gt; vl.Quantity

AND vil.Type = 1

AND vil.[Posting Date] &gt; DATEADD(mm, -1, GETDATE())

UNION ALL

SELECT

sl.Quantity SalesLineQuantity
,sil.Quantity SalesInvoiceQuantity
,sil.No_
,sil.Description
,'' [Service Item No_]
,sl.[Document No_] [Sales Order No_]
,sil.[Posting Date]

from [ZYGO$Sales Invoice Line] sil

INNER JOIN [ZYGO$Sales Invoice Header] sih ON sih.No_ = sil.[Document No_]

INNER JOIN [ZYGO$Sales Line] sl ON sl.[Document No_] = sih.[Order No_]

AND sl.No_ = sil.No_

WHERE sil.Quantity &lt;&gt; sl.Quantity

AND sil.Type = 1

AND sil.[Posting Date] &gt; DATEADD(mm, -1, GETDATE())

AND sl.[SO Line No_] &lt; 500

Order by [Posting Date] DESC</CommandText>
        <rd:UseGenericDesigner>true</rd:UseGenericDesigner>
      </Query>
      <Fields>
        <Field Name="ServiceLineQuantity">
          <DataField>ServiceLineQuantity</DataField>
          <rd:TypeName>System.Decimal</rd:TypeName>
        </Field>
        <Field Name="ServiceInvoiceQuantity">
          <DataField>ServiceInvoiceQuantity</DataField>
          <rd:TypeName>System.Decimal</rd:TypeName>
        </Field>
        <Field Name="No_">
          <DataField>No_</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Description">
          <DataField>Description</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Service_Item_No_">
          <DataField>Service Item No_</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Service_Order_No_">
          <DataField>Service Order No_</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Posting_Date">
          <DataField>Posting Date</DataField>
          <rd:TypeName>System.DateTime</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
  </DataSets>
