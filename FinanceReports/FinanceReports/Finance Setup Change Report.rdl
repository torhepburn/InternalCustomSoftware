<?xml version="1.0" encoding="utf-8"?>
<Report MustUnderstand="df" xmlns="http://schemas.microsoft.com/sqlserver/reporting/2016/01/reportdefinition" xmlns:rd="http://schemas.microsoft.com/SQLServer/reporting/reportdesigner" xmlns:df="http://schemas.microsoft.com/sqlserver/reporting/2016/01/reportdefinition/defaultfontfamily">
  <df:DefaultFontFamily>Segoe UI</df:DefaultFontFamily>
  <AutoRefresh>0</AutoRefresh>
  <DataSources>
    <DataSource Name="DataSource1">
      <ConnectionProperties>
        <DataProvider>SQL</DataProvider>
        <ConnectString>Data Source=pa-hor-as408.ametek.com;Initial Catalog=ZYGO-NAV-PROD</ConnectString>
      </ConnectionProperties>
      <rd:SecurityType>DataBase</rd:SecurityType>
      <rd:DataSourceID>a6266709-4bf9-4098-8360-60df21605e1f</rd:DataSourceID>
    </DataSource>
  </DataSources>
  <DataSets>
    <DataSet Name="DataSet1">
      <Query>
        <DataSourceName>DataSource1</DataSourceName>
        <QueryParameters>
          <QueryParameter Name="@StartDate">
            <Value>=Parameters!StartDate.Value</Value>
          </QueryParameter>
          <QueryParameter Name="@EndDate">
            <Value>=Parameters!EndDate.Value</Value>
          </QueryParameter>
        </QueryParameters>
        <CommandText>select	
	[Date and Time] as [Change Date Time],
	[User ID] as [Changed by],

	case [Table No_] 
		when 15 then 'G/L Account'
		when 98 then 'General Ledger Setup'
		when 252 then 'General Posting Setup'
		when 5813 then 'Inventory Posting Setup'
	end as [Table Name],
	[Primary Key Field 1 Value] as [Key 1],
	[Primary Key Field 2 Value] as [Key 2],
	case [Table No_] 
		when 15 then -- G/L Account
			case [Field No_] 
				when 1		then 'Account No'
				when 2		then 'Name'
				when 13		then 'Blocked'
				when 14		then 'Direct Posting'
				when 26		then 'Last Date Modified'
				else 'Field No ' + cast([Field No_] as varchar)
			end
		when 98 then -- General Ledger Setup
			case [Field No_] 
				when 2		then 'Allow Posting From'
				when 3		then 'Allow Posting To'
				else 'Field No ' + cast([Field No_] as varchar)
			end

		when 252 then -- General Posting Setup
			case [Field No_] 
				when	1	then 'Gen. Bus. Posting Group'
				when	2	then 'Gen. Prod. Posting Group'
				when	5072653	then '3rd Party Rent Account'
				when	18	then 'COGS Account'
				when	5803	then 'COGS Account - Interim'
				when	99000752	then 'Direct Cost Applied Account'
				when	5072450	then 'Internal Service Cost Account'
				when	19	then 'Inventory Adjmt. Account'
				when	5801	then 'Invt. Accrual Acc. - Interim'
				when	5072654	then 'Leasing Account'
				when	5072655	then 'Leasing Prepayment Account'
				when	99000753	then 'Overhead Applied Account'
				when	14	then 'Purch. Account'
				when	28	then 'Purch. Credit Memo Account'
				when	5600	then 'Purch. FA Disc. Account'
				when	16	then 'Purch. Inv. Disc. Account'
				when	15	then 'Purch. Line Disc. Account'
				when	17	then 'Purch. Pmt. Disc. Credit Acc.'
				when	31	then 'Purch. Pmt. Disc. Debit Acc.'
				when	35	then 'Purch. Pmt. Tol. Credit Acc.'
				when	34	then 'Purch. Pmt. Tol. Debit Acc.'
				when	37	then 'Purch. Prepayments Account'
				when	99000754	then 'Purchase Variance Account'
				when	5072658	then 'Rent Deposit Account'
				when	5072657	then 'Rent Inv. Disc. Account'
				when	5072656	then 'Rent Line Disc. Account'
				when	5072650	then 'Rental Account'
				when	5072652	then 'Rental Cr. Memo Account'
				when	5072651	then 'Rental Prepayment Account'
				when	10	then 'Sales Account'
				when	27	then 'Sales Credit Memo Account'
				when	12	then 'Sales Inv. Disc. Account'
				when	11	then 'Sales Line Disc. Account'
				when	30	then 'Sales Pmt. Disc. Credit Acc.'
				when	13	then 'Sales Pmt. Disc. Debit Acc.'
				when	33	then 'Sales Pmt. Tol. Credit Acc.'
				when	32	then 'Sales Pmt. Tol. Debit Acc.'
				when	36	then 'Sales Prepayments Account'
				else 'Field No ' + cast([Field No_] as varchar)
			end
		when 5813 then -- Inventory Posting Setup
			case [Field No_] 
				when 2	then 'Invt. Posting Group Code' 
				when 1	then 'Location Code' 
				when 99000756	then 'Cap. Overhead Variance Account' 
				when 99000754	then 'Capacity Variance Account' 
				when 6	then 'Inventory Account' 
				when 5800	then 'Inventory Account - Interim' 
				when 99000753	then 'Material Variance Account' 
				when 99000755	then 'Mfg. Overhead Variance Account' 
				when 99000757	then 'Subcontracted Variance Account' 
				when 99000750	then 'WIP Account'
			end
	
	end as [Field Name],
	case [Type of Change]
		when 0 then 'New'
		when 1 then 'Modification'
		when 2 then 'Deletion'
	end as [Change],
	[Old Value],
	[New Value]

from	
	[ZYGO$Change Log Entry] l
where 
	[Table No_] in(
	15, -- g/l account
	98, -- general ledger setup
	252, -- Gen posting setup
	5813 -- Inv postin Setup
	)
and cast([Date and Time] as date) --= cast(getdate()-1 as date) -- yesterday

BETWEEN @StartDate AND @EndDate</CommandText>
        <rd:UseGenericDesigner>true</rd:UseGenericDesigner>
      </Query>
      <Fields>
        <Field Name="Change_Date_Time">
          <DataField>Change Date Time</DataField>
          <rd:TypeName>System.DateTime</rd:TypeName>
        </Field>
        <Field Name="Changed_by">
          <DataField>Changed by</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Table_Name">
          <DataField>Table Name</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Key_1">
          <DataField>Key 1</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Key_2">
          <DataField>Key 2</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Field_Name">
          <DataField>Field Name</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Change">
          <DataField>Change</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Old_Value">
          <DataField>Old Value</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="New_Value">
          <DataField>New Value</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
  </DataSets>
