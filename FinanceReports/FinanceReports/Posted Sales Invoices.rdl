        </Field>
        <Field Name="Payment_Terms_Code">
          <DataField>Payment Terms Code</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Country_Region_Code">
          <DataField>Country/Region Code</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Salesperson_Code">
