          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Sell_to_Contact">
          <DataField>Sell-to Contact</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
