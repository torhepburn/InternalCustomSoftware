          <rd:TypeName>System.DateTime</rd:TypeName>
        </Field>
        <Field Name="Amount">
          <DataField>Amount</DataField>
          <rd:TypeName>System.Decimal</rd:TypeName>
        </Field>
        <Field Name="Amount_Including_VAT">
          <DataField>Amount Including VAT</DataField>
          <rd:TypeName>System.Decimal</rd:TypeName>
        </Field>
        <Field Name="Ship_to_City">
          <DataField>Ship-to City</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Ship_to_County">
          <DataField>Ship-to County</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Ship_to_Country_Region_Code">
          <DataField>Ship-to Country_Region Code</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
  </DataSets>
