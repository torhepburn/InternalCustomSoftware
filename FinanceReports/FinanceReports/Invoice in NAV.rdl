<?xml version="1.0" encoding="utf-8"?>
<Report MustUnderstand="df" xmlns="http://schemas.microsoft.com/sqlserver/reporting/2016/01/reportdefinition" xmlns:rd="http://schemas.microsoft.com/SQLServer/reporting/reportdesigner" xmlns:df="http://schemas.microsoft.com/sqlserver/reporting/2016/01/reportdefinition/defaultfontfamily">
  <df:DefaultFontFamily>Segoe UI</df:DefaultFontFamily>
  <AutoRefresh>0</AutoRefresh>
  <DataSources>
    <DataSource Name="DataSource1">
      <ConnectionProperties>
        <DataProvider>SQL</DataProvider>
        <ConnectString>Data Source=pa-hor-as408.ametek.com;Initial Catalog=ZYGO-NAV-PROD</ConnectString>
      </ConnectionProperties>
      <rd:SecurityType>DataBase</rd:SecurityType>
      <rd:DataSourceID>e53f8699-e8cd-4a82-b320-d11eda0195ae</rd:DataSourceID>
    </DataSource>
  </DataSources>
  <DataSets>
    <DataSet Name="DataSet1">
      <Query>
        <DataSourceName>DataSource1</DataSourceName>
        <QueryParameters>
          <QueryParameter Name="@start">
            <Value>=Parameters!start.Value</Value>
          </QueryParameter>
          <QueryParameter Name="@end">
            <Value>=Parameters!end.Value</Value>
          </QueryParameter>
        </QueryParameters>
        <CommandText>SELECT

  vih.[Location Code]
, vih.[Ship-to Name]
, vih.[Your Reference]
, vih.[No_]
, vih.[Posting Date]
, SUM([Line Amount]) Amount
, SUM([Amount Including VAT]) [Amount Including VAT]
, [Ship-to City]
, [Ship-to County]
, [Ship-to Country_Region Code]

 FROM [ZYGO$Service Invoice Header] vih 

 LEFT JOIN [ZYGO$Service Invoice Line] vil on vih.No_ = vil.[Document No_]

where vih.[Posting Date] &gt;= @start and vih.[Posting Date] &lt;= @end

GROUP BY 

  vih.[Location Code]
, vih.[Ship-to Name]
, vih.[Your Reference]
, vih.[No_]
, vih.[Posting Date]
, [Ship-to City]
, [Ship-to County]
, [Ship-to Country_Region Code]

 UNION

  SELECT 

  sih.[Location Code]
, sih.[Ship-to Name]
, sih.[Your Reference]
, sih.[No_]
, sih.[Posting Date]
, SUM([Amount]) Amount
, SUM([Amount Including VAT]) [Amount Including VAT]
, [Ship-to City]
, [Ship-to County]
, [Ship-to Country_Region Code]


 FROM [ZYGO$Sales Invoice Header] sih 
 
 LEFT JOIN [ZYGO$Sales Invoice Line] sil on sil.[Document No_] = sih.[No_]

 where sih.[Posting Date] &gt;= @start and sih.[Posting Date] &lt;= @end
  
 GROUP BY 

  sih.[Location Code]
, sih.[Ship-to Name]
, sih.[Your Reference]
, sih.[No_]
, sih.[Posting Date]
, [Ship-to City]
, [Ship-to County]
, [Ship-to Country_Region Code]


UNION

SELECT 

  sch.[Location Code]
, sch.[Ship-to Name]
, sch.[Your Reference]
, sch.[No_]
, sch.[Posting Date]
, SUM([Amount]) Amount
, SUM([Amount Including VAT]) [Amount Including VAT]
, [Ship-to City]
, [Ship-to County]
, [Ship-to Country_Region Code]


 FROM [ZYGO$Sales Cr_Memo Header] sch 
 
 LEFT JOIN [ZYGO$Sales Cr_Memo Line] scl on scl.[Document No_] = sch.[No_]

 where sch.[Posting Date] &gt;= @start and sch.[Posting Date] &lt;= @end

 GROUP BY 

sch.[Location Code]
, sch.[Ship-to Name]
, sch.[Your Reference]
, sch.[No_]
, sch.[Posting Date]
, [Ship-to City]
, [Ship-to County]
, [Ship-to Country_Region Code]


UNION

SELECT 

  vch.[Location Code]
, vch.[Ship-to Name]
, vch.[Your Reference]
, vch.[No_]
, vch.[Posting Date]
, SUM([Amount]) Amount
, SUM([Amount Including VAT]) [Amount Including VAT]
, vch.[Ship-to City]
, vch.[Ship-to County]
, vch.[Ship-to Country_Region Code]

 FROM [ZYGO$Service Cr_Memo Header] vch 
 
 LEFT JOIN [ZYGO$Service Cr_Memo Line] vcl on vcl.[Document No_] = vch.[No_]

 where vch.[Posting Date] &gt;= @start and vch.[Posting Date] &lt;= @end

 GROUP BY 

  vch.[Location Code]
, vch.[Ship-to Name]
, vch.[Your Reference]
, vch.[No_]
, vch.[Posting Date]
, vch.[Ship-to City]
, vch.[Ship-to County]
, vch.[Ship-to Country_Region Code]</CommandText>
        <rd:UseGenericDesigner>true</rd:UseGenericDesigner>
      </Query>
