<?xml version="1.0" encoding="utf-8"?>
<Report MustUnderstand="df" xmlns="http://schemas.microsoft.com/sqlserver/reporting/2016/01/reportdefinition" xmlns:rd="http://schemas.microsoft.com/SQLServer/reporting/reportdesigner" xmlns:df="http://schemas.microsoft.com/sqlserver/reporting/2016/01/reportdefinition/defaultfontfamily">
  <df:DefaultFontFamily>Segoe UI</df:DefaultFontFamily>
  <AutoRefresh>0</AutoRefresh>
  <DataSources>
    <DataSource Name="AFE">
      <DataSourceReference>AFE</DataSourceReference>
      <rd:SecurityType>None</rd:SecurityType>
      <rd:DataSourceID>fcbfbef0-e9a6-40d5-96a4-92e514604686</rd:DataSourceID>
    </DataSource>
    <DataSource Name="NAVPROD">
      <ConnectionProperties>
        <DataProvider>SQL</DataProvider>
        <ConnectString>Data Source=PA-HOR-AS408.ametek.com</ConnectString>
      </ConnectionProperties>
      <rd:SecurityType>DataBase</rd:SecurityType>
      <rd:DataSourceID>6bf56a35-b3ce-4f61-b58c-cd93408ba9f1</rd:DataSourceID>
    </DataSource>
  </DataSources>
  <DataSets>
    <DataSet Name="DataSet1">
      <Query>
        <DataSourceName>NAVPROD</DataSourceName>
        <QueryParameters>
          <QueryParameter Name="@start">
            <Value>=Parameters!start.Value</Value>
          </QueryParameter>
          <QueryParameter Name="@end">
            <Value>=Parameters!end.Value</Value>
          </QueryParameter>
        </QueryParameters>
        <CommandText>--DECLARE 
--	 @start datetime
--	,@end datetime

--SET @start = '05-01-2019'
--SET @end = '05-31-2019';


WITH s1 AS
(
	SELECT 
	
	 [Item No_] ITEM_CODE
	,[Sales Code] SALES_PRICE_LIST
	,[Unit Price] PRICE

	FROM [ZYGO$Sales Price]

	WHERE 
	
	[Ending Date] &gt;= @end
	AND [Starting Date] &lt;= @end

)

SELECT DISTINCT

 ds.[Dimension Value Code]  AREA
,dv.Name AreaDesc
,sl.[Bin Code] WAREHOUSE
,b.Description WHDesc
,sl.[Sell-to Customer No_] CUSTOMER
,c.Name NAME
,sh.[External Document No_] CUSTOMER_PO
,sh.[End User Customer Name] EndUserName
,sh.[No_] ORDER_NO
,sl.[Job No_] PROJECT
,sl.[SO Line No_] POSITION
,'' SRNO
,sl.[Shipment Date] DELIVERY_DATE
,sl.No_ ITEM_CODE
,CASE 
	WHEN LEN(sl.[Job No_]) &gt; 0 THEN j.Description + ';  ' + j.[Description 2] + ' (' + i.Description + ')'
	ELSE i.Description
 
 END GenericDesc
,i.Description ITEM_DESCRIPTION
,CASE i.[Replenishment System]
	WHEN 0 THEN 'P'
	WHEN 1 THEN 'M'
END ItemTypeDesc
 ,sh.[Order Date] ORDER_DATE
 ,sl.[Requested Delivery Date] REQUESTED_DATE
,sl.Quantity ORDERED_QUANTITY
 ,sl.[Quantity]- sl.[Outstanding Quantity] DELIVERED_QUANTITY
 ,sl.[Outstanding Quantity] BACK_ORDER
 ,'' DISPATCH_NOTE_NUMBER
 ,'' INVOICE_DATE
 ,'' INVOICE
 ,sl.[Unit Price] PRICE
 
 ,sl.[Inv_ Discount Amount] ORDER_DISCOUNT
 ,sl.[Line Discount Amount] DISCOUNT
 ,sl.[Line Amount] NetSell
 --,IIF(NetSell &lt;&gt; 0,(((NetSell/DELIVERED_QUANTITY)-Transfer)/(NetSell/DELIVERED_QUANTITY)), 0) AS NetSellTransferMargin
 --, CASE
	--WHEN sl.[Line Amount] &lt;&gt; 0 THEN (sl.[Line Amount]/[Quantity Shipped])
 --END AS NetSellTransferMargin
  ,0 NetSellTransferMargin
 --,IIF(NetSell &lt;&gt; 0,(((NetSell/DELIVERED_QUANTITY)-ZJV)/(NetSell/DELIVERED_QUANTITY)), 0) AS NetSellZJVTransferMargin
  ,0 AS NetSellZJVTransferMargin
 ,sl.[Unit Cost (LCY)] COST_PRICE
 ,i.[Standard Cost] STANDARD_COST_PRICE
 ,i.[Rolled-up Material Cost] MATERIAL_COSTS
 ,i.[Standard Cost] - i.[Rolled-up Material Cost] OPERATION_COSTS
 ,[Quantity Shipped] * i.[Standard Cost] AS StdCostSell					/*	DELIVERED_QUANTITY * PLCost	*/
 ,([Quantity Shipped] * (i.[Standard Cost] - i.[Rolled-up Material Cost])) AS OpsCostSell		/*	DELIVERED_QUANTITY * OPERATION_COSTS*/
 ,[Quantity Shipped] * i.[Rolled-up Material Cost] AS MatlCostSell				/*DELIVERED_QUANTITY * MATERIAL_COSTS*/
 --,(Transfer-PLCost)/Transfer AS StdTransferMargin
  , 0 as StdTransferMargin
 --,IIF(ZJV &lt;&gt;0, (ZJV-PLCost)/ZJV, 0) AS ZJVTransferMargin
  ,0 as ZJVTransferMargin
 ,0 Transfer
 ,0 TransferCalc
 ,0 DomList
 ,0 DomCalc
 ,0 ZJV
 ,0 ZJVCalc
 ,0  AS ZJVSell		/* DELIVERED_QUANTITY * ZJV */
 ,0 AS TransferSell	/*DELIVERED_QUANTITY * Transfer	*/
 ,0 PLCost
 ,0 PLBasis
 ,0 LeadTime
 ,0 DaysLate
 ,0 OnTime
 ,sh.[Payment Terms Code] TERMS_OF_PAYMENT
 ,sh.[Shipment Method Code] TERMS_OF_DELIVERY
 ,sh.[Ship-to Code] DELIVERY_ADDRESS
 ,sh.[Customer Price Group] SO_Price_List
 ,s1.PRICE ListPrice
 
 

from [ZYGO$Sales Header] sh 
 
LEFT JOIN [ZYGO$Dimension Set Entry] ds on sh.[Dimension Set ID] = ds.[Dimension Set ID] and [Dimension Code] = 'REGION'

LEFT JOIN [ZYGO$Dimension Value] dv on ds.[Dimension Value ID] = dv.[Dimension Value ID]

INNER JOIN [ZYGO$Sales Line] sl on sl.[Document No_] = sh.No_

LEFT JOIN [ZYGO$Bin] b on b.Code = sl.[Bin Code]

INNER JOIN ZYGO$Customer c on sl.[Sell-to Customer No_] = c.No_

LEFT JOIN [ZYGO$Job] j on j.No_ = sl.[Job No_]

LEFT JOIN ZYGO$Item i on sl.No_ = i.No_

 --LEFT JOIN [ZYGO$Bin Content] bc on i.No_ = bc.[Item No_]


 --inner JOIN [ZYGO$Sales Shipment Header] ssh on ssh.[Order No_] = sh.[No_]

 --INNER JOIN [ZYGO$Sales Shipment Line] ssl on ssh.[No_] = ssl.[Document No_] --and ssl.[SO Line No_] = sl.[SO Line No_]

 --inner JOIN [ZYGO$Sales Invoice Header] sih on sih.[Order No_] = sh.[No_]

 --inner JOIN [ZYGO$Sales Invoice Line] sil on sih.[No_] = sil.[Document No_] and ssl.[SO Line No_] = sil.[SO Line No_] --and sil.[SO Line No_] = sl.[SO Line No_]

 --

 LEFT JOIN s1 on s1.SALES_PRICE_LIST = sh.[Customer Price Group] and s1.ITEM_CODE = sl.No_

 --[ZYGO$Sales Shipment Header] ssh 
/*
left join [ZYGO$Sales Shipment Line] ssl on ssh.No_ = ssl.[Document No_] 

left join [ZYGO$Sales Invoice Header] sih ON sih.[Order No_] = ssh.[Order No_] 

left join [ZYGO$Sales Invoice Line] sil on sih.No_ = sil.[Document No_] and ssl.[SO Line No_] = sil.[SO Line No_]

and ssl.[Posting Date] = sil.[Posting Date]

left join [ZYGO$Sales Header] sh ON sh.No_ = ssh.[Order No_]

left join [ZYGO$Sales Line] sl on sh.No_ = sl.[Document No_]

*/
 WHERE 
 
 sl.[Shipment Date] &gt;= @start

 AND

 sl.[Shipment Date] &lt;= @end

 AND 
 
 sl.[SO Line No_] &lt; 500

 AND (sl.Quantity - sl.[Outstanding Quantity]) != 0</CommandText>
      </Query>
