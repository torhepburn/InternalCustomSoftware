<?xml version="1.0" encoding="utf-8"?>
<Report MustUnderstand="df" xmlns="http://schemas.microsoft.com/sqlserver/reporting/2016/01/reportdefinition" xmlns:rd="http://schemas.microsoft.com/SQLServer/reporting/reportdesigner" xmlns:df="http://schemas.microsoft.com/sqlserver/reporting/2016/01/reportdefinition/defaultfontfamily">
  <df:DefaultFontFamily>Segoe UI</df:DefaultFontFamily>
  <AutoRefresh>0</AutoRefresh>
  <DataSources>
    <DataSource Name="DataSource1">
      <ConnectionProperties>
        <DataProvider>SQL</DataProvider>
        <ConnectString>Data Source=pa-hor-as408.ametek.com;Initial Catalog=ZYGO-NAV-PROD</ConnectString>
      </ConnectionProperties>
      <rd:SecurityType>DataBase</rd:SecurityType>
      <rd:DataSourceID>d6abb269-6d28-43c1-a753-60b3fb604870</rd:DataSourceID>
    </DataSource>
  </DataSources>
  <DataSets>
    <DataSet Name="DataSet1">
      <Query>
        <DataSourceName>DataSource1</DataSourceName>
        <QueryParameters>
          <QueryParameter Name="@dtfrom">
            <Value>=Parameters!dtfrom.Value</Value>
          </QueryParameter>
          <QueryParameter Name="@dtto">
            <Value>=Parameters!dtto.Value</Value>
          </QueryParameter>
        </QueryParameters>
        <CommandText>select	
	'ZYGO - Import - Budget' as [GLSource],
	case 
	when substring(gl.[G_L Account No_],1,1) = '6' AND isnull(dcos.[Dimension Value Code],'') = '' then gl.[G_L Account No_]
	when substring(gl.[G_L Account No_],1,1) = '6' AND isnull(dcos.[Dimension Value Code],'') &lt;&gt; '' then gl.[G_L Account No_] +'-' + isnull(dcos.[Dimension Value Code],'')
	else gl.[G_L Account No_] end as [Account Number],
	'ZYGO_US' as [Company],
	isnull(c.Name,'Default (Customer)') as [Customer],
	'FY'+ right(cast(datepart(yy, @dtfrom) as varchar),2) + '-P' + right('00' + cast(datepart(mm,@dtfrom) as varchar),2) as [Fiscal Period &amp; Elimination Period],  

	case when left(gl.[G_L Account No_],1) = '6' then 'Default (Product)'
		 when left(gl.[G_L Account No_],1) = '7' then 'Default (Product)'
		 when left(gl.[G_L Account No_],5) in ('50140','50160','50225','50325','51016','51030','51050','51060') then 
			case when isnull(dseg.[Dimension Value Code],'') in ('LASER INTERF PROD','LASER INTERF SVCS') then 'OCOS_LI'
				when isnull(dseg.[Dimension Value Code],'') in ('OPT PROFILER PROD','OPT PROFILER SVCS') then 'OCOS_OP'
				when isnull(dseg.[Dimension Value Code],'') in ('EUV','CRYSTALLINE OPTICS','GLASS OPTICS','MACHINED STRUCTURES') then 'OCOS_EPO'
				when isnull(dseg.[Dimension Value Code],'') in ('ELECTRO-OPTICS OTHER') then 'OCOS_Irvine'
				when isnull(dseg.[Dimension Value Code],'') in ('PPS','PPS SYSTEM','PPS COMPONENTS','PPS SERVICES') then 'OCOS_PPS'
				when isnull(dseg.[Dimension Value Code],'') in ('PO VALUE STREAM') then 'OCOS_PO'
				when isnull(dseg.[Dimension Value Code],'') in ('LFO VALUE STREAM') then 'OCOS_LFO'
			else ''
			end
		 else isnull(dcat.[Dimension Value Code],'') 
	end as [ProdCat], --PRODUCT
	
	case when left(gl.[G_L Account No_],2) = '41' then 'Default (Cost Center)' 
		else isnull(dcos.[Dimension Value Code],'') 
	end as [CostCenter], 

	isnull(dind.[Dimension Value Code],'Default (Industry)') as [Industry], 
	'Actuals' as [Version],
	'USD' as [Currency],
	isnull(dicp.[Dimension Value Code],'Default (ICP)') as [ICP],
	isnull(dreg.[Dimension Value Code],'Default (Region)') as [Region],
	'USA' as [Country],

	case
		when isnull(dcos.[Dimension Value Code],'') in ('1140','5017','5024','7222','8200','8210','8211','8215','8220')
			then 'EO'
		when isnull(dcos.[Dimension Value Code],'') in ('1151','5620','5640','5641','5642','5643','5644','5645','5646','5647','5648','5649','5680','5685','6011','7007','8191')
			then 'EPO'
		when isnull(dcos.[Dimension Value Code],'') in ('5010','5012','5013','5050','5070','5072','5074','7010','7011','7012','7017','7028','7050','8015','8017','8049','8050','8070','8080','8090','8110','8117','8118','8119','8120','8180')
			then 'Instruments'
		when isnull(dcos.[Dimension Value Code],'') in ('5200','5210','5215','5225','5230')
			then 'LFO'
		when isnull(dcos.[Dimension Value Code],'') in ('1000','1050','1100','1210','1211','1213','5014','5015','5020','5025','5030','5045','6001','6005','6007','6015','6016','6020','6030','7001','7020',
														'7021','7040','7045','7055','7120','7125','7130','7135','7320','7325','7330','7340','7420','7430','7440','7445','7470','8010','8011','8170','8175','ZZZZ')
			then 'Other'
		when isnull(dcos.[Dimension Value Code],'') in ('5110','5125','5135','5145','5150','5160','5177','5185','5310','6050','8074','8077','8177','8190')
			then 'PO'
		when isnull(dcos.[Dimension Value Code],'') in ('5062','5065','7006','8035','8150')
			then 'PPS'
		else isnull(dseg.[Dimension Value Code],'') 
	end as [Business Group],  --SEGMENT
	
	'Default (Employee Type)' as [Employee Type],
	cast(datepart(yyyy, @dtfrom) as varchar) as [Fiscal Year],
	cast(datepart(mm,@dtfrom) as varchar) as [PeriodID],  
	'P' as [Period Type],
	case when sum(gl.Amount) &gt; 0 then  abs(sum(gl.Amount)) else 0 end as [Debit Amount],
	case when sum(gl.Amount) &lt; 0 then  abs(sum(gl.Amount)) else 0 end as [Credit Amount],
	sum(gl.Amount) as [Amount]

from		[ZYGO$G_L Entry] gl 
left join   [ZYGO$G_L Account] acc on gl.[G_L Account No_] = acc.No_
left join	[ZYGO$G_L - Item Ledger Relation] ilr on gl.[Entry No_] = ilr.[G_L Entry No_] 
left join	[ZYGO$Value Entry] ve on ve.[Entry No_] = ilr.[Value Entry No_]

left join	[ZYGO$Customer] c on gl.[Source No_] = c.No_ and gl.[Source Code] = 'SALES'

left join	[ZYGO$Dimension Set Entry] dcos on gl.[Dimension Set ID] = dcos.[Dimension Set ID] and dcos.[Dimension Code] = 'COSTCENTER'
left join	[ZYGO$Dimension Set Entry] dseg on gl.[Dimension Set ID] = dseg.[Dimension Set ID] and dseg.[Dimension Code] = 'SEGMENT'
left join	[ZYGO$Dimension Set Entry] dind on gl.[Dimension Set ID] = dind.[Dimension Set ID] and dind.[Dimension Code] = 'INDUSTRY'
left join	[ZYGO$Dimension Set Entry] dreg on gl.[Dimension Set ID] = dreg.[Dimension Set ID] and dreg.[Dimension Code] = 'REGION'
left join	[ZYGO$Dimension Set Entry] dsit on gl.[Dimension Set ID] = dsit.[Dimension Set ID] and dreg.[Dimension Code] = 'SITE'
left join	[ZYGO$Dimension Set Entry] dicp on gl.[Dimension Set ID] = dicp.[Dimension Set ID] and dicp.[Dimension Code] = 'ICP'
left join	[ZYGO$Dimension Set Entry] dcat on gl.[Dimension Set ID] = dcat.[Dimension Set ID] and dcat.[Dimension Code] = 'PRODCAT'


where gl.[Posting Date] between @dtfrom and @dtto 

group by gl.[G_L Account No_], acc.Name, c.[No_], c.Name,
		dcos.[Dimension Value Code],dseg.[Dimension Value Code],dind.[Dimension Value Code],
		dreg.[Dimension Value Code] , dsit.[Dimension Value Code] , dicp.[Dimension Value Code],dcat.[Dimension Value Code]

		order by gl.[G_L Account No_]</CommandText>
        <rd:UseGenericDesigner>true</rd:UseGenericDesigner>
      </Query>
      <Fields>
        <Field Name="GLSource">
          <DataField>GLSource</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Account_Number">
          <DataField>Account Number</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Company">
          <DataField>Company</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Customer">
          <DataField>Customer</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Fiscal_Period___Elimination_Period">
          <DataField>Fiscal Period &amp; Elimination Period</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="ProdCat">
          <DataField>ProdCat</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="CostCenter">
          <DataField>CostCenter</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Industry">
          <DataField>Industry</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Version">
          <DataField>Version</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Currency">
          <DataField>Currency</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="ICP">
          <DataField>ICP</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Region">
          <DataField>Region</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Country">
          <DataField>Country</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Business_Group">
          <DataField>Business Group</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Employee_Type">
          <DataField>Employee Type</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Fiscal_Year">
          <DataField>Fiscal Year</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="PeriodID">
          <DataField>PeriodID</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Period_Type">
          <DataField>Period Type</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Debit_Amount">
          <DataField>Debit Amount</DataField>
          <rd:TypeName>System.Decimal</rd:TypeName>
        </Field>
        <Field Name="Credit_Amount">
          <DataField>Credit Amount</DataField>
          <rd:TypeName>System.Decimal</rd:TypeName>
        </Field>
        <Field Name="Amount">
          <DataField>Amount</DataField>
          <rd:TypeName>System.Decimal</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
  </DataSets>
