<?xml version="1.0" encoding="utf-8"?>
<Report MustUnderstand="df" xmlns="http://schemas.microsoft.com/sqlserver/reporting/2016/01/reportdefinition" xmlns:rd="http://schemas.microsoft.com/SQLServer/reporting/reportdesigner" xmlns:df="http://schemas.microsoft.com/sqlserver/reporting/2016/01/reportdefinition/defaultfontfamily">
  <df:DefaultFontFamily>Segoe UI</df:DefaultFontFamily>
  <AutoRefresh>0</AutoRefresh>
  <DataSources>
    <DataSource Name="NAVPROD">
      <ConnectionProperties>
        <DataProvider>SQL</DataProvider>
        <ConnectString>Data Source=PA-HOR-AS408.ametek.com</ConnectString>
      </ConnectionProperties>
      <rd:SecurityType>DataBase</rd:SecurityType>
      <rd:DataSourceID>9c8c17ae-64ea-4c2c-9aeb-5ba6d21afdb7</rd:DataSourceID>
    </DataSource>
  </DataSources>
  <DataSets>
    <DataSet Name="DataSet1">
      <Query>
        <DataSourceName>NAVPROD</DataSourceName>
        <QueryParameters>
          <QueryParameter Name="@dtfrom">
            <Value>=Parameters!StartDate.Value</Value>
            <rd:UserDefined>true</rd:UserDefined>
          </QueryParameter>
          <QueryParameter Name="@dtto">
            <Value>=Parameters!EndDate.Value</Value>
            <rd:UserDefined>true</rd:UserDefined>
          </QueryParameter>
        </QueryParameters>
        <CommandText>--DECLARE @dtfrom as datetime = '01-JUL-2019'

--DECLARE @dtto as datetime = '31-JUL-2019'


select        
       case when substring(gl.[G_L Account No_],1,1) = '6' then gl.[G_L Account No_] +'-' + isnull(dcos.[Dimension Value Code],'') 
       else gl.[G_L Account No_] end as [Account Number],

       'Actuals' as [Version],
       isnull(dseg.[Dimension Value Code],'') as [Segment], 
       'ZYGO_US' as [Company],
       isnull(dcos.[Dimension Value Code],'') as [CostCenter], 
       'USA' as [Country],
       'USD' as [Currency],
       isnull(c.Name,'Default (Customer)') as [Customer],
       'Default (Employee Type)' as [Employee Type],
       'FY'+ right(cast(datepart(yy, @dtfrom) as varchar),2) + '-P' + right('00' + cast(datepart(mm,@dtfrom) as varchar),2) as [Period],  
       isnull(dicp.[Dimension Value Code],'Default (ICP)') as [ICP],
       isnull(dind.[Dimension Value Code],'Default (Industry)') as [Industry], 
       isnull(dcat.[Dimension Value Code],'') as [ProdCat],
       isnull(dreg.[Dimension Value Code],'Default (Region)') as [Region],
       case when sum(gl.Amount) &gt; 0 then  FORMAT(abs(sum(gl.Amount)),'C') else FORMAT(0,'C') end as [Debit Amount],
       case when sum(gl.Amount) &lt; 0 then  FORMAT(abs(sum(gl.Amount)),'C') else FORMAT(0,'C') end as [Credit Amount]


from          [ZYGO$G_L Entry] gl 
left join   [ZYGO$G_L Account] acc on gl.[G_L Account No_] = acc.No_
left join     [ZYGO$G_L - Item Ledger Relation] ilr on gl.[Entry No_] = ilr.[G_L Entry No_] 
left join     [ZYGO$Value Entry] ve on ve.[Entry No_] = ilr.[Value Entry No_]

left join     [ZYGO$Customer] c on gl.[Source No_] = c.No_ and gl.[Source Code] = 'SALES'

left join     [ZYGO$Dimension Set Entry] dcos on gl.[Dimension Set ID] = dcos.[Dimension Set ID] and dcos.[Dimension Code] = 'COSTCENTER'
left join     [ZYGO$Dimension Set Entry] dseg on gl.[Dimension Set ID] = dseg.[Dimension Set ID] and dseg.[Dimension Code] = 'SEGMENT'
left join     [ZYGO$Dimension Set Entry] dind on gl.[Dimension Set ID] = dind.[Dimension Set ID] and dind.[Dimension Code] = 'INDUSTRY'
left join     [ZYGO$Dimension Set Entry] dreg on gl.[Dimension Set ID] = dreg.[Dimension Set ID] and dreg.[Dimension Code] = 'REGION'
left join     [ZYGO$Dimension Set Entry] dsit on gl.[Dimension Set ID] = dsit.[Dimension Set ID] and dreg.[Dimension Code] = 'SITE'
left join     [ZYGO$Dimension Set Entry] dicp on gl.[Dimension Set ID] = dicp.[Dimension Set ID] and dicp.[Dimension Code] = 'ICP'
left join     [ZYGO$Dimension Set Entry] dcat on gl.[Dimension Set ID] = dcat.[Dimension Set ID] and dcat.[Dimension Code] = 'PRODCAT'


where gl.[Posting Date] between @dtfrom and @dtto

group by gl.[G_L Account No_], acc.Name, c.[No_], c.Name,
              dcos.[Dimension Value Code],dseg.[Dimension Value Code],dind.[Dimension Value Code],
              dreg.[Dimension Value Code] , dsit.[Dimension Value Code] , dicp.[Dimension Value Code],dcat.[Dimension Value Code]



</CommandText>
        <rd:UseGenericDesigner>true</rd:UseGenericDesigner>
      </Query>
