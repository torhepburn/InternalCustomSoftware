    public void Delete()
    {
        cnxn = new SqlConnection(g.db);

        cmd = new("DELETE FROM CallForQuote " +
                  "WHERE ItemNumber = '" + g.item + "'"
                    , cnxn);

        try
        {
            cnxn.Open();
            cmd.ExecuteNonQuery();
        }
        catch (SqlException ex)
