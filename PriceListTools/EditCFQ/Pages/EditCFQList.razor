<EditForm Model="item" OnValidSubmit="DataEntry">
    <DataAnnotationsValidator />
    <ValidationSummary />
    <table>
        <tbody>
            <tr>
                <td align="right">
                    Item Number :
                    <InputText id="n8" placeholder="Item Code" @bind-Value="itemNumber" />
                </td>
                <td align="right">
                    Price :
                    <InputText id="n9" placeholder="CFQ" @bind-Value="price" /> 
                </td>
          
            </tr>
        </tbody>
    </table>

</EditForm>


<button class="btn btn-primary" @onclick="DataEntry">Click me</button>
<button class="btn btn-primary " @onclick="Delete">Delete</button>

@code {

    SqlCommand cmd;
    SqlConnection cnxn;
    SqlDataReader dr;
    //DataTable dt;
    public string? item;
    public string? itemNumber;
    public string? price;

    protected override void OnInitialized()
    {
        //dt = new DataTable();

        cnxn = new SqlConnection(g.db);

        cmd = new SqlCommand("SELECT " +
                " ItemNumber "+                                                
                ", Price " +     
                " from CallForQuote WHERE itemNumber = '" + g.item + "' " 
               , cnxn);

        try
        {
            cnxn.Open();
            dr = cmd.ExecuteReader();
            while (dr.Read())
            {
                itemNumber = dr.GetString(0).Trim();
                price = dr.GetString(1);
            }

            //dt.Load(dr);
        }
        catch (SqlException ex)
        {
            ex.ToString();
        }
        finally
        {
            cnxn.Close();

        }
    }

