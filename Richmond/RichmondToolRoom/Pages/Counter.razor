@page "/counter"

<PageTitle>Counter</PageTitle>

<h1>Counter</h1>

<p role="status">Current count: @currentCount</p>

<button class="btn btn-primary" @onclick="IncrementCount">Click me</button>

<p>
    <label>
        Select a car:
        <select @bind="SelectedCar">
            <option value=""></option>
            <option value="audi">Audi</option>
            <option value="jeep">Jeep</option>
            <option value="opel">Opel</option>
            <option value="saab">Saab</option>
            <option value="volvo">Volvo</option>
        </select>
    </label>
</p>
<p>
    <label>
        STATUS:
        <select @bind="SelectedStatus">
            <option value=""></option>
            <option value="completed">Completed</option>
            <option value="on hold">On Hold</option>
            <option value="design review">Design Review</option>
            <option value="in progress">In Progress</option>
        </select>
    </label>
</p>
<p>
    <label>
        PRIORITY:
        <select @bind="SelectedPriority">
            <option value=""></option>
            <option value="routine">Routine</option>
            <option value="urgent">Urgent</option>
            <option value="production down">Production Down</option>
            <option value="in progress">In Progress</option>
        </select>
    </label>
</p>

<p>
    <label>
        DEPARTMENT:
        <select @bind="SelectedDepartment">
            <option value=""></option>
            <option value="CCOS">CCOS</option>
            <option value="IBF">IBF</option>
            <option value="METROLOGY">METROLOGY</option>
            <option value="CNC">CNC</option>
            <option value="WORK CELL">WORK CELL</option>
            <option value="QC">QC</option>
            <option value="ASSEMBLY">ASSEMBLY</option>
            <option value="ENGINEERING">ENGINEERING</option>
            <option value="SMALL OPTICS">SMALL OPTICS</option>
            <option value="OTHER">OTHER</option>
        </select>
    </label>
</p>




@code {
    private int currentCount = 0;

    private void IncrementCount()
    {
        currentCount++;
        SelectedCar = "";
    }

    
    string SelectedCar = "";
    string SelectedStatus = "";
    string SelectedPriority = "";
    string SelectedDepartment = "";
