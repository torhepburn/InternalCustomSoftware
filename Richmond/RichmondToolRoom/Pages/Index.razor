@page "/"



<PageTitle>View Tool Requests</PageTitle>

<h1>Hello, world!</h1>

<EditForm Model="item" OnValidSubmit="DataEntry">
    <DataAnnotationsValidator />
    <ValidationSummary />
    <table>
        <tbody>
            <tr>
                <td >
                    Name :
                    <InputText id="n1" placeholder= "Location" @bind-Value="location" />
                </td>
               <td >
                    Priority :
                    <InputText id="n1" placeholder= "Location" @bind-Value="location" />
                </td>
                
            </tr>
            <tr>
                <td align ="right">
                    Contact Email :
                    <InputText id="n2" placeholder="BinCode" @bind-Value="binCode" /> 
                </td>
                               
                <td >
                    Quantity :
                    <InputText id="n12" placeholder="Planner" @bind-Value="planner" />
                </td>
               
            </tr>
            <tr>
                <td >
                    Department :
                    <InputText id="n3" placeholder="Skt Rm Assoc #" @bind-Value="storekeeper" />
                </td>
            </tr>
            <tr>
                <td >
                    Customer :
                    <InputText id="n4" placeholder="CostCenter" @bind-Value="costcenter" />
                </td>
            </tr>
            <tr>
                <td >
                    Project :
                    <InputText id="n12" placeholder="Planner" @bind-Value="planner" />
                </td>
                <td >
                    Optics Drawing Number and Path :
                    <InputText id="n12" placeholder="Planner" @bind-Value="planner" />
                </td>
            </tr>
            <tr>
                <td >
                    Part :
                    <InputText id="n13" placeholder="Due Date" @bind-Value="duedate" />
                </td>
                <td >
                    If modificatiuon of existing tool :
                    <InputText id="n12" placeholder="Tool Number" @bind-Value="planner" />
                </td>
            </tr>

        </tbody>
    </table>    
</EditForm>


<br />
<button class="btn btn-primary" @onclick="DataEntry">Save Data</button>

<div class="dropdown" id="toggleDropdown">
    <button @onclick="Show" @onblur="Hide" class="button" type="button">
    <span>Persnnal</span>

    </button>

    <ul class="dropdown-list @(isActive ? "is-active" : "")">

        <li class="dropdown-item">
            <p class="text-md-start">Cabinet</p>
            </li>

        <li class="dropdown-item">
            <p class="text-md-start">Knife</p>
        </li>

    </ul>


</div>

@code
    {

        public string enteredOn = "";
        public string wo = "";
        public string woline = "";
        public string job = "";
        public string jobreference = "";
        public string item = "";
        public string partdescription = "";
        public string quantity = "";
        public string location = "";
        public string binCode = "";
        public string storekeeper = "";
        public string costcenter = "";
        public string planner = "";
        public string duedate = "";
        public string comment = "";
        public string commentEntered = "";

        private bool isActive = false;

    private void Show()
    {
        isActive = true;
    }

    private void Hide()
    {
        isActive = false;
    }

    private void DataEntry()
        {
        
        }
}