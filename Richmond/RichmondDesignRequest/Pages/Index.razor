@code{
    private string? requestor;
    private string? department;
    private string? requestorEmail;
    private DateTime requestedDate;
    private string? quantity;
    private string? priority;
    private string? project;
    private string? part;
    private string? storekeeper;
    private string data = "";
    public bool cbProject = false;
    public bool cbCostCenter = false;
    public bool cbPersist = false;
    SqlDataReader dr;
    SqlConnection cnxn;
    SqlCommand cmd;
    DataTable dtEmployees;
    DataTable dtParts;
    
    private string? selectedID;

    protected override void OnInitialized()
    {
        dtEmployees = new DataTable();

        cnxn = new SqlConnection(g.db);

        cmd = new("select " +
                  "  ROW_NUMBER() OVER " +
                  "(Order BY sn) " +
                  ", CN " +
                  ", mail " +
                  "FROM EmployeesAmetekAD " +
                  "WHERE BU = 'ca-ric' " +
                  "order by SN "
                  , cnxn);

        try
        {
            cnxn.Open();
            dr = cmd.ExecuteReader();
            dtEmployees.Load(dr);
        }
        catch (SqlException ex)
        {
            ex.ToString();
        }
        finally
        {
            cnxn.Close();

        }

        dtParts = new DataTable();

        cnxn = new SqlConnection(g.dbNAV);

        cmd = new SqlCommand(
            "SELECT " + 
            "No_ + '-:-' + Description " +
            "from ZYGO$Item " +
            "where [Global Dimension 2 Code] in " +
            "('EUV','CRYSTALLINE OPTICS','GLASS OPTICS','MACHINED STRUCTURES') ORDER BY No_", cnxn);
    
        try
        {
            cnxn.Open();
            dr = cmd.ExecuteReader();
            dtParts.Load(dr);
        }
        catch (SqlException ex)
        {
            ex.ToString();
        }
        finally
        {
            cnxn.Close();

        }
    }

    
    private void DataEntry()
    {
        
    }

}