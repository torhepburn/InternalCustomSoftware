@code {

    SqlDataReader dr;
    SqlConnection cnxn;
    SqlCommand cmd;
    DataTable dt;
    private string data ="";
    private string? selectedID;
    private string? reviewer;

    protected override void OnInitialized()
    {
        dt = new DataTable();

        cnxn = new SqlConnection(g.db);

        cmd = new("select " +
                  "  ROW_NUMBER() OVER " +
                 "(Order BY sn) " +
                 ", CN " +
                 ", mail " +
                 "FROM EmployeesAmetekAD " +
                 "WHERE BU = 'ca-ric' " +
                 "order by SN "
                 , cnxn);

        try
        {
            cnxn.Open();
            dr = cmd.ExecuteReader();
            dt.Load(dr);
        }
        catch (SqlException ex)
        {
            ex.ToString();
        }
        finally
        {
            cnxn.Close();

        }
    }

