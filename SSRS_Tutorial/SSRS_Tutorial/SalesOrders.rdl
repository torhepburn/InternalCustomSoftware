  <DataSources>
    <DataSource Name="AccessFrontEnds">
      <ConnectionProperties>
        <DataProvider>SQL</DataProvider>
        <ConnectString>Data Source=10.213.70.94;Initial Catalog=AccessFrontEnds</ConnectString>
      </ConnectionProperties>
      <rd:SecurityType>DataBase</rd:SecurityType>
      <rd:DataSourceID>22e94a24-e893-4bf8-b1f6-2bdc91762a4e</rd:DataSourceID>
    </DataSource>
  </DataSources>
  <DataSets>
    <DataSet Name="ShortageData">
      <Query>
        <DataSourceName>AccessFrontEnds</DataSourceName>
        <QueryParameters>
          <QueryParameter Name="@BUYER">
            <Value>=Parameters!BUYER.Value</Value>
          </QueryParameter>
        </QueryParameters>
        <CommandText>SELECT 

l.Buyer
,l.ItemCode
,PO
,Qty
,[Req Date]

from [Shortage_List] l 
inner join ShortageList_ActiveFlags f
on l.id = f.id

WHERE Buyer = @BUYER or @BUYER is null</CommandText>
      </Query>
      <Fields>
        <Field Name="Buyer">
          <DataField>Buyer</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="ItemCode">
          <DataField>ItemCode</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="PO">
          <DataField>PO</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Qty">
          <DataField>Qty</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Req_Date">
          <DataField>Req Date</DataField>
          <rd:TypeName>System.DateTime</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
